{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2021",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // As Skip's shared tsconfig: Node's declarations, from @types/node at the
    // version Skip's lock pins (package.json here; `npm ci` installs it).
    "types": ["node"],
    // Where they are installed, stated so that a probe project extending
    // this one finds them too.
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      // The source snapshot has neither built dist/ declarations nor npm's
      // workspace node_modules links. Map only those two package entries to
      // their upstream source entry points; core's skiplang-json symlink is real.
      "@skipruntime/core": ["./skipruntime-ts/core/src/index.ts"],
      "@skipruntime/server": ["./skipruntime-ts/server/src/server.ts"]
    }
  },
  "include": [
    "../examples/recursive-json*.ts",
    "../examples/equality-intersection-element.ts",
    "../examples/invalid-recursive-json-*.ts",
    "../examples/reactive-sum-prettier-ignore.ts",
    "../examples/reactive-sum-sound.ts",
    "../examples/sum-*.ts",
    "../examples/invalid-sum-*.ts"
  ],
  // Clients of the sound service binding belong to ../upstream-sound.
  "exclude": [
    "../examples/sum-sound-binding*.ts",
    "../examples/invalid-sum-sound-binding*.ts"
  ]
}
