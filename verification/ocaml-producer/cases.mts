// Executable coverage inventory. A negative control must reach validation;
// an earlier gate failure cannot masquerade as a soundness regression passing.
import type { Outcome, Phase } from "./check.mts";
export interface Case {
  file: string;
  area: string;
  kind: "positive" | "negative" | "gap";
  status: Outcome["status"];
  phase: Phase;
  diagnostic?: RegExp;
  /** Source tree supplying named imports; the reader and suite use the same path. */
  project?: string;
}
const positive = (file: string, area: string): Case => ({
  file,
  area,
  kind: "positive",
  status: "verified",
  phase: "check",
});
const negative = (
  file: string,
  area: string,
  diagnostic = /evidence search failed/,
): Case => ({
  file,
  area,
  kind: "negative",
  status: "unverified",
  phase: "search",
  diagnostic,
});
const gap = (
  file: string,
  area: string,
  status: Outcome["status"],
  phase: Phase,
  diagnostic: RegExp,
): Case => ({ file, area, kind: "gap", status, phase, diagnostic });
