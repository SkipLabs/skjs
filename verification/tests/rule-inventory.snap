HasTy  (Programs/ProgramTyping.lean)
  var : Γ[i]? = some A → HasTy G Γ (.var i) A
  nul : Represents G A .nul → HasTy G Γ .nul A
  undef : Represents G A .undef → HasTy G Γ .undef A
  tru : Represents G A .bool → HasTy G Γ .tru A
  fls : Represents G A .bool → HasTy G Γ .fls A
  truLit : Represents G A (.boolLit true) → HasTy G Γ .tru A
  flsLit : Represents G A (.boolLit false) → HasTy G Γ .fls A
  numLit : Represents G A (.numLit b) → HasTy G Γ (.num b) A
  num : Represents G A .num → HasTy G Γ (.num b) A
  bigintLit : Represents G A (.bigintLit i) → HasTy G Γ (.bigint i) A
  bigint : Represents G A .bigint → HasTy G Γ (.bigint i) A
  strLit : Represents G A (.strLit s) → HasTy G Γ (.str s) A
  str : Represents G A .str → HasTy G Γ (.str s) A
  funGraph {Γ : List (Ty ι)} {F : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {arity start : Nat} {E : List Tm} {K : List (ControlFlow.Continuation × Option ControlFlow.Target)} {caps : List (Ty ι × Nat)} {rest : Bool} {As : List (Ty ι)} : Represents G F (.arrs L S) → CodeOffers G arity E K start (caps.map Prod.fst) rest L S As → (∀ c ∈ caps, c.2 < Γ.length) → (∀ c ∈ caps, HasTy G Γ (.var c.2) c.1) → HasTy G Γ (.make (.graph arity E K start (caps.map fun c => .var c.2) .call rest) .nul) F
  funScheme {Γ : List (Ty ι)} {j : ι} {s : SchemeRow ι} {arity start : Nat} {E : List Tm} {K : List (ControlFlow.Continuation × Option ControlFlow.Target)} {caps : List (Ty ι × Nat)} {rest : Bool} {As : List (Ty ι)} : G.params j = false → G.schemes j = some s → (∀ η, CodeOffers (reassign G η) arity E K start (caps.map Prod.fst) rest s.signatures s.variadic As) → capturesFree G s (caps.map Prod.fst) = true → (∀ c ∈ caps, c.2 < Γ.length) → (∀ c ∈ caps, HasTy G Γ (.var c.2) c.1) → HasTy G Γ (.make (.graph arity E K start (caps.map fun c => .var c.2) .call rest) .nul) [j]
  ctorGraph {Γ : List (Ty ι)} {F U : Ty ι} {L : List (List (Ty ι) × Ty ι)} {arity start : Nat} {E : List Tm} {K : List (ControlFlow.Continuation × Option ControlFlow.Target)} {caps : List (Ty ι × Nat)} : Represents G F (.ctors L) → Represents G U .undef → (∀ p ∈ L, GraphCodeSpec G arity E K start (caps.map Prod.fst) (U, p.1, p.2)) → (∀ c ∈ caps, c.2 < Γ.length) → (∀ c ∈ caps, HasTy G Γ (.var c.2) c.1) → HasTy G Γ (.make (.graph arity E K start (caps.map fun c => .var c.2) .construct) .nul) F
  callableGraph {Γ : List (Ty ι)} {F : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {arity start : Nat} {E : List Tm} {K : List (ControlFlow.Continuation × Option ControlFlow.Target)} {caps : List (Ty ι × Nat)} {rest : Bool} {As : List (Ty ι)} {parts : List (PropKey × Ty ι × Tm)} : Represents G F (.callable (parts.map fun p => (p.1, p.2.1)) [] L S) → (parts.map Prod.fst).Nodup → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → CodeOffers G arity E K start (caps.map Prod.fst) rest L S As → (∀ c ∈ caps, c.2 < Γ.length) → (∀ c ∈ caps, HasTy G Γ (.var c.2) c.1) → HasTy G Γ (.makeAt (.graph arity E K start (caps.map fun c => .var c.2) .call rest) (parts.map Prod.fst) (parts.map fun p => p.2.2)) F
  construct {Γ : List (Ty ι)} {f : Tm} {F B : Ty ι} {L : List (List (Ty ι) × Ty ι)} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} : HasTy G Γ f F → Represents G F (.ctors L) → (xs.map Prod.fst ++ Us, B) ∈ L → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → HasTy G Γ (.construct f (xs.map Prod.snd)) B
  callCallable {Γ : List (Ty ι)} {f r : Tm} {F Rt B : Ty ι} {P : List (PropKey × Ty ι)} {Ps : List (List (PropKey × Ty ι))} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} : HasTy G Γ f F → Represents G F (.callable P Ps L S) → (Rt, xs.map Prod.fst ++ Us, B) ∈ L → HasTy G Γ r Rt → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → HasTy G Γ (.invoke f r (xs.map Prod.snd)) B
  readCallable : HasTy G Γ a F → Represents G F (.callable P Ps L S) → (f, A) ∈ P → HasTy G Γ (.readAt f a) A
  writeCallable : HasTy G Γ a F → Represents G F (.callable P Ps L S) → (f, A) ∈ P → HasTy G Γ b A → Represents G N .nul → HasTy G Γ (.writeAt f a b) N
  app {Γ : List (Ty ι)} {f r : Tm} {F Rt B : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} : HasTy G Γ f F → Represents G F (.arrs L S) → (Rt, xs.map Prod.fst ++ Us, B) ∈ L → HasTy G Γ r Rt → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → HasTy G Γ (.invoke f r (xs.map Prod.snd)) B
  letE : HasTy G Γ a A → HasTy G (A :: Γ) b B → HasTy G Γ (.letE a b) B
  alloc {parts : List (PropKey × Ty ι × Tm)} {ks : List KeyBound} : (parts.map Prod.fst).Nodup → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → Represents G Ref (.refs (parts.map fun p => (p.1, p.2.1)) [] [] [] [] ks) → (∀ K ∈ ks, ∀ p ∈ parts, K.admits p.1 = true) → allocRealm G (parts.map fun p => (p.1, p.2.1)) = true → HasTy G Γ (.makeAt .absent (parts.map Prod.fst) (parts.map fun p => p.2.2)) Ref
  allocDict {parts : List (PropKey × Ty ι × Tm)} {ix cs : List (IndexKeys × Ty ι)} {os : List (OptionalField (Ty ι))} : (parts.map Prod.fst).Nodup → CallArguments.protoField ∉ parts.map Prod.fst → CallArguments.arrayStoreField ∉ parts.map Prod.fst → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → Represents G Ref (.dict (parts.map fun p => (p.1, p.2.1)) [] [] ix os [] [] cs) → (∀ p ∈ parts, ∀ y ∈ ix ++ cs, y.1.may p.1 = true → p.2.1 = y.2) → (∀ o ∈ os, o.key ∉ parts.map Prod.fst) → (∀ o ∈ os, ∀ y ∈ cs, y.1.may o.key = true → o.type = y.2 ∨ PositiveRules.Uninhabited G y.2) → HasTy G Γ (.makeAt .absent (parts.map Prod.fst) (parts.map fun p => p.2.2)) Ref
  read : HasTy G Γ a Ref → Represents G Ref c → namedMembers c = some (fs, vs) → (f, A) ∈ fs → HasTy G Γ (.readAt f a) A
  readView : HasTy G Γ a Ref → Represents G Ref c → namedMembers c = some (fs, vs) → (f, A) ∈ vs → HasTy G Γ (.readAt f a) A
  readProto {a : Tm} {Ref P : Ty ι} {fs vs : List (PropKey × Ty ι)} {os : List (OptionalField (Ty ι))} {ms : List (MethodMembers.Sig (Ty ι))} {ks : List KeyBound} {K : KeyBound} {gs ws : List (PropKey × Ty ι)} {os' : List (OptionalField (Ty ι))} {ms' : List (MethodMembers.Sig (Ty ι))} {ks' : List KeyBound} {f : PropKey} {A : Ty ι} : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os ms ks) → K ∈ ks → K.admits f = false → (CallArguments.protoField, P) ∈ fs ++ vs → Represents G P (.refs gs [] ws os' ms' ks') → (f, A) ∈ gs ++ ws → HasTy G Γ (.readAt f a) A
  readOptional {a : Tm} {Ref : Ty ι} {fs vs : List (PropKey × Ty ι)} {os : List (OptionalField (Ty ι))} {ms : List (MethodMembers.Sig (Ty ι))} {ks : List KeyBound} {f : PropKey} {r : Bool} {A U : Ty ι} : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os ms ks) → ⟨f, r, A⟩ ∈ os → Represents G U .undef → HasTy G Γ (.readAt f a) (A ++ U)
  readDict {f : PropKey} {K : IndexKeys} : HasTy G Γ a Ref → Represents G Ref (.dict fs [] vs ix os ms ks cs) → (K, A) ∈ ix → K.surely f = true → Represents G U .undef → HasTy G Γ (.readAt f a) (A ++ U)
  indexDict {K KK : IndexKeys} : HasTy G Γ a Ref → Represents G Ref (.dict fs [] vs ix os ms ks cs) → HasTy G Γ key Kt → Represents G Kt (keyClause KK) → KK.within K = true → (K, A) ∈ ix → Represents G U .undef → HasTy G Γ (.indexAt a key) (A ++ U)
  write : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os ms ks) → (f, A) ∈ fs → HasTy G Γ b A → Represents G N .nul → HasTy G Γ (.writeAt f a b) N
  arith : HasTy G Γ a A → HasTy G Γ b B → OperatorTypes G op A B N → HasTy G Γ (.arith op a b) N
  arrLit {Γ : List (Ty ι)} {L : Ty ι} {T : Tuple (Ty ι)} {xs : List (Ty ι × Tm)} : Represents G L (.list T []) → T.required.length ≤ xs.length → (T.rest = none → xs.length ≤ T.required.length + T.optional.length) → (∀ p ∈ xs.zipIdx, positionTy T p.2 = some p.1.1) → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → HasTy G Γ (.arrLit (xs.map Prod.snd)) L
  elem {Γ : List (Ty ι)} {a i : Tm} {L I A : Ty ι} {T : Tuple (Ty ι)} {b : UInt64} {k : Nat} : HasTy G Γ a L → Represents G L (.list T []) → HasTy G Γ i I → Represents G I (.numLit b) → indexOfBits b = some k → T.required[k]? = some A → HasTy G Γ (.elemAt a i) A
  elemOpt {Γ : List (Ty ι)} {a i : Tm} {L I A U : Ty ι} {T : Tuple (Ty ι)} {b : UInt64} {k : Nat} : HasTy G Γ a L → Represents G L (.list T []) → HasTy G Γ i I → Represents G I (.numLit b) → indexOfBits b = some k → T.required[k]? = none → positionTy T k = some A → Represents G U .undef → HasTy G Γ (.elemAt a i) (A ++ U)
  elemAny {Γ : List (Ty ι)} {a i : Tm} {L I E U : Ty ι} : HasTy G Γ a L → Represents G L (.list ⟨[], [], some E, false⟩ []) → HasTy G Γ i I → Answers G I .isNum true → Represents G U .undef → HasTy G Γ (.elemAt a i) (E ++ U)
  setElem {Γ : List (Ty ι)} {a i v : Tm} {L I A : Ty ι} {T : Tuple (Ty ι)} {b : UInt64} {k : Nat} : HasTy G Γ a L → Represents G L (.list T []) → HasTy G Γ i I → Represents G I (.numLit b) → indexOfBits b = some k → positionTy T k = some A → k ≤ T.required.length → T.readonly = false → HasTy G Γ v A → HasTy G Γ (.setElem a i v) L
  len {Γ : List (Ty ι)} {a : Tm} {L N : Ty ι} {T : Tuple (Ty ι)} : HasTy G Γ a L → Represents G L (.list T []) → Represents G N .num → HasTy G Γ (.lenOf a) N
  lenStr {Γ : List (Ty ι)} {a : Tm} {S N : Ty ι} : HasTy G Γ a S → Answers G S .isStr true → Represents G N .num → HasTy G Γ (.lenOf a) N
  elemStr {Γ : List (Ty ι)} {a i : Tm} {S I T U : Ty ι} : HasTy G Γ a S → Answers G S .isStr true → HasTy G Γ i I → Answers G I .isNum true → Represents G T .str → Represents G U .undef → HasTy G Γ (.elemAt a i) (T ++ U)
  test : HasTy G Γ a A → (.boolLit true) ∈ expand G B → (.boolLit false) ∈ expand G B → HasTy G Γ (.test k a) B
  ifBool : HasTy G Γ c C → Answers G C .isBool true → HasTy G Γ t A → HasTy G Γ e A → HasTy G Γ (.ite c t e) A
  ifKnown : HasTy G Γ c C → Represents G C (.boolLit q) → HasTy G Γ (if q then t else e) A → HasTy G Γ (.ite c t e) A
  ifBoolVar : Γ[i]? = some C → Answers G C .isBool true → Represents G T (.boolLit true) → Represents G F (.boolLit false) → HasTy G (Γ.set i T) t A → HasTy G (Γ.set i F) e A → HasTy G Γ (.ite (.var i) t e) A
  ifTag : Γ[i]? = some A → Answers G A tag q → (q = true → HasTy G Γ u B) → (q = false → HasTy G Γ e B) → HasTy G Γ (.ite (.test tag (.var i)) u e) B
  unionVar : Γ[i]? = some C → (∀ a ∈ C, HasTy G (Γ.set i [a]) t A) → HasTy G Γ t A
  arrCopy {Γ : List (Ty ι)} {s : Tm} {S T E : Ty ι} : HasTy G Γ s S → SpreadsInto G S E → Represents G T (.list ⟨[], [], some E, false⟩ []) → HasTy G Γ (.arrLit [.spread s]) T
  callRest {Γ : List (Ty ι)} {f r : Tm} {F Rt : Ty ι} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} {P B : Ty ι} {parts : List (Bool × Ty ι × Tm)} : HasTy G Γ f F → (Rt, xs.map Prod.fst ++ Us, P, B) ∈ restSigs G F → HasTy G Γ r Rt → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → (Us = [] ∨ parts = []) → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → RestParts G P (parts.map fun p => (p.1, p.2.1)) → HasTy G Γ (.invoke f r (xs.map Prod.snd ++ parts.map fun p => spreadTerm (p.1, p.2.2))) B
  bindE {Γ : List (Ty ι)} {F T Rt R Rc : Ty ι} {t r : Nat} {slots : List Nat} {Ps Ds : List (Ty ι)} : Γ[t]? = some T → (Rt, Ps ++ Ds, R) ∈ callSigs G T → Γ[r]? = some Rt → slots.map (Γ[·]?) = Ps.map some → Represents G F (.arrs [(Rc, Ds, R)] []) → HasTy G Γ (.makeAt (.bound (.var t) (.var r) (slots.map .var)) [] []) F
  bindRestE {Γ : List (Ty ι)} {F T Rt E El R Rc : Ty ι} {t r : Nat} {slots : List Nat} {Ps Qs : List (Ty ι)} : Γ[t]? = some T → (Rt, Ps, E, R) ∈ restSigs G T → restElem G E = some El → Γ[r]? = some Rt → slots.map (Γ[·]?) = Qs.map some → Qs = Ps.take slots.length ++ List.replicate (slots.length - Ps.length) El → Represents G F (.arrs [] [(Rc, Ps.drop slots.length, E, R)]) → HasTy G Γ (.makeAt (.bound (.var t) (.var r) (slots.map .var)) [] []) F
  bindMember {Γ : List (Ty ι)} {F O : Ty ι} {i : Nat} {k : PropKey} {m : MethodMembers.Sig (Ty ι)} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} : Γ[i]? = some O → memberOf G O k = some m → Represents G F (.arrs L S) → (∀ q ∈ L, ∃ c ∈ m.calls, CoveredCall G q c) → (∀ s ∈ S, (s.2.1, s.2.2.1, s.2.2.2) ∈ m.rests) → HasTy G Γ (.letE (.readAt k (.var i)) (.makeAt (.bound (.var 0) (.var (i + 1)) []) [] [])) F
  bindScheme {Γ : List (Ty ι)} {F O : Ty ι} {i : Nat} {k : PropKey} {m : MethodMembers.Sig (Ty ι)} : Γ[i]? = some O → memberOf G O k = some m → F ∈ m.schemes → expand G F = [] → HasTy G Γ (.letE (.readAt k (.var i)) (.makeAt (.bound (.var 0) (.var (i + 1)) []) [] [])) F
  throw : HasTy G Γ a A → HasTy G Γ (.throw a) B
  merge {d : List PropKey} {a b : Tm} {A B R : Ty ι} : HasTy G Γ a A → HasTy G Γ b B → ObjectMerge.MergeOk G d A B R = true → HasTy G Γ (.merge d a b) R
  sub : HasTy G Γ t A → PositiveCertificates.check G A B cert = true → HasTy G Γ t B

