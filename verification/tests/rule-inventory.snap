HasTy  (Programs/ProgramTyping.lean)
  var : Γ[i]? = some A → HasTy G Γ (.var i) A
  nul : Represents G A .nul → HasTy G Γ .nul A
  undef : Represents G A .undef → HasTy G Γ .undef A
  tru : Represents G A .bool → HasTy G Γ .tru A
  fls : Represents G A .bool → HasTy G Γ .fls A
  truLit : Represents G A (.boolLit true) → HasTy G Γ .tru A
  flsLit : Represents G A (.boolLit false) → HasTy G Γ .fls A
  numLit : Represents G A (.numLit b) → HasTy G Γ (.num b) A
  num : Represents G A .num → HasTy G Γ (.num b) A
  strLit : Represents G A (.strLit s) → HasTy G Γ (.str s) A
  str : Represents G A .str → HasTy G Γ (.str s) A
  funE {Γ : List (Ty ι)} {F : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι)} {arity : Nat} {b : Tm} : Represents G F (.arrs L []) → (∀ p ∈ L, p.2.1.length = arity) → (∀ p ∈ L, HasTy G (p.1 :: p.2.1 ++ Γ) b p.2.2) → HasTy G Γ (.make (.closure arity b) .nul) F
  ctorE {Γ : List (Ty ι)} {F U : Ty ι} {L : List (List (Ty ι) × Ty ι)} {arity : Nat} {b : Tm} : Represents G F (.ctors L) → Represents G U .undef → (∀ p ∈ L, p.1.length = arity) → (∀ p ∈ L, HasTy G (U :: p.1 ++ Γ) b p.2) → HasTy G Γ (.make (.closure arity b .construct) .nul) F
  construct {Γ : List (Ty ι)} {f : Tm} {F B : Ty ι} {L : List (List (Ty ι) × Ty ι)} {xs : List (Ty ι × Tm)} : HasTy G Γ f F → Represents G F (.ctors L) → (xs.map Prod.fst, B) ∈ L → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → HasTy G Γ (.construct f (xs.map Prod.snd)) B
  makeCallable {Γ : List (Ty ι)} {F : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι)} {arity : Nat} {b : Tm} {parts : List (PropKey × Ty ι × Tm)} : Represents G F (.callable (parts.map fun p => (p.1, p.2.1)) [] L []) → (parts.map Prod.fst).Nodup → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → (∀ p ∈ L, p.2.1.length = arity) → (∀ p ∈ L, HasTy G (p.1 :: p.2.1 ++ Γ) b p.2.2) → HasTy G Γ (.makeAt (.closure arity b) (parts.map Prod.fst) (parts.map fun p => p.2.2)) F
  callCallable {Γ : List (Ty ι)} {f r : Tm} {F Rt B : Ty ι} {P : List (PropKey × Ty ι)} {Ps : List (List (PropKey × Ty ι))} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} : HasTy G Γ f F → Represents G F (.callable P Ps L S) → (Rt, xs.map Prod.fst ++ Us, B) ∈ L → HasTy G Γ r Rt → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → HasTy G Γ (.invoke f r (xs.map Prod.snd)) B
  readCallable : HasTy G Γ a F → Represents G F (.callable P Ps L S) → (f, A) ∈ P → HasTy G Γ (.readAt f a) A
  writeCallable : HasTy G Γ a F → Represents G F (.callable P Ps L S) → (f, A) ∈ P → HasTy G Γ b A → Represents G N .nul → HasTy G Γ (.writeAt f a b) N
  app {Γ : List (Ty ι)} {f r : Tm} {F Rt B : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι)} {S : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} : HasTy G Γ f F → Represents G F (.arrs L S) → (Rt, xs.map Prod.fst ++ Us, B) ∈ L → HasTy G Γ r Rt → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → HasTy G Γ (.invoke f r (xs.map Prod.snd)) B
  letE : HasTy G Γ a A → HasTy G (A :: Γ) b B → HasTy G Γ (.letE a b) B
  alloc {parts : List (PropKey × Ty ι × Tm)} : (parts.map Prod.fst).Nodup → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → Represents G Ref (.refs (parts.map fun p => (p.1, p.2.1)) [] []) → HasTy G Γ (.makeAt .absent (parts.map Prod.fst) (parts.map fun p => p.2.2)) Ref
  allocDict {parts : List (PropKey × Tm)} : (parts.map Prod.fst).Nodup → (∀ p ∈ parts, HasTy G Γ p.2 Elem) → Represents G Dict (.dict [] [] [] [Elem]) → HasTy G Γ (.makeAt .absent (parts.map Prod.fst) (parts.map Prod.snd)) Dict
  read : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os) → (f, A) ∈ fs → HasTy G Γ (.readAt f a) A
  readView : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os) → (f, A) ∈ vs → HasTy G Γ (.readAt f a) A
  readOptional : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os) → (f, A) ∈ os → Represents G U .undef → HasTy G Γ (.readAt f a) (A ++ U)
  readDict {f : String} : HasTy G Γ a Ref → Represents G Ref (.dict fs [] vs ix os) → A ∈ ix → Represents G U .undef → HasTy G Γ (.readAt (.str f) a) (A ++ U)
  indexDict : HasTy G Γ a Ref → Represents G Ref (.dict fs [] vs ix os) → HasTy G Γ key K → Represents G K .str → A ∈ ix → Represents G U .undef → HasTy G Γ (.indexAt a key) (A ++ U)
  write : HasTy G Γ a Ref → Represents G Ref (.refs fs [] vs os) → (f, A) ∈ fs → HasTy G Γ b A → Represents G N .nul → HasTy G Γ (.writeAt f a b) N
  arith : HasTy G Γ a A → Answers G A .isNum true → HasTy G Γ b B → Answers G B .isNum true → Represents G N .num → HasTy G Γ (.arith op a b) N
  arrLit {Γ : List (Ty ι)} {L : Ty ι} {T : Tuple (Ty ι)} {xs : List (Ty ι × Tm)} : Represents G L (.list T []) → T.required.length ≤ xs.length → (T.rest = none → xs.length ≤ T.required.length + T.optional.length) → (∀ p ∈ xs.zipIdx, positionTy T p.2 = some p.1.1) → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → HasTy G Γ (.arrLit (xs.map Prod.snd)) L
  elem {Γ : List (Ty ι)} {a i : Tm} {L I A : Ty ι} {T : Tuple (Ty ι)} {b : UInt64} {k : Nat} : HasTy G Γ a L → Represents G L (.list T []) → HasTy G Γ i I → Represents G I (.numLit b) → indexOfBits b = some k → T.required[k]? = some A → HasTy G Γ (.elemAt a i) A
  elemOpt {Γ : List (Ty ι)} {a i : Tm} {L I A U : Ty ι} {T : Tuple (Ty ι)} {b : UInt64} {k : Nat} : HasTy G Γ a L → Represents G L (.list T []) → HasTy G Γ i I → Represents G I (.numLit b) → indexOfBits b = some k → T.required[k]? = none → positionTy T k = some A → Represents G U .undef → HasTy G Γ (.elemAt a i) (A ++ U)
  elemAny {Γ : List (Ty ι)} {a i : Tm} {L I E U : Ty ι} : HasTy G Γ a L → Represents G L (.list ⟨[], [], some E, false⟩ []) → HasTy G Γ i I → Answers G I .isNum true → Represents G U .undef → HasTy G Γ (.elemAt a i) (E ++ U)
  setElem {Γ : List (Ty ι)} {a i v : Tm} {L I A : Ty ι} {T : Tuple (Ty ι)} {b : UInt64} {k : Nat} : HasTy G Γ a L → Represents G L (.list T []) → HasTy G Γ i I → Represents G I (.numLit b) → indexOfBits b = some k → positionTy T k = some A → T.readonly = false → HasTy G Γ v A → HasTy G Γ (.setElem a i v) L
  len {Γ : List (Ty ι)} {a : Tm} {L N : Ty ι} {T : Tuple (Ty ι)} : HasTy G Γ a L → Represents G L (.list T []) → Represents G N .num → HasTy G Γ (.lenOf a) N
  test : HasTy G Γ a A → (.boolLit true) ∈ expand G B → (.boolLit false) ∈ expand G B → HasTy G Γ (.test k a) B
  ifBool : HasTy G Γ c C → Answers G C .isBool true → HasTy G Γ t A → HasTy G Γ e A → HasTy G Γ (.ite c t e) A
  ifKnown : HasTy G Γ c C → Represents G C (.boolLit q) → HasTy G Γ (if q then t else e) A → HasTy G Γ (.ite c t e) A
  ifBoolVar : Γ[i]? = some C → Answers G C .isBool true → Represents G T (.boolLit true) → Represents G F (.boolLit false) → HasTy G (Γ.set i T) t A → HasTy G (Γ.set i F) e A → HasTy G Γ (.ite (.var i) t e) A
  ifTag : Γ[i]? = some A → Answers G A tag q → (q = true → HasTy G Γ u B) → (q = false → HasTy G Γ e B) → HasTy G Γ (.ite (.test tag (.var i)) u e) B
  unionVar : Γ[i]? = some C → (∀ a ∈ C, HasTy G (Γ.set i [a]) t A) → HasTy G Γ t A
  funRest {Γ : List (Ty ι)} {F : Ty ι} {L : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {As : List (Ty ι)} {n : Nat} {b : Tm} : Represents G F (.arrs [] L) → L.length = As.length → (∀ p ∈ L.zip As, p.1.2.1.length = n ∧ RestArray G p.2 p.1.2.2.1) → (∀ p ∈ L.zip As, HasTy G (p.2 :: p.1.1 :: p.1.2.1 ++ Γ) b p.1.2.2.2) → HasTy G Γ (.make (.variadic n b) .nul) F
  makeCallableRest {Γ : List (Ty ι)} {F : Ty ι} {parts : List (PropKey × Ty ι × Tm)} {L : List (Ty ι × List (Ty ι) × Ty ι × Ty ι)} {As : List (Ty ι)} {n : Nat} {b : Tm} : Represents G F (.callable (parts.map fun p => (p.1, p.2.1)) [] [] L) → (parts.map Prod.fst).Nodup → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → L.length = As.length → (∀ p ∈ L.zip As, p.1.2.1.length = n ∧ RestArray G p.2 p.1.2.2.1) → (∀ p ∈ L.zip As, HasTy G (p.2 :: p.1.1 :: p.1.2.1 ++ Γ) b p.1.2.2.2) → HasTy G Γ (.makeAt (.variadic n b) (parts.map Prod.fst) (parts.map fun p => p.2.2)) F
  arrCopy {Γ : List (Ty ι)} {s : Tm} {S T E : Ty ι} : HasTy G Γ s S → SpreadsInto G S E → Represents G T (.list ⟨[], [], some E, false⟩ []) → HasTy G Γ (.arrLit [.spread s]) T
  callRest {Γ : List (Ty ι)} {f r : Tm} {F Rt : Ty ι} {xs : List (Ty ι × Tm)} {Us : List (Ty ι)} {E B : Ty ι} {parts : List (Bool × Ty ι × Tm)} : HasTy G Γ f F → (Rt, xs.map Prod.fst ++ Us, E, B) ∈ restSigs G F → HasTy G Γ r Rt → (∀ p ∈ xs, HasTy G Γ p.2 p.1) → (∀ A ∈ Us, HasTy G Γ .undef A) → (Us = [] ∨ parts = []) → (∀ p ∈ parts, HasTy G Γ p.2.2 p.2.1) → (∀ p ∈ parts, p.1 = false → p.2.1 = E) → (∀ p ∈ parts, p.1 = true → SpreadsInto G p.2.1 E) → HasTy G Γ (.invoke f r (xs.map Prod.snd ++ parts.map fun p => spreadTerm (p.1, p.2.2))) B
  bindE {Γ : List (Ty ι)} {F T Rt R Rc : Ty ι} {t r : Nat} {slots : List Nat} {Ps Ds : List (Ty ι)} : Γ[t]? = some T → (Rt, Ps ++ Ds, R) ∈ callSigs G T → Γ[r]? = some Rt → slots.map (Γ[·]?) = Ps.map some → Represents G F (.arrs [(Rc, Ds, R)] []) → HasTy G Γ (.makeAt (.bound (.var t) (.var r) (slots.map .var)) [] []) F
  bindRestE {Γ : List (Ty ι)} {F T Rt E R Rc : Ty ι} {t r : Nat} {slots : List Nat} {Ps Qs : List (Ty ι)} : Γ[t]? = some T → (Rt, Ps, E, R) ∈ restSigs G T → Γ[r]? = some Rt → slots.map (Γ[·]?) = Qs.map some → Qs = Ps.take slots.length ++ List.replicate (slots.length - Ps.length) E → Represents G F (.arrs [] [(Rc, Ps.drop slots.length, E, R)]) → HasTy G Γ (.makeAt (.bound (.var t) (.var r) (slots.map .var)) [] []) F
  sub : HasTy G Γ t A → PositiveCertificates.check G A B cert = true → HasTy G Γ t B

Rule  (Programs/ProgramCertificates.lean)
  var
  nul
  undef
  tru
  fls
  truLit
  flsLit
  numLit
  num
  strLit
  str
  funE
  app
  letE
  alloc
  allocDict
  read
  readView
  write
  arith
  test
  readDict (element undef : Ty ι)
  indexDict (element undef : Ty ι)
  readOptional (element undef : Ty ι)
  arrLit
  elem
  setElem
  len
  elemOpt (undef : Ty ι)
  elemAny (undef : Ty ι)
  ifBool
  ifTrue
  ifFalse
  ifKnown (answer : Bool)
  ifBoolVar (trueType falseType : Ty ι)
  unionVar (slot : Nat)
  makeCallable
  callCallable
  readCallable
  writeCallable
  funRest (arrays : List (Ty ι))
  makeCallableRest (arrays : List (Ty ι))
  arrCopy (elem : Ty ι)
  callRest (fixed omitted : Nat) (spreads : List Bool) (elem : Ty ι)
  bindE
  bindRestE
  ctorE (undef : Ty ι)
  construct
  sub (proof : PositiveCertificates.Proof ι)

Proof  (Types/PositiveCertificates.lean)
  core (certificate : Certificate ι)
  subset
  trans (middle : List ι) (left right : Proof ι)
  inst (table : InstTable ι) (instances : List (List ι)) (domain : List ι) (free : FreeMap ι)
  table (table : InstTable ι) (domain : List ι) (free : FreeMap ι)
  gen (domain : List ι) (free : FreeMap ι) (body : List ι) (proof : Proof ι)

ArrowCert  (Types/PositiveCertificates.lean)
  empty
  source (p : List ι × List (List ι) × List ι)
  rest (s : List ι × List (List ι) × List ι × List ι)
  union (pre : List (List ι)) (a b : List ι) (suffix : List (List ι)) (left right : ArrowCert ι)
  combine (b b' : List ι) (left right : ArrowCert ι)
  emptyRecv
  recvUnion (a b : List ι) (left right : ArrowCert ι)

StepEvidence  (Programs/HeapExpressionRules.lean)
  ordinary (proof : ProgramCertificates.Evidence ι)
  pure (proof : ProgramCertificates.Evidence ι)
  created (proof : ProgramCertificates.Evidence ι)
  typedRead (slot : Nat) (element : List (PropKey × Ty ι)) (proof : ProgramCertificates.Evidence ι)
  observedRead (slot : Nat) (contents : List Atom)
  knownValue (slot : Nat) (contents : List Atom)
  allocated (proof : ProgramCertificates.Evidence ι)
  written (receiver value : Nat) (contents : List Atom) (proof : ProgramCertificates.Evidence ι)
