{
  // The trusted front end, type-checked. `annotate-source.mts` is display
  // plumbing carried over unannotated and is checked when the viewer it
  // serves is rewritten.
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "types": ["node"]
  },
  "files": [
    "parse-source.mts",
    "tsc-claims.mts",
    "strip-types.mts",
    "type-errors.mts"
  ]
}
