{
  // `annotate-source.mts` is display plumbing carried over from JavaScript, and
  // its helpers are unannotated, so the inference checks are off for it. What
  // stays on is what matters at this boundary: whether the compiler API members
  // it names exist. A renamed one reads as `undefined` at runtime rather than
  // failing — that is how `SyntaxKind.EndOfFileToken` turned a scanner loop
  // into a hang — and as an error here. It moves into tsconfig.json when the
  // reader it serves is rewritten.
  "extends": "./tsconfig.json",
  "compilerOptions": { "strict": false, "noImplicitAny": false },
  "files": ["annotate-source.mts"]
}
