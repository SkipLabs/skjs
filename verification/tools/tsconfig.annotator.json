{
  // Files carried over from JavaScript. Two checks are off, and only two:
  // `noImplicitAny`, because their helpers have no signatures, and
  // `strictNullChecks`, because they walk decoded JSON, where every index and
  // every optional field reads as possibly-absent and the file would be one
  // long `!`. Everything else strict holds — including what matters at this
  // boundary, whether the compiler API members they name exist. A renamed one
  // reads as `undefined` at runtime rather than failing (that is how
  // `SyntaxKind.EndOfFileToken` turned a scanner loop into a hang) and as an
  // error here. Turning `strictNullChecks` on costs 36 fixes in this file, 43
  // in the corpus driver and 139 across the suites.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noImplicitAny": false, "strictNullChecks": false },
  "files": ["annotate-source.mts"]
}
