{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"]
  },
  // Node strips types rather than compiling, so the syntax must be erasable:
  // no enum, no namespace, no parameter properties. Node rejects those at load,
  // and every suite loads these modules; `erasableSyntaxOnly` says so before
  // they are loaded.
  "include": ["*.ts"]
}
