{
  // The application. `svelte-check` is what actually checks the components;
  // this covers the plain `.ts` beside them, and declares the boundary with
  // the JavaScript model modules in `src/model.d.ts`.
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "vite.config.ts"]
}
