/***************************************************************************/
// Intersection operations for types.
/***************************************************************************/

module SKJS;

/* Unexpanded intersection */
//
// Interpretation:
// 〚 inter 〛 = ⨅ t for t in tys
//
// Holds a flattened set of types: (A & B) & C is stored as {A, B, C}.
//
// Invariant:
// - none of the inner TType is either bottom, top, or a single inter
// - the size of tys is >= 2
class TInter private (tys: ArraySet<TType>) extends TInst {
  static fun create(ty1: TType, ty2: TType): Result<TInter, TType> {
    if (ty1.isBottom() || ty2.isTop()) {
      return Failure(ty1)
    };
    if (ty2.isBottom() || ty1.isTop()) {
      return Failure(ty2)
    };
    tys = (ty1.getSingleInter(), ty2.getSingleInter()) match {
    | (Some(TInter(tys1)), Some(TInter(tys2))) -> tys1.union(tys2)
    | (Some(TInter(tys1)), None()) -> tys1.set(ty2)
    | (None(), Some(TInter(tys2))) -> tys2.set(ty1)
    | _ ->
      vec = mutable Vector[ty1, ty2];
      ArraySet::createFromMVector(vec)
    };
    Success(TInter(tys))
  }

  // Compute the intersection of all types in this group.
  fun expand(subst: mutable Subst, tenv: TEnv): TType {
    !tenv.expandInter = true;
    TType::interN(
      subst,
      tenv,
      this.tys.values().next().fromSome().pos,
      this.tys,
    )
  }

  // Maps f over all types in the intersection, preserving invariants.
  // Returns:
  //   Success(inter)  if result is a valid TInter (>= 2 types)
  //   Failure(ty)     otherwise
  fun map(f: TType -> TType): Result<TInter, TType> {
    result = mutable Vector[];
    for (ty in this.tys) {
      mapped = f(ty);
      if (mapped.isBottom()) return Failure(mapped);
      if (mapped.isTop()) continue;
      mapped.getSingleInter() match {
      | Some(TInter(innerTys)) -> result.extend(innerTys)
      | None() -> result.push(mapped)
      }
    };
    if (result.isEmpty()) {
      Failure(TType::top(this.tys.values().next().fromSome().pos))
    } else {
      arraySet = ArraySet::createFromMVector(result);
      arraySet.getUnique() match {
      | Some(ty) -> Failure(ty)
      | None() ->
        invariant(
          !arraySet.isEmpty(),
          "ArraySet::createFromMVector created an empty ArraySet from a non-empty Vector",
        );
        Success(TInter(arraySet))
      }
    }
  }
}

extension class TType {
  // Unexpanded intersection. Flattens nested TInters:
  // (A & B) & (C & D) → A & B & C & D
  static fun unexpandedInter(ty1: TType, ty2: TType): TType {
    TInter::create(ty1, ty2) match {
    | Failure(ty) -> ty
    | Success(tInter) ->
      TType::create(ty1.pos, TInsts::single(tInter), Clauses::empty())
    }
  }

  // Exact materialization reads both operands covariantly, establishing the
  // inspected candidate payloads in the live substitution. Uninspected members
  // remain symbolic. Frozen reads and uncommitted literal defaults are tracked
  // as provisional and cannot publish. Bare TVars use symbolic constraint
  // shortcuts and are excluded from this cache.
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    if (ty1 == ty2) return ty1;
    pair = (ty1, ty2);
    hasTVar = ty1.getSingleVar().isSome() || ty2.getSingleVar().isSome();
    if (!hasTVar) {
      subst.seenInter.maybeGet(pair) match {
      | Some(ty) -> return ty
      | None() -> void
      }
    };
    subst.withTypeQuery(() -> {
      readStamp = subst.typeQueryReadStamp();
      result = TType::inter_(subst, tenv, ty1, ty2);
      if (!hasTVar && subst.canCacheTypeQuerySince(readStamp)) {
        subst.seenInter.maybeGet(pair) match {
        | Some(ty) -> !result = ty
        | None() -> subst.!seenInter[pair] = result
        }
      };
      (result, true)
    })
  }

  // A retained type must keep its symbolic operands when eager intersection
  // inspected provisional inference or an unresolved recursive premise. Solver
  // queries can still use inter directly for their point-specific answer.
  static fun interForTypeConstruction(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    readStamp = subst.typeQueryReadStamp();
    result = TType::inter(subst, tenv, ty1, ty2);
    if (subst.canCacheTypeQuerySince(readStamp)) result else {
      TType::unexpandedInter(ty1, ty2)
    }
  }

  private static fun inter_(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    expandPrim = (primClassName) -> TType::inst(primClassName, TArgs(Array[]));
    if (ty2.isTop() || ty1.isBottom()) return ty1;
    if (ty1.isTop() || ty2.isBottom()) return ty2;
    // A match guard is a readonly context, so these binding reads -- which
    // register an observed dependency -- run in the arm bodies instead. The
    // order in which they are consulted is the order of the original arms.
    var1 = ty1.getSingleVar();
    var2 = ty2.getSingleVar();
    (var1, var2) match {
    | (Some(tvar1), Some(tvar2)) ->
      if (subst.isUnbound(tvar1) && subst.isUnbound(tvar2)) {
        return TType::unexpandedInter(ty1, ty2)
      }
    | _ -> void
    };
    var1 match {
    | Some(tvar) ->
      if (subst.isUnbound(tvar)) return TType::var(tvar.setConstraint(ty2));
      if (subst.isOpen(tvar) && tvar.isForField()) {
        return TType::var(tvar.setConstraint(ty2))
      }
    | None() -> void
    };
    var2 match {
    | Some(tvar) ->
      if (subst.isUnbound(tvar)) return TType::var(tvar.setConstraint(ty1));
      if (subst.isOpen(tvar) && tvar.isForField()) {
        return TType::var(tvar.setConstraint(ty1))
      }
    | None() -> void
    };
    if (tenv.seenInter.contains((ty1, ty2))) {
      subst.recordRecursiveTypeQuery(TQIntersection(ty1, ty2));
      return TType::unexpandedInter(ty1, ty2);
    };
    !tenv.seenInter = tenv.seenInter.set((ty1, ty2));
    subst.introduceTypeQueryAssumption(TQIntersection(ty1, ty2));
    clauses1 = ty1.expandToClauses(subst, tenv, Covariant());
    clauses2 = ty2.expandToClauses(subst, tenv, Covariant());
    // Returning the primitive requires a live subtype justification against
    // the object's constraint, which may itself contain inference candidates.
    // Keep its commitments; a discarded clone's success is not sufficient.
    (clauses1.primKind(), clauses2.getObject()) match {
    | (Some(primKind), Some(stype)) ->
      TType::isSub(
        subst,
        tenv,
        expandPrim(primKind),
        TType::single(stype),
      ) match {
      | STOk() -> return ty1
      | STError _ -> void
      }
    | _ -> void
    };
    (clauses2.primKind(), clauses1.getObject()) match {
    | (Some(primKind), Some(stype)) ->
      TType::isSub(
        subst,
        tenv,
        expandPrim(primKind),
        TType::single(stype),
      ) match {
      | STOk() -> return ty2
      | STError _ -> void
      }
    | _ -> void
    };
    clauses = Clauses::interWith(clauses1, clauses2, (left, right) ->
      TFields::inter(subst, tenv, left, right)
    );
    TType::fromClauses(ty1.pos, clauses);
  }

  static fun interN(
    subst: mutable Subst,
    tenv: TEnv,
    pos: PosRange,
    tys: readonly Sequence<TType>,
  ): TType {
    tysIt = tys.iterator();
    tysIt.next() match {
    | None() -> TType::top(pos)
    | Some(first) ->
      tysIt.reduce((res, ty) -> TType::inter(subst, tenv, res, ty), first)
    }
  }
}

extension class TFuns {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFuns,
    f2: TFuns,
  ): ?TFuns {
    TFun::inter(subst, tenv, f1.fun_, f2.fun_).map(f -> TFuns(f, f1.pos))
  }
}

extension class TField {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    x: TField,
    y: TField,
  ): TField {
    if (x.name != y.name) internal_error("field names must match");
    // The union should be processed first, it leads to better inference
    set = TType::union(subst, tenv, x.set, y.set);
    get = if (tenv.expandInter) {
      TType::interForTypeConstruction(subst, tenv, x.get, y.get)
    } else {
      TType::unexpandedInter(x.get, y.get)
    };
    TField::interContracts(x, y, get, set)
  }

  static fun interIndex(
    subst: mutable Subst,
    tenv: TEnv,
    x: TField,
    y: TField,
  ): TField {
    get = TType::interForTypeConstruction(subst, tenv, x.get, y.get);
    set = TType::union(subst, tenv, x.set, y.set);
    TField::interContracts(x, y, get, set)
  }

  // Assemble already-normalized read/write contracts without solver access.
  static fun interContracts(
    x: TField,
    y: TField,
    get: TType,
    set: TType,
  ): TField {
    isOptional = x.isOptional && y.isOptional;
    TField{
      pos => x.pos,
      name => x.name,
      isOptional,
      get,
      set,
      access => x.access.combine(y.access),
      // Either conjunct can establish that the present property is copied.
      mayBeOmittedByCopy => x.mayBeOmittedByCopy && y.mayBeOmittedByCopy,
    }
  }
}

extension class STypes {
  // Structural intersection delegates only object-field normalization. None
  // denotes bottom; primitive and parameter algebra never accesses a solver.
  static fun interWith(
    stypes1: STypes,
    stypes2: STypes,
    meetFields: (TFields, TFields) -> ?TFields,
  ): ?STypes {
    stypes1.stypes.mapInterOption(stypes2.stypes, (sty1, sty2) -> {
      invariant(
        sty1.tag() == sty2.tag(),
        "mapInterOption ensures iteration with identical tags",
      );
      (sty1, sty2) match {
      | (TPrimUnit _, TPrimUnit _) -> Some(sty1)

      | (p1 @ TPrimValue _, p2 @ TPrimValue _) -> TPrimValue::inter(p1, p2)

      | (obj1 @ TObject _, obj2 @ TObject _) ->
        TObject::interWith(obj1, obj2, meetFields)

      | _ -> internal_error("Internal error")
      }
    }) match {
    | Some(stypes) if (!stypes.isEmpty()) -> Some(STypes(stypes))
    | _ -> None()
    }
  }
}

extension class Clause {
  // Returns None if the result is bottom
  static fun interWith(
    clause1: Clause,
    clause2: Clause,
    meetFields: (TFields, TFields) -> ?TFields,
  ): ?Clause {
    vars = clause1.vars.union(clause2.vars);
    (clause1.stypes, clause2.stypes) match {
    | (None(), stypes)
    | (stypes, None()) ->
      Some(Clause(vars, stypes))
    | (Some(stypes1), Some(stypes2)) ->
      STypes::interWith(stypes1, stypes2, meetFields).map(stypes ->
        Clause(vars, Some(stypes))
      )
    }
  }
}

extension class Clauses {
  // Preserve distribution order and merge equal parameter sets structurally.
  static fun interWith(
    clauses1: Clauses,
    clauses2: Clauses,
    meetFields: (TFields, TFields) -> ?TFields,
  ): Clauses {
    result = SortedMap[];
    for (clause1 in clauses1) {
      for (clause2 in clauses2) {
        Clause::interWith(clause1, clause2, meetFields) match {
        | None() -> void
        | Some(inter) ->
          if (!result.containsKey(inter.vars)) {
            !result[inter.vars] = inter;
          } else {
            !result[inter.vars] = Clause::union(result[inter.vars], inter)
          }
        }
      }
    };
    Clauses(
      InternalKeyedArrayMap::createFromSortedIterator(
        result.items().map(x -> x.i1).iterator(),
      ),
    )
  }
}

extension class TPrimValue {
  static fun inter(t1: TPrimValue, t2: TPrimValue): ?TPrimValue {
    if (t1.kind != t2.kind) {
      // Different kinds (e.g. number and string) have no common values
      return None()
    };
    (t1.literals, t2.literals) match {
    | (_, None()) -> Some(t1)
    | (None(), Some _) -> Some(t2)
    | (Some(lits1), Some(lits2)) ->
      lits1.inter(lits2).map(lits -> TPrimValue(t1.kind, Some(lits), t1.pos))
    }
  }
}

extension base class SType {
  // Whether values of the two simple types can be strictly equal (`===`).
  // Only provably disjoint value sets report no overlap; reference types
  // always overlap, since a single value can inhabit both sides (width
  // subtyping for objects, never-returning functions, `Promise<never>`) —
  // even where tsc reports TS2367. Conversely, null and undefined overlap
  // nothing but themselves: unlike tsc, `x === null` warns when `x` cannot
  // be null. Callers are expected to exclude void operands (comparing void
  // is an error — void is non-observable).
  static fun overlaps(
    subst: mutable Subst,
    tenv: TEnv,
    sty1: SType,
    sty2: SType,
  ): Bool {
    (sty1, sty2) match {
    | (TPrimUnit(kind1, _), TPrimUnit(kind2, _)) -> kind1 == kind2
    | (TPrimUnit _, _)
    | (_, TPrimUnit _) ->
      false
    | (prim1 @ TPrimValue _, prim2 @ TPrimValue _) ->
      TPrimValue::inter(prim1, prim2).isSome()
    | (prim @ TPrimValue _, obj @ TObject _)
    | (obj @ TObject _, prim @ TPrimValue _) ->
      // A primitive overlaps an object type only through its boxed class:
      // a value of type `Number` can be a primitive number, but a value of
      // type `{ a: string }` cannot
      boxed = TType::inst(prim.asClassName(), TArgs(Array[]));
      TType::isSub(subst, tenv, boxed, TType::single(obj)) is STOk()
    | (TObject _, TObject _) ->
      // TODO: some object pairs are provably disjoint and could be
      // reported: a shared field with non-overlapping types can leave no
      // common value (e.g. `{ a?: number }` vs `{ a: string }`)
      true
    }
  }
}

extension class TIndexes {
  static fun interWith(
    indexes1: TIndexesBase,
    indexes2: TIndexesBase,
    meetIndex: (TField, TField) -> TField,
  ): TIndexes {
    stringIndex = TFields::interOptIndexWith(
      indexes1.stringIndex,
      indexes2.stringIndex,
      meetIndex,
    );
    numberIndex = TFields::interOptIndexWith(
      indexes1.numberIndex,
      indexes2.numberIndex,
      meetIndex,
    );
    symbolIndex = TFields::interOptIndexWith(
      indexes1.symbolIndex,
      indexes2.symbolIndex,
      meetIndex,
    );
    (stringIndex, numberIndex) match {
    | (Some(strIdx), Some(numIdx)) ->
      !numberIndex = Some(meetIndex(strIdx, numIdx))
    | _ -> void
    };
    TIndexes{stringIndex, numberIndex, symbolIndex}
  }
}

extension class TFields {
  private static fun interNamedFieldsWith(
    namedFields1: InternalKeyedArrayMap<FieldNameString, TField>,
    namedFields2: InternalKeyedArrayMap<FieldNameString, TField>,
    indexFor1: (FieldNameString) -> ?TField,
    indexFor2: (FieldNameString) -> ?TField,
    meetField: (TField, TField) -> TField,
    meetIndex: (TField, TField) -> TField,
  ): InternalKeyedArrayMap<FieldNameString, TField> {
    namedFields1.merge(namedFields2, ior ->
      ior match {
      | Left(f1) ->
        indexFor2(f1.name) match {
        | None() -> f1
        | Some(idx) -> meetIndex(f1, idx)
        }
      | Right(f2) ->
        indexFor1(f2.name) match {
        | None() -> f2
        | Some(idx) -> meetIndex(f2, idx)
        }
      | Both(x, y) -> meetField(x, y)
      }
    )
  }

  // Meet of two callability modes (shared by the call and new arms of
  // TFields::inter); None drops the whole branch as uninhabited. `isArray`
  // is the branch's merged array brand: for array-branded branches
  // definitely-absent is runtime-hard — array exotic objects implement
  // neither [[Call]] nor [[Construct]] — so a signature meeting CAbsent is
  // uninhabited. Elsewhere CAbsent is a brand-like approximation, not a
  // proof of uninhabitation (structural width subtyping can launder
  // callables into class-instance types, see isSubCallability), so the
  // signature is kept rather than collapsing an inhabited intersection —
  // hybrid (() => void) & C types, and instanceof narrowing of a callable
  // against a class — to never.
  private static fun interCallabilityWith(
    m1: Callability,
    m2: Callability,
    isArray: ?Bool,
    meetFunctions: (TFuns, TFuns) -> ?TFuns,
  ): ?Callability {
    (m1, m2) match {
    | (CUnknown(), m)
    | (m, CUnknown()) ->
      Some(m)
    | (CAbsent(), CAbsent()) -> Some(CAbsent())
    | (CAbsent(), p @ CPresent _)
    | (p @ CPresent _, CAbsent())
    // Proven-callable meets definitely-not-callable: same brand-aware rule
    // as the CPresent arm above.
    | (CAbsent(), p @ CFunction())
    | (p @ CFunction(), CAbsent()) ->
      if (isArray == Some(true)) None() else Some(p)
    // A known signature is strictly more precise than bare provable
    // callability.
    | (CFunction(), p @ CPresent _)
    | (p @ CPresent _, CFunction()) ->
      Some(p)
    | (CFunction(), CFunction()) -> Some(CFunction())
    | (CPresent(f1), CPresent(f2)) ->
      meetFunctions(f1, f2).map(f -> CPresent(f))
    }
  }

  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): ?TFields {
    TFields::interWith(
      fields1,
      fields2,
      (left, right) -> TField::inter(subst, tenv, left, right),
      (left, right) -> TField::interIndex(subst, tenv, left, right),
      (left, right) -> TFuns::inter(subst, tenv, left, right),
    )
  }

  // Field/index assembly and callability brands have no solver authority.
  // The three operations are distinct: named and indexed reads have different
  // normalization policies, while signatures require a subtype decision.
  static fun interWith(
    fields1: TFields,
    fields2: TFields,
    meetField: (TField, TField) -> TField,
    meetIndex: (TField, TField) -> TField,
    meetFunctions: (TFuns, TFuns) -> ?TFuns,
  ): ?TFields {
    isArray = (fields1.isArray, fields2.isArray) match {
    | (Some(true), Some(false))
    | (Some(false), Some(true)) ->
      return None()
    | (None(), ia)
    | (ia, _) ->
      ia
    };
    // Process fields first so that tuple index type variables are resolved
    // before call/new signatures with union types.
    fields = TFields::interNamedFieldsWith(
      fields1.fields,
      fields2.fields,
      name -> fields1.indexForFieldName(name.value),
      name -> fields2.indexForFieldName(name.value),
      meetField,
      meetIndex,
    );
    symbolFields = TFields::interNamedFieldsWith(
      fields1.symbolFields,
      fields2.symbolFields,
      _ -> fields1.symbolIndex,
      _ -> fields2.symbolIndex,
      meetField,
      meetIndex,
    );
    indexes = TIndexes::interWith(fields1, fields2, meetIndex);
    call = TFields::interCallabilityWith(
      fields1.call,
      fields2.call,
      isArray,
      meetFunctions,
    ) match {
    | None() -> return None()
    | Some(m) -> m
    };
    new = TFields::interCallabilityWith(
      fields1.new,
      fields2.new,
      isArray,
      meetFunctions,
    ) match {
    | None() -> return None()
    | Some(m) -> m
    };
    Some(
      TFields{
        fields,
        symbolFields,
        stringIndex => indexes.stringIndex,
        numberIndex => indexes.numberIndex,
        symbolIndex => indexes.symbolIndex,
        call,
        new,
        isArray,
      },
    )
  }

  fun interIsArray(isArray: Bool): ?TFields {
    this.isArray match {
    | None() -> Some(this with {isArray => Some(isArray)})
    | Some(ia) -> if (ia == isArray) Some(this) else None()
    }
  }

  static fun interOptIndexWith(
    idx1: ?TField,
    idx2: ?TField,
    meetIndex: (TField, TField) -> TField,
  ): ?TField {
    (idx1, idx2) match {
    | (None(), None()) -> None()
    | (Some(index), None())
    | (None(), Some(index)) ->
      Some(index)
    | (Some(index1), Some(index2)) -> Some(meetIndex(index1, index2))
    }
  }
}

extension class TObject {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    obj1: TObject,
    obj2: TObject,
  ): ?TObject {
    TObject::interWith(obj1, obj2, (left, right) ->
      TFields::inter(subst, tenv, left, right)
    )
  }

  // Distribution has no checking authority. Only the supplied field meet may
  // normalize contracts; both inference and read-only normalization can reuse
  // this traversal without exposing a substitution to it.
  static fun interWith(
    obj1: TObject,
    obj2: TObject,
    meetFields: (TFields, TFields) -> ?TFields,
  ): ?TObject {
    branches = mutable Vector[];
    for (fields1 in obj1.branches) {
      for (fields2 in obj2.branches) {
        meetFields(fields1, fields2) match {
        | None() -> void
        | Some(x) ->
          branches.push(x);
          // Intersecting unions of objects cross-products their branches; cap
          // the result like the distributed spread does, instead of
          // materializing an exponential number of branches (an n-way
          // intersection of two-branch unions yields 2^n).
          if (branches.size() > kMaxObjectBranches) {
            fatalError(
              Array[
                (
                  obj1.pos,
                  "This intersection produces too many object branches; the type is too complex to represent",
                ),
              ],
              TSCode(2590),
            )
          }
        }
      }
    };
    if (branches.isEmpty()) {
      None()
    } else {
      Some(TObject(ArraySet::createFromMVector(branches), None(), obj1.pos))
    }
  }
}

extension class TFun {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFun,
    f2: TFun,
  ): ?TFun {
    TFun::interWith(f1, f2, (left, right) ->
      TFun::isSub(subst, tenv, left, right) is STOk()
    )
  }

  static fun interWith(
    f1: TFun,
    f2: TFun,
    isSubtype: (TFun, TFun) -> Bool,
  ): ?TFun {
    merged = f1.cgNodes.union(f2.cgNodes);
    if (isSubtype(f1, f2)) {
      Some(f1 with {cgNodes => merged})
    } else if (isSubtype(f2, f1)) {
      Some(f2 with {cgNodes => merged})
    } else {
      None()
    }
  }
}

module end;
