/***************************************************************************/
// Intersection operations for types.
/***************************************************************************/

module SKJS;

/* Unexpanded intersection */
//
// Interpretation:
// 〚 inter 〛 = ⨅ t for t in tys
//
// Holds a flattened set of types: (A & B) & C is stored as {A, B, C}.
//
// Invariant:
// - none of the inner TType is either bottom, top, or a single inter
// - the size of tys is >= 2
class TInter private (tys: ArraySet<TType>) extends TInst {
  static fun create(ty1: TType, ty2: TType): ?TInter {
    if (ty1.isTop() || ty2.isTop()) {
      internal_error(`Unexpected Top in TInter: ${ty1} inter ${ty2}`)
    };
    if (ty1.isBottom() || ty2.isBottom()) {
      return None()
    };
    tys = (ty1.getSingleInter(), ty2.getSingleInter()) match {
    | (Some(TInter(tys1)), Some(TInter(tys2))) -> tys1.union(tys2)
    | (Some(TInter(tys1)), None()) -> tys1.set(ty2)
    | (None(), Some(TInter(tys2))) -> tys2.set(ty1)
    | _ ->
      vec = mutable Vector[ty1, ty2];
      ArraySet::createFromMVector(vec)
    };
    Some(TInter(tys))
  }

  // Compute the intersection of all types in this group.
  fun expand(subst: mutable Subst, tenv: TEnv): TType {
    iter = this.tys.values();
    result = iter.next().fromSome();
    for (ty in iter) {
      !result = TType::inter(subst, tenv, result, ty);
    };
    result
  }

  // Maps f over all types in the intersection, preserving invariants.
  // Returns:
  //   Success(None())       if result is bottom
  //   Success(Some(inter))  if result is a valid TInter (>= 2 types)
  //   Failure(ty)           if result collapsed to a single type
  fun map(f: TType -> TType): Result<?TInter, TType> {
    result = mutable Vector[];
    for (ty in this.tys) {
      mapped = f(ty);
      if (mapped.isTop()) continue;
      if (mapped.isBottom()) return Success(None());
      mapped.getSingleInter() match {
      | Some(TInter(innerTys)) -> result.extend(innerTys)
      | None() -> result.push(mapped)
      }
    };
    result.size() match {
    | 0 -> Success(None())
    | 1 -> Failure(result[0])
    | _ -> Success(Some(TInter(ArraySet::createFromMVector(result))))
    }
  }
}

extension class TType {
  // Unexpanded intersection. Flattens nested TInters:
  // (A & B) & (C & D) → A & B & C & D
  static private fun unexpandedInter(ty1: TType, ty2: TType): TType {
    TInter::create(ty1, ty2) match {
    | None() -> TType::bottom(ty1.pos)
    | Some(tinter) ->
      TType::create(ty1.pos, TInsts::single(tinter), Clauses::empty())
    }
  }

  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    if (ty1 == ty2) return ty1;
    pair = (ty1, ty2);
    hasTVar = ty1.getSingleVar().isSome() || ty2.getSingleVar().isSome();
    if (!hasTVar) {
      subst.seenInter.maybeGet(pair) match {
      | Some(ty) -> return ty
      | None() -> void
      }
    };
    result = TType::inter_(subst, tenv, ty1, ty2);
    // Don't cache when either operand is a TVar: TVar binding state
    // changes over time, which would make the cached result stale.
    if (hasTVar) {
      result
    } else {
      subst.seenInter.maybeGet(pair) match {
      | Some(ty) ->
        // Re-entrant cycle: a recursive call during inter_ already cached a
        // result for this pair. Return the already-cached (and already-used)
        // result for consistency with intermediate callers that consumed it.
        ty
      | None() ->
        subst.!seenInter[pair] = result;
        result
      }
    }
  }

  private static fun inter_(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    expandPrim = (primClassName) -> TType::inst(primClassName, TArgs(Array[]));
    if (ty2.isTop() || ty1.isBottom()) return ty1;
    if (ty1.isTop() || ty2.isBottom()) return ty2;
    if (tenv.seenInter.contains((ty1, ty2))) {
      return TType::unexpandedInter(ty1, ty2);
    };
    !tenv.seenInter = tenv.seenInter.set((ty1, ty2));
    (ty1.getSingleVar(), ty2.getSingleVar()) match {
    | (
      Some(tvar1),
      Some(tvar2),
    ) if (subst.isUnbound(tvar1) && subst.isUnbound(tvar2)) ->
      return TType::unexpandedInter(ty1, ty2)
    | (Some(tvar), _) -> return TType::var(tvar.addConstraint(ty2))
    | (_, Some(tvar)) -> return TType::var(tvar.addConstraint(ty1))
    | _ -> void
    };
    // Absorption: (A | B) & B = B
    if (ty1.containsType(ty2)) return ty2;
    if (ty2.containsType(ty1)) return ty1;
    clauses1 = ty1.expandToClauses(subst, tenv, Covariant());
    clauses2 = ty2.expandToClauses(subst, tenv, Covariant());
    // TODO: These speculative isSub checks use subst directly. They only
    // involve concrete types (expandPrim produces e.g. Number, not TVars),
    // so TVar growth cannot occur. If this changes, consider using clone().
    (clauses1.primKind(), clauses2.getObject()) match {
    | (Some(primKind), Some(stype)) ->
      TType::isSub(
        subst,
        tenv,
        expandPrim(primKind),
        TType::single(stype),
      ) match {
      | STOk() -> return ty1
      | STError _ -> void
      }
    | _ -> void
    };
    (clauses2.primKind(), clauses1.getObject()) match {
    | (Some(primKind), Some(stype)) ->
      TType::isSub(
        subst,
        tenv,
        expandPrim(primKind),
        TType::single(stype),
      ) match {
      | STOk() -> return ty2
      | STError _ -> void
      }
    | _ -> void
    };
    clauses = Clauses::inter(subst, tenv, clauses1, clauses2);
    TType::fromClauses(ty1.pos, clauses);
  }
}

extension class TAlgebraic {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    a1: TAlgebraic,
    a2: TAlgebraic,
  ): ?TAlgebraic {
    a1.branches
      .mapInterOption(a2.branches, (x, y) -> TConstr::inter(subst, tenv, x, y))
      .map(branches -> TAlgebraic(branches, a1.pos))
  }
}

extension class TConstr {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    x: TConstr,
    y: TConstr,
  ): ?TConstr {
    invariant(x.tag == y.tag, "TConstr::inter expects identical tags");
    TFields::inter(subst, tenv, x.fields, y.fields).map(fields ->
      TConstr(x.tag, x.tagPos, fields)
    )
  }
}

extension class TFuns {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFuns,
    f2: TFuns,
  ): ?TFuns {
    TFun::inter(subst, tenv, f1.fun_, f2.fun_).map(f -> TFuns(f, f1.pos))
  }
}

extension class TField {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    x: TField,
    y: TField,
  ): TField {
    if (x.name != y.name) internal_error("field names must match");
    TField{
      pos => x.pos,
      name => x.name,
      isOptional => x.isOptional && y.isOptional,
      type => TType::inter(subst, tenv, x.type, y.type),
    }
  }
}

extension class TIndexField {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    x: TIndexField,
    y: TIndexField,
  ): ?TIndexField {
    /* Currently over-approximating by a union
       for { [f: 0 | 1]: 4 | 5 } & { [g: 1 | 2]: 5 | 6 },
       the result would be { [f: 0]: 4 | 5, [fg: 1]: 5, [g: 2]: 5 | 6}
       but we return { [f: 0 | 1 | 2]: 4 | 5 | 6 } */
    valueType = TType::union(subst, tenv, x.valueType, y.valueType);
    keyType = TType::union(subst, tenv, x.keyType, y.keyType);
    Some(TIndexField{pos => x.pos, keyName => x.keyName, keyType, valueType})
  }
}

extension class STypes {
  // inter returns None when the intersection of the args is bottom
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): ?STypes {
    stypes1.stypes.mapInterOption(stypes2.stypes, (sty1, sty2) -> {
      invariant(
        sty1.tag() == sty2.tag(),
        "mapInterOption ensures iteration with identical tags",
      );
      (sty1, sty2) match {
      | (TPrimUnit _, TPrimUnit _) -> Some(sty1)

      | (p1 @ TPrimValue _, p2 @ TPrimValue _) -> TPrimValue::inter(p1, p2)

      | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
        Some(TTuple::inter(subst, tenv, tuple1, tuple2))

      | (TPromise(ty1, pos1), TPromise(ty2, _)) ->
        Some(TPromise(TType::inter(subst, tenv, ty1, ty2), pos1))

      | (obj1 @ TObject _, obj2 @ TObject _) ->
        TObject::inter(subst, tenv, obj1, obj2)
      | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->
        TAlgebraic::inter(subst, tenv, a1, a2)

      | _ -> internal_error("Internal error")
      }
    }) match {
    | Some(stypes) if (!stypes.isEmpty()) -> Some(STypes(stypes))
    | _ -> None()
    }
  }
}

extension class Clause {
  // Returns None if the result is bottom
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    clause1: Clause,
    clause2: Clause,
  ): ?Clause {
    vars = clause1.vars.union(clause2.vars);
    (clause1.stypes, clause2.stypes) match {
    | (None(), stypes)
    | (stypes, None()) ->
      Some(Clause(vars, stypes))
    | (Some(stypes1), Some(stypes2)) ->
      STypes::inter(subst, tenv, stypes1, stypes2).map(stypes ->
        Clause(vars, Some(stypes))
      )
    }
  }
}

extension class Clauses {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): Clauses {
    result = SortedMap[];
    for (clause1 in clauses1) {
      for (clause2 in clauses2) {
        Clause::inter(subst, tenv, clause1, clause2) match {
        | None() -> void
        | Some(inter) ->
          if (!result.containsKey(inter.vars)) {
            !result[inter.vars] = inter;
          } else {
            !result[inter.vars] = Clause::union(
              subst,
              tenv,
              result[inter.vars],
              inter,
            )
          }
        }
      }
    };
    Clauses(
      InternalKeyedArrayMap::createFromSortedIterator(
        result.items().map(x -> x.i1).iterator(),
      ),
    )
  }
}

extension class TPrimValue {
  static fun inter(t1: TPrimValue, t2: TPrimValue): ?TPrimValue {
    if (t1.kind != t2.kind) {
      internal_error(
        "Intersection must be called on primitive value types of same kind",
      )
    };
    (t1.literals, t2.literals) match {
    | (_, None()) -> Some(t1)
    | (None(), Some _) -> Some(t2)
    | (Some(lits1), Some(lits2)) ->
      lits1.inter(lits2).map(lits -> TPrimValue(t1.kind, Some(lits), t1.pos))
    }
  }
}

extension class TFields {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): ?TFields {
    fields = fields1.fields.mapUnion(fields2.fields, (x, y) ->
      TField::inter(subst, tenv, x, y)
    );
    symbolFields = fields1.symbolFields.mapUnion(
      fields2.symbolFields,
      (x, y) -> TField::inter(subst, tenv, x, y),
    );
    // TODO: handle intersection between normal fields and index fields
    indexes = {
      index1o = fields1.maybeSingleIndex();
      index2o = fields2.maybeSingleIndex();
      (index1o, index2o) match {
      | (None(), None()) -> None()
      | (Some(index), None())
      | (None(), Some(index)) ->
        Some(index)
      | (Some(index1), Some(index2)) ->
        TIndexField::inter(subst, tenv, index1, index2)
      } match {
      | None() -> Array[]
      | Some(index) -> Array[index]
      }
    };
    call = (fields1.call, fields2.call) match {
    | (None(), call)
    | (call, None()) ->
      call
    | (Some((opt1, call1)), Some((opt2, call2))) ->
      TFuns::inter(subst, tenv, call1, call2) match {
      | None() -> return None()
      | Some(f) -> Some((opt1 && opt2, f))
      }
    };
    new = (fields1.new, fields2.new) match {
    | (None(), new)
    | (new, None()) ->
      new
    | (Some((opt1, new1)), Some((opt2, new2))) ->
      TFuns::inter(subst, tenv, new1, new2) match {
      | None() -> return None()
      | Some(f) -> Some((opt1 && opt2, f))
      }
    };
    Some(TFields{fields, symbolFields, indexes, call, new})
  }
}

extension class TObject {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    obj1: TObject,
    obj2: TObject,
  ): ?TObject {
    TFields::inter(subst, tenv, obj1.fields, obj2.fields).map(fields ->
      TObject(fields, obj1.pos)
    )
  }
}

extension class TFun {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFun,
    f2: TFun,
  ): ?TFun {
    TFun::isSub(subst, tenv, f1, f2) match {
    | STOk() -> return Some(f1)
    | STError _ -> void
    };
    TFun::isSub(subst, tenv, f2, f1) match {
    | STOk() -> return Some(f2)
    | STError _ -> void
    };
    None()
  }
}

extension base class ArrayType {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    arr1: ArrayType,
    arr2: ArrayType,
  ): ArrayType {
    (
      arr1.maybeGetEltType(subst, tenv, Contravariant()),
      arr2.maybeGetEltType(subst, tenv, Contravariant()),
    ) match {
    | (Some(elt1), Some(elt2)) ->
      ArrayType::createFromElt(
        TType::inter(subst, tenv, elt1, elt2),
        arr1.getPos(),
      )
    | _ ->
      ArrayType::createFromFull(
        TType::inter(subst, tenv, arr1.full(), arr2.full()),
      )
    }
  }
}

extension class TTuple {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    tuple1: TTuple,
    tuple2: TTuple,
  ): TTuple {
    result = mutable Vector[];
    for (i in Range(0, min(tuple1.tuple.size(), tuple2.tuple.size()))) {
      result.push(TType::inter(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]));
    };
    if (tuple1.tuple.size() < tuple2.tuple.size()) {
      for (i in Range(tuple1.tuple.size(), tuple2.tuple.size())) {
        result.push(tuple2.tuple[i]);
      }
    } else if (tuple2.tuple.size() < tuple1.tuple.size()) {
      for (i in Range(tuple2.tuple.size(), tuple1.tuple.size())) {
        result.push(tuple1.tuple[i]);
      }
    };
    TTuple(result.toArray(), tuple1.pos)
  }
}

module end;
