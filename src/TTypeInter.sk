/***************************************************************************/
// Intersection operations for types.
/***************************************************************************/

module SKJS;

/* Unexpanded intersection */
//
// Interpretation:
// 〚 inter 〛 = ⨅ t for t in tys
//
// Holds a flattened set of types: (A & B) & C is stored as {A, B, C}.
//
// Invariant:
// - none of the inner TType is either bottom, top, or a single inter
// - the size of tys is >= 2
class TInter private (tys: ArraySet<TType>) extends TInst {
  static fun create(ty1: TType, ty2: TType): Result<TInter, TType> {
    if (ty1.isBottom() || ty2.isTop()) {
      return Failure(ty1)
    };
    if (ty2.isBottom() || ty1.isTop()) {
      return Failure(ty2)
    };
    tys = (ty1.getSingleInter(), ty2.getSingleInter()) match {
    | (Some(TInter(tys1)), Some(TInter(tys2))) -> tys1.union(tys2)
    | (Some(TInter(tys1)), None()) -> tys1.set(ty2)
    | (None(), Some(TInter(tys2))) -> tys2.set(ty1)
    | _ ->
      vec = mutable Vector[ty1, ty2];
      ArraySet::createFromMVector(vec)
    };
    Success(TInter(tys))
  }

  // Compute the intersection of all types in this group.
  fun expand(subst: mutable Subst, tenv: TEnv): TType {
    !tenv.expandInter = true;
    TType::interN(
      subst,
      tenv,
      this.tys.values().next().fromSome().pos,
      this.tys,
    )
  }

  // Maps f over all types in the intersection, preserving invariants.
  // Returns:
  //   Success(inter)  if result is a valid TInter (>= 2 types)
  //   Failure(ty)     otherwise
  fun map(f: TType -> TType): Result<TInter, TType> {
    result = mutable Vector[];
    for (ty in this.tys) {
      mapped = f(ty);
      if (mapped.isBottom()) return Failure(mapped);
      if (mapped.isTop()) continue;
      mapped.getSingleInter() match {
      | Some(TInter(innerTys)) -> result.extend(innerTys)
      | None() -> result.push(mapped)
      }
    };
    if (result.isEmpty()) {
      Failure(TType::top(this.tys.values().next().fromSome().pos))
    } else {
      arraySet = ArraySet::createFromMVector(result);
      arraySet.getUnique() match {
      | Some(ty) -> Failure(ty)
      | None() ->
        invariant(
          !arraySet.isEmpty(),
          "ArraySet::createFromMVector created an empty ArraySet from a non-empty Vector",
        );
        Success(TInter(arraySet))
      }
    }
  }
}

extension class TType {
  // Unexpanded intersection. Flattens nested TInters:
  // (A & B) & (C & D) → A & B & C & D
  static fun unexpandedInter(ty1: TType, ty2: TType): TType {
    TInter::create(ty1, ty2) match {
    | Failure(ty) -> ty
    | Success(tInter) ->
      TType::create(ty1.pos, TInsts::single(tInter), Clauses::empty())
    }
  }

  // Caching is correct for compound types that contain TVars (but not bare
  // TVars, which are excluded below). inter_ expands TVars via
  // expandToClauses with Covariant(), which seals them (SVOpen -> SVClosed
  // via Subst::get). Once sealed, a TVar cannot grow, so the cached result
  // remains valid for the rest of the computation. Bare TVars are excluded
  // because inter_ handles them specially (adding constraints or creating
  // unexpanded intersections) without sealing.
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    if (ty1 == ty2) return ty1;
    pair = (ty1, ty2);
    hasTVar = ty1.getSingleVar().isSome() || ty2.getSingleVar().isSome();
    if (!hasTVar) {
      subst.seenInter.maybeGet(pair) match {
      | Some(ty) -> return ty
      | None() -> void
      }
    };
    result = TType::inter_(subst, tenv, ty1, ty2);
    if (hasTVar) {
      result
    } else {
      subst.seenInter.maybeGet(pair) match {
      | Some(ty) ->
        // Re-entrant cycle: a recursive call during inter_ already cached a
        // result for this pair. Return the already-cached (and already-used)
        // result for consistency with intermediate callers that consumed it.
        ty
      | None() ->
        subst.!seenInter[pair] = result;
        result
      }
    }
  }

  private static fun inter_(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    expandPrim = (primClassName) -> TType::inst(primClassName, TArgs(Array[]));
    if (ty2.isTop() || ty1.isBottom()) return ty1;
    if (ty1.isTop() || ty2.isBottom()) return ty2;
    (ty1.getSingleVar(), ty2.getSingleVar()) match {
    | (
      Some(tvar1),
      Some(tvar2),
    ) if (subst.isUnbound(tvar1) && subst.isUnbound(tvar2)) ->
      return TType::unexpandedInter(ty1, ty2)
    | (Some(tvar), _) if (subst.isUnbound(tvar)) ->
      return TType::var(tvar.setConstraint(ty2))
    | (Some(tvar), _) if (subst.isOpen(tvar) && tvar.isForField()) ->
      return TType::var(tvar.setConstraint(ty2))
    | (_, Some(tvar)) if (subst.isUnbound(tvar)) ->
      return TType::var(tvar.setConstraint(ty1))
    | (_, Some(tvar)) if (subst.isOpen(tvar) && tvar.isForField()) ->
      return TType::var(tvar.setConstraint(ty1))
    | _ -> void
    };
    if (tenv.seenInter.contains((ty1, ty2))) {
      return TType::unexpandedInter(ty1, ty2);
    };
    !tenv.seenInter = tenv.seenInter.set((ty1, ty2));
    clauses1 = ty1.expandToClauses(subst, tenv, Covariant());
    clauses2 = ty2.expandToClauses(subst, tenv, Covariant());
    // TODO: These speculative isSub checks use subst directly. They only
    // involve concrete types (expandPrim produces e.g. Number, not TVars),
    // so TVar growth cannot occur. If this changes, consider using clone().
    (clauses1.primKind(), clauses2.getObject()) match {
    | (Some(primKind), Some(stype)) ->
      TType::isSub(
        subst,
        tenv,
        expandPrim(primKind),
        TType::single(stype),
      ) match {
      | STOk() -> return ty1
      | STError _ -> void
      }
    | _ -> void
    };
    (clauses2.primKind(), clauses1.getObject()) match {
    | (Some(primKind), Some(stype)) ->
      TType::isSub(
        subst,
        tenv,
        expandPrim(primKind),
        TType::single(stype),
      ) match {
      | STOk() -> return ty2
      | STError _ -> void
      }
    | _ -> void
    };
    clauses = Clauses::inter(subst, tenv, clauses1, clauses2);
    TType::fromClauses(ty1.pos, clauses);
  }

  static fun interN(
    subst: mutable Subst,
    tenv: TEnv,
    pos: PosRange,
    tys: readonly Sequence<TType>,
  ): TType {
    tysIt = tys.iterator();
    tysIt.next() match {
    | None() -> TType::top(pos)
    | Some(first) ->
      tysIt.reduce((res, ty) -> TType::inter(subst, tenv, res, ty), first)
    }
  }
}

extension class TFuns {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFuns,
    f2: TFuns,
  ): ?TFuns {
    TFun::inter(subst, tenv, f1.fun_, f2.fun_).map(f -> TFuns(f, f1.pos))
  }
}

extension class TField {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    x: TField,
    y: TField,
  ): TField {
    if (x.name != y.name) internal_error("field names must match");
    // The union should be processed first, it leads to better inference
    set = TType::union(subst, tenv, x.set, y.set);
    get = if (tenv.expandInter) {
      TType::inter(subst, tenv, x.get, y.get)
    } else {
      TType::unexpandedInter(x.get, y.get)
    };
    isOptional = x.isOptional && y.isOptional;
    TField{
      pos => x.pos,
      name => x.name,
      isOptional,
      get,
      set,
      access => x.access.combine(y.access),
    }
  }

  static fun interIndex(
    subst: mutable Subst,
    tenv: TEnv,
    x: TField,
    y: TField,
  ): TField {
    get = TType::inter(subst, tenv, x.get, y.get);
    set = TType::union(subst, tenv, x.set, y.set);
    isOptional = x.isOptional && y.isOptional;
    TField{
      pos => x.pos,
      name => x.name,
      isOptional,
      get,
      set,
      access => x.access.combine(y.access),
    }
  }
}

extension class STypes {
  // inter returns None when the intersection of the args is bottom
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): ?STypes {
    stypes1.stypes.mapInterOption(stypes2.stypes, (sty1, sty2) -> {
      invariant(
        sty1.tag() == sty2.tag(),
        "mapInterOption ensures iteration with identical tags",
      );
      (sty1, sty2) match {
      | (TPrimUnit _, TPrimUnit _) -> Some(sty1)

      | (p1 @ TPrimValue _, p2 @ TPrimValue _) -> TPrimValue::inter(p1, p2)

      | (obj1 @ TObject _, obj2 @ TObject _) ->
        TObject::inter(subst, tenv, obj1, obj2)

      | _ -> internal_error("Internal error")
      }
    }) match {
    | Some(stypes) if (!stypes.isEmpty()) -> Some(STypes(stypes))
    | _ -> None()
    }
  }
}

extension class Clause {
  // Returns None if the result is bottom
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    clause1: Clause,
    clause2: Clause,
  ): ?Clause {
    vars = clause1.vars.union(clause2.vars);
    (clause1.stypes, clause2.stypes) match {
    | (None(), stypes)
    | (stypes, None()) ->
      Some(Clause(vars, stypes))
    | (Some(stypes1), Some(stypes2)) ->
      STypes::inter(subst, tenv, stypes1, stypes2).map(stypes ->
        Clause(vars, Some(stypes))
      )
    }
  }
}

extension class Clauses {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): Clauses {
    result = SortedMap[];
    for (clause1 in clauses1) {
      for (clause2 in clauses2) {
        Clause::inter(subst, tenv, clause1, clause2) match {
        | None() -> void
        | Some(inter) ->
          if (!result.containsKey(inter.vars)) {
            !result[inter.vars] = inter;
          } else {
            !result[inter.vars] = Clause::union(
              subst,
              tenv,
              result[inter.vars],
              inter,
            )
          }
        }
      }
    };
    Clauses(
      InternalKeyedArrayMap::createFromSortedIterator(
        result.items().map(x -> x.i1).iterator(),
      ),
    )
  }
}

extension class TPrimValue {
  static fun inter(t1: TPrimValue, t2: TPrimValue): ?TPrimValue {
    if (t1.kind != t2.kind) {
      // Different kinds (e.g. number and string) have no common values
      return None()
    };
    (t1.literals, t2.literals) match {
    | (_, None()) -> Some(t1)
    | (None(), Some _) -> Some(t2)
    | (Some(lits1), Some(lits2)) ->
      lits1.inter(lits2).map(lits -> TPrimValue(t1.kind, Some(lits), t1.pos))
    }
  }
}

extension base class SType {
  // Whether values of the two simple types can be strictly equal (`===`).
  // Only provably disjoint value sets report no overlap; reference types
  // always overlap, since a single value can inhabit both sides (width
  // subtyping for objects, never-returning functions, `Promise<never>`) —
  // even where tsc reports TS2367. Conversely, null and undefined overlap
  // nothing but themselves: unlike tsc, `x === null` warns when `x` cannot
  // be null. Callers are expected to exclude void operands (comparing void
  // is an error — void is non-observable).
  static fun overlaps(
    subst: mutable Subst,
    tenv: TEnv,
    sty1: SType,
    sty2: SType,
  ): Bool {
    (sty1, sty2) match {
    | (TPrimUnit(kind1, _), TPrimUnit(kind2, _)) -> kind1 == kind2
    | (TPrimUnit _, _)
    | (_, TPrimUnit _) ->
      false
    | (prim1 @ TPrimValue _, prim2 @ TPrimValue _) ->
      TPrimValue::inter(prim1, prim2).isSome()
    | (prim @ TPrimValue _, obj @ TObject _)
    | (obj @ TObject _, prim @ TPrimValue _) ->
      // A primitive overlaps an object type only through its boxed class:
      // a value of type `Number` can be a primitive number, but a value of
      // type `{ a: string }` cannot
      boxed = TType::inst(prim.asClassName(), TArgs(Array[]));
      TType::isSub(subst, tenv, boxed, TType::single(obj)) is STOk()
    | (TObject _, TObject _) ->
      // TODO: some object pairs are provably disjoint and could be
      // reported: a shared field with non-overlapping types can leave no
      // common value (e.g. `{ a?: number }` vs `{ a: string }`)
      true
    }
  }
}

extension class TIndexes {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    indexes1: TIndexesBase,
    indexes2: TIndexesBase,
  ): TIndexes {
    stringIndex = TFields::interOptIndex(
      subst,
      tenv,
      indexes1.stringIndex,
      indexes2.stringIndex,
    );
    numberIndex = TFields::interOptIndex(
      subst,
      tenv,
      indexes1.numberIndex,
      indexes2.numberIndex,
    );
    symbolIndex = TFields::interOptIndex(
      subst,
      tenv,
      indexes1.symbolIndex,
      indexes2.symbolIndex,
    );
    (stringIndex, numberIndex) match {
    | (Some(strIdx), Some(numIdx)) ->
      !numberIndex = Some(TField::interIndex(subst, tenv, strIdx, numIdx))
    | _ -> void
    };
    TIndexes{stringIndex, numberIndex, symbolIndex}
  }
}

extension class TFields {
  private static fun interNamedFields(
    subst: mutable Subst,
    tenv: TEnv,
    namedFields1: InternalKeyedArrayMap<FieldNameString, TField>,
    namedFields2: InternalKeyedArrayMap<FieldNameString, TField>,
    indexFor1: (FieldNameString) -> ?TField,
    indexFor2: (FieldNameString) -> ?TField,
  ): InternalKeyedArrayMap<FieldNameString, TField> {
    namedFields1.merge(namedFields2, ior ->
      ior match {
      | Left(f1) ->
        indexFor2(f1.name) match {
        | None() -> f1
        | Some(idx) -> TField::interIndex(subst, tenv, f1, idx)
        }
      | Right(f2) ->
        indexFor1(f2.name) match {
        | None() -> f2
        | Some(idx) -> TField::interIndex(subst, tenv, f2, idx)
        }
      | Both(x, y) -> TField::inter(subst, tenv, x, y)
      }
    )
  }

  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): ?TFields {
    isArray = (fields1.isArray, fields2.isArray) match {
    | (Some(true), Some(false))
    | (Some(false), Some(true)) ->
      return None()
    | (None(), ia)
    | (ia, _) ->
      ia
    };
    // Process fields first so that tuple index type variables are resolved
    // before call/new signatures with union types.
    // effective*: a closed operand's implicit `never` collapses a field present
    // only in the OTHER operand — inter(closed({a}), {a, b: string}) is
    // closed({a, b: never}), not closed({a, b: string}). Growth EXTENDS rather
    // than intersects, so it strips the marker first (assignLocalObjectByKeys).
    fields = TFields::interNamedFields(
      subst,
      tenv,
      fields1.fields,
      fields2.fields,
      name -> fields1.effectiveIndexForFieldName(name.value),
      name -> fields2.effectiveIndexForFieldName(name.value),
    );
    symbolFields = TFields::interNamedFields(
      subst,
      tenv,
      fields1.symbolFields,
      fields2.symbolFields,
      _ -> fields1.effectiveSymbolIndex(),
      _ -> fields2.effectiveSymbolIndex(),
    );
    indexes = TIndexes::inter(subst, tenv, fields1, fields2);
    call = (fields1.call, fields2.call) match {
    | (None(), call)
    | (call, None()) ->
      call
    | (Some((opt1, call1)), Some((opt2, call2))) ->
      TFuns::inter(subst, tenv, call1, call2) match {
      | None() -> return None()
      | Some(f) -> Some((opt1 && opt2, f))
      }
    };
    new = (fields1.new, fields2.new) match {
    | (None(), new)
    | (new, None()) ->
      new
    | (Some((opt1, new1)), Some((opt2, new2))) ->
      TFuns::inter(subst, tenv, new1, new2) match {
      | None() -> return None()
      | Some(f) -> Some((opt1 && opt2, f))
      }
    };
    Some(
      TFields{
        fields,
        symbolFields,
        stringIndex => indexes.stringIndex,
        numberIndex => indexes.numberIndex,
        symbolIndex => indexes.symbolIndex,
        call,
        new,
        isArray,
        // Closedness is restrictive: the intersection is a closed literal if
        // EITHER operand is (a value in both has no excess keys). Carries the
        // literal's pos through the ownership-transfer retype.
        closedLiteralPos => fields1.closedLiteralPos match {
        | p @ Some _ -> p
        | None() -> fields2.closedLiteralPos
        },
      },
    )
  }

  fun interIsArray(isArray: Bool): ?TFields {
    this.isArray match {
    | None() -> Some(this with {isArray => Some(isArray)})
    | Some(ia) -> if (ia == isArray) Some(this) else None()
    }
  }

  static fun interOptIndex(
    subst: mutable Subst,
    tenv: TEnv,
    idx1: ?TField,
    idx2: ?TField,
  ): ?TField {
    (idx1, idx2) match {
    | (None(), None()) -> None()
    | (Some(index), None())
    | (None(), Some(index)) ->
      Some(index)
    | (Some(index1), Some(index2)) ->
      Some(TField::interIndex(subst, tenv, index1, index2))
    }
  }
}

extension class TObject {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    obj1: TObject,
    obj2: TObject,
  ): ?TObject {
    branches = mutable Vector[];
    for (fields1 in obj1.branches) {
      for (fields2 in obj2.branches) {
        TFields::inter(subst, tenv, fields1, fields2) match {
        | None() -> void
        | Some(x) ->
          branches.push(x);
          // Intersecting unions of objects cross-products their branches; cap
          // the result like the distributed spread does, instead of
          // materializing an exponential number of branches (an n-way
          // intersection of two-branch unions yields 2^n).
          if (branches.size() > kMaxObjectBranches) {
            fatalError(
              Array[
                (
                  obj1.pos,
                  "This intersection produces too many object branches; the type is too complex to represent",
                ),
              ],
              TSCode(2590),
            )
          }
        }
      }
    };
    if (branches.isEmpty()) {
      None()
    } else {
      Some(TObject(ArraySet::createFromMVector(branches), None(), obj1.pos))
    }
  }
}

extension class TFun {
  static fun inter(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFun,
    f2: TFun,
  ): ?TFun {
    merged = f1.cgNodes.union(f2.cgNodes);
    TFun::isSub(subst, tenv, f1, f2) match {
    | STOk() -> return Some(f1 with {cgNodes => merged})
    | STError _ -> void
    };
    TFun::isSub(subst, tenv, f2, f1) match {
    | STOk() -> return Some(f2 with {cgNodes => merged})
    | STError _ -> void
    };
    None()
  }
}

module end;
