/***************************************************************************/
/* Generic operations on sorted set represented with sorted arrays. */
/***************************************************************************/

module ArraySet;

// see iterDiffInterDiff
private mutable class DiffInterDiffIterator<T: Orderable> private (
  private mutable head1: ?T,
  private tail1: mutable Iterator<T>,
  private mutable head2: ?T,
  private tail2: mutable Iterator<T>,
) extends Iterator<(?T, ?T)> {
  static fun create(
    iter1: mutable Iterator<T>,
    iter2: mutable Iterator<T>,
  ): mutable Iterator<(?T, ?T)> {
    head1 = iter1.next();
    head2 = iter2.next();
    mutable static(head1, iter1, head2, iter2)
  }

  readonly fun sizeHint(): ?Int {
    size1 = this.tail1.sizeHint().map((n) ->
      if (this.head1.isSome()) n + 1 else n
    );
    size2 = this.tail2.sizeHint().map((n) ->
      if (this.head2.isSome()) n + 1 else n
    );
    (size1, size2) match {
    | (Some(m), Some(n)) ->
      Some(m + n) // actual size will be between max and sum of sizes
    | (Some(n), None())
    | (None(), Some(n)) ->
      Some(n)
    | (None(), None()) -> None()
    }
  }

  mutable fun next(): ?(?T, ?T) {
    none: ?T = None();
    go = (x, y) -> {
      if (x.isSome()) this.!head1 = this.tail1.next();
      if (y.isSome()) this.!head2 = this.tail2.next();
      Some((x, y))
    };
    (this.head1, this.head2) match {
    | (None(), None()) -> None()
    | (None(), Some(_)) -> go(none, this.head2)
    | (Some(_), None()) -> go(this.head1, none)
    | (Some(x), Some(y)) ->
      x.compare(y) match {
      | LT() -> go(this.head1, none)
      | EQ() -> go(this.head1, this.head2)
      | GT() -> go(none, this.head2)
      }
    }
  }
}

// A set of orderable elements backed by a sorted array.
class .ArraySet<T: Orderable> private (
  private inner: Vector<T>,
) uses Orderable, XXHashable[T: XXHashable] {
  static fun empty(): this {
    static(Vector[])
  }

  fun size(): Int {
    this.inner.size()
  }

  private static fun create<T: Orderable>(
    size: Int,
    init: (T -> void) -> void,
  ): ArraySet<T> {
    // create by allocating, initializing via calling push, and checking
    inner = Vector::mcreate(size);
    init(inner.push);
    // inner must be strictly increasing
    assert(
      {
        prev: ?T = None();
        for (curr in inner) {
          prev match {
          | Some(p) ->
            if (p >= curr) {
              internal_error("ArraySet::create")
            }
          | None() -> void
          };
          !prev = Some(curr);
        };
        true
      },
    );
    ArraySet(unsafe_chill_trust_me(inner))
  }

  static fun createFromIterator<T: Orderable, I: mutable Iterator<T>>(
    items: I,
  ): ArraySet<T> {
    static::create(items.sizeHint().default(0), items.each)
  }

  static fun single(x: T): this {
    static(Vector[x])
  }

  fun isEmpty(): Bool {
    this.inner.isEmpty()
  }

  fun getUnique(): ?T {
    if (this.size() == 1) {
      Some(this.inner[0])
    } else {
      None()
    }
  }

  fun toArray(): Array<T> {
    this.inner.toArray()
  }

  fun values(): mutable Iterator<T> {
    this.inner.values()
  }

  fun items(): mutable Iterator<(Int, T)> {
    this.inner.items()
  }

  fun filter(f: T -> Bool): this {
    static(this.inner.filter(f))
  }

  fun map<U: Orderable>(f: T -> U): ArraySet<U> {
    // use a SortedSet to sort and dedup since callers of map do not
    // guarantee that f is monotone
    static::createFromIterator(this.values().map(f).collect(SortedSet).values())
  }

  fun filterMap<U: Orderable>(f: T -> ?U): ArraySet<U> {
    ArraySet::createFromIterator(
      this.values().filterMap(f).collect(SortedSet).values(),
    )
  }

  // s.iterDiffInterDiff(t) contains (Some(x), None()) for every element in
  // s but not t, (None(), Some(y)) for every y in t but not s, and
  // (Some(x), Some(y)) for every pair of elements that are in both s and t.
  fun iterDiffInterDiff(that: this): mutable Iterator<(?T, ?T)> {
    DiffInterDiffIterator::create(this.inner.values(), that.inner.values())
  }

  fun iterDiff(that: this): mutable Iterator<T> {
    this.iterDiffInterDiff(that).filterMap((xO_yO) ->
      xO_yO match {
      | (xO @ Some(_), None()) -> xO
      | _ -> None()
      }
    )
  }

  fun diff(that: this): this {
    static::createFromIterator(this.iterDiff(that))
  }

  fun contains(that: this): Bool {
    !this.iterDiffInterDiff(that).any((xO_yO) -> xO_yO is (None(), Some(_)))
  }

  fun iterUnion(that: this): mutable Iterator<T> {
    this.iterDiffInterDiff(that).map((xO_yO) ->
      xO_yO match {
      | (Some(x), _)
      | (None(), Some(x)) ->
        x
      | (None(), None()) -> internal_error("ArraySet.union")
      }
    )
  }

  fun union(that: this): this {
    static::createFromIterator(this.iterUnion(that))
  }
}

module end;

module SKJS;

private fun mapUnion<T, Key: Orderable>(
  iter1: mutable Iterator<T>,
  iter2: mutable Iterator<T>,
  proj: T ~> Key,
  missing: T -> T,
  union: (T, T) -> T,
): Array<T> {
  result = mutable Vector[];
  head1 = iter1.next();
  head2 = iter2.next();
  loop {
    (head1, head2) match {
    | (None(), None()) -> break void
    | (None(), Some(y)) ->
      result.push(missing(y));
      !head2 = iter2.next()
    | (Some(x), None()) ->
      result.push(missing(x));
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) < proj(y)) ->
      result.push(missing(x));
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) > proj(y)) ->
      result.push(missing(y));
      !head2 = iter2.next()
    | (Some(x), Some(y)) ->
      result.push(union(x, y));
      !head1 = iter1.next();
      !head2 = iter2.next()
    }
  };
  result.toArray()
}

private fun mapInter<T, Key: Orderable>(
  iter1: mutable Iterator<T>,
  iter2: mutable Iterator<T>,
  proj: T ~> Key,
  inter: (T, T) -> T,
): (Array<T>, Array<T>, Array<T>) {
  noMatch1 = mutable Vector[];
  noMatch2 = mutable Vector[];
  present = mutable Vector[];
  head1 = iter1.next();
  head2 = iter2.next();
  loop {
    (head1, head2) match {
    | (None(), None()) -> break void
    | (None(), Some(y)) ->
      noMatch2.push(y);
      !head2 = iter2.next()
    | (Some(x), None()) ->
      noMatch1.push(x);
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) < proj(y)) ->
      noMatch1.push(x);
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) > proj(y)) ->
      noMatch2.push(y);
      !head2 = iter2.next()
    | (Some(x), Some(y)) ->
      present.push(inter(x, y));
      !head1 = iter1.next();
      !head2 = iter2.next()
    }
  };
  (noMatch1.toArray(), noMatch2.toArray(), present.toArray())
}

class ArrayValues private (
  values: Array<(PosRange, String)>,
) uses XXHashable, Orderable, Show {
  // Invariant: values is not empty and is sorted by x ~> x.i1

  static fun single(elt: (PosRange, String)): this {
    static(Array[elt])
  }

  static fun ofSet(set: SortedSet<String>, pos: PosRange): ?this {
    if (set.isEmpty()) None() else {
      Some(static(set.toArray().map(s -> (pos, s))))
    }
  }

  fun xxhash(ignorePos: Bool = false): XXHash {
    // Custom xxhash that excludes positions, only hashes the strings
    result = 0;
    for (i in Range(0, this.values.size())) {
      !result = XXHash64.xxHash64(
        result,
        this.values[i].i1.xxhash(ignorePos).value,
      );
    };
    XXHash(result)
  }

  fun size(): Int {
    this.values.size()
  }

  fun singleElt(): ?(PosRange, String) {
    if (this.values.size() == 1) Some(this.values[0]) else None()
  }

  fun filter(f: ((PosRange, String)) -> Bool): ?this {
    values = this.values.filter(f);
    if (values.isEmpty()) None() else Some(static(values))
  }

  fun union(other: ArrayValues): ArrayValues {
    ArrayValues(
      mapUnion(
        this.values.iterator(),
        other.values.iterator(),
        x ~> x.i1,
        x ~> x,
        (x, _) ~> x,
      ),
    )
  }

  fun inter(other: this): ?this {
    (_noMatches1, _notMatches2, result) = mapInter(
      this.values.iterator(),
      other.values.iterator(),
      x ~> x.i1,
      (x, _) ~> x,
    );
    if (result.isEmpty()) None() else Some(static(result))
  }

  fun toStringList(): String {
    this.values.map(x -> x.i1).join(" | ")
  }

  fun toString(): String {
    inspect(this).toString()
  }

  fun contains(x: String): Bool {
    idx = SKStore.binSearch(
      i ~> this.values[i].i1,
      x,
      0,
      this.values.size() - 1,
    );
    if (idx < 0 || idx >= this.values.size()) return false;
    this.values[idx].i1 == x
  }
}

module end;
