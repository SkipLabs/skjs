/***************************************************************************/
/* Generic operations on sorted set represented with sorted arrays. */
/***************************************************************************/

module ArraySet;

// A set of orderable elements backed by a sorted array.
class .ArraySet<T: Orderable> private (
  private inner: Vector<T>,
) uses Orderable, XXHashable[T: XXHashable] {
  static fun empty(): this {
    static(Vector[])
  }

  fun size(): Int {
    this.inner.size()
  }

  private static fun create<T: Orderable>(
    size: Int,
    init: (T -> void) -> void,
  ): ArraySet<T> {
    // create by allocating, initializing via calling push, and checking
    inner = Vector::mcreate(size);
    init(inner.push);
    // inner must be strictly increasing
    assert(
      {
        prev: ?T = None();
        for (curr in inner) {
          prev match {
          | Some(p) ->
            if (p >= curr) {
              internal_error("ArraySet::create")
            }
          | None() -> void
          };
          !prev = Some(curr);
        };
        true
      },
    );
    ArraySet(unsafe_chill_trust_me(inner))
  }

  // Usually cannot use this when we want; it would require duplicating most
  // of the functions on Vector to return mutable results.
  static fun createFromMVector<T: Orderable>(
    vec: mutable Vector<T>,
  ): ArraySet<T> {
    if (vec.isEmpty()) return ArraySet::empty();
    vec.sortBy(id);
    prev: ?T = None();
    vec.keepWhere(x -> {
      keep = prev.map(p -> p != x).default(true);
      !prev = Some(x);
      keep
    });
    ArraySet(unsafe_chill_trust_me(vec.chill()))
  }

  static fun createFromVector<T: Orderable>(
    vec: readonly Vector<T>,
  ): ArraySet<T> {
    if (vec.isEmpty()) return ArraySet::empty();
    ArraySet::createFromMVector(vec.clone())
  }

  static fun createFromIterator<T: Orderable, I: mutable Iterator<T>>(
    items: I,
  ): ArraySet<T> {
    static::create(items.sizeHint().default(0), items.each)
  }

  static fun single(x: T): this {
    static(Vector[x])
  }

  fun isEmpty(): Bool {
    this.inner.isEmpty()
  }

  fun getUnique(): ?T {
    if (this.size() == 1) {
      Some(this.inner[0])
    } else {
      None()
    }
  }

  fun toArray(): Array<T> {
    this.inner.toArray()
  }

  fun values(): mutable Iterator<T> {
    this.inner.values()
  }

  fun items(): mutable Iterator<(Int, T)> {
    this.inner.items()
  }

  fun filter(f: T -> Bool): this {
    static(this.inner.filter(f))
  }

  fun map<U: Orderable>(f: T -> U): ArraySet<U> {
    ArraySet::createFromVector(this.inner.map(f))
  }

  fun filterMap<U: Orderable>(f: T -> ?U): ArraySet<U> {
    ArraySet::createFromVector(this.values().filterMap(f).collect(Vector))
  }

  // s.iterDiffInterDiff(t) contains Left(x) for every x in s but not t,
  // Right(y) for every y in t but not s, and Both(x, y) for every pair of
  // elements that are in both s and t.
  fun iterDiffInterDiff(that: this): mutable Iterator<InclusiveOr<T, T>> {
    this.inner.values().zipSorted(that.inner.values())
  }

  fun iterDiff(that: this): mutable Iterator<T> {
    this.iterDiffInterDiff(that).filterMap(v -> v.maybeLeft())
  }

  fun diff(that: this): this {
    static::createFromIterator(this.iterDiff(that))
  }

  fun contains(that: this): Bool {
    !this.iterDiffInterDiff(that).any(v -> v is Right(_))
  }

  fun union(that: this): this {
    ArraySet::createFromVector(this.inner.concat(that.inner))
  }
}

module end;
