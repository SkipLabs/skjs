/*****************************************************************************/
/* Generic operations on sorted set represented with sorted arrays. */
/*****************************************************************************/

module SKJS;

fun sortedIter2<T, L: T, R: T, Key: Orderable>{
  left: mutable Iterator<L>,
  right: mutable Iterator<R>,
  proj: T ~> Key,
  onLeft: L -> void,
  onRight: R -> void,
  onBoth: (L, R) -> void,
}: void {
  headl = left.next();
  headr = right.next();
  loop {
    (headl, headr) match {
    | (None(), None()) -> break void
    | (None(), Some(y)) ->
      onRight(y);
      !headr = right.next()
    | (Some(x), None()) ->
      onLeft(x);
      !headl = left.next()
    | (Some(x), Some(y)) ->
      proj(x).compare(proj(y)) match {
      | LT() ->
        onLeft(x);
        !headl = left.next()
      | GT() ->
        onRight(y);
        !headr = right.next()
      | EQ() ->
        onBoth(x, y);
        !headl = left.next();
        !headr = right.next()
      }
    }
  };
}

fun mapSymmetricMerge<T, R, Key: Orderable>(
  left: mutable Iterator<T>,
  right: mutable Iterator<T>,
  proj: T ~> Key,
  single: T -> ?R,
  both: (T, T) -> R,
): Array<R> {
  result = mutable Vector[];
  onSingle = v -> {
    single(v) match {
    | None() -> void
    | Some(r) -> result.push(r)
    }
  };
  onBoth = (l, r) -> result.push(both(l, r));
  sortedIter2{
    left,
    right,
    proj,
    onLeft => onSingle,
    onRight => onSingle,
    onBoth,
  };
  result.toArray()
}

// variant of mapUnion that runs in the Option monad
fun mapUnionOption<T, Key: Orderable>(
  iter1: mutable Iterator<T>,
  iter2: mutable Iterator<T>,
  proj: T ~> Key,
  missing: T -> T,
  union: (T, T) -> ?T,
): ?Array<T> {
  result = mutable Vector[];
  head1 = iter1.next();
  head2 = iter2.next();
  loop {
    (head1, head2) match {
    | (None(), None()) -> break void
    | (None(), Some(y)) ->
      result.push(missing(y));
      !head2 = iter2.next()
    | (Some(x), None()) ->
      result.push(missing(x));
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) < proj(y)) ->
      result.push(missing(x));
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) > proj(y)) ->
      result.push(missing(y));
      !head2 = iter2.next()
    | (Some(x), Some(y)) ->
      union(x, y) match {
      | None() -> return None()
      | Some(u) -> result.push(u)
      };
      !head1 = iter1.next();
      !head2 = iter2.next()
    }
  };
  Some(result.toArray())
}

fun mapUnion<T, R, Key: Orderable>(
  left: mutable Iterator<T>,
  right: mutable Iterator<T>,
  proj: T ~> Key,
  missing: T -> R,
  union: (T, T) -> R,
): Array<R> {
  single = v -> Some(missing(v));
  mapSymmetricMerge(left, right, proj, single, union)
}

fun mapInter<T, R, Key: Orderable>(
  left: mutable Iterator<T>,
  right: mutable Iterator<T>,
  proj: T ~> Key,
  inter: (T, T) -> R,
): (Array<T>, Array<T>, Array<R>) {
  inLeftOnly = mutable Vector[];
  inRightOnly = mutable Vector[];
  inBothMapped = mutable Vector[];
  onLeft = v -> inLeftOnly.push(v);
  onRight = v -> inRightOnly.push(v);
  onBoth = (l, r) -> inBothMapped.push(inter(l, r));
  sortedIter2{left, right, proj, onLeft, onRight, onBoth};
  (inLeftOnly.toArray(), inRightOnly.toArray(), inBothMapped.toArray())
}

// variant of mapInter that runs in the Option monad
fun mapInterOption<T, Key: Orderable>(
  iter1: mutable Iterator<T>,
  iter2: mutable Iterator<T>,
  proj: T ~> Key,
  inter: (T, T) -> ?T,
): ?(Array<T>, Array<T>, Array<T>) {
  noMatch1 = mutable Vector[];
  noMatch2 = mutable Vector[];
  present = mutable Vector[];
  head1 = iter1.next();
  head2 = iter2.next();
  loop {
    (head1, head2) match {
    | (None(), None()) -> break void
    | (None(), Some(y)) ->
      noMatch2.push(y);
      !head2 = iter2.next()
    | (Some(x), None()) ->
      noMatch1.push(x);
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) < proj(y)) ->
      noMatch1.push(x);
      !head1 = iter1.next()
    | (Some(x), Some(y)) if (proj(x) > proj(y)) ->
      noMatch2.push(y);
      !head2 = iter2.next()
    | (Some(x), Some(y)) ->
      inter(x, y) match {
      | None() -> return None()
      | Some(i) -> present.push(i)
      };
      !head1 = iter1.next();
      !head2 = iter2.next()
    }
  };
  Some((noMatch1.toArray(), noMatch2.toArray(), present.toArray()))
}

class ArrayValues(
  values: Array<(PosRange, String)>,
) uses Hashable, Orderable, Show {
  static fun createFromItems(items: Array<(PosRange, String)>): this {
    !items = items.sortedBy(x ~> x.i1);
    static(items)
  }

  fun union(other: ArrayValues): ArrayValues {
    ArrayValues(
      mapUnion(
        this.values.iterator(),
        other.values.iterator(),
        x ~> x.i1,
        x ~> x,
        (x, _) ~> x,
      ),
    )
  }

  fun inter(other: ArrayValues): ArrayValues {
    (_noMatches1, _notMatches2, result) = mapInter(
      this.values.iterator(),
      other.values.iterator(),
      x ~> x.i1,
      (x, _) ~> x,
    );
    ArrayValues(result)
  }

  fun toStringList(): String {
    this.values.map(x -> x.i1).join(" | ")
  }

  fun toString(): String {
    inspect(this).toString()
  }

  fun contains(x: String): Bool {
    idx = SKStore.binSearch(
      i ~> this.values[i].i1,
      x,
      0,
      this.values.size() - 1,
    );
    if (idx < 0 || idx >= this.values.size()) return false;
    this.values[idx].i1 == x
  }
}

module end;
