module SKJS;

const kClassHierarchyId: String = "/skjs/class-hierarchy/";

const kClassHierarchyDirName: SKStore.DirName = SKStore.DirName::create(
  kClassHierarchyId,
);

class CHNode private (
  name: String,
  kind: ClassKind,
  fileName: String,
  symbol: SymbolicPos,
) extends SKStore.File, SKStore.Key uses XXHashable {
  static fun ofClass(c: Class): this {
    static(
      c.name.value,
      c.kind,
      c.name.pos.fileName.toString(),
      c.name.pos.symbol,
    )
  }
}

class ClassHierarchyFile(
  classHierarchy: SortedMap<CHNode, SortedSet<CHNode>> = SortedMap[],
) extends SKStore.File {
  fun recordClassHierarchy(child: Class, parent: Class): this {
    childNode = CHNode::ofClass(child);
    parentNode = CHNode::ofClass(parent);
    current = this.classHierarchy.maybeGet(childNode).default(SortedSet[]);
    new = current.set(parentNode);
    ClassHierarchyFile(this.classHierarchy.set(childNode, new))
  }

  fun each(fn: (CHNode, SortedSet<CHNode>) -> void): void {
    this.classHierarchy.each(fn)
  }
}

fun recordClassHierarchy(
  context: mutable SKStore.Context,
  child: Class,
  parent: mutable SKStore.Context -> Class,
): void {
  context.getGlobal(kClassHierarchyId).map(ClassHierarchyFile::type) match {
  | Some(classHierarchy) ->
    context.setGlobal(
      kClassHierarchyId,
      classHierarchy.recordClassHierarchy(child, parent(context)),
    )
  | _ -> void
  }
}

fun initClassHierarchy(context: mutable SKStore.Context): void {
  context.setGlobal(kClassHierarchyId, ClassHierarchyFile())
}

fun collectClassHierarchy(
  context: mutable SKStore.Context,
): ?ClassHierarchyFile {
  classHierarchy = context
    .getGlobal(kClassHierarchyId)
    .map(ClassHierarchyFile::type);
  context.removeGlobal(kClassHierarchyId);
  classHierarchy
}

fun buildClassHierarchy(
  context: mutable SKStore.Context,
  checked: SKStore.EHandle<SKStore.SID, CheckResult>,
  dirName: SKStore.DirName = kClassHierarchyDirName,
): SKStore.EHandle<CHNode, CHNode> {
  checked.map(
    CHNode::keyType,
    CHNode::type,
    context,
    dirName,
    (_context, writer, _sid, res) ~> {
      res.first.classHierarchy.each(ih ->
        ih.each((k, v) -> writer.setArray(k, v.toArray()))
      )
    },
  );
}

module end;
