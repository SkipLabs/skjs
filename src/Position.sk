/***************************************************************************/
/* Positions in the source code. */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Position types. */
/***************************************************************************/

value class LineCol{line: Int, col: Int} uses Equality

value class RelPos(fileName: FAbsolute, lc: LineCol) uses Show, Equality {
  fun toString(): String {
    fileName = this.fileName.toString().replace("\"", "\\\"");
    `File "${fileName}", line ${this.lc.line}, character ${this.lc.col}:`
  }
}
value class RelPosRange(fileName: FAbsolute, start: LineCol, end: LineCol) {
  fun toString(): String {
    if (this.start.line != this.end.line) {
      return RelPos(this.fileName, this.start).toString();
    };
    fileName = this.fileName.toString().replace("\"", "\\\"");
    `File "${fileName}", line ${this.start.line}, character ${this.start.col}-${
      this.end.col
    }:`
  }
}

value class Pos(value: Int) uses Hashable, XXHashable, Orderable {
  const none: this = Pos(-1);

  // Intentionally collide all Pos hashes so that ASTs can compare as equal
  // if they only differ in Pos values
  fun xxhash(): XXHash {
    XXHash(3691082372) // first 8 bytes of sha256("Pos")
  }
}

value class PosRange private (
  symbol: SymbolicPos,
  fileName: FPath,
  relStart: Pos,
  relEnd: Pos,
) uses XXHashable, Orderable {
  const none: this = PosRange(SPTopLevel(), FPath::nil, Pos::none, Pos::none);

  static fun create(lexer: readonly Lexer, start: Pos, end: Pos): this {
    symbolPos = lexer.currentSymbolPos;
    relativeStart = Pos(start.value - symbolPos);
    relativeEnd = Pos(end.value - symbolPos);
    static(lexer.currentSymbol, lexer.fileName, relativeStart, relativeEnd)
  }

  fun extend(end: PosRange): this {
    if (this.symbol != end.symbol) {
      internal_error("Cannot extend a position with a different symbol");
    };
    this with {relEnd => end.relEnd}
  }

  fun extendWithPos(lexer: readonly Lexer, end: Pos): this {
    if (this.symbol != lexer.currentSymbol) {
      internal_error("Cannot extend a position with a different symbol");
    };
    this with {relEnd => Pos(end.value - lexer.currentSymbolPos)}
  }

  // Intentionally collide all PosRange hashes so that ASTs can compare as
  // equal if they only differ in PosRange values
  fun xxhash(): XXHash {
    XXHash(1232240476) // first 8 bytes of sha256("PosRange")
  }

  fun getStart(symbols: Map<SymbolicPos, Int>): Pos {
    this.symbol match {
    | SPTopLevel() -> this.relStart
    | other -> Pos(symbols[other] + this.relStart.value)
    }
  }

  fun getEnd(symbols: Map<SymbolicPos, Int>): Pos {
    this.symbol match {
    | SPTopLevel() -> this.relEnd
    | other -> Pos(symbols[other] + this.relEnd.value)
    }
  }

  fun atEnd(): this {
    this with {relStart => this.relEnd}
  }
}

/***************************************************************************/
/* Position resolver. */
/***************************************************************************/

class PositionResolver{
  absFileName: FAbsolute,
  newLines: Array<Int>,
  symbols: Map<SymbolicPos, Int>,
} {
  fun errMsgPosSingle(pos: Pos): ErrorMessagePos {
    ErrorMessagePos{
      fileName => this.absFileName,
      start => this.lineCol(pos),
      endOpt => None(),
    }
  }
  fun errMsgPosRange(pos: PosRange): ErrorMessagePos {
    ErrorMessagePos{
      fileName => this.absFileName,
      start => this.lineCol(pos.getStart(this.symbols)),
      endOpt => Some(this.lineCol(pos.getEnd(this.symbols))),
    }
  }

  fun relPosRange(pos: PosRange): RelPosRange {
    RelPosRange(
      this.absFileName,
      this.lineCol(pos.getStart(this.symbols)),
      this.lineCol(pos.getEnd(this.symbols)),
    )
  }

  fun relPos(pos: Pos): RelPos {
    RelPos(this.absFileName, this.lineCol(pos))
  }

  fun lineCol(pos: Pos): LineCol {
    idx = SKStore.binSearch(
      i ~> this.newLines[i],
      pos.value,
      0,
      this.newLines.size() - 1,
    );
    if (idx <= 0 || idx >= this.newLines[idx]) {
      return LineCol{line => 1, col => pos.value + 1}
    };
    LineCol{line => idx + 1, col => pos.value - this.newLines[idx - 1]}
  }
}

/***************************************************************************/
/* Structured error message type. */
/***************************************************************************/

value class ErrorMessagePos{
  fileName: FAbsolute,
  start: LineCol,
  endOpt: ?LineCol,
}

type ErrorMessage = Array<(ErrorMessagePos, String)>;

class ErrorMessageFile(value: ErrorMessage) extends SKStore.File

fun formatErrorMessage(msg: ErrorMessage): String {
  result = mutable Vector[];
  for ((pos, text) in msg) {
    posStr = pos.endOpt match {
    | Some(end) -> RelPosRange(pos.fileName, pos.start, end).toString()
    | None() -> RelPos(pos.fileName, pos.start).toString()
    };
    result.push(posStr);
    result.push(text);
  };
  result.join("\n")
}

module end;
