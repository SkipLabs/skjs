/***************************************************************************/
/* Positions in the source code. */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Position types. */
/***************************************************************************/

value class RelPos(fileName: String, line: Int, col: Int) uses Show {
  fun toString(): String {
    fileName = this.fileName.replace("\"", "\\\"");
    `File "${fileName}", line ${this.line}, character ${this.col}:`
  }
}
value class RelPosRange(start: RelPos, end: RelPos) {
  fun toString(): String {
    if (this.start.fileName != this.end.fileName) {
      internal_error("start and end fileName must match")
    };
    if (this.start.line != this.end.line) {
      return this.start.toString();
    };
    fileName = this.start.fileName.replace("\"", "\\\"");
    `File "${fileName}", line ${this.start.line}, character ${this.start.col}-${
      this.end.col
    }:`
  }
}

value class Pos(value: Int) uses Hashable, XXHashable, Orderable {
  const none: this = Pos(-1);

  fun xxhash(ignorePos: Bool = false): XXHash {
    if (ignorePos) {
      // Intentionally collide all PosRange hashes so that ASTs can compare as equal if they only differ in PosRange values
      XXHash(3691082372) // first 8 bytes of sha256("Pos")
    } else {
      internal_error("should never xx-hash a Pos")
    };
  }
}

value class PosRange(
  fileName: String,
  start: Pos,
  end: Pos,
) uses Hashable, XXHashable, Orderable {
  const none: this = PosRange("", Pos::none, Pos::none);

  fun xxhash(ignorePos: Bool = false): XXHash {
    if (ignorePos) {
      // Intentionally collide all PosRange hashes so that ASTs can compare as equal if they only differ in PosRange values
      XXHash(1232240476) // first 8 bytes of sha256("PosRange")
    } else {
      internal_error("should never xx-hash a PosRange")
    };
  }
}

/***************************************************************************/
/* Position resolver. */
/***************************************************************************/

class PositionResolver{fileName: String = "", newLines: Array<Int> = Array[]} {
  fun relPosRange(pos: PosRange): RelPosRange {
    RelPosRange(this.relPos(pos.start), this.relPos(pos.end))
  }

  fun relPos(pos: Pos): RelPos {
    idx = SKStore.binSearch(
      i ~> this.newLines[i],
      pos.value,
      0,
      this.newLines.size() - 1,
    );
    if (idx <= 0 || idx >= this.newLines[idx]) {
      return RelPos(this.fileName, 1, pos.value + 1)
    };
    RelPos(this.fileName, idx + 1, pos.value - this.newLines[idx - 1])
  }
}

module end;
