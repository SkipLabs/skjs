/***************************************************************************/
/* Check if a string is a canonical JS Number.toString() representation.  */
/*                                                                         */
/* In JavaScript, all property keys are strings. A string is considered   */
/* numeric (matching [x: number] index signatures) if it round-trips      */
/* through Number(): String(Number(s)) === s && isFinite(Number(s)).      */
/*                                                                         */
/* Canonical forms:                                                        */
/*   Plain:      [-](0|[1-9][0-9]*)(.[0-9]*[1-9])?                       */
/*   Scientific: [-][1-9](.[0-9]*[1-9])?e[+-][1-9][0-9]*                 */
/***************************************************************************/

module SKJS;

fun isJSNumericString(s: String): Bool {
  chars = s.chars().toArray();
  len = chars.size();
  if (len == 0) return false;

  i = 0;
  hasSign = false;

  // Optional negative sign
  if (chars[i] == '-') {
    !hasSign = true;
    !i = i + 1;
    if (i >= len) return false;
  };

  // First digit
  firstDigit = chars[i];
  if (firstDigit < '0' || firstDigit > '9') return false;
  !i = i + 1;

  if (firstDigit == '0') {
    // After '0': end, or '.' for decimal. No exponent (0e+N is not canonical).
    if (i == len) {
      // "-0" is not canonical (String(Number("-0")) = "0")
      return !hasSign
    };
    if (chars[i] == '.') {
      !i = i + 1;
      isJSNumericDecimalPart(chars, i, false)
    } else {
      false
    }
  } else {
    // firstDigit is '1'-'9'. Count integer digits.
    intDigits = 1;
    while (i < len && chars[i] >= '0' && chars[i] <= '9') {
      !intDigits = intDigits + 1;
      !i = i + 1;
    };
    if (i == len) return true; // plain integer
    if (chars[i] == '.') {
      !i = i + 1;
      // Exponent only valid after single-digit integer part
      isJSNumericDecimalPart(chars, i, intDigits == 1)
    } else if (chars[i] == 'e' && intDigits == 1) {
      !i = i + 1;
      isJSNumericExponentPart(chars, i)
    } else {
      false
    }
  }
}

// Parse decimal digits after '.'. No trailing zeros allowed.
// allowExponent: whether 'e' can follow (only for single-digit integer part).
fun isJSNumericDecimalPart(
  chars: Array<Char>,
  startIdx: Int,
  allowExponent: Bool,
): Bool {
  len = chars.size();
  i = startIdx;

  // Must have at least one digit after '.'
  if (i >= len || chars[i] < '0' || chars[i] > '9') return false;

  // Consume digits, track last digit
  lastDigit = chars[i];
  !i = i + 1;
  while (i < len && chars[i] >= '0' && chars[i] <= '9') {
    !lastDigit = chars[i];
    !i = i + 1;
  };

  // No trailing zeros in decimal part
  if (lastDigit == '0') return false;

  if (i == len) return true;
  if (chars[i] == 'e' && allowExponent) {
    isJSNumericExponentPart(chars, i + 1)
  } else {
    false
  }
}

// Parse exponent part after 'e'. Requires +/- sign, non-zero exponent.
fun isJSNumericExponentPart(chars: Array<Char>, startIdx: Int): Bool {
  len = chars.size();
  i = startIdx;

  // Must have + or - sign
  if (i >= len) return false;
  if (chars[i] != '+' && chars[i] != '-') return false;
  !i = i + 1;

  // First exponent digit must be 1-9 (no leading zeros, no zero exponent)
  if (i >= len) return false;
  if (chars[i] < '1' || chars[i] > '9') return false;
  !i = i + 1;

  // Remaining exponent digits
  while (i < len && chars[i] >= '0' && chars[i] <= '9') {
    !i = i + 1;
  };

  i == len
}

module end;
