/***************************************************************************/
/* JS numeric string utilities.                                            */
/*                                                                         */
/* isJSNumericString: checks canonical Number.toString() form.             */
/* normalizeJSNumber: converts any JS numeric literal to canonical form.   */
/*                                                                         */
/* Implements Number::toString (ECMA-262 §6.1.6.1.20):                     */
/*   Given significant digits s of length k and decimal position n:        */
/*   - k ≤ n ≤ 21:  integer with trailing zeros                           */
/*   - 0 < n < k:   decimal point inside digits                           */
/*   - -5 ≤ n ≤ 0:  "0." + leading zeros + digits                        */
/*   - otherwise:    scientific notation d.ddd...e±N                       */
/*                                                                         */
/* Canonical forms (regex, plus magnitude bounds):                         */
/*   Plain:      [-](0|[1-9][0-9]*)(.[0-9]*[1-9])?                       */
/*               <= 21 integer digits; <= 5 zeros after "0." before the   */
/*               first significant digit                                   */
/*   Scientific: [-][1-9](.[0-9]*[1-9])?e[+-][1-9][0-9]*                 */
/*               exponent >= 21 for e+, >= 7 for e-                        */
/*                                                                         */
/* Limitations / TODO:                                                      */
/*   - No IEEE-754 rounding: literals whose exact value is not             */
/*     representable in a double (radix literals > 2^53, exponents beyond  */
/*     +-1e6) are left in their spelled form, so two spellings of the same */
/*     double stay textually distinct (sound, stricter than tsc)           */
/*   - BigInt normalization is out of scope (handled separately)           */
/***************************************************************************/

module SKJS;

fun isJSNumericString(s: String): Bool {
  it = s.getIter();
  hasSign = false;

  // Optional negative sign
  if (it.current() == Some('-')) {
    !hasSign = true;
    _ = it.next();
  };

  // Must have at least one digit
  firstDigit = it.current();
  if (!isDigitChar(firstDigit)) return false;
  _ = it.next();

  if (firstDigit == Some('0')) {
    // After '0': end, or '.' for decimal. No exponent (0e+N is not canonical).
    if (it.current().isNone()) {
      // "-0" is not canonical (String(Number("-0")) = "0")
      return !hasSign
    };
    if (it.current() == Some('.')) {
      _ = it.next();
      isJSNumericDecimalPartIter(it, false, true)
    } else {
      false
    }
  } else {
    // firstDigit is '1'-'9'. Count integer digits.
    intDigits = 1;
    while (isDigitChar(it.current())) {
      !intDigits = intDigits + 1;
      _ = it.next();
    };
    // Integers with more than 21 digits print in scientific form (n > 21).
    if (it.current().isNone()) return intDigits <= 21; // plain integer
    if (it.current() == Some('.')) {
      if (intDigits > 21) return false;
      _ = it.next();
      isJSNumericDecimalPartIter(it, intDigits == 1, false)
    } else if (it.current() == Some('e') && intDigits == 1) {
      _ = it.next();
      isJSNumericExponentPartIter(it)
    } else {
      false
    }
  }
}

// A property name a `number`-typed key can produce at runtime, i.e. some
// `String(n)`. This is TypeScript's notion of a numeric property name
// (`(+name).toString() === name`): the finite canonical numeric strings
// (isJSNumericString) plus the three non-finite results of
// `Number.prototype.toString` — "Infinity", "-Infinity", and "NaN".
//
// Distinct from isJSNumericString, which is finite-only (numbers reachable as
// numeric *literals*). Use this one for number-key reachability and number-index
// governance; use isJSNumericString for number-literal construction (e.g. keyof).
fun isJSNumberKeyName(s: String): Bool {
  isJSNumericString(s) || s == "Infinity" || s == "-Infinity" || s == "NaN"
}

fun isDigitChar(c: ?Char): Bool {
  c match {
  | Some(ch) -> ch >= '0' && ch <= '9'
  | _ -> false
  }
}

// Parse decimal digits after '.'. No trailing zeros allowed. When
// limitLeadingZeros is set (integer part "0"), at most 5 zeros may precede
// the first significant digit: smaller magnitudes (n <= -6) print in
// scientific form ("0.000001" is canonical, "0.0000001" prints as "1e-7").
fun isJSNumericDecimalPartIter(
  it: mutable String.StringIterator,
  allowExponent: Bool,
  limitLeadingZeros: Bool,
): Bool {
  // Must have at least one digit after '.'
  if (!isDigitChar(it.current())) return false;

  // Consume digits, track last digit
  leadingZeros = 0;
  seenNonZero = false;
  lastDigit = it.current().fromSome();
  if (lastDigit == '0') !leadingZeros = 1 else !seenNonZero = true;
  _ = it.next();
  while (isDigitChar(it.current())) {
    !lastDigit = it.current().fromSome();
    if (!seenNonZero) {
      if (lastDigit == '0') {
        !leadingZeros = leadingZeros + 1;
      } else {
        !seenNonZero = true;
      }
    };
    _ = it.next();
  };
  if (limitLeadingZeros && leadingZeros > 5) return false;

  // No trailing zeros in decimal part
  if (lastDigit == '0') return false;

  if (it.current().isNone()) return true;
  if (it.current() == Some('e') && allowExponent) {
    _ = it.next();
    isJSNumericExponentPartIter(it)
  } else {
    false
  }
}

// Parse exponent part after 'e'. Requires +/- sign and an exponent within
// the range Number.toString actually emits: scientific form only occurs for
// n > 21 (exponent >= 21) or n <= -6 (exponent <= -7); smaller magnitudes
// print in plain form ("1e+3" is not canonical, String(1e3) is "1000").
fun isJSNumericExponentPartIter(it: mutable String.StringIterator): Bool {
  // Must have + or - sign
  c = it.current();
  if (c != Some('+') && c != Some('-')) return false;
  isNegative = c == Some('-');
  _ = it.next();

  // First exponent digit must be 1-9 (no leading zeros, no zero exponent)
  first = it.current();
  if (first.isNone()) return false;
  ch = first.fromSome();
  if (ch < '1' || ch > '9') return false;
  _ = it.next();

  // Remaining exponent digits (value capped: only the thresholds matter)
  value = ch.code() - '0'.code();
  while (isDigitChar(it.current())) {
    if (value < 100000) {
      !value = value * 10 + (it.current().fromSome().code() - '0'.code());
    };
    _ = it.next();
  };

  if (it.current().isSome()) return false;
  if (isNegative) value >= 7 else value >= 21
}

// Validate that a TKNumber lexeme is a well-formed ES2021 NumericLiteral.
// The lexer scans any run of number-ish characters, so malformed forms like
// 0b12, 0o8, 0x, 1e, 1__0, 1_ and legacy octal 010 arrive here as single
// tokens; tsc rejects all of them as syntax errors. Returns the parse error
// to report, or None for a valid literal.
fun validateJSNumericLiteral(raw: String): ?ParsingKind {
  chars = raw.chars().toArray();
  sz = chars.size();
  if (sz >= 2 && chars[0] == '0') {
    chars[1] match {
    | 'x' | 'X' ->
      return validateRadixDigits(chars, HexDigitExpected(), c ->
        c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
      )
    | 'b' | 'B' ->
      return validateRadixDigits(chars, BinaryDigitExpected(), c ->
        c == '0' || c == '1'
      )
    | 'o' | 'O' ->
      return validateRadixDigits(chars, OctalDigitExpected(), c ->
        c >= '0' && c <= '7'
      )
    | _ -> void
    };
  };
  validateDecimalJSLiteral(chars)
}

fun isDecimalDigit(c: Char): Bool {
  c >= '0' && c <= '9'
}

// Validate the digits of a radix literal (after the two prefix chars).
fun validateRadixDigits(
  chars: Array<Char>,
  digitExpected: ParsingKind,
  isDigit: Char -> Bool,
): ?ParsingKind {
  sz = chars.size();
  if (sz == 2) {
    return Some(digitExpected)
  };
  for (i in Range(2, sz)) {
    c = chars[i];
    if (isDigit(c)) {
      continue
    };
    if (c == '_') {
      if (i == 2 || i == sz - 1) {
        return Some(NumericSeparatorsNotAllowedHere())
      };
      if (chars[i + 1] == '_') {
        return Some(MultipleNumericSeparators())
      };
      if (!isDigit(chars[i - 1]) || !isDigit(chars[i + 1])) {
        return Some(NumericSeparatorsNotAllowedHere())
      };
      continue
    };
    return Some(digitExpected)
  };
  None()
}

// Validate a decimal literal: digits [. digits] [eE [+-] digits], with
// numeric separators only between digits, and no leading zeros (legacy
// octal). The lexer guarantees the first char is a digit.
fun validateDecimalJSLiteral(chars: Array<Char>): ?ParsingKind {
  sz = chars.size();
  if (chars[0] == '0' && sz > 1) {
    c1 = chars[1];
    if (c1 == '_') {
      return Some(NumericSeparatorsNotAllowedHere())
    };
    if (isDecimalDigit(c1)) {
      rest = chars.slice(1, sz);
      if (rest.all(c -> c >= '0' && c <= '7')) {
        return Some(OctalLiteralsNotAllowed("0o" + String::fromChars(rest)))
      };
      return Some(LeadingZeroDecimalNotAllowed())
    };
  };
  (i0, _intCount, intErr) = consumeDecimalDigitRun(chars, 0);
  intErr match {
  | Some _ -> return intErr
  | None() -> void
  };
  i = i0;
  if (i < sz && chars[i] == '.') {
    (i1, _fracCount, fracErr) = consumeDecimalDigitRun(chars, i + 1);
    fracErr match {
    | Some _ -> return fracErr
    | None() -> void
    };
    !i = i1;
  };
  if (i < sz && (chars[i] == 'e' || chars[i] == 'E')) {
    !i = i + 1;
    if (i < sz && (chars[i] == '+' || chars[i] == '-')) {
      !i = i + 1;
    };
    (i2, expCount, expErr) = consumeDecimalDigitRun(chars, i);
    expErr match {
    | Some _ -> return expErr
    | None() -> void
    };
    if (expCount == 0) {
      return Some(DigitExpected())
    };
    !i = i2;
  };
  if (i < sz) {
    // Hex letters in a decimal literal (1a), a second dot or exponent, a
    // misplaced radix prefix char (1x0), ...
    return Some(InvalidNumericLiteral())
  };
  None()
}

// Consume a run of decimal digits with numeric separators starting at
// `start`. Returns (index after the run, digit count, separator error).
fun consumeDecimalDigitRun(
  chars: Array<Char>,
  start: Int,
): (Int, Int, ?ParsingKind) {
  sz = chars.size();
  i = start;
  count = 0;
  loop {
    if (i >= sz) {
      break void
    };
    c = chars[i];
    if (isDecimalDigit(c)) {
      !count = count + 1;
      !i = i + 1;
      continue
    };
    if (c == '_') {
      prevIsDigit = i > start && isDecimalDigit(chars[i - 1]);
      nextIsDigit = i + 1 < sz && isDecimalDigit(chars[i + 1]);
      if (i + 1 < sz && chars[i + 1] == '_') {
        return (i, count, Some(MultipleNumericSeparators()))
      };
      if (!prevIsDigit || !nextIsDigit) {
        return (i, count, Some(NumericSeparatorsNotAllowedHere()))
      };
      !i = i + 1;
      continue
    };
    break void;
  };
  (i, count, None())
}

// Negate a canonical numeric literal name. Negative literals are built by
// the parser and typechecker as unary minus around an unsigned literal, so
// the sign is applied AFTER normalization: this is where -0 collapses to 0
// (String(-0) is "0") and -0n to 0n (bigint has no negative zero). Negating
// an already-negative name (only reachable through constant folding)
// strips the sign.
fun negateJSNumberLiteral(canonical: String): String {
  if (canonical.startsWith("-")) {
    canonical.stripPrefix("-")
  } else if (canonical == "0" || canonical == "0n") {
    canonical
  } else {
    "-" + canonical
  }
}

// Normalize a JS numeric literal to its canonical String(Number(x)) form.
// Handles underscores (1_000), hex (0x10), binary (0b10), trailing
// decimal zeros (1.0), and non-canonical scientific notation (1e3).
fun normalizeJSNumber(raw: String): String {
  s0 = raw.replace("_", "");

  // Handle negative sign
  (negative, s) = if (s0.startsWith("-")) {
    (true, s0.stripPrefix("-"))
  } else {
    (false, s0)
  };

  result = normalizeUnsignedJSNumber(s);
  if (negative && result != "0") "-" + result else result
}

fun normalizeUnsignedJSNumber(s: String): String {
  it = s.getIter();
  c0 = it.next();
  c1 = it.next();
  if (c0 == Some('0')) {
    base = c1 match {
    | Some('x')
    | Some('X') ->
      16
    | Some('b')
    | Some('B') ->
      2
    | Some('o')
    | Some('O') ->
      8
    | _ -> 0
    };
    if (base != 0) {
      return parseRadixInt(s.substring(it), base) match {
      | Some(v) -> v.toString()
      | None() -> s
      }
    };
  };
  normalizeDecimalJS(s)
}

// 2^53: the largest Int an IEEE-754 double represents exactly. Values the
// normalizer cannot represent exactly are left in their spelled form.
const maxSafeJSInt: Int = 9007199254740992;

// Parse validated radix digits (no separators). Returns None when the value
// exceeds maxSafeJSInt: beyond that, exact Int arithmetic diverges from the
// IEEE-754 double rounding JavaScript applies.
fun parseRadixInt(s: String, base: Int): ?Int {
  result = 0;
  for (c in s) {
    digit = Chars.hexDigitToInt(c);
    if (result > (maxSafeJSInt - digit) / base) {
      return None()
    };
    !result = result * base + digit;
  };
  Some(result)
}

// Normalize a decimal literal (no hex/binary prefix, no underscores).
// Input may contain '.', 'e'/'E'.
fun normalizeDecimalJS(s: String): String {
  chars = s.chars().toArray();

  // Find 'e'/'E'
  ePos = {
    r = -1;
    for (i in Range(0, chars.size())) {
      if (chars[i] == 'e' || chars[i] == 'E') !r = i;
    };
    r
  };

  mantissaEnd = if (ePos >= 0) ePos else chars.size();
  rawExp = if (ePos >= 0) {
    expStr = s.substring(s.getIter().forward(ePos + 1));
    expStr.stripPrefix("+").toIntOption() match {
    | Some(v) if (v >= -1000000 && v <= 1000000) -> v
    // An exponent this large is far beyond the double range; leave the
    // literal in its spelled form.
    | _ -> return s
    }
  } else {
    0
  };

  // Find '.' in mantissa
  dotPos = {
    r = -1;
    for (i in Range(0, mantissaEnd)) {
      if (chars[i] == '.') !r = i;
    };
    r
  };

  // Collect all digits (skipping dot); the fractional length is the digit
  // count after the dot.
  allDigits = mutable Vector[];
  for (i in Range(0, mantissaEnd)) {
    if (i != dotPos) {
      allDigits.push(chars[i]);
    };
  };
  fracLen = if (dotPos >= 0) mantissaEnd - dotPos - 1 else 0;

  exp = rawExp - fracLen;
  sz = allDigits.size();

  // Strip leading zeros (keep at least one)
  lead = 0;
  while (lead < sz - 1 && allDigits[lead] == '0') {
    !lead = lead + 1;
  };

  // Strip trailing zeros, adjust exponent
  trail = sz;
  while (trail > lead + 1 && allDigits[trail - 1] == '0') {
    !trail = trail - 1;
    !exp = exp + 1;
  };

  // Check for zero
  if (trail - lead == 1 && allDigits[lead] == '0') return "0";

  sigDigits = String::fromChars(allDigits.toArray().slice(lead, trail));

  // n = number of digits before decimal point in canonical form
  n = (trail - lead) + exp;

  formatCanonicalJSNumber(sigDigits, n)
}

// Format a number from its significant digits and decimal point position.
// n = number of digits before the decimal point.
fun formatCanonicalJSNumber(digits: String, n: Int): String {
  len = digits.length();
  if (n > 21 || n <= -6) {
    // Scientific notation: d.ddd...e[+|-]N
    sciExp = n - 1;
    expSign = if (sciExp > 0) "+" else "-";
    absExp = if (sciExp >= 0) sciExp else -sciExp;
    if (len == 1) {
      digits + "e" + expSign + absExp.toString()
    } else {
      rest = digits.substring(digits.getIter().forward(1));
      digits.take(1) + "." + rest + "e" + expSign + absExp.toString()
    }
  } else if (n >= len) {
    // Plain integer: digits followed by zeros
    digits + "0".repeat(n - len)
  } else if (n > 0) {
    // Decimal point inside digits
    digits.take(n) + "." + digits.substring(digits.getIter().forward(n))
  } else if (n == 0) {
    "0." + digits
  } else {
    // n < 0: leading zeros after decimal point
    "0." + "0".repeat(-n) + digits
  }
}

module end;
