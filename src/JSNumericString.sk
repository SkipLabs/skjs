/***************************************************************************/
/* JS numeric string utilities.                                            */
/*                                                                         */
/* isJSNumericString: checks canonical Number.toString() form.             */
/* normalizeJSNumber: names a JS numeric literal by the String() form of   */
/*   the double it denotes (parsed correctly rounded, printed shortest).   */
/*                                                                         */
/* Number::toString (ECMA-262 §6.1.6.1.20) is implemented by                */
/* jsNumberToString: given significant digits s of length k and decimal    */
/* position n, it lays them out as                                          */
/*   - k ≤ n ≤ 21:  integer with trailing zeros                           */
/*   - 0 < n < k:   decimal point inside digits                           */
/*   - -5 ≤ n ≤ 0:  "0." + leading zeros + digits                        */
/*   - otherwise:    scientific notation d.ddd...e±N                       */
/* and isJSNumericString is the canonical form, as a round-trip check.     */
/*                                                                         */
/* Printing and parsing rely on the stdlib's Ryu-based Float.toString      */
/* (shortest round-trip form, since std 0.5.0 / SkipLabs/skip#1288) and    */
/* its correctly-rounded float parser.                                    */
/*                                                                         */
/* Limitations / TODO:                                                      */
/*   - Literals whose decimal form is 250 characters or longer exceed the  */
/*     runtime float parser and keep their spelled form, so two such       */
/*     spellings of one double stay distinct (sound, stricter than tsc)    */
/*   - Radix-to-decimal conversion of validated 0x/0o/0b literals goes     */
/*     through the skbigint library (SKBigInt.BigInt::fromStringRadix),    */
/*     so it is exact at any magnitude (SkipLabs/skip#1731, #1740)         */
/***************************************************************************/

module SKJS;

// Whether s is exactly the canonical ECMAScript Number::toString() form of a
// finite double — tsc's numeric-name test, `(+s).toString() === s`: s is an
// exact name (it parses and the double prints back as s; the round-trip is
// precise since std 0.5.0, SkipLabs/skip#1288) other than the non-finite
// "Infinity" / "-Infinity". Everything else fails it: radix spellings
// ("0x10"), "-0", "1e3", "1.0", out-of-range exponents ("1e+309" is Infinity,
// not a finite canonical form), and "NaN" (which never parses).
fun isJSNumericString(s: String): Bool {
  isExactJSNumberName(s) && s != "Infinity" && s != "-Infinity"
}

// The IEEE-754 double a number literal name denotes, when it can be
// computed: canonical and beyond-precision decimal names (as normalized by
// normalizeJSNumber), and radix names kept in source form past 2^53, which
// are converted exactly to decimal first. Parsing goes through the runtime's
// correctly-rounded strtod, so two names denote the same double iff their
// results are ==. None when a name cannot be parsed (invalid radix digits,
// or longer than the runtime parser accepts): callers must then assume any
// value. Total: never throws, whatever the string.
fun jsNumberLiteralDouble(name: String): ?Float {
  (negative, unsigned) = if (name.startsWith("-")) {
    (true, name.stripPrefix("-"))
  } else {
    (false, name)
  };
  if (unsigned == "Infinity") {
    return Some(if (negative) -Float::inf else Float::inf)
  };
  base = jsLiteralRadixBase(unsigned);
  decimal = if (base == 10) {
    // The runtime parser needs a digit before the point: `.5` is `0.5`.
    if (unsigned.startsWith(".")) "0" + unsigned else unsigned
  } else {
    // Exact radix-to-decimal conversion via skbigint (the digits are
    // validated, so this cannot fail; None would mean any value).
    SKBigInt.BigInt::fromStringRadix(
      unsigned.substring(unsigned.getIter().forward(2)),
      base,
    ).map(bi -> bi.toString()) match {
    | Some(d) -> d
    | None() -> return None()
    }
  };
  // The runtime parser rejects inputs of 255 bytes or more: drop the zero
  // padding of a long spelling first, which does not change its value.
  short = if (decimal.length() >= 250) compactDecimal(decimal) else decimal;
  if (short.length() >= 250) return None();
  short.toFloatOption().map(f -> if (negative) -f else f)
}

// Split a raw literal spelling into (negative, unsigned) with the numeric
// separators removed: `-1_000` is (true, "1000").
fun splitSignedLiteral(raw: String): (Bool, String) {
  s = raw.replace("_", "");
  if (s.startsWith("-")) (true, s.stripPrefix("-")) else (false, s)
}

// Split `<mantissa>e<exponent>` (either 'e' or 'E') into its two parts; the
// exponent part is "" when there is none.
fun splitExponent(s: String): (String, String) {
  s.splitFirst("e") match {
  | (_, "") -> s.splitFirst("E")
  | p -> p
  }
}

// Normalize decimal digits whose point sits at `point` (value =
// 0.chars * 10^point) to canonical (digits, exp10) without leading or
// trailing zeros: value = 0.digits * 10^(exp10 + 1). ("0", 0) is exact zero.
fun decimalDigitsExp(chars: Vector<Char>, point: Int): (String, Int) {
  lead = 0;
  while (lead < chars.size() && chars[lead] == '0') !lead = lead + 1;
  !point = point - lead;
  trail = chars.size();
  while (trail > lead && chars[trail - 1] == '0') !trail = trail - 1;
  if (lead == trail) return ("0", 0);
  (String::fromChars(chars.slice(lead, trail).toArray()), point - 1)
}

// An unsigned decimal literal rewritten without leading or trailing zero
// digits, as `<digits>e<exp>` (exactly the same value), or unchanged when
// its exponent is not a small integer. `000.0012300e5` is `123e-1`.
fun compactDecimal(s: String): String {
  (mantissa, expPart) = splitExponent(s);
  exp = if (expPart == "") 0 else {
    expPart.stripPrefix("+").toIntOption() match {
    | Some(n) if (n >= -1000000 && n <= 1000000) -> n
    | _ -> return s
    }
  };
  (intPart, fracPart) = mantissa.splitFirst(".");
  (digits, exp10) = decimalDigitsExp(
    (intPart + fracPart).chars(),
    intPart.length() + exp,
  );
  if (digits == "0") return "0";
  // value = 0.digits * 10^(exp10 + 1) = digits * 10^exp
  digits + "e" + (exp10 + 1 - digits.length()).toString()
}

// Whether a number literal name is exactly the ECMAScript String() form of
// the double it denotes: it parses, and the double prints back as the name.
// normalizeJSNumber produces such names for every literal it can parse, so
// the only inexact names are spellings it kept (too long for the runtime
// parser). String() is a function of the double, so two distinct exact names
// denote distinct doubles: exact names compare by name. "NaN" is never exact
// (the runtime parser rejects it), and "Infinity" / "-Infinity" are exact.
fun isExactJSNumberName(name: String): Bool {
  jsNumberLiteralDouble(name).map(jsNumberToString) == Some(name)
}

// Whether two number literal names may denote the same double: equal names
// do, distinct exact names never do, and an inexact name may denote anything.
fun jsNumberLiteralsMayCollide(a: String, b: String): Bool {
  a == b || !isExactJSNumberName(a) || !isExactJSNumberName(b)
}

// Whether a number literal name may denote a falsy value (+0, -0 or NaN),
// and whether it may denote a truthy one. An exact name is falsy iff it is
// "0" (-0 is named "0"; "NaN" is never an exact name); an inexact name may
// be either.
fun jsNumberLiteralMayBeFalsy(name: String): Bool {
  name == "0" || !isExactJSNumberName(name)
}

fun jsNumberLiteralMayBeTruthy(name: String): Bool {
  name != "0" || !isExactJSNumberName(name)
}

// A property name a `number`-typed key can produce at runtime, i.e. some
// `String(n)`. This is TypeScript's notion of a numeric property name
// (`(+name).toString() === name`): the finite canonical numeric strings
// (isJSNumericString) plus the three non-finite results of
// `Number.prototype.toString` — "Infinity", "-Infinity", and "NaN".
//
// Distinct from isJSNumericString, which is finite-only (numbers reachable as
// numeric *literals*). Use this one for number-key reachability and number-index
// governance; use isJSNumericString for number-literal construction (e.g. keyof).
fun isJSNumberKeyName(s: String): Bool {
  isJSNumericString(s) || s == "Infinity" || s == "-Infinity" || s == "NaN"
}

// Validate that a TKNumber lexeme is a well-formed ES2021 NumericLiteral.
// The lexer scans any run of number-ish characters, so malformed forms like
// 0b12, 0o8, 0x, 1e, 1__0, 1_ and legacy octal 010 arrive here as single
// tokens; tsc rejects all of them as syntax errors. Returns the parse error
// to report, or None for a valid literal.
fun validateJSNumericLiteral(raw: String): ?ParsingKind {
  chars = raw.chars().toArray();
  (done, err) = validateIntegerPrefix(chars, "");
  err match {
  | Some(e) -> return Some(e)
  | None() -> void
  };
  if (done) return None();
  validateDecimalJSLiteral(chars)
}

fun isDecimalDigit(c: Char): Bool {
  c >= '0' && c <= '9'
}

// The radix of a 0x/0b/0o prefix character, or 0 when c is none of them.
fun radixPrefixBase(c: Char): Int {
  c match {
  | 'x' | 'X' -> 16
  | 'b' | 'B' -> 2
  | 'o' | 'O' -> 8
  | _ -> 0
  }
}

// Validate the head of a TKNumber / TKBigInt lexeme. Returns (done, err):
// err is Some on a validation error; done is true when the lexeme had a
// 0x/0b/0o prefix — then it is fully validated and the caller must stop —
// and false when there is no prefix, so the caller continues with the
// decimal body. Without a leading zero, also rejects legacy octal and a
// numeric separator right after the zero. `suffix` is "" for numbers and
// "n" for bigints, used in the octal message.
fun validateIntegerPrefix(
  chars: Array<Char>,
  suffix: String,
): (Bool, ?ParsingKind) {
  sz = chars.size();
  if (sz >= 2 && chars[0] == '0') {
    base = radixPrefixBase(chars[1]);
    if (base != 0) {
      return (true, validateRadixDigits(chars, base))
    };
    c1 = chars[1];
    if (c1 == '_') {
      return (false, Some(NumericSeparatorsNotAllowedHere()))
    };
    if (isDecimalDigit(c1)) {
      rest = chars.slice(1, sz);
      if (rest.all(c -> c >= '0' && c <= '7')) {
        return (
          false,
          Some(
            OctalLiteralsNotAllowed("0o" + String::fromChars(rest) + suffix),
          ),
        )
      };
      return (false, Some(LeadingZeroDecimalNotAllowed()))
    }
  };
  (false, None())
}

// Validate the digits of a radix literal (after the two prefix chars).
fun validateRadixDigits(chars: Array<Char>, base: Int): ?ParsingKind {
  digitExpected = base match {
  | 16 -> HexDigitExpected()
  | 8 -> OctalDigitExpected()
  | _ -> BinaryDigitExpected()
  };
  isDigit = c -> radixDigitValue(c, base).isSome();
  sz = chars.size();
  if (sz == 2) {
    return Some(digitExpected)
  };
  for (i in Range(2, sz)) {
    c = chars[i];
    if (isDigit(c)) {
      continue
    };
    if (c == '_') {
      if (i == 2 || i == sz - 1) {
        return Some(NumericSeparatorsNotAllowedHere())
      };
      if (chars[i + 1] == '_') {
        return Some(MultipleNumericSeparators())
      };
      if (!isDigit(chars[i - 1]) || !isDigit(chars[i + 1])) {
        return Some(NumericSeparatorsNotAllowedHere())
      };
      continue
    };
    return Some(digitExpected)
  };
  None()
}

// Validate a decimal literal: digits [. digits] [eE [+-] digits], with
// numeric separators only between digits. The lexer guarantees the first
// char is a digit; the leading-zero (legacy octal) check lives in
// validateIntegerPrefix.
fun validateDecimalJSLiteral(chars: Array<Char>): ?ParsingKind {
  sz = chars.size();
  (i0, _intCount, intErr) = consumeDecimalDigitRun(chars, 0);
  intErr match {
  | Some _ -> return intErr
  | None() -> void
  };
  i = i0;
  if (i < sz && chars[i] == '.') {
    (i1, _fracCount, fracErr) = consumeDecimalDigitRun(chars, i + 1);
    fracErr match {
    | Some _ -> return fracErr
    | None() -> void
    };
    !i = i1;
  };
  if (i < sz && (chars[i] == 'e' || chars[i] == 'E')) {
    !i = i + 1;
    if (i < sz && (chars[i] == '+' || chars[i] == '-')) {
      !i = i + 1;
    };
    (i2, expCount, expErr) = consumeDecimalDigitRun(chars, i);
    expErr match {
    | Some _ -> return expErr
    | None() -> void
    };
    if (expCount == 0) {
      return Some(DigitExpected())
    };
    !i = i2;
  };
  if (i < sz) {
    // Hex letters in a decimal literal (1a), a second dot or exponent, a
    // misplaced radix prefix char (1x0), ...
    return Some(InvalidNumericLiteral())
  };
  None()
}

// Consume a run of decimal digits with numeric separators starting at
// `start`. Returns (index after the run, digit count, separator error).
fun consumeDecimalDigitRun(
  chars: Array<Char>,
  start: Int,
): (Int, Int, ?ParsingKind) {
  sz = chars.size();
  i = start;
  count = 0;
  loop {
    if (i >= sz) {
      break void
    };
    c = chars[i];
    if (isDecimalDigit(c)) {
      !count = count + 1;
      !i = i + 1;
      continue
    };
    if (c == '_') {
      prevIsDigit = i > start && isDecimalDigit(chars[i - 1]);
      nextIsDigit = i + 1 < sz && isDecimalDigit(chars[i + 1]);
      if (i + 1 < sz && chars[i + 1] == '_') {
        return (i, count, Some(MultipleNumericSeparators()))
      };
      if (!prevIsDigit || !nextIsDigit) {
        return (i, count, Some(NumericSeparatorsNotAllowedHere()))
      };
      !i = i + 1;
      continue
    };
    break void;
  };
  (i, count, None())
}

// Validate that a TKBigInt lexeme (trailing 'n' included) is a well-formed
// bigint literal: an integer in decimal or radix form, with separators only
// between digits. Fractions, exponents and legacy octal are rejected the
// way tsc rejects them.
fun validateJSBigIntLiteral(raw: String): ?ParsingKind {
  chars = raw.stripSuffix("n").chars().toArray();
  sz = chars.size();
  (done, err0) = validateIntegerPrefix(chars, "n");
  err0 match {
  | Some(e) -> return Some(e)
  | None() -> void
  };
  if (done) return None();
  (i0, _count, err) = consumeDecimalDigitRun(chars, 0);
  err match {
  | Some _ -> return err
  | None() -> void
  };
  if (i0 < sz) {
    if (chars[i0] == '.' || chars[i0] == 'e' || chars[i0] == 'E') {
      return Some(BigIntLiteralMustBeInteger())
    };
    return Some(InvalidNumericLiteral())
  };
  None()
}

// Normalize a validated bigint literal to its canonical form: underscores
// stripped and radix forms converted to decimal via skbigint (exactly —
// bigints are arbitrary precision, so no magnitude guard is needed). The
// trailing 'n' is preserved.
fun normalizeJSBigInt(raw: String): String {
  s = raw.stripSuffix("n").replace("_", "");
  base = jsLiteralRadixBase(s);
  if (base != 10) {
    // The digits are validated, so the skbigint conversion cannot fail; a
    // failure would keep the spelled form, which is sound.
    return SKBigInt.BigInt::fromStringRadix(
      s.substring(s.getIter().forward(2)),
      base,
    ).map(bi -> bi.toString() + "n") match {
    | Some(d) -> d
    | None() -> s + "n"
    }
  };
  s + "n"
}

// The value of a digit character in the given base, or None when it is not a
// valid digit for that base.
fun radixDigitValue(c: Char, base: Int): ?Int {
  d = if (c >= '0' && c <= '9') {
    c.code() - '0'.code()
  } else if (c >= 'a' && c <= 'f') {
    c.code() - 'a'.code() + 10
  } else if (c >= 'A' && c <= 'F') {
    c.code() - 'A'.code() + 10
  } else {
    return None()
  };
  if (d >= base) None() else Some(d)
}

// Negate a canonical numeric literal name. Negative literals are built by
// the parser and typechecker as unary minus around an unsigned literal, so
// the sign is applied AFTER normalization: this is where -0 collapses to 0
// (String(-0) is "0") and -0n to 0n (bigint has no negative zero). Negating
// an already-negative name (only reachable through constant folding)
// strips the sign.
fun negateJSNumberLiteral(canonical: String): String {
  if (canonical.startsWith("-")) {
    canonical.stripPrefix("-")
  } else if (canonical == "0" || canonical == "0n") {
    canonical
  } else {
    "-" + canonical
  }
}

// The ECMAScript String() form of a double (Number::toString, ECMA-262
// 6.1.6.1.20): "NaN", "Infinity", "-Infinity", "0" for both zeros, otherwise
// the shortest digits that round-trip, laid out by formatCanonicalJSNumber.
// The digits come from Float.toString, which is Ryu's shortest round-trip
// form since Skip std 0.5.0 (SkipLabs/skip#1288) -- the same digits JS
// prints. Ryu guarantees those digits read back to this very double, and the
// runtime parse is correctly rounded, while formatCanonicalJSNumber only
// rearranges digits and exponent, so the name always denotes f: no
// round-trip guard is needed.
fun jsNumberToString(f: Float): String {
  if (f.isNaN()) return "NaN";
  if (f == Float::inf) return "Infinity";
  if (f == -Float::inf) return "-Infinity";
  if (f == 0.0) return "0";
  negative = f < 0.0;
  magnitude = if (negative) -f else f;
  (digits, exp10) = shortestFloatDigits(magnitude);
  unsigned = formatCanonicalJSNumber(digits, exp10 + 1);
  if (negative) "-" + unsigned else unsigned
}

// Normalize a validated JS numeric literal (underscores, radix prefixes,
// exponents and a leading `-` allowed) to the ECMAScript String() form of
// the double it denotes, so every spelling of one double is one literal type,
// as tsc keys them: `1.0` = `1`, `0x10` = `16`, `1e3` = `1000`,
// `9007199254740993` = `9007199254740992`, `1e-400` = `0`, `2e309` =
// `Infinity` (issue #781). The double is computed exactly (radix digits are
// converted to decimal first, then parsed correctly rounded), and printed by
// jsNumberToString. A literal whose double cannot be computed keeps its
// spelling, which is sound: names then only fail to merge.
fun normalizeJSNumber(raw: String): String {
  (negative, unsigned) = splitSignedLiteral(raw);
  jsNumberLiteralDouble(unsigned).map(jsNumberToString) match {
  | Some(name) -> if (negative && name != "0") "-" + name else name
  | None() -> if (negative) "-" + unsigned else unsigned
  }
}

// The significant digits and decimal exponent of a positive finite double's
// shortest round-trip representation: f = 0.d1d2...dn * 10^(exp10 + 1),
// i.e. d1.d2...dn * 10^exp10. Parsed from Float.toString, which since Skip
// std 0.5.0 (Ryu, SkipLabs/skip#1288) always prints that shortest form in
// one of the layouts "123.45", "1.0", "1.2345e+20", "5.0e-324" (fixed or
// exponent notation).
fun shortestFloatDigits(f: Float): (String, Int) {
  s = f.toString();
  (mantissa, expPart) = splitExponent(s);
  exp = if (expPart == "") 0 else {
    expPart.stripPrefix("+").toIntOption().fromSome()
  };
  (intPart, fracPart) = mantissa.splitFirst(".");
  // Position of the decimal point within the digits: value = 0.digits * 10^point.
  decimalDigitsExp((intPart + fracPart).chars(), intPart.length() + exp)
}

// The radix base of an unsigned literal spelling: 16/8/2 for the 0x/0o/0b
// prefixes, else 10.
fun jsLiteralRadixBase(unsigned: String): Int {
  chars = unsigned.chars();
  if (chars.size() >= 2 && chars[0] == '0') {
    base = radixPrefixBase(chars[1]);
    if (base != 0) return base
  };
  10
}

// The exact value of an unsigned validated numeric literal, as canonical
// (digits, exp10) with value = 0.digits * 10^(exp10 + 1) and no leading or
// trailing zeros in digits — the same convention shortestFloatDigits uses,
// so an exact value and a double's shortest form compare directly. ("0", 0)
// represents an exact zero. None when the exponent is not an Int (the value
// is then 0 or infinite, decided via the double). Only called on validated
// literals, so the radix conversion cannot fail.
fun jsLiteralExactDigits(unsigned: String): ?(String, Int) {
  base = jsLiteralRadixBase(unsigned);
  (chars, point) = if (base == 10) {
    (mantissa, expPart) = splitExponent(unsigned);
    exp = if (expPart == "") 0 else {
      expPart.stripPrefix("+").toIntOption() match {
      | Some(n) -> n
      | None() -> return None()
      }
    };
    (intPart, fracPart) = mantissa.splitFirst(".");
    // Position of the decimal point within the digits: value = 0.chars * 10^point.
    ((intPart + fracPart).chars(), intPart.length() + exp)
  } else {
    decimal = SKBigInt.BigInt::fromStringRadix(
      unsigned.substring(unsigned.getIter().forward(2)),
      base,
    ).map(bi -> bi.toString()) match {
    | Some(d) -> d
    | None() -> return None()
    };
    (decimal.chars(), decimal.length())
  };
  Some(decimalDigitsExp(chars, point))
}

// Whether a validated numeric literal is read by JS as a different value than
// the exact decimal it spells — String(double(raw)) differs from the literal's
// exact value — and if so, the warning message and code. The three surprise
// cases: overflow to ±Infinity, underflow to 0, and rounding (precision loss,
// including in the denormal range). Cosmetic respellings of the same value
// (1e3 = 1000, 0x10 = 16, 1.0 = 1, 1_000 = 1000, -0 = 0) and exactly
// representable values (0.1, 1e21, 5e-324) stay silent, as does a literal too
// long for the runtime parser (SKJS keeps its spelling; names then only fail
// to merge).
fun jsNumberLiteralSurprise(raw: String): ?(String, ErrorCode) {
  (negative, unsigned) = splitSignedLiteral(raw);
  f = jsNumberLiteralDouble(unsigned) match {
  | Some(f) -> f
  | None() -> return None()
  };
  // The signed double and its String() form, for the messages.
  fSigned = if (negative) -f else f;
  name = jsNumberToString(fSigned);
  if (f == Float::inf || f == -Float::inf) {
    return Some(
      (`Number literal '${raw}' overflows to ${name}`, SKJSCode(2080)),
    )
  };
  exact = jsLiteralExactDigits(unsigned);
  if (f == 0.0) {
    // Underflow is silent exactly when the literal spells zero itself.
    exact match {
    | Some(("0", _)) -> None()
    | _ -> Some((`Number literal '${raw}' underflows to 0`, SKJSCode(2081)))
    }
  } else {
    // f is the unsigned magnitude, a positive finite double here.
    (digitsF, exp10F) = shortestFloatDigits(f);
    exact match {
    | Some((digitsW, exp10W)) ->
      if (digitsW == digitsF && exp10W == exp10F) {
        None()
      } else {
        Some(
          (
            `Number literal '${raw}' is rounded to ${name} by IEEE-754 double precision`,
            SKJSCode(2082),
          ),
        )
      }
    | None() -> None()
    }
  }
}

// 2^53: the largest Int an IEEE-754 double represents exactly (used by enum
// constant folding, which folds integers exactly).
const maxSafeJSInt: Int = 9007199254740992;

// Format a number from its significant digits and decimal point position.
// n = number of digits before the decimal point.
fun formatCanonicalJSNumber(digits: String, n: Int): String {
  len = digits.length();
  if (n > 21 || n <= -6) {
    // Scientific notation: d.ddd...e[+|-]N
    sciExp = n - 1;
    expSign = if (sciExp > 0) "+" else "-";
    absExp = if (sciExp >= 0) sciExp else -sciExp;
    if (len == 1) {
      digits + "e" + expSign + absExp.toString()
    } else {
      rest = digits.substring(digits.getIter().forward(1));
      digits.take(1) + "." + rest + "e" + expSign + absExp.toString()
    }
  } else if (n >= len) {
    // Plain integer: digits followed by zeros
    digits + "0".repeat(n - len)
  } else if (n > 0) {
    // Decimal point inside digits
    digits.take(n) + "." + digits.substring(digits.getIter().forward(n))
  } else if (n == 0) {
    "0." + digits
  } else {
    // n < 0: leading zeros after decimal point
    "0." + "0".repeat(-n) + digits
  }
}

module end;
