//
// Data structure for maps backed by arrays where the keys are internal to
// the data and obtained using a projection function
//

trait Projectable<T> {
  readonly fun project(): T;
}

module InternalKeyedArrayMap;

// see iterDiffInterDiff
private mutable class DiffInterDiffIterator<
  K: Orderable,
  T: Projectable<K>,
> private (
  private mutable head1: ?T,
  private tail1: mutable Iterator<T>,
  private mutable head2: ?T,
  private tail2: mutable Iterator<T>,
) extends Iterator<(?T, ?T)> {
  static fun create(
    iter1: mutable Iterator<T>,
    iter2: mutable Iterator<T>,
  ): mutable Iterator<(?T, ?T)> {
    head1 = iter1.next();
    head2 = iter2.next();
    mutable static(head1, iter1, head2, iter2)
  }

  readonly fun sizeHint(): ?Int {
    size1 = this.tail1.sizeHint().map((n) ->
      if (this.head1.isSome()) n + 1 else n
    );
    size2 = this.tail2.sizeHint().map((n) ->
      if (this.head2.isSome()) n + 1 else n
    );
    (size1, size2) match {
    | (Some(m), Some(n)) ->
      Some(m + n) // actual size will be between max and sum of sizes
    | (Some(n), None())
    | (None(), Some(n)) ->
      Some(n)
    | (None(), None()) -> None()
    }
  }

  mutable fun next(): ?(?T, ?T) {
    none: ?T = None();
    go = (x, y) -> {
      if (x.isSome()) this.!head1 = this.tail1.next();
      if (y.isSome()) this.!head2 = this.tail2.next();
      Some((x, y))
    };
    (this.head1, this.head2) match {
    | (None(), None()) -> None()
    | (None(), Some(_)) -> go(none, this.head2)
    | (Some(_), None()) -> go(this.head1, none)
    | (Some(x), Some(y)) ->
      x.project().compare(y.project()) match {
      | LT() -> go(this.head1, none)
      | EQ() -> go(this.head1, this.head2)
      | GT() -> go(none, this.head2)
      }
    }
  }
}

// A map where the keys are projected from the values, backed by a sorted array
class .InternalKeyedArrayMap<K: Orderable, T: Projectable<K>> private (
  private inner: Vector<T>,
) uses Orderable[T: Orderable], Hashable[T: Hashable] {
  private static fun create(size: Int, init: (T -> void) -> void): this {
    // create by allocating, initializing via push, and checking collisions
    inner = Vector::mcreate(size);
    init(inner.push);
    // inner must be strictly increasing under project, which is expected to
    // hold since every transformation of T, such as the argument of map,
    // should preserve project
    prev: ?T = None();
    for (curr in inner) {
      prev match {
      | Some(p) ->
        if (p.project() >= curr.project()) {
          invariant_violation("InternalKeyedArrayMap::create")
        }
      | None() -> void
      };
      !prev = Some(curr);
    };
    static(unsafe_chill_trust_me(inner))
  }

  static fun createFromSortedIterator<I: mutable Iterator<T>>(items: I): this {
    static::create(items.sizeHint().default(0), items.each)
  }

  static fun empty(): this {
    static(Vector[])
  }

  static fun single(x: T): this {
    static(Vector[x])
  }

  fun isEmpty(): Bool {
    this.inner.isEmpty()
  }

  fun size(): Int {
    this.inner.size()
  }

  fun minimum(): ?T {
    this.inner.maybeGet(0)
  }

  fun get(i: Int): T {
    this.inner.get(i)
  }

  fun toArray(): Array<T> {
    this.inner.toArray()
  }

  fun values(): mutable Iterator<T> {
    this.inner.values()
  }

  fun items(): mutable Iterator<(Int, T)> {
    this.inner.items()
  }

  fun any(f: T -> Bool): Bool {
    this.inner.any(f)
  }

  fun all(f: T -> Bool): Bool {
    this.inner.all(f)
  }

  fun find(f: T -> Bool): ?T {
    this.inner.find(f)
  }

  fun filter(f: T -> Bool): this {
    // don't need to call create since Vector.filter returns a subset and
    // preserves order
    static(this.inner.filter(f))
  }

  // REQUIRES: f must preserve project: x.project() == f(x).project() for any x
  fun map(f: T -> T): this {
    static::createFromSortedIterator(this.inner.values().map(f))
  }

  // REQUIRES: f must preserve project: x.project() == f(x).project() for any x
  fun filterMap(f: T -> ?T): this {
    static::createFromSortedIterator(this.inner.values().filterMap(f))
  }

  // s.iterDiffInterDiff(t) contains (Some(x), None()) for every element in
  // s but not t, (None(), Some(y)) for every y in t but not s, and
  // (Some(x), Some(y)) for every pair of elements that are in both s and t.
  fun iterDiffInterDiff(that: this): mutable Iterator<(?T, ?T)> {
    DiffInterDiffIterator::create(this.inner.values(), that.inner.values())
  }

  fun iterDiff(that: this): mutable Iterator<(T, ?T)> {
    this.iterDiffInterDiff(that).filterMap((xO_yO) ->
      xO_yO match {
      | (Some(x), yO) -> Some((x, yO))
      | (None(), _) -> None()
      }
    )
  }

  // s.leq(t, leqT) is Success if leqT(x, t.maybeGet(x)) is Success for every
  // x in s, otherwise the first Failure encountered is returned
  // immediately. Note that any extra elements in t are ignored.
  fun leq<E>(that: this, leqT: (T, ?T) -> Result<void, E>): Result<void, E> {
    this.iterDiff(that).findMap((x_yO) ->
      x_yO match {
      | (x, yO) ->
        leqT(x, yO) match {
        | Success(void) -> None()
        | Failure(err) -> Some(err)
        }
      }
    ) match {
    | None() -> Success(void)
    | Some(err) -> Failure(err)
    }
  }

  // s.geq(t, geqT) is Success if geqT(s.maybeGet(y), y) is Success for every
  // y in t, otherwise the first Failure encountered is returned
  // immediately. Note that any extra elements in s are ignored.
  fun geq<E>(that: this, geqT: (?T, T) -> Result<void, E>): Result<void, E> {
    that.leq(this, (y, xO) -> geqT(xO, y))
  }

  // s.merge(t, f) is the set of elements v where Some(v) is returned by f
  // from (Some(x), None) for every element in s but not t, (None, Some(y))
  // for every y in t but not s, and (Some(x), Some(y)) for every pair of
  // elements that are in both s and t. If f returns None, it indicates the
  // unit of the merge operation and no corresponding element is included in
  // the result.
  //
  // REQUIRES: f must preserve project:
  // x.project() == f(Some(x),_).each(project) for any x and
  // y.project() == f(_,Some(y)).each(project) for any y
  fun merge(that: this, f: (?T, ?T) -> ?T): this {
    static::createFromSortedIterator(
      this.iterDiffInterDiff(that).filterMap((xO_yO) ->
        xO_yO match {
        | (xO, yO) -> f(xO, yO)
        }
      ),
    )
  }

  // mergeOption is a generalization of merge where f may return None() to
  // indicate the zero of the merge operation, causing mergeOption to return
  // None() immediately, Some(None()) indicating the unit of the merge
  // operation, and Some(Some(z)) indicating an element.
  //
  // REQUIRES: f must preserve project:
  // x.project() == f(Some(x),_).each(project) for any x and
  // y.project() == f(_,Some(y)).each(project) for any y
  fun mergeOption(that: this, f: (?T, ?T) -> ??T): ?this {
    zero = false;
    result =
      this.iterDiffInterDiff(that)
        .map((xO_yO) -> {
          zOO = xO_yO match {
          | (xO, yO) -> f(xO, yO)
          };
          if (zOO.isNone()) !zero = true;
          zOO
        })
        .takeWhile((zOO) -> zOO.isSome())
        .map((zOO) -> zOO.fromSome())
        .filterNone() |> static::createFromSortedIterator;
    if (zero) None() else Some(result)
  }

  fun union(that: this): this {
    this.merge(that, (xO, yO) ~>
      xO match {
      | None() -> yO
      | _ -> xO
      }
    )
  }

  fun mapInter(that: this, f: (T, T) -> T): this {
    this.merge(that, (xO, yO) ->
      (xO, yO) match {
      | (Some(x), Some(y)) -> Some(f(x, y))
      | _ -> None()
      }
    )
  }

  fun mapUnion(that: this, f: (T, T) -> T): this {
    this.merge(that, (xO, yO) ->
      (xO, yO) match {
      | (Some(z), None())
      | (None(), Some(z)) ->
        Some(z)
      | (Some(x), Some(y)) -> Some(f(x, y))
      | (None(), None()) -> None()
      }
    )
  }

  fun mapInterOption(that: this, f: (T, T) -> ?T): ?this {
    this.mergeOption(that, (xO, yO) ->
      (xO, yO) match {
      | (Some(x), Some(y)) ->
        f(x, y) match {
        | None() -> None()
        | sz -> Some(sz)
        }
      | _ -> Some(None())
      }
    )
  }

  fun mapUnionOption(that: this, f: (T, T) -> ?T): ?this {
    this.mergeOption(that, (xO, yO) ->
      (xO, yO) match {
      | (Some(z), None())
      | (None(), Some(z)) ->
        Some(Some(z))
      | (Some(x), Some(y)) ->
        f(x, y) match {
        | Some(z) -> Some(Some(z))
        | None() -> None()
        }
      | (None(), None()) -> Some(None())
      }
    )
  }
}

module end;
