//
// Data structure for maps backed by arrays where the keys are internal to
// the data and obtained using a projection function
//

module InternalKeyedArrayMap;

// A map where the keys are projected from the values, backed by a sorted array
class .InternalKeyedArrayMap<K: Orderable, T: Projectable<K>> private (
  private inner: Vector<T>,
) extends Sequence<T> uses Orderable[T: Orderable], XXHashable[T: XXHashable] {
  /* Constructors */

  private static fun createFromSortedVector(inner: Vector<T>): this {
    // inner must be strictly increasing under project, which is expected to
    // hold since every transformation of T, such as the argument of map,
    // should preserve project
    prev: ?T = None();
    for (curr in inner) {
      prev match {
      | Some(p) ->
        if (p.project() >= curr.project()) {
          internal_error("InternalKeyedArrayMap::create")
        }
      | None() -> void
      };
      !prev = Some(curr);
    };
    static(inner)
  }

  private static fun create(size: Int, init: (T -> void) -> void): this {
    // create by allocating, initializing via push, and checking collisions
    inner = Vector::mcreate(size);
    init(inner.push);
    static::createFromSortedVector(unsafe_chill_trust_me(inner))
  }

  static fun createFromSortedIterator<I: mutable Iterator<T>>(items: I): this {
    static::create(items.sizeHint().default(0), items.each)
  }

  static fun createFromIterator<I: mutable Iterator<T>>(items: I): this {
    inner = Vector::mcreateFromIterator(items);
    inner.sortBy(x ~> x.project());
    static::createFromSortedVector(unsafe_chill_trust_me(inner))
  }

  static fun empty(): this {
    static(Vector[])
  }

  static fun single(x: T): this {
    static(Vector[x])
  }

  /* Getters */

  fun isEmpty(): Bool {
    this.inner.isEmpty()
  }

  fun size(): Int {
    this.inner.size()
  }

  fun singleElt(): ?T {
    if (this.inner.size() == 1) Some(this.inner[0]) else None()
  }

  fun minimum(): ?T {
    this.inner.maybeGet(0)
  }

  fun maybeGet(k: K): ?T {
    idx = SKStore.binSearch(
      i ~> this.inner[i].project(),
      k,
      0,
      this.inner.size() - 1,
    );
    if (idx < 0 || idx >= this.inner.size() || this.inner[idx].project() != k) {
      None()
    } else {
      Some(this.inner[idx])
    }
  }

  fun containsKey(k: K): Bool {
    this.maybeGet(k).isSome()
  }

  /* Iterations */

  fun toVector(): Vector<T> {
    this.inner
  }

  fun toArray(): Array<T> {
    this.inner.toArray()
  }

  fun values(): mutable Iterator<T> {
    this.inner.values()
  }

  fun items(): mutable Iterator<(Int, T)> {
    this.inner.items()
  }

  // s.iterDiffInterDiff(t) contains Left(x) for every x in s but not t,
  // Right(y) for every y in t but not s, and Both(x, y) for every pair of
  // elements that are in both s and t.
  fun iterDiffInterDiff(that: this): mutable Iterator<InclusiveOr<T, T>> {
    this.inner.values().zipSortedBy(that.inner.values())
  }

  fun iterDiff(that: this): mutable Iterator<T> {
    this.iterDiffInterDiff(that).filterMap(v -> v.maybeLeft())
  }

  /* Searching */

  fun any(f: T -> Bool): Bool {
    this.inner.any(f)
  }

  fun all(f: T -> Bool): Bool {
    this.inner.all(f)
  }

  fun find(f: T -> Bool): ?T {
    this.inner.find(f)
  }

  /* Transformers */

  fun filterKeyed(f: T -> Bool): this {
    // don't need to call create since Vector.filter returns a subset and
    // preserves order
    static(this.inner.filter(f))
  }

  // REQUIRES: f must preserve project: x.project() == f(x).project() for any x
  fun mapKeyed(f: T -> T): this {
    f1 = (x) -> {
      y = f(x);
      assert(x.project() == y.project());
      y
    };
    static(this.inner.map(f1))
  }

  // REQUIRES: f must preserve project: x.project() == f(x).project() for any x
  fun filterMap(f: T -> ?T): this {
    f1 = (x) -> {
      yO = f(x);
      yO match {
      | None() -> void
      | Some(y) -> assert(x.project() == y.project())
      };
      yO
    };
    static::createFromSortedIterator(this.inner.values().filterMap(f1))
  }

  fun diff(that: this): this {
    InternalKeyedArrayMap::createFromSortedIterator(this.iterDiff(that))
  }

  // s.merge(t, f) is the set of elements returned by f
  // from Left(x) for every element in s but not t, Right(y) for every y in
  // t but not s, and Both(x, y) for every pair of elements that are in both
  // s and t.
  //
  // REQUIRES: f must preserve project:
  // x.project() == f(Left(x)).project() for any x and
  // y.project() == f(Right(y)).project() for any y
  fun merge(that: this, f: InclusiveOr<T, T> -> T): this {
    static::createFromSortedIterator(this.iterDiffInterDiff(that).map(f))
  }

  // s.mergeOpt(t, f) is the set of elements v where Some(v) is returned by f
  // from Left(x) for every element in s but not t, Right(y) for every y in
  // t but not s, and Both(x, y) for every pair of elements that are in both
  // s and t. If f returns None, it indicates the unit of the merge
  // operation and no corresponding element is included in the result.
  //
  // REQUIRES: f must preserve project:
  // x.project() == f(Left(x)).each(project) for any x and
  // y.project() == f(Right(y)).each(project) for any y
  fun mergeOpt(that: this, f: InclusiveOr<T, T> -> ?T): this {
    static::createFromSortedIterator(this.iterDiffInterDiff(that).filterMap(f))
  }

  // mergeOption is a generalization of mergeOpt where f may return None() to
  // indicate the zero of the merge operation, causing mergeOption to return
  // None() immediately, Some(None()) indicating the unit of the merge
  // operation, and Some(Some(z)) indicating an element.
  //
  // REQUIRES: f must preserve project:
  // x.project() == f(Left(x)).each(project) for any x and
  // y.project() == f(Right(y)).each(project) for any y
  fun mergeOption(that: this, f: InclusiveOr<T, T> -> ??T): ?this {
    zero = false;
    result =
      this.iterDiffInterDiff(that)
        .map(ior -> {
          zOO = f(ior);
          if (zOO is None()) !zero = true;
          zOO
        })
        .takeWhile(zOO -> zOO is Some(_))
        .map(zOO -> zOO.fromSome())
        .filterNone() |> static::createFromSortedIterator;
    if (zero) None() else Some(result)
  }

  fun inter(that: this): this {
    this.mergeOpt(that, ior ~>
      ior match {
      | Both(x, _) -> Some(x)
      | _ -> None()
      }
    )
  }

  fun union(that: this): this {
    this.merge(that, ior ~>
      ior match {
      | Left(x)
      | Right(x)
      | Both(x, _) ->
        x
      }
    )
  }

  fun mapInter(that: this, f: (T, T) -> T): this {
    this.mergeOpt(that, ior ->
      ior match {
      | Both(x, y) -> Some(f(x, y))
      | _ -> None()
      }
    )
  }

  fun mapUnion(that: this, f: (T, T) -> T): this {
    this.merge(that, ior ->
      ior match {
      | Left(x)
      | Right(x) ->
        x
      | Both(x, y) -> f(x, y)
      }
    )
  }

  fun mapInterOption(that: this, f: (T, T) -> ?T): ?this {
    this.mergeOption(that, ior ->
      ior match {
      | Both(x, y) -> f(x, y).map(z -> Some(z))
      | _ -> Some(None())
      }
    )
  }

  fun mapUnionOption(that: this, f: (T, T) -> ?T): ?this {
    this.mergeOption(that, ior ->
      ior match {
      | Left(z)
      | Right(z) ->
        Some(Some(z))
      | Both(x, y) -> f(x, y).map(z -> Some(z))
      }
    )
  }

  fun mapDiff(that: this, f: (T, T) -> ?T): this {
    this.mergeOpt(that, ior ->
      ior match {
      | Left(x) -> Some(x)
      | Right(_) -> None()
      | Both(x, y) -> f(x, y)
      }
    )
  }

  /* Comparisons */

  // s.leq(t, leqT) is Success if leqT(x, t.maybeGet(x)) is Success for every
  // x in s, otherwise the first Failure encountered is returned
  // immediately. Note that any extra elements in t are ignored.
  fun leq<E>(that: this, leqT: (T, ?T) -> Result<void, E>): Result<void, E> {
    this.iterDiffInterDiff(that)
      .findMap(ior ->
        ior match {
        | Left(x) -> leqT(x, None()).maybeFailure()
        | Both(x, y) -> leqT(x, Some(y)).maybeFailure()
        | Right(_) -> None()
        }
      )
      .failureOr(void)
  }

  // s.geq(t, geqT) is Success if geqT(s.maybeGet(y), y) is Success for every
  // y in t, otherwise the first Failure encountered is returned
  // immediately. Note that any extra elements in s are ignored.
  fun geq<E>(that: this, geqT: (?T, T) -> Result<void, E>): Result<void, E> {
    that.leq(this, (y, xO) -> geqT(xO, y))
  }
}

module end;
