module SKJS;

extension class TypeChecker {
  fun evalEquality(
    tcenv: mutable TCEnv,
    e1: Expr,
    e2: Expr,
    target: Bool,
  ): void {
    (e1, e2) match {
    | (
      Expr(_, EString(tag)),
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
    )
    | (
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
      Expr(_, EString(tag)),
    ) if (fieldName == kAlgebraicBranchFieldName) ->
      this.evalAlgebraicBranchEquality(tcenv, local, tag, target)

    | (Expr(_, TypeOf(Expr(_, Var(local)))), Expr(typePos, EString(typeStr)))
    | (Expr(typePos, EString(typeStr)), Expr(_, TypeOf(Expr(_, Var(local))))) ->
      this.evalTypeofEquality(tcenv, local, typeStr, typePos, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "null"))))
    | (Expr(_, Var(Name(_, "null"))), Expr(_, Var(local))) ->
      this.evalNullEquality(tcenv, local, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "undefined"))))
    | (Expr(_, Var(Name(_, "undefined"))), Expr(_, Var(local))) ->
      this.evalUndefinedEquality(tcenv, local, target)

    | (Expr(pos, _), Expr(_, Var(Name(_, "null"))))
    | (Expr(_, Var(Name(_, "null"))), Expr(pos, _))
    | (Expr(pos, _), Expr(_, Var(Name(_, "undefined"))))
    | (Expr(_, Var(Name(_, "undefined"))), Expr(pos, _)) ->
      typingError(
        Array[(pos, "Only locals can be compared to null/undefined.")],
      )

    | _ -> void
    }
  }

  fun evalAlgebraicBranchEquality(
    tcenv: mutable TCEnv,
    local: Name,
    tag: String,
    target: Bool,
  ): void {
    this.setLocal(
      tcenv,
      local,
      None(),
      _ ~> true,
      stype ~>
        stype match {
        | TAlgebraic(branches, aPos) ->
          TAlgebraic(
            branches.filter(branch -> (branch.tag == tag) == target),
            aPos,
          )
        | x -> x
        }
      ,
    )
  }

  fun evalTypeofEquality(
    tcenv: mutable TCEnv,
    local: Name,
    typeStr: String,
    typePos: PosRange,
    target: Bool,
  ): void {
    typeStr match {
    | "symbol" -> void
    | "string" ->
      filter = x ~> (x is TPrimValue(TString(), _, _)) == target;
      default = if (target) Some(TPrimValue::string(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "number" ->
      filter = x ~> (x is TPrimValue(TNum(), _, _)) == target;
      default = if (target) Some(TPrimValue::number(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "bigint" ->
      filter = x ~> (x is TPrimValue(TBigInt(), _, _)) == target;
      default = if (target) Some(TPrimValue::bigint(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "boolean" ->
      filter = x ~> (x is TPrimValue(TBool(), _, _)) == target;
      default = if (target) Some(TPrimValue::boolean(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "undefined" ->
      filter = x ~>
        (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) ==
          target;
      default = None();
      this.setLocal(tcenv, local, default, filter)
    | "object" ->
      filter = x ~>
        (x is TObject(TFields{call => None()}, _) ||
          x is TAlgebraic _ ||
          x is TPrimUnit(TNull(), _) ||
          x is TTuple _ ||
          x is TPromise _) == target;
      default = if (target) Some(TObject(TFields::empty(), typePos)) else {
        None()
      };
      this.setLocal(tcenv, local, default, filter)
    | "function" ->
      filter = x ~> (x is TObject(TFields{call => Some _}, _)) == target;
      default = None();
      this.setLocal(tcenv, local, default, filter)
    | _ ->
      typingError(
        Array[(typePos, `Unexpected typeof check against "${typeStr}"`)],
      )
    }
  }

  fun evalNullEquality(tcenv: mutable TCEnv, local: Name, target: Bool): void {
    this.setLocal(tcenv, local, None(), x ~>
      x is TPrimUnit(TNull(), _) == target
    )
  }

  fun evalUndefinedEquality(
    tcenv: mutable TCEnv,
    local: Name,
    target: Bool,
  ): void {
    this.setLocal(tcenv, local, None(), x ~>
      (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) == target
    )
  }

  fun evalCond(tcenv: mutable TCEnv, e: Expr, target: Bool): void {
    e.value match {
    | Binop(BOStrictEquality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, target)

    | Binop(BOStrictInequality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, !target)

    | InstanceOf(
      Expr(_, Var(local)),
      Expr(_, Var(Name(posArray, "Array"))),
    ) if (target) ->
      tcenv.scope.set(
        local,
        TType::inst(
          Name(posArray, "Array"),
          TArgs(Array[TType::top(posArray)]),
        ),
        (_, _) -> void,
      )

    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->
      tcenv.scope.set(
        local,
        this.tenv.new(
          tcenv.context,
          className,
          this.tenv.makeTArgs(tcenv.context, tcenv.subst, className),
        ),
        (x, y) -> this.checkSubType(tcenv, e.pos, "Invalid instanceof", x, y),
      )

    | In(e1, Expr(_, Var(local))) ->
      (_t1, fieldsOpt) = this.getInLhsTypeAndFields(tcenv, e.pos, e1);
      default = if (target) {
        fieldsOpt.flatMap(fieldsToCheck ->
          fieldsToCheck.singleElt().flatMap(singleField ->
            TField::create(
              e1.pos,
              singleField.i1,
              false,
              TType::top(e.pos),
            ).map(field ->
              TObject(TFields::create{fields => Array[field]}, e1.pos)
            )
          )
        )
      } else {
        None()
      };
      filterSType = stype ~>
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          !target
        | TTuple _
        | TAlgebraic _
        | TPromise _ ->
          true /* TODO */
        | TObject _ -> true
        };
      mapSType = stype ~>
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          if (target) internal_error("Filter should have got rid of it") else {
            stype
          }
        | TTuple _
        | TAlgebraic _
        | TPromise _ ->
          stype /* TODO */
        | TObject(tFields @ TFields{indexes}, tObjPos) ->
          fieldsOpt
            .flatMap(fieldsToCheck ->
              fieldsToCheck
                .singleElt()
                .flatMap(singleField ->
                  if (target) {
                    if (!indexes.isEmpty()) None() else {
                      TField::create(
                        e1.pos,
                        singleField.i1,
                        false,
                        TType::top(e.pos),
                      ).flatMap(fieldToAdd -> tFields.addField(fieldToAdd))
                    }
                  } else {
                    Some(
                      tFields.filterMap(tField ->
                        if (tField.name == singleField.i1) None() else {
                          Some(tField)
                        }
                      ),
                    )
                  }
                )
                .map(newTFields -> TObject(newTFields, tObjPos))
            )
            .default(stype)
        };
      this.setLocal(tcenv, local, default, filterSType, mapSType)

    | Unop(UOExclamationMark(), subE) -> this.evalCond(tcenv, subE, !target)

    | Binop(BOLogicalAnd(), e1, e2) if (target) ->
      this.evalCond(tcenv, e1, true);
      this.evalCond(tcenv, e2, true)

    | Binop(BOLogicalOr(), e1, e2) if (!target) ->
      this.evalCond(tcenv, e1, false);
      this.evalCond(tcenv, e2, false)

    | _ -> void
    }
  }

  fun setLocal(
    tcenv: mutable TCEnv,
    local: Name,
    default: ?SType,
    filter: SType ~> Bool,
    map: SType ~> SType = x ~> x,
  ): void {
    ty = tcenv.scope.get(local);
    !ty = ty.expand(tcenv.subst, this.tenv, Covariant());
    !ty = (mutable FilterType()).type((filter, map), ty);
    localType = default match {
    | Some(d) ->
      isTopOrEmpty = ty.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
      | None() -> true
      | Some(stypes) -> stypes.isEmpty()
      };
      if (isTopOrEmpty) TType::single(d) else ty
    | _ -> ty
    };
    tcenv.scope.set(local, localType, (_, _) -> void)
  }
}

module end;
