module SKJS;

extension class TypeChecker {
  // Dispatches a strict equality/inequality check to the appropriate
  // narrowing handler based on the operand shapes.
  // Refines `(e1 === e2) === target`
  fun evalEquality(
    tcenv: mutable TCEnv,
    e1: Expr,
    e2: Expr,
    target: Bool,
  ): void {
    (e1, e2) match {
    | (Expr(_, Var(local1)), Expr(_, Var(local2))) ->
      this.evalVarEquality(tcenv, local1, e2, target);
      this.evalVarEquality(tcenv, local2, e1, target)

    | (
      Expr(_, Dot(NormalDot(), Expr(_, Var(local1)), Name(_, fieldName1))),
      Expr(_, Dot(NormalDot(), Expr(_, Var(local2)), Name(_, fieldName2))),
    ) ->
      this.evalFieldEquality(tcenv, local1, fieldName1, e2, target);
      this.evalFieldEquality(tcenv, local2, fieldName2, e1, target)

    | (
      other1 @ Expr(_, Var(local1)),
      other2 @ Expr(
        _,
        Dot(NormalDot(), Expr(_, Var(local2)), Name(_, fieldName2)),
      ),
    )
    | (
      other2 @ Expr(
        _,
        Dot(NormalDot(), Expr(_, Var(local2)), Name(_, fieldName2)),
      ),
      other1 @ Expr(_, Var(local1)),
    ) ->
      this.evalVarEquality(tcenv, local1, other2, target);
      this.evalFieldEquality(tcenv, local2, fieldName2, other1, target)

    | (Expr(_, Var(local)), otherExpr)
    | (otherExpr, Expr(_, Var(local))) ->
      this.evalVarEquality(tcenv, local, otherExpr, target)

    | (
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
      otherExpr,
    )
    | (
      otherExpr,
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
    ) ->
      this.evalFieldEquality(tcenv, local, fieldName, otherExpr, target)

    | (Expr(_, TypeOf(Expr(_, Var(local)))), Expr(typePos, EString(typeStr)))
    | (Expr(typePos, EString(typeStr)), Expr(_, TypeOf(Expr(_, Var(local))))) ->
      this.evalTypeofEquality(tcenv, local, typeStr, typePos, target)

    | _ -> void
    }
  }

  // Narrows `local` based on `(local === otherExpr) === target`.
  // target=true: narrow local to inter(localType, otherType).
  // target=false: if otherExpr is a singleton constant, diff it out of local.
  fun evalVarEquality(
    tcenv: mutable TCEnv,
    local: Name,
    otherExpr: Expr,
    target: Bool,
  ): void {
    tcenv.scope.maybeGet(local) match {
    | None() -> void
    | Some(localType) ->
      otherExpr match {
      | Expr(_, Var(Name(_, "undefined"))) ->
        filter = x ~>
          (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) ==
            target;
        default = None();
        this.setLocal(tcenv, local, default, filter)
      | _ ->
        otherType = this.lookupExprType(tcenv, otherExpr);
        // Clone subst because inter may unify type variables as a side
        // effect; we want the exploratory narrowing not to mutate the main subst.
        if (target) {
          common = TType::inter(
            tcenv.subst.clone(),
            this,
            localType,
            otherType,
          );
          tcenv.scope.set(local, common, (_, _) -> void)
        } else {
          otherType.getSingleConstant() match {
          | Some(c) ->
            diffed = TType::removeConstant(
              tcenv.subst.clone(),
              this,
              localType,
              c,
            );
            tcenv.scope.set(local, diffed, (_, _) -> void)
          | None() -> void
          }
        }
      }
    }
  }

  // Narrows `local` based on `(local.fieldName === otherExpr) === target`.
  fun evalFieldEquality(
    tcenv: mutable TCEnv,
    local: Name,
    fieldName: String,
    otherExpr: Expr,
    target: Bool,
  ): void {
    otherType = this.lookupExprType(tcenv, otherExpr);
    this.evalFieldEqualityType(tcenv, local, fieldName, otherType, target)
  }

  // Narrows `local.fieldName` within each `TObject` branch of `local`'s type:
  // for a branch that has the field, `narrow(branchFields, fieldType)` returns
  // the updated branch fields, or None to drop the branch entirely. Branches
  // that lack the field, and non-object members, are left unchanged. Shared by
  // evalFieldEqualityType and evalFieldTruthiness.
  private fun narrowField(
    tcenv: mutable TCEnv,
    local: Name,
    fieldName: String,
    // Position to attribute field-resolution errors to (the field access for
    // truthiness narrowing, the variable for equality narrowing).
    errorPos: PosRange,
    narrow: (TFields, TType) -> ?TFields,
  ): void {
    this.setLocalFilterMap(tcenv, local, None(), stype ->
      stype match {
      | tObj @ TObject _ ->
        tObj.mapOpt(tFields ->
          tFields.maybeGetType(
            tcenv.subst,
            this,
            fieldName,
            errorPos,
            false,
          ) match {
          | None() -> Some(tFields)
          | Some(branchFieldType) -> narrow(tFields, branchFieldType)
          }
        )
      | x -> Some(x)
      }
    )
  }

  // Narrows `local` based on `(local.fieldName === <type>) === target`.
  // Two strategies depending on whether the RHS is a single constant:
  //  - Non-constant RHS: narrow field via inter for ===, keep for !==.
  //  - Constant RHS: also narrow via diff for !==.
  fun evalFieldEqualityType(
    tcenv: mutable TCEnv,
    local: Name,
    fieldName: String,
    otherType: TType,
    target: Bool,
  ): void {
    constant = otherType.getSingleConstant();
    this.narrowField(
      tcenv,
      local,
      fieldName,
      local.pos,
      (tFields, branchFieldType) -> {
        overlap = TType::inter(
          tcenv.subst.clone(),
          this,
          branchFieldType,
          otherType,
        );
        if (overlap.isBottom()) {
          // No overlap: === eliminates the branch, !== keeps it
          if (target) None() else Some(tFields)
        } else if (target) {
          // ===: narrow field to intersection with RHS
          Some(
            tFields.updateField(fieldName, fd ->
              fd.withGet(overlap, fd.isOptional)
            ),
          )
        } else {
          constant match {
          | Some(c) ->
            // !==: subtract the constant from the field type
            narrowed = TType::removeConstant(
              tcenv.subst.clone(),
              this,
              branchFieldType,
              c,
            );
            if (narrowed.isBottom()) {
              None()
            } else {
              // Clear isOptional when narrowing out undefined so that
              // resolveFieldType doesn't re-add | undefined.
              keepOpt = !(c is TPrimUnit(TUndefined(), _));
              Some(
                tFields.updateField(fieldName, fd ->
                  fd.withGet(narrowed, keepOpt && fd.isOptional)
                ),
              )
            }
          | None() ->
            // !==, non-constant RHS: can't narrow, keep branch
            Some(tFields)
          }
        }
      },
    )
  }

  // Narrows `local` based on `(typeof local === typeStr) === target`.
  // Keeps SType branches whose runtime typeof matches typeStr === target.
  fun evalTypeofEquality(
    tcenv: mutable TCEnv,
    local: Name,
    typeStr: String,
    typePos: PosRange,
    target: Bool,
  ): void {
    typeStr match {
    | "symbol" ->
      filter = x ~> (x is TPrimValue(TSymbol(), _, _)) == target;
      default = if (target) Some(TPrimValue::symbol(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "string" ->
      filter = x ~> (x is TPrimValue(TString(), _, _)) == target;
      default = if (target) Some(TPrimValue::string(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "number" ->
      filter = x ~> (x is TPrimValue(TNum(), _, _)) == target;
      default = if (target) Some(TPrimValue::number(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "bigint" ->
      filter = x ~> (x is TPrimValue(TBigInt(), _, _)) == target;
      default = if (target) Some(TPrimValue::bigint(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "boolean" ->
      filter = x ~> (x is TPrimValue(TBool(), _, _)) == target;
      default = if (target) Some(TPrimValue::boolean(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "undefined" ->
      filter = x ~>
        (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) ==
          target;
      default = None();
      this.setLocal(tcenv, local, default, filter)
    | "object" ->
      filterMap = x ~>
        x match {
        | tObj @ TObject _ ->
          tObj.mapCall(call ->
            call match {
            | Some((true, f)) -> Some(if (target) None() else Some((false, f)))
            | Some((false, _)) -> if (target) None() else Some(call)
            | None() -> if (target) Some(call) else None()
            }
          )
        | TPrimUnit(TNull(), _) -> if (target) Some(x) else None()
        | _ -> if (target) None() else Some(x)
        };
      default = if (target) {
        Some(
          STypes::union(
            tcenv.subst,
            this,
            STypes::single(TPrimUnit(TNull(), typePos)),
            STypes::single(TObject::createEmpty(typePos)),
          ),
        )
      } else {
        None()
      };
      this.setLocalFilterMap(tcenv, local, default, filterMap)
    | "function" ->
      filterMap = x ~>
        x match {
        | tObj @ TObject _ ->
          tObj.mapCall(call ->
            call match {
            | Some((true, f)) -> Some(if (target) Some((false, f)) else None())
            | Some((false, _)) -> if (target) Some(call) else None()
            | None() -> if (target) None() else Some(call)
            }
          )
        | _ -> if (target) None() else Some(x)
        };
      this.setLocalFilterMap(tcenv, local, None(), filterMap)
    | _ ->
      tcenv.error(
        Array[
          (
            typePos,
            `'${typeStr}' is not a valid operand for a 'typeof' comparison`,
          ),
        ],
        TSCode(2367),
      )
    }
  }

  // Narrows `local` based on `Array.isArray(local) === target`.
  // target === true: intersects with Array/ReadonlyArray.
  // target === false: excludes arrays and tuples.
  fun evalIsArray(tcenv: mutable TCEnv, local: Name, target: Bool): void {
    if (target) {
      // Intersect with `ReadonlyArray<unknown>`, never mutable `Array`. A
      // branch that is already a mutable array keeps its mutability — index
      // intersection unions the set types, and `union(T, bottom) = T` — so
      // `number[]` stays pushable, while a readonly array, a tuple, or a
      // non-array object (which a readonly array can inhabit by carrying extra
      // properties) gets a readonly index and cannot be mutated. e.g.
      // `number[] | { readonly length: number }` refines to
      // `number[] | readonly unknown[]`.
      readonlyArrayObj = this.newObject(
        tcenv.subst,
        Name(local.pos, "ReadonlyArray"),
        Array[TType::top(local.pos)],
      );
      filterMap = x ->
        x match {
        | tObj @ TObject _ ->
          TObject::inter(tcenv.subst, this, tObj, readonlyArrayObj).flatMap(
            o -> o.mapOpt(tFields -> tFields.interIsArray(true)),
          )
        | _ -> None()
        };
      this.setLocalFilterMap(tcenv, local, None(), filterMap)
    } else {
      this.setLocalFilterMap(tcenv, local, None(), stype ->
        stype match {
        | tObj @ TObject _ ->
          tObj.mapOpt(tFields -> tFields.interIsArray(false))
        | _ -> Some(stype)
        }
      )
    }
  }

  // Narrows `local` based on `local instanceof className`
  fun evalInstanceof(tcenv: mutable TCEnv, local: Name, className: Name): void {
    tArgs = if (className.value == "Array") {
      Array[TType::top(className.pos)]
    } else {
      this.makeTArgs(tcenv, className)
    };
    obj = this.newObject(tcenv.subst, className, tArgs);
    filterMap = stype ->
      stype match {
      | tObj @ TObject _ -> TObject::inter(tcenv.subst, this, tObj, obj)
      | _ -> None()
      };
    this.setLocalFilterMap(tcenv, local, Some(STypes::single(obj)), filterMap)
  }

  // Entry point for type narrowing from a conditional expression.
  // Dispatches on the condition shape (===, !==, typeof, instanceof,
  // Array.isArray, `in`, &&, ||, !) and narrows `tcenv` accordingly.
  // `target === true` when the condition holds, `target === false` when it doesn't.
  fun evalCond(tcenv: mutable TCEnv, e: Expr, target: Bool): void {
    e.value match {
    | Binop(BOStrictEquality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, target)

    | Binop(BOStrictInequality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, !target)

    | Call(
      Expr(
        _,
        Dot(NormalDot(), Expr(_, Var(Name(_, "Array"))), Name(_, "isArray")),
      ),
      targs,
      args,
    ) if (targs.isEmpty() && args.size() == 1) ->
      args[0] match {
      | Expr(_, Var(local)) -> this.evalIsArray(tcenv, local, target)
      | _ -> void
      }

    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->
      // Only a class/interface RHS can drive narrowing; a Function-like value
      // (e.g. a `typeof Class` const) is a valid RHS but has no class def to
      // build an instance type from, so it narrows nothing.
      if (this.hasClassDef(tcenv, className)) {
        this.evalInstanceof(tcenv, local, className)
      }

    | In(e1, Expr(_, Var(local))) ->
      (_t1, litsOpt, symLitsOpt) = this.getInLhsTypeAndFields(tcenv, e.pos, e1);
      singleKey = (litsOpt, symLitsOpt) match {
      | (Some(Some(strLits)), None()) ->
        strLits.singleElt().map(singleStr ->
          FKName(Name(singleStr.pos, singleStr.val), TString())
        )
      | (None(), Some(Some(symLits))) ->
        symLits.singleElt().map(singleSym ->
          FKSymbol(singleSym.pos, singleSym.val)
        )
      | _ -> None()
      };
      filterMapSType = stype ~>
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          if (target) None() else Some(stype)
        | tObj @ TObject(_, _, _pos) ->
          singleKey match {
          | None() -> Some(stype)
          | Some(key) ->
            if (target) {
              Some(
                tObj.map(tf ->
                  tf.maybeGetField(key) match {
                  | Some(existing) ->
                    if (existing.isOptional) {
                      tf.updateFieldByKey(key, fd ~> fd.withIsOptional(false))
                    } else {
                      tf
                    }
                  | None() ->
                    fieldToAdd = tf.nonSyntheticIndexForKeyKind(
                      key.toPrimValueKind(),
                    ) match {
                    | Some(indexField) ->
                      TField{
                        pos => e1.pos,
                        name => FieldNameString(key.value()),
                        isOptional => false,
                        get => indexField.get,
                        set => indexField.set,
                        access => indexField.access,
                      }
                    | None() ->
                      // Presence is runtime-confirmed by `in` but the
                      // declaration is unknown. Synthesize a phantom that
                      // errors at access (since the field could be private)
                      // and is invisible to subtyping toward the original
                      // type.
                      TField{
                        pos => e1.pos,
                        name => FieldNameString(key.value()),
                        isOptional => false,
                        get => TType::top(e.pos),
                        set => TType::bottom(e.pos),
                        access => FAPhantom(e.pos),
                      }
                    };
                    (if (key is FKSymbol _) {
                      tf.addSymbolField(fieldToAdd)
                    } else {
                      tf.addField(fieldToAdd)
                    }).default(tf)
                  }
                ),
              )
            } else {
              tObj.mapOpt(tFields ->
                tFields.maybeGetField(key) match {
                | Some(TField{isOptional => false}) -> None()
                | Some(TField{isOptional => true}) ->
                  key match {
                  | FKSymbol(_, keyName) ->
                    Some(
                      tFields.filterSymbolFields(sf ->
                        sf.name.value != keyName
                      ),
                    )
                  | FKName(Name(_, keyName), _) ->
                    Some(tFields.filterFields(f -> f.name.value != keyName))
                  }
                | None() -> Some(tFields)
                }
              )
            }
          }
        };
      this.setLocalFilterMap(tcenv, local, None(), filterMapSType)

    | Unop(UOExclamationMark(), subE) -> this.evalCond(tcenv, subE, !target)

    | Binop(BOLogicalAnd(), e1, e2) ->
      if (target) {
        this.evalCond(tcenv, e1, true);
        this.evalCond(tcenv, e2, true)
      } else {
        savedScope = tcenv.scope;
        scope1 = tcenv.mcreateSubScope{isLoop => false};
        scope2 = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = scope1;
        this.evalCond(tcenv, e1, false);
        tcenv.!scope = scope2;
        this.evalCond(tcenv, e1, true);
        this.evalCond(tcenv, e2, false);
        tcenv.!scope = savedScope;
        tcenv.mergeScope(this, scope1, scope2)
      }
    | Binop(BOLogicalOr(), e1, e2) ->
      if (target) {
        savedScope = tcenv.scope;
        scope1 = tcenv.mcreateSubScope{isLoop => false};
        scope2 = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = scope1;
        this.evalCond(tcenv, e1, true);
        tcenv.!scope = scope2;
        this.evalCond(tcenv, e1, false);
        this.evalCond(tcenv, e2, true);
        tcenv.!scope = savedScope;
        tcenv.mergeScope(this, scope1, scope2)
      } else {
        this.evalCond(tcenv, e1, false);
        this.evalCond(tcenv, e2, false)
      }

    // Truthiness: if (x) treated as if (x === true)
    | Var(
      local @ Name(_, n),
    ) if (n != "true" && n != "false" && n != "null" && n != "undefined") ->
      this.evalTruthiness(tcenv, local, target)

    | Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName)) ->
      this.evalFieldTruthiness(tcenv, local, fieldName, e.pos, target)

    | _ -> void
    }
  }

  // Narrows `local` based on its truthiness (`if (local)`). Each member is kept
  // as its truthy part (then-branch) or falsy part (else-branch): `boolean`
  // narrows to true/false, `T | undefined` to `T` / `undefined`, etc. Type
  // semantics are always JavaScript here regardless of the truthiness mode
  // (issue #654). No-op if `local` is not in the local scope (e.g. a const).
  fun evalTruthiness(tcenv: mutable TCEnv, local: Name, target: Bool): void {
    filterMap = stype -> stype.truthinessResidue(target);
    this.setLocalFilterMap(tcenv, local, None(), filterMap)
  }

  // Narrows `local.fieldName` based on its truthiness (`if (local.field)`), the
  // field analogue of evalTruthiness. The then-branch keeps the field's truthy
  // part (clearing optionality, since the field is then definitely present and
  // non-falsy); the else-branch keeps its falsy part. A branch whose narrowed
  // field is bottom is eliminated.
  fun evalFieldTruthiness(
    tcenv: mutable TCEnv,
    local: Name,
    fieldName: String,
    fieldPos: PosRange,
    target: Bool,
  ): void {
    this.narrowField(
      tcenv,
      local,
      fieldName,
      fieldPos,
      (tFields, branchFieldType) -> {
        narrowed = branchFieldType.truthinessPart(
          tcenv.subst.clone(),
          this,
          target,
        );
        if (narrowed.isBottom()) {
          None()
        } else {
          // The then-branch removes undefined, so the field is no longer
          // optional; the else-branch keeps it.
          keepOpt = !target;
          Some(
            tFields.updateField(fieldName, fd ->
              fd.withGet(narrowed, keepOpt && fd.isOptional)
            ),
          )
        }
      },
    )
  }

  // Narrows a local variable's type by applying `filterMap` to each SType branch.
  // Branches where filterMap returns None are eliminated.
  // `default` is used when a clause is bound by Top rather than concrete STypes.
  // No-op if `local` is not in the local scope (e.g. module-level declaration):
  // narrowing a global would only be sound for truly immutable values, and
  // readonly/declare const doesn't guarantee that (mutation through closures
  // or aliases is still possible).
  fun setLocalFilterMap(
    tcenv: mutable TCEnv,
    local: Name,
    default: ?STypes,
    filterMap: SType -> ?SType,
  ): void {
    ty = tcenv.scope.maybeGet(local) match {
    | None() -> /* Non-local */ return void
    | Some(ty) -> ty
    };
    f = (sTypesOpt) ->
      sTypesOpt match {
      | None() -> default
      | Some(sTypes) -> Some(sTypes.filterMap(filterMap))
      };
    !ty = ty.mapSTypes(tcenv.subst, this, Some(Covariant()), f);
    tcenv.scope.set(local, ty, (_, _) -> void)
  }

  // Convenience wrapper around setLocalFilterMap that keeps branches where
  // `filter` returns true and eliminates the rest.
  fun setLocal(
    tcenv: mutable TCEnv,
    local: Name,
    default: ?SType,
    filter: SType ~> Bool,
  ): void {
    filterMap = sType -> if (filter(sType)) Some(sType) else None();
    this.setLocalFilterMap(tcenv, local, default.map(STypes::single), filterMap)
  }
}

module end;
