module SKJS;

extension class TypeChecker {
  fun evalEquality(
    tcenv: mutable TCEnv,
    e1: Expr,
    e2: Expr,
    target: Bool,
  ): void {
    (e1, e2) match {
    | (Expr(_, TypeOf(Expr(_, Var(local)))), Expr(typePos, EString(typeStr)))
    | (Expr(typePos, EString(typeStr)), Expr(_, TypeOf(Expr(_, Var(local))))) ->
      this.evalTypeofEquality(tcenv, local, typeStr, typePos, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "null"))))
    | (Expr(_, Var(Name(_, "null"))), Expr(_, Var(local))) ->
      this.evalNullEquality(tcenv, local, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "undefined"))))
    | (Expr(_, Var(Name(_, "undefined"))), Expr(_, Var(local))) ->
      this.evalUndefinedEquality(tcenv, local, target)

    | (
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
      otherExpr,
    )
    | (
      otherExpr,
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
    ) ->
      this.evalFieldEquality(tcenv, local, fieldName, otherExpr, target)

    | (Expr(pos, _), Expr(_, Var(Name(_, v @ "null"))))
    | (Expr(_, Var(Name(_, v @ "null"))), Expr(pos, _))
    | (Expr(pos, _), Expr(_, Var(Name(_, v @ "undefined"))))
    | (Expr(_, Var(Name(_, v @ "undefined"))), Expr(pos, _)) ->
      tcenv.error(
        Array[(pos, `Only locals and their fields can be compared to ${v}`)],
      )

    | _ -> void
    }
  }

  fun evalFieldEquality(
    tcenv: mutable TCEnv,
    local: Name,
    fieldName: String,
    otherExpr: Expr,
    target: Bool,
  ): void {
    fieldType = this.expr(tcenv, otherExpr, true);
    fieldType.getSingleConstant() match {
    | None() -> void
    | Some(constant) ->
      this.setLocalFilterMap(tcenv, local, None(), stype ->
        stype match {
        | tObj @ TObject _ ->
          tObj.mapOpt(tFields -> {
            tFields
              .maybeGetType(tcenv.subst, this, fieldName, local.pos, false)
              .flatMap(branchFieldType ->
                branchFieldType.getSingleConstant()
              ) match {
            | Some(branchConstant) ->
              if (branchConstant.sameConstant(constant) == target) {
                Some(tFields)
              } else {
                None()
              }
            | None() -> Some(tFields)
            }
          })
        | x -> Some(x)
        }
      )
    }
  }

  fun evalTypeofEquality(
    tcenv: mutable TCEnv,
    local: Name,
    typeStr: String,
    typePos: PosRange,
    target: Bool,
  ): void {
    typeStr match {
    | "symbol" ->
      filter = x ~> (x is TPrimValue(TSymbol(), _, _)) == target;
      default = if (target) Some(TPrimValue::symbol(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "string" ->
      filter = x ~> (x is TPrimValue(TString(), _, _)) == target;
      default = if (target) Some(TPrimValue::string(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "number" ->
      filter = x ~> (x is TPrimValue(TNum(), _, _)) == target;
      default = if (target) Some(TPrimValue::number(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "bigint" ->
      filter = x ~> (x is TPrimValue(TBigInt(), _, _)) == target;
      default = if (target) Some(TPrimValue::bigint(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "boolean" ->
      filter = x ~> (x is TPrimValue(TBool(), _, _)) == target;
      default = if (target) Some(TPrimValue::boolean(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "undefined" ->
      filter = x ~>
        (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) ==
          target;
      default = None();
      this.setLocal(tcenv, local, default, filter)
    | "object" ->
      filterMap = x ~>
        x match {
        | tObj @ TObject _ ->
          tObj.mapCall(call ->
            call match {
            | Some((true, f)) -> Some(if (target) None() else Some((false, f)))
            | Some((false, _)) -> if (target) None() else Some(call)
            | None() -> if (target) Some(call) else None()
            }
          )
        | TPrimUnit(TNull(), _)
        | TTuple _
        | TPromise _ ->
          if (target) Some(x) else None()
        | _ -> if (target) None() else Some(x)
        };
      default = if (target) Some(TObject::createEmpty(typePos)) else {
        None()
      };
      this.setLocalFilterMap(tcenv, local, default, filterMap)
    | "function" ->
      filterMap = x ~>
        x match {
        | tObj @ TObject _ ->
          tObj.mapCall(call ->
            call match {
            | Some((true, f)) -> Some(if (target) Some((false, f)) else None())
            | Some((false, _)) -> if (target) Some(call) else None()
            | None() -> if (target) None() else Some(call)
            }
          )
        | _ -> if (target) None() else Some(x)
        };
      default = None();
      this.setLocalFilterMap(tcenv, local, default, filterMap)
    | _ ->
      tcenv.error(
        Array[(typePos, `Unexpected typeof check against "${typeStr}"`)],
      )
    }
  }

  fun evalNullEquality(tcenv: mutable TCEnv, local: Name, target: Bool): void {
    filter = x ~> (x is TPrimUnit(TNull(), _)) == target;
    default = None();
    this.setLocal(tcenv, local, default, filter)
  }

  fun evalUndefinedEquality(
    tcenv: mutable TCEnv,
    local: Name,
    target: Bool,
  ): void {
    filter = x ~>
      (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) == target;
    default = None();
    this.setLocal(tcenv, local, default, filter)
  }

  fun evalIsArray(tcenv: mutable TCEnv, local: Name, target: Bool): void {
    if (target) {
      filterMap = x ->
        x match {
        | TTuple _ -> Some(x)
        | tObj @ TObject _ ->
          tparam = TType::top(local.pos);
          arrObj = this.newObject(
            tcenv,
            Name(local.pos, "Array"),
            Array[tparam],
          );
          TObject::inter(tcenv.subst, this, tObj, arrObj)
        | _ -> None()
        };

      default = None();
      this.setLocalFilterMap(tcenv, local, default, filterMap)
    }
  }

  fun evalCond(tcenv: mutable TCEnv, e: Expr, target: Bool): void {
    e.value match {
    | Binop(BOStrictEquality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, target)

    | Binop(BOStrictInequality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, !target)

    | Call(
      Expr(
        _,
        Dot(NormalDot(), Expr(_, Var(Name(_, "Array"))), Name(_, "isArray")),
      ),
      targs,
      args,
    ) if (targs.isEmpty() && args.size() == 1) ->
      args[0] match {
      | Expr(_, Var(local)) -> this.evalIsArray(tcenv, local, target)
      | _ -> void
      }

    | InstanceOf(
      Expr(_, Var(local)),
      Expr(_, Var(Name(posArray, "Array"))),
    ) if (target) ->
      tcenv.scope.set(
        local,
        TType::inst(
          Name(posArray, "Array"),
          TArgs(Array[TType::top(posArray)]),
        ),
        (_, _) -> void,
      )

    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->
      tcenv.scope.set(
        local,
        this.new(tcenv, className, this.makeTArgs(tcenv, className)),
        (x, y) -> this.checkSubType(tcenv, e.pos, "Invalid instanceof", x, y),
      )

    | In(e1, Expr(_, Var(local))) ->
      (_t1, litsOpt, symLitsOpt) = this.getInLhsTypeAndFields(tcenv, e.pos, e1);
      singleKey = (litsOpt, symLitsOpt) match {
      | (Some(Some(strLits)), None()) ->
        strLits.singleElt().map(singleStr ->
          FKName(Name(singleStr.pos, singleStr.val), TString())
        )
      | (None(), Some(Some(symLits))) ->
        symLits.singleElt().map(singleSym ->
          FKSymbol(singleSym.pos, singleSym.val)
        )
      | _ -> None()
      };
      default = if (target) {
        singleKey.map(key -> {
          field = TField::create{
            pos => e1.pos,
            name => key.value(),
            isOptional => false,
            isReadonly => Some(e1.pos),
            type => TType::top(e.pos),
          };
          tFields = if (key is FKSymbol _) {
            TFields::singleSymbolField(field)
          } else {
            TFields::singleField(field)
          };
          TObject::createSingleBranch(tFields, e1.pos)
        })
      } else {
        None()
      };
      filterMapSType = stype ~>
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          if (target) None() else Some(stype)
        | TTuple _
        | TPromise _ ->
          Some(stype) /* TODO */
        | tObj @ TObject(_, _pos) ->
          singleKey match {
          | None() -> Some(stype)
          | Some(key) ->
            if (target) {
              Some(
                tObj.map(tf ->
                  if (!tf.indexes.isEmpty()) /* TODO: refine */ tf else {
                    fieldToAdd = TField::create{
                      pos => e1.pos,
                      name => key.value(),
                      isOptional => false,
                      isReadonly => Some(e1.pos),
                      type => TType::top(e.pos),
                    };
                    (if (key is FKSymbol _) {
                      tf.addSymbolField(fieldToAdd)
                    } else {
                      tf.addField(fieldToAdd)
                    }).default(tf)
                  }
                ),
              )
            } else {
              tObj.mapOpt(tFields ->
                tFields.maybeGetField(key) match {
                | Some(TField{isOptional => false}) -> None()
                | Some(_) ->
                  key match {
                  | FKSymbol(_, keyName) ->
                    Some(
                      tFields.filterSymbolFields(sf ->
                        sf.name.value != keyName
                      ),
                    )
                  | FKName(Name(_, keyName), _) ->
                    Some(tFields.filterFields(f -> f.name.value != keyName))
                  }
                | None() -> Some(tFields)
                }
              )
            }
          }
        };
      this.setLocalFilterMap(tcenv, local, default, filterMapSType)

    | Unop(UOExclamationMark(), subE) -> this.evalCond(tcenv, subE, !target)

    | Binop(BOLogicalAnd(), e1, e2) if (target) ->
      this.evalCond(tcenv, e1, true);
      this.evalCond(tcenv, e2, true)

    | Binop(BOLogicalOr(), e1, e2) if (!target) ->
      this.evalCond(tcenv, e1, false);
      this.evalCond(tcenv, e2, false)

    | _ -> void
    }
  }

  fun setLocalFilterMap(
    tcenv: mutable TCEnv,
    local: Name,
    default: ?SType,
    filterMap: SType -> ?SType,
  ): void {
    f = (sTypesOpt) ->
      sTypesOpt match {
      | None() -> default.map(STypes::single)
      | Some(sTypes) -> Some(sTypes.filterMap(filterMap))
      };
    ty = tcenv.scope.get(local);
    !ty = ty.mapSTypes(tcenv.subst, this, Some(Covariant()), f);
    tcenv.scope.set(local, ty, (_, _) -> void)
  }

  fun setLocal(
    tcenv: mutable TCEnv,
    local: Name,
    default: ?SType,
    filter: SType ~> Bool,
  ): void {
    filterMap = sType -> if (filter(sType)) Some(sType) else None();
    this.setLocalFilterMap(tcenv, local, default, filterMap)
  }
}

module end;
