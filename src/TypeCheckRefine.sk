module SKJS;

extension class TypeChecker {
  fun evalEquality(
    tcenv: mutable TCEnv,
    e1: Expr,
    e2: Expr,
    target: Bool,
  ): void {
    (e1, e2) match {
    | (
      Expr(_, EString(tag)),
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
    )
    | (
      Expr(_, Dot(NormalDot(), Expr(_, Var(local)), Name(_, fieldName))),
      Expr(_, EString(tag)),
    ) if (fieldName == kAlgebraicBranchFieldName) ->
      this.evalAlgebraicBranchEquality(tcenv, local, tag, target)

    | (Expr(_, TypeOf(Expr(_, Var(local)))), Expr(typePos, EString(typeStr)))
    | (Expr(typePos, EString(typeStr)), Expr(_, TypeOf(Expr(_, Var(local))))) ->
      this.evalTypeofEquality(tcenv, local, typeStr, typePos, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "null"))))
    | (Expr(_, Var(Name(_, "null"))), Expr(_, Var(local))) ->
      this.evalNullEquality(tcenv, local, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "undefined"))))
    | (Expr(_, Var(Name(_, "undefined"))), Expr(_, Var(local))) ->
      this.evalUndefinedEquality(tcenv, local, target)

    | (Expr(pos, _), Expr(_, Var(Name(_, v @ "null"))))
    | (Expr(_, Var(Name(_, v @ "null"))), Expr(pos, _))
    | (Expr(pos, _), Expr(_, Var(Name(_, v @ "undefined"))))
    | (Expr(_, Var(Name(_, v @ "undefined"))), Expr(pos, _)) ->
      tcenv.error(Array[(pos, `Only locals can be compared to ${v}`)])

    | _ -> void
    }
  }

  fun evalAlgebraicBranchEquality(
    tcenv: mutable TCEnv,
    local: Name,
    tag: String,
    target: Bool,
  ): void {
    this.setLocal(
      tcenv,
      local,
      None(),
      _ ~> true,
      stype ~>
        stype match {
        | TAlgebraic(branches, aPos) ->
          TAlgebraic(
            branches.filter(branch -> (branch.tag == tag) == target),
            aPos,
          )
        | x -> x
        }
      ,
    )
  }

  fun evalTypeofEquality(
    tcenv: mutable TCEnv,
    local: Name,
    typeStr: String,
    typePos: PosRange,
    target: Bool,
  ): void {
    typeStr match {
    | "symbol" -> void
    | "string" ->
      filter = x ~> (x is TPrimValue(TString(), _, _)) == target;
      default = if (target) Some(TPrimValue::string(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "number" ->
      filter = x ~> (x is TPrimValue(TNum(), _, _)) == target;
      default = if (target) Some(TPrimValue::number(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "bigint" ->
      filter = x ~> (x is TPrimValue(TBigInt(), _, _)) == target;
      default = if (target) Some(TPrimValue::bigint(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "boolean" ->
      filter = x ~> (x is TPrimValue(TBool(), _, _)) == target;
      default = if (target) Some(TPrimValue::boolean(typePos)) else None();
      this.setLocal(tcenv, local, default, filter)
    | "undefined" ->
      filter = x ~>
        (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) ==
          target;
      default = None();
      this.setLocal(tcenv, local, default, filter)
    | "object" ->
      filter = x ~>
        x match {
        | TObject(_, TFields{call => Some((true, _))}, _) -> true
        | TObject(_, TFields{call => None()}, _)
        | TAlgebraic _
        | TPrimUnit(TNull(), _)
        | TTuple _
        | TPromise _ ->
          target
        | _ -> !target
        };
      map = x ~>
        x match {
        | TObject(arrayFields, tFields @ TFields{call => Some((true, f))}, pos) ->
          call = if (target) None() else Some((false, f));
          TObject(arrayFields, tFields with {call}, pos)
        | _ -> x
        };
      default = if (target) Some(TObject(None(), TFields::empty(), typePos)) else {
        None()
      };
      this.setLocal(tcenv, local, default, filter, map)
    | "function" ->
      filter = x ~>
        x match {
        | TObject(_, TFields{call => Some((true, _))}, _) -> true
        | TObject(_, TFields{call => Some((false, _))}, _) -> target
        | _ -> !target
        };
      map = x ~>
        x match {
        | TObject(arrayFields, tFields @ TFields{call => Some((true, f))}, pos) ->
          call = if (target) Some((false, f)) else None();
          TObject(arrayFields, tFields with {call}, pos)
        | _ -> x
        };
      default = None();
      this.setLocal(tcenv, local, default, filter, map)
    | _ ->
      tcenv.error(
        Array[(typePos, `Unexpected typeof check against "${typeStr}"`)],
      )
    }
  }

  fun evalNullEquality(tcenv: mutable TCEnv, local: Name, target: Bool): void {
    filter = x ~> (x is TPrimUnit(TNull(), _)) == target;
    default = None();
    this.setLocal(tcenv, local, default, filter)
  }

  fun evalUndefinedEquality(
    tcenv: mutable TCEnv,
    local: Name,
    target: Bool,
  ): void {
    filter = x ~>
      (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) == target;
    default = None();
    this.setLocal(tcenv, local, default, filter)
  }

  fun evalCond(tcenv: mutable TCEnv, e: Expr, target: Bool): void {
    e.value match {
    | Binop(BOStrictEquality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, target)

    | Binop(BOStrictInequality(), e1, e2) ->
      this.evalEquality(tcenv, e1, e2, !target)

    | Call(
      Expr(
        _,
        Dot(NormalDot(), Expr(_, Var(Name(_, "Array"))), Name(_, "isArray")),
      ),
      _targs,
      args,
    ) if (args.size() == 1 && target) ->
      args[0] match {
      | Expr(_, Var(local)) ->
        filter = x ~>
          x match {
          | TObject(Some(_), _, _) -> true
          | _ -> false
          };
        map = x ~>
          x match {
          | TObject(Some(arrFields), _, pos) ->
            TObject(Some(arrFields), arrFields, pos)
          | _ -> x
          };
        this.setLocal(tcenv, local, None(), filter, map)
      | _ -> void
      }

    | InstanceOf(
      Expr(_, Var(local)),
      Expr(_, Var(Name(posArray, "Array"))),
    ) if (target) ->
      tcenv.scope.set(
        local,
        TType::inst(
          Name(posArray, "Array"),
          TArgs(Array[TType::top(posArray)]),
        ),
        (_, _) -> void,
      )

    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->
      tcenv.scope.set(
        local,
        this.tenv.new(tcenv, className, this.tenv.makeTArgs(tcenv, className)),
        (x, y) -> this.checkSubType(tcenv, e.pos, "Invalid instanceof", x, y),
      )

    | In(e1, Expr(_, Var(local))) ->
      (_t1, litsOpt) = this.getInLhsTypeAndFields(tcenv, e.pos, e1);
      default = if (target) {
        litsOpt.flatMap(litsToCheck ->
          litsToCheck.singleElt().flatMap(singleField ->
            TField::create(
              e1.pos,
              singleField.val,
              false,
              TType::top(e.pos),
            ).map(field ->
              TObject(None(), TFields::create{fields => Array[field]}, e1.pos)
            )
          )
        )
      } else {
        None()
      };
      filterSType = stype ~>
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          !target
        | TTuple _
        | TAlgebraic _
        | TPromise _ ->
          true /* TODO */
        | TObject _ -> true
        };
      mapSType = stype ~>
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          if (target) internal_error("Filter should have got rid of it") else {
            stype
          }
        | TTuple _
        | TAlgebraic _
        | TPromise _ ->
          stype /* TODO */
        | TObject(arrayFields, tFields @ TFields{indexes}, tObjPos) ->
          litsOpt
            .flatMap(litsToCheck ->
              litsToCheck
                .singleElt()
                .flatMap(singleField ->
                  if (target) {
                    if (!indexes.isEmpty()) None() else {
                      TField::create(
                        e1.pos,
                        singleField.val,
                        false,
                        TType::top(e.pos),
                      ).flatMap(fieldToAdd -> tFields.addField(fieldToAdd))
                    }
                  } else {
                    Some(
                      tFields.filterMap(tField ->
                        if (tField.name == singleField.val) None() else {
                          Some(tField)
                        }
                      ),
                    )
                  }
                )
                .map(newTFields -> TObject(arrayFields, newTFields, tObjPos))
            )
            .default(stype)
        };
      this.setLocal(tcenv, local, default, filterSType, mapSType)

    | Unop(UOExclamationMark(), subE) -> this.evalCond(tcenv, subE, !target)

    | Binop(BOLogicalAnd(), e1, e2) if (target) ->
      this.evalCond(tcenv, e1, true);
      this.evalCond(tcenv, e2, true)

    | Binop(BOLogicalOr(), e1, e2) if (!target) ->
      this.evalCond(tcenv, e1, false);
      this.evalCond(tcenv, e2, false)

    | _ -> void
    }
  }

  fun setLocal(
    tcenv: mutable TCEnv,
    local: Name,
    default: ?SType,
    filter: SType ~> Bool,
    map: SType ~> SType = x ~> x,
  ): void {
    ty = tcenv.scope.get(local);
    !ty = ty.expand(tcenv.subst, this.tenv, Some(Covariant()));
    !ty = (mutable FilterType()).type((filter, map, default), ty);
    tcenv.scope.set(local, ty, (_, _) -> void)
  }
}

module end;
