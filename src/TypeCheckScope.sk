/***************************************************************************/
/* The local environment. */
/***************************************************************************/

module SKJS;

// `type` is the binding's current (flow-narrowed) type; `declaredType` is its
// initial or inherited contract, preserved across narrowing so a write that
// escapes the current frame — through a loop or into an enclosing-function
// capture — can be checked against the declared type rather than a transient
// narrowing (see `Scope::set`). `hasDeclaredContract` records an explicit
// annotation, a completed inferred object, or an object contract inherited
// from an alias source. Every write must preserve that contract.
// Inferred initializers constrain writes too. Open inference variables collect
// compatible bounds; a concrete contract is never replaced by a later flow type.
// `isMutable` is false for a `const` binding and true for `let`, `var`, a
// parameter, or a catch clause's variable; `this` is also not mutable, since
// it cannot be reassigned.
value class LocalRef(
  type: TType,
  declaredType: TType,
  hasDeclaredContract: Bool,
  isInitialized: Bool,
  isMutable: Bool,
  hasFieldRefinement: Bool = false,
) {
  // Only a binding carrying transient field facts needs contract projection.
  fun stableContentsType(
    subst: mutable Subst,
    tenv: TEnv,
    preserveAlternatives: Bool = false,
  ): TType {
    if (this.hasDeclaredContract && this.hasFieldRefinement) {
      this.type.withStableContents(
        subst,
        tenv,
        this.declaredType,
        preserveAlternatives,
      )
    } else {
      this.type
    }
  }
}

extension class TType {
  // Project transient field facts back to the lasting object contract, keeping
  // primitive alternatives from the current flow type (including null checks).
  fun withStableContents(
    subst: mutable Subst,
    tenv: TEnv,
    contract: TType,
    preserveAlternatives: Bool,
  ): TType {
    if (this != contract && !this.isFieldFree()) {
      objects = contract.mapSTypes(subst, tenv, Some(Covariant()), stypes ->
        Some(
          stypes
            .map(types ->
              types.filterMap(st ->
                st match {
                | obj @ TObject _ ->
                  if (preserveAlternatives) {
                    obj.mapOpt(fields ->
                      if (this.mayMatchAlternative(subst, tenv, fields)) {
                        Some(fields)
                      } else {
                        None()
                      }
                    )
                  } else {
                    Some(obj)
                  }
                | TPrim _ -> None()
                }
              )
            )
            .default(STypes::single(TObject::createEmpty(this.pos))),
        )
      );
      values = this.mapSTypes(subst, tenv, Some(Covariant()), stypes ->
        stypes.map(types ->
          types.filterMap(st ->
            st match {
            | prim @ TPrim _ -> Some(prim)
            | TObject _ -> None()
            }
          )
        )
      );
      TType::union(subst, tenv, objects, values)
    } else {
      this
    }
  }

  // Selecting a declared union alternative does not strengthen that
  // alternative's contents contract. Discard only alternatives separated by
  // incompatible required field values; uncertainty keeps the alternative.
  private fun mayMatchAlternative(
    subst: mutable Subst,
    tenv: TEnv,
    declared: TFields,
  ): Bool {
    subst.withCommittedReadContext<Bool>(
      tenv.forTypeReadObservation(),
      context ->
        if (this.probeMatchesAlternative(context, declared)) {
          None()
        } else {
          Some(false)
        }
      ,
    ) match {
    | TRReady(matches) -> matches
    | TRUnavailable()
    | TRBlocked() ->
      true
    }
  }

  // Only a justified elimination escapes; keeping an alternative requires no
  // inferred commitment. Nested probes share the outer observation's reads.
  private fun probeMatchesAlternative(
    context: mutable TypeReadContext,
    declared: TFields,
  ): Bool {
    current = context.singleTypes(this);
    current
      .map(current ->
        current.any(st ->
          st match {
          | obj @ TObject _ ->
            obj.getBranches().any(branch ->
              !declared.fields.any(field ->
                branch.fields
                  .maybeGet(field.name)
                  .map(other ->
                    !field.isOptional &&
                      !other.isOptional &&
                      context.disjoint(field.get, other.get)
                  )
                  .default(false)
              )
            )
          | TPrim _ -> true
          }
        )
      )
      .default(true)
  }
}

class NameRef(name: String, ref: LocalRef) uses Projectable<String> {
  fun project(): String {
    this.name
  }
}

mutable class Scope{
  id: Int,
  private isLoop: Bool,
  // A function boundary (a lambda body or an arrow's default-parameter
  // initializer). A write to a binding declared beyond such a boundary is a
  // capture: the lambda may run at any later time, so the write cannot narrow
  // and must be checked against the declared type (see `isThroughFunction`).
  private isFunction: Bool = false,
  up: ?readonly Scope = None(),
  private mutable locals: SortedMap<String, Name> = SortedMap[],
  private mutable refs: SortedMap<String, LocalRef> = SortedMap[],
  private mutable hasCaptureSummary: Bool = false,
  private mutable captureWrites: ?SortedSet<String> = None(),
  private mutable capturedNames: ?SortedSet<String> = None(),
} {
  static fun mcreateToplevel(): mutable this {
    mutable static{id => 0, isLoop => false}
  }

  mutable fun setCaptureWrites(
    writes: ?SortedSet<String>,
    captures: ?SortedSet<String>,
  ): void {
    this.!hasCaptureSummary = true;
    this.!captureWrites = writes;
    this.!capturedNames = captures
  }

  readonly private fun functionWrites(): ?SortedSet<String> {
    if (this.hasCaptureSummary) {
      this.captureWrites
    } else {
      this.up.flatMap(up -> up.functionWrites())
    }
  }

  readonly private fun captureNeverWritten(name: String): Bool {
    if (this.locals.containsKey(name)) {
      this.functionWrites().map(writes -> !writes.contains(name)).default(false)
    } else {
      this.up.map(up -> up.captureNeverWritten(name)).default(false)
    }
  }

  readonly private fun functionCaptures(): ?SortedSet<String> {
    if (this.hasCaptureSummary) {
      this.capturedNames
    } else {
      this.up.flatMap(up -> up.functionCaptures())
    }
  }

  readonly private fun isCapturedBinding(name: String): Bool {
    if (this.locals.containsKey(name)) {
      this.functionCaptures().map(names -> names.contains(name)).default(true)
    } else {
      this.up.map(up -> up.isCapturedBinding(name)).default(false)
    }
  }

  readonly private fun hasCaptureContract(name: String, ref: LocalRef): Bool {
    ref.hasDeclaredContract ||
      (ref.isMutable &&
        (ref.declaredType.isConcretePrimitive() ||
          ref.declaredType.getSingleVar().isSome()) &&
        this.isCapturedBinding(name))
  }

  readonly private fun captureView(name: String, ref: LocalRef): LocalRef {
    // Stable binding identity does not stabilize mutable properties. Recover
    // only field-free facts (primitive values and callable signatures).
    if (
      this.hasCaptureContract(name, ref) &&
      (!ref.type.isFieldFree() ||
        (ref.isMutable && !this.captureNeverWritten(name)))
    ) {
      ref with {type => ref.declaredType}
    } else {
      ref
    }
  }

  readonly private fun maybeGetLocal(name: Name): ?Name {
    this.locals.maybeGet(name.value) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetLocal(name)
      }
    | Some(x) -> Some(x)
    }
  }

  // The declaration position of the in-scope binding of `name`, or None if
  // `name` is not a lexical local. This is a stable per-binding identity
  // (distinct for shadowed / sibling / sequential same-name bindings), used to
  // key per-binding state (see TCEnv.localObjects) instead of the bare name.
  readonly fun bindingPos(name: Name): ?PosRange {
    this.maybeGetLocal(name).map(declName -> declName.pos)
  }

  readonly private fun maybeGetRefHelper(
    throughLoop: Bool,
    throughFunction: Bool,
    name: String,
  ): ?(Bool, LocalRef) {
    !throughLoop = this.isLoop || throughLoop;
    this.refs.maybeGet(name) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) ->
        up.maybeGetRefHelper(
          throughLoop,
          throughFunction || this.isFunction,
          name,
        )
      }
    | Some(x) ->
      // Enclosing flow facts may expire before this function runs, but a
      // capture with a write contract retains its declared type. Other inferred
      // bindings can evolve beyond their initial type, so it is not a fallback.
      // Refinements made inside this function are found before crossing its
      // boundary, so invocation-time checks still narrow subsequent reads.
      ref = if (throughFunction) {
        this.captureView(name, x)
      } else {
        x
      };
      Some((throughLoop, ref))
    }
  }

  readonly private fun maybeGetRef(name: String): ?(Bool, LocalRef) {
    this.maybeGetRefHelper(false, false, name)
  }

  mutable fun bind(
    tcenvb: mutable TCEnvBase,
    name: Name,
    ty: TType,
    hasDeclaredContract: Bool,
    isInitialized: Bool,
    isMutable: Bool,
    pendingBindings: SortedSet<PosRange> = SortedSet[],
  ): void {
    this.maybeGetLocal(name) match {
    | None() -> void
    | Some(
      otherDef,
    ) if (
      !this.locals.containsKey(name.value) &&
      pendingBindings.contains(otherDef.pos)
    ) ->
      // An inner binding remains distinct from a future outer declaration.
      // Pre-reservation must not turn that valid reuse into a redeclaration.
      void
    | Some(otherDef) ->
      tcenvb.error(
        Array[
          (name.pos, `Cannot redeclare block-scoped variable '${name}'`),
          (otherDef.pos, "Previous definition was here"),
        ],
        TSCode(2451),
      )
    };
    this.!locals[name.value] = name;
    this.!refs[name.value] = LocalRef(
      ty,
      ty,
      hasDeclaredContract,
      isInitialized,
      isMutable,
    )
  }

  // Only for names already reserved in this scope. Initialization
  // establishes the projected contract; it is not an assignment to the
  // inaccessible placeholder type used during reservation.
  mutable fun initializeReservedBinding(
    name: Name,
    ty: TType,
    hasDeclaredContract: Bool = true,
    isInitialized: Bool = true,
  ): void {
    ref = this.refs.get(name.value);
    this.!refs[name.value] = ref with {
      type => ty,
      declaredType => ty,
      isInitialized,
      hasDeclaredContract,
    }
  }

  // A direct object alias shares its source's lasting contents contract, not
  // just the source's current field refinements. Scalar/callable snapshots
  // without fields copy stable values and retain their narrower type.
  mutable fun inheritAliasContract(alias: Name, source: Name): void {
    this.maybeGetRef(source.value) match {
    | Some(
      (_, sourceRef),
    ) if (sourceRef.hasDeclaredContract && !sourceRef.type.isFieldFree()) ->
      aliasRef = this.refs.get(alias.value);
      this.!refs[alias.value] = aliasRef with {
        declaredType => sourceRef.declaredType,
        hasDeclaredContract => true,
        hasFieldRefinement => sourceRef.hasFieldRefinement,
      }
    | _ -> void
    }
  }

  // Use an existing contract when this binding inherited one from an alias.
  // Otherwise the completed initialization shape is the first-use contract.
  readonly fun objectContentsContract(name: Name): TType {
    ref = this.maybeGetRef(name.value).fromSome().i1;
    if (ref.hasDeclaredContract) ref.declaredType else ref.type
  }

  // Install the binding's shared first-use contract in the current scope.
  // A callback's first read must forget enclosing flow facts; refinements
  // already made against a contract in this scope remain valid.
  mutable fun establishObjectContract(name: Name, contract: TType): void {
    this.maybeGetRef(name.value) match {
    | Some((_, ref)) if (!ref.hasDeclaredContract) ->
      this.!refs[name.value] = ref with {
        type => if (this.isThroughFunction(name)) contract else ref.type,
        declaredType => contract,
        hasDeclaredContract => true,
      }
    | _ -> void
    }
  }

  mutable fun markFieldRefinement(name: Name): void {
    this.maybeGetRef(name.value) match {
    | Some((_, ref)) ->
      this.!refs[name.value] = ref with {hasFieldRefinement => true}
    | None() -> void
    }
  }

  readonly fun hasFieldRefinement(name: Name): Bool {
    this.maybeGetRef(name.value)
      .map(pair -> pair.i1.hasFieldRefinement)
      .default(false)
  }

  readonly fun hasDeclaredContract(name: Name): Bool {
    this.maybeGetRef(name.value)
      .map(pair -> pair.i1.hasDeclaredContract)
      .default(false)
  }

  // An annotated direct alias must promise stable contents, rather than
  // turning a temporary field refinement into a lasting read guarantee.
  readonly fun stableAliasType(
    name: Name,
    currentType: TType,
    subst: mutable Subst,
    tenv: TEnv,
  ): ?TType {
    this.maybeGetRef(name.value).map(pair ->
      // A distributed receiver call checks only its selected branch.
      (pair.i1 with {type => currentType}).stableContentsType(subst, tenv, true)
    )
  }

  readonly fun mayBeReassignedByCall(name: Name): Bool {
    this.maybeGetRef(name.value)
      .map(pair ->
        pair.i1.isMutable &&
          this.isCapturedBinding(name.value) &&
          !this.captureNeverWritten(name.value)
      )
      .default(false)
  }

  readonly fun callWriteBounds(): SortedMap<String, TType> {
    bounds = SortedMap[];
    for (entry in this.visibleRefs().items()) {
      ref = entry.i1;
      if (
        this.hasCaptureContract(entry.i0, ref) &&
        this.mayBeReassignedByCall(Name(ref.type.pos, entry.i0))
      ) {
        !bounds = bounds.set(entry.i0, ref.declaredType)
      }
    };
    bounds
  }

  // A property write may affect any visible object alias. Restore object
  // contents from lasting contracts, while retaining current primitive
  // alternatives: changing a field cannot turn a non-null reference into null.
  // Do not reset inferred objects to an initial type their writes may outgrow.
  mutable fun forgetObjectRefinements(
    subst: mutable Subst,
    tenv: TEnv,
    hasStableContents: Name -> Bool,
  ): void {
    for (entry in this.visibleRefs().items()) {
      ref = entry.i1;
      if (
        ref.hasDeclaredContract &&
        hasStableContents(Name(ref.type.pos, entry.i0)) &&
        ref.type != ref.declaredType &&
        !ref.type.isFieldFree()
      ) {
        this.!refs[entry.i0] = ref with {
          type => ref.stableContentsType(subst, tenv),
        }
      }
    }
  }

  // Repeated reads must cover every value a loop may write. A fresh condition
  // or body check can narrow again, but a pre-loop fact is not an invariant.
  // Unknown write summaries conservatively include every visible binding.
  mutable fun widenLoopBindings(
    writes: ?SortedSet<String>,
  ): SortedMap<String, TType> {
    entryValues = SortedMap[];
    for (entry in this.visibleRefs().items()) {
      ref = entry.i1;
      if (
        ref.isMutable &&
        ref.hasDeclaredContract &&
        writes.map(names -> names.contains(entry.i0)).default(true)
      ) {
        if (ref.declaredType.isConcretePrimitive()) {
          !entryValues[entry.i0] = ref.type
        };
        this.!refs[entry.i0] = ref with {type => ref.declaredType}
      }
    };
    entryValues
  }

  // The invariant used inside a loop may be broader than any value actually
  // stored. Recover scalar exit precision from entry values and runtime writes.
  // Object contents need alias/effect tracking and are deliberately excluded.
  mutable fun limitLoopExit(
    subst: mutable Subst,
    tenv: TEnv,
    bounds: readonly Map<String, TType>,
  ): void {
    for (entry in bounds.items()) {
      this.maybeGetRef(entry.i0).each(pair ->
        this.!refs[entry.i0] = pair.i1 with {
          type => TType::inter(subst, tenv, pair.i1.type, entry.i1),
        }
      )
    }
  }

  // Every binding visible from this scope, innermost shadowing outer, as a
  // flat map for claim recording and refinement invalidation.
  readonly fun visibleRefs(): SortedMap<String, LocalRef> {
    acc = this.up match {
    | None() -> SortedMap[]
    | Some(up) -> up.visibleRefs()
    };
    // Export the same capture view used by lookup, not creation-time flow
    // refinements from an enclosing mutable binding.
    if (this.isFunction) {
      for (kv in acc.items()) {
        ref = kv.i1;
        !acc = acc.set(kv.i0, this.captureView(kv.i0, ref))
      }
    };
    for (kv in this.refs.items()) {
      !acc = acc.set(kv.i0, kv.i1)
    };
    acc
  }

  readonly fun isThroughLoop(name: Name): Bool {
    this.maybeGetRef(name.value) match {
    | None() -> false
    | Some((isThroughLoop, _)) -> isThroughLoop
    }
  }

  // Whether `name` is captured from an enclosing function: its binding lives
  // beyond a function boundary crossed on the way up. This walks the
  // declaration (`locals`) chain rather than the narrowing (`refs`) chain, so
  // it stays correct even when an earlier in-lambda write has already shadowed
  // the binding with a narrowing in an inner frame.
  readonly fun isThroughFunction(name: Name): Bool {
    this.isThroughFunctionHelper(false, name)
  }

  readonly private fun isThroughFunctionHelper(
    throughFunction: Bool,
    name: Name,
  ): Bool {
    if (this.locals.containsKey(name.value)) {
      throughFunction
    } else {
      this.up match {
      | None() -> false
      | Some(up) ->
        up.isThroughFunctionHelper(this.isFunction || throughFunction, name)
      }
    }
  }

  readonly fun maybeGet(name: Name): ?TType {
    this.maybeGetRef(name.value) match {
    | None() -> None()
    | Some((_, ref)) ->
      if (!ref.isInitialized) {
        fatalError(
          Array[
            (
              name.pos,
              `Variable '${name.value}' is used before being assigned`,
            ),
          ],
          TSCode(2454),
        )
      } else {
        Some(ref.type)
      }
    }
  }

  readonly fun get(name: Name): TType {
    this.maybeGet(name) match {
    | None() ->
      fatalError(
        Array[(name.pos, `Cannot find name '${name.value}'`)],
        TSCode(2304),
      )
    | Some(x) -> x
    }
  }

  // Runtime writes must respect binding immutability. Flow refinements and
  // declaration initialization use set/initializeReservedBinding separately.
  readonly fun checkWritable(name: Name): void {
    this.maybeGetRef(name.value) match {
    | Some((_, ref)) if (!ref.isMutable) ->
      fatalError(
        Array[
          (
            name.pos,
            `Cannot assign to '${name.value}' because it is a constant`,
          ),
        ],
        TSCode(2588),
      )
    | _ -> void
    }
  }

  mutable fun set(
    name: Name,
    ty: TType,
    isSubType: (TType, TType) -> void,
    runtimeWrite: Bool = false,
  ): void {
    (throughLoop, upRef) = this.maybeGetRef(name.value) match {
    | None() ->
      fatalError(
        Array[(name.pos, `Cannot find name '${name.value}'`)],
        TSCode(2304),
      )
    | Some(x) -> x
    };
    // Every runtime write preserves the binding's retained contract, even
    // when no closure captures it. Concrete contracts cannot change kind;
    // an open inference variable collects writes in that same variable,
    // and a sealed one checks them against its established bound.
    // Object initialization can grow a reference's shape without replacing
    // the binding. Preserve its existing first-use contract discipline;
    // runtimeWrite distinguishes assignments from that construction work.
    // Flow-only callers supply a no-op checker.
    if (
      runtimeWrite ||
      this.hasCaptureContract(name.value, upRef) ||
      this.isThroughFunction(name)
    ) {
      isSubType(ty, upRef.declaredType);
    };
    if (
      throughLoop &&
      !this.hasCaptureContract(name.value, upRef) &&
      !this.isThroughFunction(name)
    ) {
      // Retain the existing loop-entry restriction for unsealed bindings.
      isSubType(ty, upRef.type);
    };
    this.!refs[name.value] = LocalRef(
      ty,
      upRef.declaredType,
      upRef.hasDeclaredContract,
      true,
      upRef.isMutable,
      upRef.hasFieldRefinement,
    );
  }

  // Capture and loop entry use the declared contract. A write cannot let
  // those views forget that an assigned method may be omitted by copying.
  mutable fun preserveAssignedCopyProvenance(
    tenv: TEnv,
    subst: mutable Subst,
    name: Name,
    source: TType,
  ): void {
    ref = this.refs.get(name.value);
    this.!refs[name.value] = ref with {
      declaredType => tenv.preserveCopyProvenance(
        subst,
        source,
        ref.declaredType,
      ),
    }
  }

  readonly fun escapingRefs(): mutable Iterator<NameRef> {
    this.refs.items()
      .filter(x -> !this.locals.containsKey(x.i0))
      .map(x -> NameRef(x.i0, x.i1))
  }

  // Fold into this scope another sibling it can also be entered from — a
  // `switch` clause falling into the one this scope belongs to, whose
  // statements have already run when that is how the body was reached.
  //
  // Either entry is possible, so a binding the sibling touched becomes the union
  // of the value it left and the value this scope already holds for it — which
  // is what entering on this clause's own label (this scope's narrowing) gives.
  // This runs *after* that narrowing, so it widens the own-entry value rather
  // than being narrowed away by it: a scrutinee the falling clause reassigned to
  // a value outside this clause's label survives, and one it did not reassign
  // stays the union of the two entry labels. Folding into this scope, not the
  // parent, keeps it local: a clause that does not fall through leaves the
  // parent untouched for the clauses after it.
  //
  // The result escapes this scope in turn, so a chain of clauses falling into
  // one another accumulates: each is entered from every clause above it that can
  // reach it.
  mutable fun uniteFallenInto(
    subst: mutable Subst,
    tenv: TEnv,
    from: readonly Scope,
  ): void {
    if (from.up.fromSome().id != this.up.fromSome().id) {
      internal_error("fallthrough scope is not a sibling")
    };
    for (nameRef in from.escapingRefs()) {
      // This scope's current value for the name: what its own-entry narrowing
      // left it at, or the parent's when the narrowing did not touch it.
      (_, curRef) = this.maybeGetRef(nameRef.name).fromSome();
      this.!refs[nameRef.name] = LocalRef(
        TType::union(subst, tenv, nameRef.ref.type, curRef.type),
        tenv.preserveCopyProvenance(
          subst,
          nameRef.ref.declaredType,
          curRef.declaredType,
        ),
        curRef.hasDeclaredContract,
        nameRef.ref.isInitialized && curRef.isInitialized,
        curRef.isMutable,
        curRef.hasFieldRefinement || nameRef.ref.hasFieldRefinement,
      )
    }
  }

  // The current view of `name` from this scope: the nearest ref's type walking
  // up, or None when the name does not resolve here.
  readonly fun lookupRefType(name: String): ?TType {
    this.maybeGetRef(name).map(x -> x.i1.type)
  }

  // The value this scope left the outer binding `name` at, or None when the
  // scope does not touch it (so the binding keeps whatever the parent holds).
  readonly fun escapingRef(name: String): ?LocalRef {
    if (this.locals.containsKey(name)) {
      None()
    } else {
      this.refs.maybeGet(name)
    }
  }

  // A snapshot of every outer binding this scope's chain has touched, down to
  // the ancestor with `baselineId` (exclusive): each name mapped to the nearest
  // (innermost) value on the way up. Used to record the state at a `break` /
  // `continue`, which exits mid-block carrying exactly this, so the catcher can
  // union it into the state after the loop or switch.
  readonly fun snapshotTo(baselineId: Int): mutable Map<String, LocalRef> {
    acc = mutable Map<String, LocalRef>[];
    // Names declared below the baseline (a clause's own `const`/`let`): their
    // refs are collected along the way but dropped at the end, since they do
    // not escape to where the catcher merges and the merge cannot resolve them.
    localNames = mutable Vector<String>[];
    this.snapshotInto(baselineId, acc, localNames);
    for (name in localNames) {
      _ = acc.maybeRemove(name)
    };
    acc
  }

  private readonly fun snapshotInto(
    baselineId: Int,
    acc: mutable Map<String, LocalRef>,
    localNames: mutable Vector<String>,
  ): void {
    if (this.id != baselineId) {
      for (kv in this.refs.items()) {
        if (!acc.containsKey(kv.i0)) acc![kv.i0] = kv.i1
      };
      for (kv in this.locals.items()) {
        localNames.push(kv.i0)
      };
      this.up match {
      // The baseline is the scope of the catcher this jump was routed to, so
      // it is necessarily an ancestor; running out of parents without meeting
      // it means the routing and the scope chain disagree.
      | None() -> internal_error("jump snapshot baseline is not an ancestor")
      | Some(u) -> u.snapshotInto(baselineId, acc, localNames)
      }
    }
  }

  // Union a recorded jump snapshot into this scope: each binding becomes what
  // this scope already holds for it (walking up when it does not touch it) or
  // the value the jump edge carried. Used by a loop to fold its break and
  // continue edges into the state its exit merge reads — one more way the code
  // after the loop can be reached, alongside the body completing normally.
  mutable fun uniteSnapshot(
    subst: mutable Subst,
    tenv: TEnv,
    snap: readonly Map<String, LocalRef>,
  ): void {
    for (kv in snap.items()) {
      (_, curRef) = this.maybeGetRef(kv.i0).fromSome();
      this.!refs[kv.i0] = LocalRef(
        TType::union(subst, tenv, kv.i1.type, curRef.type),
        tenv.preserveCopyProvenance(
          subst,
          kv.i1.declaredType,
          curRef.declaredType,
        ),
        curRef.hasDeclaredContract,
        kv.i1.isInitialized && curRef.isInitialized,
        curRef.isMutable,
        curRef.hasFieldRefinement || kv.i1.hasFieldRefinement,
      )
    };
    // The edge speaks for every binding, not only the ones it mentions: one it
    // does not was left at the state above this scope, since the jump touched
    // nothing below its baseline for it. The exit merge already unions the
    // parent's value on that account; the initialization bit is this scope's
    // to keep honest — a binding this scope's own paths assigned is not
    // assigned on the edge's path unless it already was above
    // (SkipLabs/skjs#969: a `continue` past the assignment must not leave the
    // for-increment reading the binding as assigned).
    for (nameRef in this.escapingRefs()) {
      if (nameRef.ref.isInitialized && !snap.containsKey(nameRef.name)) {
        this.up.fromSome().maybeGetRef(nameRef.name) match {
        | Some((_, upRef)) if (!upRef.isInitialized) ->
          this.!refs[nameRef.name] = LocalRef(
            nameRef.ref.type,
            nameRef.ref.declaredType,
            nameRef.ref.hasDeclaredContract,
            false,
            nameRef.ref.isMutable,
            nameRef.ref.hasFieldRefinement,
          )
        | _ -> void
        }
      }
    }
  }

  // Enter a `catch` or `finally` with the try's write-log unioned in: the
  // exception can leave the try after any prefix, so each logged binding may
  // hold any value written — or what it held on entry, which the walk-up
  // already gives, and which also keeps the initialization bit: a mid-try
  // assignment is not definite here, since the throw may come first. A name
  // that does not resolve is local to the try, out of scope here.
  mutable fun uniteTryWrites(
    subst: mutable Subst,
    tenv: TEnv,
    log: readonly Map<String, TType>,
  ): void {
    for (kv in log.items()) {
      this.maybeGetRef(kv.i0) match {
      | Some((_, cur)) ->
        this.!refs[kv.i0] = LocalRef(
          TType::union(subst, tenv, cur.type, kv.i1),
          tenv.preserveCopyProvenance(subst, kv.i1, cur.declaredType),
          cur.hasDeclaredContract,
          cur.isInitialized,
          cur.isMutable,
          true, // The write log carries types without refinement provenance.
        )
      | None() -> void
      }
    }
  }

  // Fold a finally's writes into a recorded jump snapshot. A jump that leaves
  // a `try` runs its `finally` on the way out, so the edge carries the state
  // after the finally's writes: each binding the finally wrote becomes the
  // union of what the edge carried — or, when it carried nothing, the view
  // from this scope, which the try's own merge has already widened past the
  // baseline the edge implies — and the written value, covering the write
  // path and a conditional path that left the binding alone. The
  // initialization state is left as carried: upgrading it would claim the
  // finally definitely assigned from the edge's entry, which its own merge
  // cannot attest.
  readonly fun foldFinallyIntoSnapshot(
    subst: mutable Subst,
    tenv: TEnv,
    snap: mutable Map<String, LocalRef>,
    finallyScope: readonly Scope,
  ): void {
    for (nameRef in finallyScope.escapingRefs()) {
      cur = snap.maybeGet(nameRef.name) match {
      | Some(ref) -> ref
      | None() -> this.maybeGetRef(nameRef.name).fromSome().i1
      };
      snap![nameRef.name] = LocalRef(
        TType::union(subst, tenv, cur.type, nameRef.ref.type),
        tenv.preserveCopyProvenance(
          subst,
          nameRef.ref.declaredType,
          cur.declaredType,
        ),
        cur.hasDeclaredContract,
        cur.isInitialized,
        cur.isMutable,
        cur.hasFieldRefinement || nameRef.ref.hasFieldRefinement,
      )
    }
  }

  // Fill this (fresh, empty) scope with a recorded snapshot, so it can stand in
  // as one more direct subscope for `mergeN`.
  mutable fun seedRefs(snap: readonly Map<String, LocalRef>): void {
    for (kv in snap.items()) {
      this.!refs[kv.i0] = kv.i1
    }
  }

  // Merge sibling subscopes into `this`. Every scope must be a direct subscope.
  //
  // A binding ends up as the union over every path that can reach this point:
  // per scope, the value that scope left it at, or the parent's value when the
  // scope does not touch it. `untouchedPath` adds one further path that touches
  // nothing — a `switch` with no `default` may match no clause at all, leaving
  // every binding exactly as it was.
  //
  // This is the N-way form of `merge`, and it is not the same as folding `merge`
  // pairwise: for a binding escaping both of its scopes, the two-scope form
  // *replaces* the parent's value rather than accumulating into it, so each fold
  // step would discard the previous one.
  mutable fun mergeN(
    subst: mutable Subst,
    tenv: TEnv,
    scopes: Sequence<readonly Scope>,
    untouchedPath: Bool,
  ): void {
    for (scope in scopes) {
      if (scope.up.fromSome().id != this.id) {
        internal_error("scope up id mismatch")
      }
    };
    names = SortedSet[];
    for (scope in scopes) {
      for (nameRef in scope.escapingRefs()) {
        !names = names.set(nameRef.name)
      }
    };
    for (name in names) {
      (_, upRef) = this.maybeGetRef(name).fromSome();
      // Every path that leaves the binding alone — a scope that does not touch
      // it, or the untouched path — contributes the same parent value, so it is
      // unioned in once rather than once per such path.
      declaredType = upRef.declaredType;
      untouched = untouchedPath;
      tyOpt: ?TType = None();
      isInitialized = true;
      hasFieldRefinement = false;
      for (scope in scopes) {
        scope.escapingRef(name) match {
        | Some(ref) ->
          !declaredType = tenv.preserveCopyProvenance(
            subst,
            ref.declaredType,
            declaredType,
          );
          !tyOpt = Some(
            tyOpt match {
            | None() -> ref.type
            | Some(ty) -> TType::union(subst, tenv, ty, ref.type)
            },
          );
          !hasFieldRefinement = hasFieldRefinement || ref.hasFieldRefinement;
          !isInitialized = isInitialized && ref.isInitialized
        | None() -> !untouched = true
        }
      };
      // `name` is here because it escapes at least one scope, so the fold above
      // ran at least once.
      ty = tyOpt.fromSome();
      if (untouched) {
        !ty = TType::union(subst, tenv, ty, upRef.type);
        !hasFieldRefinement = hasFieldRefinement || upRef.hasFieldRefinement;
        !isInitialized = isInitialized && upRef.isInitialized
      };
      this.!refs[name] = LocalRef(
        ty,
        declaredType,
        upRef.hasDeclaredContract,
        isInitialized,
        upRef.isMutable,
        hasFieldRefinement,
      )
    }
  }

  mutable fun merge(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    if (scope1.up.fromSome().id != this.id) {
      internal_error("scope1 up id mismatch")
    };
    if (scope2.up.fromSome().id != this.id) {
      internal_error("scope2 up id mismatch")
    };
    scope1.escapingRefs().zipSortedBy(scope2.escapingRefs()).each(ior -> {
      ior match {
      | Left(nameRef)
      | Right(nameRef) ->
        (_, upRef) = this.maybeGetRef(nameRef.name).fromSome();
        this.!refs[nameRef.name] = LocalRef(
          TType::union(subst, tenv, upRef.type, nameRef.ref.type),
          tenv.preserveCopyProvenance(
            subst,
            nameRef.ref.declaredType,
            upRef.declaredType,
          ),
          upRef.hasDeclaredContract,
          upRef.isInitialized,
          upRef.isMutable,
          upRef.hasFieldRefinement || nameRef.ref.hasFieldRefinement,
        )
      | Both(nameRef1, nameRef2) ->
        // Value contracts belong to the binding. Copy provenance may have
        // accumulated on either branch and must survive alongside that contract.
        (_, upRef) = this.maybeGetRef(nameRef1.name).fromSome();
        this.!refs[nameRef1.name] = LocalRef(
          TType::union(subst, tenv, nameRef1.ref.type, nameRef2.ref.type),
          tenv.preserveCopyProvenance(
            subst,
            nameRef2.ref.declaredType,
            tenv.preserveCopyProvenance(
              subst,
              nameRef1.ref.declaredType,
              upRef.declaredType,
            ),
          ),
          upRef.hasDeclaredContract,
          nameRef1.ref.isInitialized && nameRef2.ref.isInitialized,
          upRef.isMutable,
          nameRef1.ref.hasFieldRefinement || nameRef2.ref.hasFieldRefinement,
        )
      }
    })
  }

  mutable fun popMerge(
    subst: mutable Subst,
    tenv: TEnv,
    scope: readonly Scope,
  ): void {
    if (scope.up.fromSome().id != this.id) {
      internal_error("scope up id mismatch")
    };
    for (nameRef in scope.escapingRefs()) {
      (_, upRef) = this.maybeGetRef(nameRef.name).fromSome();
      this.!refs[nameRef.name] = LocalRef(
        TType::union(subst, tenv, upRef.type, nameRef.ref.type),
        tenv.preserveCopyProvenance(
          subst,
          nameRef.ref.declaredType,
          upRef.declaredType,
        ),
        upRef.hasDeclaredContract,
        upRef.isInitialized,
        upRef.isMutable,
        upRef.hasFieldRefinement || nameRef.ref.hasFieldRefinement,
      )
    }
  }

  mutable fun popReplace(scope: readonly Scope): void {
    if (scope.up.fromSome().id != this.id) {
      internal_error("scope up id mismatch")
    };
    for (nameRef in scope.escapingRefs()) {
      this.!refs[nameRef.name] = nameRef.ref;
    }
  }
}

module end;
