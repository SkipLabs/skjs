/***************************************************************************/
/* The local environment. */
/***************************************************************************/

module SKJS;

value class LocalRef(type: TType, isInitialized: Bool)

class NameRef(name: String, ref: LocalRef) uses Projectable<String> {
  fun project(): String {
    this.name
  }
}

mutable class Scope{
  id: Int,
  private isLoop: Bool,
  up: ?readonly Scope = None(),
  private mutable locals: SortedMap<String, Name> = SortedMap[],
  private mutable refs: SortedMap<String, LocalRef> = SortedMap[],
} {
  static fun mcreateToplevel(): mutable this {
    mutable static{id => 0, isLoop => false}
  }

  readonly private fun maybeGetLocal(name: Name): ?Name {
    this.locals.maybeGet(name.value) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetLocal(name)
      }
    | Some(x) -> Some(x)
    }
  }

  // The declaration position of the in-scope binding of `name`, or None if
  // `name` is not a lexical local. This is a stable per-binding identity
  // (distinct for shadowed / sibling / sequential same-name bindings), used to
  // key per-binding state (see TCEnv.localObjects) instead of the bare name.
  readonly fun bindingPos(name: Name): ?PosRange {
    this.maybeGetLocal(name).map(declName -> declName.pos)
  }

  readonly private fun maybeGetRefHelper(
    throughLoop: Bool,
    name: String,
  ): ?(Bool, LocalRef) {
    !throughLoop = this.isLoop || throughLoop;
    this.refs.maybeGet(name) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetRefHelper(throughLoop, name)
      }
    | Some(x) -> Some((throughLoop, x))
    }
  }

  readonly private fun maybeGetRef(name: String): ?(Bool, LocalRef) {
    this.maybeGetRefHelper(false, name)
  }

  mutable fun bind(
    tcenvb: mutable TCEnvBase,
    name: Name,
    ty: TType,
    isInitialized: Bool,
  ): void {
    this.maybeGetLocal(name) match {
    | None() -> void
    | Some(otherDef) ->
      tcenvb.error(
        Array[
          (name.pos, `Cannot redeclare block-scoped variable '${name}'`),
          (otherDef.pos, "Previous definition was here"),
        ],
        TSCode(2451),
      )
    };
    this.!locals[name.value] = name;
    this.!refs[name.value] = LocalRef(ty, isInitialized)
  }

  readonly fun isThroughLoop(name: Name): Bool {
    this.maybeGetRef(name.value) match {
    | None() -> false
    | Some((isThroughLoop, _)) -> isThroughLoop
    }
  }

  readonly fun maybeGet(name: Name): ?TType {
    this.maybeGetRef(name.value) match {
    | None() -> None()
    | Some((_, ref)) ->
      if (!ref.isInitialized) {
        fatalError(
          Array[
            (
              name.pos,
              `Variable '${name.value}' is used before being assigned`,
            ),
          ],
          TSCode(2454),
        )
      } else {
        Some(ref.type)
      }
    }
  }

  readonly fun get(name: Name): TType {
    this.maybeGet(name) match {
    | None() ->
      fatalError(
        Array[(name.pos, `Cannot find name '${name.value}'`)],
        TSCode(2304),
      )
    | Some(x) -> x
    }
  }

  mutable fun set(
    name: Name,
    ty: TType,
    isSubType: (TType, TType) -> void,
  ): void {
    (throughLoop, upRef) = this.maybeGetRef(name.value) match {
    | None() ->
      fatalError(
        Array[(name.pos, `Cannot find name '${name.value}'`)],
        TSCode(2304),
      )
    | Some(x) -> x
    };
    if (throughLoop) {
      isSubType(ty, upRef.type);
    };
    this.!refs[name.value] = LocalRef(ty, true);
  }

  readonly fun escapingRefs(): mutable Iterator<NameRef> {
    this.refs.items()
      .filter(x -> !this.locals.containsKey(x.i0))
      .map(x -> NameRef(x.i0, x.i1))
  }

  mutable fun merge(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    if (scope1.up.fromSome().id != this.id) {
      internal_error("scope1 up id mismatch")
    };
    if (scope2.up.fromSome().id != this.id) {
      internal_error("scope2 up id mismatch")
    };
    scope1.escapingRefs().zipSortedBy(scope2.escapingRefs()).each(ior -> {
      ior match {
      | Left(nameRef)
      | Right(nameRef) ->
        (_, upRef) = this.maybeGetRef(nameRef.name).fromSome();
        this.!refs[nameRef.name] = LocalRef(
          TType::union(subst, tenv, upRef.type, nameRef.ref.type),
          upRef.isInitialized,
        )
      | Both(nameRef1, nameRef2) ->
        this.!refs[nameRef1.name] = LocalRef(
          TType::union(subst, tenv, nameRef1.ref.type, nameRef2.ref.type),
          nameRef1.ref.isInitialized && nameRef2.ref.isInitialized,
        )
      }
    })
  }

  mutable fun popMerge(
    subst: mutable Subst,
    tenv: TEnv,
    scope: readonly Scope,
  ): void {
    if (scope.up.fromSome().id != this.id) {
      internal_error("scope up id mismatch")
    };
    for (nameRef in scope.escapingRefs()) {
      (_, upRef) = this.maybeGetRef(nameRef.name).fromSome();
      this.!refs[nameRef.name] = LocalRef(
        TType::union(subst, tenv, upRef.type, nameRef.ref.type),
        upRef.isInitialized,
      )
    }
  }

  mutable fun popReplace(scope: readonly Scope): void {
    if (scope.up.fromSome().id != this.id) {
      internal_error("scope up id mismatch")
    };
    for (nameRef in scope.escapingRefs()) {
      this.!refs[nameRef.name] = nameRef.ref;
    }
  }
}

module end;
