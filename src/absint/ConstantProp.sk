module SKJS;

base class CPVal uses Equality {
  children =
  | CPVBot()
  | CPVNumber(x: Float)
  | CPVString(x: String)
  | CPVBool(x: Bool)
  | CPVUndefined()
  | CPVNull()
  | CPVTop()

  static fun join(l: CPVal, r: CPVal): CPVal {
    (l, r) match {
    | (CPVBot(), other)
    | (other, CPVBot()) ->
      other
    | (CPVNumber(x), CPVNumber(y)) -> if (x == y) CPVNumber(x) else CPVTop()
    | (CPVString(x), CPVString(y)) -> if (x == y) CPVString(x) else CPVTop()
    | (CPVBool(x), CPVBool(y)) -> if (x == y) CPVBool(x) else CPVTop()
    | (CPVUndefined(), CPVUndefined()) -> CPVUndefined()
    | (CPVNull(), CPVNull()) -> CPVNull()
    | _ -> CPVTop()
    }
  }
  static fun leq(l: CPVal, r: CPVal): Bool {
    (l, r) match {
    | (_, CPVTop())
    | (CPVBot(), _)
    | (CPVUndefined(), CPVUndefined())
    | (CPVNull(), CPVNull()) ->
      true
    | (CPVNumber(x), CPVNumber(y)) -> x == y || x.isNaN() && y.isNaN()
    | (CPVString(x), CPVString(y)) -> x == y
    | (CPVBool(x), CPVBool(y)) -> x == y
    | _ -> false
    }
  }
}

// A reachable state binds local variables to abstract values (missing keys are
// un-constrained, i.e. `Top`) and carries `ret`, the abstract value the
// function returns along paths that reach this point — accumulated by `return`
// terminators and read back at call sites. `ret` starts at `undefined`, so a
// function that falls off its end returns `undefined`.
base class CPEnv {
  children =
  | CPEBot()
  | CPEEnv(env: SortedMap<String, CPVal>, ret: CPVal)
}

class ConstantProp() uses AbstractDomain<CPEnv> {
  fun bottom(): CPEnv {
    CPEBot()
  }
  fun init(): CPEnv {
    CPEEnv(SortedMap[], CPVUndefined())
  }

  // point-wise, dropping any resulting k |-> \top bindings
  fun join(l: CPEnv, r: CPEnv): CPEnv {
    l match {
    | CPEBot() -> r
    | CPEEnv(l_env, l_ret) ->
      r match {
      | CPEBot() -> l
      | CPEEnv(r_env, r_ret) ->
        point_join = (_k, v1_opt, v2_opt) -> {
          v1_opt match {
          | None() -> None()
          | Some(v1) ->
            v2_opt match {
            | None() -> None()
            | Some(v2) ->
              CPVal::join(v1, v2) match {
              | CPVTop() -> None()
              | x -> Some(x)
              }
            }
          }
        };
        CPEEnv(l_env.mergeWith(r_env, point_join), CPVal::join(l_ret, r_ret))
      }
    }
  }

  // l <= r IFF
  // l.ret <= r.ret AND
  // \forall k |-> v_r in r . \exists k |-> v_l in l . v_l <= v_r
  fun leq(l: CPEnv, r: CPEnv): Bool {
    l match {
    | CPEBot() -> true
    | CPEEnv(l_env, l_ret) ->
      r match {
      | CPEBot() -> false
      | CPEEnv(r_env, r_ret) ->
        CPVal::leq(l_ret, r_ret) &&
          r_env.all((k, v_r) -> {
            l_env.maybeGet(k) match {
            | None() -> false
            | Some(v_l) -> CPVal::leq(v_l, v_r)
            }
          })
      }
    }
  }
  // Transfer the block body by threading each instruction's transfer over the
  // instruction sequence.
  //
  // Calls are handled interprocedurally: a call as the initializer/right-hand
  // side of a bind/assignment, in statement position, or as a `return` value is
  // resolved through `interproc` (formals bound to actuals by `call`, the
  // callee's return value read back from its exit state). Calls nested inside a
  // larger expression (e.g. `f(a) + 1`) are not yet resolved and evaluate to
  // `Top`. The analysis is otherwise intraprocedural and sound under the
  // assumption that a tracked local is never reassigned "at a distance" through
  // a closure that captures it; every syntactically visible write (assignments,
  // compound assignments, `++`/`--`, including nested ones) is invalidated.
  fun transfer(
    instrs: Array<CFGInstr>,
    env: CPEnv,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPEnv {
    instrs.foldl((acc, instr) -> this.transferInstr(instr, acc, interproc), env)
  }

  private fun transferInstr(
    instr: CFGInstr,
    state: CPEnv,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPEnv {
    state match {
    | CPEBot() -> CPEBot()
    | CPEEnv(env, ret) ->
      instr match {
      | CFGIBind(_kind, pat, _ty, initOpt) ->
        // Evaluate the initializer in the pre-state, then invalidate any
        // variable it writes as a side effect before binding the pattern.
        env1 = initOpt match {
        | None() -> env
        | Some(te) -> this.dropVars(env, this.assignedVars(te.expr))
        };
        initOpt match {
        // A binding with no initializer introduces `undefined`.
        | None() ->
          pat.value match {
          | PVar(name) ->
            CPEEnv(this.setVar(env1, name.value, CPVUndefined()), ret)
          | _ -> CPEEnv(this.dropVars(env1, this.patternVars(pat)), ret)
          }
        | Some(te) ->
          this.evalOperand(env, te.expr, interproc) match {
          // A non-returning call initializer makes this point unreachable.
          | None() -> CPEBot()
          | Some(v) ->
            pat.value match {
            | PVar(name) -> CPEEnv(this.setVar(env1, name.value, v), ret)
            | _ ->
              // Destructuring binding: components are not tracked.
              CPEEnv(this.dropVars(env1, this.patternVars(pat)), ret)
            }
          }
        }
      | CFGIAssign(target, value) ->
        this.evalOperand(env, value.expr, interproc) match {
        | None() -> CPEBot()
        | Some(v) ->
          // Invalidate side-effecting writes in both operands (e.g. a computed
          // target `a[i++]` or a nested assignment in the value).
          env1 = this.dropVars(
            this.dropVars(env, this.assignedVars(value.expr)),
            this.assignedVars(target.expr),
          );
          target.expr.value match {
          | Var(name) -> CPEEnv(this.setVar(env1, name.value, v), ret)
          | _ ->
            // Complex target (property write or destructuring). A property
            // write touches no tracked local; destructuring writes are dropped.
            CPEEnv(this.dropVars(env1, this.lvalueVars(target.expr)), ret)
          }
        }
      | CFGIExpr(te) ->
        // Statement-position expression evaluated for effect; its value is
        // discarded, but a non-returning call makes the point unreachable and
        // any variable the expression writes must be invalidated.
        this.evalOperand(env, te.expr, interproc) match {
        | None() -> CPEBot()
        | Some(_) -> CPEEnv(this.dropVars(env, this.assignedVars(te.expr)), ret)
        }
      }
    }
  }

  // The exceptional edge is taken when the block raises at some point in its
  // body or terminator. The handler sees the environment as of the throw point:
  // instructions before it have run, the throwing one has only partially run (so
  // its own writes are uncertain). Thread the normal environment through the
  // block in evaluation order, joining the current environment — with the
  // throwing construct's writes dropped — at every point that may throw.
  fun transferExn(
    block: CFGBlock,
    s: CPEnv,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPEnv {
    result: CPEnv = CPEBot();
    cur = s;
    for (instr in block.instrs) {
      cur match {
      // A non-returning call earlier in the block leaves the rest unreachable.
      | CPEBot() -> void
      | CPEEnv(env, ret) ->
        if (instrMayThrow(instr)) {
          !result = this.join(
            result,
            CPEEnv(this.dropVars(env, this.instrModifiedVars(instr)), ret),
          )
        };
        !cur = this.transferInstr(instr, cur, interproc)
      }
    };

    cur match {
    | CPEBot() -> void
    | CPEEnv(env, ret) ->
      // A `throw` operand runs on no normal edge, so seed its calls here.
      block.terminator match {
      | CFGTThrow(te) -> _ = this.evalExpr(env, te.expr, interproc)
      | _ -> void
      };
      if (terminatorMayThrow(block.terminator)) {
        !result = this.join(
          result,
          CPEEnv(
            this.dropVars(env, this.terminatorModifiedVars(block.terminator)),
            ret,
          ),
        )
      }
    };
    result
  }

  fun transferTerminator(
    term: BBTerminator,
    s: CPEnv,
    label: CFGENormalLabel,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPEnv {
    s match {
    | CPEBot() -> CPEBot()
    | CPEEnv(env, ret) ->
      term match {
      | CFGTBranch(cond, _, _) ->
        // Invalidate writes in the condition, then prune the edge that a known
        // condition value makes unreachable.
        env1 = this.dropVars(env, this.assignedVars(cond.expr));
        this.evalExpr(env1, cond.expr, interproc) match {
        // A pending call in the condition leaves both edges unreachable for now.
        | CPVBot() -> CPEBot()
        | cv ->
          this.truthiness(cv) match {
          | Some(true) ->
            label match {
            | CFGEFalse() -> CPEBot()
            | _ -> CPEEnv(env1, ret)
            }
          | Some(false) ->
            label match {
            | CFGETrue() -> CPEBot()
            | _ -> CPEEnv(env1, ret)
            }
          | None() -> CPEEnv(env1, ret)
          }
        }
      | CFGTSwitch(scrutinee, branches, _default) ->
        env1 = this.dropVars(env, this.assignedVars(scrutinee.expr));
        sv = this.evalExpr(env1, scrutinee.expr, interproc);
        // A pending scrutinee call leaves every switch edge unreachable for now.
        if (sv is CPVBot()) return CPEBot();
        label match {
        | CFGECase(i) ->
          branches[i].i0 match {
          | Case(caseExpr) ->
            cav = this.evalExpr(env1, caseExpr, interproc);
            this.strictEq(sv, cav) match {
            // `Bot` cav (pending case value) folds here: `strictEq` yields
            // `None`, and the guard below excludes non-concrete values, so the
            // edge stays unreachable until the case value resolves.
            | Some(false) ->
              CPEBot() // this case can never be selected
            | Some(true) -> CPEEnv(env1, ret)
            | None() if (cav is CPVBot()) -> CPEBot()
            | None() ->
              // Reaching this case implies `scrutinee === caseValue`. When the
              // case is a known constant and the scrutinee is a bare,
              // currently-unknown variable, narrow it along this edge.
              scrutinee.expr.value match {
              | Var(
                name,
              ) if (
                this.isConcrete(cav) &&
                this.lookupVar(env1, name.value) is CPVTop()
              ) ->
                CPEEnv(this.setVar(env1, name.value, cav), ret)
              | _ -> CPEEnv(env1, ret)
              }
            }
          | Default() -> CPEEnv(env1, ret)
          }
        | CFGEDefault() ->
          // The default is taken only when no case matches, so it is
          // unreachable once some case is a definite match. Evaluate the case
          // values once: a pending (`Bot`) case value could still resolve to a
          // definite match, so keep the default unreachable until every case
          // value is known — this stays monotone as summaries resolve.
          caseVals = branches.map(b ->
            b.i0 match {
            | Case(ce) -> this.evalExpr(env1, ce, interproc)
            | Default() -> CPVTop()
            }
          );
          anyPending = caseVals.any(cv -> cv is CPVBot());
          someMatch = caseVals.any(cv -> this.strictEq(sv, cv) is Some(true));
          if (anyPending || someMatch) CPEBot() else CPEEnv(env1, ret)
        | CFGENormal()
        | CFGETrue()
        | CFGEFalse() ->
          CPEEnv(env1, ret)
        }
      // A `return` carries the function's result along the normal edge: record
      // it in `ret` for callers to read from the callee's exit state.
      | CFGTReturn(valueOpt) ->
        valueOpt match {
        | None() -> CPEEnv(env, CPVUndefined())
        | Some(te) ->
          env1 = this.dropVars(env, this.assignedVars(te.expr));
          this.evalOperand(env, te.expr, interproc) match {
          // `return f()` where `f` does not return here: this path is pending.
          | None() -> CPEBot()
          | Some(v) -> CPEEnv(env1, v)
          }
        }
      | CFGTJump _
      | CFGTThrow _
      | CFGTUnreachable() ->
        s
      }
    }
  }

  // -- Interprocedural calls ------------------------------------------------

  // Evaluate an expression in operand position, distinguishing an unreachable
  // result. `evalExpr` surfaces a pending/non-returning call (anywhere in `e`,
  // not just at its root) as `CPVBot`; here that becomes `None`, signalling the
  // program point is unreachable until a returning summary exists. Every other
  // expression yields `Some` abstract value.
  private fun evalOperand(
    env: SortedMap<String, CPVal>,
    e: Expr,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): ?CPVal {
    this.evalExpr(env, e, interproc) match {
    | CPVBot() -> None()
    | v -> Some(v)
    }
  }

  // Build a callee's entry frame: a fresh environment with each simple formal
  // bound to the abstract value of the corresponding actual (evaluated in the
  // caller's env), and `ret` seeded to `undefined`. Destructured or surplus
  // formals are left unconstrained.
  fun call(
    callerState: CPEnv,
    site: Callsite,
    params: Array<(Pattern, TType)>,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPEnv {
    callerState match {
    | CPEBot() -> CPEBot()
    | CPEEnv(callerEnv, _ret) ->
      args = site match {
      | CSCall(Call(_, _, a), _) -> a
      | CSNew(New(_, _, a), _) -> a
      };
      n = if (params.size() < args.size()) params.size() else args.size();
      entryEnv = SortedMap<String, CPVal>[];
      for (i in Range(0, n)) {
        this.evalOperand(callerEnv, args[i], interproc) match {
        // A pending/non-returning call in argument position makes the callee
        // entry unreachable
        | None() -> return CPEBot()
        | Some(v) ->
          params[i].i0.value match {
          | PVar(name) -> !entryEnv = this.setVar(entryEnv, name.value, v)
          | _ -> void
          }
        }
      };
      CPEEnv(entryEnv, CPVUndefined())
    }
  }

  // An unanalyzable callee (no CFG: imported / ambient) may return any value and
  // execution continues, so its result is `Top`. The env is irrelevant — a
  // caller reads only `ret`.
  fun callOpaque(_callerState: CPEnv, _site: Callsite): CPEnv {
    CPEEnv(SortedMap[], CPVTop())
  }

  // Propagate a callee's exit state back into the caller at a callsite. The call
  // does not mutate the caller's locals, so the caller's environment is preserved;
  // the callee's return value (its exit `ret`) is surfaced in `ret` for the call
  // site to read as the call's result value. A bottom callee state — the callee
  // has not returned here (pending or non-returning) — leaves the caller's
  // continuation unreachable, which keeps the fixpoint monotone as callee
  // summaries grow from bottom.
  fun ret(callerState: CPEnv, calleeState: CPEnv, _site: Callsite): CPEnv {
    (callerState, calleeState) match {
    | (CPEBot(), _)
    | (_, CPEBot()) ->
      CPEBot()
    | (CPEEnv(callerEnv, _callerRet), CPEEnv(_calleeEnv, calleeRet)) ->
      CPEEnv(callerEnv, calleeRet)
    }
  }

  // -- Environment helpers --------------------------------------------------

  // Missing keys denote `Top` (unconstrained), so a `Top` binding is dropped.
  private fun setVar(
    env: SortedMap<String, CPVal>,
    name: String,
    v: CPVal,
  ): SortedMap<String, CPVal> {
    v match {
    | CPVTop() -> env.remove(name)
    | _ -> env.set(name, v)
    }
  }

  private fun lookupVar(env: SortedMap<String, CPVal>, name: String): CPVal {
    env.maybeGet(name).default(CPVTop())
  }

  private fun dropVars(
    env: SortedMap<String, CPVal>,
    names: SortedSet<String>,
  ): SortedMap<String, CPVal> {
    names.reduce((acc, n) -> acc.remove(n), env)
  }

  private fun isConcrete(v: CPVal): Bool {
    v match {
    | CPVTop()
    | CPVBot() ->
      false
    | _ -> true
    }
  }

  // -- Abstract expression evaluation ---------------------------------------

  // Over-approximate the value of `e` in `env`, returning `Top` whenever the
  // result cannot be pinned to a single constant. Nested assignments evaluate to
  // `Top` (see `evalBinop`), which poisons any enclosing constant evaluation so
  // a later read of the written variable never gets a stale value.
  //
  // A call/`new` (at any depth) is resolved through `interproc`; a callee that
  // does not return here yet yields `CPVBot`, which is strict — it propagates
  // through every combinator so the whole enclosing expression is `Bot`. This is
  // what keeps the fixpoint monotone as callee summaries grow from bottom (see
  // `evalOperand`, which turns a `Bot` result into an unreachable point).
  private fun evalExpr(
    env: SortedMap<String, CPVal>,
    e: Expr,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPVal {
    e.value match {
    | Number(s) ->
      // Number literals are stored in canonical `String(Number(x))` form, which
      // `toFloatOption` parses directly.
      s.toFloatOption() match {
      | Some(f) -> CPVNumber(f)
      | None() -> CPVTop()
      }
    | EString(s) -> CPVString(s)
    | Var(Name(_, "true")) -> CPVBool(true)
    | Var(Name(_, "false")) -> CPVBool(false)
    | Var(Name(_, "null")) -> CPVNull()
    | Var(Name(_, "undefined")) -> CPVUndefined()
    | Var(name) -> this.lookupVar(env, name.value)
    | call @ Call _ ->
      (onReturn, _onThrow) = interproc(
        CSCall(call, e.pos),
        CPEEnv(env, CPVUndefined()),
      );
      onReturn match {
      | CPEBot() -> CPVBot()
      | CPEEnv(_callee_env, ret) -> ret
      }
    | ctor @ New _ ->
      (onReturn, _onThrow) = interproc(
        CSNew(ctor, e.pos),
        CPEEnv(env, CPVUndefined()),
      );
      onReturn match {
      | CPEBot() -> CPVBot()
      | CPEEnv(_, _) -> CPVTop()
      }
    | Unop(op, e1) -> this.evalUnop(op, this.evalExpr(env, e1, interproc))
    | Binop(op, e1, e2) -> this.evalBinop(env, op, e1, e2, interproc)
    | EIf(cond, thenE, elseE) ->
      this.evalExpr(env, cond, interproc) match {
      | CPVBot() -> CPVBot()
      | c ->
        this.truthiness(c) match {
        | Some(true) -> this.evalExpr(env, thenE, interproc)
        | Some(false) -> this.evalExpr(env, elseE, interproc)
        | None() -> CPVTop()
        }
      }
    | As(e1, _)
    | AsConst(e1)
    | Satisfies(e1, _) ->
      // Type-only wrappers: identical runtime value.
      this.evalExpr(env, e1, interproc)
    | _ ->
      // Any other form (property access, object/array/template literals, ...) is
      // not a tracked constant. `Top` over-approximates every possible runtime
      // value, so this default is sound for any present or future expression
      // form. It cannot contain an unresolved call, so `Bot` never hides here.
      CPVTop()
    }
  }

  private fun evalUnop(op: UnaryOperator, v: CPVal): CPVal {
    if (v is CPVBot()) return CPVBot(); // strict: propagate a pending operand
    op match {
    | UOExclamationMark() ->
      this.truthiness(v) match {
      | Some(b) -> CPVBool(!b)
      | None() -> CPVTop()
      }
    | UOMinus() ->
      v match {
      | CPVNumber(x) -> CPVNumber(x.negate())
      | _ -> CPVTop()
      }
    | UOPlus() ->
      v match {
      | CPVNumber(x) -> CPVNumber(x)
      | _ -> CPVTop()
      }
    // Bitwise not applies `ToInt32` coercion; abstract to top
    | UOTild() -> CPVTop()
    }
  }

  private fun evalBinop(
    env: SortedMap<String, CPVal>,
    op: BinaryOperator,
    e1: Expr,
    e2: Expr,
    interproc: (Callsite, CPEnv) -> (CPEnv, CPEnv),
  ): CPVal {
    op match {
    // Short-circuit operators evaluate the left operand first. A pending left
    // (`Bot`) makes the whole expression `Bot`; when the left is only unknown
    // (`None`/`Top`) the result may come from either operand, so it stays `Top`
    // even if the right would be `Bot` — the point is not necessarily dead.
    | BOLogicalAnd() ->
      l = this.evalExpr(env, e1, interproc);
      l match {
      | CPVBot() -> CPVBot()
      | _ ->
        this.truthiness(l) match {
        | Some(false) ->
          l // short-circuits to the (falsy) left value
        | Some(true) -> this.evalExpr(env, e2, interproc)
        | None() -> CPVTop()
        }
      }
    | BOLogicalOr() ->
      l = this.evalExpr(env, e1, interproc);
      l match {
      | CPVBot() -> CPVBot()
      | _ ->
        this.truthiness(l) match {
        | Some(true) ->
          l // short-circuits to the (truthy) left value
        | Some(false) -> this.evalExpr(env, e2, interproc)
        | None() -> CPVTop()
        }
      }
    | BONullishCoalescing() ->
      l = this.evalExpr(env, e1, interproc);
      l match {
      | CPVBot() -> CPVBot()
      | CPVNull()
      | CPVUndefined() ->
        this.evalExpr(env, e2, interproc)
      | CPVTop() -> CPVTop()
      | other -> other
      }
    | BOAssignment()
    | BOOpAssignment(_) ->
      // `Top` is conservative but sound in the presence of sub-expression assignments
      CPVTop()
    | _ ->
      // Every remaining operator evaluates both operands unconditionally, so a
      // pending call in either makes the result `Bot`.
      l = this.evalExpr(env, e1, interproc);
      r = this.evalExpr(env, e2, interproc);
      (l, r) match {
      | (CPVBot(), _)
      | (_, CPVBot()) ->
        CPVBot()
      | _ -> this.evalStrictBinop(op, l, r)
      }
    }
  }

  private fun evalStrictBinop(op: BinaryOperator, l: CPVal, r: CPVal): CPVal {
    op match {
    | BOStrictEquality() ->
      this.strictEq(l, r) match {
      | Some(b) -> CPVBool(b)
      | None() -> CPVTop()
      }
    | BOStrictInequality() ->
      this.strictEq(l, r) match {
      | Some(b) -> CPVBool(!b)
      | None() -> CPVTop()
      }
    | BOAddition() ->
      (l, r) match {
      | (CPVNumber(x), CPVNumber(y)) -> CPVNumber(x + y)
      | (CPVString(x), CPVString(y)) -> CPVString(x + y)
      // Mixed operands trigger coercion
      | _ -> CPVTop()
      }
    | BOSubtraction() -> this.numBinop(l, r, (x, y) -> x - y)
    | BOMultiplication() -> this.numBinop(l, r, (x, y) -> x * y)
    // Division by zero yields IEEE `inf`/`nan` rather than trapping
    | BODivision() -> this.numBinop(l, r, (x, y) -> x / y)
    | BOLessThan() -> this.numCmp(l, r, (x, y) -> x < y)
    | BOLessThanOrEqual() -> this.numCmp(l, r, (x, y) -> x <= y)
    | BOGreaterThan() -> this.numCmp(l, r, (x, y) -> x > y)
    | BOGreaterThanOrEqual() -> this.numCmp(l, r, (x, y) -> x >= y)
    | _ ->
      // Remainder, exponentiation, bit/shift ops, etc. not handled yet.
      CPVTop()
    }
  }

  private fun numBinop(l: CPVal, r: CPVal, f: (Float, Float) -> Float): CPVal {
    (l, r) match {
    | (CPVNumber(x), CPVNumber(y)) -> CPVNumber(f(x, y))
    | _ -> CPVTop()
    }
  }

  private fun numCmp(l: CPVal, r: CPVal, f: (Float, Float) -> Bool): CPVal {
    (l, r) match {
    | (CPVNumber(x), CPVNumber(y)) -> CPVBool(f(x, y))
    | _ -> CPVTop()
    }
  }

  // Three-valued truthiness (`ToBoolean`): `None` when unknown.
  private fun truthiness(v: CPVal): ?Bool {
    v match {
    | CPVBool(b) -> Some(b)
    // `0`, `-0` (`== 0.0`) and `NaN` are the only falsy numbers.
    | CPVNumber(x) -> Some(!(x == 0.0) && !x.isNaN())
    | CPVString(s) -> Some(s != "")
    | CPVNull() -> Some(false)
    | CPVUndefined() -> Some(false)
    | CPVTop()
    | CPVBot() ->
      None()
    }
  }

  // Three-valued strict equality (`===`): `None` when the result cannot be
  // decided from the abstract values.
  private fun strictEq(a: CPVal, b: CPVal): ?Bool {
    (a, b) match {
    | (CPVTop(), _)
    | (_, CPVTop())
    | (CPVBot(), _)
    | (_, CPVBot()) ->
      None()
    // `NaN` is never `===` to anything, including itself.
    | (CPVNumber(x), CPVNumber(y)) ->
      Some(if (x.isNaN() || y.isNaN()) false else x == y)
    | (CPVString(x), CPVString(y)) ->
      // `unquoteString` does not decode escape sequences, so distinct raw
      // spellings may denote the same runtime string. Only equal raw forms are
      // provably equal; unequal ones are `None`, never a definite `false`
      // (which would be unsound for e.g. `"A" === "\x41"`).
      if (x == y) Some(true) else None()
    | (CPVBool(x), CPVBool(y)) -> Some(x == y)
    | (CPVNull(), CPVNull()) -> Some(true)
    | (CPVUndefined(), CPVUndefined()) -> Some(true)
    | _ ->
      // Distinct primitive kinds compared here (number vs string, null vs
      // undefined, ...). They are never `===`, but this arm is a cross-product
      // of value kinds that Skip cannot express without nested or-patterns;
      // returning `None` is the conservative choice that stays sound even if a
      // new `CPVal` kind is added.
      None()
    }
  }

  // -- Syntactic write / binding sets ---------------------------------------

  // Names a pattern binds.
  private fun patternVars(pat: Pattern): SortedSet<String> {
    pat.value match {
    | PVar(name) -> SortedSet[name.value]
    | PArray(elements, rest) ->
      base = elements.reduce(
        (acc, eltOpt) ->
          eltOpt match {
          | None() -> acc
          | Some((p, _)) -> acc.union(this.patternVars(p))
          },
        SortedSet[],
      );
      rest match {
      | None() -> base
      | Some(n) -> base.add(n.value)
      }
    | PObject{fields, rest} ->
      base = fields.reduce(
        (acc, field) -> {
          (_, p, _) = field;
          acc.union(this.patternVars(p))
        },
        SortedSet[],
      );
      rest match {
      | None() -> base
      | Some(n) -> base.add(n.value)
      }
    }
  }

  // Local variables written anywhere in `e` (assignment / compound-assignment
  // targets and `++`/`--` operands), used to invalidate stale constants.
  private fun assignedVars(e: Expr): SortedSet<String> {
    e.value match {
    | Binop(BOAssignment(), lhs, rhs)
    | Binop(BOOpAssignment(_), lhs, rhs) ->
      this.lvalueVars(lhs)
        .union(this.assignedVars(lhs))
        .union(this.assignedVars(rhs))
    | PostOp(POIncr(), e1)
    | PostOp(PODecr(), e1) ->
      this.lvalueVars(e1).union(this.assignedVars(e1))
    | _ ->
      // No write at this node; recurse into sub-expressions. Correct for any
      // non-assignment form, present or future.
      this.childExprs(e).reduce(
        (acc, c) -> acc.union(this.assignedVars(c)),
        SortedSet[],
      )
    }
  }

  // Local variables written when `e` is used as an assignment target. Property
  // writes (`obj.f`, `obj[k]`) touch no tracked local and contribute nothing.
  private fun lvalueVars(e: Expr): SortedSet<String> {
    e.value match {
    | Var(name) -> SortedSet[name.value]
    | Spread(e1) -> this.lvalueVars(e1)
    | EArray(elts) ->
      elts.reduce((acc, elt) -> acc.union(this.lvalueVars(elt)), SortedSet[])
    | Object(fields) ->
      fields.reduce(
        (acc, field) ->
          field match {
          | FDNormal(_, v)
          | FDComputed(_, v) ->
            acc.union(this.lvalueVars(v))
          | FDSpread(v) -> acc.union(this.lvalueVars(v))
          | FDMethod _ -> acc
          },
        SortedSet[],
      )
    | _ -> SortedSet[]
    }
  }

  // Immediate sub-expressions of `e`. Closures are deliberately opaque: their
  // body runs when *called*, not where the closure is written, so any write it
  // performs is out of scope for this intraprocedural analysis.
  private fun childExprs(e: Expr): Array<Expr> {
    e.value match {
    | Number _
    | BigInt _
    | Var _
    | EString _
    | Regexp _
    | Params _
    | Closure _ ->
      Array[]
    | Spread(e1)
    | TypeOf(e1)
    | VoidOp(e1)
    | Await(e1)
    | Async(e1)
    | Unop(_, e1)
    | PostOp(_, e1)
    | Dot(_, e1, _)
    | As(e1, _)
    | AsConst(e1)
    | Satisfies(e1, _) ->
      Array[e1]
    | Get(e1, e2)
    | In(e1, e2)
    | InstanceOf(e1, e2)
    | Binop(_, e1, e2) ->
      Array[e1, e2]
    | EIf(a, b, c) -> Array[a, b, c]
    | New(callee, _, args)
    | Call(callee, _, args) ->
      Array[callee].concat(args)
    | EArray(exprs)
    | TemplateLiteral(_, exprs) ->
      exprs
    | Object(fields) ->
      result = mutable Vector<Expr>[];
      for (field in fields) {
        field match {
        | FDNormal(_, ex) -> result.push(ex)
        | FDComputed(key, value) ->
          result.push(key);
          result.push(value)
        | FDSpread(ex) -> result.push(ex)
        | FDMethod _ -> void
        }
      };
      result.toArray()
    }
  }

  // Variables a single instruction may write (bindings and syntactic writes),
  // used to invalidate them on the exceptional edge.
  private fun instrModifiedVars(instr: CFGInstr): SortedSet<String> {
    instr match {
    | CFGIBind(_, pat, _, initOpt) ->
      base = this.patternVars(pat);
      initOpt match {
      | None() -> base
      | Some(te) -> base.union(this.assignedVars(te.expr))
      }
    | CFGIAssign(target, value) ->
      this.lvalueVars(target.expr)
        .union(this.assignedVars(target.expr))
        .union(this.assignedVars(value.expr))
    | CFGIExpr(te) -> this.assignedVars(te.expr)
    }
  }

  // Variables a terminator may write before transferring control.
  private fun terminatorModifiedVars(term: BBTerminator): SortedSet<String> {
    term match {
    | CFGTBranch(cond, _, _) -> this.assignedVars(cond.expr)
    | CFGTSwitch(scrutinee, _, _) -> this.assignedVars(scrutinee.expr)
    | CFGTReturn(Some(te)) -> this.assignedVars(te.expr)
    | CFGTThrow(te) -> this.assignedVars(te.expr)
    | CFGTReturn(None())
    | CFGTJump _
    | CFGTUnreachable() ->
      SortedSet[]
    }
  }
}

// Render a single abstract value.
fun renderCPVal(v: CPVal): String {
  v match {
  | CPVBot() -> "bot"
  | CPVTop() -> "top"
  | CPVNumber(x) -> x.toString()
  | CPVString(s) -> "\"" + s + "\""
  | CPVBool(b) -> b.toString()
  | CPVNull() -> "null"
  | CPVUndefined() -> "undefined"
  }
}

// Render a block's abstract state as its (sorted) variable bindings.
fun renderCPEnv(st: CPEnv): String {
  st match {
  | CPEBot() -> "unreachable"
  | CPEEnv(env, _ret) ->
    parts = env.items().collect(Array).map(kv ->
      kv.i0 + "=" + renderCPVal(kv.i1)
    );
    "{" + ", ".join(parts) + "}"
  }
}

// Renders constant-propagation states as the comment lines to insert.
//
// A CFG the analysis never reached gets no annotation at all rather than a row
// of "unreachable": a lambda passed to an unresolved higher-order call is not
// something the reader needs told about at every occurrence.
class ConstantPropAnnotations(
  states: SortedMap<CGNode, SortedMap<CFGBlockId, CPEnv>>,
) extends CFGAnnotations {
  fun blockState(node: CGNode, block: CFGBlockId): ?CPEnv {
    this.states.maybeGet(node).flatMap(perBlock -> perBlock.maybeGet(block))
  }

  fun analyzed(node: CGNode): Bool {
    this.states.maybeGet(node) match {
    | None() -> false
    | Some(perBlock) -> !perBlock.isEmpty()
    }
  }

  fun renderState(node: CGNode, block: CFGBlockId): String {
    this.blockState(node, block) match {
    | None() -> "unreachable"
    | Some(st) -> renderCPEnv(st)
    }
  }

  fun function(node: CGNode, cfg: CFG): Array<String> {
    if (!this.analyzed(node)) return Array[];
    ret = this.blockState(node, cfg.normalExit) match {
    | Some(CPEEnv(_, r)) -> ` returns ${renderCPVal(r)}`
    | _ -> ""
    };
    Array[
      `dataflow entry: ${this.renderState(node, cfg.entry)}`,
      `dataflow exit: ${this.renderState(node, cfg.normalExit)}${ret}`,
      `dataflow throw: ${this.renderState(node, cfg.exnExit)}`,
    ]
  }

  fun header(
    node: CGNode,
    _cfg: CFG,
    block: CFGBlock,
    isLoopHeader: Bool,
  ): Array<String> {
    if (!this.analyzed(node)) return Array[];
    label = if (isLoopHeader) "loop head" else "branch";
    Array[`dataflow ${label}: ${this.renderState(node, block.id)}`]
  }
}

module end;
