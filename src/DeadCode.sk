// Reachability / dead-code analysis as a two-element abstract domain

module SKJS;

base class Liveness {
  children =
  | Dead()
  | Live()
}

// Reachability / dead-code analysis. Liveness propagates unchanged along every
// edge (the transfers are the identity, ignoring calls), so a block is reachable
// exactly when the solver assigns it a state; dead blocks are the rest (see
// `deadBlocks`).
class LivenessDomain() uses AbstractDomain<Liveness> {
  fun bottom(): Liveness {
    Dead()
  }

  fun init(): Liveness {
    Live()
  }

  fun join(l: Liveness, r: Liveness): Liveness {
    l match {
    | Live() -> Live()
    | Dead() -> r
    }
  }
  fun leq(l: Liveness, r: Liveness): Bool {
    l match {
    | Dead() -> true
    | Live() -> r is Live()
    }
  }

  fun transfer(
    _instrs: Array<CFGInstr>,
    s: Liveness,
    _interproc: (Callsite, Liveness) -> Liveness,
  ): Liveness {
    s
  }

  fun transferExn(
    _block: CFGBlock,
    s: Liveness,
    _interproc: (Callsite, Liveness) -> Liveness,
  ): Liveness {
    s
  }

  fun transferTerminator(
    _term: BBTerminator,
    s: Liveness,
    _label: CFGENormalLabel,
    _interproc: (Callsite, Liveness) -> Liveness,
  ): Liveness {
    s
  }

  // Liveness ignores calls (the transfers never invoke the callback), so these
  // are only here to satisfy the trait: a reachable caller reaches its callees,
  // and an opaque call leaves reachability unchanged.
  fun call(
    s: Liveness,
    _site: Callsite,
    _params: Array<(Pattern, TType)>,
    _interproc: (Callsite, Liveness) -> Liveness,
  ): Liveness {
    s
  }

  fun callOpaque(s: Liveness, _site: Callsite): Liveness {
    s
  }

  // The caller continues past the call exactly when the callee returns.
  fun ret(
    _callerState: Liveness,
    calleeState: Liveness,
    _site: Callsite,
  ): Liveness {
    calleeState
  }
}

// The dead (unreachable) blocks of every function in `cfgs`. Runs the
// inter-procedural liveness solver with every function as an entrypoint — so a
// block is judged reachable relative to its own function's entry — and
// `callgraph` resolving call/return edges between them. For each function it
// returns every block absent from the fixpoint (excluding the structural
// `normalExit`/`exnExit` sentinels).
fun deadBlocks(
  cfgs: SortedMap<CGNode, CFG>,
  callgraph: SortedMap<CGNode, Array<CGNode>>,
): SortedMap<CGNode, SortedSet<CFGBlockId>> {
  solver = mutable Interproc{
    cfgs,
    callgraph,
    domain => LivenessDomain(),
    ctx_policy => ContextInsensitive(),
  };
  solver.analyzeForward(cfgs.keys().collect(Array));
  // A block is reachable exactly when the fixpoint assigned it a (necessarily
  // `Live`) state; `blockStates` omits blocks that were never reached.
  states = solver.blockStates();
  isLive = (node: CGNode, blk: CFGBlockId) -> {
    states.maybeGet(node) match {
    | None() -> false
    | Some(inner) -> (inner.maybeGet(blk) : ?Liveness) is Some(Live())
    }
  };

  result = SortedMap<CGNode, SortedSet<CFGBlockId>>[];
  for (kv in cfgs.items()) {
    (node, cfg) = kv;
    dead = SortedSet<CFGBlockId>[];
    for (block in cfg.blocks.values()) {
      isSentinel = block.id == cfg.normalExit || block.id == cfg.exnExit;
      if (!isSentinel && !isLive(node, block.id)) {
        !dead = dead.set(block.id)
      }
    };
    !result = result.set(node, dead)
  };
  result
}

module end;
