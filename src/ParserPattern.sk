/***************************************************************************/
/* Pattern parsing methods for the TypeScript parser. */
/***************************************************************************/

module SKJS;

extension class Parser {
  /***************************************************************************/
  // Pattern parsing
  //
  // <pattern> ::=
  //   | <name>
  //   | <pattern> ::= [ <pattern>* ]
  //   | <pattern> ::= { (<name> : <pattern>)* }
  /***************************************************************************/

  // Parse a pattern (used in destructuring assignments and function parameters)
  mutable fun pattern(): Pattern {
    (pos, pat) = this.withPos(this.pattern_, UnterminatedDef());
    Pattern(pos, pat)
  }

  // Internal pattern parsing implementation
  mutable fun pattern_(): Pattern_ {
    this.lex.peekKind() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
    | Some(TKOpenSquare()) ->
      _ = this.lex.next();
      if (this.lex.peekKind() is Some(TKCloseSquare())) {
        _ = this.lex.next();
        return PArray(Array[])
      };
      pats = mutable Vector[];
      loop {
        pats.push(this.pattern());
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseSquare())) {
            _ = this.lex.next();
            break void;
          }
        | TKCloseSquare() -> break void
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokens(Array[TKCloseSquare(), TKComma()]),
          )
        }
      };
      PArray(pats.toArray())
    | Some(TKOpenCurly()) ->
      _ = this.lex.next();
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        return PObject{fields => Array[], rest => None()}
      };
      fields = mutable Vector[];
      rest: ?Name = None();
      loop {
        if (this.lex.peekKind() is Some(TKDotDotDot())) {
          _ = this.lex.next();
          !rest = Some(this.getName());
          if (this.lex.peekKind() is Some(TKComma())) {
            _ = this.lex.next()
          };
          this.expect(TKCloseCurly());
          break void
        };
        fieldName = this.getName();
        fieldPat = if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          Some(this.pattern());
        } else {
          None()
        };
        fieldDefault = if (this.lex.peekKind() is Some(TKAssignment())) {
          _ = this.lex.next();
          Some(this.expr(0))
        } else {
          None()
        };
        fields.push(
          (
            fieldName,
            fieldPat match {
            | None() -> Pattern(fieldName.pos, PVar(fieldName))
            | Some(x) -> x
            },
            fieldDefault,
          ),
        );
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseCurly())) {
            _ = this.lex.next();
            break void;
          }
        | TKCloseCurly() -> break void
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokens(Array[TKCloseCurly(), TKComma()]),
          )
        }
      };
      PObject{fields => fields.toArray().sortedBy(x ~> x.i0.value), rest}
    | _ -> PVar(this.getName())
    }
  }
}

module end;
