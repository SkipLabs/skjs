module SKJS;

// A primitive literal value with position, identified by the value string
class PrimLiteral(
  pos: PosRange,
  val: String,
) uses Projectable<String>, Orderable {
  fun project(): String {
    this.val
  }

  fun compare(that: this): Order {
    this.project().compare(that.project())
  }
}

// The values a TPrimValue denotes, widened (issue #897) from the two-state
// `?PrimLiterals` (None = the whole primitive, Some = a finite non-empty
// literal set) to a three-child domain: a template literal pattern is
// neither, and a union like `"a" | `#${string}`` must be representable in the
// single string SType a clause can hold (STypes keys by tag).
base class PrimDomain uses XXHashable, Orderable {
  children =
  // The whole primitive (the old None()).
  | PDFull()
  // A finite non-empty literal set (the old Some(lits)).
  | PDLits(lits: PrimLiterals)
  // A mixed disjunction: any literals plus at least one template literal
  // pattern (patterns only ever occur under TString).
  | PDMixed(lits: ?PrimLiterals, pats: TemplatePats)

  // Hashes exactly like the old `?PrimLiterals` field for the two pre-existing
  // cases, so TPrimValue (and therefore TType, whose compare is hash-based)
  // keeps its hash — and every hash-derived ordering — unchanged. Only the new
  // PDMixed case hashes differently.
  fun xxhash(): XXHash {
    this match {
    | PDFull() -> (None() : ?PrimLiterals).xxhash()
    | PDLits(l) -> Some(l).xxhash()
    | PDMixed(l, p) ->
      XXHash(XXHash64.xxHash64(l.xxhash().value, p.xxhash().value))
    }
  }
}

class PrimLiterals private (
  private inner: InternalKeyedArrayMap<String, PrimLiteral>,
) extends Sequence<PrimLiteral> uses XXHashable, Orderable, Show {
  // Invariant: inner is not empty

  static fun single(elt: PrimLiteral): PrimLiterals {
    PrimLiterals(InternalKeyedArrayMap::single(elt))
  }

  static fun ofSet(set: SortedSet<String>, pos: PosRange): ?PrimLiterals {
    if (set.isEmpty()) None() else {
      Some(
        PrimLiterals(
          InternalKeyedArrayMap::createFromSortedIterator(
            set.values().map(s -> PrimLiteral(pos, s)),
          ),
        ),
      )
    }
  }

  fun xxhash(): XXHash {
    // Custom xxhash that excludes positions, only hashes the strings
    result = 0;
    for (lit in this.inner.values()) {
      !result = XXHash64.xxHash64(result, lit.val.xxhash().value);
    };
    XXHash(result)
  }

  fun size(): Int {
    this.inner.size()
  }

  fun singleElt(): ?PrimLiteral {
    this.inner.singleElt()
  }

  fun filterLiterals(f: PrimLiteral -> Bool): ?PrimLiterals {
    result = this.inner.filterKeyed(f);
    if (result.isEmpty()) None() else Some(PrimLiterals(result))
  }

  fun union(that: PrimLiterals): PrimLiterals {
    PrimLiterals(this.inner.union(that.inner))
  }

  fun inter(that: PrimLiterals): ?PrimLiterals {
    result = this.inner.inter(that.inner);
    if (result.isEmpty()) None() else Some(PrimLiterals(result))
  }

  // The literals of `this` that may denote the same runtime value as some
  // literal of `that`, for literal kinds where distinct names can denote one
  // value (beyond-precision numbers). Keeps `this`'s spellings.
  fun interMayEqual(
    that: PrimLiterals,
    mayEqual: (String, String) -> Bool,
  ): ?PrimLiterals {
    this.filterLiterals(lit ->
      that.inner.containsKey(lit.val) ||
        that.inner.values().any(other -> mayEqual(lit.val, other.val))
    )
  }

  fun diff(that: PrimLiterals): ?PrimLiterals {
    result = this.inner.diff(that.inner);
    if (result.isEmpty()) None() else Some(PrimLiterals(result))
  }

  fun toStringList(): String {
    this.inner.values().map(lit -> lit.val).collect(Array).join(" | ")
  }

  fun toString(): String {
    inspect(this).toString()
  }

  fun contains(x: String): Bool {
    this.inner.containsKey(x)
  }

  fun values(): mutable Iterator<PrimLiteral> {
    this.inner.values()
  }
}

module end;
