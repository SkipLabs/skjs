module SKJS;

// A primitive literal value with position, identified by the value string
class PrimLiteral(
  pos: PosRange,
  val: String,
) uses Projectable<String>, Orderable {
  fun project(): String {
    this.val
  }

  fun compare(that: this): Order {
    this.project().compare(that.project())
  }
}

class PrimLiterals private (
  private inner: InternalKeyedArrayMap<String, PrimLiteral>,
) extends Sequence<PrimLiteral> uses XXHashable, Orderable, Show {
  // Invariant: inner is not empty

  static fun single(elt: PrimLiteral): PrimLiterals {
    PrimLiterals(InternalKeyedArrayMap::single(elt))
  }

  static fun ofSet(set: SortedSet<String>, pos: PosRange): ?PrimLiterals {
    if (set.isEmpty()) None() else {
      Some(
        PrimLiterals(
          InternalKeyedArrayMap::createFromSortedIterator(
            set.values().map(s -> PrimLiteral(pos, s)),
          ),
        ),
      )
    }
  }

  fun xxhash(): XXHash {
    // Custom xxhash that excludes positions, only hashes the strings
    result = 0;
    for (lit in this.inner.values()) {
      !result = XXHash64.xxHash64(result, lit.val.xxhash().value);
    };
    XXHash(result)
  }

  fun size(): Int {
    this.inner.size()
  }

  fun singleElt(): ?PrimLiteral {
    this.inner.singleElt()
  }

  fun filterLiterals(f: PrimLiteral -> Bool): ?PrimLiterals {
    result = this.inner.filter(f);
    if (result.isEmpty()) None() else Some(PrimLiterals(result))
  }

  fun union(that: PrimLiterals): PrimLiterals {
    PrimLiterals(this.inner.union(that.inner))
  }

  fun inter(that: PrimLiterals): ?PrimLiterals {
    result = this.inner.inter(that.inner);
    if (result.isEmpty()) None() else Some(PrimLiterals(result))
  }

  fun diff(that: PrimLiterals): ?PrimLiterals {
    result = this.inner.diff(that.inner);
    if (result.isEmpty()) None() else Some(PrimLiterals(result))
  }

  fun toStringList(quotes: Bool = false): String {
    this.inner.values()
      .map(lit -> if (quotes) `'${lit.val}'` else lit.val)
      .collect(Array)
      .join(" | ")
  }

  fun toString(): String {
    inspect(this).toString()
  }

  fun contains(x: String): Bool {
    this.inner.containsKey(x)
  }

  fun values(): mutable Iterator<PrimLiteral> {
    this.inner.values()
  }
}

module end;
