module SKJS;

base class OptionalTypeParamsPermission {
  children =
  | OptionalTypeParamsAllowed()
  | OptionalTypeParamsForbidden()
}

extension class TypeChecker {
  fun check(
    context: mutable SKStore.Context,
    defs: Array<Def>,
  ): readonly TCResults {
    results = TCResults::mcreate{errorHandling => this.errorHandling};
    for (def in defs) {
      this.errorHandling match {
      | EHBacktrace() -> this.checkDef(context, def, results)
      | EHDefault()
      | EHKeepGoing() ->
        try {
          this.checkDef(context, def, results)
        } catch {
        | ErrorExn(err @ TypingError _) -> results.errors.push(err)
        | exn -> throw exn
        }
      }
    };
    results
  }

  fun checkDef(
    context: mutable SKStore.Context,
    def: Def,
    results: mutable TCResults,
  ): void {
    def.value match {
    | ExportImport _ -> notSupported(def.pos, "export import")
    | ImportExpr _ -> void
    | Global _ -> notSupported(def.pos, "global")
    | ExportAs _ -> notSupported(def.pos, "export as")
    | ExportEq _ -> notSupported(def.pos, "export =")
    | Module _ -> notSupported(def.pos, "module")
    | e @ Expr _ ->
      subst = Subst::mcreate{context};
      tcenv = TCEnv::mcreate(
        context,
        subst,
        CGNode::toplevel(def.pos.fileName),
        results,
      );
      ty = this.expr(tcenv, e, true);
      this.checkIsVoid(tcenv, e.pos, ty)
    | fd @ TopLevelFunDef _ ->
      cgNode = CGNode::create(TopLevelFunction(fd.name, fd.pos.fileName));
      subst = Subst::mcreate{context};
      this.funDef(subst, None(), fd, cgNode, results)
    | Declare _
    | ExportDeclare _ ->
      void
    | Namespace _ -> notSupported(def.pos, "namespace")
    | Export(d) -> this.checkDef(context, Def(def.pos, d), results)
    | ExportDefault _ -> notSupported(def.pos, "export default")
    | ExportNames _
    | ExportNamesFrom _ ->
      void
    | Import _ -> void
    | c @ Class _ -> this.class_(context, c, results)
    | Enum _ -> notSupported(def.pos, "enum")
    | VarDefs(kind, varDefs) -> this.varDefs(context, kind, varDefs, results)
    | td @ TypeDef _ -> this.typeDef(context, td, results)
    }
  }

  fun varDefs(
    context: mutable SKStore.Context,
    kind: VarDefKind,
    varDefs: Array<VarDef>,
    results: mutable TCResults,
  ): void {
    for (varDef in varDefs) {
      kind match {
      | VDKConst() -> void
      | VDKLet() -> notSupported(varDef.pat.pos, "toplevel let")
      | VDKVar() -> notSupported(varDef.pat.pos, "toplevel var")
      };
      if (varDef.value is None()) {
        results.error(Array[(varDef.pat.pos, "Missing definition")])
      };
      literalType = varDef.value.flatMap(this.asConstExpr).map(TType::single);
      typeOpt = varDef.type match {
      | None() ->
        if (literalType is None()) {
          results.error(Array[(varDef.pat.pos, "Missing type annotation")])
        };
        literalType
      | Some(x) -> Some(this.tenv.normalize(context, x))
      };
      subst = Subst::mcreate{context};
      typeOpt match {
      | Some(type) ->
        if (!type.isPrimitiveType(subst, this.tenv)) {
          typingError(
            Array[
              (
                varDef.pat.pos,
                "Invalid type for constant, only primitive types (not objects) are allowed",
              ),
            ],
          )
        }
      | _ -> void
      };
      varDef.pat.value match {
      | PVar _ -> void
      | PArray _
      | PObject _ ->
        typingError(
          Array[
            (
              varDef.pat.pos,
              "Construction not supported: top-level const declarations cannot destructure\n" +
                "Declare a simple const (e.g. `const tmp = ...`) and perform the destructuring inside a block/function.",
            ),
          ],
        )
      };
      (varDef.value, typeOpt) match {
      | (Some(e), Some(type)) ->
        tcenv = TCEnv::mcreate(
          context,
          subst,
          CGNode::toplevel(varDef.pat.pos.fileName),
          results,
        );
        this.checkSubType(
          tcenv,
          varDef.pat.pos,
          "Invalid definition",
          literalType match {
          | None() -> this.expr(tcenv, e, kind is VDKConst())
          | Some(litType) -> litType
          },
          type,
        )
      | _ -> void
      }
    }
  }

  fun typeDef(
    context: mutable SKStore.Context,
    typeDef: TypeDef,
    results: mutable TCResults,
  ): void {
    results.collectErrors(() ->
      static::checkTypeParams(typeDef.tdefParams, OptionalTypeParamsAllowed())
    );

    subst = Subst::mcreate{context};
    !this.tenv = this.tenv.addTParams(subst, typeDef.tdefParams);

    results.collectErrors(() -> _ = this.tenv.normalize(context, typeDef.body));
  }

  static fun checkTypeParams(
    tparams: Array<TypeParam>,
    optionalTypeParamsPermission: OptionalTypeParamsPermission,
  ): void {
    firstDefaultPosOpt: ?PosRange = None();
    for (tparam in tparams) {
      (tparam.default, firstDefaultPosOpt) match {
      | (Some _, None()) ->
        optionalTypeParamsPermission match {
        | OptionalTypeParamsForbidden() ->
          typingError(
            Array[
              (
                tparam.name.pos,
                "Optional type parameters are not supported for classes and functions",
              ),
            ],
          )
        | OptionalTypeParamsAllowed() -> void
        };
        !firstDefaultPosOpt = Some(tparam.name.pos)
      | (None(), Some(firstDefaultPos)) ->
        typingError(
          Array[
            (
              tparam.name.pos,
              "Required type parameters may not follow optional type parameters.",
            ),
            (firstDefaultPos, "First optional type parameter was here"),
          ],
        )
      | (None(), None())
      | (Some _, Some _) ->
        void
      }
    }
  }
}

module end;
