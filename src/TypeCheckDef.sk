module SKJS;

base class OptionalTypeParamsPermission {
  children =
  | OptionalTypeParamsAllowed()
  | OptionalTypeParamsForbidden()
}

// Key for caching checkDef results in an LHandle.
// Uses (fileName, defName, occurrenceNumber) so that results are stable
// across position changes within a file.
class DefKey(
  fileName: FPath,
  defName: String,
  occurrence: Int,
  def: Def,
) extends SKStore.Key {
  fun compare(other: SKStore.Key): Order {
    other match {
    | o @ DefKey _ ->
      this.fileName.compare(o.fileName) match {
      | EQ() ->
        this.defName.compare(o.defName) match {
        | EQ() -> this.occurrence.compare(o.occurrence)
        | x -> x
        }
      | x -> x
      }
    | _ -> internal_error("Invalid comparison")
    }
  }
}

class TCResultsAccFile(
  value: Result<TCResultsAcc, Exception>,
) extends SKStore.File

extension class TypeChecker {
  fun check(
    context: mutable SKStore.Context,
    checkDir: SKStore.LHandle<DefKey, TCResultsAccFile>,
    fileName: FPath,
    defs: Array<Def>,
  ): TCResults {
    results = mutable Vector[];
    // Count occurrences of each name to assign stable occurrence numbers
    nameCounts: mutable Map<String, Int> = mutable Map[];
    // checkDef catches fatal errors at the definition boundary (it only lets
    // them propagate in backtrace mode, for a native trace), so the loop body
    // never throws an ErrorExn here; any exception that does propagate is a
    // genuine crash and should not be swallowed.
    for (def in defs) {
      def.value.defStableName() match {
      | Some(Name(_, name)) ->
        occ = nameCounts.maybeGet(name).default(0);
        nameCounts![name] = occ + 1;
        key = DefKey(fileName, name, occ, def);
        checkDir.get(context, key).value match {
        | Success(res) -> results.push(res)
        | Failure(exn) -> throw exn
        }
      | None() -> results.push(this.checkDef(context, def))
      }
    };
    TCResults::ofAccs(results)
  }

  fun checkDef(
    context: mutable SKStore.Context,
    def: Def,
  ): readonly TCResultsAcc {
    results = TCResultsAcc::mcreate{errorHandling => this.errorHandling};
    tcenvl = mutable TCEnvLight{context, results};
    // Catch a fatal abort at the definition boundary so warnings (and any
    // earlier errors) collected before it survive instead of being discarded
    // with the unwound stack. The definition still stops at the first fatal
    // (one error per definition); backtrace mode propagates for a native trace.
    this.errorHandling match {
    | EHBacktrace() -> this.checkDef_(tcenvl, def)
    | EHKeepGoing()
    | EHDefault() ->
      catchError(() -> this.checkDef_(tcenvl, def)).each(results.errors.push)
    };
    results
  }

  fun checkDef_(tcenvl: mutable TCEnvLight, def: Def): void {
    def.value match {
    | ExportImport _ -> tcenvl.notSupported(def.pos, "export import")
    | ImportExpr _ -> void
    | Global _ -> tcenvl.notSupported(def.pos, "global")
    | ExportAs _ -> tcenvl.notSupported(def.pos, "export as")
    | ExportEq _ -> tcenvl.notSupported(def.pos, "export =")
    | Module _ -> tcenvl.notSupported(def.pos, "module")
    | e @ Expr _ ->
      subst = Subst::mcreate(tcenvl);
      tcenv = TCEnv::mcreate(subst, CGNode::toplevel(def.pos.fileName));
      ty = this.expr(tcenv, e, true);
      this.checkIsVoid(tcenv, e.pos, ty)
    | fd @ TopLevelFunDef _ ->
      subst = Subst::mcreate(tcenvl);
      this.funDef(subst, None(), fd, fd.cgNode.fromSome())
    | Declare(VarDefs(_, varDefs))
    | ExportDeclare(VarDefs(_, varDefs)) ->
      for (varDef in varDefs) {
        varDef.type.each(t -> checkUniqueSymbolReadonly(tcenvl, t))
      }
    | Declare(fd @ TopLevelFunDef _)
    | ExportDeclare(fd @ TopLevelFunDef _) ->
      // An ambient function declaration has no body, but its signature still
      // needs checking: normalizing the parameter and return types validates
      // their type-argument constraints at the reference site (see normalize's
      // TAInst branch). Without this, an unused ambient declaration is never
      // normalized anywhere and a constraint violation in its signature
      // (`Id<number>` for `type Id<P extends string>`) escapes detection.
      subst = Subst::mcreate(tcenvl);
      this.funDef(subst, None(), fd, fd.cgNode.fromSome())
    | Declare(en @ Enum _)
    | ExportDeclare(en @ Enum _) ->
      this.checkEnum(tcenvl, en)
    | Declare _
    | ExportDeclare _ ->
      void
    | Namespace _ -> tcenvl.notSupported(def.pos, "namespace")
    | Export(d) -> this.checkDef_(tcenvl, Def::create(def.pos, d))
    | ExportDefault _ -> tcenvl.notSupported(def.pos, "export default")
    | ExportNames _
    | ExportNamesFrom _ ->
      void
    | Import _ -> void
    | c @ Class _ -> this.class_(tcenvl, c)
    | en @ Enum _ -> this.checkEnum(tcenvl, en)
    | VarDefs(kind, varDefs) -> this.varDefs(tcenvl, kind, varDefs)
    | td @ TypeDef _ -> this.typeDef(tcenvl, td)
    }
  }

  // Validate a top-level const declaration (also reusable for class static readonly).
  // bindingName is the const/field name; when present it is encoded into any
  // unique-symbol identifier produced from the annotation, so the type can be
  // pretty-printed as `typeof <name>` rather than as a hash-based internal id.
  private fun validateToplevelConst(
    tcenvl: mutable TCEnvLight,
    pos: PosRange,
    typeAnnotation: ?Type,
    value: ?Expr,
    bindingName: ?String = None(),
  ): void {
    subst = Subst::mcreate(tcenvl);

    typeOpt = typeAnnotation.map(x ->
      this.normalize(subst, x, true, bindingName)
    );

    value match {
    | None() ->
      tcenvl.error(
        Array[(pos, "This declaration must have an initializer")],
        TSCode(1155),
      )
    | Some(e) ->
      tcenv = TCEnv::mcreate(subst, CGNode::toplevel(pos.fileName));
      valueType = this.expr(tcenv, e, true);
      if (typeAnnotation is Some(Type(_, TAUniqueSymbol()))) {
        e.value match {
        | Call(Expr(_, Var(Name(_, "Symbol"))), _, _) -> void
        | _ ->
          tcenvl.error(
            Array[
              (
                pos,
                "A 'unique symbol' type requires a 'Symbol()' call as its initializer",
              ),
            ],
            SKJSCode(2057),
          )
        }
      } else {
        typeOpt match {
        | None() -> !typeOpt = Some(valueType)
        | Some(type) ->
          this.checkSubType(
            tcenv,
            pos,
            "Type of initializer is not assignable to the declared type annotation",
            valueType,
            type,
            TSCode(2322),
          )
        }
      }
    };

    // Check if type is primitive
    typeOpt match {
    | Some(type) ->
      if (!type.isPrimitiveType(subst, this)) {
        tcenvl.error(
          Array[
            (
              pos,
              "The type of a top-level constant must be a primitive type, not an object",
            ),
          ],
          SKJSCode(2062),
        )
      }
    | _ -> void
    }
  }

  fun varDefs(
    tcenvl: mutable TCEnvLight,
    kind: VarDefKind,
    varDefs: Array<VarDef>,
  ): void {
    for (varDef in varDefs) {
      kind match {
      | VDKConst() -> void
      | VDKLet() -> tcenvl.notSupported(varDef.pat.pos, "toplevel let")
      | VDKVar() -> tcenvl.notSupported(varDef.pat.pos, "toplevel var")
      };
      // Check pattern is not destructuring first
      bindingName = varDef.pat.value match {
      | PVar(name) -> Some(name.value)
      | PArray _
      | PObject _ ->
        fatalError(
          Array[
            (
              varDef.pat.pos,
              "Top-level const declarations cannot use destructuring in SKJS\n" +
                "Declare a simple const (e.g. `const tmp = ...`) and perform the destructuring inside a block/function.",
            ),
          ],
          SKJSCode(1010),
        )
      };
      // Validate the const declaration
      this.validateToplevelConst(
        tcenvl,
        varDef.pat.pos,
        varDef.type,
        varDef.value,
        bindingName,
      )
    }
  }

  fun typeDef(tcenvl: mutable TCEnvLight, typeDef: TypeDef): void {
    static::checkTypeParams(
      tcenvl,
      typeDef.tdefParams,
      OptionalTypeParamsAllowed(),
    );
    // Before normalizing the body: an alias that requires itself denotes
    // nothing, and normalize resolves the cycle silently rather than reporting
    // it.
    this.checkCircularTypeDef(tcenvl, typeDef);

    subst = Subst::mcreate(tcenvl);
    !this = this.addTParams(subst, typeDef.tdefParams);
    !this.inTypeDefValidation = true;

    body = this.getTypeDefBody(tcenvl.context, typeDef);
    tcenvl.collectErrors(() -> _ = this.normalize(subst, body));
  }

  // Reports a type alias whose own definition requires resolving itself
  // (TS2456, issue #874). Such an alias denotes nothing: `instantiate` breaks
  // the recursion by handing back an unexpandable self-reference, which
  // contributes no clauses and so *is* the empty type. `type R = R` then
  // silently satisfies every annotation, and an ambient `declare` can assert a
  // value into it, so the mistake has to be caught at the declaration.
  //
  // A reference is *immediate* when computing the alias's own type forces the
  // referenced type to be computed too: the body itself, either side of a
  // union or intersection, the operand of `keyof`, and the type arguments of a
  // reference to another alias — instantiating an alias resolves its arguments
  // before substituting them, so `type Y = Box<Y>` is circular even though
  // `type Box<T> = { v: T }` never uses `T` immediately, and even where the
  // alias ignores the argument outright.
  //
  // Every other position is *deferred*: an object member, array element, tuple
  // element, or function parameter/return names the alias without resolving
  // it, which is what keeps `type List<T> = null | { head: T; tail: List<T> }`
  // legal. The type arguments of a class or interface reference are deferred
  // for the same reason, which is what separates `type Arr = Array<Arr>`
  // (legal) from `type Y = Box<Y>` (circular).
  //
  // Only a cycle that comes back to the alias under test is reported: in
  // `type X = Y; type Y = Z; type Z = Y;` resolving `X` reaches the circular
  // `Y`, but `X` is not itself on the cycle, and tsc reports only `Y` and `Z`.
  private fun checkCircularTypeDef(
    tcenvl: mutable TCEnvLight,
    typeDef: TypeDef,
  ): void {
    if (
      this.requiresTypeDef(
        tcenvl.context,
        typeDef,
        this.getTypeDefBody(tcenvl.context, typeDef),
        static::tparamNames(typeDef.tdefParams),
        mutable Set[],
      )
    ) {
      tcenvl.error(
        Array[
          (
            typeDef.name.pos,
            `Type alias '${typeDef.name.value}' circularly references itself`,
          ),
        ],
        TSCode(2456),
      )
    }
  }

  // Whether computing `ty` immediately requires the type alias `target`.
  //
  // Every name is resolved through the defMap, in the scope of the file that
  // wrote it, and compared to `target` by definition rather than by name: the
  // same name denotes different aliases in different files (`Json` is declared
  // in four of them), so matching on the name alone would report an alias that
  // merely forwards to a same-named one elsewhere as circular.
  //
  // `shadowed` holds the type parameters in scope at `ty`, which hide an alias
  // of the same name — in `type Bar<Foo> = Foo`, the body is the parameter,
  // not the alias `Foo`.
  //
  // `visited` records the alias bodies already explored, which both stops a
  // cycle that never reaches `target` from looping and keeps the walk linear.
  // It is shared across the whole walk rather than threaded down each path:
  // whether `target` is reachable from an alias does not depend on the path
  // taken to reach that alias, so an alias whose body has already been
  // explored without finding `target` cannot find it on a second visit. Per
  // path, the same body is re-explored once per path that reaches it, which is
  // exponential on a chain of alias unions (`type A0 = A1 | A1; ...`).
  //
  // The walk is purely syntactic — it never instantiates — so it terminates
  // even on bodies whose expansion would not.
  private fun requiresTypeDef(
    context: mutable SKStore.Context,
    target: TypeDef,
    ty: Type,
    shadowed: SortedSet<String>,
    visited: mutable Set<TypeDefBodyRef>,
  ): Bool {
    ty.value match {
    | TAUnion(ty1, ty2)
    | TAInter(ty1, ty2) ->
      this.requiresTypeDef(context, target, ty1, shadowed, visited) ||
        this.requiresTypeDef(context, target, ty2, shadowed, visited)
    // `keyof T` needs T's keys, so T is resolved. Its *members* are not, which
    // is why `type K = keyof { a: K }` stays legal: the object below defers.
    | TAKeyOf(operand) ->
      this.requiresTypeDef(context, target, operand, shadowed, visited)
    | TAInst(n, targs) ->
      if (shadowed.contains(n.value)) {
        // A type parameter of the alias being walked, not the alias itself.
        false
      } else {
        this.maybeGetTypeDef(context, n) match {
        | Some(td) ->
          if (td.bodyRef == target.bodyRef) {
            true
          } else {
            // The arguments are written in the current scope, so they keep
            // `shadowed`; the body is read in the callee's, so it takes the
            // callee's parameters instead.
            targs.any(targ ->
              this.requiresTypeDef(context, target, targ, shadowed, visited)
            ) ||
              (visited.maybeInsert(td.bodyRef) &&
                this.requiresTypeDef(
                  context,
                  target,
                  this.getTypeDefBody(context, td),
                  static::tparamNames(td.tdefParams),
                  visited,
                ))
          }
        // Not an alias: a class or interface reference defers its arguments,
        // and a name that does not resolve is normalize's to report.
        | None() -> false
        }
      }
    // Every remaining annotation defers, and a new one is far likelier to
    // defer than not: naming a type inside an object, array, tuple, or
    // signature does not resolve it. Three exceptions are immediate in tsc and
    // silent here only because SKJS rejects them before circularity could
    // matter — `TAGet` (`type R = R["x"]`), `TAExtendsQuestion`
    // (`type R = R extends string ? 1 : 2`) and `TAImport` are all "not yet
    // supported". Whichever of them lands first should be given an arm above
    // rather than left to this one.
    | _ -> false
    }
  }

  private static fun tparamNames(tparams: Array<TypeParam>): SortedSet<String> {
    tparams.reduce((names, tparam) -> names.set(tparam.name.value), SortedSet[])
  }

  static fun checkTypeParams(
    tcenvb: mutable TCEnvBase,
    tparams: Array<TypeParam>,
    optionalTypeParamsPermission: OptionalTypeParamsPermission,
  ): void {
    firstDefaultPosOpt: ?PosRange = None();
    for (tparam in tparams) {
      (tparam.default, firstDefaultPosOpt) match {
      | (Some _, None()) ->
        optionalTypeParamsPermission match {
        | OptionalTypeParamsForbidden() ->
          tcenvb.error(
            Array[
              (
                tparam.name.pos,
                "Optional type parameters are not supported for classes and functions",
              ),
            ],
            SKJSCode(2021),
          )
        | OptionalTypeParamsAllowed() -> void
        };
        !firstDefaultPosOpt = Some(tparam.name.pos)
      | (None(), Some(firstDefaultPos)) ->
        tcenvb.error(
          Array[
            (
              tparam.name.pos,
              "Required type parameters may not follow optional type parameters.",
            ),
            (firstDefaultPos, "First optional type parameter was here"),
          ],
          TSCode(2706),
        )
      | (None(), None())
      | (Some _, Some _) ->
        void
      }
    }
  }
}

fun checkUniqueSymbolReadonly(tcenvl: mutable TCEnvLight, t: Type): void {
  t.value match {
  | TAObject(fields) ->
    for (field in fields) {
      field match {
      | fd @ ObjectFieldValue _ ->
        fd.type match {
        | Some(
          Type(_, TAUniqueSymbol()),
        ) if (!(fd.readonly_ is Some(OFReadonly _))) ->
          tcenvl.error(
            Array[
              (
                fd.pos,
                "A property whose type is 'unique symbol' must be 'readonly'",
              ),
            ],
            TSCode(1331),
          )
        | _ -> void
        }
      | _ -> void
      }
    }
  | _ -> void
  }
}

module end;
