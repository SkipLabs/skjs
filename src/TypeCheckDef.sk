module SKJS;

base class OptionalTypeParamsPermission {
  children =
  | OptionalTypeParamsAllowed()
  | OptionalTypeParamsForbidden()
}

extension class TypeChecker {
  fun check(context: mutable SKStore.Context, defs: Array<Def>): Array<Error> {
    errors = mutable Vector[];
    for (def in defs) {
      if (this.backtrace) this.checkDef(context, def) else {
        try {
          this.checkDef(context, def)
        } catch {
        | ErrorExn(err) -> errors.push(err)
        | exn -> throw exn
        }
      }
    };
    errors.toArray()
  }

  fun checkDef(context: mutable SKStore.Context, def: Def): void {
    def.value match {
    | ExportImport _ -> notSupported(def.pos)
    | ImportExpr _ -> void
    | Global _ -> notSupported(def.pos)
    | ExportAs _ -> notSupported(def.pos)
    | ExportEq _ -> notSupported(def.pos)
    | Module _ -> notSupported(def.pos)
    | e @ Expr _ ->
      subst = Subst::mcreate{context};
      tcenv = TCEnv::mcreate(
        context,
        subst,
        CGNode::toplevel(def.pos.fileName),
      );
      ty = this.expr(tcenv, e);
      this.checkIsVoid(tcenv, e.pos, ty)
    | fd @ FunDef _ ->
      cgNode = fd.name match {
      | Some(name) -> CGNode::create(TopLevelFunDef(name, fd.pos.fileName))
      | None() -> CGNode::create(AnonymousFunDef(fd))
      };
      subst = Subst::mcreate{context};
      this.funDef(subst, None(), fd, cgNode)
    | Declare _
    | ExportDeclare _ ->
      void
    | Namespace _ -> notSupported(def.pos)
    | Export(d) -> this.checkDef(context, Def(def.pos, d))
    | ExportDefault _ -> notSupported(def.pos)
    | ExportNames _
    | ExportNamesFrom _ ->
      void
    | Import _ -> void
    | c @ Class _ -> this.class_(context, c)
    | Enum _ -> notSupported(def.pos)
    | VarDefs(kind, varDefs) -> this.varDefs(context, kind, varDefs)
    | td @ TypeDef _ -> this.typeDef(td)
    }
  }

  fun varDefs(
    context: mutable SKStore.Context,
    kind: VarDefKind,
    varDefs: Array<VarDef>,
  ): void {
    for (varDef in varDefs) {
      kind match {
      | VDKConst() -> void
      | VDKLet() -> notSupported(varDef.pat.pos, "toplevel let")
      | VDKVar() -> notSupported(varDef.pat.pos, "toplevel var")
      };
      literalType = varDef.value match {
      | None() -> None()
      | Some(x) -> this.asConstExpr(x)
      };
      type = varDef.type match {
      | None() ->
        literalType match {
        | Some(ty) -> ty
        | _ -> typingError(Array[(varDef.pat.pos, "Missing type annotation")])
        }
      | Some(x) -> this.tenv.normalize(context, x)
      };
      subst = Subst::mcreate{context};
      if (!type.isPrimitiveType(subst, this.tenv)) {
        typingError(
          Array[
            (
              varDef.pat.pos,
              "Invalid type for constant, " +
                "only primitive types (not objects) are allowed",
            ),
          ],
        );
      };
      varDef.pat.value match {
      | PVar _ -> void
      | PArray _
      | PObject _ ->
        typingError(
          Array[
            (
              varDef.pat.pos,
              "Construction not supported: top-level const declarations cannot destructure\n" +
                "Declare a simple const (e.g. `const tmp = ...`) and perform the destructuring inside a block/function.",
            ),
          ],
        )
      };
      e = varDef.value match {
      | None() -> typingError(Array[(varDef.pat.pos, "Missing definition")])
      | Some(x) -> x
      };
      tcenv = TCEnv::mcreate(
        context,
        subst,
        CGNode::toplevel(varDef.pat.pos.fileName),
      );
      this.checkSubType(
        tcenv,
        varDef.pat.pos,
        "Invalid definition",
        literalType match {
        | None() ->
          ty = this.expr(tcenv, e);
          ty
        | Some(litType) -> litType
        },
        type,
      )
    }
  }

  fun typeDef(typeDef: TypeDef): void {
    static::checkTypeParams(typeDef.tdefParams, OptionalTypeParamsAllowed())
  }

  static fun checkTypeParams(
    tparams: Array<TypeParam>,
    optionalTypeParamsPermission: OptionalTypeParamsPermission,
  ): void {
    firstDefaultPosOpt: ?PosRange = None();
    for (tparam in tparams) {
      (tparam.default, firstDefaultPosOpt) match {
      | (Some _, None()) ->
        optionalTypeParamsPermission match {
        | OptionalTypeParamsForbidden() ->
          typingError(
            Array[
              (
                tparam.name.pos,
                "Optional type parameters are not supported for classes and functions",
              ),
            ],
          )
        | OptionalTypeParamsAllowed() -> void
        };
        !firstDefaultPosOpt = Some(tparam.name.pos)
      | (None(), Some(firstDefaultPos)) ->
        typingError(
          Array[
            (
              tparam.name.pos,
              "Required type parameters may not follow optional type parameters.",
            ),
            (firstDefaultPos, "First optional type parameter was here"),
          ],
        )
      | (None(), None())
      | (Some _, Some _) ->
        void
      }
    }
  }
}

module end;
