/***************************************************************************/
/* Expression parsing methods for the TypeScript parser. */
/***************************************************************************/

module SKJS;

extension class Parser {
  /***************************************************************************/
  // Expression parsing
  //
  // <expr> ::=
  //   | <string-number>
  //   | <name>
  //   | ... <name>
  //   | <string-kind> <string>
  //   | typeof <expr>
  //   | keyof <type>
  //   | await <expr>
  //   | <expr> [ <expr> ]
  //   | new <name> ( <type>* ) ( <expr>* )
  //   | <unop> <expr>
  //   | <expr> <post-op>
  //   | <expr> <binop> <expr>
  //   | <expr> ( <type>* ) ( <expr>* )
  //   | ( (<name> (: <type>)?)* )
  //   | { <field>* }
  //   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>
  //   | [ <expr>* ]
  //   | <expr> ? <expr> : <expr>
  //   | <expr> instanceof <expr>
  //   | <expr> as const
  //   | <expr> as <type>
  //   | < <type> > <expr>
  //   | /<regexp>/
  //   | async <expr>
  /***************************************************************************/

  // Parse an expression with given precedence level
  mutable fun expr(prec: Int): Expr {
    inTypeCopy = this.lex.inType;
    this.lex.!inType = false;
    start = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(tok) -> tok.posStart
    };
    e_ = this.expr_(prec);
    end = this.lex.lastTok.fromSome().posEnd;
    this.lex.!inType = inTypeCopy;
    Expr(PosRange::create(this.lex, start, end), e_)
  }

  // Parse regular expression literals (/pattern/flags)
  // Handles escaped characters and flag parsing
  mutable fun parseRegexpExpr(): Expr_ {
    _ = this.lex.next();
    pos = this.lex.pos;
    loop {
      if (pos >= this.lex.contents.size()) {
        this.error(this.lex.posEnd(), UnterminatedExpr())
      };
      c = this.lex.contents[pos];
      if (c == '\\') {
        !pos = pos + 2;
        continue;
      };
      !pos = pos + 1;
      if (c == '/') break void;
    };
    loop {
      if (pos >= this.lex.contents.size()) {
        this.error(this.lex.posEnd(), UnterminatedExpr())
      };
      c = this.lex.contents[pos];
      if (
        c == 'g' ||
        c == 'i' ||
        c == 'm' ||
        c == 's' ||
        c == 'u' ||
        c == 'y'
      ) {
        !pos = pos + 1;
        continue;
      };
      break void
    };
    regexp = String::fromChars(this.lex.contents.slice(this.lex.pos, pos));
    this.lex.!pos = pos;
    Regexp(regexp)
  }

  // Parse array literal expressions [elem1, elem2, ...]
  // Handles empty arrays and trailing commas
  mutable fun parseArrayExpr(): Expr_ {
    if (this.lex.peekKind() is Some(TKCloseSquare())) {
      _ = this.lex.next();
      EArray(Array[])
    } else {
      values = mutable Vector[];
      loop {
        values.push(this.expr(0));
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseSquare() -> break EArray(values.toArray())
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseSquare())) {
            _ = this.lex.next();
            break EArray(values.toArray())
          }
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedToken(TKCloseSquare()),
          )
        }
      }
    }
  }

  // Parse object literal expressions {key: value, ...}
  // Handles empty objects, method definitions, and spread syntax
  mutable fun parseObjectExpr(): Expr_ {
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      Object(Array[])
    } else {
      fields = mutable Vector[];
      fields.push(this.field());
      loop {
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseCurly() -> break Object(fields.toArray())
        | TKSemi()
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseCurly())) {
            _ = this.lex.next();
            break Object(fields.toArray())
          } else {
            fields.push(this.field());
          }
        | _ ->
          this.error(this.lex.posStart(commaTok), ExpectedToken(TKCloseCurly()))
        }
      }
    }
  }

  // Parse parenthesized expressions and parameter lists
  // Handles: (expr), (param), (param: type), (param1, param2, ...)
  mutable fun parseParenExpr(): Expr_ {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      Params(Array[])
    } else {
      first = this.expr_(0);
      firstTypeOpt = if (this.lex.peekKind() is Some(TKColon())) {
        _ = this.lex.next();
        Some(this.type(0))
      } else {
        None()
      };
      commaTok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseParen() ->
        _ = this.lex.next();
        firstTypeOpt match {
        | None() -> first
        | Some _ ->
          firstName = first match {
          | Var(x) -> x
          | _ -> this.error(this.lex.posStart(commaTok), ExpectedVarName())
          };
          Params(Array[(firstName, firstTypeOpt)])
        }
      | TKComma() ->
        _ = this.lex.next();
        firstName = first match {
        | Var(x) -> x
        | _ -> this.error(this.lex.posStart(commaTok), ExpectedVarName())
        };
        params = mutable Vector[(firstName, firstTypeOpt)];
        loop {
          tok = this.lex.peek();
          e = this.expr(0) match {
          | Expr(_, Var(x)) -> x
          | Expr _ ->
            this.error(
              EPChar(this.lex.fileName, tok.fromSome().posStart),
              ExpectedVarName(),
            )
          };
          tyOpt = if (this.lex.peekKind() is Some(TKColon())) {
            _ = this.lex.next();
            Some(this.type(0))
          } else {
            None()
          };
          params.push((e, tyOpt));
          closeTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
          | Some(x) -> x
          };
          closeTok.kind match {
          | TKCloseParen() -> break void
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKCloseParen())) {
              _ = this.lex.next();
              break void;
            }
          | _ ->
            this.error(
              this.lex.posStart(closeTok),
              ExpectedToken(TKCloseParen()),
            )
          }
        };
        Params(params.toArray())
      | _ ->
        this.error(this.lex.posStart(commaTok), ExpectedToken(TKCloseParen()))
      }
    }
  }

  // Parse atomic expressions (literals, variables, unary operators)
  // Handles: numbers, strings, variables, typeof, await, new, unary ops
  mutable fun parseAtomicExpr(tok: Token): Expr_ {
    tok.kind match {
    | TKNumber() -> Number(this.lex.getStrTok(tok))
    | TKBigInt() -> BigInt(this.lex.getStrTok(tok))
    | TKTild() ->
      (_assoc, tildPrec) = precedence[TKTild()];
      Unop(UOTild(), this.expr(tildPrec))
    | TKDotDotDot() -> Spread(this.getName())
    | TKVar() ->
      str = this.lex.getStrTok(tok);
      str match {
      | "function" -> this.error(this.lex.posStart(tok), FunctionInExpr())
      | "new" ->
        name = this.getName();
        targs = if (this.lex.peekKind() is Some(TKLessThan())) {
          _ = this.lex.next();
          this.typeList()
        } else {
          Array[]
        };
        this.expect(TKOpenParen());
        args = this.arguments();
        New(name, targs, args)
      | "async" -> Async(this.expr(0))
      | "await" -> Await(this.expr(0))
      | "typeof" -> TypeOf(this.expr(typeOfPrec))
      | _ ->
        Var(Name(PosRange::create(this.lex, tok.posStart, tok.posEnd), str))
      }
    | TKQuote()
    | TKDoubleQuote() ->
      EString(this.lex.getStrTok(tok))
    | TKBackTick() -> this.parseTemplateLiteral(tok)
    | subTok @ TKAddition()
    | subTok @ TKSubtraction() ->
      (_assoc, bopPrec) = precedence[subTok];
      this.expr_(bopPrec)
    | subTok @ TKExclamationMark() ->
      (_, unopPrec) = precedence[subTok];
      Unop(UOExclamationMark(), this.expr(unopPrec))
    | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())
    }
  }

  // Internal expression parsing implementation
  // Parses primary expressions and then delegates to binary/postfix operator handling
  mutable fun expr_(prec: Int): Expr_ {
    tok = this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    left: Expr_ = tok.kind match {
    | TKOpenParen() -> this.parseParenExpr()
    | TKOpenCurly() -> this.parseObjectExpr()
    | TKOpenSquare() -> this.parseArrayExpr()
    | TKDivision() -> this.parseRegexpExpr()
    | TKLessThan() ->
      ty = this.type(0);
      this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(Token(TKGreaterThan(), _, _)) -> void
      | Some(unexpectedTok) ->
        this.error(
          this.lex.posStart(unexpectedTok),
          ExpectedToken(TKGreaterThan()),
        )
      };
      e = this.expr(prec);
      return As(e, ty)
    | _ -> this.parseAtomicExpr(tok)
    };

    this.parseBinaryAndPostfixOps(left, tok, prec)
  }

  // Handle binary operators with precedence climbing
  mutable fun tryParseBinaryOp(
    mutableLeft: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    (assoc, bopPrec) = precedence.maybeGet(binopTok.kind) match {
    | None() -> return None()
    | Some(x) -> x
    };
    binop = binopTok.kind.toBinop() match {
    | None() -> return None()
    | Some(x) -> x
    };
    if (bopPrec == prec) {
      leftPosRange = PosRange::create(
        this.lex,
        tok.posStart,
        this.lex.getLastPos(),
      );
      _ = this.lex.next();
      newLeft = assoc match {
      | ALeft() ->
        right = this.expr(prec + 1);
        Binop(binop, Expr(leftPosRange, mutableLeft), right)
      | ARight() ->
        Binop(binop, Expr(leftPosRange, mutableLeft), this.expr(prec))
      | ANonAssoc() ->
        this.error(
          this.lex.posStart(binopTok),
          NonAssociative(this.lex.getStrTok(binopTok)),
        )
      };
      Some(newLeft)
    } else if (bopPrec > prec) {
      leftPosRange = PosRange::create(
        this.lex,
        tok.posStart,
        this.lex.getLastPos(),
      );
      _ = this.lex.next();
      newLeft = Binop(
        binop,
        Expr(leftPosRange, mutableLeft),
        this.expr(bopPrec + 1),
      );
      Some(newLeft)
    } else {
      if (bopPrec >= prec) {
        internal_error("bopPrec should be less than prec")
      };
      None()
    }
  }

  // Handle closure syntax (: type => expr and => expr)
  mutable fun tryParseClosure(
    mutableLeft: Expr_,
    binopTok: Token,
    tok: Token,
  ): ?Expr_ {
    if (
      binopTok.kind is TKColon() &&
      this.lex.lookAhead(() -> {
        try {
          _ = this.lex.next();
          _ = this.type(0);
          this.lex.peekKind() is Some(TKClosure())
        } catch {
        | ErrorExn _ -> false
        | exn -> throw exn
        }
      })
    ) {
      _ = this.lex.next();
      rty = this.type(0);
      this.expect(TKClosure());
      params = mutableLeft match {
      | Params(params) -> params
      | Var(varName) -> Array[(varName, None())]
      | _ -> this.error(this.lex.posStart(tok), ExpectedParams())
      };
      closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
        CBBlock(this.blockOrStmt())
      } else {
        CBExpr(this.expr(0))
      };
      Some(Closure(params, Some(rty), closureBody))
    } else if (binopTok.kind is TKClosure()) {
      _ = this.lex.next();
      params = mutableLeft match {
      | Params(params) -> params
      | Var(varName) -> Array[(varName, None())]
      | _ -> this.error(this.lex.posStart(tok), ExpectedParams())
      };
      closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
        CBBlock(this.blockOrStmt())
      } else {
        CBExpr(this.expr(0))
      };
      Some(Closure(params, None(), closureBody))
    } else {
      None()
    }
  }

  // Handle type casting with 'as' keyword and 'as const' syntax
  mutable fun tryParseTypeCast(
    mutableLeft: Expr_,
    binopTok: Token,
    tok: Token,
  ): ?Expr_ {
    if (this.lex.isEqTok(binopTok, "as")) {
      leftPosRange = PosRange::create(
        this.lex,
        tok.posStart,
        this.lex.getLastPos(),
      );
      _ = this.lex.next();

      // Check if this is 'as const'
      if (this.lex.isEq("const")) {
        _ = this.lex.next(); // consume 'const'
        result = AsConst(Expr(leftPosRange, mutableLeft));
        Some(result)
      } else {
        ty = this.type(0);
        result = As(Expr(leftPosRange, mutableLeft), ty);
        loop {
          if (this.lex.isEq("as")) {
            _ = this.lex.next();
            type = this.type(0);
            !result = As(
              Expr(
                PosRange::create(this.lex, tok.posStart, this.lex.getLastPos()),
                result,
              ),
              type,
            );
          };
          break void;
        };
        Some(result)
      }
    } else {
      None()
    }
  }

  // Handle function calls with optional type arguments
  mutable fun tryParseFunctionCall(
    mutableLeft: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    hasTArgs = this.hasTArgs();
    if (binopTok.kind is TKOpenParen() || hasTArgs) {
      if (prec >= callPrec) return None();
      _ = this.lex.next();
      targs = mutable Vector[];
      if (hasTArgs) {
        loop {
          targs.push(this.type(0));
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
          | Some(tk) -> tk
          };
          commaTok.kind match {
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKGreaterThan())) {
              _ = this.lex.next();
              break void
            }
          | TKGreaterThan() -> break void
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedToken(TKGreaterThan()),
            )
          }
        };
        this.expect(TKOpenParen())
      };
      args = this.arguments();
      newLeft = Call(
        Expr(
          PosRange::create(this.lex, tok.posStart, this.lex.getLastPos()),
          mutableLeft,
        ),
        targs.toArray(),
        args,
      );
      Some(newLeft)
    } else {
      None()
    }
  }

  // Handle postfix operators (++, --, !)
  mutable fun tryParsePostfixOp(
    mutableLeft: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): (Bool, Expr_) {
    binopTok.kind match {
    | TKIncr() ->
      (_assoc, opPrec) = precedence[binopTok.kind];
      if (prec <= opPrec) {
        leftPosRange = PosRange::create(
          this.lex,
          tok.posStart,
          this.lex.getLastPos(),
        );
        _ = this.lex.next();
        (true, PostOp(POIncr(), Expr(leftPosRange, mutableLeft)))
      } else {
        (false, mutableLeft)
      }
    | TKDecr() ->
      (_assoc, opPrec) = precedence[binopTok.kind];
      if (prec <= opPrec) {
        leftPosRange = PosRange::create(
          this.lex,
          tok.posStart,
          this.lex.getLastPos(),
        );
        _ = this.lex.next();
        (true, PostOp(PODecr(), Expr(leftPosRange, mutableLeft)))
      } else {
        (false, mutableLeft)
      }
    | TKExclamationMark() ->
      (_assoc, opPrec) = precedence[TKIncr()];
      if (prec <= opPrec) {
        leftPosRange = PosRange::create(
          this.lex,
          tok.posStart,
          this.lex.getLastPos(),
        );
        _ = this.lex.next();
        (true, PostOp(POExcl(), Expr(leftPosRange, mutableLeft)))
      } else {
        (false, mutableLeft)
      }
    | _ -> (false, mutableLeft)
    }
  }

  // Handle binary and postfix operators with precedence
  // Processes: function calls, array access, binary ops, ternary, in, instanceof, as casts
  // Uses precedence climbing algorithm for correct operator associativity
  mutable fun parseBinaryAndPostfixOps(
    left: Expr_,
    tok: Token,
    prec: Int,
  ): Expr_ {
    mutableLeft = left;
    loop {
      binopTok = this.lex.peek() match {
      | None() -> return mutableLeft
      | Some(x) -> x
      };
      isIn = this.lex.isEqTok(binopTok, "in");
      if (isIn || this.lex.isEqTok(binopTok, "instanceof")) {
        (_assoc, opPrec) = in_and_instanceofPrec;
        if (prec <= opPrec) {
          leftPosRange = PosRange::create(
            this.lex,
            tok.posStart,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          rhs = this.expr(opPrec);
          lhs = Expr(leftPosRange, mutableLeft);
          !mutableLeft = if (isIn) In(lhs, rhs) else InstanceOf(lhs, rhs);
          continue;
        };
        return mutableLeft;
      };
      (postfixHandled, postfixResult) = this.tryParsePostfixOp(
        mutableLeft,
        binopTok,
        tok,
        prec,
      );
      if (postfixHandled) {
        !mutableLeft = postfixResult;
        return mutableLeft;
      };
      if (binopTok.kind is TKQuestionMark()) {
        (_assoc, opPrec) = precedence[binopTok.kind];
        if (prec <= opPrec) {
          leftPosRange = PosRange::create(
            this.lex,
            tok.posStart,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          e2 = this.expr(0);
          this.expect(TKColon());
          e3 = this.expr(opPrec);
          !mutableLeft = EIf(Expr(leftPosRange, mutableLeft), e2, e3);
        };
        return mutableLeft;
      };
      this.tryParseClosure(mutableLeft, binopTok, tok).each(closureResult ->
        !mutableLeft = closureResult
      );
      if (binopTok.kind is TKOpenSquare()) {
        if (prec >= callPrec) return mutableLeft;
        _ = this.lex.next();
        !mutableLeft = Get(
          Expr(
            PosRange::create(this.lex, tok.posStart, this.lex.getLastPos()),
            mutableLeft,
          ),
          this.expr(0),
        );
        this.expect(TKCloseSquare());
        continue;
      };
      this.tryParseFunctionCall(mutableLeft, binopTok, tok, prec) match {
      | None() -> void
      | Some(callResult) ->
        !mutableLeft = callResult;
        continue
      };
      if (binopTok.kind is TKEquality()) {
        this.error(this.lex.posStart(binopTok), DontUseEquality())
      };
      if (binopTok.kind is TKInequality()) {
        this.error(this.lex.posStart(binopTok), DontUseInequality())
      };
      this.tryParseTypeCast(mutableLeft, binopTok, tok) match {
      | None() -> void
      | Some(castResult) -> return castResult
      };
      this.tryParseBinaryOp(mutableLeft, binopTok, tok, prec) match {
      | None() -> void
      | Some(binaryResult) ->
        !mutableLeft = binaryResult;
        continue
      };
      return mutableLeft
    }
  }

  // Check if the current position starts with type arguments
  mutable fun hasTArgs(): Bool {
    this.lex.lookAhead(() -> {
      binopTok = this.lex.peek() match {
      | None() -> return false
      | Some(x) -> x
      };
      if (!(binopTok.kind is TKLessThan())) return false;
      try {
        _ = this.lex.next();
        loop {
          _ = this.type(0);
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
          | Some(tk) -> tk
          };
          commaTok.kind match {
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKGreaterThan())) {
              _ = this.lex.next();
              break void
            }
          | TKGreaterThan() -> break void
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedToken(TKGreaterThan()),
            )
          }
        };
        this.expect(TKOpenParen());
        true
      } catch {
      | ErrorExn _ -> false
      | exn -> throw exn
      }
    })
  }

  // Parse function call arguments
  mutable fun arguments(): Array<Expr> {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return Array[]
    };
    args = mutable Vector[];
    loop {
      args.push(this.expr(0));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseParen() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(this.lex.posStart(commaTok), ExpectedToken(TKCloseParen()))
      }
    };
    args.toArray()
  }

  // Parse object field in expression context
  mutable fun field(): Field {
    if (this.lex.peekKind() is Some(TKDotDotDot())) {
      _ = this.lex.next();
      e = this.expr(0);
      return FDSpread(e);
    };
    modifiers = this.modifiers{allowRemove => false};
    fieldGetSet = this.isGetSet();
    fieldNameTok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    fieldName = this.getNameOrStringOrInt();
    if (
      this.lex.peekKind() is Some(TKOpenParen()) ||
      this.lex.peekKind() is Some(TKLessThan())
    ) {
      return this.anonMethodDef(
        None(),
        modifiers,
        fieldGetSet,
        Some((fieldNameTok.posStart, FNNormal(fieldName))),
        true,
        None(),
        None(),
      )
    };
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    tok.kind match {
    | TKColon() ->
      _ = this.lex.next();
      FDNormal(fieldName, this.expr(0))
    | TKComma()
    | TKCloseCurly() ->
      FDNormal(fieldName, Expr(fieldName.pos, Var(fieldName)))
    | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKCloseCurly()))
    }
  }

  // Parse template literals with interpolation: `text ${expr} more text`
  mutable fun parseTemplateLiteral(tok: Token): Expr_ {
    rawContent = this.lex.getStrTok(tok);

    if (!rawContent.contains("${")) {
      // Simple template literal without interpolation
      return EString(rawContent)
    };

    // Parse template literal with interpolation by manipulating lexer position
    // The lexer has already consumed the entire template, but we can re-parse it

    parts = mutable Vector<String>[];
    expressions = mutable Vector<Expr>[];

    // Save current lexer position
    originalPos = this.lex.pos;
    originalLastTok = this.lex.lastTok;

    // Reset to start of template content (after opening backtick)
    templateStart = tok.posStart.value + 1; // Skip opening `
    templateEnd = tok.posEnd.value - 1; // Skip closing `
    this.lex.!pos = templateStart;
    this.lex.!lastTok = None();

    currentStart = templateStart;
    pos = templateStart;

    // Parse through the template content
    loop {
      if (pos >= templateEnd) break void;

      // Look for ${ pattern
      if (
        pos + 1 < templateEnd &&
        this.lex.contents[pos] == '$' &&
        this.lex.contents[pos + 1] == '{'
      ) {
        // Add string part before ${
        if (pos > currentStart) {
          part = String::fromChars(this.lex.contents.slice(currentStart, pos));
          parts.push(part);
        };

        // Skip ${
        !pos = pos + 2;
        this.lex.!pos = pos;

        // Find matching }
        braceCount = 1;
        exprStart = pos;
        loop {
          if (pos >= templateEnd) {
            this.error(
              EPChar(this.lex.fileName, tok.posStart),
              UnterminatedExpr(),
            );
          };
          c = this.lex.contents[pos];
          if (c == '{') !braceCount = braceCount + 1;
          if (c == '}') !braceCount = braceCount - 1;
          if (braceCount == 0) break void;
          !pos = pos + 1;
        };

        // Set lexer to parse the expression content
        this.lex.!pos = exprStart;
        expr = this.expr(0);
        expressions.push(expr);

        // Move past the closing }
        !pos = pos + 1;
        !currentStart = pos;
        this.lex.!pos = pos;
      } else {
        !pos = pos + 1;
      }
    };

    // Add final string part
    if (currentStart < templateEnd) {
      part = String::fromChars(
        this.lex.contents.slice(currentStart, templateEnd),
      );
      parts.push(part);
    };

    // Restore lexer position
    this.lex.!pos = originalPos;
    this.lex.!lastTok = originalLastTok;

    TemplateLiteral(parts.toArray(), expressions.toArray())
  }
}

module end;
