/***************************************************************************/
/* Expression parsing methods for the TypeScript parser. */
/***************************************************************************/

module SKJS;

extension class Parser {
  /***************************************************************************/
  // Expression parsing
  //
  // <expr> ::=
  //   | <string-number>
  //   | <name>
  //   | ... <expr>
  //   | <string-kind> <string>
  //   | typeof <expr>
  //   | keyof <type>
  //   | await <expr>
  //   | <expr> [ <expr> ]
  //   | new <name> ( <type>* ) ( <expr>* )
  //   | <unop> <expr>
  //   | <expr> <post-op>
  //   | <expr> <binop> <expr>
  //   | <expr> ( <type>* ) ( <expr>* )
  //   | ( (<name> (: <type>)?)* )
  //   | { <field>* }
  //   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>
  //   | [ <expr>* ]
  //   | <expr> ? <expr> : <expr>
  //   | <expr> instanceof <expr>
  //   | <expr> as const
  //   | <expr> as <type>
  //   | < <type> > <expr>
  //   | /<regexp>/
  //   | async <expr>
  /***************************************************************************/

  // Parse an expression with given precedence level
  mutable fun expr(prec: Int): Expr {
    inTypeCopy = this.lex.inType;
    this.lex.!inType = false;
    // Parses primary expressions and then delegates to binary/postfix operator handling
    lhs = this.parseBeginningOfExpr();
    res = this.parseBinaryAndPostfixOps(lhs, prec);
    this.lex.!inType = inTypeCopy;
    res
  }

  // Parse regular expression literals (/pattern/flags)
  // Handles escaped characters and flag parsing
  mutable fun parseRegexpExpr(): Expr_ {
    _ = this.lex.next();
    pos = this.lex.pos;
    loop {
      if (pos >= this.lex.contents.size()) {
        this.error(this.lex.posEnd(), UnterminatedExpr())
      };
      c = this.lex.contents[pos];
      if (c == '\\') {
        !pos = pos + 2;
        continue;
      };
      !pos = pos + 1;
      if (c == '/') break void;
    };
    loop {
      if (pos >= this.lex.contents.size()) {
        this.error(this.lex.posEnd(), UnterminatedExpr())
      };
      c = this.lex.contents[pos];
      if (
        c == 'g' ||
        c == 'i' ||
        c == 'm' ||
        c == 's' ||
        c == 'u' ||
        c == 'y'
      ) {
        !pos = pos + 1;
        continue;
      };
      break void
    };
    regexp = String::fromChars(this.lex.contents.slice(this.lex.pos, pos));
    this.lex.!pos = pos;
    Regexp(regexp)
  }

  // Parse array literal expressions [elem1, elem2, ...]
  // Handles empty arrays and trailing commas
  mutable fun parseArrayExpr(): Expr_ {
    values = mutable Vector[];
    if (this.lex.peekKind() is Some(TKCloseSquare())) {
      _ = this.lex.next();
    } else {
      loop {
        values.push(this.expr(0));
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseSquare() -> break void
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseSquare())) {
            _ = this.lex.next();
            break void
          }
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokens(Array[TKCloseSquare(), TKComma()]),
          )
        }
      }
    };
    EArray(values.toArray())
  }

  // Parse object literal expressions {key: value, ...}
  // Handles empty objects, method definitions, and spread syntax
  mutable fun parseObjectExpr(): Expr_ {
    fields = mutable Vector[];
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
    } else {
      loop {
        fields.push(this.field());
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseCurly() -> break void
        | TKSemi()
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseCurly())) {
            _ = this.lex.next();
            break void
          }
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokens(Array[TKCloseCurly(), TKSemi(), TKComma()]),
          )
        }
      }
    };
    Object(fields.toArray())
  }

  // Parse parenthesized expressions and parameter lists
  // Handles: (expr), (param), (param: type), (param1, param2, ...)
  mutable fun parseParenExpr(): Expr_ {
    this.lex.tryAhead(() -> {
      try {
        e = this.expr(0);
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          Some(e.value)
        } else {
          None()
        }
      } catch {
      | _ -> None()
      }
    }) match {
    | Some(e) -> e
    | None() -> Params(this.params())
    }
  }

  // Parse beginning of expressions
  mutable fun parseBeginningOfExpr(): Expr {
    tok = this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    e_ = tok.kind match {
    /* groups */
    | TKOpenParen() -> this.parseParenExpr()
    | TKOpenCurly() -> this.parseObjectExpr()
    | TKOpenSquare() -> this.parseArrayExpr()
    /* literals */
    | TKNumber() -> Number(this.getNumber(tok))
    | TKBigInt() -> BigInt(this.getBigInt(tok))
    | TKQuote()
    | TKDoubleQuote() ->
      EString(this.unquoteString(tok))
    | TKBackTick() -> this.parseTemplateLiteral(tok)
    | TKDivision() -> this.parseRegexpExpr()
    /* names / name-prefixes */
    | TKVar() ->
      this.getVar(tok) match {
      | "function" -> this.error(this.lex.posStart(tok), FunctionInExpr())
      | "new" ->
        subExpr = this.expr(callPrecHigh);
        targs = if (this.lex.peekKind() is Some(TKLessThan())) {
          _ = this.lex.next();
          this.typeList()
        } else {
          Array[]
        };
        this.expect(TKOpenParen());
        args = this.arguments();
        New(subExpr, targs, args)
      | "async" -> Async(this.expr(closurePrec))
      | "await" -> Await(this.expr(prefixPrec))
      | "typeof" -> TypeOf(this.expr(prefixPrec))
      | "void" -> VoidOp(this.expr(prefixPrec))
      | str -> Var(Name(this.lex.posRange(tok), str))
      }
    /* prefixes */
    | TKAddition() -> Unop(UOPlus(), this.expr(prefixPrec))
    | TKSubtraction() -> Unop(UOMinus(), this.expr(prefixPrec))
    | TKExclamationMark() -> Unop(UOExclamationMark(), this.expr(prefixPrec))
    | TKTild() -> Unop(UOTild(), this.expr(prefixPrec))
    | TKDotDotDot() -> Spread(this.expr(spreadPrec))
    /* generic arrow function <T>(params) => body,
       or old-style as cast <T>expr */
    | TKLessThan() ->
      this.lex.tryAhead(() -> {
        try {
          tparams = this.typeParams();
          this.expect(TKOpenParen());
          params = this.params();
          rty = if (this.lex.peekKind() is Some(TKColon())) {
            _ = this.lex.next();
            Some(this.type(0))
          } else {
            None()
          };
          if (this.lex.peekKind() is Some(TKClosure())) {
            _ = this.lex.next();
            closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
              CBBlock(this.blockOrStmt())
            } else {
              CBExpr(this.expr(closurePrec))
            };
            Some(Closure(tparams, params, rty, closureBody))
          } else {
            None()
          }
        } catch {
        | ErrorExn _ -> None()
        | exn -> throw exn
        }
      }) match {
      | Some(c) -> c
      | None() ->
        ty = this.type(0);
        this.expect(TKGreaterThan());
        e = this.expr(asPrec);
        As(e, ty)
      }
    | _ ->
      this.error(
        this.lex.posStart(tok),
        ExpectedTokens(
          Array[
            TKOpenParen(),
            TKOpenCurly(),
            TKOpenSquare(),
            TKNumber(),
            TKBigInt(),
            TKQuote(),
            TKDoubleQuote(),
            TKBackTick(),
            TKDivision(),
            TKVar(),
            TKAddition(),
            TKSubtraction(),
            TKExclamationMark(),
            TKTild(),
            TKDotDotDot(),
            TKLessThan(),
          ],
        ),
      )
    };
    Expr(this.lex.posRangeFrom(tok), e_);
  }

  // Handle binary operators with precedence climbing
  mutable fun tryParseBinaryOp(left: Expr, binopTok: Token, prec: Int): ?Expr_ {
    (assoc, bopPrec, binop) = binaryOperators.maybeGet(binopTok.kind) match {
    | None() -> return None()
    | Some(x) -> x
    };
    if (prec > bopPrec) return None();
    _ = this.lex.next();
    newMinPrec = assoc match {
    | ALeft() -> bopPrec + 1
    | ARight() -> bopPrec
    };
    right = this.expr(newMinPrec);
    Some(Binop(binop, left, right))
  }

  // Handle closure syntax (: type => expr and => expr)
  mutable fun tryParseClosure(left: Expr, binopTok: Token, prec: Int): ?Expr_ {
    if (prec > closurePrec) {
      return None()
    };
    rty = if (binopTok.kind is TKColon()) {
      rty = this.lex.tryAhead(() -> {
        _ = this.lex.next();
        try {
          rty = this.type(0);
          this.expect(TKClosure());
          Some(rty)
        } catch {
        | ErrorExn _ -> None()
        | exn -> throw exn
        }
      });
      if (rty is None()) return None();
      rty
    } else if (binopTok.kind is TKClosure()) {
      _ = this.lex.next();
      None()
    } else {
      return None()
    };
    params = exprToParams(left) match {
    | None() -> return None()
    | Some(p) -> p
    };
    closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
      CBBlock(this.blockOrStmt())
    } else {
      CBExpr(this.expr(closurePrec))
    };
    Some(Closure(Array[], params, rty, closureBody))
  }

  // Handle type casting with 'as' keyword, 'as const' syntax, and 'satisfies'
  mutable fun tryParseTypeCast(left: Expr, binopTok: Token, prec: Int): ?Expr_ {
    if (prec > asPrec) return None();
    if (this.lex.isEqTok(binopTok, "as")) {
      _ = this.lex.next();
      if (this.lex.isEq("const")) {
        _ = this.lex.next();
        Some(AsConst(left))
      } else {
        ty = this.type(0);
        Some(As(left, ty))
      }
    } else if (this.lex.isEqTok(binopTok, "satisfies")) {
      _ = this.lex.next();
      ty = this.type(0);
      Some(Satisfies(left, ty))
    } else {
      None()
    }
  }

  // Handle function calls with optional type arguments
  mutable fun tryParseFunctionCall(
    left: Expr,
    binopTok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec > callPrecLow) return None();
    targsOpt = if (binopTok.kind is TKOpenParen()) {
      _ = this.lex.next();
      Some(Array[])
    } else if (binopTok.kind is TKLessThan()) {
      this.lex.tryAhead(() -> {
        _ = this.lex.next();
        targs = mutable Vector[];
        try {
          if (
            loop {
              targs.push(this.type(0));
              this.lex.next().map(tok -> tok.kind) match {
              | Some(TKComma()) ->
                if (this.lex.peekKind() is Some(TKGreaterThan())) {
                  _ = this.lex.next();
                  break true
                }
              | Some(TKGreaterThan()) -> break true
              | _ -> break false
              }
            }
          ) {
            this.expect(TKOpenParen());
            Some(targs.toArray())
          } else {
            None()
          }
        } catch {
        | ErrorExn _ -> None()
        | exn -> throw exn
        }
      })
    } else {
      None()
    };
    targsOpt.map(targs -> {
      args = this.arguments();
      Call(left, targs, args)
    })
  }

  // Handle postfix operators (++, --, !)
  mutable fun tryParsePostfixOp(
    left: Expr,
    binopTok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec > postfixPrec) return None();
    op = binopTok.kind match {
    | TKIncr() -> POIncr()
    | TKDecr() -> PODecr()
    | TKExclamationMark() -> POExcl()
    | _ -> return None()
    };
    _ = this.lex.next();
    Some(PostOp(op, left))
  }

  // Handle in and instanceof
  mutable fun tryParseInAndInstanceOf(
    left: Expr,
    binopTok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec > in_and_instanceofPrec) return None();
    isIn = this.lex.isEqTok(binopTok, "in");
    if (!isIn && !this.lex.isEqTok(binopTok, "instanceof")) return None();
    _ = this.lex.next();
    rhs = this.expr(in_and_instanceofPrec);
    Some(if (isIn) In(left, rhs) else InstanceOf(left, rhs))
  }

  // Handle x ? y : z
  mutable fun tryParseTernary(left: Expr, binopTok: Token, prec: Int): ?Expr_ {
    if (prec > ternaryPrec) return None();
    if (!(binopTok.kind is TKQuestionMark())) return None();
    _ = this.lex.next();
    e2 = this.expr(0);
    this.expect(TKColon());
    e3 = this.expr(ternaryPrec);
    Some(EIf(left, e2, e3))
  }

  // Handle x[y], x.y, x?.y
  mutable fun tryParseAccess(left: Expr, binopTok: Token, prec: Int): ?Expr_ {
    if (prec > callPrecHigh) return None();
    dotOp = binopTok.kind match {
    | TKOpenSquare() ->
      _ = this.lex.next();
      rhs = this.expr(0);
      this.expect(TKCloseSquare());
      return Some(Get(left, rhs))
    | TKDot() -> NormalDot()
    | TKQuestionMarkDot() -> OptionalDot()
    | _ -> return None()
    };
    _ = this.lex.next();
    Some(Dot(dotOp, left, this.getName()))
  }

  // Handle binary and postfix operators with precedence
  // Processes: function calls, array access, binary ops, ternary, in, instanceof, as casts
  // Uses precedence climbing algorithm for correct operator associativity
  mutable fun parseBinaryAndPostfixOps(left: Expr, prec: Int): Expr {
    binopTok = this.lex.peek() match {
    | None() -> return left
    | Some(x) -> x
    };
    if (binopTok.kind is TKEquality()) {
      this.error(this.lex.posStart(binopTok), DontUseEquality())
    };
    if (binopTok.kind is TKInequality()) {
      this.error(this.lex.posStart(binopTok), DontUseInequality())
    };
    for (tryParse in Array[
      this.tryParseAccess,
      this.tryParseFunctionCall,
      this.tryParsePostfixOp,
      this.tryParseTypeCast,
      this.tryParseInAndInstanceOf,
      this.tryParseTernary,
      this.tryParseClosure,
      this.tryParseBinaryOp,
    ]) {
      tryParse(left, binopTok, prec) match {
      | None() -> void
      | Some(newLeft) ->
        pos = left.pos.extendWithPos(this.lex, this.lex.getLastPos());
        newLeftExpr = Expr(pos, newLeft);
        return this.parseBinaryAndPostfixOps(newLeftExpr, prec)
      };
    };
    left
  }

  // Parse function call arguments
  mutable fun arguments(): Array<Expr> {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return Array[]
    };
    args = mutable Vector[];
    loop {
      args.push(this.expr(0));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseParen() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokens(Array[TKCloseParen(), TKComma()]),
        )
      }
    };
    args.toArray()
  }

  // Parse field name: identifier, string, number, or [expr] for computed keys
  mutable fun getFieldNameOrComputed(): SimpleFieldName {
    if (this.lex.peekKind() is Some(TKOpenSquare())) {
      _ = this.lex.next(); // consume [
      keyExpr = this.expr(0);
      this.expect(TKCloseSquare());
      return FNComputed(keyExpr)
    };
    FNNormal(this.getNameOrStringOrNumber())
  }

  // Parse object field in expression context
  mutable fun field(): Field {
    if (this.lex.peekKind() is Some(TKDotDotDot())) {
      _ = this.lex.next();
      e = this.expr(0);
      return FDSpread(e);
    };
    modifiers = this.modifiers();
    fieldGetSet = this.isGetSet();
    fieldNameOrComputed = this.getFieldNameOrComputed();

    // Handle method definitions
    if (
      this.lex.peekKind() is Some(TKOpenParen()) ||
      this.lex.peekKind() is Some(TKLessThan())
    ) {
      fieldNameOrComputed match {
      | FNNormal(fieldName) ->
        return this.methodDef(
          {tparams, params, retType, body} ->
            FDMethod{
              isAsync => None(),
              modifiers,
              isGetSet => fieldGetSet,
              name => FNNormal(fieldName),
              optional => None(),
              sig => FSInline(tparams, params, retType),
              body => FBInline(body),
              cgNode => None(),
            },
          FNNormal(fieldName),
          true,
        )
      | FNComputed(keyExpr) ->
        this.error(EPRange(keyExpr.pos), ComputedMethodNameNotSupported())
      }
    };

    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    if (fieldGetSet.isSome()) {
      this.error(this.lex.posStart(tok), ExpectedAccessorDefinition())
    };

    // Handle value fields
    fieldNameOrComputed match {
    | FNNormal(fieldName) ->
      tok.kind match {
      | TKColon() ->
        _ = this.lex.next();
        FDNormal(fieldName, this.expr(0))
      | TKComma()
      | TKCloseCurly() ->
        FDNormal(fieldName, Expr(fieldName.pos, Var(fieldName)))
      | _ ->
        this.error(
          this.lex.posStart(tok),
          ExpectedTokens(Array[TKCloseCurly(), TKColon(), TKComma()]),
        )
      }
    | FNComputed(keyExpr) ->
      tok.kind match {
      | TKColon() ->
        _ = this.lex.next();
        FDComputed(keyExpr, this.expr(0))
      | _ ->
        this.error(this.lex.posStart(tok), ExpectedTokens(Array[TKColon()]))
      }
    }
  }

  // Parse template literals with interpolation: `text ${expr} more text`
  mutable fun parseTemplateLiteral(tok: Token): Expr_ {
    invariant(
      tok.kind is TKBackTick(),
      "parseTemplateLiteral expects a TKBackTick",
    );

    rawContent = this.lex.getTokenRawStringContent(tok);

    if (!rawContent.contains("${")) {
      // Simple template literal without interpolation
      return EString(rawContent.stripPrefix("`").stripSuffix("`"))
    };

    // Parse template literal with interpolation by manipulating lexer position
    // The lexer has already consumed the entire template, but we can re-parse it

    parts = mutable Vector<String>[];
    expressions = mutable Vector<Expr>[];

    // Save current lexer position
    originalPos = this.lex.pos;
    originalLastTok = this.lex.lastTok;

    // Reset to start of template content (after opening backtick)
    templateStart = tok.posStart.value + 1; // Skip opening `
    templateEnd = tok.posEnd.value - 1; // Skip closing `
    this.lex.!pos = templateStart;
    this.lex.!lastTok = None();

    currentStart = templateStart;
    pos = templateStart;

    // Parse through the template content
    loop {
      if (pos >= templateEnd) break void;

      // Look for ${ pattern
      if (
        pos + 1 < templateEnd &&
        this.lex.contents[pos] == '$' &&
        this.lex.contents[pos + 1] == '{'
      ) {
        // Add string part before ${
        if (pos > currentStart) {
          part = String::fromChars(this.lex.contents.slice(currentStart, pos));
          parts.push(part);
        };

        // Skip ${
        !pos = pos + 2;
        this.lex.!pos = pos;

        // Find matching }
        braceCount = 1;
        exprStart = pos;
        loop {
          if (pos >= templateEnd) {
            this.error(
              EPChar(this.lex.fileName, tok.posStart),
              UnterminatedExpr(),
            );
          };
          c = this.lex.contents[pos];
          if (c == '{') !braceCount = braceCount + 1;
          if (c == '}') !braceCount = braceCount - 1;
          if (braceCount == 0) break void;
          !pos = pos + 1;
        };

        // Set lexer to parse the expression content
        this.lex.!pos = exprStart;
        expr = this.expr(0);
        expressions.push(expr);

        // Move past the closing }
        !pos = pos + 1;
        !currentStart = pos;
        this.lex.!pos = pos;
      } else {
        !pos = pos + 1;
      }
    };

    // Add final string part
    if (currentStart < templateEnd) {
      part = String::fromChars(
        this.lex.contents.slice(currentStart, templateEnd),
      );
      parts.push(part);
    };

    // Restore lexer position
    this.lex.!pos = originalPos;
    this.lex.!lastTok = originalLastTok;

    TemplateLiteral(parts.toArray(), expressions.toArray())
  }
}

// Convert an expression parsed in parentheses to a pattern for arrow
// function destructuring parameters: ([a, b]) => ... or ({x, y}) => ...
fun exprToPattern(e: Expr): ?Pattern {
  pat = e.value match {
  | Var(name) -> PVar(name)
  | EArray(elements) ->
    patElements = mutable Vector[];
    rest = for (i => ae in elements) {
      (lhs, default) = ae.value match {
      | Spread(Expr(_, Var(spreadName))) if (i == elements.size() - 1) ->
        break Some(spreadName)
      | Binop(BOAssignment(), lhs, rhs) -> (lhs, Some(rhs))
      | _ -> (ae, None())
      };
      exprToPattern(lhs) match {
      | None() -> return None()
      | Some(p) -> patElements.push(Some((p, default)))
      }
    } else {
      None()
    };
    PArray(patElements.toArray(), rest)
  | Object(fields) ->
    patFields = mutable Vector[];
    rest = for (i => field in fields) {
      field match {
      | FDSpread(Expr(_, Var(spreadName))) if (i == fields.size() - 1) ->
        break Some(spreadName)
      | FDNormal(name, value) ->
        (v, default) = value.value match {
        | Binop(BOAssignment(), lhs, rhs) -> (lhs, Some(rhs))
        | _ -> (value, None())
        };
        exprToPattern(v) match {
        | None() -> return None()
        | Some(f) -> patFields.push((name, f, default))
        }
      | FDSpread _
      | FDComputed _
      | FDMethod _ ->
        return None()
      }
    } else {
      None()
    };
    PObject{fields => patFields.toArray(), rest}
  | _ -> return None()
  };
  Some(Pattern(e.pos, pat))
}

fun exprToParam(e: Expr): ?Param {
  e.value match {
  | Spread(spread) ->
    exprToParam(spread).flatMap(param ->
      if (param.isRest is Some _) None() else {
        Some(param with {isRest => Some(spread.pos)})
      }
    )
  | Binop(BOAssignment(), lhs, rhs) ->
    exprToParam(lhs).flatMap(param ->
      if (param.default is Some _) None() else {
        Some(param with {default => Some(rhs)})
      }
    )
  | _ ->
    exprToPattern(e).map(p ->
      Param(e.pos, Modifiers::empty(), None(), p, None(), None(), None())
    )
  }
}

fun exprToParams(e: Expr): ?Array<Param> {
  e.value match {
  | Params(params) -> Some(params)
  | _ -> exprToParam(e).map(p -> Array[p])
  }
}

module end;
