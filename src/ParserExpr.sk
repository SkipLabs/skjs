/***************************************************************************/
/* Expression parsing methods for the TypeScript parser. */
/***************************************************************************/

module SKJS;

extension class Parser {
  /***************************************************************************/
  // Expression parsing
  //
  // <expr> ::=
  //   | <string-number>
  //   | <name>
  //   | ... <name>
  //   | <string-kind> <string>
  //   | typeof <expr>
  //   | keyof <type>
  //   | await <expr>
  //   | <expr> [ <expr> ]
  //   | new <name> ( <type>* ) ( <expr>* )
  //   | <unop> <expr>
  //   | <expr> <post-op>
  //   | <expr> <binop> <expr>
  //   | <expr> ( <type>* ) ( <expr>* )
  //   | ( (<name> (: <type>)?)* )
  //   | { <field>* }
  //   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>
  //   | [ <expr>* ]
  //   | <expr> ? <expr> : <expr>
  //   | <expr> instanceof <expr>
  //   | <expr> as const
  //   | <expr> as <type>
  //   | < <type> > <expr>
  //   | /<regexp>/
  //   | async <expr>
  /***************************************************************************/

  // Parse an expression with given precedence level
  mutable fun expr(prec: Int): Expr {
    inTypeCopy = this.lex.inType;
    this.lex.!inType = false;
    (pos, e) = this.withPos(() -> this.expr_(prec), UnterminatedExpr());
    this.lex.!inType = inTypeCopy;
    Expr(pos, e)
  }

  // Parse regular expression literals (/pattern/flags)
  // Handles escaped characters and flag parsing
  mutable fun parseRegexpExpr(): Expr_ {
    _ = this.lex.next();
    pos = this.lex.pos;
    loop {
      if (pos >= this.lex.contents.size()) {
        this.error(this.lex.posEnd(), UnterminatedExpr())
      };
      c = this.lex.contents[pos];
      if (c == '\\') {
        !pos = pos + 2;
        continue;
      };
      !pos = pos + 1;
      if (c == '/') break void;
    };
    loop {
      if (pos >= this.lex.contents.size()) {
        this.error(this.lex.posEnd(), UnterminatedExpr())
      };
      c = this.lex.contents[pos];
      if (
        c == 'g' ||
        c == 'i' ||
        c == 'm' ||
        c == 's' ||
        c == 'u' ||
        c == 'y'
      ) {
        !pos = pos + 1;
        continue;
      };
      break void
    };
    regexp = String::fromChars(this.lex.contents.slice(this.lex.pos, pos));
    this.lex.!pos = pos;
    Regexp(regexp)
  }

  // Parse array literal expressions [elem1, elem2, ...]
  // Handles empty arrays and trailing commas
  mutable fun parseArrayExpr(): Expr_ {
    if (this.lex.peekKind() is Some(TKCloseSquare())) {
      _ = this.lex.next();
      EArray(Array[])
    } else {
      values = mutable Vector[];
      loop {
        values.push(this.expr(0));
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseSquare() -> break EArray(values.toArray())
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseSquare())) {
            _ = this.lex.next();
            break EArray(values.toArray())
          }
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokens(Array[TKCloseSquare(), TKComma()]),
          )
        }
      }
    }
  }

  // Parse object literal expressions {key: value, ...}
  // Handles empty objects, method definitions, and spread syntax
  mutable fun parseObjectExpr(): Expr_ {
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      Object(Array[])
    } else {
      fields = mutable Vector[];
      fields.push(this.field());
      loop {
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseCurly() -> break Object(fields.toArray())
        | TKSemi()
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseCurly())) {
            _ = this.lex.next();
            break Object(fields.toArray())
          } else {
            fields.push(this.field());
          }
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokens(Array[TKCloseCurly(), TKSemi(), TKComma()]),
          )
        }
      }
    }
  }

  // Parse parenthesized expressions and parameter lists
  // Handles: (expr), (param), (param: type), (param1, param2, ...)
  mutable fun parseParenExpr(): Expr_ {
    firstTok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    if (firstTok.kind is TKCloseParen()) {
      _ = this.lex.next();
      return Params(Array[])
    };
    first = this.expr_(0);
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return first
    };
    firstName = first match {
    | Var(x) -> x
    | _ -> this.error(this.lex.posStart(firstTok), ExpectedVarName())
    };
    firstTypeOpt = if (this.lex.peekKind() is Some(TKColon())) {
      _ = this.lex.next();
      Some(this.type(0))
    } else {
      None()
    };
    commaTok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    commaTok.kind match {
    | TKCloseParen() ->
      _ = this.lex.next();
      invariant(firstTypeOpt is Some _);
      Params(Array[(firstName, firstTypeOpt)])
    | TKComma() ->
      _ = this.lex.next();
      params = mutable Vector[(firstName, firstTypeOpt)];
      loop {
        tok = this.lex.peek();
        e = this.expr(0) match {
        | Expr(_, Var(x)) -> x
        | Expr _ ->
          this.error(
            EPChar(this.lex.fileName, tok.fromSome().posStart),
            ExpectedVarName(),
          )
        };
        tyOpt = if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          Some(this.type(0))
        } else {
          None()
        };
        params.push((e, tyOpt));
        closeTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        closeTok.kind match {
        | TKCloseParen() -> break void
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseParen())) {
            _ = this.lex.next();
            break void;
          }
        | _ ->
          this.error(
            this.lex.posStart(closeTok),
            ExpectedTokens(Array[TKCloseParen(), TKComma()]),
          )
        }
      };
      Params(params.toArray())
    | _ ->
      this.error(
        this.lex.posStart(commaTok),
        ExpectedTokens(Array[TKCloseParen(), TKComma()]),
      )
    }
  }

  // Parse atomic expressions (literals, variables, unary operators)
  // Handles: numbers, strings, variables, prefix operators
  mutable fun parseAtomicExpr(tok: Token): Expr_ {
    tok.kind match {
    | TKNumber() -> Number(this.getNumber(tok))
    | TKBigInt() -> BigInt(this.getBigInt(tok))
    | TKQuote()
    | TKDoubleQuote() ->
      EString(this.unquoteString(tok))
    | TKBackTick() -> this.parseTemplateLiteral(tok)
    | TKVar() ->
      this.getVar(tok) match {
      | "function" -> this.error(this.lex.posStart(tok), FunctionInExpr())
      | "new" ->
        name = this.getName();
        targs = if (this.lex.peekKind() is Some(TKLessThan())) {
          _ = this.lex.next();
          this.typeList()
        } else {
          Array[]
        };
        this.expect(TKOpenParen());
        args = this.arguments();
        New(name, targs, args)
      | "async" -> Async(this.expr(closurePrec))
      | "await" -> Await(this.expr(prefixPrec))
      | "typeof" -> TypeOf(this.expr(prefixPrec))
      | str -> Var(Name(this.lex.posRange(tok), str))
      }
    | TKAddition() -> Unop(UOPlus(), this.expr(prefixPrec))
    | TKSubtraction() -> Unop(UOMinus(), this.expr(prefixPrec))
    | TKExclamationMark() -> Unop(UOExclamationMark(), this.expr(prefixPrec))
    | TKTild() -> Unop(UOTild(), this.expr(prefixPrec))
    | TKDotDotDot() -> Spread(this.getName())
    | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())
    }
  }

  // Internal expression parsing implementation
  // Parses primary expressions and then delegates to binary/postfix operator handling
  mutable fun expr_(prec: Int): Expr_ {
    tok = this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    left: Expr_ = tok.kind match {
    | TKOpenParen() -> this.parseParenExpr()
    | TKOpenCurly() -> this.parseObjectExpr()
    | TKOpenSquare() -> this.parseArrayExpr()
    | TKDivision() -> this.parseRegexpExpr()
    | TKLessThan() ->
      ty = this.type(0);
      this.expect(TKGreaterThan());
      e = this.expr(prec);
      return As(e, ty)
    | _ -> this.parseAtomicExpr(tok)
    };

    this.parseBinaryAndPostfixOps(left, tok, prec)
  }

  // Handle binary operators with precedence climbing
  mutable fun tryParseBinaryOp(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    (assoc, bopPrec, binop) = binaryOperators.maybeGet(binopTok.kind) match {
    | None() -> return None()
    | Some(x) -> x
    };
    if (bopPrec == prec) {
      leftPosRange = this.lex.posRangeFrom(tok);
      _ = this.lex.next();
      newLeft = assoc match {
      | ALeft() ->
        right = this.expr(prec + 1);
        Binop(binop, Expr(leftPosRange, left), right)
      | ARight() -> Binop(binop, Expr(leftPosRange, left), this.expr(prec))
      };
      Some(newLeft)
    } else if (bopPrec > prec) {
      leftPosRange = this.lex.posRangeFrom(tok);
      _ = this.lex.next();
      newLeft = Binop(binop, Expr(leftPosRange, left), this.expr(bopPrec + 1));
      Some(newLeft)
    } else {
      if (bopPrec >= prec) {
        internal_error("bopPrec should be less than prec")
      };
      None()
    }
  }

  // Handle closure syntax (: type => expr and => expr)
  mutable fun tryParseClosure(
    left: Expr_,
    binopTok: Token,
    _tok: Token,
    prec: Int,
  ): ?Expr_ {
    params = left match {
    | Params(params) -> params
    | Var(varName) -> Array[(varName, None())]
    | _ -> return None()
    };
    rty = if (binopTok.kind is TKColon()) {
      rty = this.lex.tryAhead(() -> {
        _ = this.lex.next();
        try {
          rty = this.type(0);
          this.expect(TKClosure());
          Some(rty)
        } catch {
        | ErrorExn _ -> None()
        | exn -> throw exn
        }
      });
      if (rty is None()) return None();
      rty
    } else if (prec <= closurePrec && binopTok.kind is TKClosure()) {
      _ = this.lex.next();
      None()
    } else {
      return None()
    };
    closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
      CBBlock(this.blockOrStmt())
    } else {
      CBExpr(this.expr(closurePrec))
    };
    Some(Closure(params, rty, closureBody))
  }

  // Handle type casting with 'as' keyword and 'as const' syntax
  mutable fun tryParseTypeCast(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec >= asPrec) return None();
    if (!this.lex.isEqTok(binopTok, "as")) return None();
    leftPosRange = this.lex.posRangeFrom(tok);
    _ = this.lex.next();
    if (this.lex.isEq("const")) {
      _ = this.lex.next();
      Some(AsConst(Expr(leftPosRange, left)))
    } else {
      ty = this.type(0);
      Some(As(Expr(leftPosRange, left), ty))
    }
  }

  // Handle function calls with optional type arguments
  mutable fun tryParseFunctionCall(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec >= callPrec) return None();
    targsOpt = if (binopTok.kind is TKOpenParen()) {
      _ = this.lex.next();
      Some(Array[])
    } else if (binopTok.kind is TKLessThan()) {
      this.lex.tryAhead(() -> {
        _ = this.lex.next();
        targs = mutable Vector[];
        try {
          if (
            loop {
              targs.push(this.type(0));
              this.lex.next().map(tok -> tok.kind) match {
              | Some(TKComma()) ->
                if (this.lex.peekKind() is Some(TKGreaterThan())) {
                  _ = this.lex.next();
                  break true
                }
              | Some(TKGreaterThan()) -> break true
              | _ -> break false
              }
            }
          ) {
            this.expect(TKOpenParen());
            Some(targs.toArray())
          } else {
            None()
          }
        } catch {
        | ErrorExn _ -> None()
        | exn -> throw exn
        }
      })
    } else {
      None()
    };
    targsOpt.map(targs -> {
      args = this.arguments();
      Call(Expr(this.lex.posRangeFrom(tok), left), targs, args)
    })
  }

  // Handle postfix operators (++, --, !)
  mutable fun tryParsePostfixOp(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec > postfixPrec) return None();
    op = binopTok.kind match {
    | TKIncr() -> POIncr()
    | TKDecr() -> PODecr()
    | TKExclamationMark() -> POExcl()
    | _ -> return None()
    };
    leftPosRange = this.lex.posRangeFrom(tok);
    _ = this.lex.next();
    Some(PostOp(op, Expr(leftPosRange, left)))
  }

  // Handle in and instanceof
  mutable fun tryParseInAndInstanceOf(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec > in_and_instanceofPrec) return None();
    isIn = this.lex.isEqTok(binopTok, "in");
    if (!isIn && !this.lex.isEqTok(binopTok, "instanceof")) return None();
    _ = this.lex.next();
    leftPosRange = this.lex.posRangeFrom(tok);
    lhs = Expr(leftPosRange, left);
    rhs = this.expr(in_and_instanceofPrec);
    Some(if (isIn) In(lhs, rhs) else InstanceOf(lhs, rhs))
  }

  // Handle x ? y : z
  mutable fun tryParseTernary(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    if (prec > ternaryPrec) return None();
    if (!(binopTok.kind is TKQuestionMark())) return None();
    leftPosRange = this.lex.posRangeFrom(tok);
    _ = this.lex.next();
    e2 = this.expr(0);
    this.expect(TKColon());
    e3 = this.expr(ternaryPrec);
    Some(EIf(Expr(leftPosRange, left), e2, e3))
  }

  // Handle x[y]
  mutable fun tryParseAccess(
    left: Expr_,
    binopTok: Token,
    tok: Token,
    prec: Int,
  ): ?Expr_ {
    if (!(binopTok.kind is TKOpenSquare())) return None();
    if (prec >= callPrec) return None();
    _ = this.lex.next();
    lhs = Expr(this.lex.posRangeFrom(tok), left);
    rhs = this.expr(0);
    this.expect(TKCloseSquare());
    Some(Get(lhs, rhs))
  }

  // Handle binary and postfix operators with precedence
  // Processes: function calls, array access, binary ops, ternary, in, instanceof, as casts
  // Uses precedence climbing algorithm for correct operator associativity
  mutable fun parseBinaryAndPostfixOps(
    left: Expr_,
    tok: Token,
    prec: Int,
  ): Expr_ {
    binopTok = this.lex.peek() match {
    | None() -> return left
    | Some(x) -> x
    };
    if (binopTok.kind is TKEquality()) {
      this.error(this.lex.posStart(binopTok), DontUseEquality())
    };
    if (binopTok.kind is TKInequality()) {
      this.error(this.lex.posStart(binopTok), DontUseInequality())
    };
    for (tryParse in Array[
      this.tryParseAccess,
      this.tryParseFunctionCall,
      this.tryParsePostfixOp,
      this.tryParseTypeCast,
      this.tryParseInAndInstanceOf,
      this.tryParseTernary,
      this.tryParseClosure,
      this.tryParseBinaryOp,
    ]) {
      tryParse(left, binopTok, tok, prec) match {
      | None() -> void
      | Some(newLeft) ->
        return this.parseBinaryAndPostfixOps(newLeft, tok, prec)
      };
    };
    left
  }

  // Parse function call arguments
  mutable fun arguments(): Array<Expr> {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return Array[]
    };
    args = mutable Vector[];
    loop {
      args.push(this.expr(0));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseParen() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokens(Array[TKCloseParen(), TKComma()]),
        )
      }
    };
    args.toArray()
  }

  // Parse object field in expression context
  mutable fun field(): Field {
    if (this.lex.peekKind() is Some(TKDotDotDot())) {
      _ = this.lex.next();
      e = this.expr(0);
      return FDSpread(e);
    };
    modifiers = this.modifiers{allowRemove => false};
    fieldGetSet = this.isGetSet();
    fieldName = this.getNameOrStringOrInt();
    if (
      this.lex.peekKind() is Some(TKOpenParen()) ||
      this.lex.peekKind() is Some(TKLessThan())
    ) {
      return this.anonMethodDef(
        None(),
        modifiers,
        fieldGetSet,
        Some(FNNormal(fieldName)),
        true,
        None(),
        None(),
      )
    };
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    tok.kind match {
    | TKColon() ->
      _ = this.lex.next();
      FDNormal(fieldName, this.expr(0))
    | TKComma()
    | TKCloseCurly() ->
      FDNormal(fieldName, Expr(fieldName.pos, Var(fieldName)))
    | _ ->
      this.error(
        this.lex.posStart(tok),
        ExpectedTokens(Array[TKCloseCurly(), TKColon(), TKComma()]),
      )
    }
  }

  // Parse template literals with interpolation: `text ${expr} more text`
  mutable fun parseTemplateLiteral(tok: Token): Expr_ {
    invariant(tok.kind is TKBackTick());

    rawContent = this.lex.getTokenRawStringContent(tok);

    if (!rawContent.contains("${")) {
      // Simple template literal without interpolation
      return EString(rawContent.stripPrefix("`").stripSuffix("`"))
    };

    // Parse template literal with interpolation by manipulating lexer position
    // The lexer has already consumed the entire template, but we can re-parse it

    parts = mutable Vector<String>[];
    expressions = mutable Vector<Expr>[];

    // Save current lexer position
    originalPos = this.lex.pos;
    originalLastTok = this.lex.lastTok;

    // Reset to start of template content (after opening backtick)
    templateStart = tok.posStart.value + 1; // Skip opening `
    templateEnd = tok.posEnd.value - 1; // Skip closing `
    this.lex.!pos = templateStart;
    this.lex.!lastTok = None();

    currentStart = templateStart;
    pos = templateStart;

    // Parse through the template content
    loop {
      if (pos >= templateEnd) break void;

      // Look for ${ pattern
      if (
        pos + 1 < templateEnd &&
        this.lex.contents[pos] == '$' &&
        this.lex.contents[pos + 1] == '{'
      ) {
        // Add string part before ${
        if (pos > currentStart) {
          part = String::fromChars(this.lex.contents.slice(currentStart, pos));
          parts.push(part);
        };

        // Skip ${
        !pos = pos + 2;
        this.lex.!pos = pos;

        // Find matching }
        braceCount = 1;
        exprStart = pos;
        loop {
          if (pos >= templateEnd) {
            this.error(
              EPChar(this.lex.fileName, tok.posStart),
              UnterminatedExpr(),
            );
          };
          c = this.lex.contents[pos];
          if (c == '{') !braceCount = braceCount + 1;
          if (c == '}') !braceCount = braceCount - 1;
          if (braceCount == 0) break void;
          !pos = pos + 1;
        };

        // Set lexer to parse the expression content
        this.lex.!pos = exprStart;
        expr = this.expr(0);
        expressions.push(expr);

        // Move past the closing }
        !pos = pos + 1;
        !currentStart = pos;
        this.lex.!pos = pos;
      } else {
        !pos = pos + 1;
      }
    };

    // Add final string part
    if (currentStart < templateEnd) {
      part = String::fromChars(
        this.lex.contents.slice(currentStart, templateEnd),
      );
      parts.push(part);
    };

    // Restore lexer position
    this.lex.!pos = originalPos;
    this.lex.!lastTok = originalLastTok;

    TemplateLiteral(parts.toArray(), expressions.toArray())
  }
}

module end;
