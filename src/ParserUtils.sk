module SKJS;

extension class Parser {
  /***************************************************************************/
  // Helpers
  /***************************************************************************/

  readonly fun error<T>(pos: ErrorPos, kind: ParsingKind): T {
    throw ErrorExn(ParsingError(pos, kind))
  }

  readonly fun getVar(tok: Token): String {
    if (tok.kind is TKVar()) {
      // The name is the identifier's decoded text, so an escaped spelling and
      // its literal twin are one name (ECMA-262 sec 12.7).
      decodeIdentifierName(this.lex.getTokenRawStringContent(tok))
    } else {
      this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))
    }
  }

  // `negative` is set when the literal is the operand of a unary minus (the
  // sign is then part of the written literal for diagnostics, and applied
  // after normalization so -0 collapses to 0).
  mutable fun getNumber(tok: Token, negative: Bool = false): NumLit {
    if (tok.kind is TKNumber()) {
      raw0 = this.lex.getTokenRawStringContent(tok);
      validateJSNumericLiteral(raw0) match {
      | Some(kind) -> this.error(EPRange(this.lex.posRange(tok)), kind)
      | None() ->
        // Warn when JS reads the literal as a different value than written
        // (overflow, underflow, precision loss).
        raw = if (negative) "-" + raw0 else raw0;
        jsNumberLiteralSurprise(raw) match {
        | Some((msg, code)) -> this.warn(this.lex.posRange(tok), msg, code)
        | None() -> void
        };
        result = normalizeJSNumber(raw0);
        if (negative) !result = negateJSNumberLiteral(result);
        NumLit::ofUserWritten(
          result,
          if (this.userLiteralSpelling) raw else result,
        )
      }
    } else {
      this.error(this.lex.posStart(tok), ExpectedToken(TKNumber()))
    }
  }

  readonly fun getBigInt(tok: Token): NumLit {
    if (tok.kind is TKBigInt()) {
      raw = this.lex.getTokenRawStringContent(tok);
      validateJSBigIntLiteral(raw) match {
      | Some(kind) -> this.error(EPRange(this.lex.posRange(tok)), kind)
      | None() ->
        NumLit::ofUserWritten(
          normalizeJSBigInt(raw),
          if (this.userLiteralSpelling) raw else normalizeJSBigInt(raw),
        )
      }
    } else {
      this.error(this.lex.posStart(tok), ExpectedToken(TKBigInt()))
    }
  }

  // Returns the cooked text of a template chunk: escapes are decoded and line
  // terminators normalized, so the text equals the runtime string, and an
  // invalid escape is an error — exactly as for a quoted string literal.
  readonly fun cookTemplatePart(tok: Token): String {
    raw = normalizeTemplateLineTerminators(this.lex.templateChunkRawText(tok));
    decodeJSStringLiteral(raw) match {
    | Success(decoded) -> decoded
    | Failure(kind) -> this.error(EPRange(this.lex.posRange(tok)), kind)
    }
  }

  readonly fun unquoteString(tok: Token): String {
    body = tok.kind match {
    | TKQuote() ->
      this.lex.getTokenRawStringContent(tok).stripPrefix("'").stripSuffix("'")
    | TKDoubleQuote() ->
      this.lex.getTokenRawStringContent(tok).stripPrefix("\"").stripSuffix("\"")
    | _ ->
      this.error(
        this.lex.posStart(tok),
        ExpectedTokens(Array[TKQuote(), TKDoubleQuote()]),
      )
    };
    decodeJSStringLiteral(body) match {
    | Success(decoded) -> decoded
    | Failure(kind) -> this.error(EPRange(this.lex.posRange(tok)), kind)
    }
  }

  mutable fun expect(kind: TokenKind): void {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(kind))
    | Some(tok) if (tok.kind == kind) -> void
    | Some(tok) -> this.error(this.lex.posStart(tok), ExpectedToken(kind))
    }
  }

  mutable fun expectStr(str: String): void {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedStr(str))
    | Some(tok) ->
      if (this.lex.isEqTok(tok, str)) void else {
        this.error(this.lex.posStart(tok), ExpectedStr(str))
      }
    }
  }

  mutable fun withPos<T>(f: () -> T, err: ParsingKind): (PosRange, T) {
    start = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), err)
    | Some(tok) -> tok.posStart
    };
    result = f();
    end = this.lex.getLastPos();
    (PosRange::create(this.lex, start, end), result)
  }
}

module end;
