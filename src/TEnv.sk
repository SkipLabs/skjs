/***************************************************************************/
// The typing environment.
//
// The typing environment retrieves the abstract syntax tree
// corresponding to a type definition and turns it into a type.
/***************************************************************************/

module SKJS;

const cstrName: String = "constructor";
value class CstrType(cstr: ?TType)

class TEnv{
  // The defMap associates an AST to a type name.
  private defMap: IDefMap,

  // The type-parameters that are currently in scope. So if we see a
  // type definition with a matching name, we know we are dealing with
  // a universally quantified type variable.
  tparams: SortedMap<String, TParamWithConstraint> = SortedMap[],

  // The type substitution, which is different than the one used for
  // existentials during inference. This one is used to instantiate a type
  // with parameters with type arguments. So when you write new
  // mytype<number>, it's this substitution that will take care of replacing
  // the instances of type-parameter in the definition of mytype. However,
  // if you introduce an existential (like you would with a parametric new
  // construct without explicit type arguments), a different substitution is
  // used (cf TVar).
  subst: SortedMap<String, (Bool, TType)> = SortedMap[],

  // When expanding a type definition, we don't want to recursively
  // get all the type instances of a type, we only want to go one
  // level deep. Concretely, consider the following type:
  //
  // type foo = { field1: null | foo, field2: number };
  //
  // When we expand foo, we want to get:
  //   { field1: null | foo, field2: number };
  //
  // We don't want the instance of foo to be expanded (because that
  // could be infinite). Instead, the second instance of foo will only
  // be expanded if that turns out to be necessary for the inference.
  // The field "seenInstantiate" enforces the fact that we only expand one
  // level deep by keeping track of the types that we are in the
  // process of expanding.
  seenInstantiate: SortedSet<String> = SortedSet[],

  // This field keeps track of type names that, if used, would define
  // a cyclic type definition.
  forbiddenInsts: SortedSet<String> = SortedSet[],

  // This field keeps track of the intersections that we are in the
  // process of computing. If a cycle occurs, the type TInter(t1, t2)
  // will be returned.
  seenInter: SortedSet<(TType, TType)> = SortedSet[],

  // This field keeps track of the unions that we are in the
  // process of computing. If a cycle occurs, the type TUnion(t1, t2)
  // will be returned.
  seenUnion: SortedSet<(TType, TType)> = SortedSet[],

  // This field keeps track of the subtyping relations that we are in
  // the process of checking. If a cycle occurs, the subtyping
  // relation is considered correct (by co-induction).
  seenSub: SortedSet<(Int, TType, TType)> = SortedSet[],
} {
  // Given a type name and type arguments, first retrieves the type
  // definition (using the defMap) and then produces a type where the
  // type parameters have been replaced with the corresponding type
  // arguments (as expected).
  fun instantiate(subst: mutable Subst, name: Name, targs: TArgs): TType {
    // We are dealing with a recursive instance, if we keep on
    // unfolding, we will end up in an infinite loop. Instead, we
    // produce a type that can be later lazily unfolded if need be.
    if (this.seenInstantiate.contains(name.value)) {
      return TType::inst(name, targs);
    };
    !this.seenInstantiate = this.seenInstantiate.set(name.value);

    tdef = this.defMap.getType(subst.context, name);
    clauses = tdef match {
    | TDType(ta) -> ta.tdefParams
    | TDClass(ca) -> ca.tparams
    };
    if (targs.targs.size() > clauses.size()) {
      typingError(
        Array[
          (
            name.pos,
            `Too many type parameters: given ${targs.targs.size()}, expected ${clauses.size()}`,
          ),
        ],
      )
    };

    for (i => tparam in clauses) {
      targ = if (i < targs.targs.size()) targs.targs[i] else {
        tparam.default match {
        | Some(default) -> this.normalize(subst.context, default)
        | None() ->
          typingError(
            Array[
              (
                name.pos,
                `Not enough type parameters: given ${targs.targs.size()}, expected ${clauses.size()}`,
              ),
            ],
          )
        }
      };
      tparam.constraint match {
      | None() -> void
      | Some(cstr) ->
        cstrTy = this.normalize(subst.context, cstr);
        isSubTType(subst, this, targ, cstrTy) match {
        | STOk() -> void
        | STError _ ->
          typingError(
            Array[
              (name.pos, "Constraint not satisfied"),
              (targ.pos, `This is of type: ${targ}`),
              (cstr.pos, `It does not implement: ${cstrTy}`),
            ],
          )
        }
      };
      !this.subst[tparam.name.value] = (true, targ);
    };

    tdef match {
    | TDType(ta) -> this.normalize(subst.context, ta.body)
    | TDClass(_) -> this.new(subst.context, name, targs.targs)
    }
  }

  fun getClass(context: mutable SKStore.Context, className: Name): Class {
    tdef = this.defMap.getType(context, className);
    tdef match {
    | TDType(_) -> typingError(Array[(className.pos, "Expected a class name")])
    | TDClass(ca) -> ca
    };
  }

  fun makeTArgs(
    context: mutable SKStore.Context,
    subst: mutable Subst,
    className: Name,
  ): Array<TType> {
    this.getClass(context, className).tparams.map(tparam -> {
      tvar = subst.gen(className.pos);
      ty = TType::var(tvar);
      tparam.constraint match {
      | None() -> ty
      | Some(cstr) ->
        TType::union(subst, this, this.normalize(context, cstr), ty)
      }
    })
  }

  fun new(
    context: mutable SKStore.Context,
    className: Name,
    targs: Array<TType>,
    filter: FieldType ~> Bool = _ ~> true,
  ): TType {
    obj = this.newObject(context, className, targs, filter);
    TType::single(obj)
  }

  fun newConstructor(
    context: mutable SKStore.Context,
    className: Name,
    targs: Array<TType>,
  ): CstrType {
    c = this.getClass(context, className);
    if (c.tparams.size() != targs.size()) {
      typingError(
        Array[(className.pos, `Expected ${c.tparams.size()} parameters`)],
      )
    };
    visitedClasses = SortedSet[];
    CstrType(
      this.findConstructor(
        context,
        visitedClasses,
        className,
        c.tparams,
        targs,
      ),
    )
  }

  fun newObject(
    context: mutable SKStore.Context,
    className: Name,
    targs: Array<TType>,
    filter: FieldType ~> Bool = _ ~> true,
  ): TObject {
    c = this.getClass(context, className);
    if (c.tparams.size() != targs.size()) {
      typingError(
        Array[(className.pos, `Expected ${c.tparams.size()} parameters`)],
      )
    };
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    indexes = mutable Vector[];
    thisType = TType::inst(className, TArgs(targs));
    !this.subst["this"] = (false, thisType);
    this.addFields(
      context,
      fields,
      indexes,
      visitedClasses,
      None(),
      className,
      targs,
      fieldType ~> {
        filter(fieldType) && !fieldType.isStatic()
      },
    );
    TObject(
      TFields::create(fields.values().collect(Array), indexes.toArray()),
      className.pos,
    )
  }

  fun newStatic(context: mutable SKStore.Context, className: Name): TType {
    obj = this.newStaticObject(context, className);
    TType::single(obj)
  }

  private fun newStaticObject(
    context: mutable SKStore.Context,
    className: Name,
  ): TObject {
    c = this.getClass(context, className);
    targs = Array[];
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    indexes = mutable Vector[];
    this.addFields(
      context,
      fields,
      indexes,
      visitedClasses,
      Some(c.tparams),
      className,
      targs,
      fieldType ~> fieldType.isStatic(),
    );
    pos = className.pos;
    if (!fields.containsKey(cstrName)) {
      fields![cstrName] = this.makeEmptyConstructor(context, pos, className, c);
    };
    TObject(
      TFields::create(fields.values().collect(Array), indexes.toArray()),
      pos,
    )
  }

  private fun makeEmptyConstructor(
    context: mutable SKStore.Context,
    pos: PosRange,
    className: Name,
    c: Class,
  ): TField {
    cgNode = CGNode::create(
      Method(
        Some(FNNormal(Name(pos, cstrName))),
        className,
        c.name.pos.fileName,
        true,
      ),
    );
    targs = c.tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[])));
    retType = Type(pos, TAInst(className, targs));
    ftype = Type(pos, TAFun(true, c.tparams, Array[], retType, cgNode));
    TField::create(
      pos,
      "constructor",
      false,
      this.normalize(context, ftype),
    ).fromSome()
  }

  fun addTParams(subst: mutable Subst, clauses: Array<TypeParam>): this {
    for (tparam in clauses) {
      ty = TType::fromClauses(tparam.name.pos, Clauses::fromTypeParam(tparam));
      !this.subst[tparam.name.value] = (
        false,
        tparam.constraint match {
        | None() -> ty
        | Some(cstr) ->
          TType::inter(subst, this, ty, this.normalize(subst.context, cstr))
        },
      )
    };
    this
  }

  private fun processClassSetup(
    context: mutable SKStore.Context,
    visitedClasses: SortedSet<String>,
    withTParams: Bool,
    className: Name,
    targs: Array<TType>,
  ): (this, Class) {
    if (visitedClasses.contains(className.value)) {
      typingError(Array[(className.pos, "Cyclic class definition")]);
    };
    !visitedClasses = visitedClasses.set(className.value);
    defs = this.defMap.get(
      context,
      FileName::create(className.pos.fileName),
      className,
    );
    cls = for (def in defs) {
      def.value match {
      | cls @ Class _ -> break cls
      | _ -> void
      }
    } else {
      typingError(Array[(className.pos, "Unbound class")])
    };
    if (targs.size() != 0 && targs.size() != cls.tparams.size()) {
      typingError(
        Array[
          (className.pos, "Invalid number of type arguments"),
          (cls.name.pos, "Class declaration is here"),
        ],
      )
    };
    if (withTParams) {
      for (i => tparam in cls.tparams) {
        !this.subst[tparam.name.value] = (false, targs[i])
      };
    };
    (this, cls)
  }

  private fun addFields(
    context: mutable SKStore.Context,
    acc: mutable Map<String, TField>,
    indexes: mutable Vector<TIndexField>,
    visitedClasses: SortedSet<String>,
    isStatic: ?Array<TypeParam>,
    className: Name,
    targs: Array<TType>,
    filter: FieldType ~> Bool,
  ): void {
    (!this, cls) = this.processClassSetup(
      context,
      visitedClasses,
      isStatic is None(),
      className,
      targs,
    );
    for (extend in cls.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        this.addFields(
          context,
          acc,
          indexes,
          visitedClasses,
          isStatic,
          parentName,
          if (isStatic is Some _) Array[] else {
            paramTArgs.map(targ -> this.normalize(context, targ))
          },
          filter,
        )
      | _ -> typingError(Array[(extend.pos, "Unexpected extend")])
      }
    };
    for (fieldType in cls.fields) {
      fieldType match {
      | field @ FieldTypeValue _ ->
        if (!filter(fieldType)) continue;
        field.setGet match {
        | None() -> void
        | Some(FieldGetSet(_, pos)) -> notSupported(pos)
        };
        for (modifier in field.modifiers.modifiers) {
          if (modifier.value != "static") {
            typingError(Array[(modifier.pos, "TODO: field modifier")])
          }
        };
        field.name match {
        | FNNormal(fdName) ->
          fieldName = fdName.value;
          type = this.normalize(context, field.type);
          TField::create(
            field.pos,
            fieldName,
            field.optional is Some _,
            type,
          ) match {
          | None() ->
            typingError(
              Array[
                (field.pos, `Forbidden field name '${fieldName}' in a class`),
              ],
            )
          | Some(f) -> acc![fieldName] = f
          }
        | FNColon(indexName, indexType) ->
          keyType = this.normalize(context, indexType);
          valueType = this.normalize(context, field.type);
          indexes.push(
            TIndexField(indexName.pos, indexName.value, keyType, valueType),
          )
        | _ -> typingError(Array[(field.pos, "Unsupported field name")])
        }
      | fd @ FunDef _ ->
        isConstructor = fd.name match {
        | Some(FNNormal(name @ Name(_, "constructor"))) -> Some(name)
        | _ -> None()
        };
        metIsStatic = isConstructor.isSome() || fd.isStatic();
        if (metIsStatic != isStatic.isSome()) continue;
        (metName, metType) = isConstructor match {
        | Some(name) ->
          (
            name,
            this.makeConstructor(context, className, isStatic.fromSome(), fd),
          )
        | None() ->
          cgNode = CGNode::create(
            Method(fd.name, className, fd.pos.fileName, metIsStatic),
          );
          this.funDecl(context, true, fd, cgNode)
        };
        TField::create(fd.pos, metName.value, false, metType) match {
        | None() ->
          typingError(
            Array[(fd.pos, `Forbidden method name '${metName.value}'`)],
          )
        | Some(field) -> acc![metName.value] = field
        }
      }
    }
  }

  private fun findConstructor(
    context: mutable SKStore.Context,
    visitedClasses: SortedSet<String>,
    className: Name,
    tparams: Array<TypeParam>,
    targs: Array<TType>,
  ): ?TType {
    this.findConstructorMethod(
      context,
      visitedClasses,
      className,
      tparams,
      targs,
    ) match {
    | None() -> None()
    | Some(fd) -> Some(this.makeConstructor(context, className, tparams, fd))
    }
  }

  private fun findConstructorMethod(
    context: mutable SKStore.Context,
    visitedClasses: SortedSet<String>,
    className: Name,
    tparams: Array<TypeParam>,
    targs: Array<TType>,
  ): ?FunDef {
    (!this, cls) = this.processClassSetup(
      context,
      visitedClasses,
      true,
      className,
      targs,
    );
    for (fieldType in cls.fields) {
      fieldType match {
      | fd @ FunDef _ if (fd.name is Some(FNNormal(Name(_, "constructor")))) ->
        return Some(fd)
      | _ -> void
      }
    };
    for (extend in cls.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        return this.findConstructorMethod(
          context,
          visitedClasses,
          parentName,
          tparams,
          paramTArgs.map(targ -> this.normalize(context, targ)),
        )
      | _ -> typingError(Array[(extend.pos, "Unexpected extend")])
      }
    };
    None()
  }

  // Normalizes constructor signatures by making type parameters and
  // return types explicit.  For example, in a generic class A<T> {
  // constructor() {} }, the constructor is transformed into:
  // constructor<T>(...): A<T> This ensures constructors reflect their
  // class's type parameters and return type.

  fun makeConstructor(
    context: mutable SKStore.Context,
    className: Name,
    tparams: Array<TypeParam>,
    fd: FunDef,
  ): TType {
    cgNode = CGNode::create(Method(fd.name, className, fd.pos.fileName, true));
    !tparams = tparams.map(x -> {
      // We give the tparams a different name to make sure they are
      // not confused with the type parameters of the class
      !x.id = x.id.prefixWith("$");
      x
    });
    params = fd.params.map(this.convertParam);
    retType = fd.retType match {
    | (pos, None()) -> // constructor
      Type(
        pos,
        TAInst(
          Name(pos, className.value),
          tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[]))),
        ),
      )
    | (_, Some(x)) ->
      typingError(Array[(x.pos, "Unexpected annotation for constructor")])
    };
    this.normalize(
      context,
      Type(fd.pos, TAFun(true, tparams, params, retType, cgNode)),
    );
  }

  private fun convertParam(param: Param): TAFunParam {
    (paramName, ty) = param.name match {
    | PNName(n) ->
      param.type match {
      | None() -> typingError(Array[(n.pos, "Missing type annotation")])
      | Some(ty) -> (TAParamName(n), ty)
      }
    | PNDDD(n) ->
      param.type match {
      | None() -> typingError(Array[(n.pos, "Missing type annotation")])
      | Some(x) -> (TAParamSpread(n), x)
      }
    | _ ->
      typingError(
        Array[(param.pos, "TODO: support for param pattern in typeDecl")],
      )
    };
    param.optional match {
    | None() -> void
    | Some(optionalPos) ->
      !ty = Type(
        param.pos,
        TAUnion(
          ty,
          Type(optionalPos, TAInst(Name(optionalPos, "undefined"), Array[])),
        ),
      )
    };
    optional = param.default match {
    | None() -> param.optional
    | Some(defaultExpr) -> Some(defaultExpr.pos)
    };
    TAFunParam(Some(paramName), optional, ty)
  }

  fun funDecl(
    context: mutable SKStore.Context,
    isMethod: Bool,
    fd: FunDef,
    cgNode: CGNode,
  ): (Name, TType) {
    name = fd.name match {
    | Some(FNNormal(x)) -> x
    | None() -> notSupported(fd.pos, "anonymous function")
    | _ -> notSupported(fd.pos, "non-normal function name")
    };
    retType = fd.retType match {
    | (pos, None()) ->
      // constructors must use makeConstructor
      typingError(Array[(pos, "Missing return type annotation")])
    | (_, Some(x)) -> x
    };
    fty = this.normalize(
      context,
      Type(
        fd.pos,
        TAFun(
          isMethod,
          fd.tparams,
          fd.params.map(this.convertParam),
          retType,
          cgNode,
        ),
      ),
    );
    (name, fty)
  }

  fun normalize(context: mutable SKStore.Context, typeAst: Type): TType {
    subst = Subst::mcreate{context};
    pos = typeAst.pos;
    typeAst.value match {
    | TABigIntLiteral(x) -> TType::single(TPrimValue::single(TBigInt(), x, pos))
    | TAAssertIs _ -> internal_error("TODO assertIs ")
    | TAAbstract _ -> internal_error("TODO abstract ")
    | TAUniqueSymbol() -> internal_error("TODO uniqueSymbol ")
    | TAAsserts _ -> internal_error("TODO asserts ")
    | TAIs _ -> internal_error("TODO is ")
    | TAKeyOf(ty) ->
      targetType = this.normalize(context, ty);
      this.keyOfType(subst, targetType, pos)
    | TANew(Type(tyPos, TAFun(_, clauses, params, retType, cgNode))) ->
      tfun = this.normalize(
        context,
        Type(tyPos, TAFun(true, clauses, params, retType, cgNode)),
      );
      TType::single(
        TObject(
          TFields::create(
            Array[TField::create(pos, cstrName, false, tfun).fromSome()],
            Array[],
          ),
          pos,
        ),
      )
    | TANew _ -> typingError(Array[(pos, "Invalid new")])
    | TAEmptyArray _ -> internal_error("TODO emptyArray ")
    | TAInfer _ -> internal_error("TODO infer ")
    | TATemplate _ -> internal_error("TODO template ")
    | TAImport _ -> internal_error("TODO import ")
    | TAReadonly _ -> internal_error("TODO readonly ")
    | TAExtends _ -> internal_error("TODO extends ")
    | TAExtendsQuestion _ -> internal_error("TODO extendsQuestion ")
    | TAStringLiteral(x) -> TType::single(TPrimValue::single(TString(), x, pos))
    | TANumLiteral(x) -> TType::single(TPrimValue::single(TNum(), x, pos))
    | TATypeOf(ty) ->
      ty.value match {
      | TAInst(Name(_, "undefined"), targs) ->
        if (targs.size() != 0) {
          typingError(Array[(pos, "Unexpected type parameters for undefined")])
        };
        TType::single(TPrimUnit(TUndefined(), pos))
      | TAInst(className, targs) ->
        c = this.getClass(context, className);
        this.findConstructorMethod(
          context,
          SortedSet[],
          className,
          c.tparams,
          targs.map(x -> this.normalize(context, x)),
        ) match {
        | None() ->
          TType::single(
            TObject(
              TFields::create(
                Array[this.makeEmptyConstructor(context, pos, className, c)],
                Array[],
              ),
              pos,
            ),
          )
        | Some(fd) ->
          tfun = this.makeConstructor(context, className, c.tparams, fd);
          TType::single(
            TObject(
              TFields::create(
                Array[TField::create(pos, cstrName, false, tfun).fromSome()],
                Array[],
              ),
              pos,
            ),
          )
        }
      | _ -> typingError(Array[(ty.pos, "Invalid typeof")])
      }
    | TAPrim(kind) ->
      TType::single(
        kind match {
        | TPKNull() -> TPrimUnit(TNull(), pos)
        | TPKBool() -> TPrimValue::boolean(pos)
        | TPKNum() -> TPrimValue::number(pos)
        | TPKString() -> TPrimValue::string(pos)
        | TPKBigInt() -> TPrimValue::bigint(pos)
        },
      )
    | TAObject(fields) ->
      (algebraicBranchField, tFields) = this.createTFields(context, fields);
      createObject(pos, algebraicBranchField, tFields)
    | TAInst(n @ Name(p, "object"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(n.pos, "Invalid number of type arguments")])
      };
      TType::single(TObject(TFields::empty(), p))

    | TAInst(n @ Name(p, "Array"), targs) ->
      if (targs.size() != 1) {
        typingError(Array[(n.pos, "Invalid number of type arguments")])
      };
      TType::inst(
        Name(p, "Array"),
        TArgs(Array[this.normalize(context, targs[0])]),
      )

    | TAArray(ty) ->
      TType::inst(Name(pos, "Array"), TArgs(Array[this.normalize(context, ty)]))

    | TAInst(n @ Name(p, "void"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(n.pos, "Invalid number of type arguments")])
      };
      TType::single(TPrimUnit(TVoid(), p))
    | TAInst(n @ Name(p, "undefined"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(n.pos, "Invalid number of type arguments")])
      };
      TType::single(TPrimUnit(TUndefined(), p))
    | TAInst(n @ Name(_, "Promise"), targs) ->
      if (targs.size() != 1) {
        typingError(Array[(n.pos, "Invalid number of type arguments")])
      };
      TType::single(TPromise(this.normalize(context, targs[0]), pos))
    | TAInst(Name(p, "unknown"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(p, "Invalid number of type arguments")])
      };
      TType::top(p)
    | TAInst(Name(_, "never"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(pos, "Invalid number of type arguments")])
      };
      TType::bottom(pos)
    | TAInst(Name(_, x @ "true"), targs)
    | TAInst(Name(_, x @ "false"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(pos, "Invalid number of type arguments")])
      };
      TType::single(TPrimValue::single(TBool(), x, pos))
    | TAInst(n, targs) ->
      if (this.tparams.containsKey(n.value)) {
        if (targs.size() != 0) {
          typingError(
            Array[
              (
                n.pos,
                "A bound occurrence of a type parameter cannot have type arguments",
              ),
            ],
          )
        };
        tparam = this.tparams[n.value];
        TType::fromTParamWithConstraint(subst, this, pos, tparam, None())
      } else if (this.subst.containsKey(n.value)) {
        if (targs.size() != 0) {
          typingError(
            Array[
              (
                n.pos,
                "A bound occurrence of a type parameter cannot have type arguments",
              ),
            ],
          )
        };
        (keepPos, ty) = this.subst[n.value];
        if (keepPos) ty else ty.withPos(pos)
      } else if (this.forbiddenInsts.contains(n.value)) {
        typingError(Array[(n.pos, "Cyclic definition")])
      } else {
        tdef = this.defMap.getType(context, n);
        tparams = tdef match {
        | TDType(ta) -> ta.tdefParams
        | TDClass(ca) -> ca.tparams
        };
        if (
          targs.size() > tparams.size() ||
          (targs.size() < tparams.size() &&
            tparams[targs.size()].default is None())
        ) {
          typingError(
            Array[
              (
                n.pos,
                `Invalid number of type arguments: given ${targs.size()}, expected ${tparams.size()}`,
              ),
            ],
          )
        };

        TType::inst(
          n,
          TArgs(
            targs.map(x ->
              (this with {forbiddenInsts => this.seenInstantiate}).normalize(
                context,
                x,
              )
            ),
          ),
        )
      }
    | TAUnion(ty1, ty2) ->
      TType::union(
        subst,
        this,
        this.normalize(context, ty1),
        this.normalize(context, ty2),
      ).withPos(pos)
    | TAInter(ty1, ty2) ->
      TType::inter(
        subst,
        this,
        this.normalize(context, ty1),
        this.normalize(context, ty2),
      ).withPos(pos)
    | TATuple(tupleElts) ->
      typeVec = mutable Vector[];
      for (ty in tupleElts) {
        ty match {
        | TEType(n, optional, x) ->
          if (n is Some _) internal_error("TODO named tuple");
          if (optional is Some _) {
            internal_error("TODO optional element tuple")
          };
          typeVec.push(x)
        | TESpread _ -> internal_error("TODO tuple spread")
        }
      };
      types = typeVec.toArray();
      TType::single(TTuple(types.map(ty -> this.normalize(context, ty)), pos))
    | TAFun(isMethod, clauses, params, retType, cgNode) ->
      TypeChecker::checkTypeParams(clauses);
      funClauses = mutable Vector[];
      for (tparam in clauses) {
        if (tparam.default is Some _) {
          typingError(
            Array[
              (
                tparam.name.pos,
                "Optional type parameters are not supported for functions",
              ),
            ],
          )
        };
        funTParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.pos.fileName,
          tparam.id,
          tparam.constraint.map(cstr -> this.normalize(context, cstr)),
        );
        funClauses.push(funTParam);
        !this.tparams[tparam.name.value] = funTParam;
      };
      normalParams = mutable Vector[];
      optionalParams = mutable Vector[];
      optionalWitness: ?PosRange = None();
      spreadParam: ?TType = None();
      for (i => param in params) {
        paramType = this.normalize(context, param.type);
        param.name match {
        | Some(TAParamSpread(spreadName)) ->
          if (i != params.size() - 1) {
            typingError(
              Array[(spreadName.pos, "... must always be the last parameter")],
            );
          };
          !spreadParam = Some(paramType);
          continue
        | _ -> void
        };
        param.optional match {
        | None() ->
          optionalWitness match {
          | None() -> normalParams.push(paramType)
          | Some(wpos) ->
            typingError(
              Array[
                (param.type.pos, "This parameter is not optional"),
                (wpos, "It appears after this parameter that is optional"),
              ],
            )
          }
        | Some(wpos) ->
          !optionalWitness = Some(wpos);
          optionalParams.push(paramType)
        }
      };
      tfun = TFun(
        funClauses.toArray(),
        normalParams.toArray(),
        optionalParams.toArray(),
        spreadParam,
        pos,
        this.normalize(context, retType),
        CGNodes::singleton(cgNode),
      );
      tfuns = if (isMethod) {
        TFuns::singleMethod(tfun, pos)
      } else {
        TFuns::singleFun(tfun, pos)
      };
      TType::single(tfuns)
    | TAGet _ -> internal_error("TODO TAGet")
    }
  }

  /*
    The first element is the position and the type of the algebraic branch field if it is present.
   */
  private fun createTFields(
    context: mutable SKStore.Context,
    fieldTypes: Array<FieldType>,
  ): (?(PosRange, TType), TFields) {
    algebraicBranchField: ?(PosRange, TType) = None();
    indexes = mutable Vector[];
    fields = fieldTypes.filterMap(elt -> {
      elt match {
      | fd @ FieldTypeValue _ ->
        fd.name match {
        | FNIn _ -> typingError(Array[(fd.pos, "TODO fnIn")])
        | FNSymbol _ -> internal_error("TODO symbol")
        | FNNormal(name) ->
          normalizedType = this.normalize(context, fd.type);
          optField = TField::create(
            name.pos,
            name.value,
            fd.optional is Some _,
            normalizedType,
          );
          if (optField is None()) {
            algebraicBranchField match {
            | Some((existingPos, _existingType)) ->
              typingError(
                Array[
                  (name.pos, `Duplicate field ${name.value}`),
                  (existingPos, "Previously declared here"),
                ],
              )
            | None() -> void
            };
            fd.optional match {
            | Some(optionalPos) ->
              typingError(
                Array[(optionalPos, `Field ${name.value} cannot be optional`)],
              )
            | None() -> void
            };
            !algebraicBranchField = Some((name.pos, normalizedType))
          };
          optField
        | FNColon(indexName, indexType) ->
          keyType = this.normalize(context, indexType);
          valueType = this.normalize(context, fd.type);
          indexes.push(
            TIndexField(indexName.pos, indexName.value, keyType, valueType),
          );
          None()
        }
      | fd @ FunDef _ ->
        cgNode = CGNode::create(AnonymousFunDef(fd));
        (name, decl) = this.funDecl(context, true, fd, cgNode);
        optField = TField::create(name.pos, name.value, false, decl);
        if (optField is None()) {
          typingError(Array[(name.pos, `Forbidden method name ${name.value}`)])
        };
        optField
      }
    });
    tFields = TFields::create(fields, indexes.toArray());
    (algebraicBranchField, tFields)
  }

  /* Over-approximates keyof targetType
     Though keyof should be treated symbolically because it is a decreasing
     function of types.
     In particular, do not use keyof to check that a key is valid.

     Try to keep in synch with TypeChecker#get in TypeCheckExpr
  */
  fun keyOfType(subst: mutable Subst, targetType: TType, pos: PosRange): TType {
    this.keys(subst, targetType, pos, false)
  }

  /* Over-approximates the type of the iterated key in a loop
      for (let key in x)  where x has type iterableType

      It is basically the same as keyof iterableType without:
      - non-enumerable properties (TODO? private members)
      - number and symbols
      And is allowed on arrays and objects only
   */
  fun forInKeys(
    subst: mutable Subst,
    iterableType: TType,
    pos: PosRange,
  ): TType {
    keys = this.keys(subst, iterableType, pos, true);
    TType::inter(subst, this, keys, TType::single(TPrimValue::string(pos)))
  }

  fun keys(subst: mutable Subst, ty: TType, pos: PosRange, forIn: Bool): TType {
    clauses = ty.expand(subst, this, Covariant()).clauses;
    if (
      clauses.any(clause -> (!clause.vars.isEmpty() || clause.stypes is None()))
    ) {
      return TType::fromSTypes(pos, STypes::stringOrNumber(pos))
    };
    result = TType::bottom(pos);
    maxRange = -1;
    strings = SortedSet[];
    for (clause in clauses) {
      invariant(clause.vars.isEmpty());
      stypes = Vector::mcreateFromIterator(clause.stypes.fromSome().values());
      while (!stypes.isEmpty()) {
        stype = stypes.pop();
        stype match {
        | TTuple(tyArr, _) -> !maxRange = max(maxRange, tyArr.size())
        | TObject(fields, _) ->
          for (field in fields) {
            if (forIn && field.type.isMethod(subst, this)) continue;
            !strings = strings.set(field.name);
          };
          for (index in fields.indexes) {
            // TODO: convert numbers to strings
            !result = TType::union(subst, this, result, index.keyType);
          }
        | TAlgebraic(branches, _) ->
          !strings = strings.set(kAlgebraicBranchFieldName);
          for (branch in branches) {
            for (field in branch.fields) {
              if (forIn && field.type.isMethod(subst, this)) continue;
              !strings = strings.set(field.name);
            };
            for (index in branch.fields.indexes) {
              // TODO: convert numbers to strings
              !result = TType::union(subst, this, result, index.keyType);
            }
          }
        | _ if (forIn) ->
          typingError(
            Array[(pos, "for-in loop requires an object or array type")],
          )
        | TPrimValue(primKind, _, primPos) ->
          objName = primKind.toString();
          obj = this.newObject(subst.context, Name(primPos, objName), Array[]);
          stypes.push(obj)
        | TPrimUnit _ -> void /* bottom */
        | TPromise _
        | TFuns _ ->
          internal_error(`TODO: keyof ${prettyPrintSType(stype)}`)
        }
      }
    };
    numbers = SortedSet::createFromItems(
      Range(0, maxRange).map(i -> i.toString()),
    );
    !strings = strings.union(numbers);
    ArrayValues::ofSet(strings, pos) match {
    | None() -> void
    | strValues @ Some _ ->
      literals = ArrayValues::ofSet(numbers, pos) match {
      | None() -> TType::single(TPrimValue(TString(), strValues, pos))
      | nbrValues @ Some _ ->
        TType::fromSTypes(
          pos,
          STypes::stringOrNumber(pos, strValues, nbrValues),
        )
      };
      !result = TType::union(subst, this, result, literals)
    };
    result
  }
}

module end;
