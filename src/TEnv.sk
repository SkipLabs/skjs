/***************************************************************************/
// The typing environment.
//
// The typing environment retrieves the abstract syntax tree
// corresponding to a type definition and turns it into a type.
/***************************************************************************/

module SKJS;

value class CstrType(cstr: ?TFuns, tArgs: Array<TType>)

base class TEnv{
  // The defMap associates an AST to a type name.
  defMap: IDefMap,

  // Body maps resolve bodyRef references to their bodies.
  funDefSigMap: FunDefSigMap,
  funDefBodyMap: FunDefBodyMap,
  classBodyMap: ClassBodyMap,
  classFieldMap: ClassFieldMap,
  typeDefBodyMap: TypeDefBodyMap,
  methodBodyMap: MethodBodyMap,

  // Lexical bindings for TAInst name resolution, keyed by syntactic
  // name. Distinct from the existential Subst used for TVar unification
  // (cf TVar); this map resolves named references in source types.
  //
  // Each entry maps a name to the TType it currently denotes:
  // - a concretized type argument, while expanding a class/type-def
  //   instantiation (`instantiate`, `processClassSetup`);
  // - an abstract tparam TType, while type-checking a class or function
  //   body (`addTParams`, `normalizeFun`);
  // - the synthetic `"this"` binding (`newObject`, `TypeCheckFun`).
  //
  // Shadowing is last-write-wins: when an inner scope introduces a
  // binding with the same name, it overwrites any outer one. Scope
  // exit requires no explicit restore because `!this = ...` mutations
  // are local to the current frame — the caller keeps its own `this`
  // with the bindings it had on entry.
  //
  // At a TAInst lookup the stored TType is returned with
  // `.withPos(refPos)` so errors point at the reference site.
  bindings: SortedMap<String, TType> = SortedMap[],

  // When expanding a type definition, we don't want to recursively
  // get all the type instances of a type, we only want to go one
  // level deep. Concretely, consider the following type:
  //
  // type foo = { field1: null | foo, field2: number };
  //
  // When we expand foo, we want to get:
  //   { field1: null | foo, field2: number };
  //
  // We don't want the instance of foo to be expanded (because that
  // could be infinite). Instead, the second instance of foo will only
  // be expanded if that turns out to be necessary for the inference.
  // The field "seenInstantiate" enforces the fact that we only expand one
  // level deep by keeping track of the types that we are in the
  // process of expanding.
  seenInstantiate: SortedSet<String> = SortedSet[],

  // This field keeps track of type names that, if used, would define
  // a cyclic type definition.
  forbiddenInsts: SortedSet<String> = SortedSet[],

  // This field keeps track of the intersections that we are in the
  // process of computing. If a cycle occurs, an unexpanded TInter
  // will be returned.
  seenInter: SortedSet<(TType, TType)> = SortedSet[],

  // This field keeps track of the subtyping relations that we are in
  // the process of checking. If a cycle occurs, the subtyping
  // relation is considered correct (by co-induction).
  seenSub: SortedSet<(Int, TType, TType)> = SortedSet[],

  // Controls whether field inter/union operations fully expand intersections.
  // When false (default), defers via unexpandedInter to avoid infinite expansion
  // during normal type operations. Set to true only during TInter expansion
  // in getSTypes (TType.sk) where full expansion is safe and needed.
  expandInter: Bool = false,

  // True while normalizing a generic type-alias body for definition-time
  // validation (TypeCheckDef.typeDef). Mapped-type expansion treats abstract
  // K silently in this mode so that aliases like
  //   type Record<K extends ..., V> = { [P in K]: V }
  // pass validation; outside this mode an abstract K is reported as
  // "not supported yet".
  inTypeDefValidation: Bool = false,

  // The use-site position when normalizing an instantiated type-alias body.
  // FNIn uses this so that errors in stub-defined mapped types (like Record)
  // surface at the user's call site rather than in the stub.
  instantiateAt: ?PosRange = None(),

  // Mirrors the `--verbose` CLI flag. Read by the pretty-printer to opt out
  // of hiding internal-only details (currently the synthetic index name on
  // object literals; see kSyntheticIndexName and TypePp::fields).
  verbose: Bool = false,
} {
  // Short-hand for prettyPrintType(false, ty, tcenv.subst, this) used in error messages
  fun ppType(tcenv: mutable TCEnv, ty: TType): String {
    prettyPrintType(false, ty, tcenv.subst, this)
  }

  // Given a type name and type arguments, first retrieves the type
  // definition (using the defMap) and then produces a type where the
  // type parameters have been replaced with the corresponding type
  // arguments (as expected).
  fun instantiate(subst: mutable Subst, name: Name, targs: TArgs): TType {
    // Synthetic placeholder for a class field with no type annotation
    // (see addFields). It has no defMap entry — keep it unexpanded so
    // it stays opaque under subtype comparison and pretty-prints as the
    // synthetic name. Two instantiations of the same generic class with
    // different type arguments produce TInsts with different targs,
    // which compare as incompatible.
    if (name.value.startsWith(kMissingTypeAnnotationPrefix)) {
      return TType::inst(name, targs);
    };
    // We are dealing with a recursive instance, if we keep on
    // unfolding, we will end up in an infinite loop. Instead, we
    // produce a type that can be later lazily unfolded if need be.
    if (this.seenInstantiate.contains(name.value)) {
      return TType::inst(name, targs);
    };
    !this.seenInstantiate = this.seenInstantiate.set(name.value);

    tcenvb: mutable TCEnvBase = subst;

    tdef = this.defMap.getType(tcenvb, name);
    clauses = tdef match {
    | TypeDef{tdefParams} -> tdefParams
    | Class{tparams} -> tparams
    | Enum _ -> Array[]
    };
    if (targs.targs.size() > clauses.size()) {
      tcenvb.error(
        Array[
          (
            name.pos,
            `Too many type parameters: given ${targs.targs.size()}, expected ${clauses.size()}`,
          ),
        ],
      )
    };

    for (i => tparam in clauses) {
      targ = if (i < targs.targs.size()) targs.targs[i] else {
        tparam.default match {
        | Some(default) -> this.normalize(tcenvb, default)
        | None() ->
          tcenvb.error(
            Array[
              (
                name.pos,
                `Not enough type parameters: given ${targs.targs.size()}, expected ${clauses.size()}`,
              ),
            ],
          );
          break void
        }
      };
      tparam.constraint match {
      | None() -> void
      | Some(cstr) ->
        cstrTy = this.normalize(tcenvb, cstr);
        // Clone substitution: constraint checking should verify compatibility
        // but NOT permanently grow type variables. Growing here would close the
        // variable to its constraint, preventing later unification with more
        // specific types (e.g., TVar<:Json should remain open to unify with string).
        TType::isSub(subst.clone(), this, targ, cstrTy) match {
        | STOk() -> void
        | err @ STErrorOnTType _ ->
          tcenvb.subtypingError(
            subst,
            this,
            Array[
              (name.pos, "Constraint not satisfied"),
              (
                targ.pos,
                `This is of type: ${prettyPrintType(false, targ, subst, this)}`,
              ),
              (
                cstr.pos,
                `It does not implement: ${prettyPrintType(
                  false,
                  cstrTy,
                  subst,
                  this,
                )}`,
              ),
            ],
            err,
          )
        }
      };
      !this.bindings[tparam.name.value] = targ;
    };

    tdef match {
    | ta @ TypeDef _ ->
      !this.instantiateAt = Some(name.pos);
      this.normalize(tcenvb, this.getTypeDefBody(tcenvb.context, ta))
    | Class _ -> this.new(subst, name, targs.targs)
    | Enum _ -> error(Array[(name.pos, "TODO: instantiate Enum")])
    }
  }

  fun getClass(tcenvb: mutable TCEnvBase, className: Name): Class {
    tdef = this.defMap.getType(tcenvb, className);
    tdef match {
    | ca @ Class _ -> ca
    | TypeDef _
    | Enum _ ->
      error(Array[(className.pos, "Expected a class name")])
    };
  }

  fun getClassFields(
    context: mutable SKStore.Context,
    c: Class,
  ): Array<ClassField> {
    fieldRefs = this.classBodyMap.get(context, c.bodyRef).fieldRefs;
    fieldRefs.map(fieldRef -> this.classFieldMap.get(context, fieldRef).field)
  }

  fun getTypeDefBody(context: mutable SKStore.Context, td: TypeDef): Type {
    this.typeDefBodyMap.get(context, td.bodyRef).body
  }

  fun getFunSig(
    context: mutable SKStore.Context,
    fd: FunDef<FunDefName>,
  ): FunDefSigData {
    fd.sig match {
    | FSInline(tparams, params, retType) ->
      FunDefSigData(tparams, params, retType)
    | FSRef(ref) -> this.funDefSigMap.get(context, ref)
    }
  }

  fun getFunBody(
    context: mutable SKStore.Context,
    fd: FunDef<FunDefName>,
  ): FunDefBody {
    fd.body match {
    | FBInline(body) -> body
    | FBRef(BRFunDef(ref)) -> this.funDefBodyMap.get(context, ref).body
    | FBRef(BRMethod(ref)) -> this.methodBodyMap.get(context, ref).body
    }
  }

  fun makeTArgs(tcenv: mutable TCEnv, className: Name): Array<TType> {
    tparams = this.getClass(tcenv, className).tparams;
    allTVars = tparams
      .map(tparam -> {
        tvar = tcenv.subst.gen(className.pos);
        tparam.constraint.each(cstr ->
          !tvar = tvar.setConstraint(this.normalize(tcenv, cstr))
        );
        tvar
      })
      .collect(Array);
    allTVars.map(tvar -> {
      tcenv.subst.setOrigin(tvar, FromGenericInst(className.pos, allTVars));
      TType::var(tvar)
    })
  }

  fun new(
    subst: mutable Subst,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TType {
    obj = this.newObject(subst, className, targs, filter);
    TType::single(obj)
  }

  fun newConstructor(
    subst: mutable Subst,
    className: Name,
    targs: Array<TType>,
  ): CstrType {
    c = this.getClass(subst, className);
    if (c.tparams.size() != targs.size()) {
      subst.error(
        Array[(className.pos, `Expected ${c.tparams.size()} parameters`)],
      )
    };
    visitedClasses = SortedSet[];
    CstrType(
      this.findConstructor(subst, visitedClasses, className, c.tparams, targs),
      targs,
    )
  }

  fun newObject(
    subst: mutable Subst,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TObject {
    c = this.getClass(subst, className);
    if (c.tparams.size() != targs.size()) {
      subst.error(
        Array[(className.pos, `Expected ${c.tparams.size()} parameters`)],
      )
    };
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    symbolFields = mutable Map[];
    indexes = mutable Vector[];
    thisType = TType::inst(className, TArgs(targs));
    !this.bindings["this"] = thisType;
    constructor = this.addFields(
      subst,
      fields,
      symbolFields,
      indexes,
      visitedClasses,
      None(),
      className,
      targs,
      fieldType ~> {
        filter(fieldType) && !fieldType.isStatic()
      },
    );
    constructor match {
    | Some(constructorTy) ->
      subst.notSupported(constructorTy.pos, "new returning a constructor")
    | None() -> void
    };
    isArray = c.kind match {
    | CKInterface() -> None()
    | CKAbstract()
    | CKClass() ->
      Some(false) /* Unless overridden by brand field */
    };
    tIndexes = TIndexes::create(subst, this, indexes);
    TObject::createSingleBranch(
      TFields::create{fields, symbolFields, tIndexes, isArray},
      Some(TSInst(className, TArgs(targs))),
      className.pos,
    )
  }

  fun newStatic(subst: mutable Subst, className: Name): TType {
    obj = this.newStaticObject(subst, className);
    TType::single(obj)
  }

  private fun newStaticObject(subst: mutable Subst, className: Name): TObject {
    c = this.getClass(subst, className);
    targs = Array[];
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    symbolFields = mutable Map[];
    indexes = mutable Vector[];
    constructor = this.addFields(
      subst,
      fields,
      symbolFields,
      indexes,
      visitedClasses,
      Some(c.tparams),
      className,
      targs,
      fieldType ~> fieldType.isStatic(),
    );
    pos = className.pos;
    new = constructor match {
    | Some(tfuns) -> tfuns
    | None() -> this.makeEmptyConstructor(subst, pos, className, c)
    };
    tIndexes = TIndexes::create(subst, this, indexes);
    TObject::createSingleBranch(
      TFields::create{
        fields,
        symbolFields,
        tIndexes,
        new => Some(new),
        isArray => Some(false),
      },
      Some(TSInst(className, TArgs(targs))),
      pos,
    )
  }

  private fun makeEmptyConstructor(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    className: Name,
    c: Class,
  ): TFuns {
    cgNode = CGNode::create(Constructor(className, c.name.pos.fileName));
    targs = c.tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[])));
    retType = Type(pos, TAInst(className, targs));
    tafun = TAFun(false, c.tparams, Array[], retType, cgNode);
    this.normalizeFun(tcenvb, pos, tafun)
  }

  // TParamWithConstraint corresponding to syntactic TypeParam
  fun makeTParam(
    tcenvb: mutable TCEnvBase,
    tparam: TypeParam,
  ): TParamWithConstraint {
    cstr = tparam.constraint.map(cstr -> this.normalize(tcenvb, cstr));
    TParamWithConstraint(
      tparam.name.value,
      tparam.name.pos.fileName,
      tparam.id,
      cstr,
    )
  }

  fun addTParams(subst: mutable Subst, clauses: Array<TypeParam>): this {
    for (tparam in clauses) {
      ty = TType::fromTParamWithConstraint(
        subst,
        this,
        tparam.name.pos,
        this.makeTParam(subst, tparam),
      );
      !this.bindings[tparam.name.value] = ty
    };
    this
  }

  private fun processClassSetup(
    tcenvb: mutable TCEnvBase,
    visitedClasses: SortedSet<String>,
    withTParams: Bool,
    className: Name,
    targs: Array<TType>,
  ): (this, Class) {
    if (visitedClasses.contains(className.value)) {
      error(Array[(className.pos, "Cyclic class definition")]);
    };
    !visitedClasses = visitedClasses.set(className.value);
    defs = this.defMap.getAll(tcenvb, className);
    defsCls = defs.filterMap(def ->
      def match {
      | cls @ Class _ -> Some(cls)
      | _ -> None()
      }
    );
    defsCls.size() match {
    | 0 -> error(Array[(className.pos, "Unbound class")])
    | 1 -> void
    | _ ->
      tcenvb.error(
        Array[
          (className.pos, `Found multiple definitions for class ${className}`),
        ],
      )
    };
    cls = defsCls[0];
    if (
      (withTParams || targs.size() != 0) &&
      targs.size() != cls.tparams.size()
    ) {
      tcenvb.error(
        Array[
          (className.pos, "Invalid number of type arguments"),
          (cls.name.pos, "Class declaration is here"),
        ],
      )
    };
    if (withTParams) {
      for (i => tparam in cls.tparams) {
        targ = if (i < targs.size()) {
          targs[i]
        } else {
          // TypeChecker::class_ rejects classes with defaulted type parameters, but we
          // still reach this code when other defs (e.g. subclasses) keep type-checking
          tparam.default match {
          | None() -> break void
          | Some(d) -> this.normalize(tcenvb, d)
          }
        };
        // Class type arguments are lexical binders for this class expansion.
        !this.bindings[tparam.name.value] = targ
      }
    };
    (this, cls)
  }

  // Returns the type of the constructor, if any.
  private fun addFields(
    subst: mutable Subst,
    acc: mutable Map<FieldNameString, TField>,
    symbolFields: mutable Map<FieldNameString, TField>,
    indexes: mutable Vector<(IndexKeyKinds, TField)>,
    visitedClasses: SortedSet<String>,
    isStatic: ?Array<TypeParam>,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool,
  ): ?TFuns {
    (!this, cls) = this.processClassSetup(
      subst,
      visitedClasses,
      isStatic is None(),
      className,
      targs,
    );
    for (extend in cls.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        _ = this.addFields(
          subst,
          acc,
          symbolFields,
          indexes,
          visitedClasses,
          isStatic,
          parentName,
          if (isStatic is Some _) Array[] else {
            paramTArgs.map(targ -> this.normalize(subst, targ))
          },
          filter,
        )
      | _ -> subst.error(Array[(extend.pos, "Unexpected extend")])
      }
    };
    constructor: ?TFuns = None();
    fields = this.getClassFields(subst.context, cls);
    for (fieldType in fields) {
      fieldType match {
      | field @ ClassFieldValue _ ->
        if (!filter(field)) continue;
        fieldIsStatic = false;
        fieldIsReadonly: ?PosRange = None();
        fieldAccess: FieldAccess = FAPublic();
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic _ -> !fieldIsStatic = true
          | ModReadonly(roPos) -> !fieldIsReadonly = Some(roPos)
          | ModPublic _ -> void /* public is the default */
          | ModPrivate _ -> !fieldAccess = FAPrivate(cls.name)
          | ModProtected _ -> void /* protected is silently treated as public */
          | mod ->
            subst.error(
              Array[
                (
                  modifier.pos,
                  `TODO: field modifier '${mod}' (TEnv#addFields)`,
                ),
              ],
            )
          }
        };
        if (fieldIsStatic != isStatic.isSome()) continue;
        if (fieldIsStatic) {
          if (fieldIsReadonly is None()) {
            subst.error(Array[(field.pos, "Static fields must be readonly")])
          };
          field.optional.each(pos ->
            subst.error(Array[(pos, "Static fields cannot be optional")])
          )
        };
        // Static readonly fields are the class-level analog of a top-level
        // const — `unique symbol` is permitted there, so propagate the flag.
        // Also propagate the qualified display name so the encoded id here
        // matches the one minted at validateToplevelConst (declaration site).
        isTopLevelConst = fieldIsStatic && fieldIsReadonly is Some _;
        displayName = if (isTopLevelConst) {
          field.name match {
          | FNNormal(fdName) -> Some(`${className.value}.${fdName.value}`)
          | _ -> None()
          }
        } else {
          None()
        };
        type: TType = field.type match {
        | Some(ty) -> this.normalize(subst, ty, isTopLevelConst, displayName)
        | None() ->
          // No annotation: synthesize a placeholder TInst whose name
          // isn't resolvable, so any later attempt to use the field's
          // type surfaces a clear error mentioning the missing
          // annotation. The placeholder carries the class's current
          // type arguments so two instances of the same generic class
          // with different type arguments produce non-equal placeholders
          // (e.g. C<number>.x and C<string>.x are incompatible). The
          // declaration-time "Type annotation expected" error is
          // reported by TypeChecker#class_, which doesn't run for
          // ambient (declare-wrapped) classes — that's how ambient
          // classes get to omit the type on a private field.
          TType::inst(
            Name(
              field.pos,
              `${kMissingTypeAnnotationPrefix}${
                className.value
              }_${field.name.getName()}`,
            ),
            TArgs(targs),
          )
        };
        field.name match {
        | FNNormal(fdName) ->
          fieldName = fdName.value;
          f = TField::create{
            pos => field.pos,
            name => fieldName,
            isOptional => field.optional is Some _,
            isReadonly => fieldIsReadonly,
            type,
            access => fieldAccess,
          };

          acc![f.name] = f
        | FNColon(indexName, indexType) ->
          keyType = this.normalize(subst, indexType);
          keyKinds = this.resolveIndexKeyKinds(subst, indexName.pos, keyType);
          indexes.push(
            (
              keyKinds,
              TField::create{
                pos => indexName.pos,
                name => indexName.value,
                isOptional => true,
                isReadonly => fieldIsReadonly,
                type,
                access => FAPublic(),
              },
            ),
          )
        | _ -> subst.error(Array[(field.pos, "Unsupported field name")])
        }
      | fd @ ClassFieldMethod{name => FNNormal(Name(fdPos, "constructor"))} ->
        if (isStatic is None()) continue;
        constructor match {
        | Some(constructorTy) ->
          subst.error(
            Array[
              (fdPos, "Unexpected multiple constructors"),
              (constructorTy.pos, "Previous constructor was here"),
            ],
          )
        | None() -> void
        };
        !constructor = Some(
          this.makeConstructor(subst, className, isStatic.fromSome(), fd),
        )
      | fd @ ClassFieldMethod _ ->
        metIsStatic = fd.isStatic();
        if (metIsStatic != isStatic.isSome()) continue;
        cgNode = CGNode::create(Method(fd.name, className, metIsStatic));
        metTFuns = this.funDecl(subst, !metIsStatic, fd, cgNode);
        metType = TType::single(TObject::createCall(metTFuns));
        metAccess: FieldAccess = FAPublic();
        for (modifier in fd.modifiers.modifiers) {
          modifier match {
          | ModPrivate _ -> !metAccess = FAPrivate(cls.name)
          | _ -> void
          }
        };
        fd.name match {
        | FNNormal(name) -> FKName(name, TString())
        | FNComputed(keyExpr) -> this.resolveComputedKeyFieldKey(subst, keyExpr)
        } match {
        | FKSymbol(exprPos, uniqueId) ->
          field = TField::create{
            pos => exprPos,
            name => uniqueId,
            isOptional => false,
            isReadonly => Some(exprPos),
            type => metType,
            access => metAccess,
          };

          symbolFields![field.name] = field
        | FKName(name, _) ->
          field = TField::create{
            pos => name.pos,
            name => name.value,
            isOptional => false,
            isReadonly => Some(name.pos),
            type => metType,
            access => metAccess,
          };

          acc![field.name] = field
        }
      }
    };
    constructor
  }

  private fun findConstructor(
    subst: mutable Subst,
    visitedClasses: SortedSet<String>,
    className: Name,
    tparams: Array<TypeParam>,
    targs: Array<TType>,
  ): ?TFuns {
    this.findConstructorMethod(
      subst,
      visitedClasses,
      className,
      tparams,
      targs,
    ) match {
    | None() -> None()
    | Some((tenv, fd)) ->
      Some(tenv.makeConstructor(subst, className, tparams, fd))
    }
  }

  private fun findConstructorMethod(
    subst: mutable Subst,
    visitedClasses: SortedSet<String>,
    className: Name,
    tparams: Array<TypeParam>,
    targs: Array<TType>,
  ): ?(this, ClassFieldMethod) {
    (!this, cls) = this.processClassSetup(
      subst,
      visitedClasses,
      true,
      className,
      targs,
    );
    clsFields = this.getClassFields(subst.context, cls);
    for (fieldType in clsFields) {
      fieldType match {
      | fd @ ClassFieldMethod _ if (
        fd.name is FNNormal(Name(_, "constructor"))
      ) ->
        return Some((this, fd))
      | _ -> void
      }
    };
    for (extend in cls.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        return this.findConstructorMethod(
          subst,
          visitedClasses,
          parentName,
          tparams,
          paramTArgs.map(targ -> this.normalize(subst, targ)),
        )
      | _ -> subst.error(Array[(extend.pos, "Unexpected extend")])
      }
    };
    None()
  }

  // Normalizes constructor signatures by making type parameters and
  // return types explicit.  For example, in a generic class A<T> {
  // constructor() {} }, the constructor is transformed into:
  // constructor<T>(...): A<T> This ensures constructors reflect their
  // class's type parameters and return type.

  fun makeConstructor(
    tcenvb: mutable TCEnvBase,
    className: Name,
    tparams: Array<TypeParam>,
    fd: ClassFieldMethod,
  ): TFuns {
    cgNode = CGNode::create(Method(fd.name, className, true));
    !tparams = tparams.map(x -> {
      // We give the tparams a different name to make sure they are
      // not confused with the type parameters of the class
      !x.id = x.id.prefixWith("$");
      x
    });
    sig = this.getFunSig(tcenvb.context, fd);
    params = sig.params.map(this.convertParam);
    sig.retType.i1 match {
    | None() -> // constructor
      void
    | Some(x) ->
      tcenvb.error(Array[(x.pos, "Unexpected annotation for constructor")])
    };
    retTypePos = className.pos;
    retType = Type(
      retTypePos,
      TAInst(
        Name(retTypePos, className.value),
        tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[]))),
      ),
    );
    tafun = TAFun(false, tparams, params, retType, cgNode);
    this.normalizeFun(tcenvb, fd.name.getPos(), tafun)
  }

  private fun convertParam(param: Param): TAFunParam {
    ty = param.type match {
    | None() -> error(Array[(param.pos, "Missing type annotation")])
    | Some(ty) -> ty
    };
    optional = param.default match {
    | None() -> param.optional
    | Some(defaultExpr) -> Some(defaultExpr.pos)
    };
    TAFunParam(param.isRest, param.name, optional, ty)
  }

  fun funDecl(
    tcenvb: mutable TCEnvBase,
    isMethod: Bool,
    fd: FunDef<FunDefName>,
    cgNode: CGNode,
  ): TFuns {
    sig = this.getFunSig(tcenvb.context, fd);
    retType = sig.retType match {
    | (pos, None()) ->
      // constructors must use makeConstructor
      error(
        Array[
          (pos, `Missing return type annotation for '${fd.name.getName()}'`),
        ],
      )
    | (_, Some(x)) -> x
    };
    tafun = TAFun(
      isMethod,
      sig.tparams,
      sig.params.map(this.convertParam),
      retType,
      cgNode,
    );
    this.normalizeFun(tcenvb, fd.name.getPos(), tafun)
  }

  // Normalizes a type annotation.
  // When isTopLevelConst is true, allows unique symbol type (only permitted
  // in top-level const declarations, class static readonly members, and
  // imported const bindings).
  // displayName, when present, is the binding name attached to a top-level
  // unique symbol. It is encoded into the unique-symbol identifier so the
  // pretty printer can render the type as `typeof <name>` instead of the
  // hash-based internal id.
  fun normalize(
    tcenvb: mutable TCEnvBase,
    typeAst: Type,
    isTopLevelConst: Bool = false,
    displayName: ?String = None(),
  ): TType {
    pos = typeAst.pos;
    typeAst.value match {
    | TABigIntLiteral(x) -> TType::single(TPrimValue::single(TBigInt(), x, pos))
    | TAAssertIs _ -> error(Array[(pos, "TODO assertIs")])
    | TAAbstract _ -> error(Array[(pos, "TODO abstract")])
    | TAUniqueSymbol() ->
      if (isTopLevelConst) {
        // Each unique symbol gets a distinct type based on its position.
        // Format: unique_symbol:<filePath>:<symbol>:<relStart>:<displayName>
        // - filePath + symbol + relStart together provide identity
        //   (uniqueness across declarations).
        // - <symbol> is `SymbolicPos::toString` — e.g. `constant(uniqueA)`,
        //   `class(MyClass)` — so the encoded id is human-meaningful in
        //   debug contexts and can be surfaced for anonymous cases.
        // - displayName, when non-empty, lets the renderer show the type
        //   as `typeof <displayName>`.
        uniqueId = `unique_symbol:${pos.fileName}:${pos.symbol}:${
          pos.relStart.value
        }:${displayName.default("")}`;
        TType::single(TPrimValue::single(TSymbol(), uniqueId, pos))
      } else {
        error(Array[(pos, "unique symbol type cannot be used here")])
      }
    | TAAsserts _ -> error(Array[(pos, "TODO asserts")])
    | TAIs _ -> error(Array[(pos, "TODO is ")])
    | TAKeyOf(ty) ->
      subst = Subst::mcreate(tcenvb);
      targetType = this.normalize(tcenvb, ty);
      this.keyOfType(subst, targetType, pos)
    | tafun @ TAFun _ ->
      tfuns = this.normalizeFun(tcenvb, pos, tafun);
      TType::single(TObject::createCallWithPos(tfuns, pos))
    | TANew(Type(tyPos, TAFun(_, clauses, params, retType, cgNode))) ->
      tafun = TAFun(false, clauses, params, retType, cgNode);
      tfuns = this.normalizeFun(tcenvb, tyPos, tafun);
      TType::single(TObject::createNew(tfuns, pos))
    | TANew _ -> error(Array[(pos, "Invalid new")])
    | TAEmptyArray _ -> error(Array[(pos, "TODO emptyArray")])
    | TAInfer _ -> error(Array[(pos, "TODO infer")])
    | TATemplate _ -> error(Array[(pos, "TODO template")])
    | TAImport _ -> error(Array[(pos, "TODO import")])
    | TAReadonly(ro) ->
      ro.value match {
      | TAArray(ty) ->
        TType::inst(
          Name(pos, "ReadonlyArray"),
          TArgs(Array[this.normalize(tcenvb, ty)]),
        )
      | TAInst(Name(_, "Array"), arr) ->
        if (arr.size() != 1) {
          tcenvb.error(Array[(pos, "Array expects 1 type parameter")])
        };
        elemType = if (arr.isEmpty()) {
          TType::top(pos)
        } else {
          this.normalize(tcenvb, arr[0])
        };
        TType::inst(Name(pos, "ReadonlyArray"), TArgs(Array[elemType]))
      | TAEmptyArray _ ->
        TType::inst(
          Name(pos, "ReadonlyArray"),
          TArgs(Array[TType::bottom(pos)]),
        )
      | taTuple @ TATuple _ -> this.normalizeTuple(tcenvb, pos, taTuple, true)
      | _ ->
        tcenvb.error(
          Array[
            (
              pos,
              "'readonly' type modifier is only permitted on array and tuple literal types.",
            ),
          ],
        ); // TS1354
        this.normalize(tcenvb, ro)
      }
    | TAExtends _ -> error(Array[(pos, "TODO extends")])
    | TAExtendsQuestion _ -> error(Array[(pos, "TODO extendsQuestion")])
    | TAStringLiteral(x) -> TType::single(TPrimValue::single(TString(), x, pos))
    | TANumLiteral(x) -> TType::single(TPrimValue::single(TNum(), x, pos))
    | TATypeOf(expr) -> this.typeOfExpr(tcenvb, expr)
    | TAPrim(kind) ->
      TType::single(
        kind match {
        | TPKNull() -> TPrimUnit(TNull(), pos)
        | TPKBool() -> TPrimValue::boolean(pos)
        | TPKNum() -> TPrimValue::number(pos)
        | TPKString() -> TPrimValue::string(pos)
        | TPKBigInt() -> TPrimValue::bigint(pos)
        | TPKSymbol() -> TPrimValue::symbol(pos)
        },
      )
    | TAObject(fields) ->
      tFields = this.createTFields(tcenvb, fields, isTopLevelConst);
      TType::single(TObject::createSingleBranch(tFields, None(), pos))
    | TAInst(Name(p, "object"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      TType::single(TObject::createEmpty(pos))

    | TAArray(ty) ->
      TType::inst(Name(pos, "Array"), TArgs(Array[this.normalize(tcenvb, ty)]))

    | TAInst(Name(p, "void"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      TType::single(TPrimUnit(TVoid(), pos))
    | TAInst(Name(p, "undefined"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      TType::single(TPrimUnit(TUndefined(), pos))
    | TAInst(Name(p, "Promise"), targs) ->
      if (targs.size() != 1) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      tArg = if (targs.size() >= 1) {
        this.normalize(tcenvb, targs[0])
      } else {
        TType::top(pos)
      };
      TType::single(TPromise(tArg, pos))
    | TAInst(Name(p, "unknown"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      TType::top(pos)
    | TAInst(Name(p, "never"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      TType::bottom(pos)
    | TAInst(Name(p, x @ "true"), targs)
    | TAInst(Name(p, x @ "false"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(Array[(p, "Invalid number of type arguments")])
      };
      TType::single(TPrimValue::single(TBool(), x, pos))
    | TAInst(n, targs) ->
      // Resolve via lexical bindings (see `bindings` field doc).
      this.bindings.maybeGet(n.value) match {
      | Some(boundTy) ->
        // If n resolves to a bound type parameter, n<targs> is invalid
        // (example: class C<T> { value: T<number> }).
        if (targs.size() != 0) {
          tcenvb.error(
            Array[
              (
                n.pos,
                "A bound occurrence of a type parameter cannot have type arguments",
              ),
            ],
          )
        };
        boundTy.withPos(pos)

      | None() if (this.forbiddenInsts.contains(n.value)) ->
        error(Array[(n.pos, "Cyclic definition")])
      | None() ->
        // No bound-name match: treat n as a named type definition.
        tdef = this.defMap.getType(tcenvb, n);
        tparams = tdef match {
        | TypeDef{tdefParams} -> tdefParams
        | Class{tparams} -> tparams
        | Enum _ -> Array[]
        };
        if (
          targs.size() > tparams.size() ||
          (targs.size() < tparams.size() &&
            tparams[targs.size()].default is None())
        ) {
          tcenvb.error(
            Array[
              (
                n.pos,
                `Invalid number of type arguments: given ${targs.size()}, expected ${tparams.size()}`,
              ),
            ],
          )
        };

        if (this.seenInstantiate.contains(n.value)) {
          !this.forbiddenInsts = this.forbiddenInsts.set(n.value)
        };
        TType::inst(n, TArgs(targs.map(x -> this.normalize(tcenvb, x))))
      }
    | TAUnion(ty1, ty2) ->
      subst = Subst::mcreate(tcenvb);
      TType::union(
        subst,
        this,
        this.normalize(tcenvb, ty1),
        this.normalize(tcenvb, ty2),
      ).withPos(pos)
    | TAInter(ty1, ty2) ->
      subst = Subst::mcreate(tcenvb);
      TType::inter(
        subst,
        this,
        this.normalize(tcenvb, ty1),
        this.normalize(tcenvb, ty2),
      ).withPos(pos)
    | taTuple @ TATuple _ -> this.normalizeTuple(tcenvb, pos, taTuple, false)
    | TAGet _ -> error(Array[(pos, "TODO TAGet")])
    }
  }

  private fun normalizeTuple(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    taTuple: TATuple,
    isReadonly: Bool,
  ): TType {
    if (isReadonly) {
      tcenvb.error(Array[(pos, "TODO readonly")])
    };
    tupleElts = taTuple match {
    | TATuple(elts) -> elts
    };
    types = tupleElts.map(ty ->
      ty match {
      | TEType(n, optional, x) ->
        if (n is Some _) tcenvb.error(Array[(pos, "TODO named tuple")]);
        if (optional is Some _) {
          tcenvb.error(Array[(pos, "TODO optional element tuple")])
        };
        this.normalize(tcenvb, x)
      | TESpread _ -> error(Array[(pos, "TODO tuple spread")])
      }
    );
    TType::tuple(pos, types, isReadonly)
  }

  private fun isValidTypeofExpr(expr: Expr): Bool {
    expr.value match {
    | Var(_) -> true
    | Dot(_, baseExpr, _) -> this.isValidTypeofExpr(baseExpr)
    | _ -> false
    }
  }

  fun typeOfExpr(tcenvb: mutable TCEnvBase, expr: Expr): TType {
    (this, tcenvb) match {
    | (tc @ TypeChecker _, tcenv @ TCEnv _) ->
      // Validate structure first - only Var and Dot allowed
      if (!this.isValidTypeofExpr(expr)) {
        tcenvb.error(
          Array[
            (
              expr.pos,
              "typeof operand must be an identifier or property access",
            ),
          ],
        )
      };
      return tc.expr(tcenv, expr, false)
    | _ -> void
    };
    expr.value match {
    | Var(Name(_, "undefined")) ->
      TType::single(TPrimUnit(TUndefined(), expr.pos))
    | Var(varName) ->
      for (def in this.defMap.getAll(tcenvb, varName)) {
        def match {
        | FDVar(kind, _, Some(t), _) ->
          return this.normalize(
            tcenvb,
            t,
            kind is VDKConst _,
            Some(varName.value),
          )
        | fd @ TopLevelFunDef _ ->
          cgNode = fd.cgNode.fromSome();
          return TType::single(
            TObject::createCall(this.funDecl(tcenvb, false, fd, cgNode)),
          )
        | Class _ ->
          subst = Subst::mcreate(tcenvb);
          return this.newStatic(subst, varName)
        | _ -> void
        }
      };
      error(Array[(varName.pos, `Variable ${varName} not found`)])
    | Dot(_, baseExpr, propertyName) ->
      if (propertyName.value == "prototype") {
        notSupported(propertyName.pos, "prototype access")
      };
      baseType = this.typeOfExpr(tcenvb, baseExpr);
      subst = Subst::mcreate(tcenvb);
      baseType.getSTypes(subst, this, Covariant()).flatMap(sTypes ->
        sTypes.singleElt()
      ) match {
      | Some(obj @ TObject _) ->
        obj.getType(subst, this, propertyName.value, expr.pos)
      | _ ->
        error(
          Array[
            (
              propertyName.pos,
              `Cannot get type for property of non-object type ${prettyPrintType(
                false,
                baseType,
                subst,
                this,
              )}`,
            ),
          ],
        )
      }
    | _ ->
      error(
        Array[
          (expr.pos, "typeof operand must be an identifier or property access"),
        ],
      )
    }
  }

  // Resolve Symbol.iterator's unique ID via synthetic expression
  fun getSymbolIteratorUniqueId(subst: mutable Subst, pos: PosRange): ?String {
    symbolExpr = Expr(pos, Var(Name(pos, "Symbol")));
    iteratorExpr = Expr(
      pos,
      Dot(NormalDot(), symbolExpr, Name(pos, "iterator")),
    );
    iteratorSymType = this.typeOfExpr(subst, iteratorExpr);
    iteratorSymType.getSTypes(subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TSymbol(), Some(lits), _)) ->
      lits.singleElt().map(lit -> lit.val)
    | _ -> None()
    }
  }

  fun resolveIndexKeyKinds(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    keyType: TType,
  ): IndexKeyKinds {
    subst = Subst::mcreate(tcenvb);
    hasString = false;
    hasNumber = false;
    hasSymbol = false;
    valid = keyType.getSTypes(subst, this, Covariant()) match {
    | Some(stypes) ->
      stypes.all(stype ->
        stype match {
        | TPrimValue(TString(), None(), _) ->
          !hasString = true;
          true
        | TPrimValue(TNum(), None(), _) ->
          !hasNumber = true;
          true
        | TPrimValue(TSymbol(), None(), _) ->
          !hasSymbol = true;
          true
        | _ -> false
        }
      )
    | None() -> false
    };
    if (valid) {
      IndexKeyKinds::create{hasString, hasNumber, hasSymbol} match {
      | Some(res) -> return res
      | None() -> void
      }
    };
    error(
      Array[
        (
          pos,
          "An index signature parameter type must be string, number, or symbol",
        ),
      ],
    )
  }

  fun getIteratorElementType(
    subst: mutable Subst,
    tObj: TObject,
    pos: PosRange,
  ): ?TType {
    // Step 1: Look up [Symbol.iterator] symbol field
    iteratorMethodType = this.getSymbolIteratorUniqueId(subst, pos).flatMap(
      uniqueId -> tObj.maybeGetSymbolType(subst, this, uniqueId, pos, false),
    ) match {
    | Some(t) -> t
    | None() -> return None()
    };

    // Step 2: Get return type of calling [Symbol.iterator]()
    iteratorType = iteratorMethodType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetRetType(subst, this) match {
      | Some(retType) -> retType
      | None() -> return None()
      }
    | _ -> return None()
    };

    // Step 3: Look up "next" on the iterator object
    nextMethodType = iteratorType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetType(subst, this, "next", pos) match {
      | Some(t) -> t
      | None() -> return None()
      }
    | _ -> return None()
    };

    // Step 4: Get return type of calling next()
    nextResultType = nextMethodType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetRetType(subst, this) match {
      | Some(retType) -> retType
      | None() -> return None()
      }
    | _ -> return None()
    };

    // Step 5: Look up "value" on {value: T, done: boolean}
    nextResultType.getSTypes(subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetType(subst, this, "value", pos)
    | _ -> None()
    }
  }

  fun normalizeFun(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    tafun: TAFun,
  ): TFuns {
    tafun match {
    | TAFun(isMethod, tParams, params, retType, cgNode) ->
      subst = Subst::mcreate(tcenvb);
      TypeChecker::checkTypeParams(
        tcenvb,
        tParams,
        OptionalTypeParamsForbidden(),
      );
      funTParams = tParams.map(tparam -> {
        // invariant(
        //   tparam.default is None(),
        //   "no-default type parameter (already checked in checkTypeParams)",
        // );
        funTParam = this.makeTParam(tcenvb, tparam);
        // Bind the method-local tparam, overwriting any same-named
        // outer class/type-def instantiation binding. This gives the
        // method its own scope for `tparam.name.value` within its
        // signature. (#606)
        !this.bindings[tparam.name.value] = TType::fromTParamWithConstraint(
          subst,
          this,
          tparam.name.pos,
          funTParam,
        );
        funTParam
      });
      normalParams = mutable Vector[];
      optionalParams = mutable Vector[];
      optionalWitness: ?PosRange = None();
      spreadParam: ?TType = None();
      thisParam: ?TType = None();
      for (i => param in params) {
        paramType = this.normalize(tcenvb, param.type);
        param.name.value match {
        | PVar(Name(thisPos, "this")) ->
          if (i > 0) {
            tcenvb.error(
              Array[(thisPos, "Parameter named this must be the first one")],
            );
            continue
          };
          invariant(thisParam is None(), "Assigning thisParam multiple times");
          param.isRest.each(restPos ->
            tcenvb.error(Array[(restPos, "this cannot be a rest parameter")])
          );
          param.optional.each(optPos ->
            tcenvb.error(Array[(optPos, "this cannot be optional")])
          );
          !thisParam = Some(paramType);
          continue
        | _ -> checkPatternDoesNotContainThis(param.name)
        };
        param.isRest match {
        | Some(restPos) ->
          param.optional match {
          | Some(optPos) ->
            tcenvb.error(Array[(optPos, "A rest parameter cannot be optional")])
          | None() -> void
          };
          !spreadParam = Some(TType::arrayToReadonlyArray(paramType));
          VariadicTyping::checkRestParamReadonly(
            tcenvb,
            this,
            restPos,
            param.type,
            tParams,
          );
          if (i != params.size() - 1) {
            tcenvb.error(
              Array[
                (restPos, "A rest parameter must be last in a parameter list"),
              ],
            );
            break void
          };
          continue
        | None() -> void
        };
        param.optional match {
        | None() ->
          optionalWitness match {
          | None() -> void
          | Some(wpos) ->
            tcenvb.error(
              Array[
                (param.type.pos, "This parameter is not optional"),
                (wpos, "It appears after this parameter that is optional"),
              ],
            )
          };
          normalParams.push(paramType)
        | Some(wpos) ->
          !optionalWitness = Some(wpos);
          optionalParams.push(
            TType::unionUndefined(subst, this, paramType, wpos),
          )
        }
      };
      tfun = TFun(
        funTParams,
        thisParam,
        normalParams.toArray(),
        optionalParams.toArray(),
        spreadParam,
        this.normalize(tcenvb, retType),
        CGNodes::singleton(cgNode),
      );
      if (isMethod) {
        TFuns::singleMethod(tfun, pos)
      } else {
        TFuns::singleFun(tfun, pos)
      }
    }
  }

  // Resolve a computed key expression to a FieldKey.
  private fun resolveComputedKeyFieldKey(
    tcenvb: mutable TCEnvBase,
    keyExpr: Expr,
  ): FieldKey {
    keyType = this.typeOfExpr(tcenvb, keyExpr);
    subst = Subst::mcreate(tcenvb);
    keyType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes -> stypes.singleElt())
      .flatMap(stype -> FieldKey::ofSType(keyExpr.pos, stype)) match {
    | Some(res) -> res
    | None() ->
      error(
        Array[
          (
            keyExpr.pos,
            "Computed property key must be a literal or unique symbol",
          ),
        ],
      )
    }
  }

  private fun createTFields(
    tcenvb: mutable TCEnvBase,
    fieldTypes: Array<ObjectField>,
    isTopLevelConst: Bool = false,
  ): TFields {
    fieldsMap = mutable Map[];
    symbolFields = mutable Map[];
    indexes = mutable Vector[];
    call: ?TFuns = None();
    new: ?TFuns = None();

    for (elt in fieldTypes) {
      elt match {
      | fd @ ObjectFieldValue{readonly_} ->
        readonly_.each(r ->
          if (r is OFRemoveReadonly _ && !(fd.name is FNIn _)) {
            tcenvb.error(
              Array[
                (r.pos, "'-readonly' modifier can only appear in mapped types"),
              ],
            )
          }
        );
        fieldTy = fd.type match {
        | None() ->
          error(
            Array[
              (fd.pos, `Type annotation expected for '${fd.name.getName()}'`),
            ],
          )
        | Some(ty) -> ty
        };
        fd.name match {
        | FNIn(boundName, kType, asOpt, op) ->
          if (asOpt.isSome()) {
            tcenvb.error(
              Array[(fd.pos, "Mapped type 'as' clause is not supported yet")],
            )
          };
          isFieldOptional = op match {
          | None() -> false
          | Some(FNQuestion _)
          | Some(FNAdd _) ->
            true
          | Some(FNRemove _) -> false
          };
          keyTType = this.normalize(tcenvb, kType);
          subst = Subst::mcreate(tcenvb);
          hasString = false;
          hasNumber = false;
          hasSymbol = false;
          namedLiterals = mutable Vector[];
          symbolLiterals = mutable Vector[];
          // K resolves either to a concrete supported shape, an abstract type
          // parameter (TParam in clause.vars / TVar in insts), or an unsupported
          // shape (e.g. boolean). Abstract K is silently skipped only during
          // type-def validation so that generic mapped-type aliases like
          //   type Record<K extends string | number | symbol, V> = { [P in K]: V }
          // pass validation; in any other context (e.g. instantiation with an
          // outer type parameter) an abstract K is reported. Unsupported
          // shapes always error.
          isAbstract = false;
          shapeOk = keyTType.expandToVectors(subst, this, None()) match {
          | None() ->
            false // K expanded to Top (e.g. any/unknown) — unsupported
          | Some((insts, clauses)) ->
            ok = insts.isEmpty();
            for (clause in clauses) {
              if (!clause.vars.isEmpty()) !isAbstract = true;
              clause.stypes match {
              | None() -> !ok = false
              | Some(stypes) ->
                for (stype in stypes) {
                  stype match {
                  | TPrimValue(TString(), None(), _) -> !hasString = true
                  | TPrimValue(TNum(), None(), _) -> !hasNumber = true
                  | TPrimValue(TSymbol(), None(), _) -> !hasSymbol = true
                  | TPrimValue(TString(), Some(lits), _)
                  | TPrimValue(TNum(), Some(lits), _) ->
                    for (lit in lits.values()) namedLiterals.push(lit.val)
                  | TPrimValue(TSymbol(), Some(lits), _) ->
                    for (lit in lits.values()) symbolLiterals.push(lit.val)
                  | _ -> !ok = false
                  }
                }
              }
            };
            ok
          };
          if (isAbstract) {
            if (!this.inTypeDefValidation) {
              errPos = this.instantiateAt.default(fd.pos);
              tcenvb.error(
                Array[
                  (
                    errPos,
                    "Mapped type with abstract key type is not supported yet",
                  ),
                ],
              )
            }
          } else {
            if (!shapeOk) {
              tcenvb.error(
                Array[(fd.pos, "Mapped type key shape is not supported yet")],
              )
            } else {
              // Bind P to a deliberately-unresolvable inst type. If V references
              // P, expansion later surfaces a clear "Type … not found" error
              // naming the poison alias. For Record (V doesn't reference P),
              // this is a no-op.
              poisonName = Name(
                boundName.pos,
                "SKJS_unsupported_key_type_reference_in_mapped_type_value",
              );
              !this.bindings[boundName.value] = TType::inst(
                poisonName,
                TArgs(Array[]),
              );
              valueType = this.normalize(tcenvb, fieldTy);
              IndexKeyKinds::create{hasString, hasNumber, hasSymbol} match {
              | None() -> void
              | Some(keyKinds) ->
                indexes.push(
                  (
                    keyKinds,
                    TField::create{
                      pos => boundName.pos,
                      name => boundName.value,
                      isOptional => true,
                      isReadonly => None(),
                      type => valueType,
                      access => FAPublic(),
                    },
                  ),
                )
              };
              for (litVal in namedLiterals) {
                field = TField::create{
                  pos => boundName.pos,
                  name => litVal,
                  isOptional => isFieldOptional,
                  isReadonly => None(),
                  type => valueType,
                  access => FAPublic(),
                };
                fieldsMap![field.name] = field
              };
              for (uniqueId in symbolLiterals) {
                field = TField::create{
                  pos => boundName.pos,
                  name => uniqueId,
                  isOptional => isFieldOptional,
                  isReadonly => None(),
                  type => valueType,
                  access => FAPublic(),
                };
                symbolFields![field.name] = field
              }
            }
          }
        | simpleFieldName @ SimpleFieldName _ ->
          normalizedType = this.normalize(tcenvb, fieldTy, isTopLevelConst);
          simpleFieldName match {
          | FNNormal(name) -> FKName(name, TString())
          | FNComputed(keyExpr) ->
            this.resolveComputedKeyFieldKey(tcenvb, keyExpr)
          } match {
          | FKSymbol(exprPos, uniqueId) ->
            field = TField::create{
              pos => exprPos,
              name => uniqueId,
              isOptional => fd.optional is Some _,
              isReadonly => readonly_.map(r -> r.pos),
              type => normalizedType,
              access => FAPublic(),
            };
            symbolFields![field.name] = field
          | FKName(name, _) ->
            field = TField::create{
              pos => name.pos,
              name => name.value,
              isOptional => fd.optional is Some _,
              isReadonly => readonly_.map(r -> r.pos),
              type => normalizedType,
              access => FAPublic(),
            };
            fieldsMap![field.name] = field
          }
        | FNColon(indexName, indexType) ->
          keyType = this.normalize(tcenvb, indexType);
          keyKinds = this.resolveIndexKeyKinds(tcenvb, indexName.pos, keyType);
          valueType = this.normalize(tcenvb, fieldTy);
          indexes.push(
            (
              keyKinds,
              TField::create{
                pos => indexName.pos,
                name => indexName.value,
                isOptional => true,
                isReadonly => readonly_.map(r -> r.pos),
                type => valueType,
                access => FAPublic(),
              },
            ),
          )
        }
      | fd @ ObjectFieldMethod _ ->
        cgNode = CGNode::create(AnonymousFunDef(fd));
        tFuns = this.funDecl(tcenvb, false, fd, cgNode);
        fd.name match {
        | FNNormal(Name(_, "new")) -> !new = Some(tFuns)
        | FNEmpty(_) -> !call = Some(tFuns)
        | simpleFieldName @ SimpleFieldName _ ->
          decl = TType::single(TObject::createCall(tFuns));
          simpleFieldName match {
          | FNNormal(name) -> FKName(name, TString())
          | FNComputed(keyExpr) ->
            this.resolveComputedKeyFieldKey(tcenvb, keyExpr)
          } match {
          | FKSymbol(exprPos, uniqueId) ->
            field = TField::create{
              pos => exprPos,
              name => uniqueId,
              isOptional => false,
              isReadonly => Some(exprPos),
              type => decl,
              access => FAPublic(),
            };
            symbolFields![field.name] = field
          | FKName(name, _) ->
            field = TField::create{
              pos => name.pos,
              name => name.value,
              isOptional => false,
              isReadonly => Some(name.pos),
              type => decl,
              access => FAPublic(),
            };
            fieldsMap![field.name] = field
          }
        }
      }
    };
    tIndexes = TIndexes::create(tcenvb, this, indexes);
    tFields = TFields::create{
      fields => fieldsMap,
      symbolFields,
      tIndexes,
      new,
      call,
    };
    tFields
  }

  /* Over-approximates keyof ty
     Though keyof should be treated symbolically because it is a decreasing
     function of types.
     In particular, do not use keyof to check that a key is valid.

     Try to keep in synch with TypeChecker#get in TypeCheckExpr
  */
  fun keyOfType(subst: mutable Subst, ty: TType, pos: PosRange): TType {
    clauses = ty.expandToClauses(subst, this, Covariant());
    if (
      clauses.any(clause -> (!clause.vars.isEmpty() || clause.stypes is None()))
    ) {
      return TType::union(
        subst,
        this,
        TType::single(TPrimValue(TString(), None(), pos)),
        TType::single(TPrimValue(TNum(), None(), pos)),
      )
    };
    allStrings = false;
    allNumbers = false;
    allSymbols = false;
    maxRange = -1;
    strings = SortedSet[];
    symbols = SortedSet[];
    for (clause in clauses) {
      invariant(clause.vars.isEmpty(), "keyof with non-empty variables");
      stypes = Vector::mcreateFromIterator(clause.stypes.fromSome().values());
      while (!stypes.isEmpty()) {
        stype = stypes.pop();
        stype match {
        | TTuple(tyArr, _) -> !maxRange = max(maxRange, tyArr.size())
        | obj @ TObject(_, _, _) ->
          for (fields in obj.getAllFields()) {
            if (!allStrings || !allNumbers) {
              for (field in fields.fields) {
                !strings = strings.set(field.name.value);
              }
            };
            if (!allSymbols) {
              for (symbolField in fields.symbolFields) {
                !symbols = symbols.set(symbolField.name.value);
              }
            };
            if (fields.stringIndex.isSome()) !allStrings = true;
            if (fields.numberIndex.isSome()) !allNumbers = true;
            if (fields.symbolIndex.isSome()) !allSymbols = true;
          }
        | prim @ TPrimValue _ ->
          obj = this.newObject(subst, prim.asClassName(), Array[]);
          stypes.push(obj)
        | TPrimUnit _ -> void /* bottom */
        | TPromise _ ->
          error(
            Array[
              (
                pos,
                `TODO: keyof ${prettyPrintType(
                  false,
                  TType::single(stype),
                  subst,
                  this,
                )}`,
              ),
            ],
          )
        }
      }
    };
    resultTys = mutable Vector[];
    numbers = if (!allStrings || !allNumbers) {
      SortedSet::createFromItems(Range(0, maxRange).map(i -> i.toString()))
    } else {
      SortedSet[]
    };
    if (allStrings) {
      resultTys.push(TType::single(TPrimValue::string(pos)))
    } else {
      stringsAndNumbers = strings.union(numbers);
      PrimLiterals::ofSet(stringsAndNumbers, pos).each(strLits ->
        resultTys.push(TType::single(TPrimValue(TString(), Some(strLits), pos)))
      )
    };
    if (allNumbers) {
      resultTys.push(TType::single(TPrimValue::number(pos)))
    } else {
      for (str in strings) {
        if (isJSNumericString(str)) !numbers = numbers.set(str)
      };
      PrimLiterals::ofSet(numbers, pos).each(nbrLits ->
        resultTys.push(TType::single(TPrimValue(TNum(), Some(nbrLits), pos)))
      )
    };
    if (allSymbols) {
      resultTys.push(TType::single(TPrimValue::symbol(pos)))
    } else {
      PrimLiterals::ofSet(symbols, pos).each(symLits ->
        resultTys.push(TType::single(TPrimValue(TSymbol(), Some(symLits), pos)))
      )
    };
    TType::unionN(subst, this, pos, resultTys)
  }
}

fun checkPatternDoesNotContainThis(pat: Pattern): void {
  pat.value match {
  | PVar(name) -> Some(name)
  | PArray(elements, rest) ->
    elements.each(elt -> elt.each(pe -> checkPatternDoesNotContainThis(pe.i0)));
    rest
  | PObject{fields, rest} ->
    fields.each(fld -> checkPatternDoesNotContainThis(fld.i1));
    rest
  } match {
  | Some(Name(thisPos, "this")) ->
    error(Array[(thisPos, "this forbidden here")])
  | _ -> void
  }
}

module end;
