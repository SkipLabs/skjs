/***************************************************************************/
// The typing environment.
//
// The typing environment retrieves the abstract syntax tree
// corresponding to a type definition and turns it into a type.
/***************************************************************************/

module SKJS;

value class CstrType(cstr: ?TFuns, tArgs: Array<TType>)

// The number of members past which a template literal type's expansion is
// refused rather than materialized. Matches tsc's union-size limit, which it
// reports as TS2590 (verified: 99,999 members are accepted, 100,000 are not).
// Distinct from kMaxObjectBranches, which bounds object branches, not unions.
const kMaxTemplateUnionSize: Int = 100000;

// What a template literal type's interpolation contributes to the strings the
// template can produce.
base class TemplateHole {
  children =
  // Finitely many values, listed. Empty means the hole is `never`.
  | THFinite(SortedSet<String>)
  // Exactly `string`. Unbounded, but a template that is nothing but bare string
  // holes still reduces -- to `string` itself.
  | THBareString()
  // Unboundedly many values (`number`, `bigint`, an abstract type parameter):
  // representing the result needs a pattern type SKJS does not have.
  | THIrreducible()
  // A type that may not be interpolated at all (object, symbol, void, unknown).
  | THNotStringifiable()
}

base class TEnv{
  // The defMap associates an AST to a type name.
  defMap: IDefMap,

  // Body maps resolve bodyRef references to their bodies.
  funDefSigMap: FunDefSigMap,
  funDefBodyMap: FunDefBodyMap,
  classBodyMap: ClassBodyMap,
  classFieldMap: ClassFieldMap,
  typeDefBodyMap: TypeDefBodyMap,
  methodBodyMap: MethodBodyMap,

  // Lexical bindings for TAInst name resolution, keyed by syntactic
  // name. Distinct from the existential Subst used for TVar unification
  // (cf TVar); this map resolves named references in source types.
  //
  // Each entry maps a name to the TType it currently denotes:
  // - a concretized type argument, while expanding a class/type-def
  //   instantiation (`instantiate`, `processClassSetup`);
  // - an abstract tparam TType, while type-checking a class or function
  //   body (`addTParams`, `normalizeFun`);
  // - the synthetic `"this"` binding (`newObject`, `TypeCheckFun`).
  //
  // Shadowing is last-write-wins: when an inner scope introduces a
  // binding with the same name, it overwrites any outer one. Scope
  // exit requires no explicit restore because `!this = ...` mutations
  // are local to the current frame — the caller keeps its own `this`
  // with the bindings it had on entry.
  //
  // At a TAInst lookup the stored TType is returned with
  // `.withPos(refPos)` so errors point at the reference site.
  bindings: SortedMap<String, TType> = SortedMap[],

  // When expanding a type definition, we don't want to recursively
  // get all the type instances of a type, we only want to go one
  // level deep. Concretely, consider the following type:
  //
  // type foo = { field1: null | foo, field2: number };
  //
  // When we expand foo, we want to get:
  //   { field1: null | foo, field2: number };
  //
  // We don't want the instance of foo to be expanded (because that
  // could be infinite). Instead, the second instance of foo will only
  // be expanded if that turns out to be necessary for the inference.
  // The field "seenInstantiate" enforces the fact that we only expand one
  // level deep by keeping track of the types that we are in the
  // process of expanding.
  seenInstantiate: SortedSet<String> = SortedSet[],

  // The value names currently being resolved through `typeof` in a type
  // position. `typeof v` reads v's declared type, so two values that name each
  // other's `typeof` (`declare const v: typeof w; declare const w: typeof v`)
  // resolve forever without this; on re-entering a name already here, the
  // resolution reports TS2502 and stops. Like `seenInstantiate`, this is only
  // added to below the point it is set, so it scopes itself as the resolution
  // unwinds.
  typeofValues: SortedSet<String> = SortedSet[],

  // This field keeps track of type names that, if used, would define
  // a cyclic type definition.
  forbiddenInsts: SortedSet<String> = SortedSet[],

  // This field keeps track of the intersections that we are in the
  // process of computing. If a cycle occurs, an unexpanded TInter
  // will be returned.
  seenInter: SortedSet<(TType, TType)> = SortedSet[],

  // This field keeps track of the subtyping relations that we are in
  // the process of checking. If a cycle occurs, the subtyping
  // relation is considered correct (by co-induction).
  seenSub: SortedSet<(Int, TType, TType)> = SortedSet[],

  // How deep the current structural subtyping check has recursed on this path.
  // `seenSub` stops a check that returns to an identical pair, but two recursive
  // aliases whose type arguments grow at each level never produce an identical
  // pair, so the descent runs until the stack — or, once it branches, the heap —
  // is gone. Past a shallow bound the pair is assumed related, the way tsc
  // treats a deeply nested type: the finite obligations at each level (a field
  // whose type does not itself recurse) have already been checked, so a
  // mismatch is caught before the bound; only the growing recursive part is
  // assumed, which closes the co-induction. Threaded like `seenSub`, so it is
  // the depth of the current path, and a sibling field is checked in full — a
  // shallow mismatch is never masked.
  subtypingDepth: Int = 0,

  // Controls whether field inter/union operations fully expand intersections.
  // When false (default), defers via unexpandedInter to avoid infinite expansion
  // during normal type operations. Set to true only during TInter expansion
  // in getSTypes (TType.sk) where full expansion is safe and needed.
  expandInter: Bool = false,

  // True while normalizing a generic type-alias body for definition-time
  // validation (TypeCheckDef.typeDef). Mapped-type expansion treats abstract
  // K silently in this mode so that aliases like
  //   type Record<K extends ..., V> = { [P in K]: V }
  // pass validation; outside this mode an abstract K is reported as
  // "not supported yet".
  inTypeDefValidation: Bool = false,

  // The use-site position when normalizing an instantiated type-alias body.
  // FNIn uses this so that errors in stub-defined mapped types (like Record)
  // surface at the user's call site rather than in the stub.
  instantiateAt: ?PosRange = None(),

  // Mirrors the `--verbose` CLI flag. Read by the pretty-printer to opt out
  // of hiding internal-only details: the synthetic index name on object
  // literals (see kSyntheticIndexName and TypePp::renderObjectMembers) and
  // the qualified type-parameter id, name:counter:file-hash (see
  // TypePp::tparamName).
  verbose: Bool = false,
} {
  // Renders a type for embedding in diagnostic prose, quoted per tsc's
  // `Type 'X'` convention (see quoteRenderedType). For a raw rendering
  // (non-diagnostic contexts) call prettyPrintType directly.
  fun ppType(tcenv: mutable TCEnv, ty: TType): String {
    quoteRenderedType(prettyPrintType(false, ty, tcenv.subst, this))
  }

  // Given a type name and type arguments, first retrieves the type
  // definition (using the defMap) and then produces a type where the
  // type parameters have been replaced with the corresponding type
  // arguments (as expected).
  fun instantiate(
    tcenvb: mutable TCEnvBase,
    baseSubst: readonly Subst,
    name: Name,
    targs: TArgs,
  ): TType {
    // Synthetic placeholder for a class field with no type annotation
    // (see addFields). It has no defMap entry, so it head-expands to an
    // opaque type parameter: a subtype of nothing but itself and `unknown`,
    // with nothing but itself a subtype of it. Returning the identity inst
    // here instead would let the expansion worklist's seen-set dedup drop
    // the re-emitted inst, collapsing the field to `never` (bottom) so a
    // read is unsoundly accepted into any target type (issue #775). The
    // unexpanded field type stays a TInst named for the missing annotation,
    // so error messages and `__SKJS_show` still surface that name.
    if (name.value.startsWith(kMissingTypeAnnotationPrefix)) {
      return TType::missingAnnotationPlaceholder(name);
    };
    // We are dealing with a recursive instance, if we keep on
    // unfolding, we will end up in an infinite loop. Instead, we
    // produce a type that can be later lazily unfolded if need be.
    if (this.seenInstantiate.contains(name.value)) {
      return TType::inst(name, targs);
    };
    !this.seenInstantiate = this.seenInstantiate.set(name.value);

    tdef = this.defMap.getType(tcenvb, name);

    subst = Subst::mcreate(tcenvb, baseSubst);
    tdef match {
    | ta @ TypeDef{tdefParams} ->
      // An alias that requires itself denotes nothing, and unfolding it need
      // not terminate: `type P<T> = Q<T>; type Q<T> = P<Q<T>>` rewrites to a
      // strictly bigger instantiation on every turn, so no instantiation ever
      // repeats for a caller's seen-set to catch — expandToVectors loops and
      // collectTVars recurses until the stack is gone (issue #883). The guard
      // above cannot see this: it is keyed by name, and `this` is a value, so
      // the name it records is visible only to the unfolding below it, not to
      // the caller that unfolds the type handed back.
      //
      // Hand back the unexpanded instantiation, exactly as the guard above
      // does. It costs nothing that was not already lost — with no clauses it
      // is the empty type either way — and the alias is reported at its own
      // declaration (TS2456, issue #874).
      if (this.isCircularTypeDef(tcenvb.context, ta)) {
        return TType::inst(name, targs);
      };
      !this = this.instantiateTParams(subst, name.pos, targs.targs, tdefParams);
      !this.instantiateAt = Some(name.pos);
      this.normalize(tcenvb, this.getTypeDefBody(tcenvb.context, ta))
    | Class _ -> this.new(subst, name, targs.targs)
    | en @ Enum _ -> this.enumUnionType(subst, en)
    // Enum-member types (`E.A`) are resolved directly in normalize and never
    // wrapped in a TInst, so instantiate never receives one.
    | EnumMemberDef _ ->
      invariant_violation("enum member types are not instantiated")
    }
  }

  // Binds each type parameter to its corresponding type argument, checking the
  // argument against the parameter's constraint along the way.
  //
  // Soundness of the constraint check:
  //  - For a CONCRETE type argument the check is exact and fires on a real
  //    violation. This is the only place explicit class type arguments are
  //    validated: `new C<number>()` for `class C<V extends string>` reaches
  //    here via new -> newObject -> processClassSetup, and the `New` branch in
  //    TypeCheckExpr normalizes each argument individually without checking it
  //    against the constraint, while normalize's reference-site check fires only
  //    on type *references* (`C<number>` in a type position), not on `new`
  //    expressions. So this check is load-bearing, not redundant.
  //  - For an UNBOUND inference-variable argument the check is vacuous: isSub
  //    grows the variable on the throwaway clone to satisfy the constraint, then
  //    discards the growth. This is still sound, because such a variable only
  //    reaches here from a well-formed declaration, and well-formedness forces
  //    the variable to already carry a constraint at least as strong. A
  //    signature `f<V extends C>(x: Alias<V>)` normalizes V to `V & C` (see
  //    fromTParamWithConstraint and TTypeInter's setConstraint), so the
  //    inference variable carries C as its own constraint, enforced at growth
  //    (growTVars / Subst::get) independently of the discarded clone growth. An
  //    UNCONSTRAINED V flowing into a constrained alias parameter never gets
  //    this far: it is rejected at the declaration by normalize's reference-site
  //    check (the rigid TParam V fails C there).
  private fun instantiateTParams(
    subst: mutable Subst,
    pos: PosRange,
    tArgs: Array<TType>,
    tParams: Array<TypeParam>,
  ): this {
    tcenvb: mutable TCEnvBase = subst;

    if (tArgs.size() > tParams.size()) {
      tcenvb.error(
        Array[
          (
            pos,
            `Expected ${tParams.size()} type arguments, but got ${tArgs.size()}`,
          ),
        ],
        TSCode(2707),
      )
    };

    for (i => tParam in tParams) {
      tArg = if (i < tArgs.size()) tArgs[i] else {
        tParam.default match {
        | Some(default) -> this.normalize(tcenvb, default)
        | None() ->
          tcenvb.error(
            Array[
              (
                pos,
                `Expected ${tParams.size()} type arguments, but got ${tArgs.size()}`,
              ),
            ],
            TSCode(2707),
          );
          break void
        }
      };
      tParam.constraint match {
      | None() -> void
      | Some(cstr) ->
        cstrTy = this.normalize(tcenvb, cstr);
        // Clone substitution: constraint checking should verify compatibility
        // but NOT permanently grow type variables. Growing here would close the
        // variable to its constraint, preventing later unification with more
        // specific types (e.g., TVar<:Json should remain open to unify with
        // string). For an unbound inference-variable argument this makes the
        // check vacuous, which is sound — see the constraint-check soundness
        // note on this function.
        TType::isSub(subst.clone(), this, tArg, cstrTy) match {
        | STOk() -> void
        | err @ STErrorOnTType _ ->
          tcenvb.subtypingError(
            subst,
            this,
            Array[
              (pos, "Type argument does not satisfy the constraint"),
              (
                tArg.pos,
                `This is of type: ${quoteRenderedType(
                  prettyPrintType(false, tArg, subst, this),
                )}`,
              ),
              (
                cstr.pos,
                `It does not satisfy the constraint: ${quoteRenderedType(
                  prettyPrintType(false, cstrTy, subst, this),
                )}`,
              ),
            ],
            err,
            TSCode(2344),
          )
        }
      };
      !this.bindings[tParam.name.value] = tArg;
    };
    this
  }

  fun getClass(tcenvb: mutable TCEnvBase, className: Name): Class {
    tdef = this.defMap.getType(tcenvb, className);
    tdef match {
    | ca @ Class _ -> ca
    | TypeDef _
    | Enum _
    | EnumMemberDef _ ->
      fatalError(
        Array[(className.pos, "A class name was expected here")],
        SKJSCode(2022),
      )
    };
  }

  // Whether `name` resolves to a class or interface definition (anything
  // `getClass` would accept). Used to decide whether an `instanceof` RHS can
  // drive narrowing without `getClass` raising a fatal error on a value-only
  // name.
  fun hasClassDef(tcenvb: mutable TCEnvBase, name: Name): Bool {
    this.defMap.getAll(tcenvb, name).any(def -> def is Class _)
  }

  // The type alias `name` denotes, or None() when it denotes something else (a
  // class, an interface, an enum) or does not resolve at all.
  //
  // Resolution runs against a throwaway `probe` accumulator rather than the
  // caller's, for the same two reasons enumFoldOfCrossEnumRef uses one: this
  // is a speculative lookup, and a name that does not resolve — or resolves to
  // something that is not an alias — is not its concern, so attaching a
  // diagnostic here would duplicate or mis-attribute the authoritative one;
  // and getAll raises a fatal ErrorExn in the default error-handling mode,
  // which must not abort the caller. Keep-going collects any such error into
  // the discarded accumulator instead.
  fun maybeGetTypeDef(context: mutable SKStore.Context, name: Name): ?TypeDef {
    probe = mutable TCEnvLight{
      context,
      results => TCResultsAcc::mcreate{errorHandling => EHKeepGoing()},
    };
    // Take the first definition and report it only if it is an alias, rather
    // than searching past a class or an enum for an alias behind it: `getType`
    // resolves the name to that same first definition, so searching on would
    // let a caller reason about one definition while the checker uses another.
    // With both an `interface Foo {}` and a `type Foo = Foo` in one file — a
    // duplicate identifier, and reported as one — the alias is the second
    // definition, and finding it here would call `Foo` circular while
    // normalize resolves `Foo` to the interface.
    this.defMap.getAll(probe, name, true).maybeGet(0) match {
    | Some(td @ TypeDef _) -> Some(td)
    | _ -> None()
    }
  }

  fun getClassFields(
    context: mutable SKStore.Context,
    c: Class,
  ): Array<ClassField> {
    this.classBodyMap.getFields(context, this.classFieldMap, c)
  }

  fun getTypeDefBody(context: mutable SKStore.Context, td: TypeDef): Type {
    this.typeDefBodyMap.get(context, td.bodyRef).body
  }

  // Whether the type alias `td` requires resolving itself to compute its own
  // type (TS2456, issue #874) — the property reported at its declaration, and
  // the reason its expansion must not be chased (issue #883).
  //
  // A reference is *immediate* when computing the alias's own type forces the
  // referenced type to be computed too: the body itself, either side of a
  // union or intersection, the operand of `keyof`, and the type arguments of a
  // reference to another alias — instantiating an alias resolves its arguments
  // before substituting them, so `type Y = Box<Y>` is circular even though
  // `type Box<T> = { v: T }` never uses `T` immediately, and even where the
  // alias ignores the argument outright.
  //
  // Every other position is *deferred*: an object member, array element, tuple
  // element, or function parameter/return names the alias without resolving
  // it, which is what keeps `type List<T> = null | { head: T; tail: List<T> }`
  // legal. The type arguments of a class or interface reference are deferred
  // for the same reason, which is what separates `type Arr = Array<Arr>`
  // (legal) from `type Y = Box<Y>` (circular).
  //
  // Only a cycle that comes back to the alias under test counts: in
  // `type X = Y; type Y = Z; type Z = Y;` resolving `X` reaches the circular
  // `Y`, but `X` is not itself on the cycle, and tsc reports only `Y` and `Z`.
  fun isCircularTypeDef(context: mutable SKStore.Context, td: TypeDef): Bool {
    this.requiresTypeDef(
      context,
      td,
      this.getTypeDefBody(context, td),
      static::tparamNames(td.tdefParams),
      mutable Set[],
      mutable Set[],
    )
  }

  // Whether `name` denotes a type alias that circularly references itself. A
  // name that denotes anything else, or nothing at all, is not this check's
  // concern.
  fun isCircularTypeName(tcenvb: mutable TCEnvBase, name: Name): Bool {
    this.maybeGetTypeDef(tcenvb.context, name) match {
    | Some(td) -> this.isCircularTypeDef(tcenvb.context, td)
    | None() -> false
    }
  }

  // Whether computing `ty` immediately requires the type alias `target`.
  //
  // Every name is resolved through the defMap, in the scope of the file that
  // wrote it, and compared to `target` by definition rather than by name: the
  // same name denotes different aliases in different files (`Json` is declared
  // in four of them), so matching on the name alone would report an alias that
  // merely forwards to a same-named one elsewhere as circular.
  //
  // `shadowed` holds the type parameters in scope at `ty`, which hide an alias
  // of the same name — in `type Bar<Foo> = Foo`, the body is the parameter,
  // not the alias `Foo`.
  //
  // `visited` records the alias bodies already explored, which both stops a
  // cycle that never reaches `target` from looping and keeps the walk linear.
  // It is shared across the whole walk rather than threaded down each path:
  // whether `target` is reachable from an alias does not depend on the path
  // taken to reach that alias, so an alias whose body has already been
  // explored without finding `target` cannot find it on a second visit. Per
  // path, the same body is re-explored once per path that reaches it, which is
  // exponential on a chain of alias unions (`type A0 = A1 | A1; ...`).
  //
  // `typeofVisited` is the same idea for the value names reached through
  // `typeof`. It stops a value-level `typeof` cycle
  // (`declare const v: typeof w; declare const w: typeof v`) from looping the
  // walk when neither value's type ever reaches an alias.
  //
  // The walk is purely syntactic — it never instantiates — so it terminates
  // even on bodies whose expansion would not.
  private fun requiresTypeDef(
    context: mutable SKStore.Context,
    target: TypeDef,
    ty: Type,
    shadowed: SortedSet<String>,
    visited: mutable Set<TypeDefBodyRef>,
    typeofVisited: mutable Set<String>,
  ): Bool {
    ty.value match {
    | TAUnion(ty1, ty2)
    | TAInter(ty1, ty2) ->
      this.requiresTypeDef(
        context,
        target,
        ty1,
        shadowed,
        visited,
        typeofVisited,
      ) ||
        this.requiresTypeDef(
          context,
          target,
          ty2,
          shadowed,
          visited,
          typeofVisited,
        )
    // `keyof T` needs T's keys, so T is resolved. Its *members* are not, which
    // is why `type K = keyof { a: K }` stays legal: the object below defers.
    | TAKeyOf(operand) ->
      this.requiresTypeDef(
        context,
        target,
        operand,
        shadowed,
        visited,
        typeofVisited,
      )
    // `typeof v` forces the declared type of the value `v`, so the alias is
    // reached whenever v's annotation reaches it — `type R = typeof v` with
    // `declare const v: R` is circular, exactly as `type R = R` is. The
    // annotation is walked under the same immediate/deferred rule, so a value
    // typed `{ a: R }` or `() => R` still defers. Only the bare-identifier form
    // is followed; a dotted `typeof v.a`, a value with no annotation, and a
    // typeof of a function, class, or enum are left for a later pass.
    //
    // v's annotation is read in v's own scope, which has no type parameters, so
    // `shadowed` resets — a value cannot mention the alias's parameters, and
    // carrying them would hide an alias of the same name.
    //
    // tsc additionally treats an array or tuple element of a *value's* type as
    // immediate (its value-level TS2502), so it rejects `declare const v: R[];
    // type R = typeof v`. SKJS keeps the deferred rule there and accepts it:
    // `R` is then the well-founded recursive `R[]`, an inhabited type, not the
    // empty type, so the acceptance is sound rather than a hole.
    | TATypeOf(operand) ->
      operand.value match {
      | Var(varName) ->
        if (typeofVisited.maybeInsert(varName.value)) {
          probe = mutable TCEnvLight{
            context,
            results => TCResultsAcc::mcreate{errorHandling => EHKeepGoing()},
          };
          this.defMap.getAll(probe, varName).maybeGet(0) match {
          | Some(FDVar(_, _, Some(annotation), _)) ->
            this.requiresTypeDef(
              context,
              target,
              annotation,
              SortedSet[],
              visited,
              typeofVisited,
            )
          | _ -> false
          }
        } else {
          false
        }
      | _ -> false
      }
    | TAInst(n, targs) ->
      if (shadowed.contains(n.value)) {
        // A type parameter of the alias being walked, not the alias itself.
        false
      } else {
        this.maybeGetTypeDef(context, n) match {
        | Some(td) ->
          if (td.bodyRef == target.bodyRef) {
            true
          } else {
            // The arguments are written in the current scope, so they keep
            // `shadowed`; the body is read in the callee's, so it takes the
            // callee's parameters instead.
            targs.any(targ ->
              this.requiresTypeDef(
                context,
                target,
                targ,
                shadowed,
                visited,
                typeofVisited,
              )
            ) ||
              (visited.maybeInsert(td.bodyRef) &&
                this.requiresTypeDef(
                  context,
                  target,
                  this.getTypeDefBody(context, td),
                  static::tparamNames(td.tdefParams),
                  visited,
                  typeofVisited,
                ))
          }
        // Not an alias: a class or interface reference defers its arguments,
        // and a name that does not resolve is normalize's to report.
        | None() -> false
        }
      }
    // Every remaining annotation defers, and a new one is far likelier to
    // defer than not: naming a type inside an object, array, tuple, or
    // signature does not resolve it. Three exceptions are immediate in tsc and
    // silent here only because SKJS rejects them before circularity could
    // matter — `TAGet` (`type R = R["x"]`), `TAExtendsQuestion`
    // (`type R = R extends string ? 1 : 2`) and `TAImport` are all "not yet
    // supported". Whichever of them lands first should be given an arm above
    // rather than left to this one.
    | _ -> false
    }
  }

  private static fun tparamNames(tparams: Array<TypeParam>): SortedSet<String> {
    tparams.reduce((names, tparam) -> names.set(tparam.name.value), SortedSet[])
  }

  fun getFunSig(
    context: mutable SKStore.Context,
    fd: FunDef<FunDefName>,
  ): FunDefSigData {
    fd.sig match {
    | FSInline(tparams, params, retType) ->
      FunDefSigData(tparams, params, retType)
    | FSRef(ref) -> this.funDefSigMap.get(context, ref)
    }
  }

  fun getFunBody(
    context: mutable SKStore.Context,
    fd: FunDef<FunDefName>,
  ): FunDefBody {
    fd.body match {
    | FBInline(body) -> body
    | FBRef(BRFunDef(ref)) -> this.funDefBodyMap.get(context, ref).body
    | FBRef(BRMethod(ref)) -> this.methodBodyMap.get(context, ref).body
    }
  }

  // Fresh skolem type arguments for `instanceof` narrowing. Each represents a
  // type argument fixed by the runtime object but hidden from the program.
  fun makeSkolemTArgs(tcenv: mutable TCEnv, className: Name): Array<TType> {
    this.makeSkolemTArgsOf(
      tcenv.subst,
      this.getClass(tcenv, className),
      className,
    )
  }

  // makeSkolemTArgs against a class the caller has already resolved.
  fun makeSkolemTArgsOf(
    subst: mutable Subst,
    c: Class,
    className: Name,
  ): Array<TType> {
    c.tparams.map(tparam -> {
      cstr = tparam.constraint.map(x -> this.normalize(subst, x));
      // Represent the skolem as a synthetic TParam, preserving its identity
      // and declared upper bound through expansion.
      //
      // Name it for where it comes from -- `Box#T`, not the bare `T` the
      // class declared. A hidden argument has no name in source, so the
      // printed one is free to say which parameter of which class it stands
      // for, and a message naming two of them is far easier to read when they
      // are `Box#T` and `Crate#T` rather than `T` twice. `#` cannot appear in
      // a type reference, so the name also cannot be mistaken for something
      // writable.
      TType::fromTParamWithConstraint(
        subst,
        this,
        className.pos,
        subst.genSkolemTParam(
          className.pos,
          `${className.value}#${tparam.name.value}`,
          cstr,
        ),
      )
    })
  }

  fun makeTArgs(tcenv: mutable TCEnv, className: Name): Array<TType> {
    this.makeTArgsIn(tcenv.subst, className)
  }

  // makeTArgs against an explicit substitution. Lets a caller mint the
  // inference variables in a throwaway `Subst::clone` -- getClass and
  // normalize both take a TCEnvBase, which Subst is.
  fun makeTArgsIn(subst: mutable Subst, className: Name): Array<TType> {
    this.makeTArgsOf(subst, this.getClass(subst, className), className)
  }

  // makeTArgs against a class the caller has already resolved.
  fun makeTArgsOf(
    subst: mutable Subst,
    c: Class,
    className: Name,
  ): Array<TType> {
    allTVars = c.tparams
      .map(tparam -> {
        tvar = subst.gen(className.pos);
        tparam.constraint.each(cstr ->
          !tvar = tvar.setConstraint(this.normalize(subst, cstr))
        );
        tvar
      })
      .collect(Array);
    allTVars.map(tvar -> {
      subst.setOrigin(tvar, FromGenericInst(className.pos, allTVars));
      TType::var(tvar)
    })
  }

  fun new(
    subst: mutable Subst,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TType {
    this.newOf(subst, this.getClass(subst, className), className, targs, filter)
  }

  // new against a class the caller has already resolved.
  fun newOf(
    subst: mutable Subst,
    c: Class,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TType {
    obj = this.newObjectOf(subst, c, className, targs, filter);
    TType::single(obj)
  }

  fun newConstructor(
    subst: mutable Subst,
    className: Name,
    targs: Array<TType>,
  ): CstrType {
    this.newConstructorOf(
      subst,
      this.getClass(subst, className),
      className,
      targs,
    )
  }

  // newConstructor against a class the caller has already resolved.
  fun newConstructorOf(
    subst: mutable Subst,
    c: Class,
    className: Name,
    targs: Array<TType>,
  ): CstrType {
    if (c.tparams.size() != targs.size()) {
      subst.error(
        Array[
          (
            className.pos,
            `Expected ${c.tparams.size()} type arguments, but got ${targs.size()}`,
          ),
        ],
        TSCode(2707),
      )
    };
    visitedClasses = SortedSet[];
    CstrType(
      this.findConstructor(subst, visitedClasses, className, c.tparams, targs),
      targs,
    )
  }

  fun newObject(
    subst: mutable Subst,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TObject {
    this.newObjectOf(
      subst,
      this.getClass(subst, className),
      className,
      targs,
      filter,
    )
  }

  // newObject against a class the caller has already resolved. A caller that
  // also needs the class's tparams (to build `targs` with makeTArgsOf or
  // makeSkolemTArgsOf) would otherwise resolve the same name twice.
  fun newObjectOf(
    subst: mutable Subst,
    c: Class,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TObject {
    this.objectOfFields(
      this.newFieldsOf(subst, c, className, targs, filter),
      className,
      targs,
    )
  }

  // The single-branch object a class instantiation denotes, from fields the
  // caller already built. Keeps the unexpanded instance, so the type still
  // prints as `C<targs>` rather than structurally.
  fun objectOfFields(
    fields: TFields,
    className: Name,
    targs: Array<TType>,
  ): TObject {
    TObject::createSingleBranch(
      fields,
      Some(TSInst(className, TArgs(targs))),
      className.pos,
    )
  }

  // The fields of a class instantiation. A class instantiation is always one
  // branch, so a caller doing per-branch work (`TFields::isSub`,
  // `TFields::inter`) wants this rather than a TObject it has to unwrap --
  // and the signature, not a comment, is then what says there is one branch.
  fun newFieldsOf(
    subst: mutable Subst,
    c: Class,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool = _ ~> true,
  ): TFields {
    if (c.tparams.size() != targs.size()) {
      subst.error(
        Array[
          (
            className.pos,
            `Expected ${c.tparams.size()} type arguments, but got ${targs.size()}`,
          ),
        ],
        TSCode(2707),
      )
    };
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    symbolFields = mutable Map[];
    indexes = mutable Vector[];
    thisType = TType::inst(className, TArgs(targs));
    !this.bindings["this"] = thisType;
    constructor = this.addFields(
      subst,
      fields,
      symbolFields,
      indexes,
      visitedClasses,
      None(),
      className,
      targs,
      fieldType ~> {
        filter(fieldType) && !fieldType.isStatic()
      },
    );
    constructor match {
    | Some(constructorTy) ->
      subst.notSupported(constructorTy.pos, "new returning a constructor")
    | None() -> void
    };
    isArray = c.kind match {
    | CKInterface() -> None()
    | CKAbstract()
    | CKClass() ->
      Some(false) /* Unless overridden by brand field */
    };
    // Class instances are never callable or constructible; interfaces are
    // structural, so their callability is unconstrained (a function with the
    // right members inhabits them). Mirrors the isArray brand above.
    (call, new) = c.kind match {
    | CKInterface() -> (CUnknown(), CUnknown())
    | CKAbstract()
    | CKClass() ->
      (CAbsent(), CAbsent())
    };
    tIndexes = TIndexes::create(subst, this, indexes);
    TFields::create{fields, symbolFields, tIndexes, call, new, isArray}
  }

  fun newStatic(subst: mutable Subst, className: Name): TType {
    obj = this.newStaticObject(subst, className);
    TType::single(obj)
  }

  private fun newStaticObject(subst: mutable Subst, className: Name): TObject {
    c = this.getClass(subst, className);
    targs = Array[];
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    symbolFields = mutable Map[];
    indexes = mutable Vector[];
    constructor = this.addFields(
      subst,
      fields,
      symbolFields,
      indexes,
      visitedClasses,
      Some(c.tparams),
      className,
      targs,
      fieldType ~> fieldType.isStatic(),
    );
    pos = className.pos;
    new = constructor match {
    | Some(tfuns) -> tfuns
    | None() -> this.makeEmptyConstructor(subst, pos, className, c)
    };
    tIndexes = TIndexes::create(subst, this, indexes);
    TObject::createSingleBranch(
      TFields::create{
        fields,
        symbolFields,
        tIndexes,
        new => CPresent(new),
        // A class constructor implements [[Call]] (typeof C === "function"),
        // but invoking it without `new` always throws, so there is no
        // signature to offer: provably callable, not invocable (see
        // Callability).
        call => CFunction(),
        isArray => Some(false),
      },
      Some(TSInst(className, TArgs(targs))),
      pos,
    )
  }

  // The class's own type parameters, as type arguments applying the class
  // to itself (e.g. `class C<T>` -> `C<T>`).
  private static fun tparamsAsTArgs(tparams: Array<TypeParam>): Array<Type> {
    tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[])))
  }

  private fun makeEmptyConstructor(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    className: Name,
    c: Class,
  ): TFuns {
    cgNode = CGNode::create(Constructor(className, c.name.pos.fileName));
    retType = Type(pos, TAInst(className, TEnv::tparamsAsTArgs(c.tparams)));
    tafun = TAFun(false, c.tparams, Array[], retType, cgNode);
    this.normalizeFun(tcenvb, pos, tafun)
  }

  // TParamWithConstraint corresponding to syntactic TypeParam
  fun makeTParam(
    tcenvb: mutable TCEnvBase,
    tparam: TypeParam,
  ): TParamWithConstraint {
    cstr = tparam.constraint.map(cstr -> this.normalize(tcenvb, cstr));
    TParamWithConstraint(
      tparam.name.value,
      tparam.name.pos.fileName,
      tparam.id,
      cstr,
    )
  }

  fun addTParams(subst: mutable Subst, clauses: Array<TypeParam>): this {
    for (tparam in clauses) {
      ty = TType::fromTParamWithConstraint(
        subst,
        this,
        tparam.name.pos,
        this.makeTParam(subst, tparam),
      );
      !this.bindings[tparam.name.value] = ty
    };
    this
  }

  // Normalizes a function/method's return type annotation. The top-level `x
  // is T` type-predicate form is accepted here (unlike in the general
  // recursive `normalize`, whose own TAIs handling always rejects, covering
  // any nested position). Whether this is legal on the enclosing
  // declaration (only on a bodyless signature — see callers of
  // rejectTypePredicateOnBodiedSignature) is deliberately NOT checked here:
  // this return-type normalization must stay independent of whether the
  // declaration has a body, since it feeds a signature that's cached
  // separately from — and read by callers regardless of — the body, and
  // depending on body content here would incorrectly propagate body-only
  // edits to those callers under incremental checking. `params` is consulted
  // only inside the TAIs branch, so the common (non-predicate) return type
  // costs nothing.
  fun normalizeReturnType(
    tcenvb: mutable TCEnvBase,
    rty: Type,
    params: Array<ParamBase>,
  ): TType {
    rty.value match {
    | TAIs(lhs, rhs) ->
      // The subject must name an actual parameter of the enclosing
      // function, or be `this` — nothing else (unlike a full `normalize`
      // call, which would also accept any other valid type expression,
      // e.g. `true is ...`).
      // TODO: model the narrowing effect precisely.
      isValidSubject = lhs.value match {
      | TAInst(Name(_, "this"), args) if (args.isEmpty()) -> true
      | TAInst(name, args) if (args.isEmpty()) ->
        params.any(p ->
          p.name.value match {
          | PVar(n) -> n.value == name.value
          | _ -> false
          }
        )
      | _ -> false
      };
      if (!isValidSubject) {
        fatalError(
          Array[
            (
              lhs.pos,
              "A type predicate's subject must be a parameter of the enclosing function, or 'this'",
            ),
          ],
          SKJSCode(9031),
        )
      };
      _ = this.normalize(tcenvb, rhs);
      TType::single(TPrimValue::boolean(rty.pos))
    | _ -> this.normalize(tcenvb, rty)
    }
  }

  // A type predicate return type is only accepted on a bodyless
  // (ambient/interface) signature, since SKJS never checks it against a
  // real implementation. Called from funDef/method-checking, right where
  // the body is already legitimately read (to check its statements) —
  // deliberately NOT from normalizeReturnType/funDefSetup, which must stay
  // independent of body content for incremental checking (see
  // normalizeReturnType's doc comment).
  fun rejectTypePredicateOnBodiedSignature(
    tcenvb: mutable TCEnvBase,
    retTypeAst: ?Type,
  ): void {
    retTypeAst match {
    | Some(Type(pos, TAIs _)) ->
      tcenvb.error(
        Array[
          (
            pos,
            "A type predicate ('x is T') is only supported as the top-level return type of a declared function or method signature",
          ),
        ],
        SKJSCode(9032),
      )
    | _ -> void
    }
  }

  private fun processClassSetup(
    subst: mutable Subst,
    visitedClasses: SortedSet<String>,
    withTParams: Bool,
    className: Name,
    targs: Array<TType>,
  ): (this, Class) {
    if (visitedClasses.contains(className.value)) {
      fatalError(
        Array[
          (
            className.pos,
            "This class is referenced directly or indirectly in its own base class",
          ),
        ],
        TSCode(2506),
      );
    };
    !visitedClasses = visitedClasses.set(className.value);
    defs = this.defMap.getAll(subst, className);
    defsCls = defs.filterMap(def ->
      def match {
      | cls @ Class _ -> Some(cls)
      | _ -> None()
      }
    );
    defsCls.size() match {
    | 0 ->
      fatalError(
        Array[(className.pos, `Cannot find name '${className.value}'`)],
        TSCode(2304),
      )
    | 1 -> void
    | _ ->
      subst.error(
        Array[(className.pos, `Duplicate class declaration '${className}'`)],
        TSCode(2300),
      )
    };
    cls = defsCls[0];
    if (
      (withTParams || targs.size() != 0) &&
      targs.size() != cls.tparams.size()
    ) {
      subst.error(
        Array[
          (
            className.pos,
            `Expected ${cls.tparams.size()} type arguments, but got ${targs.size()}`,
          ),
          (cls.name.pos, "Class declaration is here"),
        ],
        TSCode(2707),
      )
    };
    if (withTParams) {
      !this = this.instantiateTParams(subst, className.pos, targs, cls.tparams);
    };
    (this, cls)
  }

  // Returns the type of the constructor, if any.
  private fun addFields(
    subst: mutable Subst,
    acc: mutable Map<FieldNameString, TField>,
    symbolFields: mutable Map<FieldNameString, TField>,
    indexes: mutable Vector<(IndexKeyKinds, TField)>,
    visitedClasses: SortedSet<String>,
    isStatic: ?Array<TypeParam>,
    className: Name,
    targs: Array<TType>,
    filter: ClassFieldValue ~> Bool,
  ): ?TFuns {
    (!this, cls) = this.processClassSetup(
      subst,
      visitedClasses,
      isStatic is None(),
      className,
      targs,
    );
    for (extend in cls.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        if (this.hasClassDef(subst, parentName)) {
          _ = this.addFields(
            subst,
            acc,
            symbolFields,
            indexes,
            visitedClasses,
            isStatic,
            parentName,
            if (isStatic is Some _) Array[] else {
              paramTArgs.map(targ -> this.normalize(subst, targ))
            },
            filter,
          )
        } else {
          // The extends target is not a class or interface. tsc allows an
          // interface to extend a type alias as long as the alias resolves to
          // an object type (or an intersection of object types with statically
          // known members); the alias's members are merged structurally, as if
          // intersected with the interface body. Resolve and merge them here.
          this.addFieldsFromAliasBase(
            subst,
            acc,
            symbolFields,
            indexes,
            isStatic,
            extend,
          )
        }
      | _ ->
        subst.error(
          Array[
            (
              extend.pos,
              "An 'extends' clause must reference a class instantiation",
            ),
          ],
          TSCode(2507),
        )
      }
    };
    constructor: ?TFuns = None();
    fields = this.getClassFields(subst.context, cls);
    for (fieldType in fields) {
      fieldType match {
      | field @ ClassFieldValue _ ->
        if (!filter(field)) continue;
        fieldIsStatic = false;
        fieldIsReadonly: ?PosRange = None();
        fieldAccess: FieldAccess = FAPublic();
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic _ -> !fieldIsStatic = true
          | ModReadonly(roPos) -> !fieldIsReadonly = Some(roPos)
          | ModPublic _ -> void /* public is the default */
          | ModPrivate _ -> !fieldAccess = FAPrivate(cls.name)
          | ModProtected _ -> void /* protected is silently treated as public */
          | mod ->
            subst.error(
              Array[
                (
                  modifier.pos,
                  `Field modifier '${mod}' is not yet supported by SKJS`,
                ),
              ],
              SKJSCode(9008),
            )
          }
        };
        if (fieldIsStatic != isStatic.isSome()) continue;
        if (fieldIsStatic) {
          if (fieldIsReadonly is None()) {
            subst.error(
              Array[(field.pos, "A static field must be marked 'readonly'")],
              SKJSCode(2019),
            )
          };
          field.optional.each(pos ->
            subst.error(
              Array[(pos, "A static field cannot be optional")],
              SKJSCode(2020),
            )
          )
        };
        // Static readonly fields are the class-level analog of a top-level
        // const — `unique symbol` is permitted there, so propagate the flag.
        // Also propagate the qualified display name so the encoded id here
        // matches the one minted at validateToplevelConst (declaration site).
        isTopLevelConst = fieldIsStatic && fieldIsReadonly is Some _;
        displayName = if (isTopLevelConst) {
          field.name match {
          | FNNormal(fdName) -> Some(`${className.value}.${fdName.value}`)
          | _ -> None()
          }
        } else {
          None()
        };
        type: TType = field.type match {
        | Some(ty) -> this.normalize(subst, ty, isTopLevelConst, displayName)
        | None() ->
          // No annotation: synthesize a placeholder TInst whose name
          // isn't resolvable, so any later attempt to use the field's
          // type surfaces a clear error mentioning the missing
          // annotation. The placeholder carries the class's current
          // type arguments so two instances of the same generic class
          // with different type arguments produce non-equal placeholders
          // (e.g. C<number>.x and C<string>.x are incompatible). The
          // declaration-time "Type annotation expected" error is
          // reported by TypeChecker#class_, which doesn't run for
          // ambient (declare-wrapped) classes — that's how ambient
          // classes get to omit the type on a private field.
          TType::inst(
            Name(
              field.pos,
              `${kMissingTypeAnnotationPrefix}${
                className.value
              }_${field.name.getName()}`,
            ),
            TArgs(targs),
          )
        };
        field.name match {
        | FNNormal(fdName) ->
          fieldName = fdName.value;
          f = TField::create{
            pos => field.pos,
            name => fieldName,
            isOptional => field.optional is Some _,
            isReadonly => fieldIsReadonly,
            type,
            access => fieldAccess,
          };

          acc![f.name] = f
        | FNColon(indexName, indexType) ->
          keyType = this.normalize(subst, indexType);
          keyKinds = this.resolveIndexKeyKinds(subst, indexName.pos, keyType);
          indexes.push(
            (
              keyKinds,
              TField::create{
                pos => indexName.pos,
                name => indexName.value,
                isOptional => true,
                isReadonly => fieldIsReadonly,
                type,
                access => FAPublic(),
              },
            ),
          )
        | _ ->
          subst.error(
            Array[
              (field.pos, "This field name syntax is not supported by SKJS"),
            ],
            SKJSCode(2024),
          )
        }
      | fd @ ClassFieldMethod{name => FNNormal(Name(fdPos, "constructor"))} ->
        if (isStatic is None()) continue;
        constructor match {
        | Some(constructorTy) ->
          subst.error(
            Array[
              (fdPos, "Multiple constructor implementations are not allowed."),
              (constructorTy.pos, "Previous constructor was here"),
            ],
            TSCode(2392),
          )
        | None() -> void
        };
        !constructor = Some(
          this.makeConstructor(subst, className, isStatic.fromSome(), fd),
        )
      | fd @ ClassFieldMethod _ ->
        metIsStatic = fd.isStatic();
        if (metIsStatic != isStatic.isSome()) continue;
        cgNode = CGNode::create(Method(fd.name, className, metIsStatic));
        // Populate the implicit `this` type (the enclosing class instance) for
        // every non-static method. This closes the "detached method call"
        // soundness gap (`const g = obj.m; g()`) uniformly — including methods
        // declared on extending classes and body-less stub methods (interfaces,
        // ambient declarations, generic containers). normalizeFun records it
        // as ThisParam::ImplicitClass, which function-type subtyping treats as
        // mutually compatible between two implicit thises (see TTypeSubtyping),
        // preserving generic-container variance and subclass override
        // compatibility.
        implicitThisOpt = if (metIsStatic) {
          None()
        } else {
          Some(TType::inst(className, TArgs(targs)))
        };
        metTFuns = this.funDecl(subst, implicitThisOpt, fd, cgNode);
        metType = TType::single(TObject::createCall(metTFuns));
        metAccess: FieldAccess = FAPublic();
        for (modifier in fd.modifiers.modifiers) {
          modifier match {
          | ModPrivate _ -> !metAccess = FAPrivate(cls.name)
          | _ -> void
          }
        };
        fd.name match {
        | FNNormal(name) -> FKName(name, TString())
        | FNComputed(keyExpr) -> this.resolveComputedKeyFieldKey(subst, keyExpr)
        } match {
        | FKSymbol(exprPos, uniqueId) ->
          field = TField::create{
            pos => exprPos,
            name => uniqueId,
            isOptional => false,
            isReadonly => Some(exprPos),
            type => metType,
            access => metAccess,
          };

          symbolFields![field.name] = field
        | FKName(name, _) ->
          field = TField::create{
            pos => name.pos,
            name => name.value,
            isOptional => false,
            isReadonly => Some(name.pos),
            type => metType,
            access => metAccess,
          };

          acc![field.name] = field
        }
      }
    };
    constructor
  }

  // Merge the structural members of a type-alias base referenced by an
  // `interface I extends Alias` heritage clause into the accumulating field
  // maps. tsc accepts an alias here when it resolves to an object type (or an
  // intersection of object types with statically known members); the members
  // are inherited as if `Alias` were intersected with the interface body.
  // Only instance members are inherited — a type alias declares no statics, so
  // the static-collection pass contributes nothing.
  private fun addFieldsFromAliasBase(
    subst: mutable Subst,
    acc: mutable Map<FieldNameString, TField>,
    symbolFields: mutable Map<FieldNameString, TField>,
    indexes: mutable Vector<(IndexKeyKinds, TField)>,
    isStatic: ?Array<TypeParam>,
    extend: Type,
  ): void {
    if (isStatic is Some _) {
      void
    } else {
      // `normalize` resolves the alias (reporting "Cannot find name" if the
      // name is undefined); `expand` then drives it to its object structure.
      aliasTy = this.normalize(subst, extend);
      aliasTy.expand(subst, this, Some(Covariant())).clauses.getObject() match {
      | Some(obj) if (obj.getBranches().size() == 1) ->
        tfields = obj.getBranches()[0];
        for (f in tfields.fields.toArray()) {
          acc![f.name] = f
        };
        for (f in tfields.symbolFields.toArray()) {
          symbolFields![f.name] = f
        };
        // A call/construct signature on the base is representable here only as
        // a named member, so it cannot flow through the field maps; reject
        // rather than silently drop it.
        if (
          tfields.call is CPresent _ ||
          tfields.call is CFunction() ||
          tfields.new is CPresent _
        ) {
          subst.notSupported(
            extend.pos,
            "extending a type alias that has a call or construct signature",
          )
        };
        pushIndex = (index: ?TField, keyKinds: IndexKeyKinds) ->
          index.each(f -> if (!f.isSynthetic()) indexes.push((keyKinds, f)));
        pushIndex(
          tfields.stringIndex,
          IndexKeyKinds::create{
            hasString => true,
            hasNumber => false,
            hasSymbol => false,
          }.fromSome(),
        );
        pushIndex(
          tfields.numberIndex,
          IndexKeyKinds::create{
            hasString => false,
            hasNumber => true,
            hasSymbol => false,
          }.fromSome(),
        );
        pushIndex(
          tfields.symbolIndex,
          IndexKeyKinds::create{
            hasString => false,
            hasNumber => false,
            hasSymbol => true,
          }.fromSome(),
        )
      | _ ->
        // Not an object type (a union, primitive, etc.). tsc rejects this
        // with TS2312; match it.
        subst.error(
          Array[
            (
              extend.pos,
              `An interface can only extend an object type or intersection of object types with statically known members.`,
            ),
          ],
          TSCode(2312),
        )
      }
    }
  }

  private fun findConstructor(
    subst: mutable Subst,
    visitedClasses: SortedSet<String>,
    className: Name,
    tparams: Array<TypeParam>,
    targs: Array<TType>,
  ): ?TFuns {
    this.findConstructorMethod(
      subst,
      visitedClasses,
      className,
      tparams,
      targs,
    ) match {
    | None() -> None()
    | Some((tenv, fd)) ->
      Some(tenv.makeConstructor(subst, className, tparams, fd))
    }
  }

  private fun findConstructorMethod(
    subst: mutable Subst,
    visitedClasses: SortedSet<String>,
    className: Name,
    tparams: Array<TypeParam>,
    targs: Array<TType>,
  ): ?(this, ClassFieldMethod) {
    (!this, cls) = this.processClassSetup(
      subst,
      visitedClasses,
      true,
      className,
      targs,
    );
    clsFields = this.getClassFields(subst.context, cls);
    for (fieldType in clsFields) {
      fieldType match {
      | fd @ ClassFieldMethod _ if (
        fd.name is FNNormal(Name(_, "constructor"))
      ) ->
        return Some((this, fd))
      | _ -> void
      }
    };
    for (extend in cls.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        // A type-alias base cannot contribute a constructor (a call/construct
        // signature on an alias base is rejected by addFieldsFromAliasBase),
        // so skip it instead of resolving it as a class — recursing would
        // fatal "Cannot find name" on the alias (#798). Mirrors the
        // hasClassDef guard in addFields' extends walk.
        if (this.hasClassDef(subst, parentName)) {
          return this.findConstructorMethod(
            subst,
            visitedClasses,
            parentName,
            tparams,
            paramTArgs.map(targ -> this.normalize(subst, targ)),
          )
        }
      | _ ->
        subst.error(
          Array[
            (
              extend.pos,
              "An 'extends' clause must reference a class instantiation",
            ),
          ],
          TSCode(2507),
        )
      }
    };
    None()
  }

  // Normalizes constructor signatures by making type parameters and
  // return types explicit.  For example, in a generic class A<T> {
  // constructor() {} }, the constructor is transformed into:
  // constructor<T>(...): A<T> This ensures constructors reflect their
  // class's type parameters and return type.

  fun makeConstructor(
    tcenvb: mutable TCEnvBase,
    className: Name,
    tparams: Array<TypeParam>,
    fd: ClassFieldMethod,
  ): TFuns {
    cgNode = CGNode::create(Method(fd.name, className, true));
    !tparams = tparams.map(x -> {
      // We give the tparams a different name to make sure they are
      // not confused with the type parameters of the class
      !x.id = x.id.prefixWith("$");
      x
    });
    sig = this.getFunSig(tcenvb.context, fd);
    sig.retType.i1 match {
    | None() -> // constructor
      void
    | Some(x) ->
      tcenvb.error(
        Array[(x.pos, "A constructor cannot have a return type annotation")],
        TSCode(1093),
      )
    };
    retTypePos = className.pos;
    retType = Type(
      retTypePos,
      TAInst(Name(retTypePos, className.value), TEnv::tparamsAsTArgs(tparams)),
    );
    // A `this` parameter on a constructor is already an error (TS2681, reported
    // in TypeChecker::constructor). Drop it from the synthesized `new` signature
    // so it stays receiver-free and construction sites (`new C()`) do not
    // cascade a spurious "this context is not assignable" error.
    params = if (sig.params.size() > 0 && sig.params[0].isThisParam()) {
      sig.params.slice(1)
    } else {
      sig.params
    };
    tafun = TAFun(false, tparams, params, retType, cgNode);
    this.normalizeFun(tcenvb, fd.name.getPos(), tafun)
  }

  fun funDecl(
    tcenvb: mutable TCEnvBase,
    implicitThisOpt: ?TType,
    fd: FunDef<FunDefName>,
    cgNode: CGNode,
    isShapeMethod: Bool = false,
  ): TFuns {
    sig = this.getFunSig(tcenvb.context, fd);
    retType = sig.retType match {
    | (pos, None()) ->
      // constructors must use makeConstructor
      fatalError(
        Array[
          (
            pos,
            `Function '${fd.name.getName()}' must have an explicit return type annotation`,
          ),
        ],
        TSCode(7010),
      )
    | (_, Some(x)) -> x
    };
    tafun = TAFun(
      implicitThisOpt.isSome(),
      sig.tparams,
      sig.params,
      retType,
      cgNode,
    );
    this.normalizeFun(
      tcenvb,
      fd.name.getPos(),
      tafun,
      true,
      isShapeMethod,
      implicitThisOpt,
    )
  }

  // Normalizes a type annotation.
  // When isTopLevelConst is true, allows unique symbol type (only permitted
  // in top-level const declarations, class static readonly members, and
  // imported const bindings).
  // displayName, when present, is the binding name attached to a top-level
  // unique symbol. It is encoded into the unique-symbol identifier so the
  // pretty printer can render the type as `typeof <name>` instead of the
  // hash-based internal id.
  fun normalize(
    tcenvb: mutable TCEnvBase,
    typeAst: Type,
    isTopLevelConst: Bool = false,
    displayName: ?String = None(),
  ): TType {
    pos = typeAst.pos;
    typeAst.value match {
    | TABigIntLiteral(x) -> TType::single(TPrimValue::single(TBigInt(), x, pos))
    | TAAssertIs _ ->
      fatalError(
        Array[(pos, "'asserts' type predicates are not yet supported by SKJS")],
        SKJSCode(9013),
      )
    | TAAbstract _ ->
      fatalError(
        Array[
          (pos, "The 'abstract' type modifier is not yet supported by SKJS"),
        ],
        SKJSCode(9014),
      )
    | TAUniqueSymbol() ->
      if (isTopLevelConst) {
        // Each unique symbol gets a distinct type based on its position.
        // Format: unique_symbol:<filePath>:<symbol>:<relStart>:<displayName>
        // - filePath + symbol + relStart together provide identity
        //   (uniqueness across declarations).
        // - <symbol> is `SymbolicPos::toString` — e.g. `constant(uniqueA)`,
        //   `class(MyClass)` — so the encoded id is human-meaningful in
        //   debug contexts and can be surfaced for anonymous cases.
        // - displayName, when non-empty, lets the renderer show the type
        //   as `typeof <displayName>`.
        uniqueId = `unique_symbol:${pos.fileName}:${pos.symbol}:${
          pos.relStart.value
        }:${displayName.default("")}`;
        TType::single(TPrimValue::single(TSymbol(), uniqueId, pos))
      } else {
        fatalError(
          Array[
            (
              pos,
              "A 'unique symbol' type is only allowed in a top-level 'const' declaration, a 'static readonly' member, or an imported 'const' binding",
            ),
          ],
          SKJSCode(2029),
        )
      }
    | TAAsserts _ ->
      fatalError(
        Array[(pos, "'asserts' type predicates are not yet supported by SKJS")],
        SKJSCode(9013),
      )
    | TAIs _ ->
      // A type predicate (`x is T`) is only accepted as the top-level
      // return type of a declared (bodyless) function or method signature —
      // see normalizeReturnType, called from funDefSetup/funDecl instead of
      // this general recursive normalize for that position. Anywhere else
      // (nested in another type, or on a signature with a body, which SKJS
      // cannot verify the predicate against) is rejected.
      fatalError(
        Array[
          (
            pos,
            "A type predicate ('x is T') is only supported as the top-level return type of a declared function or method signature",
          ),
        ],
        SKJSCode(9032),
      )
    | TAKeyOf(ty) ->
      subst = Subst::mcreate(tcenvb);
      targetType = this.normalize(tcenvb, ty);
      this.keyOfType(subst, targetType, pos)
    | tafun @ TAFun _ ->
      tfuns = this.normalizeFun(tcenvb, pos, tafun);
      TType::single(TObject::createCallWithPos(tfuns, pos))
    | TANew(Type(tyPos, tafun @ TAFun _)) ->
      // The inner function type comes only from ParserType.typeFun, which
      // always sets isMethod=false, so it can be normalized as-is.
      tfuns = this.normalizeFun(tcenvb, tyPos, tafun);
      TType::single(TObject::createNew(tfuns, pos))
    | TANew _ ->
      fatalError(
        Array[(pos, "A 'new' type annotation must take a function type")],
        SKJSCode(2025),
      )
    | TAEmptyArray _ ->
      fatalError(
        Array[
          (
            pos,
            "Empty array/tuple type literals are not yet supported by SKJS",
          ),
        ],
        SKJSCode(9016),
      )
    | TAInfer _ ->
      fatalError(
        Array[(pos, "The 'infer' keyword is not yet supported by SKJS")],
        SKJSCode(9017),
      )
    | TAImport _ ->
      fatalError(
        Array[(pos, "'import(...)' type syntax is not yet supported by SKJS")],
        SKJSCode(9019),
      )
    | TAReadonly(ro) ->
      ro.value match {
      | TAArray(ty) ->
        TType::inst(
          Name(pos, "ReadonlyArray"),
          TArgs(Array[this.normalize(tcenvb, ty)]),
        )
      | TAInst(Name(_, "Array"), arr) ->
        if (arr.size() != 1) {
          tcenvb.error(
            Array[(pos, "Array<T> requires exactly 1 type argument")],
            TSCode(2707),
          )
        };
        elemType = if (arr.isEmpty()) {
          TType::top(pos)
        } else {
          this.normalize(tcenvb, arr[0])
        };
        TType::inst(Name(pos, "ReadonlyArray"), TArgs(Array[elemType]))
      | TAEmptyArray _ ->
        TType::inst(
          Name(pos, "ReadonlyArray"),
          TArgs(Array[TType::bottom(pos)]),
        )
      | taTuple @ TATuple _ -> this.normalizeTuple(tcenvb, pos, taTuple, true)
      | _ ->
        tcenvb.error(
          Array[
            (
              pos,
              "'readonly' type modifier is only permitted on array and tuple literal types.",
            ),
          ],
          TSCode(1354),
        );
        this.normalize(tcenvb, ro)
      }
    | TAExtends _ ->
      fatalError(
        Array[
          (
            pos,
            "Conditional types ('T extends U ? X : Y') are not yet supported by SKJS",
          ),
        ],
        SKJSCode(9020),
      )
    | TAExtendsQuestion _ ->
      fatalError(
        Array[
          (
            pos,
            "Conditional types ('T extends U ? X : Y') are not yet supported by SKJS",
          ),
        ],
        SKJSCode(9020),
      )
    | TATemplate(strings, types) ->
      this.normalizeTemplate(tcenvb, pos, strings, types)
    | TAStringLiteral(x) -> TType::single(TPrimValue::single(TString(), x, pos))
    | TANumLiteral(x) -> TType::single(TPrimValue::single(TNum(), x, pos))
    | TATypeOf(expr) -> this.typeOfExpr(tcenvb, expr)
    | TAPrim(kind) ->
      TType::single(
        kind match {
        | TPKNull() -> TPrimUnit(TNull(), pos)
        | TPKBool() -> TPrimValue::boolean(pos)
        | TPKNum() -> TPrimValue::number(pos)
        | TPKString() -> TPrimValue::string(pos)
        | TPKBigInt() -> TPrimValue::bigint(pos)
        | TPKSymbol() -> TPrimValue::symbol(pos)
        },
      )
    | TAObject(fields) ->
      tFields = this.createTFields(tcenvb, fields, isTopLevelConst);
      TType::single(TObject::createSingleBranch(tFields, None(), pos))
    | TAInst(Name(p, "object"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(
          Array[
            (p, "This type is not generic; it does not accept type arguments"),
          ],
          TSCode(2315),
        )
      };
      TType::single(TObject::createEmpty(pos))

    | TAArray(ty) ->
      TType::inst(Name(pos, "Array"), TArgs(Array[this.normalize(tcenvb, ty)]))

    | TAInst(Name(p, "void"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(
          Array[
            (p, "This type is not generic; it does not accept type arguments"),
          ],
          TSCode(2315),
        )
      };
      TType::single(TPrimUnit(TVoid(), pos))
    | TAInst(Name(p, "undefined"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(
          Array[
            (p, "This type is not generic; it does not accept type arguments"),
          ],
          TSCode(2315),
        )
      };
      TType::single(TPrimUnit(TUndefined(), pos))
    | TAInst(Name(p, "unknown"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(
          Array[
            (p, "This type is not generic; it does not accept type arguments"),
          ],
          TSCode(2315),
        )
      };
      TType::top(pos)
    | TAInst(Name(p, "never"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(
          Array[
            (p, "This type is not generic; it does not accept type arguments"),
          ],
          TSCode(2315),
        )
      };
      TType::bottom(pos)
    | TAInst(Name(p, x @ "true"), targs)
    | TAInst(Name(p, x @ "false"), targs) ->
      if (targs.size() != 0) {
        tcenvb.error(
          Array[
            (p, "This type is not generic; it does not accept type arguments"),
          ],
          TSCode(2315),
        )
      };
      TType::single(TPrimValue::single(TBool(), x, pos))
    | TAInst(Name(closedPos, "SKJS_Closed"), targs) if (targs.size() == 1) ->
      // SKJS_Closed<T>: the closed-object operator — every key not named in
      // T is provably absent. The SKJS_-prefixed name is reserved for the
      // checker and intercepted BEFORE name resolution; user code writes
      // Closed<T>, a plain stub alias for it (import-stubs/@types/skjs). For
      // tsc compatibility a tsc-only stub declares the identity
      // `type SKJS_Closed<T> = T`. Other arities resolve ordinarily.
      inner = this.normalize(tcenvb, targs[0]);
      this.closeObjectType(tcenvb, closedPos, inner)
    | TAInst(n, targs) ->
      // Resolve via lexical bindings (see `bindings` field doc).
      this.bindings.maybeGet(n.value) match {
      | Some(boundTy) ->
        // If n resolves to a bound type parameter, n<targs> is invalid
        // (example: class C<T> { value: T<number> }).
        if (targs.size() != 0) {
          tcenvb.error(
            Array[
              (
                n.pos,
                `Type parameter '${
                  n.value
                }' is not generic and cannot have type arguments`,
              ),
            ],
            TSCode(2315),
          )
        };
        boundTy.withPos(pos)

      | None() if (this.forbiddenInsts.contains(n.value)) ->
        fatalError(
          Array[(n.pos, `Type '${n.value}' circularly references itself`)],
          TSCode(2456),
        )
      | None() ->
        // No bound-name match: treat n as a named type definition. A dotted
        // name whose head is an enum (`E.A`) resolves to an EnumMemberDef.
        tdef = this.defMap.getType(tcenvb, n);
        tparams = tdef match {
        | TypeDef{tdefParams} -> tdefParams
        | Class{tparams} -> tparams
        | Enum _ -> Array[]
        | EnumMemberDef(en, member) ->
          // A qualified enum-member type reference (`E.A`). Build the member
          // type here — the defMap resolved the name, TEnv owns the folding.
          if (targs.size() != 0) {
            tcenvb.error(
              Array[(n.pos, `Type '${n.value}' is not generic`)],
              TSCode(2315),
            )
          };
          return this.enumMemberType(tcenvb, en, member.value) match {
          | Some(memberTy) -> memberTy.withPos(pos)
          | None() ->
            fatalError(
              Array[
                (
                  n.pos,
                  `Namespace '${
                    en.name.value
                  }' has no exported member '${TypePp::escapeName(
                    member.value,
                  )}'`,
                ),
              ],
              TSCode(2694),
            )
          }
        };
        arityOk = !(
          targs.size() > tparams.size() ||
          (targs.size() < tparams.size() &&
            tparams[targs.size()].default is None())
        );
        if (!arityOk) {
          tcenvb.error(
            Array[
              (
                n.pos,
                `Expected ${tparams.size()} type arguments, but got ${targs.size()}`,
              ),
            ],
            TSCode(2707),
          )
        };

        if (this.seenInstantiate.contains(n.value)) {
          !this.forbiddenInsts = this.forbiddenInsts.set(n.value)
        };
        normTargs = targs.map(x -> this.normalize(tcenvb, x));
        // Check the type arguments against the parameters' constraints at the
        // reference site, the same obligation enforced when the definition is
        // expanded (see instantiateTParams), but without expanding the body.
        // Without this, a violating argument in a reference that is never
        // expanded — an unused ambient declaration, an interface field, an
        // unused parameter type — escapes the expansion-time check entirely
        // and skjs accepts a reference TypeScript rejects (TS2344). The check
        // runs on a throwaway subst so its discarded bindings and clone growth
        // never touch the live substitution. Guarded on arityOk so a wrong
        // count is reported once (as TS2707) rather than also here.
        if (arityOk) {
          _ = this.instantiateTParams(
            Subst::mcreate(tcenvb),
            n.pos,
            normTargs,
            tparams,
          )
        };
        TType::inst(n, TArgs(normTargs))
      }
    | TAUnion(ty1, ty2) ->
      subst = Subst::mcreate(tcenvb);
      TType::union(
        subst,
        this,
        this.normalize(tcenvb, ty1),
        this.normalize(tcenvb, ty2),
      ).withPos(pos)
    | TAInter(ty1, ty2) ->
      subst = Subst::mcreate(tcenvb);
      TType::inter(
        subst,
        this,
        this.normalize(tcenvb, ty1),
        this.normalize(tcenvb, ty2),
      ).withPos(pos)
    | taTuple @ TATuple _ -> this.normalizeTuple(tcenvb, pos, taTuple, false)
    | TAGet(tyObj, tyKey) ->
      tyKey.value match {
      | TAPrim(TPKNum()) ->
        // T[number]: extract element type.  TVars are expanded to their
        // constraints so e.g. `N extends string[]` resolves to `string`.
        subst = Subst::mcreate(tcenvb);
        objType = this.normalize(tcenvb, tyObj);
        this.numberIndexedType(subst, objType, pos)
      | _ ->
        fatalError(
          Array[
            (
              pos,
              "Indexed access types ('T[K]') are not yet supported by SKJS",
            ),
          ],
          SKJSCode(9021),
        )
      }
    }
  }

  // Reduces a template literal type, as tsc does, to a type in the existing
  // string domain. A template has no type of its own here: it either names a
  // finite set of strings (then it IS that literal union) or it names the whole
  // `string` primitive.
  //
  // Not reduced, and rejected: a `number` or `bigint` hole, or an abstract one,
  // whatever surrounds it (`\`${number}\``); and a bare `string` hole when the
  // template has text of its own (`\`a${string}b\``), the text being what stops
  // it from simply being `string`.
  // Such a type is an infinite but partial set of strings, which needs a pattern
  // representation SKJS does not have -- TPrimValue holds either the whole
  // primitive or a finite literal set, and nothing in between.
  private fun normalizeTemplate(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    strings: Array<String>,
    types: Array<Type>,
  ): TType {
    invariant(strings.size() == types.size() + 1);
    subst = Subst::mcreate(tcenvb);
    holeTypes = types.map(ty -> this.normalize(tcenvb, ty));
    holes = holeTypes.map(ty -> this.templateHole(subst, ty));

    // A hole whose type may not be interpolated at all is an error, as in tsc,
    // and takes precedence over any reduction. Checking continues as `string`,
    // the type every template has once its holes are stringified.
    notStringifiable = types.zip(holeTypes).zip(holes).filter(p ->
      p.i1 is THNotStringifiable _
    );
    if (!notStringifiable.isEmpty()) {
      for (p in notStringifiable) {
        (ty, holeType) = p.i0;
        tcenvb.error(
          Array[
            (
              ty.pos,
              `Type ${quoteRenderedType(
                prettyPrintType(false, holeType, subst, this),
              )} is not assignable to type 'string | number | bigint | boolean | null | undefined'`,
            ),
          ],
          TSCode(2322),
        )
      };
      return TType::single(TPrimValue(TString(), None(), pos))
    };

    // `never` has no values, so a template containing it has none either: no
    // string can be built. It absorbs, exactly as in tsc.
    if (
      holes.any(h ->
        h match {
        | THFinite(vs) -> vs.isEmpty()
        | _ -> false
        }
      )
    ) {
      return TType::bottom(pos)
    };

    // `\`${string}\`` (and any all-bare-string template with no text of its own)
    // is not a pattern over `string` -- it IS `string`, and tsc treats the two as
    // the same type.
    if (
      strings.all(s -> s == "") &&
      !holes.isEmpty() &&
      holes.all(h -> h is THBareString _)
    ) {
      return TType::single(TPrimValue(TString(), None(), pos))
    };

    values = mutable Vector<String>[strings[0]];
    for (i in Range(0, holes.size())) {
      holes[i] match {
      | THFinite(holeValues) ->
        // Guard before materializing: the product is multiplicative, so an
        // unguarded expansion can exhaust memory on a type tsc rejects cleanly.
        if (values.size() * holeValues.size() >= kMaxTemplateUnionSize) {
          tcenvb.error(
            Array[
              (
                pos,
                "Expression produces a union type that is too complex to represent",
              ),
            ],
            TSCode(2590),
          );
          return TType::single(TPrimValue(TString(), None(), pos))
        };
        next = mutable Vector<String>[];
        for (prefix in values) {
          for (v in holeValues) {
            next.push(prefix + v + strings[i + 1])
          }
        };
        !values = next
      | THBareString()
      | THIrreducible() ->
        fatalError(
          Array[
            (
              types[i].pos,
              "Template literal types are only supported when every interpolation has finitely many values, which this one does not",
            ),
          ],
          SKJSCode(9018),
        )
      | THNotStringifiable() -> invariant_violation("reported above")
      }
    };

    PrimLiterals::ofSet(SortedSet::createFromItems(values), pos) match {
    | Some(lits) -> TType::single(TPrimValue(TString(), Some(lits), pos))
    // Unreachable: `values` starts non-empty and only grows, and an empty hole
    // is handled by the `never` case above. Guarded because an empty literal set
    // would silently mean the WHOLE `string` primitive, not `never`.
    | None() -> TType::bottom(pos)
    }
  }

  // Classifies the strings a template hole's type can produce at runtime.
  private fun templateHole(subst: mutable Subst, hole: TType): TemplateHole {
    hole.expandToVectors(subst, this, None()) match {
    // Top: `unknown` (which tsc rejects here) or `any`.
    | None() -> THNotStringifiable()
    | Some((insts, clauses)) ->
      values = mutable Vector<String>[];
      // A hole is a union, so its members are accumulated and judged together
      // rather than returned on: the verdicts do not commute. `string` absorbs
      // an unbounded sibling (`${string | number}` IS `string`), and a sibling
      // that may not be interpolated at all outranks both (`${number | symbol}`
      // is a constraint error, not an unsupported one), so returning on the
      // first unbounded member would decide by stype order.
      notStringifiable = false;
      bareString = false;
      // A residual named or type-variable type resolves to no values here.
      irreducible = !insts.isEmpty();
      for (clause in clauses) {
        // An abstract type parameter, as in `type Wrap<T> = \`a${T}b\``.
        if (!clause.vars.isEmpty()) !irreducible = true;
        clause.stypes match {
        | None() -> !irreducible = true
        | Some(stypes) ->
          for (stype in stypes) {
            stype match {
            | TPrimValue(TString(), Some(lits), _)
            | TPrimValue(TBool(), Some(lits), _) ->
              // A string literal's value is already cooked, and a boolean's is
              // its runtime spelling, so both are used verbatim.
              for (lit in lits.values()) values.push(lit.val)
            | TPrimValue(TNum(), Some(lits), _) ->
              for (lit in lits.values()) {
                // A number literal's name is its ECMAScript String() form only
                // when the spelling pins down one double. The normalizer leaves
                // a beyond-precision spelling alone and keeps a radix literal
                // past 2^53 in source form (see rule 30), and neither names a
                // string any runtime value produces.
                if (isPreciseJSNumberLiteral(lit.val)) {
                  values.push(lit.val)
                } else {
                  !irreducible = true
                }
              }
            | TPrimValue(TBigInt(), Some(lits), _) ->
              // Exact at any magnitude, unlike a number: only the `n` suffix,
              // which the runtime string lacks, has to come off.
              for (lit in lits.values()) values.push(lit.val.stripSuffix("n"))
            | TPrimValue(TBool(), None(), _) ->
              // `boolean` is the saturated two-literal set, which union
              // normalizes to None().
              values.push("false");
              values.push("true")
            | TPrimValue(TString(), None(), _) -> !bareString = true
            | TPrimValue(TNum(), None(), _)
            | TPrimValue(TBigInt(), None(), _) ->
              !irreducible = true
            | TPrimUnit(TNull(), _) -> values.push("null")
            | TPrimUnit(TUndefined(), _) -> values.push("undefined")
            | _ -> !notStringifiable = true
            }
          }
        }
      };
      if (notStringifiable) {
        THNotStringifiable()
      } else if (bareString) {
        // Every string is in `string`, so a hole that is `string` at all is
        // `string`, whatever else it also is.
        THBareString()
      } else if (irreducible) {
        THIrreducible()
      } else {
        THFinite(SortedSet::createFromItems(values))
      }
    }
  }

  private fun normalizeTuple(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    taTuple: TATuple,
    isReadonly: Bool,
  ): TType {
    tupleElts = taTuple match {
    | TATuple(elts) -> elts
    };
    types = tupleElts.map(ty ->
      ty match {
      | TEType(n, optional, x) ->
        if (n is Some _) {
          tcenvb.error(
            Array[(pos, "Named tuple elements are not yet supported by SKJS")],
            SKJSCode(9022),
          )
        };
        if (optional is Some _) {
          tcenvb.error(
            Array[
              (pos, "Optional tuple elements are not yet supported by SKJS"),
            ],
            SKJSCode(9023),
          )
        };
        this.normalize(tcenvb, x)
      | TESpread _ ->
        fatalError(
          Array[
            (pos, "Tuple rest/spread elements are not yet supported by SKJS"),
          ],
          SKJSCode(9024),
        )
      }
    );
    TType::tuple(pos, types, isReadonly)
  }

  private fun isValidTypeofExpr(expr: Expr): Bool {
    expr.value match {
    | Var(_) -> true
    | Dot(_, baseExpr, _) -> this.isValidTypeofExpr(baseExpr)
    | _ -> false
    }
  }

  fun typeOfExpr(tcenvb: mutable TCEnvBase, expr: Expr): TType {
    (this, tcenvb) match {
    | (tc @ TypeChecker _, tcenv @ TCEnv _) ->
      // Validate structure first - only Var and Dot allowed
      if (!this.isValidTypeofExpr(expr)) {
        tcenvb.error(
          Array[
            (
              expr.pos,
              "A 'typeof' operand must be an identifier or a property access",
            ),
          ],
          SKJSCode(2052),
        )
      };
      return tc.expr(tcenv, expr, false)
    | _ -> void
    };
    expr.value match {
    | Var(Name(_, "undefined")) ->
      TType::single(TPrimUnit(TUndefined(), expr.pos))
    | Var(varName) ->
      sawInterface = false;
      sawValueDef = false;
      sawTypeAlias = false;
      for (def in this.defMap.getAll(tcenvb, varName)) {
        def match {
        | FDVar(kind, _, Some(t), _) ->
          if (this.typeofValues.contains(varName.value)) {
            // v's type is `typeof v`, directly or through other values — it
            // refers to itself, so it denotes nothing. Report it and stop,
            // rather than resolve it forever.
            tcenvb.error(
              Array[
                (
                  varName.pos,
                  `'${
                    varName.value
                  }' is referenced directly or indirectly in its own type annotation`,
                ),
              ],
              TSCode(2502),
            );
            return TType::bottom(varName.pos)
          };
          !this.typeofValues = this.typeofValues.set(varName.value);
          return this.normalize(
            tcenvb,
            t,
            kind is VDKConst _,
            Some(varName.value),
          )
        | fd @ TopLevelFunDef _ ->
          cgNode = fd.cgNode.fromSome();
          return TType::single(
            TObject::createCall(this.funDecl(tcenvb, None(), fd, cgNode)),
          )
        | Class{kind => CKInterface()} -> !sawInterface = true
        | Class _ ->
          subst = Subst::mcreate(tcenvb);
          return this.newStatic(subst, varName)
        | TypeDef _ -> !sawTypeAlias = true
        | en @ Enum _ -> return this.enumStatic(tcenvb, en)
        | FDVar _ -> !sawValueDef = true
        // EnumMemberDef is only synthesized in type position, never returned
        // by a value-position (typeOnly=false) lookup.
        | EnumMemberDef _ -> void
        }
      };
      if (sawInterface && !sawValueDef) {
        interfaceAsValueError(tcenvb, varName);
        // Continue as if the interface name were a value.
        subst = Subst::mcreate(tcenvb);
        this.newStatic(subst, varName)
      } else if (sawTypeAlias && !sawValueDef) {
        typeAliasAsValueError(varName)
      } else {
        fatalError(
          Array[(varName.pos, `Cannot find name '${varName.value}'`)],
          TSCode(2304),
        )
      }
    | Dot(_, baseExpr, propertyName) ->
      if (propertyName.value == "prototype") {
        notSupported(propertyName.pos, "prototype access")
      };
      baseType = this.typeOfExpr(tcenvb, baseExpr);
      subst = Subst::mcreate(tcenvb);
      baseType.getSTypes(subst, this, Covariant()).flatMap(sTypes ->
        sTypes.singleElt()
      ) match {
      | Some(obj @ TObject _) ->
        obj.getType(subst, this, propertyName.value, expr.pos)
      | _ ->
        fatalError(
          Array[
            (
              propertyName.pos,
              `Cannot access a property on non-object type ${quoteRenderedType(
                prettyPrintType(false, baseType, subst, this),
              )}`,
            ),
          ],
          TSCode(2339),
        )
      }
    | _ ->
      fatalError(
        Array[
          (
            expr.pos,
            "A 'typeof' operand must be an identifier or a property access",
          ),
        ],
        SKJSCode(2052),
      )
    }
  }

  // Resolve a well-known Symbol's unique ID (e.g. `Symbol.iterator`,
  // `Symbol.hasInstance`) via a synthetic `Symbol.<prop>` expression.
  fun getWellKnownSymbolUniqueId(
    subst: mutable Subst,
    pos: PosRange,
    prop: String,
  ): ?String {
    symbolExpr = Expr(pos, Var(Name(pos, "Symbol")));
    symExpr = Expr(pos, Dot(NormalDot(), symbolExpr, Name(pos, prop)));
    symType = this.typeOfExpr(subst, symExpr);
    symType.getSTypes(subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TSymbol(), Some(lits), _)) ->
      lits.singleElt().map(lit -> lit.val)
    | _ -> None()
    }
  }

  // Resolve Symbol.iterator's unique ID via synthetic expression
  fun getSymbolIteratorUniqueId(subst: mutable Subst, pos: PosRange): ?String {
    this.getWellKnownSymbolUniqueId(subst, pos, "iterator")
  }

  fun resolveIndexKeyKinds(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    keyType: TType,
  ): IndexKeyKinds {
    subst = Subst::mcreate(tcenvb);
    hasString = false;
    hasNumber = false;
    hasSymbol = false;
    valid = keyType.getSTypes(subst, this, Covariant()) match {
    | Some(stypes) ->
      stypes.all(stype ->
        stype match {
        | TPrimValue(TString(), None(), _) ->
          !hasString = true;
          true
        | TPrimValue(TNum(), None(), _) ->
          !hasNumber = true;
          true
        | TPrimValue(TSymbol(), None(), _) ->
          !hasSymbol = true;
          true
        | _ -> false
        }
      )
    | None() -> false
    };
    if (valid) {
      IndexKeyKinds::create{hasString, hasNumber, hasSymbol} match {
      | Some(res) -> return res
      | None() -> void
      }
    };
    fatalError(
      Array[
        (
          pos,
          "An index signature parameter type must be 'string', 'number', or 'symbol'",
        ),
      ],
      TSCode(1268),
    )
  }

  fun getIteratorElementType(
    subst: mutable Subst,
    tObj: TObject,
    pos: PosRange,
  ): ?TType {
    // Step 1: Look up [Symbol.iterator] symbol field
    iteratorMethodType = this.getSymbolIteratorUniqueId(subst, pos).flatMap(
      uniqueId -> tObj.maybeGetSymbolType(subst, this, uniqueId, pos, false),
    ) match {
    | Some(t) -> t
    | None() -> return None()
    };

    // Step 2: Get return type of calling [Symbol.iterator]()
    iteratorType = iteratorMethodType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetRetType(subst, this) match {
      | Some(retType) -> retType
      | None() -> return None()
      }
    | _ -> return None()
    };

    // Step 3: Look up "next" on the iterator object
    nextMethodType = iteratorType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetType(subst, this, "next", pos) match {
      | Some(t) -> t
      | None() -> return None()
      }
    | _ -> return None()
    };

    // Step 4: Get return type of calling next()
    nextResultType = nextMethodType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetRetType(subst, this) match {
      | Some(retType) -> retType
      | None() -> return None()
      }
    | _ -> return None()
    };

    // Step 5: Look up "value" on {value: T, done: boolean}
    nextResultType.getSTypes(subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(obj @ TObject(_, _, _)) ->
      obj.maybeGetType(subst, this, "value", pos)
    | _ -> None()
    }
  }

  // An explicit `this: void` / `this: undefined` declares a function that
  // ignores its receiver. Its body may not use `this` (funDefSetup enforces
  // this), so it is sound to treat it as a genuinely free function (`NoThis`):
  // assignable to a no-`this` type and callable with any receiver.
  static fun isReceiverlessThis(
    subst: mutable Subst,
    tenv: TEnv,
    thisTy: TType,
  ): Bool {
    thisTy.getSTypes(subst, tenv, Covariant()) match {
    | Some(sTypes) ->
      sTypes.all(st ->
        st is TPrimUnit(TVoid(), _) || st is TPrimUnit(TUndefined(), _)
      )
    | None() -> false
    }
  }

  // isDeclaredSignature: true only when tafun is a named function/method
  // declaration's own signature (from funDecl) — the only case where a
  // top-level `x is T` return type is accepted (see normalizeReturnType).
  // False (the default) for every other TAFun position: constructor
  // synthesis, callable/newable object types, and TAFun appearing as a
  // nested type annotation (e.g. a type alias or callback parameter type),
  // where `x is T` is never legal.
  fun normalizeFun(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    tafun: TAFun,
    isDeclaredSignature: Bool = false,
    isShapeMethod: Bool = false,
    implicitThisOpt: ?TType = None(),
  ): TFuns {
    tafun match {
    | TAFun(isMethod, tParams, params, retType, cgNode) ->
      subst = Subst::mcreate(tcenvb);
      TypeChecker::checkTypeParams(
        tcenvb,
        tParams,
        OptionalTypeParamsForbidden(),
      );
      funTParams = tParams.map(tparam -> {
        // invariant(
        //   tparam.default is None(),
        //   "no-default type parameter (already checked in checkTypeParams)",
        // );
        funTParam = this.makeTParam(tcenvb, tparam);
        // Bind the method-local tparam, overwriting any same-named
        // outer class/type-def instantiation binding. This gives the
        // method its own scope for `tparam.name.value` within its
        // signature. (#606)
        !this.bindings[tparam.name.value] = TType::fromTParamWithConstraint(
          subst,
          this,
          tparam.name.pos,
          funTParam,
        );
        funTParam
      });
      normalParams = mutable Vector[];
      optionalParams = mutable Vector[];
      optionalWitness: ?PosRange = None();
      spreadParam: ?TType = None();
      thisParam: ?TType = None();
      for (i => param in params) {
        paramTypeAst = param.requiredType();
        paramType = this.normalize(tcenvb, paramTypeAst);
        param.name.value match {
        | PVar(Name(thisPos, "this")) ->
          if (i > 0) {
            tcenvb.error(
              Array[
                (thisPos, "A 'this' parameter must be the first parameter"),
              ],
              TSCode(2730),
            );
            continue
          };
          invariant(thisParam is None(), "Assigning thisParam multiple times");
          param.isRest.each(restPos ->
            tcenvb.error(
              Array[(restPos, "A 'this' parameter cannot be a rest parameter")],
              SKJSCode(2026),
            )
          );
          param.omittablePos().each(optPos ->
            tcenvb.error(
              Array[(optPos, "A 'this' parameter cannot be optional")],
              SKJSCode(2027),
            )
          );
          !thisParam = Some(paramType);
          continue
        | _ -> checkPatternDoesNotContainThis(param.name)
        };
        param.isRest match {
        | Some(restPos) ->
          param.optional match {
          | Some(optPos) ->
            tcenvb.error(
              Array[(optPos, "A rest parameter cannot be optional")],
              TSCode(1047),
            )
          | None() -> void
          };
          !spreadParam = Some(TType::arrayToReadonlyArray(paramType));
          VariadicTyping::checkRestParamReadonly(
            tcenvb,
            this,
            restPos,
            paramTypeAst,
            tParams,
          );
          if (i != params.size() - 1) {
            tcenvb.error(
              Array[
                (restPos, "A rest parameter must be last in a parameter list"),
              ],
              TSCode(1014),
            );
            break void
          };
          continue
        | None() -> void
        };
        param.omittablePos() match {
        | None() ->
          optionalWitness match {
          | None() -> void
          | Some(wpos) ->
            tcenvb.error(
              Array[
                (
                  paramTypeAst.pos,
                  "A required parameter cannot follow an optional parameter",
                ),
                (wpos, "It appears after this parameter that is optional"),
              ],
              TSCode(1016),
            )
          };
          normalParams.push(paramType)
        | Some(wpos) ->
          !optionalWitness = Some(wpos);
          optionalParams.push(
            TType::unionUndefined(subst, this, paramType, wpos),
          )
        }
      };
      thisParamValue: ThisParam = thisParam match {
      | Some(t) ->
        // An explicit `this: void` / `this: undefined` gives the body no
        // receiver to use (funDefSetup rejects any use of `this`), so the
        // function is effectively free: freely callable, assignable to a
        // no-`this` type, and its `.call`/`.apply`/`.bind` accept the natural
        // `undefined` receiver. Represent it as `NoThis`.
        if (TEnv::isReceiverlessThis(subst, this, t)) {
          NoThis()
        } else {
          Explicit(t)
        }
      | None() ->
        implicitThisOpt match {
        | Some(i) -> ImplicitClass(i)
        | None() -> if (isShapeMethod) ImplicitShape() else NoThis()
        }
      };
      tfun = TFun(
        funTParams,
        thisParamValue,
        normalParams.toArray(),
        optionalParams.toArray(),
        spreadParam,
        if (isDeclaredSignature) {
          this.normalizeReturnType(tcenvb, retType, params)
        } else {
          this.normalize(tcenvb, retType)
        },
        CGNodes::singleton(cgNode),
      );
      if (isMethod) {
        TFuns::singleMethod(tfun, pos)
      } else {
        TFuns::singleFun(tfun, pos)
      }
    }
  }

  // Resolve a computed key expression to a FieldKey.
  private fun resolveComputedKeyFieldKey(
    tcenvb: mutable TCEnvBase,
    keyExpr: Expr,
  ): FieldKey {
    keyType = this.typeOfExpr(tcenvb, keyExpr);
    subst = Subst::mcreate(tcenvb);
    keyType
      .getSTypes(subst, this, Covariant())
      .flatMap(stypes -> stypes.singleElt())
      .flatMap(stype -> FieldKey::ofSType(keyExpr.pos, stype)) match {
    | Some(res) -> res
    | None() ->
      fatalError(
        Array[
          (
            keyExpr.pos,
            "A computed property key must be a literal or a 'unique symbol'",
          ),
        ],
        TSCode(1170),
      )
    }
  }

  private fun createTFields(
    tcenvb: mutable TCEnvBase,
    fieldTypes: Array<ObjectField>,
    isTopLevelConst: Bool = false,
  ): TFields {
    fieldsMap = mutable Map[];
    symbolFields = mutable Map[];
    indexes = mutable Vector[];
    call: ?TFuns = None();
    new: ?TFuns = None();

    for (elt in fieldTypes) {
      elt match {
      | fd @ ObjectFieldValue{readonly_} ->
        readonly_.each(r ->
          if (r is OFRemoveReadonly _ && !(fd.name is FNIn _)) {
            tcenvb.error(
              Array[
                (
                  r.pos,
                  "'-readonly' modifier can only appear in a mapped type",
                ),
              ],
              SKJSCode(2054),
            )
          }
        );
        fieldTy = fd.type match {
        | None() ->
          fatalError(
            Array[
              (
                fd.pos,
                `Member '${fd.name.getName()}' must have an explicit type annotation`,
              ),
            ],
            TSCode(7008),
          )
        | Some(ty) -> ty
        };
        fd.name match {
        | FNIn(boundName, kType, asOpt, op) ->
          if (asOpt.isSome()) {
            tcenvb.error(
              Array[
                (
                  fd.pos,
                  "Mapped type 'as' clauses are not yet supported by SKJS",
                ),
              ],
              SKJSCode(9028),
            )
          };
          isFieldOptional = op match {
          | None() -> false
          | Some(FNQuestion _)
          | Some(FNAdd _) ->
            true
          | Some(FNRemove _) -> false
          };
          keyTType = this.normalize(tcenvb, kType);
          subst = Subst::mcreate(tcenvb);
          hasString = false;
          hasNumber = false;
          hasSymbol = false;
          namedLiterals = mutable Vector[];
          symbolLiterals = mutable Vector[];
          // K resolves either to a concrete supported shape, an abstract type
          // parameter (TParam in clause.vars / TVar in insts), or an unsupported
          // shape (e.g. boolean). Abstract K is silently skipped only during
          // type-def validation so that generic mapped-type aliases like
          //   type Record<K extends string | number | symbol, V> = { [P in K]: V }
          // pass validation; in any other context (e.g. instantiation with an
          // outer type parameter) an abstract K is reported. Unsupported
          // shapes always error.
          isAbstract = false;
          shapeOk = keyTType.expandToVectors(subst, this, None()) match {
          | None() ->
            false // K expanded to Top (e.g. any/unknown) — unsupported
          | Some((insts, clauses)) ->
            ok = insts.isEmpty();
            for (clause in clauses) {
              if (!clause.vars.isEmpty()) !isAbstract = true;
              clause.stypes match {
              | None() -> !ok = false
              | Some(stypes) ->
                for (stype in stypes) {
                  stype match {
                  | TPrimValue(TString(), None(), _) -> !hasString = true
                  | TPrimValue(TNum(), None(), _) -> !hasNumber = true
                  | TPrimValue(TSymbol(), None(), _) -> !hasSymbol = true
                  | TPrimValue(TString(), Some(lits), _)
                  | TPrimValue(TNum(), Some(lits), _) ->
                    for (lit in lits.values()) namedLiterals.push(lit.val)
                  | TPrimValue(TSymbol(), Some(lits), _) ->
                    for (lit in lits.values()) symbolLiterals.push(lit.val)
                  | _ -> !ok = false
                  }
                }
              }
            };
            ok
          };
          if (isAbstract) {
            if (!this.inTypeDefValidation) {
              errPos = this.instantiateAt.default(fd.pos);
              tcenvb.error(
                Array[
                  (
                    errPos,
                    "Mapped types with an abstract key type are not yet supported by SKJS",
                  ),
                ],
                SKJSCode(9029),
              )
            }
          } else {
            if (!shapeOk) {
              tcenvb.error(
                Array[
                  (
                    fd.pos,
                    "This mapped type key shape is not yet supported by SKJS",
                  ),
                ],
                SKJSCode(9030),
              )
            } else {
              // Bind P to a deliberately-unresolvable inst type. If V references
              // P, expansion later surfaces a clear "Type … not found" error
              // naming the poison alias. For Record (V doesn't reference P),
              // this is a no-op.
              poisonName = Name(
                boundName.pos,
                "SKJS_unsupported_key_type_reference_in_mapped_type_value",
              );
              !this.bindings[boundName.value] = TType::inst(
                poisonName,
                TArgs(Array[]),
              );
              valueType = this.normalize(tcenvb, fieldTy);
              IndexKeyKinds::create{hasString, hasNumber, hasSymbol} match {
              | None() -> void
              | Some(keyKinds) ->
                indexes.push(
                  (
                    keyKinds,
                    TField::create{
                      pos => boundName.pos,
                      name => boundName.value,
                      isOptional => true,
                      isReadonly => None(),
                      type => valueType,
                      access => FAPublic(),
                    },
                  ),
                )
              };
              for (litVal in namedLiterals) {
                field = TField::create{
                  pos => boundName.pos,
                  name => litVal,
                  isOptional => isFieldOptional,
                  isReadonly => None(),
                  type => valueType,
                  access => FAPublic(),
                };
                fieldsMap![field.name] = field
              };
              for (uniqueId in symbolLiterals) {
                field = TField::create{
                  pos => boundName.pos,
                  name => uniqueId,
                  isOptional => isFieldOptional,
                  isReadonly => None(),
                  type => valueType,
                  access => FAPublic(),
                };
                symbolFields![field.name] = field
              }
            }
          }
        | simpleFieldName @ SimpleFieldName _ ->
          normalizedType = this.normalize(tcenvb, fieldTy, isTopLevelConst);
          simpleFieldName match {
          | FNNormal(name) -> FKName(name, TString())
          | FNComputed(keyExpr) ->
            this.resolveComputedKeyFieldKey(tcenvb, keyExpr)
          } match {
          | FKSymbol(exprPos, uniqueId) ->
            field = TField::create{
              pos => exprPos,
              name => uniqueId,
              isOptional => fd.optional is Some _,
              isReadonly => readonly_.map(r -> r.pos),
              type => normalizedType,
              access => FAPublic(),
            };
            symbolFields![field.name] = field
          | FKName(name, _) ->
            field = TField::create{
              pos => name.pos,
              name => name.value,
              isOptional => fd.optional is Some _,
              isReadonly => readonly_.map(r -> r.pos),
              type => normalizedType,
              access => FAPublic(),
            };
            fieldsMap![field.name] = field
          }
        | FNColon(indexName, indexType) ->
          keyType = this.normalize(tcenvb, indexType);
          keyKinds = this.resolveIndexKeyKinds(tcenvb, indexName.pos, keyType);
          valueType = this.normalize(tcenvb, fieldTy);
          indexes.push(
            (
              keyKinds,
              TField::create{
                pos => indexName.pos,
                name => indexName.value,
                isOptional => true,
                isReadonly => readonly_.map(r -> r.pos),
                type => valueType,
                access => FAPublic(),
              },
            ),
          )
        }
      | fd @ ObjectFieldMethod _ ->
        cgNode = CGNode::create(AnonymousFunDef(fd));
        // Named method-syntax members are attach-only shape methods; the
        // object's call/new signatures are not (the object itself is invoked).
        isShapeMethod = fd.name match {
        | FNNormal(Name(_, "new"))
        | FNEmpty(_) ->
          false
        | SimpleFieldName _ -> true
        };
        tFuns = this.funDecl(tcenvb, None(), fd, cgNode, isShapeMethod);
        fd.name match {
        | FNNormal(Name(_, "new")) -> !new = Some(tFuns)
        | FNEmpty(_) -> !call = Some(tFuns)
        | simpleFieldName @ SimpleFieldName _ ->
          decl = TType::single(TObject::createCall(tFuns));
          simpleFieldName match {
          | FNNormal(name) -> FKName(name, TString())
          | FNComputed(keyExpr) ->
            this.resolveComputedKeyFieldKey(tcenvb, keyExpr)
          } match {
          | FKSymbol(exprPos, uniqueId) ->
            field = TField::create{
              pos => exprPos,
              name => uniqueId,
              isOptional => fd.optional is Some _,
              isReadonly => Some(exprPos),
              type => decl,
              access => FAPublic(),
            };
            symbolFields![field.name] = field
          | FKName(name, _) ->
            field = TField::create{
              pos => name.pos,
              name => name.value,
              isOptional => fd.optional is Some _,
              isReadonly => Some(name.pos),
              type => decl,
              access => FAPublic(),
            };
            fieldsMap![field.name] = field
          }
        }
      }
    };
    tIndexes = TIndexes::create(tcenvb, this, indexes);
    tFields = TFields::create{
      fields => fieldsMap,
      symbolFields,
      tIndexes,
      new => Callability::fromSig(new),
      call => Callability::fromSig(call),
    };
    tFields
  }

  // Closed<T> (SKJS extension): close an object type by setting its string
  // and symbol index slots to `never`. SKJS index signatures are residual —
  // they cover exactly the keys not named in the type — so the never indexes
  // state that every unnamed key is provably absent (number keys fall back to
  // the string index, so no number slot is needed). `never` is TType::bottom,
  // making the index's set bottom as well: a readonly and a mutable never
  // index are the same field, so no readonly modifier is involved.
  //
  // T must expand to a statically known object type without index signatures
  // (a synthetic literal index is not a declared index: it is cleared and
  // replaced). Anything else errors and recovers with T itself — the tsc
  // reading of the recommended compat declaration `type Closed<T> = T`.
  private fun closeObjectType(
    tcenvb: mutable TCEnvBase,
    closedPos: PosRange,
    inner: TType,
  ): TType {
    subst = Subst::mcreate(tcenvb);
    // Errors anchor at the instantiation site when there is one (for the
    // stub-alias route that is the innermost alias application: a direct
    // Closed<...> use anchors at the use site; a wrapper alias anchors at the
    // wrapper's own Closed<T> application — the use-site position is erased
    // by alias re-positioning before reaching this depth).
    errPos = this.instantiateAt.default(closedPos);
    hasDeclaredIndex = (idx: ?TField) ->
      idx match {
      | Some(i) -> !i.isSynthetic()
      | None() -> false
      };
    expanded = inner.expand(subst, this, Some(Covariant()));
    // An abstract type parameter expands to a clause with non-empty vars —
    // possibly WITH the constraint's stypes (fromTParamWithConstraint), which
    // Clauses::getObject would happily return: without this guard, Closed<T>
    // for `T extends { a: number }` would silently close the CONSTRAINT.
    // Like mapped types with an abstract key (see createTFields), an abstract
    // T is deferred during type-definition validation (a generic alias body
    // is re-validated at each concrete instantiation) and rejected anywhere
    // else (e.g. a generic function signature, normalized once), reporting at
    // the instantiation site when there is one.
    if (expanded.clauses.any(clause -> !clause.vars.isEmpty())) {
      if (!this.inTypeDefValidation) {
        tcenvb.error(
          Array[(errPos, "Closed<T> requires a statically known object type")],
          SKJSCode(9033),
        )
      };
      return inner
    };
    expanded.clauses.getObject() match {
    | Some(obj) if (obj.getBranches().all(b -> b.isArray != Some(true))) ->
      if (
        obj.getBranches().any(b ->
          hasDeclaredIndex(b.stringIndex) ||
            hasDeclaredIndex(b.numberIndex) ||
            hasDeclaredIndex(b.symbolIndex)
        )
      ) {
        tcenvb.error(
          Array[
            (
              errPos,
              "Closed<T> requires an object type without index signatures",
            ),
          ],
          SKJSCode(9033),
        );
        inner
      } else {
        neverIndex = (name: String) ->
          TField::create{
            pos => closedPos,
            name,
            isOptional => true,
            isReadonly => None(),
            type => TType::bottom(closedPos),
            access => FAPublic(),
          };
        closed = obj.map(b ->
          b.withNeverIndexes(neverIndex("k"), neverIndex("s"))
        );
        TType::single(closed)
      }
    | Some _ ->
      tcenvb.error(
        Array[(errPos, "Closed<T> is not supported on array or tuple types")],
        SKJSCode(9033),
      );
      inner
    | None() ->
      tcenvb.error(
        Array[(errPos, "Closed<T> requires a statically known object type")],
        SKJSCode(9033),
      );
      inner
    }
  }

  /* Over-approximates keyof ty
     Though keyof should be treated symbolically because it is a decreasing
     function of types.
     In particular, do not use keyof to check that a key is valid.

     Try to keep in synch with TypeChecker#get in TypeCheckExpr
  */
  fun keyOfType(subst: mutable Subst, ty: TType, pos: PosRange): TType {
    clauses = ty.expandToClauses(subst, this, Covariant());
    if (
      clauses.any(clause -> (!clause.vars.isEmpty() || clause.stypes is None()))
    ) {
      return TType::union(
        subst,
        this,
        TType::single(TPrimValue(TString(), None(), pos)),
        TType::single(TPrimValue(TNum(), None(), pos)),
      )
    };
    allStrings = false;
    allNumbers = false;
    allSymbols = false;
    strings = SortedSet[];
    symbols = SortedSet[];
    for (clause in clauses) {
      invariant(clause.vars.isEmpty(), "keyof with non-empty variables");
      stypes = Vector::mcreateFromIterator(clause.stypes.fromSome().values());
      while (!stypes.isEmpty()) {
        stype = stypes.pop();
        stype match {
        | obj @ TObject(_, _, _) ->
          for (fields in obj.getAllFields()) {
            if (!allStrings || !allNumbers) {
              for (field in fields.fields) {
                !strings = strings.set(field.name.value);
              }
            };
            if (!allSymbols) {
              for (symbolField in fields.symbolFields) {
                !symbols = symbols.set(symbolField.name.value);
              }
            };
            // A never-valued index (get = bottom, e.g. from Closed<T>) proves
            // its keys absent, so it widens keyof by nothing.
            fields.stringIndex.each(idx ->
              if (!idx.get.isBottom()) !allStrings = true
            );
            fields.numberIndex.each(idx ->
              if (!idx.get.isBottom()) !allNumbers = true
            );
            fields.symbolIndex.each(idx ->
              if (!idx.get.isBottom()) !allSymbols = true
            );
          }
        | prim @ TPrimValue _ ->
          obj = this.newObject(subst, prim.asClassName(), Array[]);
          stypes.push(obj)
        | TPrimUnit _ -> void /* bottom */
        }
      }
    };
    resultTys = mutable Vector[];
    numbers = SortedSet[];
    if (allStrings) {
      resultTys.push(TType::single(TPrimValue::string(pos)))
    } else {
      stringsAndNumbers = strings.union(numbers);
      PrimLiterals::ofSet(stringsAndNumbers, pos).each(strLits ->
        resultTys.push(TType::single(TPrimValue(TString(), Some(strLits), pos)))
      )
    };
    if (allNumbers) {
      resultTys.push(TType::single(TPrimValue::number(pos)))
    } else {
      for (str in strings) {
        if (isJSNumericString(str)) !numbers = numbers.set(str)
      };
      PrimLiterals::ofSet(numbers, pos).each(nbrLits ->
        resultTys.push(TType::single(TPrimValue(TNum(), Some(nbrLits), pos)))
      )
    };
    if (allSymbols) {
      resultTys.push(TType::single(TPrimValue::symbol(pos)))
    } else {
      PrimLiterals::ofSet(symbols, pos).each(symLits ->
        resultTys.push(TType::single(TPrimValue(TSymbol(), Some(symLits), pos)))
      )
    };
    TType::unionN(subst, this, pos, resultTys)
  }

  // `T[number]`: the element type of T when T is an array or array-constrained
  // type variable.  Expands TVars to their constraints so that `N extends
  // string[]` resolves to `string`.  Returns the union of all numberIndex
  // element types across the clauses of the expanded object type.
  // TODO: generalize to `T[K]` for any `K: TPrimValue` (e.g. `string`), by
  // parameterizing this over the index kind (numberIndex/stringIndex/
  // symbolIndex) instead of hardcoding numberIndex.
  private fun numberIndexedType(
    subst: mutable Subst,
    objType: TType,
    pos: PosRange,
  ): TType {
    clauses = objType.expandToClauses(subst, this, Covariant());
    // Clauses with `vars` (TParams) are OK: vars are universally-quantified
    // type parameters; their `stypes` still carry concrete constraint info.
    // Only reject when `stypes is None()` (top — no type information at all).
    if (clauses.any(clause -> clause.stypes is None())) {
      fatalError(
        Array[
          (pos, "Indexed access types ('T[K]') are not yet supported by SKJS"),
        ],
        SKJSCode(9021),
      )
    };
    resultTys = mutable Vector[];
    for (clause in clauses) {
      stypes = Vector::mcreateFromItems(clause.stypes.fromSome());
      while (!stypes.isEmpty()) {
        stype = stypes.pop();
        stype match {
        | obj @ TObject _ ->
          for (fields in obj.getAllFields()) {
            fields.numberIndex.each(nIdx -> resultTys.push(nIdx.get));
            // A number key also reaches any named field whose name a
            // number key can produce (e.g. `{0: string}[number]`), and
            // falls back to the string index when there is no number
            // index (JS coerces a number key to a string for lookup).
            for (field in fields.fields.values()) {
              if (isJSNumberKeyName(field.name.value)) {
                resultTys.push(field.get)
              }
            };
            if (fields.numberIndex.isNone()) {
              fields.stringIndex.each(sIdx -> resultTys.push(sIdx.get))
            }
          }
        | prim @ TPrimValue _ ->
          expanded = this.newObject(subst, prim.asClassName(), Array[]);
          stypes.push(expanded)
        | TPrimUnit _ -> void
        }
      }
    };
    if (resultTys.isEmpty()) {
      fatalError(
        Array[
          (pos, "Indexed access types ('T[K]') are not yet supported by SKJS"),
        ],
        SKJSCode(9021),
      )
    };
    TType::unionN(subst, this, pos, resultTys)
  }
}

fun checkPatternDoesNotContainThis(pat: Pattern): void {
  pat.value match {
  | PVar(name) -> Some(name)
  | PArray(elements, rest) ->
    elements.each(elt -> elt.each(pe -> checkPatternDoesNotContainThis(pe.i0)));
    rest
  | PObject{fields, rest} ->
    fields.each(fld -> checkPatternDoesNotContainThis(fld.i1));
    rest
  } match {
  | Some(Name(thisPos, "this")) ->
    fatalError(
      Array[(thisPos, "'this' is not allowed in this binding position")],
      SKJSCode(2028),
    )
  | _ -> void
  }
}

module end;
