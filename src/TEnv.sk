/*****************************************************************************/
// The typing environment.
//
// The typing environment retrieves the abstract syntax tree
// corresponding to a type definition and turns it into a type.
/*****************************************************************************/

module SKJS;

class TEnv{
  // The defMap associates an AST to a type name.
  private defMap: IDefMap,

  // The type-parameters that are currently in scope. So if we see a
  // type definition with a matching name, we know we are dealing with
  // a universally quantified type variable.
  clauses: SortedMap<String, TParamWithConstraint> = SortedMap[],

  // The type substitution, which is different than the one used for
  // existentials during the inference. This one is used to
  // instantiate a type with parameters with type arguments. So when
  // you write new mytype<number>, it's this substitution that will
  // take care of replacing the instances of type-parameter in the
  // definition of mytype. However, if you introduce an existential
  // (like you would with a parametric new construct without explicit
  // type arguments), a different substitution is used (cf TVar).
  subst: SortedMap<String, (Bool, TType)> = SortedMap[],

  // When expanding a type definition, we don't want to recursively
  // get all the type instances of a type, we only want to go one
  // level deep. Concretely, consider the following type:
  //
  // type foo = { field1: null | foo, field2: number };
  //
  // When we expand foo, we want to get:
  //   { field1: null | foo, field2: number };
  //
  // We don't want the instance of foo to be expanded (because that
  // could be infinite). Instead, the second instance of foo will only
  // be expanded if that turns out to be necessary for the inference.
  // The field "seenInstantiate" enforces the fact that we only expand one
  // level deep by keeping track of the types that we are in the
  // process of expanding.
  seenInstantiate: SortedSet<String> = SortedSet[],

  // This field keeps track of type names that, if used, would define
  // a cyclic type definition.
  forbiddenInsts: SortedSet<String> = SortedSet[],

  // This field keeps track of the intersections that we are in the
  // process of computing. If a cycle occurs, the type TInter(t1, t2)
  // will be returned.
  seenInter: SortedSet<(TType, TType)> = SortedSet[],

  // This field keeps track of the subtyping relations that we are in
  // the process of checking. If a cycle occurs, the subtyping
  // relation is considered correct (by co-induction).
  seenSub: SortedSet<(Int, TType, TType)> = SortedSet[],
} {
  static fun fromSortedMap(typeDefs: SortedMap<String, TypeDef>): this {
    static{defMap => SortedDefMap{map => typeDefs}}
  }

  // Given a type name and type arguments, first retrieves the type
  // definition (using the defMap) and then produces a type where the
  // type parameters have been replaced with the corresponding type
  // arguments (as expected).
  fun instantiate(
    context: mutable SKStore.Context,
    name: Name,
    targs: TArgs,
  ): TType {
    // We are dealing with a recursive instance, if we keep on
    // unfolding, we will end up in an infinite loop. Instead, we
    // produce a type that can be later lazily unfolded if need be.
    if (this.seenInstantiate.contains(name.value)) {
      return TType::inst(name, targs);
    };
    !this.seenInstantiate = this.seenInstantiate.set(name.value);

    tdef = this.defMap.getType(context, name);
    clauses = tdef match {
    | TDType(ta) ->
      if (ta.tdefParams.size() != targs.targs.size()) {
        typingError(Array[(name.posRange, "Invalid number of type arguments")])
      };
      ta.tdefParams
    | TDClass(ca) ->
      if (ca.tparams.size() != targs.targs.size()) {
        typingError(Array[(name.posRange, "Invalid number of type arguments")])
      };
      ca.tparams
    };

    for (i => targ in targs.targs) {
      tparam = clauses[i];
      tparam.constraint match {
      | None() -> void
      | Some(cstr) ->
        cstrTy = this.normalize(context, cstr);
        isSubTType(Subst::mcreate{context}, this, targ, cstrTy) match {
        | STOk() -> void
        | _ ->
          typingError(
            Array[
              (name.posRange, "Constraint not satisfied"),
              (targ.pos, "This is of type: " + targ.toString()),
              (cstr.posRange, "It does not implement: " + cstrTy.toString()),
            ],
          )
        }
      };
      if (tparam.default is Some _) {
        invariant_violation("TODO default type param");
      };
      !this.subst[tparam.name.value] = (true, targ);
    };

    tdef match {
    | TDType(ta) -> this.normalize(context, ta.body)
    | TDClass(_) -> this.new(context, name, targs.targs)
    }
  }

  fun getClass(context: mutable SKStore.Context, className: Name): Class {
    tdef = this.defMap.getType(context, className);
    tdef match {
    | TDType(_) ->
      typingError(Array[(className.posRange, "Expected a class name")])
    | TDClass(ca) -> ca
    };
  }

  fun makeTArgs(
    context: mutable SKStore.Context,
    subst: mutable Subst,
    className: Name,
  ): Array<TType> {
    this.getClass(context, className).tparams.map(tparam -> {
      tvar = subst.gen(className.posRange);
      ty = TType::fromTInst(className.posRange, tvar);
      tparam.constraint match {
      | None() -> ty
      | Some(cstr) ->
        TType::union(subst, this, this.normalize(context, cstr), ty)
      }
    })
  }

  fun new(
    context: mutable SKStore.Context,
    className: Name,
    targs: Array<TType>,
    filter: FieldType ~> Bool = _ ~> true,
  ): TType {
    obj = this.newObject(context, className, targs, filter);
    TType::single(className.posRange, obj)
  }

  fun newObject(
    context: mutable SKStore.Context,
    className: Name,
    targs: Array<TType>,
    filter: FieldType ~> Bool = _ ~> true,
  ): TObject {
    c = this.getClass(context, className);
    if (c.tparams.size() != targs.size()) {
      typingError(
        Array[
          (className.posRange, "Expected " + c.tparams.size() + " parameters"),
        ],
      )
    };
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    thisType = TType::inst(className, TArgs(targs));
    !this.subst["this"] = (false, thisType);
    this.addFields(
      context,
      fields,
      visitedClasses,
      false,
      className,
      targs,
      fieldType ~> {
        filter(fieldType) &&
          !fieldType.modifiers.modifiers.containsKey("static")
      },
    );
    TObject(TFields::create(fields.values().collect(Array)), className.posRange)
  }

  fun newStatic(context: mutable SKStore.Context, className: Name): TType {
    obj = this.newStaticObject(context, className);
    TType::single(className.posRange, obj)
  }

  fun newStaticObject(
    context: mutable SKStore.Context,
    className: Name,
  ): TObject {
    targs = Array[];
    visitedClasses = SortedSet[];
    fields = mutable Map[];
    this.addFields(
      context,
      fields,
      visitedClasses,
      true,
      className,
      targs,
      fieldType ~> fieldType.modifiers.modifiers.containsKey("static"),
    );
    TObject(TFields::create(fields.values().collect(Array)), className.posRange)
  }

  fun addTParams(
    context: mutable SKStore.Context,
    clauses: Array<TypeParam>,
  ): this {
    for (tparam in clauses) {
      ty = TType::fromClauses(
        tparam.name.posRange,
        Clauses::fromTypeParam(tparam, None()),
      );
      !this.subst[tparam.name.value] = (
        false,
        tparam.constraint match {
        | None() -> ty
        | Some(cstr) ->
          interTType(
            Subst::mcreate{context},
            this,
            ty,
            this.normalize(context, cstr),
          )
        },
      )
    };
    this
  }

  fun addFields(
    context: mutable SKStore.Context,
    acc: mutable Map<String, TField>,
    visitedClasses: SortedSet<String>,
    isStatic: Bool,
    className: Name,
    targs: Array<TType>,
    filter: FieldType ~> Bool,
  ): void {
    if (visitedClasses.contains(className.value)) {
      typingError(Array[(className.posRange, "Cyclic class definition")]);
    };
    !visitedClasses = visitedClasses.set(className.value);
    c = for (def in this.defMap.get(
      context,
      FileName::create(className.posRange.fileName),
      className,
    )) {
      def.value match {
      | c @ Class _ -> break c
      | _ -> void
      }
    } else {
      typingError(Array[(className.posRange, "Unbound class")])
    };
    if (targs.size() != 0 && targs.size() != c.tparams.size()) {
      typingError(
        Array[
          (className.posRange, "Invalid number of type arguments"),
          (c.name.posRange, "Class declaration is here"),
        ],
      )
    };
    if (!isStatic) {
      for (i => tparam in c.tparams) {
        !this.subst[tparam.name.value] = (false, targs[i])
      };
    };
    for (extend in c.extends_) {
      extend.value match {
      | TAInst(parentName, paramTArgs) ->
        this.addFields(
          context,
          acc,
          visitedClasses,
          isStatic,
          parentName,
          if (isStatic) Array[] else {
            paramTArgs.map(targ -> this.normalize(context, targ))
          },
          filter,
        )
      | _ -> typingError(Array[(extend.posRange, "Unexpected extend")])
      }
    };
    for (fieldType in c.fields) {
      if (!filter(fieldType)) continue;
      fieldType match {
      | field @ FieldTypeValue _ ->
        field.setGet match {
        | None() -> void
        | Some(FieldGetSet(_, pos)) -> notSupported(pos)
        };
        for (modifier in field.modifiers.modifiers) {
          if (modifier.value != "static") {
            typingError(Array[(modifier.posRange, "TODO: field modifier")])
          }
        };
        type = field.type match {
        | None() -> typingError(Array[(field.pos, "Missing type annotation")])
        | Some(ty) -> this.normalize(context, ty)
        };
        fieldName = field.name match {
        | FNNormal(x) -> x.value
        | _ -> typingError(Array[(field.pos, "Unsupported field name")])
        };
        TField::create(
          field.pos,
          fieldName,
          field.optional is Some _,
          type,
        ) match {
        | None() ->
          typingError(
            Array[
              (field.pos, `Forbidden field name '${fieldName}' in a class`),
            ],
          )
        | Some(f) -> acc![fieldName] = f
        }
      | fd @ FunDef _ ->
        (metName, metType) = this.funDecl(context, true, fd);
        TField::create(fd.pos, metName.value, false, metType) match {
        | None() ->
          typingError(
            Array[(fd.pos, `Forbidden method name '${metName.value}'`)],
          )
        | Some(field) -> acc![metName.value] = field
        }
      }
    }
  }

  fun funDecl(
    context: mutable SKStore.Context,
    isMethod: Bool,
    fd: FunDef,
  ): (Name, TType) {
    name = fd.name match {
    | Some(FNNormal(x)) -> x
    | None() -> notSupported(fd.pos, "anonymous function")
    | _ -> notSupported(fd.pos, "non-normal function name")
    };
    fty = this.normalize(
      context,
      Type(
        fd.pos,
        TAFun(
          isMethod,
          fd.tparams,
          fd.params.map(param -> {
            (paramName, ty) = param.name match {
            | PNName(n, tyOpt) ->
              tyOpt match {
              | None() ->
                param.type match {
                | None() ->
                  typingError(Array[(n.posRange, "Missing type annotation")])
                | Some(ty) -> (TAParamName(n), ty)
                }
              | Some(ty) -> (TAParamName(n), ty)
              }
            | PNDDD(n) ->
              param.type match {
              | None() ->
                typingError(Array[(n.posRange, "Missing type annotation")])
              | Some(x) -> (TAParamSpread(n), x)
              }
            | _ ->
              typingError(
                Array[
                  (param.pos, "TODO: support for param pattern in typeDecl"),
                ],
              )
            };
            TAFunParam(Some(paramName), param.optional, ty)
          }),
          fd.retType.i1 match {
          | None() -> // constructor
            Type(fd.retType.i0, TAInst(Name(fd.retType.i0, "void"), Array[]))
          | Some(x) -> x
          },
        ),
      ),
    );
    (name, fty)
  }

  fun normalize(context: mutable SKStore.Context, typeAst: Type): TType {
    subst = Subst::mcreate{context};
    pos = typeAst.posRange;
    typeAst.value match {
    | TABigIntLiteral _ -> invariant_violation("TODO BigIntLiteral ")
    | TAAssertIs _ -> invariant_violation("TODO assertIs ")
    | TAAbstract _ -> invariant_violation("TODO abstract ")
    | TAUniqueSymbol() -> invariant_violation("TODO uniqueSymbol ")
    | TAAsserts _ -> invariant_violation("TODO asserts ")
    | TAIs _ -> invariant_violation("TODO is ")
    | TANew _ -> invariant_violation("TODO new ")
    | TAKeyOf _ -> invariant_violation("TODO keyof ")
    | TAEmptyArray _ -> invariant_violation("TODO emptyArray ")
    | TAInfer _ -> invariant_violation("TODO infer ")
    | TATemplate _ -> invariant_violation("TODO template ")
    | TAImport _ -> invariant_violation("TODO import ")
    | TAReadonly _ -> invariant_violation("TODO readonly ")
    | TAExtends _ -> invariant_violation("TODO extends ")
    | TAExtendsQuestion _ -> invariant_violation("TODO extendsQuestion ")
    | TAStringLiteral(x) ->
      TType::single(
        pos,
        TPrimValue(
          TString(),
          Some(ArrayValues::single((typeAst.posRange, x))),
          typeAst.posRange,
        ),
      )
    | TANumLiteral(x) ->
      TType::single(
        pos,
        TPrimValue(
          TNum(),
          Some(ArrayValues::single((typeAst.posRange, x))),
          typeAst.posRange,
        ),
      )
    | TATypeOf(expr) ->
      expr.value match {
      | Var(name) ->
        name.value match {
        | "undefined" ->
          TType::single(pos, TPrimVoid(TUndefined(), name.posRange))
        | _ -> invariant_violation(`TODO typeof ${name.value}`)
        }
      | Binop(BODot(), _, Expr(_, Var(_))) -> invariant_violation("TODO typeof")
      | _ -> typingError(Array[(expr.posRange, "Invalid typeof expression")])
      }
    | TAPrim(kind) ->
      TType::single(
        pos,
        kind match {
        | TPKNull() -> TPrimVoid(TNull(), typeAst.posRange)
        | TPKBool() -> TPrimValue(TBool(), None(), typeAst.posRange)
        | TPKNum() -> TPrimValue(TNum(), None(), typeAst.posRange)
        | TPKString() -> TPrimValue(TString(), None(), typeAst.posRange)
        },
      )
    | TAObject(fields) ->
      (algebraicBranchField, tFields) = this.createTFields(context, fields);
      createObject(typeAst.posRange, algebraicBranchField, tFields)
    | TAInst(n @ Name(p, "object"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(n.posRange, "Invalid number of type arguments")])
      };
      TType::single(p, TObject(TFields::empty(), p))

    | TAInst(n @ Name(p, "Array"), targs) ->
      if (targs.size() != 1) {
        typingError(Array[(n.posRange, "Invalid number of type arguments")])
      };
      TType::fromTInst(
        pos,
        TSInst(
          Name(p, "Array"),
          TArgs(Array[this.normalize(context, targs[0])]),
        ),
      )

    | TAArray(ty) ->
      TType::fromTInst(
        pos,
        TSInst(Name(pos, "Array"), TArgs(Array[this.normalize(context, ty)])),
      )

    | TAInst(n @ Name(p, "void"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(n.posRange, "Invalid number of type arguments")])
      };
      TType::single(p, TPrimVoid(TVoid(), p))
    | TAInst(n @ Name(p, "undefined"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(n.posRange, "Invalid number of type arguments")])
      };
      TType::single(p, TPrimVoid(TUndefined(), p))
    | TAInst(n @ Name(_, "Promise"), targs) ->
      if (targs.size() != 1) {
        typingError(Array[(n.posRange, "Invalid number of type arguments")])
      };
      TType::single(
        pos,
        TPromise(this.normalize(context, targs[0]), typeAst.posRange),
      )
    | TAInst(Name(_, "never"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(pos, "Invalid number of type arguments")])
      };
      TType::bottom(pos)
    | TAInst(Name(_, x @ "true"), targs)
    | TAInst(Name(_, x @ "false"), targs) ->
      if (targs.size() != 0) {
        typingError(Array[(pos, "Invalid number of type arguments")])
      };
      TType::single(
        pos,
        TPrimValue(
          TBool(),
          Some(ArrayValues::single((typeAst.posRange, x))),
          typeAst.posRange,
        ),
      )
    | TAInst(n, targs) ->
      if (this.clauses.containsKey(n.value)) {
        if (targs.size() != 0) {
          typingError(
            Array[(n.posRange, "A type parameter cannot have type argument")],
          )
        };
        tparam = this.clauses[n.value];
        ty = TType::fromClauses(
          pos,
          Clauses::fromTParamWithConstraint(tparam, None()),
        );
        tparam.cstr match {
        | None() -> ty
        | Some(cstr) -> interTType(Subst::mcreate{context}, this, ty, cstr)
        }
      } else if (this.subst.containsKey(n.value)) {
        if (targs.size() != 0) {
          typingError(
            Array[(n.posRange, "A type parameter cannot have type argument")],
          )
        };
        (keepPos, ty) = this.subst[n.value];
        if (keepPos) ty else ty.withPos(pos)
      } else if (this.forbiddenInsts.contains(n.value)) {
        typingError(Array[(n.posRange, "Cyclic definition")])
      } else {
        tdef = this.defMap.getType(context, n);
        tdef match {
        | TDType(ta) ->
          if (ta.tdefParams.size() != targs.size()) {
            typingError(Array[(n.posRange, "Invalid number of type arguments")])
          }
        | TDClass(ca) ->
          if (ca.tparams.size() != targs.size()) {
            typingError(Array[(n.posRange, "Invalid number of type arguments")])
          }
        };

        TType::fromTInst(
          pos,
          TSInst(
            n,
            TArgs(
              targs.map(x ->
                (this with {forbiddenInsts => this.seenInstantiate}).normalize(
                  context,
                  x,
                )
              ),
            ),
          ),
        )
      }
    | TAUnion(ty1, ty2) ->
      ty = TType::union(
        subst,
        this,
        this.normalize(context, ty1),
        this.normalize(context, ty2),
      );
      ty.withPos(pos)
    | TAInter(ty1, ty2) ->
      ty = interTType(
        subst,
        this,
        this.normalize(context, ty1),
        this.normalize(context, ty2),
      );
      ty.withPos(pos)
    | TATuple(tupleElts) ->
      typeVec = mutable Vector[];
      for (ty in tupleElts) {
        ty match {
        | TEType(n, optional, x) ->
          if (n is Some _) invariant_violation("TODO named tuple");
          if (optional is Some _) {
            invariant_violation("TODO optional element tuple")
          };
          typeVec.push(x)
        | TESpread _ -> invariant_violation("TODO tuple spread")
        }
      };
      types = typeVec.toArray();
      TType::single(
        pos,
        TTuple(types.map(ty -> this.normalize(context, ty)), typeAst.posRange),
      )
    | TAFun(isMethod, clauses, params, retType) ->
      funClauses = mutable Vector[];
      for (tparam in clauses) {
        funTParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.posRange.fileName,
          tparam.id,
          tparam.constraint.map(cstr -> this.normalize(context, cstr)),
        );
        funClauses.push(funTParam);
        !this.clauses[tparam.name.value] = funTParam;
      };
      normalParams = mutable Vector[];
      optionalParams = mutable Vector[];
      optionalWitness: ?PosRange = None();
      spreadParam: ?TType = None();
      for (i => param in params) {
        paramType = this.normalize(context, param.type);
        param.name match {
        | Some(TAParamSpread(spreadName)) ->
          if (i != params.size() - 1) {
            typingError(
              Array[
                (spreadName.posRange, "... must always be the last parameter"),
              ],
            );
          };
          !spreadParam = Some(paramType);
          continue
        | _ -> void
        };
        param.optional match {
        | None() ->
          optionalWitness match {
          | None() -> normalParams.push(paramType)
          | Some(wpos) ->
            typingError(
              Array[
                (param.type.posRange, "This parameter is not optional"),
                (wpos, "It appears after this parameter that is optional"),
              ],
            )
          }
        | Some(wpos) ->
          !optionalWitness = Some(wpos);
          optionalParams.push(paramType)
        }
      };
      tfun = TFun(
        funClauses.toArray(),
        normalParams.toArray(),
        optionalParams.toArray(),
        spreadParam,
        pos,
        Array[],
        this.normalize(context, retType),
      );
      tfuns = if (isMethod) {
        TFuns::singleMethod(tfun, typeAst.posRange)
      } else {
        TFuns::singleFun(tfun, typeAst.posRange)
      };
      TType::single(pos, tfuns)
    | TAGet _ -> invariant_violation("TODO TAGet")
    }
  }

  /*
    The first element is the position and the type of the algebraic branch field if it is present.
   */
  fun createTFields(
    context: mutable SKStore.Context,
    fields: Array<FieldType>,
  ): (?(PosRange, TType), TFields) {
    algebraicBranchField: ?(PosRange, TType) = None();
    tFields = TFields::create(
      fields.filterMap(elt -> {
        elt match {
        | fd @ FieldTypeValue _ ->
          fd.type match {
          | None() -> invariant_violation("TODO no type")
          | Some(ty) ->
            normalizedType = this.normalize(context, ty);
            fd.name match {
            | FNColon _ -> invariant_violation("TODO fnColon")
            | FNIn _ -> invariant_violation("TODO fnIn")
            | FNSymbol _ -> invariant_violation("TODO symbol")
            | FNNormal(name) ->
              optField = TField::create(
                name.posRange,
                name.value,
                fd.optional is Some _,
                normalizedType,
              );
              if (optField is None()) {
                algebraicBranchField match {
                | Some((existingPos, _existingType)) ->
                  typingError(
                    Array[
                      (name.posRange, `Duplicate field ${name.value}`),
                      (existingPos, "Previously declared here"),
                    ],
                  )
                | None() -> void
                };
                fd.optional match {
                | Some(optionalPos) ->
                  typingError(
                    Array[
                      (optionalPos, `Field ${name.value} cannot be optional`),
                    ],
                  )
                | None() -> void
                };
                !algebraicBranchField = Some((name.posRange, normalizedType))
              };
              optField
            }
          }
        | fd @ FunDef _ ->
          (name, decl) = this.funDecl(context, true, fd);
          optField = TField::create(name.posRange, name.value, false, decl);
          if (optField is None()) {
            typingError(
              Array[(name.posRange, `Forbidden method name ${name.value}`)],
            )
          };
          optField
        }
      }),
    );
    (algebraicBranchField, tFields)
  }
}

module end;
