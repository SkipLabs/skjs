/***************************************************************************/
/* Statement parsing methods for the TypeScript parser. */
/***************************************************************************/

module SKJS;

extension class Parser {
  /***************************************************************************/
  // Statement parsing
  //
  // <stmt_> ::=
  //   | ;
  //   | <expr>
  //   | return <expr>?
  //   | throw <expr>
  //   | if ( <expr> ) <stmt>* (else <stmt>*)?
  //   | for ( <stmt> in <expr> ) <stmt>*
  //   | for ( <stmt> of <expr> ) <stmt>*
  //   | for ( <stmt> ; <expr> ; <expr> ) <stmt>*
  //   | while ( <expr> ) <stmt>*
  //   | let <binding>*
  //   | var <binding>*
  //   | const <binding>*
  //   | switch ( <expr> ) { <switch-branch>* }
  //   | try { <stmt>* } (catch ( <pattern> (: <type>)? ) { <stmt>* })? (finally { <stmt>* })?
  //   | { <stmt>* }
  /***************************************************************************/

  // Parse either a block or a single statement
  mutable fun blockOrStmt(): Array<Stmt> {
    this.lex.peekKind() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedBlock())
    | Some(TKOpenCurly()) ->
      _ = this.lex.next();
      this.block()
    | Some(_) ->
      st = this.stmt();
      if (this.lex.peekKind() is Some(TKSemi())) {
        _ = this.lex.next()
      };
      Array[st]
    }
  }

  // Parse a block, after a {
  mutable fun block(): Array<Stmt> {
    stmts = mutable Vector[];
    loop {
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        return stmts.toArray()
      };
      stmts.push(this.stmt());
      if (this.lex.peekKind() is Some(TKSemi())) {
        _ = this.lex.next()
      }
    }
  }

  // Parse a single statement, does not consume the semi-colon
  mutable fun stmt(): Stmt {
    (pos, stmt) = this.withPos(this.stmt_, UnterminatedStmt());
    Stmt(pos, stmt)
  }

  // Internal statement parsing implementation
  mutable fun stmt_(): Stmt_ {
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
    | Some(x) -> x
    };
    tok.kind match {
    | TKSemi() -> StmtEmpty()
    | TKOpenCurly() -> Block(this.blockOrStmt())
    | TKVar() ->
      keyword = this.getVar(tok);
      keyword match {
      | "break" ->
        _ = this.lex.next();
        Break()
      | "continue" ->
        _ = this.lex.next();
        Continue()
      | "switch" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        e = this.expr(0);
        this.expect(TKCloseParen());
        this.expect(TKOpenCurly());
        cases = mutable Vector<SwitchBranch>[];
        loop {
          caseTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
          | Some(x) -> x
          };
          caseTokPos = this.lex.posRange(caseTok);
          case = this.lex.getTokenRawStringContent(caseTok) match {
          | "case" -> Case(this.expr(0))
          | "default" -> Default()
          | "}" -> break void
          | _ -> this.error(this.lex.posStart(caseTok), UnexpectedToken())
          };
          this.expect(TKColon());
          stmts = mutable Vector[];
          loop {
            this.lex.peekRawStr() match {
            | Some("case")
            | Some("default")
            | Some("}") ->
              break void
            | _ -> void
            };
            stmts.push(this.stmt());
            if (this.lex.peekKind() is Some(TKSemi())) {
              _ = this.lex.next()
            }
          };
          cases.push(SwitchBranch(case, stmts.toArray(), caseTokPos))
        };
        Switch(e, cases.toArray())
      | "if" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        e = this.expr(0);
        this.expect(TKCloseParen());
        ifBlock = this.blockOrStmt();
        elseBlock = if (this.lex.isEq("else")) {
          _ = this.lex.next();
          Some(this.blockOrStmt())
        } else {
          None()
        };
        If(e, ifBlock, elseBlock)
      | "return" ->
        retPos = this.lex.posRange(this.lex.next().fromSome());
        exprOpt = if (
          this.lex.peekKind() is Some(TKSemi()) ||
          this.lex.peekKind() is Some(TKCloseCurly())
        ) {
          None()
        } else {
          Some(this.expr(0))
        };
        Return(retPos, exprOpt)
      | "throw" ->
        _ = this.lex.next();
        Throw(this.expr(0))
      | "while" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        cond = this.expr(0);
        this.expect(TKCloseParen());
        While(cond, this.blockOrStmt())
      | "for" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        st = this.stmt();
        isIn = this.lex.isEq("in");
        if (isIn || this.lex.isEq("of")) {
          forInOfKind = if (isIn) ForIn() else ForOf();
          _ = this.lex.next();
          e = this.expr(0);
          this.expect(TKCloseParen());
          block = this.blockOrStmt();
          ForInOf(forInOfKind, st, e, block)
        } else {
          this.expect(TKSemi());
          cond = this.expr(0);
          this.expect(TKSemi());
          incr = this.expr(0);
          this.expect(TKCloseParen());
          block = this.blockOrStmt();
          For(st, cond, incr, block)
        }
      | bk @ "let"
      | bk @ "const"
      | bk @ "var" ->
        _ = this.lex.next();
        bkind = bk match {
        | "let" -> BKLet()
        | "const" -> BKConst()
        | "var" -> BKVar()
        | _ -> internal_error("Internal error")
        };
        bindings = mutable Vector[];
        loop {
          pat = this.pattern();
          type = if (this.lex.peekKind() is Some(TKColon())) {
            _ = this.lex.next();
            Some(this.type(0));
          } else {
            None()
          };
          e = if (this.lex.peekKind() is Some(TKAssignment())) {
            this.expect(TKAssignment());
            value = this.expr(0);
            Some(value)
          } else {
            None()
          };
          bindings.push(Binding(pat, type, e));
          if (this.lex.peekKind() is Some(TKComma())) {
            _ = this.lex.next();
          } else {
            break void
          }
        };
        Bind(bkind, bindings.toArray())
      | "try" ->
        _ = this.lex.next();
        this.expect(TKOpenCurly());
        tryStmts = this.block();

        catchClause = if (this.lex.isEq("catch")) {
          _ = this.lex.next();
          (param, type) = if (this.lex.peekKind() is Some(TKOpenParen())) {
            this.expect(TKOpenParen());
            param = if (this.lex.peekKind() is Some(TKCloseParen())) {
              None()
            } else {
              Some(this.pattern())
            };
            type = if (this.lex.peekKind() is Some(TKColon())) {
              _ = this.lex.next();
              Some(this.type(0))
            } else {
              None()
            };
            this.expect(TKCloseParen());
            (param, type)
          } else {
            (None(), None())
          };
          this.expect(TKOpenCurly());
          catchStmts = this.block();
          Some(CatchClause(param, type, catchStmts))
        } else {
          None()
        };

        finallyClause = if (this.lex.isEq("finally")) {
          _ = this.lex.next();
          this.expect(TKOpenCurly());
          finallyStmts = this.block();
          Some(finallyStmts)
        } else {
          None()
        };

        if (catchClause is None() && finallyClause is None()) {
          this.error(this.lex.posEnd(), ExpectedCatchOrFinally())
        };

        Try(tryStmts, catchClause, finallyClause)

      | _ ->
        e = this.expr(0);
        StmtExpr(e)
      }
    | _ -> StmtExpr(this.expr(0))
    }
  }
}

module end;
