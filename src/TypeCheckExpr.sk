module SKJS;

base class AccessKind uses XXHashable {
  children =
  | AKNormal()
  | AKLValue()
  | AKOptionalChain()
}

extension class TypeChecker {
  fun block(
    tcenv: mutable TCEnv,
    stmts: Array<Stmt>,
    cond: ?(Expr, Bool) = None(),
  ): readonly Scope {
    scopeCopy = tcenv.scope;
    scope = tcenv.mcreateSubScope{isLoop => false};
    tcenv.!scope = scope;
    cond match {
    | None() -> void
    | Some((c, target)) -> this.evalCond(tcenv, c, target)
    };
    for (st in stmts) {
      this.stmt(tcenv, st)
    };
    tcenv.!scope = scopeCopy;
    scope
  }

  fun bind(
    tcenv: mutable TCEnv,
    kind: BindKind,
    pat: Pattern,
    type: TType,
    isInitialized: Bool,
    isLocalObject: Bool,
  ): void {
    pos = pat.pos;
    pat.value match {
    | PVar(local) ->
      if (
        isLocalObject &&
        !tcenv.scope.isThroughLoop(local) &&
        !tcenv.localObjects.containsKey(local.value)
      ) {
        tcenv.localObjects![local.value] = LOCanGrow(None())
      };
      tcenv.scope.bind(tcenv, local, type, isInitialized)
    | PArray(arrPat, rest) ->
      rest match {
      | Some(restName) ->
        notSupported(restName.pos, "Rest element in array destructuring")
      | None() -> void
      };
      type.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TTuple(tyl, _)) ->
        for (i in Range(0, min(arrPat.size(), tyl.size()))) {
          arrPat[i] match {
          | None() -> /* skipped element */ void
          | Some((_, Some(defaultExpr))) ->
            tcenv.notSupported(
              defaultExpr.pos,
              "Default value in array destructuring",
            )
          | Some((eltPat, None())) ->
            this.bind(tcenv, kind, eltPat, tyl[i], isInitialized, false)
          };
        };
        if (arrPat.size() != tyl.size()) {
          typingError(
            Array[
              (
                pos,
                `Invalid tuple pattern size, it is of size ${arrPat.size()}`,
              ),
              (
                type.pos,
                `It is incompatible with a tuple of size ${tyl.size()}`,
              ),
            ],
          )
        }
      | Some(obj @ TObject _) ->
        eltType = this.getIteratorElementType(tcenv.subst, obj, pos) match {
        | Some(t) -> t
        | None() ->
          typingError(
            Array[
              (pos, "Invalid tuple pattern"),
              (type.pos, `This is not iterable, it is ${type}`),
            ],
          )
        };
        for (i in Range(0, arrPat.size())) {
          arrPat[i] match {
          | None() -> void
          | Some((_, Some(defaultExpr))) ->
            tcenv.notSupported(
              defaultExpr.pos,
              "Default value in array destructuring",
            )
          | Some((eltPat, None())) ->
            optionalEltType = TType::unionUndefined(
              tcenv.subst,
              this,
              eltType,
              eltPat.pos,
            );
            this.bind(
              tcenv,
              kind,
              eltPat,
              optionalEltType,
              isInitialized,
              false,
            )
          }
        }
      | _ ->
        typingError(
          Array[
            (pos, "Invalid tuple pattern"),
            (type.pos, `This is not a tuple, it is ${type}`),
          ],
        )
      }

    | PObject{fields => objectFields, rest} ->
      fieldsToRemoveForRest = rest match {
      | None() -> SortedSet[]
      | Some(_name) ->
        SortedSet::createFromItems(objectFields.map(f -> f.i0.value))
      };
      type.getSTypes(tcenv.subst, this, Covariant()) match {
      | None() ->
        typingError(
          Array[(pos, "Invalid object pattern"), (type.pos, `This is ${type}`)],
        )
      | Some(stypes) ->
        for (stype in stypes) {
          (branches, typeForRest) = stype match {
          | tobj @ TObject(_, _) ->
            (tobj.getBranches(), tobj.removeFields(fieldsToRemoveForRest))
          | _ ->
            typingError(
              Array[
                (pos, "Invalid object pattern"),
                (type.pos, `This is ${type}`),
              ],
            )
          };
          for (field in objectFields) {
            (fieldName, fieldPat, fieldDefault) = field;
            defaultOpt = fieldDefault.map(e ->
              (e.pos, this.expr(tcenv, e, kind is BKConst()))
            );
            defaultIsUseless = fieldDefault.map(e -> e.pos);
            typeForField = TType::bottom(fieldName.pos);
            for (fields in branches) {
              fields.maybeGet(fieldName.value) match {
              | None() ->
                tcenv.error(
                  Array[
                    (fieldName.pos, `The field ${fieldName} is missing`),
                    (type.pos, `Out of ${type}`),
                  ],
                )
              | Some(tfield) ->
                undefined = (pos) ->
                  TType::single(TPrimUnit(TUndefined(), pos));
                union = (t1, t2) -> TType::union(tcenv.subst, this, t1, t2);
                !typeForField = union(
                  typeForField,
                  defaultOpt match {
                  | Some((defaultPos, defaultType)) ->
                    if (
                      tfield.isOptional ||
                      TType::isSub(
                        tcenv.subst.clone(),
                        this,
                        undefined(defaultPos),
                        tfield.get,
                      ) is STOk()
                    ) {
                      !defaultIsUseless = None();
                      union(
                        TType::diff(
                          tcenv.subst,
                          this,
                          tfield.get,
                          undefined(defaultPos),
                        ),
                        defaultType,
                      )
                    } else {
                      tfield.get
                    }
                  | None() ->
                    if (tfield.isOptional) {
                      union(tfield.get, undefined(tfield.pos))
                    } else {
                      tfield.get
                    }
                  },
                )
              }
            };
            defaultIsUseless match {
            | None() -> void
            | Some(defaultPos) ->
              tcenv.error(
                Array[
                  (
                    defaultPos,
                    "Default is useless because field cannot be undefined",
                  ),
                ],
              )
            };
            this.bind(tcenv, kind, fieldPat, typeForField, isInitialized, false)
          };
          rest.each(name ->
            this.bind(
              tcenv,
              kind,
              Pattern(name.pos, PVar(name)),
              TType::single(typeForRest),
              isInitialized,
              false,
            )
          )
        }
      }
    }
  }

  fun bindType(
    pos: PosRange,
    tcenv: mutable TCEnv,
    kind: BindKind,
    type: ?Type,
    value: ?Expr,
  ): (TType, Bool) {
    value match {
    | None() ->
      if (kind is BKConst()) {
        tcenv.error(Array[(pos, "Const must be bound to a value")]);
      };
      type match {
      | None() -> typingError(Array[(pos, "Was expecting a type or a value")])
      | Some(annotAst) ->
        ty = this.normalize(tcenv, annotAst);
        (ty, false)
      }
    | Some(e) ->
      ty = this.expr(tcenv, e, kind is BKConst());
      type match {
      | None() -> (ty, true)
      | Some(annotAst) ->
        annot = this.normalize(tcenv, annotAst);
        this.checkSubType(tcenv, annotAst.pos, "Invalid annotation", ty, annot);
        (annot, true)
      }
    }
  }

  /* Typechecks expression  obj.fieldName
             or expression  obj?.fieldName
       where obj has type objType */
  fun dot(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    fieldName: Name,
    accessKind: AccessKind,
  ): TType {
    idx = Expr(fieldName.pos, EString(fieldName.value));
    this.get(tcenv, pos, objType, idx, accessKind)
  }

  /* Typechecks expression  obj[idx]
             or expression  obj.idx
             or expression  obj?.idx
     where obj has type objType

     Try to keep in synch with TEnv#keyOfType
  */
  fun get(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    idx: Expr,
    accessKind: AccessKind,
  ): TType {
    idxType = this.expr(tcenv, idx, true);
    idxSType = idxType
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(ty @ TPrimValue(TString(), _, _))
    | Some(ty @ TPrimValue(TNum(), _, _))
    | Some(ty @ TPrimValue(TSymbol(), _, _)) ->
      ty
    | _ -> typingError(Array[(idx.pos, "Invalid index type")])
    };
    objType2 = ArrayLitTyping::refineForArrayUse(
      tcenv,
      this,
      objType,
      idxSType,
    );
    stypes = objType2.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> Vector::mcreateFromItems(stypes)
    | _ ->
      typingError(
        Array[
          (pos, `Invalid access for type ${prettyPrintType(false, objType2)}`),
        ],
      )
    };
    result = TType::bottom(pos);
    isOptionalChaining = accessKind is AKOptionalChain _;
    isLValue = accessKind is AKLValue _;
    optionalChainingIsUseless = isOptionalChaining;
    optionalChainingIsAlwaysUndefined = isOptionalChaining;
    while (!stypes.isEmpty()) {
      stype = stypes.pop();

      optionalChainingIsAlwaysUndefinedForThisSType = false;
      stype match {
      | TTuple(tyArr, tuplePos) ->
        n = idxSType match {
        | TPrimValue(TNum(), Some(numbers), _) ->
          numbers.singleElt().flatMap(lit -> lit.val.toIntOption())
        | _ -> None()
        } match {
        | None() ->
          typingError(
            Array[
              (idx.pos, "Invalid index"),
              (tuplePos, "A tuple expects a static index"),
            ],
          )
        | Some(x) -> x
        };
        tyAtN = tyArr.maybeGet(n) match {
        | Some(tyAtN) -> tyAtN
        | None() -> typingError(Array[(pos, "Out of bound index")])
        };
        !result = TType::union(tcenv.subst, this, result, tyAtN)

      | obj @ TObject(_, objectPos) ->
        fields = obj.getFields(tcenv.subst, this);
        if (fields.isEmpty()) {
          !result = TType::top(objectPos)
        } else if (idxSType is TPrimValue(TSymbol(), _, _)) {
          uniqueId = idxSType match {
          | TPrimValue(_, Some(lits), _) -> lits.singleElt().map(lit -> lit.val)
          | _ -> None()
          } match {
          | Some(id) -> id
          | None() -> typingError(Array[(idx.pos, "Expected a unique symbol")])
          };
          fields.maybeGetSymbolType(
            tcenv.subst,
            this,
            uniqueId,
            pos,
            isLValue,
          ) match {
          | Some(ty) -> !result = TType::union(tcenv.subst, this, result, ty)
          | None() ->
            typingError(Array[(pos, "Symbol property not found on object")])
          }
        } else {
          idxSType.literals match {
          | None() -> Some(idxSType)
          | Some(lits) ->
            lits
              .filterLiterals(fieldLit ->
                fields.maybeGetType(
                  tcenv.subst,
                  this,
                  fieldLit.val,
                  fieldLit.pos,
                  isLValue,
                ) match {
                | Some(ty) ->
                  !result = TType::union(tcenv.subst, this, result, ty);
                  false
                | None() -> true
                }
              )
              .map(remainingLits ->
                idxSType with {literals => Some(remainingLits)}
              )
          } match {
          | None() -> void
          | Some(remainingIdxSType) ->
            fields.maybeSingleIndex() match {
            | None() ->
              remainingIdxSType.literals match {
              | None() ->
                typingError(
                  Array[
                    (pos, "Invalid access"),
                    (
                      idx.pos,
                      `Index has non-literal type ${remainingIdxSType.kind}`,
                    ),
                    (objectPos, "But object has no index field"),
                  ],
                )
              | Some(lits) ->
                fields.getTypeTypingError(lits.toStringList(), pos)
              }
            | Some(index) ->
              this.checkSubType(
                tcenv,
                pos,
                "Invalid index key",
                TType::single(remainingIdxSType),
                index.keyType,
              );
              ty = if (isLValue) index.valueTypeSet else {
                TType::unionUndefined(
                  tcenv.subst,
                  this,
                  index.valueTypeGet,
                  pos,
                )
              };
              !result = TType::union(tcenv.subst, this, result, ty)
            }
          }
        }
      | prim @ TPrimValue _ ->
        obj = this.newObject(tcenv, prim.asClassName(), Array[]);
        stypes.push(obj)

      | TPrimUnit(TUndefined(), undefPos)
      | TPrimUnit(
        TNull(),
        undefPos,
      ) if (isOptionalChaining) ->
        !optionalChainingIsUseless = false;
        !optionalChainingIsAlwaysUndefinedForThisSType = true;
        !result = TType::unionUndefined(tcenv.subst, this, result, undefPos)

      | _ ->
        typingError(
          Array[
            (pos, "Type cannot be accessed"),
            (
              idxType.pos,
              "This is a " + prettyPrintType(false, TType::single(stype)),
            ),
          ],
        )
      };
      !optionalChainingIsAlwaysUndefined =
        optionalChainingIsAlwaysUndefined &&
        optionalChainingIsAlwaysUndefinedForThisSType;
    };
    if (optionalChainingIsUseless) {
      tcenv.error(
        Array[
          (pos, "Useless '?.'. Use '.' instead"),
          (objType.pos, `${objType} is never null nor undefined`),
        ],
      )
    };
    if (optionalChainingIsAlwaysUndefined) {
      tcenv.error(
        Array[
          (pos, "Result of optional chaining is always undefined"),
          (objType.pos, `${objType} is always null or undefined`),
        ],
      )
    };
    result
  }

  fun exprWithoutNullish(
    pos: PosRange,
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
  ): (Bool, TType) {
    ty = this.expr(tcenv, e, mostPrecise);
    hasTop = false;
    hasVoid = false;
    hasNullOrUndefined = false;
    hasOthers = false;
    tyWithoutNullish = ty.mapSTypes(
      tcenv.subst,
      this,
      Some(Covariant()),
      stypesOpt ->
        stypesOpt match {
        | None() ->
          !hasTop = true;
          stypesOpt
        | Some(stypes) ->
          Some(
            stypes.filterSTypes(stype -> {
              stype match {
              | TPrimUnit(TNull(), _)
              | TPrimUnit(TUndefined(), _) ->
                !hasNullOrUndefined = true;
                return false
              | TPrimUnit(TVoid(), _) -> !hasVoid = true
              | _ -> !hasOthers = true
              };
              true
            }),
          )
        }
      ,
    );
    isValid = true;
    if (hasVoid) {
      !isValid = false;
      tcenv.error(
        Array[
          (pos, "Invalid operation on type void"),
          (e.pos, `This expression has type ${ty}`),
        ],
      )
    } else if (!hasTop && !hasNullOrUndefined) {
      !isValid = false;
      tcenv.error(
        Array[
          (pos, "This operator is useless"),
          (e.pos, "This expression is never null or undefined"),
        ],
      );
    } else if (!hasTop && !hasOthers) {
      !isValid = false;
      tcenv.error(
        Array[
          (pos, "This operator is useless"),
          (e.pos, "This expression is always null or undefined"),
        ],
      )
    };
    (isValid, tyWithoutNullish)
  }

  fun nonVoidExpr(
    pos: PosRange,
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
  ): TType {
    ty = this.expr(tcenv, e, mostPrecise);
    if (this.nonTopContainsVoid(tcenv, ty)) {
      tcenv.error(
        Array[
          (pos, "Invalid operation on type void"),
          (e.pos, `This expression has type ${ty}`),
        ],
      )
    };
    ty
  }

  private fun showTypes(
    tcenv: mutable TCEnv,
    args: Array<Expr>,
    expand: Bool,
    pos: PosRange,
  ): TType {
    if (!args.isEmpty()) {
      subst = tcenv.subst.clone();
      exprTy = this.expr(tcenv, args[0], true);
      ty = if (expand) {
        // Resolve single tvar to raw binding (without constraint intersection)
        // to avoid e.g. [string, number] & readonly unknown[] -> never.
        exprTy.getSingleVar().flatMap(tvar -> subst.peekRaw(tvar)) match {
        | Some(rawBinding) -> rawBinding.expand(subst, this, Some(Covariant()))
        | None() -> exprTy.expand(subst, this, Some(Covariant()))
        }
      } else {
        exprTy
      };
      actual = prettyPrintType(false, ty);
      print_error(actual);
      if (args.size() >= 2) {
        expectedTy = this.expr(tcenv, args[1], true);
        expectedTy.getConstantString() match {
        | Some(expected) ->
          if (actual != expected.val) {
            tcenv.error(
              Array[
                (
                  args[0].pos,
                  `__SKJS_show: expected ${expected.val}, got ${actual}`,
                ),
              ],
            )
          }
        | None() ->
          tcenv.error(
            Array[
              (
                args[1].pos,
                "__SKJS_show: second argument must be a string literal",
              ),
            ],
          )
        }
      };
      if (args.size() > 2) {
        tcenv.error(
          Array[(args[2].pos, "__SKJS_show: expected at most 2 arguments")],
        )
      }
    };
    TType::single(TPrimUnit(TVoid(), pos))
  }

  /* Typechecks expression e
     If mostPrecise, use the most precise type. */
  fun expr(
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
    isLValue: Bool = false,
  ): TType {
    if (mostPrecise) {
      if (isLValue) {
        tcenv.error(
          Array[
            (
              e.pos,
              "Internal error: expr call with both mostPrecise and isLValue",
            ),
          ],
        )
      };
      this.asConstExpr(tcenv, e) match {
      | Some(ty) -> return TType::single(ty)
      | None() -> void
      }
    };

    pos = e.pos;
    e.value match {
    | Number(_) -> TType::single(TPrimValue::number(pos))
    | BigInt(_) -> TType::single(TPrimValue::bigint(pos))
    | EString(_) -> TType::single(TPrimValue::string(pos))
    | TemplateLiteral(_parts, exprs) ->
      // Type check all embedded expressions - allow primitive types that can be converted to strings
      strType = TType::single(TPrimValue::string(pos));
      for (expr in exprs) {
        ety = this.expr(tcenv, expr, true);
        this.checkStringifiable(tcenv, expr.pos, ety);
      };
      strType

    | Var(Name(_, "true"))
    | Var(Name(_, "false")) ->
      TType::single(TPrimValue::boolean(pos))
    | Var(Name(_, "null")) ->
      this.makeBoundTVar(tcenv, TType::single(TPrimUnit(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      this.makeBoundTVar(tcenv, TType::single(TPrimUnit(TUndefined(), pos)))
    | Var(local) ->
      // Transition local objects to LOUsed state when read/referenced.
      // Once used, the type is frozen - no more fields can be added.
      // This ensures soundness: code that observed the object with N fields
      // won't be invalidated by later additions.
      if (tcenv.localObjects.containsKey(local.value)) {
        tcenv.localObjects![local.value] = LOUsed(local.pos)
      };
      tcenv.scope.maybeGet(local) match {
      | None() ->
        defs = this.defMap.getAll(tcenv, local);
        for (def in defs) {
          def match {
          | fd @ TopLevelFunDef _ ->
            tFuns = this.funDecl(
              tcenv,
              false,
              fd,
              fd.cgNode match {
              | Some(n) -> n
              | None() -> CGNode::create(AnonymousFunDef(fd))
              },
            );
            break TType::single(TObject::createCall(tFuns))
          | c @ Class _ ->
            staticClass = this.newStatic(tcenv, c.name);
            break staticClass
          | FDVar(kind, name, type, value) ->
            if (!(kind is VDKConst _)) {
              tcenv.error(Array[(name.pos, "Non-const not supported")]);
            };
            break type match {
            | None() ->
              value.flatMap(e -> this.asConstExpr(tcenv, e)) match {
              | None() -> this.newTVar(tcenv, pos)
              | Some(ty) -> TType::single(ty)
              }
            | Some(ty) -> this.normalize(tcenv, ty, kind is VDKConst _)
            }
          | _ -> void
          }
        } else {
          typingError(Array[(pos, "Unbound name")])
        }
      | Some(localDef) -> localDef
      }
    | Object(efields) ->
      fields = mutable Map[];
      symbolFields = mutable Map[];
      indexes = mutable Vector[];
      for (efield in efields) {
        (name, ty) = efield match {
        | FDNormal(name, y) ->
          ttype = this.expr(
            tcenv,
            y,
            mostPrecise || name.value == kAlgebraicBranchFieldName,
          );
          (
            name,
            if (y.value is Object _ || ttype.isConcretePrimitive()) {
              this.makeBoundTVarForField(tcenv, ttype)
            } else {
              ttype
            },
          )

        | FDSpread(spreadExpr) ->
          spreadTy = this.expr(tcenv, spreadExpr, mostPrecise);
          spreadTy.getSTypes(tcenv.subst, this, Covariant()) match {
          | None() ->
            tcenv.error(
              Array[
                (spreadExpr.pos, "Invalid spread"),
                (spreadTy.pos, "This has type unknown"),
              ],
            )
          | Some(spreadSTypes) ->
            for (spreadSType in spreadSTypes) {
              spreadSType match {
              | obj @ TObject(_, _pos) ->
                spreadTFields = obj.getFields(tcenv.subst, this);
                for (spreadField in spreadTFields.fields) {
                  fields![spreadField.name] = spreadField
                };
                for (spreadSymbolField in spreadTFields.symbolFields) {
                  symbolFields![spreadSymbolField.name] = spreadSymbolField
                };
                for (spreadIndex in spreadTFields.indexes) {
                  indexes.push(spreadIndex)
                };
                spreadTFields.call.each(_ ->
                  tcenv.notSupported(
                    spreadExpr.pos,
                    "call signature in spread object",
                  )
                );
                spreadTFields.new.each(_ ->
                  tcenv.notSupported(
                    spreadExpr.pos,
                    "constructor signature in spread object",
                  )
                )
              | _ ->
                tcenv.error(
                  Array[
                    (spreadExpr.pos, "Invalid spread"),
                    (spreadTy.pos, `This has type ${spreadTy}`),
                  ],
                )
              }
            }
          };
          continue
        | FDComputed(keyExpr, valueExpr) ->
          keyType = this.expr(tcenv, keyExpr, true);
          valueTy = this.expr(tcenv, valueExpr, mostPrecise);
          keyType
            .getSTypes(tcenv.subst, this, Covariant())
            .flatMap(stypes -> stypes.singleElt())
            .flatMap(stype -> FieldKey::ofSType(keyExpr.pos, stype)) match {
          | Some(FKName(name, _)) -> (name, valueTy)
          | Some(FKSymbol(_, uniqueId)) ->
            field = TField::create{
              pos => keyExpr.pos,
              name => uniqueId,
              isOptional => false,
              isReadonly => None(),
              type => valueTy,
            };
            symbolFields![field.name] = field;
            continue
          | None() ->
            tcenv.error(
              Array[
                (
                  keyExpr.pos,
                  "Computed property key must be a literal or unique symbol",
                ),
              ],
            );
            continue
          }
        | fd @ FDMethod{name => FNNormal(name)} ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          tFuns = this.funDecl(tcenv, false, fd, cgNode);
          (name, TType::single(TObject::createCall(tFuns)))
        };
        field = TField::create{
          pos => name.pos,
          name => name.value,
          isOptional => false,
          isReadonly => None(),
          type => ty,
        };
        fields![field.name] = field
      };
      obj = TType::single(
        TObject::createSingleBranch(
          TFields::create{fields, symbolFields, indexes},
          pos,
        ),
      );
      for (efield in efields) {
        efield match {
        | fd @ FDMethod _ ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          this.funDef(tcenv.subst, Some((CKClass(), obj)), fd, cgNode)
        | _ -> void
        }
      };
      obj
    | Call(Expr(_, Var(Name(superPos, "super"))), targs, args) ->
      this.super match {
      | None() -> tcenv.error(Array[(superPos, "'super' is not defined")])
      | Some((superCstr, super)) ->
        if (targs.size() != 0) {
          tcenv.error(
            Array[(pos, "super cannot be called with type arguments")],
          );
        };
        this.callConstructor(tcenv, pos, superCstr, args);
        thisName = Name(pos, "this");
        thisType = TType::inter(
          tcenv.subst,
          this,
          tcenv.scope.get(thisName),
          super,
        );
        tcenv.scope.set(thisName, thisType, (x, y) -> {
          this.checkSubType(tcenv, pos, "Invalid super call", x, y)
        })
      };
      TType::single(TPrimUnit(TVoid(), pos))

    | Call(Expr(_, Var(Name(_, "__SKJS_show"))), _, args) ->
      this.showTypes(tcenv, args, false, pos)
    | Call(Expr(_, Var(Name(_, "__SKJS_show_expanded"))), _, args) ->
      this.showTypes(tcenv, args, true, pos)
    | Call(f, targs, args) ->
      fty = this.expr(tcenv, f, mostPrecise);
      tfuns = fty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(obj @ TObject _) ->
        obj.maybeGetCall(tcenv.subst, this) match {
        | Some((optional, tfuns)) ->
          if (optional) {
            tcenv.error(
              Array[
                (pos, "Invalid call"),
                (fty.pos, `Type ${fty} may not be a function`),
              ],
            )
          };
          tfuns
        | None() ->
          typingError(
            Array[
              (pos, "Invalid call"),
              (fty.pos, `Type ${fty} is not a function`),
            ],
          )
        }
      | _ ->
        typingError(
          Array[
            (pos, "Invalid call"),
            (fty.pos, `Type ${fty} is not a function`),
          ],
        )
      };
      rty = this.call(
        tcenv,
        pos,
        tfuns,
        targs.map(ty -> this.normalize(tcenv, ty)),
        args,
        mostPrecise,
      );
      f.value match {
      | Dot(
        NormalDot(),
        Expr(_, Var(Name(_, "console"))),
        Name(_, "assert"),
      ) if (args.size() >= 1) ->
        this.evalCond(tcenv, args[0], true)
      | _ -> void
      };
      rty
    | New(subExpr, targsAst, args) ->
      tArgs = targsAst.map(targ -> this.normalize(tcenv, targ));
      subExpr.value match {
      | Var(className) if (tcenv.scope.maybeGet(className) is None()) ->
        if (targsAst.size() == 0) {
          !tArgs = this.makeTArgs(tcenv, className)
        };
        cstr = this.newConstructor(tcenv, className, tArgs);
        this.callConstructor(tcenv, pos, cstr, args);
        this.new(tcenv, className, tArgs)
      | _ ->
        subExprTy = this.expr(tcenv, subExpr, mostPrecise);
        subExprTy.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ->
          stypes.singleElt()
        ) match {
        | Some(obj @ TObject _) ->
          obj.maybeGetNew(tcenv.subst, this) match {
          | Some((optional, f)) ->
            if (optional) {
              tcenv.error(
                Array[
                  (pos, "Invalid new"),
                  (obj.pos, `${subExprTy} may not have a constructor`),
                ],
              )
            };
            this.call(tcenv, pos, f, tArgs, args, mostPrecise)
          | None() ->
            typingError(
              Array[
                (pos, "Invalid new"),
                (obj.pos, `${subExprTy} has no constructor`),
              ],
            )
          }
        | _ ->
          typingError(
            Array[
              (pos, "Invalid new"),
              (subExprTy.pos, `${subExprTy} is not an object`),
            ],
          )
        }
      }

    | Get(arr, idx) ->
      objOrArray = this.expr(tcenv, arr, mostPrecise);
      accessKind = if (isLValue) AKLValue() else AKNormal();
      this.get(tcenv, pos, objOrArray, idx, accessKind)

    // We always interpret `[]` as an array, not a tuple.
    // Because an empty tuple is not very meaningful.
    | EArray(arr) if (arr.size() == 0) ->
      tvar = this.newTVar(tcenv, pos);
      TType::inst(Name(pos, "Array"), TArgs(Array[tvar]))

    | EArray(arr) ->
      hasSpread = arr.any(x -> x.value is Spread _);
      if (hasSpread) {
        eltType = TType::bottom(pos);
        for (x in arr) {
          xEltTy = x.value match {
          | Spread(spreadExpr) ->
            spreadTy = this.expr(tcenv, spreadExpr, true);
            this.getValueType(tcenv, x.pos, spreadTy)
          | _ -> this.expr(tcenv, x, mostPrecise)
          };
          !eltType = TType::union(tcenv.subst, this, eltType, xEltTy)
        };
        TType::inst(Name(pos, "Array"), TArgs(Array[eltType]))
      } else {
        ArrayLitTyping::typeFromLiteral(
          tcenv,
          pos,
          arr.map(x -> {
            ty = this.expr(tcenv, x, mostPrecise);
            if (x.value is Object _ || ty.isConcretePrimitive()) {
              this.makeBoundTVar(tcenv, ty)
            } else {
              ty
            }
          }),
        )
      }

    | Unop(uop, subExpr) ->
      ty = this.expr(tcenv, subExpr, true);
      uop match {
      | UOExclamationMark() ->
        bool = TType::single(TPrimValue::boolean(pos));
        this.checkSubType(tcenv, pos, "Invalid !", ty, bool);
        bool
      | nuop @ NumericUnaryOperator() ->
        invalid = false;
        res = ty.mapSTypes(tcenv.subst, this, Some(Covariant()), stypesOpt ->
          stypesOpt match {
          | None() ->
            !invalid = true;
            stypesOpt
          | Some(stypes) ->
            Some(
              stypes.mapSTypes(stype ->
                stype match {
                | TPrimValue(k @ TNum(), _, primPos)
                | TPrimValue(k @ TBigInt(), _, primPos) ->
                  TPrimValue(k, None(), primPos)
                | _ ->
                  !invalid = true;
                  stype
                }
              ),
            )
          }
        );
        if (invalid) {
          typingError(
            Array[
              (pos, `Invalid unary operation ${nuop}`),
              (subExpr.pos, `This has type ${ty}`),
            ],
          )
        };
        res
      }

    | Dot(dotKind, e1, fieldName) ->
      accessKind = (isLValue, dotKind) match {
      | (true, OptionalDot()) ->
        tcenv.notSupported(pos, "optional dot in L-value");
        AKLValue()
      | (true, NormalDot()) -> AKLValue()
      | (false, OptionalDot()) -> AKOptionalChain()
      | (false, NormalDot()) -> AKNormal()
      };
      this.dot(
        tcenv,
        e1.pos,
        this.expr(tcenv, e1, mostPrecise),
        fieldName,
        accessKind,
      )

    | Binop(op, e1, e2) ->
      op match {
      | BOAddition() ->
        ty1 = this.expr(tcenv, e1, true);
        ty1.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
          stypes.singleElt()
        ) match {
        | Some(TPrimValue(k @ TNum(), _, primPos))
        | Some(TPrimValue(k @ TString(), _, primPos))
        | Some(TPrimValue(k @ TBigInt(), _, primPos)) ->
          ty2 = this.expr(tcenv, e2, true);
          res = TType::single(TPrimValue::full(k, primPos));
          this.checkSubType(tcenv, e2.pos, "Invalid + operand", ty2, res);
          res
        | _ ->
          typingError(
            Array[
              (pos, "Invalid + operation"),
              (e1.pos, `For an object of type: ${ty1}`),
            ],
          )
        }
      | BOAssignment() -> this.assign(tcenv, pos, e1, e2, mostPrecise)
      | op_ @ BOStrictComparison() ->
        ty1 = this.nonVoidExpr(pos, tcenv, e1, true);
        ty2 = this.nonVoidExpr(pos, tcenv, e2, true);
        // Clone subst: this is a diagnostic check ("always false/true?"),
        // not a type assignment. It should not grow type variables.
        if (ty1.clauses.isEmpty() && ty2.clauses.isEmpty()) {
          clonedSubst = tcenv.subst.clone();
          TType::isSub(clonedSubst, this, ty1, ty2) match {
          | STOk() -> void
          | STError _ ->
            TType::isSub(clonedSubst, this, ty2, ty1) match {
            | STOk() -> void
            | STError _ ->
              alwaysResult = op_ match {
              | BOStrictEquality() -> "false"
              | BOStrictInequality() -> "true"
              };
              tcenv.error(
                Array[(pos, `This equality is always ${alwaysResult}`)],
              )
            }
          }
        };
        TType::single(TPrimValue::boolean(pos))

      | op_ @ LazyLogicalOperator() ->
        (opStr, continuationTarget) = op_ match {
        | BOLogicalAnd() -> ("&&", true)
        | BOLogicalOr() -> ("||", false)
        };
        ty1 = this.expr(tcenv, e1, true);
        this.checkSubType(
          tcenv,
          pos,
          `Invalid ${opStr}`,
          ty1,
          TType::single(TPrimValue::boolean(e1.pos)),
        );
        savedScope = tcenv.scope;
        branch2 = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = branch2;
        this.evalCond(tcenv, e1, continuationTarget);
        ty2 = this.expr(tcenv, e2, true);
        this.checkSubType(
          tcenv,
          pos,
          `Invalid ${opStr}`,
          ty2,
          TType::single(TPrimValue::boolean(e2.pos)),
        );
        tcenv.!scope = savedScope;
        tcenv.popScope(this, branch2);
        TType::single(TPrimValue::boolean(pos))

      | BOLessThan()
      | BOLessThanOrEqual()
      | BOGreaterThan()
      | BOGreaterThanOrEqual() ->
        getExprPrimKind = (e) -> {
          ty = this.expr(tcenv, e, true);
          ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
            stypes.singleElt()
          ) match {
          | Some(TPrimValue(k, _, _)) -> Some(k)
          | _ ->
            tcenv.error(
              Array[
                (
                  pos,
                  "Invalid comparison. You can only compare strings, numbers, bigints, and booleans.",
                ),
                (e1.pos, `This is a ${ty}`),
              ],
            );
            None()
          }
        };
        kind1 = getExprPrimKind(e1);
        kind2 = getExprPrimKind(e2);
        (kind1, kind2) match {
        | (Some(k1), Some(k2)) if (k1 != k2) ->
          tcenv.error(
            Array[
              (
                pos,
                "Invalid comparison. Both operands must have the same type.",
              ),
              (e1.pos, `This is a ${k1}`),
              (e2.pos, `This is a ${k2}`),
            ],
          )
        | _ -> void
        };
        TType::single(TPrimValue::boolean(pos))

      | BOOpAssignment(assOp) ->
        this.expr(
          tcenv,
          Expr(pos, Binop(BOAssignment(), e1, Expr(pos, Binop(assOp, e1, e2)))),
          mostPrecise,
        )

      | BOExponentiation()
      | BOMultiplication()
      | BODivision()
      | BORemainder()
      | BOSubtraction()
      | BOBitwiseAnd()
      | BOBitwiseOr()
      | BOBitwiseXor()
      | BOLeftShift()
      | BOSignedRightShift()
      | BOZeroFilledRightShift() ->
        ty1 = this.expr(tcenv, e1, true);
        kind1 = this.checkIsNumeric(tcenv, e1.pos, "Invalid operation", ty1);
        ty2 = this.expr(tcenv, e2, true);
        kind2 = this.checkIsNumeric(tcenv, e2.pos, "Invalid operation", ty2);
        if (kind1 != kind2) {
          typingError(
            Array[
              (
                pos,
                "Arithmetic operations require both operands to be the same numeric type",
              ),
              (e1.pos, `Left operand is ${kind1}`),
              (e2.pos, `Right operand is ${kind2}`),
            ],
          )
        };
        TType::single(TPrimValue::full(kind1, pos))

      | BONullishCoalescing() ->
        (_isValid, ty1WithoutNullish) = this.exprWithoutNullish(
          pos,
          tcenv,
          e1,
          mostPrecise,
        );
        ty2 = this.expr(tcenv, e2, mostPrecise);
        TType::union(tcenv.subst, this, ty1WithoutNullish, ty2)
      }

    | InstanceOf(e1, Expr(_, Var(className))) ->
      _ = this.expr(tcenv, e1, true);
      _ = this.getClass(tcenv, className);
      TType::single(TPrimValue::boolean(pos))
    | InstanceOf(_, e2) -> typingError(Array[(e2.pos, "Unexpected instanceof")])
    | In(e1, e2) ->
      (t1, fieldsOpt, symFieldsOpt) = this.getInLhsTypeAndFields(
        tcenv,
        pos,
        e1,
      );
      t2 = this.expr(tcenv, e2, true);
      t2.getSTypes(tcenv.subst, this, Covariant()) match {
      | None() ->
        tcenv.error(
          Array[(pos, "Invalid in"), (e2.pos, "This has type unknown")],
        )
      | Some(stypes2) ->
        canBeTrue = false;
        canBeFalse = false;
        for (stype2 in stypes2) {
          stype2 match {
          | TPrimUnit _
          | TPrimValue _ ->
            tcenv.error(
              Array[(pos, "Invalid in"), (e2.pos, `This has type ${t2}`)],
            );
            !canBeTrue = true;
            !canBeFalse = true
          | obj @ TObject(_, _pos) ->
            objFields = obj.getFields(tcenv.subst, this);
            (fields, symbolFields, indexes) = objFields match {
            | TFields{fields, symbolFields, indexes} ->
              (fields, symbolFields, indexes)
            };
            !canBeTrue = true; // object types are open
            !canBeFalse =
              canBeFalse ||
              !indexes.isEmpty() /* TODO: refine */ ||
              fieldsOpt match {
              | None() ->
                false // no field keys to check
              | Some(None()) ->
                true // broad type, could be any key
              | Some(Some(fieldsToCheck)) ->
                fieldsToCheck.values().any(fieldToCheck ->
                  fields.maybeGet(FieldNameString(fieldToCheck.val)) match {
                  | Some(tField) -> tField.isOptional
                  | None() -> true
                  }
                )
              } ||
              symFieldsOpt match {
              | None() ->
                false // no symbol keys to check
              | Some(None()) ->
                true // broad symbol, could be any key
              | Some(Some(symFieldsToCheck)) ->
                symFieldsToCheck.values().any(symToCheck ->
                  symbolFields.maybeGet(FieldNameString(symToCheck.val)) match {
                  | Some(tField) -> tField.isOptional
                  | None() -> true
                  }
                )
              }
          | TTuple _
          | TPromise _ ->
            tcenv.error(Array[(pos, "TODO: in"), (e2.pos, `For type ${t2}`)]);
            !canBeTrue = true;
            !canBeFalse = true
          }
        };
        (canBeTrue, canBeFalse) match {
        | (true, true) -> void
        | (false, false) ->
          tcenv.error(
            Array[
              (pos, "Unexpected in"),
              (e1.pos, `This has type ${t1}`),
              (e2.pos, `This has type ${t2}`),
            ],
          )
        | _ ->
          tcenv.error(Array[(pos, `This expression is always ${canBeTrue}`)])
        }
      };
      TType::single(TPrimValue::boolean(pos))
    | TypeOf(subExpr) ->
      _ = this.nonVoidExpr(pos, tcenv, subExpr, true);
      TType::single(TPrimValue::string(pos))

    | PostOp(pop, subExpr) ->
      pop match {
      | PODecr()
      | POIncr() ->
        num = TType::single(TPrimValue::number(pos));
        ty = this.expr(tcenv, subExpr, true);
        this.checkSubType(tcenv, pos, "Expected integer", ty, num);
        num
      | POExcl() ->
        (isValid, tyWithoutNullish) = this.exprWithoutNullish(
          pos,
          tcenv,
          subExpr,
          mostPrecise,
        );
        if (isValid) {
          tcenv.error(
            Array[
              (pos, "Do not use the postfix ! operator"),
              (
                subExpr.pos,
                "This assertion is unsound and may cause runtime errors",
              ),
            ],
          )
        };
        tyWithoutNullish
      }

    | c @ Closure(params, retTypeAstOpt, body) ->
      this.anonFunction(tcenv, None(), pos, c, params, retTypeAstOpt, body)
    | Async(Expr(closurePos, c @ Closure(params, retTypeAstOpt, body))) ->
      this.anonFunction(
        tcenv,
        Some(pos),
        closurePos,
        c,
        params,
        retTypeAstOpt,
        body,
      )
    | As _ -> notSupported(pos, "operator as")
    | Async _ -> typingError(Array[(pos, "Invalid async")])
    | Await(ae) ->
      aeType = this.expr(tcenv, ae, mostPrecise);
      aeType.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TPromise(ty, _)) -> ty
      | _ ->
        typingError(
          Array[(pos, "Invalid await"), (aeType.pos, "This is not a promise")],
        )
      }
    | EIf(e1, e2, e3) ->
      cond = this.expr(tcenv, e1, true);
      this.checkSubType(
        tcenv,
        e1.pos,
        "Invalid ? condition",
        cond,
        TType::single(TPrimValue::boolean(e1.pos)),
      );

      // Create scopes for the true and false branches with type refinements
      scopeCopy = tcenv.scope;

      // True branch - evaluate e2 with refinements from e1 being true
      trueScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = trueScope;
      this.evalCond(tcenv, e1, true);
      left = this.expr(tcenv, e2, mostPrecise);
      tcenv.!scope = scopeCopy;

      // False branch - evaluate e3 with refinements from e1 being false
      falseScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = falseScope;
      this.evalCond(tcenv, e1, false);
      right = this.expr(tcenv, e3, mostPrecise);
      tcenv.!scope = scopeCopy;

      TType::union(tcenv.subst, this, left, right)
    | AsConst(subExpr) ->
      this.asConstExpr(tcenv, subExpr) match {
      | Some(ty) -> TType::single(ty)
      | None() ->
        tcenv.error(
          Array[(pos, "'as const' can only be used with some literals")],
        );
        this.expr(tcenv, subExpr, true)
      }
    | Params _ -> paramsError(pos)
    | Regexp _ -> typingError(Array[(pos, "TODO: regexp")])
    | Spread _ -> typingError(Array[(pos, "TODO: ...")])
    }
  }

  /* Typechecks expression e as const */
  fun asConstExpr(tcenvb: mutable TCEnvBase, e: Expr): ?SType {
    pos = e.pos;
    e.value match {
    | AsConst(subExpr) ->
      tcenvb.error(Array[(subExpr.pos, "Unnecessary 'as const'")]);
      this.asConstExpr(tcenvb, subExpr)
    | Var(Name(_, "null")) -> Some(TPrimUnit(TNull(), pos))
    | Var(Name(_, "undefined")) -> Some(TPrimUnit(TUndefined(), pos))
    | Number(n) -> Some(TPrimValue::single(TNum(), n, pos))
    | BigInt(n) -> Some(TPrimValue::single(TBigInt(), n, pos))
    | Var(Name(_, "true")) -> Some(TPrimValue::single(TBool(), "true", pos))
    | Var(Name(_, "false")) -> Some(TPrimValue::single(TBool(), "false", pos))
    | EString(n) -> Some(TPrimValue::single(TString(), n, pos))
    | Unop(UOExclamationMark(), subE) ->
      this.asConstExpr(tcenvb, subE).map(stype ->
        stype match {
        | TPrimValue(TBool(), lits, _) ->
          lits.flatMap(v -> v.singleElt()) match {
          | Some(lit) ->
            tcenvb.error(
              Array[
                (pos, "Constant expression could have been simplified"),
                (subE.pos, `This has type ${lit.val}`),
              ],
            );
            res = lit.val match {
            | "true" -> "false"
            | "false" -> "true"
            | _ ->
              internal_error(
                `asConstExpr on Unop(UOExclamationMark) encountered a non-true non-false boolean: ${
                  lit.val
                }`,
              )
            };
            TPrimValue::single(TBool(), res, pos)
          | None() ->
            internal_error(
              `asConstExpr returned a non-literal boolean: ${stype}`,
            )
          }
        | _ ->
          typingError(
            Array[
              (pos, "Invalid unary !"),
              (subE.pos, `This has type ${stype}`),
            ],
          )
        }
      )
    | Unop(UOTild(), _) -> /* TODO */ None()
    | Unop(nuop @ ArithmeticUnaryOperator(), subE) ->
      this.asConstExpr(tcenvb, subE).flatMap(stype ->
        stype match {
        | TPrimValue(k @ TNum(), valuesOpt, _)
        | TPrimValue(k @ TBigInt(), valuesOpt, _) ->
          Some(
            nuop match {
            | UOPlus() -> stype
            | UOMinus() ->
              valuesOpt.flatMap(v -> v.singleElt()) match {
              | None() ->
                internal_error(
                  "asConstExpr should return literals with a single value",
                )
              | Some(lit) ->
                num = if (lit.val.startsWith("-")) {
                  lit.val.stripPrefix("-")
                } else {
                  `-${lit.val}`
                };
                TPrimValue::single(k, num, pos)
              }
            },
          )
        | _ -> None()
        }
      )
    | _ -> None()
    }
  }

  fun anonFunction(
    tcenv: mutable TCEnv,
    isAsync: ?PosRange,
    pos: PosRange,
    c: Closure,
    params: Array<(Name, ?Type)>,
    retTypeAstOpt: ?Type,
    body: ClosureBody,
  ): TType {
    paramTypes = params.map(param -> {
      if (param.i0.value == "this") {
        typingError(
          Array[
            (param.i0.pos, "Parameter this forbidden in anonymous functions"),
          ],
        )
      };
      param.i1 match {
      | None() ->
        typingError(Array[(param.i0.pos, "Please add a type annotation")])
      | Some(ty) -> (param.i0, this.normalize(tcenv, ty))
      }
    });
    callingContext = CGNode::create(AnonymousLambda(pos, c));
    // Register a dependency from parent context on this lambda
    tcenv.recordCalls(CGNodes::singleton(callingContext));
    savedScope = tcenv.scope;
    savedCallingContext = tcenv.callingContext;
    tcenv.!scope = tcenv.mcreateSubScope{isLoop => false};
    tcenv.!callingContext = callingContext;

    for (param in paramTypes) {
      tcenv.scope.bind(tcenv, param.i0, param.i1, true)
    };

    retType = (retTypeAstOpt, body) match {
    | (None(), CBExpr(e)) ->
      inferredType = this.expr(tcenv, e, true);
      isAsync match {
      | None() -> inferredType
      | Some(asyncPos) -> TType::single(TPromise(inferredType, asyncPos))
      }
    | (Some(annotatedTypeAst), CBExpr(e)) ->
      inferredType = this.expr(tcenv, e, true);
      annotatedType = this.normalize(tcenv, annotatedTypeAst);
      this.checkSubType(
        tcenv,
        e.pos,
        "Invalid callback return",
        isAsync match {
        | None() -> inferredType
        | Some(asyncPos) -> TType::single(TPromise(inferredType, asyncPos))
        },
        annotatedType,
      );
      annotatedType
    | (None(), CBBlock(bl)) ->
      if (isAsync is Some _) !this.isAsync = true;
      tvar = isAsync match {
      | None() -> this.newTVar(tcenv, pos)
      | Some(asyncPos) ->
        TType::single(TPromise(this.newTVar(tcenv, pos), asyncPos))
      };
      !this.retType = Some(tvar);
      _ = this.block(tcenv, bl);
      tvar
    | (Some(annotatedTypeAst), CBBlock(bl)) ->
      if (isAsync is Some _) !this.isAsync = true;
      annotatedType = this.normalize(tcenv, annotatedTypeAst);
      !this.retType = Some(annotatedType);
      _ = this.block(tcenv, bl);
      annotatedType
    };

    tcenv.!scope = savedScope;
    tcenv.!callingContext = savedCallingContext;

    TType::single(
      TObject::createCall(
        TFuns::singleFun(
          TFun(
            Array[],
            None(),
            paramTypes.map(x -> x.i1),
            Array[],
            None(),
            retType,
            CGNodes::singleton(callingContext),
          ),
          pos,
        ),
      ),
    )
  }

  fun callConstructor(
    tcenv: mutable TCEnv,
    pos: PosRange,
    cstrType: CstrType,
    args: Array<Expr>,
  ): void {
    cstrType.cstr match {
    | None() ->
      if (args.size() == 0) return void;
      tcenv.error(Array[(pos, "Invalid new: constructor expects no arguments")])
    | Some(cstr) -> _ = this.call(tcenv, pos, cstr, cstrType.tArgs, args, true)
    }
  }

  fun assign(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1: Expr,
    e2: Expr,
    mostPrecise: Bool,
  ): TType {
    this.checkLValue(tcenv, e1);
    e1.value match {
    | Var(n) ->
      ty2 = this.expr(tcenv, e2, mostPrecise);
      tcenv.scope.set(n, ty2, (x, y) ->
        this.checkSubType(tcenv, pos, "Invalid assignment", x, y)
      );
      ty2
    | Dot(
      NormalDot(),
      Expr(_, Var(local)),
      fieldName,
    ) if (tcenv.localObjects.containsKey(local.value)) ->
      keyExpr = Expr(fieldName.pos, EString(fieldName.value));
      this.assignLocalObject(
        tcenv,
        pos,
        e1.pos,
        local,
        keyExpr,
        e2,
        mostPrecise,
      )
    | Get(
      Expr(_, Var(local)),
      keyExpr,
    ) if (tcenv.localObjects.containsKey(local.value)) ->
      this.assignLocalObject(
        tcenv,
        pos,
        e1.pos,
        local,
        keyExpr,
        e2,
        mostPrecise,
      )
    | _ ->
      ty1 = this.expr(tcenv, e1, false, true);
      ty2 = this.expr(tcenv, e2, mostPrecise);
      this.checkSubType(tcenv, e2.pos, "Invalid assignment", ty2, ty1);
      ty1
    }
  }

  /*
   * Adds a field to a local object via assignment: obj.field = value or obj[key] = value
   *
   * This implements the "growth" mechanism for local objects. When we see:
   *   let obj = {};
   *   obj.field = value;
   *
   * We:
   * 1. Resolve the key expression to a FieldKey (string/number/symbol literal)
   * 2. Check against bound type if present
   * 3. Look up existing field or check index signatures
   * 4. If no match, grow the object by adding the new field
   *
   * Errors if:
   * - Object has been used (LOUsed state)
   * - Adding field inside a loop
   * - Field is the discriminant kind field
   */
  private fun assignLocalObject(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1Pos: PosRange,
    local: Name,
    keyExpr: Expr,
    e2: Expr,
    mostPrecise: Bool,
  ): TType {
    fieldType = this.expr(tcenv, e2, mostPrecise);
    keyType = this.expr(tcenv, keyExpr, true);
    keyType.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ->
      stypes.singleElt()
    ) match {
    | Some(stype) ->
      fieldKeys = FieldKey::allOfSType(keyExpr.pos, stype);
      if (fieldKeys.isEmpty()) {
        this.assignLocalObjectByIndex(
          tcenv,
          pos,
          local,
          keyExpr,
          keyType,
          fieldType,
        )
      } else {
        this.assignLocalObjectByKeys(
          tcenv,
          pos,
          e1Pos,
          local,
          keyExpr,
          fieldType,
          fieldKeys,
        )
      }
    | _ ->
      this.assignLocalObjectByIndex(
        tcenv,
        pos,
        local,
        keyExpr,
        keyType,
        fieldType,
      )
    }
  }

  // Grows a local object by one or more literal keys.
  // When there are multiple keys (e.g. key: "a" | "b"), fields are optional.
  private fun assignLocalObjectByKeys(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1Pos: PosRange,
    local: Name,
    keyExpr: Expr,
    fieldType: TType,
    fieldKeys: Array<FieldKey>,
  ): TType {
    isOptional = fieldKeys.size() > 1;
    used = tcenv.localObjects[local.value] match {
    | LOCanGrow(bound) ->
      bound match {
      | None() -> void
      | Some(objectType) ->
        /* Not using the setter type here:
           LOCanGrow with a bound is only used for the this type in constructors
           so getters and setters have the same type, except for readonly-fields.
           But in constructors, all fields are writable, hence the usage of the getter type. */
        this.checkSubType(
          tcenv,
          fieldType.pos,
          "Invalid assignment",
          fieldType,
          this.get(tcenv, e1Pos, objectType, keyExpr, AKNormal()),
        )
      };
      None()
    | LOUsed(usedPos) -> Some(usedPos)
    };
    tcenv.scope
      .get(local)
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, objPos)) ->
      fields = obj.getFields(tcenv.subst, this);
      // For each key, check existing fields/index sigs and collect
      // new fields to grow.
      newFieldsMap = mutable Map[];
      newSymbolFieldsMap = mutable Map[];
      needsGrowth = false;
      for (key in fieldKeys) {
        fields.maybeGetField(key) match {
        | Some(fd) ->
          this.checkSubType(
            tcenv,
            fieldType.pos,
            "Invalid assignment",
            fieldType,
            fd.set,
          )
        | None() ->
          matchingIndex = fields.indexes.find(indexField -> {
            clonedSubst = tcenv.subst.clone();
            TType::isSub(
              clonedSubst,
              this,
              key.toType(),
              indexField.keyType,
            ) is STOk _
          });
          matchingIndex match {
          | Some(indexField) ->
            this.checkSubType(
              tcenv,
              fieldType.pos,
              "Invalid assignment",
              fieldType,
              indexField.valueTypeSet,
            )
          | None() ->
            !needsGrowth = true;
            field = TField::create{
              pos => key.pos(),
              name => key.value(),
              isOptional,
              isReadonly => None(),
              type => fieldType,
            };
            key match {
            | FKName _ -> newFieldsMap![field.name] = field
            | FKSymbol _ -> newSymbolFieldsMap![field.name] = field
            }
          }
        }
      };
      if (needsGrowth) {
        used match {
        | None() -> void
        | Some(usedPos) ->
          tcenv.error(
            Array[
              (pos, "You are trying to add a field to this object"),
              (
                usedPos,
                "But this object has been already been used for something else",
              ),
            ],
          )
        };
        if (tcenv.scope.isThroughLoop(local)) {
          tcenv.error(
            Array[(local.pos, "You cannot add a field to an object in a loop")],
          )
        };
        allNewFields = TFields::create{
          fields => newFieldsMap,
          symbolFields => newSymbolFieldsMap,
        };
        newTy = TFields::inter(tcenv.subst, this, fields, allNewFields) match {
        | None() -> TType::bottom(objPos)
        | Some(mergedFields) ->
          TType::single(TObject::createSingleBranch(mergedFields, objPos))
        };
        tcenv.scope.set(local, newTy, (x, y) -> {
          this.checkSubType(tcenv, fieldType.pos, "Invalid assignment", x, y)
        })
      }
    | _ ->
      tcenv.error(Array[(pos, "Internal error: local object is not an object")])
    };
    fieldType
  }

  // Validates a computed-key assignment on a local object when the key
  // can't be resolved to a single literal. Checks index signatures.
  private fun assignLocalObjectByIndex(
    tcenv: mutable TCEnv,
    pos: PosRange,
    local: Name,
    keyExpr: Expr,
    keyType: TType,
    fieldType: TType,
  ): TType {
    tcenv.scope
      .get(local)
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _)) ->
      fields = obj.getFields(tcenv.subst, this);
      matchingIndex = fields.indexes.find(indexField -> {
        clonedSubst = tcenv.subst.clone();
        TType::isSub(clonedSubst, this, keyType, indexField.keyType) is STOk _
      });
      matchingIndex match {
      | Some(indexField) ->
        this.checkSubType(
          tcenv,
          fieldType.pos,
          "Invalid assignment",
          fieldType,
          indexField.valueTypeSet,
        )
      | None() ->
        tcenv.error(
          Array[
            (
              keyExpr.pos,
              "Computed property key must match an index signature on this object",
            ),
          ],
        )
      }
    | _ ->
      tcenv.error(Array[(pos, "Internal error: local object is not an object")])
    };
    fieldType
  }

  fun getInLhsTypeAndFields(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1: Expr,
  ): (TType, ??PrimLiterals, ??PrimLiterals) {
    t1 = this.expr(tcenv, e1, true);
    t1.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes1) if (!stypes1.isEmpty()) ->
      fieldLitsOpt: ??PrimLiterals = None();
      symLitsOpt: ??PrimLiterals = None();
      for (stype1 in stypes1) {
        stype1 match {
        | TPrimValue(TNum(), lits, _)
        | TPrimValue(TString(), lits, _) ->
          !fieldLitsOpt = fieldLitsOpt match {
          | Some(None()) -> Some(None())
          | None() -> Some(lits)
          | Some(Some(_)) if (lits.isNone()) -> Some(None())
          | Some(Some(existing)) -> Some(lits.map(more -> existing.union(more)))
          }
        | TPrimValue(TSymbol(), symLits, _) ->
          !symLitsOpt = symLitsOpt match {
          | Some(None()) -> Some(None())
          | None() -> Some(symLits)
          | Some(Some(_)) if (symLits.isNone()) -> Some(None())
          | Some(Some(existing)) ->
            Some(symLits.map(more -> existing.union(more)))
          }
        | _ ->
          typingError(
            Array[(pos, "Invalid in"), (e1.pos, `This has type ${t1}`)],
          )
        }
      };
      (t1, fieldLitsOpt, symLitsOpt)
    | _ ->
      typingError(Array[(pos, "Invalid in"), (e1.pos, `This has type ${t1}`)])
    }
  }

  fun call(
    tcenv: mutable TCEnv,
    pos: PosRange,
    tfuns: TFuns,
    targs: Array<TType>,
    argExprs: Array<Expr>,
    mostPrecise: Bool,
  ): TType {
    args = mutable Vector<TType>[];
    moreArgs: ?TType = None();

    for (argExpr in argExprs) {
      argExpr.value match {
      | Spread(spreadExpr) ->
        spreadTy = this.expr(tcenv, spreadExpr, mostPrecise);
        spreadTy.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
          stypes.singleElt()
        ) match {
        | Some(obj @ TObject _) ->
          this.getIteratorElementType(tcenv.subst, obj, argExpr.pos) match {
          | None() ->
            tcenv.error(
              Array[
                (argExpr.pos, "Invalid spread argument"),
                (spreadTy.pos, `It has type ${spreadTy}`),
              ],
            )
          | Some(eltType) ->
            !moreArgs = Some(
              moreArgs match {
              | None() -> eltType
              | Some(ma) -> TType::union(tcenv.subst, this, ma, eltType)
              },
            )
          }
        | Some(TTuple(tupElts, _)) ->
          moreArgs match {
          | None() -> args.extend(tupElts)
          | Some(ma) ->
            for (tupElt in tupElts) {
              !ma = TType::union(tcenv.subst, this, ma, tupElt)
            };
            !moreArgs = Some(ma)
          }
        | _ ->
          tcenv.error(
            Array[
              (argExpr.pos, "Invalid spread argument"),
              (spreadTy.pos, `It has type ${spreadTy}`),
            ],
          )
        }
      | _ ->
        argTy = this.expr(tcenv, argExpr, mostPrecise);
        moreArgs match {
        | None() -> args.push(argTy)
        | Some(ma) ->
          !moreArgs = Some(TType::union(tcenv.subst, this, ma, argTy))
        }
      }
    };

    tfuns match {
    | TFuns(tfun, fPos) ->
      tcenv.recordCalls(tfun.cgNodes);
      if (targs.size() != 0 && targs.size() != tfun.tparams.size()) {
        tcenv.error(
          Array[
            (
              pos,
              `Incompatible number of type arguments: ${targs.size()} passed`,
            ),
            (fPos, `Expected: ${tfun.tparams.size()}`),
          ],
        )
      };
      map = SortedMap[];
      for (i => tparamDecl in tfun.tparams) {
        !map[tparamDecl.id] = if (i < targs.size()) {
          targs[i]
        } else {
          this.newTVar(tcenv, pos)
        };
      };
      !tfun = (mutable Instantiate()).fun_(
        (tcenv.subst, this, map.chill()),
        tfun with {tparams => Array[]},
      );
      totalSize = tfun.params.size() + tfun.optionalParams.size();
      // Unified rest-argument mechanism (Stage A): if spreadParam is an unbound generic
      // type variable, infer/bind it from call-site arguments before param checking.
      callInvalid = VariadicTyping::inferRestTypeVar(
        tcenv,
        this,
        pos,
        tfun.spreadParam,
        totalSize,
        args,
        moreArgs,
      );

      if (callInvalid) {
        // Skip further param checking and return the function's return type
        // to avoid cascading diagnostics from void/return-type mismatches.
        return tfun.retType
      };

      version = tcenv.subst.version;
      loop {
        for (i in Range(0, tfun.params.size())) {
          if (i >= args.size()) {
            tcenv.error(
              Array[
                (pos, "Invalid call"),
                (fPos, `This function has ${tfun.params.size()} parameters`),
              ],
            );
            break void
          } else {
            this.checkSubType(
              tcenv,
              pos,
              "Invalid call",
              args[i],
              tfun.params[i],
            )
          }
        };
        for (j in Range(0, tfun.optionalParams.size())) {
          i = tfun.params.size() + j;
          arg = if (i < args.size()) {
            args[i]
          } else {
            moreArgs match {
            | None() -> break void
            | Some(ma) -> ma
            }
          };
          this.checkSubType(
            tcenv,
            pos,
            "Invalid call",
            arg,
            tfun.optionalParams[j],
          )
        };
        if (tcenv.subst.version == version) break void;
        !version = tcenv.subst.version;
      };
      VariadicTyping::checkRestArgs(
        tcenv,
        this,
        pos,
        tfun.spreadParam,
        totalSize,
        args,
        moreArgs,
      );
      tfun.retType
    }
  }
}

module end;
