module SKJS;

extension class TypeChecker {
  fun block(
    tcenv: mutable TCEnv,
    stmts: Array<Stmt>,
    cond: ?(Expr, Bool) = None(),
  ): readonly Scope {
    scopeCopy = tcenv.scope;
    scope = tcenv.mcreateSubScope{isLoop => false};
    tcenv.!scope = scope;
    cond match {
    | None() -> void
    | Some((c, target)) -> this.evalCond(tcenv, c, target)
    };
    for (st in stmts) {
      this.stmt(tcenv, st)
    };
    tcenv.!scope = scopeCopy;
    scope
  }

  fun bind(
    tcenv: mutable TCEnv,
    kind: BindKind,
    pat: Pattern,
    type: TType,
    isInitialized: Bool,
    isLocalObject: Bool,
  ): void {
    pos = pat.pos;
    pat.value match {
    | PVar(local) ->
      if (
        isLocalObject &&
        !tcenv.scope.isThroughLoop(local) &&
        !tcenv.localObjects.containsKey(local.value)
      ) {
        tcenv.localObjects![local.value] = None()
      };
      tcenv.scope.bind(local, type, isInitialized)
    | PArray(arrPat) ->
      type.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TTuple(tyl, _)) ->
        if (arrPat.size() != tyl.size()) {
          typingError(
            Array[
              (
                pos,
                `Invalid tuple pattern size, it is of size ${arrPat.size()}`,
              ),
              (
                type.pos,
                `It is incompatible with a tuple of size ${tyl.size()}`,
              ),
            ],
          )
        };
        for (i in Range(0, arrPat.size())) {
          this.bind(tcenv, kind, arrPat[i], tyl[i], isInitialized, false)
        }
      | _ ->
        typingError(
          Array[
            (pos, "Invalid tuple pattern"),
            (type.pos, `This is not a tuple, it is ${type}`),
          ],
        )
      }

    | PObject(objectFields) ->
      type.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
      | None() ->
        typingError(
          Array[(pos, "Invalid object pattern"), (type.pos, `This is ${type}`)],
        )
      | Some(stypes) ->
        for (stype in stypes) {
          branches = stype match {
          | TObject(fields, _) -> Array[fields]
          | a @ TAlgebraic _ -> a.branches.toArray().map(x -> x.fields)
          | _ ->
            typingError(
              Array[
                (pos, "Invalid object pattern"),
                (type.pos, `This is ${type}`),
              ],
            )
          };
          for (field in objectFields) {
            (fieldName, fieldPat, fieldDefault) = field;
            defaultOpt = fieldDefault.map(e ->
              (e.pos, this.expr(tcenv, e, kind is BKConst()))
            );
            defaultIsUseless = fieldDefault.map(e -> e.pos);
            for (fields in branches) {
              fields.maybeGet(fieldName.value) match {
              | None() ->
                typingError(
                  Array[
                    (fieldName.pos, `The field ${fieldName.value} is missing`),
                    (type.pos, `Out of ${type}`),
                  ],
                )
              | Some(tfield) ->
                tfieldType = tfield.type;
                if (tfield.isOptional) {
                  !tfieldType = tfieldType.unionUndefined(
                    tcenv.subst,
                    this.tenv,
                    tfield.pos,
                  )
                };
                defaultOpt match {
                | None() -> void
                | Some((defaultPos, defaultType)) ->
                  undefined = TType::single(
                    TPrimUnit(TUndefined(), defaultPos),
                  );
                  if (
                    tfield.isOptional ||
                    isSubTType(
                      tcenv.subst.clone(),
                      this.tenv,
                      undefined,
                      tfieldType,
                    ) is STOk()
                  ) {
                    !defaultIsUseless = None();
                    !tfieldType = tfield.type.diff(undefined);
                    !tfieldType = TType::union(
                      tcenv.subst,
                      this.tenv,
                      tfieldType,
                      defaultType,
                    )
                  }
                };
                this.bind(
                  tcenv,
                  kind,
                  fieldPat,
                  tfieldType,
                  isInitialized,
                  false,
                )
              }
            };
            defaultIsUseless match {
            | None() -> void
            | Some(defaultPos) ->
              typingError(
                Array[
                  (
                    defaultPos,
                    "Default is useless because field cannot be undefined",
                  ),
                ],
              )
            }
          }
        }
      }
    }
  }

  fun bindType(
    pos: PosRange,
    tcenv: mutable TCEnv,
    kind: BindKind,
    type: ?Type,
    value: ?Expr,
  ): (TType, Bool) {
    value match {
    | None() ->
      if (kind is BKConst()) {
        typingError(Array[(pos, "Const must be bound to a value")]);
      };
      type match {
      | None() -> typingError(Array[(pos, "Was expecting a type or a value")])
      | Some(annotAst) ->
        ty = this.tenv.normalize(tcenv.context, annotAst);
        (ty, false)
      }
    | Some(e) ->
      ty = this.expr(tcenv, e, kind is BKConst());
      type match {
      | None() -> (ty, true)
      | Some(annotAst) ->
        annot = this.tenv.normalize(tcenv.context, annotAst);
        this.checkSubType(tcenv, annotAst.pos, "Invalid annotation", ty, annot);
        (annot, true)
      }
    }
  }

  /* Typechecks expression  obj.fieldName
             or expression  obj?.fieldName  if optionalChaining is true
       where obj has type objType */
  fun dot(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    fieldName: Name,
    optionalChaining: Bool = false,
  ): TType {
    idx = Expr(fieldName.pos, EString(fieldName.value));
    this.get(tcenv, pos, objType, idx, optionalChaining)
  }

  /* Typechecks expression  obj[idx]
             or expression  obj.idx
             or expression  obj?.idx  if optionalChaining is true
     where obj has type objType

     Try to keep in synch with TEnv#keyOfType
  */
  fun get(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    idx: Expr,
    optionalChaining: Bool = false,
    allowConstructor: Bool = false,
  ): TType {
    stypes = objType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) ->
      Vector::mcreateFromIterator(stypes.values())
    | _ ->
      typingError(
        Array[
          (pos, `Invalid access for type ${prettyPrintType(false, objType)}`),
        ],
      )
    };
    idxType = this.expr(tcenv, idx, true);
    idxSType = idxType
      .getSTypes(tcenv.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(
      TPrimValue(TString(), Some(values), _),
    ) if (values.contains("constructor") && !allowConstructor) ->
      typingError(Array[(idx.pos, "Cannot access field 'constructor'")])
    | Some(ty @ TPrimValue(TString(), _, _))
    | Some(ty @ TPrimValue(TNum(), _, _)) ->
      ty
    | _ -> typingError(Array[(idx.pos, "Invalid index type")])
    };
    result = TType::bottom(pos);
    optionalChainingIsUseless = optionalChaining;
    optionalChainingIsAlwaysUndefined = optionalChaining;
    while (!stypes.isEmpty()) {
      stype = stypes.pop();

      optionalChainingIsAlwaysUndefinedForThisSType = false;
      stype match {
      | TTuple(tyArr, tuplePos) ->
        n = idxSType match {
        | TPrimValue(TNum(), Some(numbers), _) ->
          numbers.singleElt().flatMap(s -> s.i1.toIntOption())
        | _ -> None()
        } match {
        | None() ->
          typingError(
            Array[
              (idx.pos, "Invalid index"),
              (tuplePos, "A tuple expects a static index"),
            ],
          )
        | Some(x) -> x
        };
        !result = TType::union(tcenv.subst, this.tenv, result, tyArr[n])

      | TObject(fields, objectPos) if (fields.isEmpty()) ->
        !result = TType::top(objectPos)

      | TObject(fields, objectPos) ->
        idxSType.values match {
        | None() -> Some(idxSType)
        | Some(values) ->
          values
            .filter(posAndFieldName ->
              fields.maybeGetType(
                tcenv.subst,
                this.tenv,
                Name(posAndFieldName.i0, posAndFieldName.i1),
              ) match {
              | Some(ty) ->
                !result = TType::union(tcenv.subst, this.tenv, result, ty);
                false
              | None() -> true
              }
            )
            .map(remainingValues ->
              idxSType with {values => Some(remainingValues)}
            )
        } match {
        | None() -> void
        | Some(remainingIdxSType) ->
          fields.maybeSingleIndex() match {
          | None() ->
            remainingIdxSType.values match {
            | None() ->
              typingError(
                Array[
                  (pos, "Invalid access"),
                  (
                    idx.pos,
                    `Index has non-literal type ${remainingIdxSType.kind}`,
                  ),
                  (objectPos, "But object has no index field"),
                ],
              )
            | Some(values) ->
              fields.getTypeTypingError(Name(pos, values.toStringList()))
            }
          | Some(index) ->
            this.checkSubType(
              tcenv,
              pos,
              "Invalid index key",
              TType::single(remainingIdxSType),
              index.keyType,
            );
            ty = index.valueType.unionUndefined(tcenv.subst, this.tenv, pos);
            !result = TType::union(tcenv.subst, this.tenv, result, ty)
          }
        }

      | TAlgebraic(branches, _) ->
        idxSType match {
        | TPrimValue(TString(), Some(values), _) ->
          values.singleElt().map(v -> Name(v.i0, v.i1))
        | _ -> None()
        } match {
        | None() ->
          typingError(
            Array[
              (idx.pos, "Invalid index"),
              (pos, "An algebraic expects a static index"),
            ],
          )
        | Some(fieldName) ->
          for (branch in branches) {
            !result = TType::union(
              tcenv.subst,
              this.tenv,
              result,
              branch.getType(tcenv.subst, this.tenv, fieldName),
            )
          }
        }

      | TPrimValue(primKind, _, primPos) ->
        objName = primKind.toString();
        obj = this.tenv.newObject(
          tcenv.context,
          Name(primPos, objName),
          Array[],
        );
        stypes.push(obj)

      | TPrimUnit(TUndefined(), undefPos)
      | TPrimUnit(
        TNull(),
        undefPos,
      ) if (optionalChaining) ->
        !optionalChainingIsUseless = false;
        !optionalChainingIsAlwaysUndefinedForThisSType = true;
        !result = result.unionUndefined(tcenv.subst, this.tenv, undefPos)

      | _ ->
        typingError(
          Array[
            (pos, "Type cannot be accessed"),
            (
              idxType.pos,
              "This is a " + prettyPrintType(false, TType::single(stype)),
            ),
          ],
        )
      };
      !optionalChainingIsAlwaysUndefined =
        optionalChainingIsAlwaysUndefined &&
        optionalChainingIsAlwaysUndefinedForThisSType;
    };
    if (optionalChainingIsUseless) {
      typingError(
        Array[
          (pos, "Useless '?.'. Use '.' instead"),
          (objType.pos, `${objType} is never null nor undefined`),
        ],
      )
    };
    if (optionalChainingIsAlwaysUndefined) {
      typingError(
        Array[
          (pos, "Result of optional chaining is always undefined"),
          (objType.pos, `${objType} is always null or undefined`),
        ],
      )
    };
    result
  }

  fun nonVoidExpr(pos: PosRange, tcenv: mutable TCEnv, e: Expr): TType {
    ty = this.expr(tcenv, e);
    if (this.nonTopContainsVoid(tcenv, ty)) {
      typingError(
        Array[
          (pos, "Invalid operation on type void"),
          (e.pos, `This expression has type ${ty}`),
        ],
      )
    };
    ty
  }

  /* Typechecks expression e
     If mostPrecise, use the most precise type. */
  fun expr(tcenv: mutable TCEnv, e: Expr, mostPrecise: Bool = false): TType {
    if (mostPrecise) {
      this.asConstExpr(e) match {
      | Some(ty) -> return ty
      | None() -> void
      }
    };

    pos = e.pos;
    e.value match {
    | Number(_) -> TType::single(TPrimValue::number(pos))
    | BigInt(_) -> TType::single(TPrimValue::bigint(pos))
    | EString(_) -> TType::single(TPrimValue::string(pos))
    | TemplateLiteral(_parts, exprs) ->
      // Type check all embedded expressions - allow primitive types that can be converted to strings
      strType = TType::single(TPrimValue::string(pos));
      for (expr in exprs) {
        ety = this.expr(tcenv, expr);
        this.checkStringifiable(tcenv, expr.pos, ety);
      };
      strType

    | Var(Name(_, "true"))
    | Var(Name(_, "false")) ->
      TType::single(TPrimValue::boolean(pos))
    | Var(Name(_, "null")) ->
      this.makeBoundTVar(tcenv, TType::single(TPrimUnit(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      this.makeBoundTVar(tcenv, TType::single(TPrimUnit(TUndefined(), pos)))
    | Var(local) ->
      if (tcenv.localObjects.containsKey(local.value)) {
        tcenv.usedObjects![local.value] = local.pos
      };
      tcenv.scope.maybeGet(local) match {
      | None() ->
        defs = if (this.builtins.contains(local.value)) {
          this.defMap.get(tcenv.context, this.builtinsFileName, local)
        } else {
          this.defMap.get(
            tcenv.context,
            FileName::create(local.pos.fileName),
            local,
          )
        };
        for (def in defs) {
          def.value match {
          | fd @ FunDef _ ->
            break this.tenv.funDecl(
              tcenv.context,
              false,
              fd,
              fd.cgNode match {
              | Some(n) -> n
              | None() -> CGNode::create(AnonymousFunDef(fd))
              },
            ).i1
          | c @ Class _ ->
            staticClass = this.tenv.newStatic(tcenv.context, c.name);
            break staticClass
          | VarDefs(kind, varDefArr) ->
            if (varDefArr.size() != 1) {
              internal_error("varDefArr size should be 1")
            };
            varDef = varDefArr[0];
            if (!(kind is VDKConst _)) {
              typingError(
                Array[(varDef.pat.pos, "Construction not supported")],
              );
            };
            if (!(varDef.pat is Pattern(_, PVar _))) {
              typingError(
                Array[(varDef.pat.pos, "Construction not supported")],
              );
            };
            break varDef.type match {
            | None() ->
              varDef.value match {
              | None() -> None()
              | Some(x) -> this.asConstExpr(x)
              } match {
              | None() -> this.newTVar(tcenv, pos)
              | Some(ty) -> ty
              }
            | Some(ty) -> this.tenv.normalize(tcenv.context, ty)
            }
          | _ -> void
          }
        } else {
          typingError(Array[(pos, "Unbound name")])
        }
      | Some(localDef) -> localDef
      }
    | Object(efields) ->
      algebraicBranchField: ?(PosRange, TType) = None();
      fields = mutable Vector[];
      for (efield in efields) {
        (name, ty) = efield match {
        | FDNormal(name, y) ->
          if (name.value == "constructor") {
            typingError(
              Array[(name.pos, `Forbidden field name: ${name.value}`)],
            )
          };
          (name, this.expr(tcenv, y, name.value == kAlgebraicBranchFieldName))

        | FDSpread _ -> internal_error("TODO spread")
        | fd @ FunDef _ ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          this.tenv.funDecl(tcenv.context, true, fd, cgNode)
        };
        TField::create(name.pos, name.value, false, ty) match {
        | None() ->
          algebraicBranchField match {
          | Some((existingPos, _existingType)) ->
            typingError(
              Array[
                (name.pos, `Duplicate field ${name.value}`),
                (existingPos, "Previously declared here"),
              ],
            )
          | None() -> void
          };
          !algebraicBranchField = Some((name.pos, ty))
        | Some(field) -> fields.push(field)
        }
      };
      obj = createObject(
        pos,
        algebraicBranchField,
        TFields::create(fields.toArray(), Array[]),
      );
      for (efield in efields) {
        efield match {
        | fd @ FunDef _ ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          this.funDef(tcenv.subst, Some((CKClass(), obj)), fd, cgNode)
        | _ -> void
        }
      };
      obj
    | Call(Expr(_, Var(Name(superPos, "super"))), targs, args) ->
      this.super match {
      | None() -> typingError(Array[(superPos, "'super' is not defined")])
      | Some((superCstr, super)) ->
        if (targs.size() != 0) {
          typingError(
            Array[(pos, "super cannot be called with type arguments")],
          );
        };
        this.callConstructor(
          tcenv,
          pos,
          superCstr,
          args.map(x -> this.expr(tcenv, x)),
        );
        thisName = Name(pos, "this");
        thisType = TType::inter(
          tcenv.subst,
          this.tenv,
          tcenv.scope.get(thisName),
          super,
        );
        tcenv.scope.set(thisName, thisType, (x, y) -> {
          this.checkSubType(tcenv, pos, "Invalid super call", x, y)
        })
      };
      TType::single(TPrimUnit(TVoid(), pos))

    | Call(Expr(_, Var(Name(_, "__SKJS_show"))), _, args) ->
      exprTy = this.expr(tcenv, args[0]);
      ty = exprTy.expand(tcenv.subst.clone(), this.tenv, Covariant());
      print_error(prettyPrintType(false, ty));
      TType::single(TPrimUnit(TVoid(), pos))
    | Call(f, targs, args) ->
      rty = this.call(
        tcenv,
        pos,
        this.expr(tcenv, f),
        targs.map(ty -> this.tenv.normalize(tcenv.context, ty)),
        args.map(x -> this.expr(tcenv, x)),
      );
      f.value match {
      | Binop(
        BODot(),
        Expr(_, Var(Name(_, "console"))),
        Expr(_, Var(Name(_, "assert"))),
      ) if (args.size() >= 1) ->
        this.evalCond(tcenv, args[0], true)
      | _ -> void
      };
      rty
    | New(
      className,
      targsAst,
      argsAst,
    ) if (tcenv.scope.maybeGet(className) is Some _) ->
      cstr = this.get(
        tcenv,
        pos,
        this.expr(tcenv, Expr(pos, Var(className))),
        Expr(pos, EString("constructor")),
        false,
        true,
      );
      this.call(
        tcenv,
        pos,
        cstr,
        targsAst.map(x -> this.tenv.normalize(tcenv.context, x)),
        argsAst.map(x -> this.expr(tcenv, x)),
      )

    | New(className, targsAst, argsAst) ->
      targs = if (targsAst.size() == 0) {
        this.tenv.makeTArgs(tcenv.context, tcenv.subst, className)
      } else {
        targsAst.map(targ -> this.tenv.normalize(tcenv.context, targ))
      };
      cstr = this.tenv.newConstructor(tcenv.context, className, targs);
      this.callConstructor(
        tcenv,
        pos,
        cstr,
        argsAst.map(e -> this.expr(tcenv, e)),
      );
      this.tenv.new(tcenv.context, className, targs)

    | Get(arr, idx) -> this.get(tcenv, pos, this.expr(tcenv, arr), idx)

    | EArray(arr) ->
      TType::single(TTuple(arr.map(x -> this.expr(tcenv, x)), pos))

    | Unop(uop, subExpr) ->
      uop match {
      | UOExclamationMark() ->
        bool = TType::single(TPrimValue::boolean(pos));
        this.checkSubType(
          tcenv,
          pos,
          "Invalid !",
          this.expr(tcenv, subExpr),
          bool,
        );
        bool
      | _ -> typingError(Array[(pos, "TODO: unary operator")])
      }

    | Binop(op, e1, e2) ->
      op match {
      | BOAddition() ->
        ty1 = this.expr(tcenv, e1);
        ty1.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
          stypes.singleElt()
        ) match {
        | Some(TPrimValue(k @ TNum(), _, primPos))
        | Some(TPrimValue(k @ TString(), _, primPos))
        | Some(TPrimValue(k @ TBigInt(), _, primPos)) ->
          ty2 = this.expr(tcenv, e2);
          res = TType::single(TPrimValue::full(k, primPos));
          this.checkSubType(tcenv, e2.pos, "Invalid + operand", ty2, res);
          res
        | _ ->
          typingError(
            Array[
              (pos, "Invalid + operation"),
              (e1.pos, `For an object of type: ${ty1}`),
            ],
          )
        }
      | BOAssignment() -> this.assign(tcenv, pos, e1, e2)
      | op_ @ BOStrictComparison() ->
        ty1 = this.nonVoidExpr(pos, tcenv, e1);
        ty2 = this.nonVoidExpr(pos, tcenv, e2);
        if (ty1.clauses.clauses.isEmpty() && ty2.clauses.clauses.isEmpty()) {
          isSubTType(tcenv.subst, this.tenv, ty1, ty2) match {
          | STOk() -> void
          | STError _ ->
            isSubTType(tcenv.subst, this.tenv, ty2, ty1) match {
            | STOk() -> void
            | STError _ ->
              alwaysResult = op_ match {
              | BOStrictEquality() -> "false"
              | BOStrictInequality() -> "true"
              };
              typingError(
                Array[(pos, "This is equality is always " + alwaysResult)],
              )
            }
          }
        };
        TType::single(TPrimValue::boolean(pos))

      | BOLogicalAnd() ->
        ty1 = this.expr(tcenv, e1);
        this.checkSubType(
          tcenv,
          pos,
          "Invalid &&",
          ty1,
          TType::single(TPrimValue::boolean(e1.pos)),
        );
        this.evalCond(tcenv, e1, true);
        ty2 = this.expr(tcenv, e2);
        this.checkSubType(
          tcenv,
          pos,
          "Invalid &&",
          ty2,
          TType::single(TPrimValue::boolean(e2.pos)),
        );
        TType::single(TPrimValue::boolean(pos))
      | BOLogicalOr() ->
        ty1 = this.expr(tcenv, e1);
        this.checkSubType(
          tcenv,
          pos,
          "Invalid ||",
          ty1,
          TType::single(TPrimValue::boolean(e1.pos)),
        );
        this.evalCond(tcenv, e1, false);
        ty2 = this.expr(tcenv, e2);
        this.checkSubType(
          tcenv,
          pos,
          "Invalid ||",
          ty2,
          TType::single(TPrimValue::boolean(e2.pos)),
        );
        TType::single(TPrimValue::boolean(pos))

      | BODot() ->
        e2.value match {
        | Var(fieldName) ->
          this.dot(tcenv, e1.pos, this.expr(tcenv, e1), fieldName)
        | _ -> typingError(Array[(e2.pos, "Invalid '.'")])
        }

      | BOOptionalDot() ->
        e2.value match {
        | Var(fieldName) ->
          this.dot(
            tcenv,
            e1.pos,
            this.expr(tcenv, e1),
            fieldName,
            true/* optionalChaining */ ,
          )
        | _ -> typingError(Array[(e2.pos, "Invalid '?.'")])
        }

      | BOExclamationMarkDot() -> notSupported(pos)

      | BOLessThan()
      | BOLessThanOrEqual()
      | BOGreaterThan()
      | BOGreaterThanOrEqual() ->
        getExprPrimKind = (e) -> {
          ty = this.expr(tcenv, e);
          ty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
            stypes.singleElt()
          ) match {
          | Some(TPrimValue(k, _, _)) -> k
          | _ ->
            typingError(
              Array[
                (
                  pos,
                  "Invalid comparison. You can only compare strings, numbers, bigints, and booleans.",
                ),
                (e1.pos, `This is a ${ty}`),
              ],
            )
          }
        };
        kind1 = getExprPrimKind(e1);
        kind2 = getExprPrimKind(e2);
        if (kind1 != kind2) {
          typingError(
            Array[
              (
                pos,
                "Invalid comparison. Both operands must have the same type.",
              ),
              (e1.pos, `This is a ${kind1}`),
              (e2.pos, `This is a ${kind2}`),
            ],
          )
        };
        TType::single(TPrimValue::boolean(pos))

      | BOOpAssignment(assOp) ->
        this.expr(
          tcenv,
          Expr(pos, Binop(BOAssignment(), e1, Expr(pos, Binop(assOp, e1, e2)))),
        )

      | BOAs() -> notSupported(pos)
      | BOMultiplication()
      | BODivision()
      | BORemainder()
      | BOSubtraction()
      | BOBitwiseAnd()
      | BOBitwiseOr()
      | BOBitwiseXor()
      | BOLeftShift()
      | BOSignedRightShift()
      | BOZeroFilledRightShift() ->
        ty1 = this.expr(tcenv, e1);
        kind1 = this.checkIsNumeric(tcenv, e1.pos, "Invalid operation", ty1);
        ty2 = this.expr(tcenv, e2);
        kind2 = this.checkIsNumeric(tcenv, e2.pos, "Invalid operation", ty2);
        if (kind1 != kind2) {
          typingError(
            Array[
              (
                pos,
                "Arithmetic operations require both operands to be the same numeric type",
              ),
              (e1.pos, `Left operand is ${kind1}`),
              (e2.pos, `Right operand is ${kind2}`),
            ],
          )
        };
        TType::single(TPrimValue::full(kind1, pos))

      | BONullishCoalescing() ->
        ty1 = this.nonVoidExpr(pos, tcenv, e1);
        ty2 = this.expr(tcenv, e2);
        ty1.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
        | None() -> void
        | Some(stypes) ->
          hasVoid = false;
          hasNullOrUndefined = false;
          hasOthers = false;
          for (stype in stypes) {
            stype match {
            | TPrimUnit(TVoid(), _) -> !hasVoid = true
            | TPrimUnit(TNull(), _)
            | TPrimUnit(TUndefined(), _) ->
              !hasNullOrUndefined = true
            | _ -> !hasOthers = true
            }
          };
          if (hasVoid) {
            typingError(
              Array[
                (pos, "Invalid operation on type void"),
                (e1.pos, `This expression has type ${ty1}`),
              ],
            )
          };
          if (!hasNullOrUndefined) {
            typingError(
              Array[
                (pos, "This operator is useless"),
                (e1.pos, "This construction is never null or undefined"),
              ],
            );
          };
          if (!hasOthers) {
            typingError(
              Array[
                (pos, "This operator is useless"),
                (e.pos, "This constructor is always null or undefined"),
              ],
            )
          }
        };
        nullish = TType::nullish(pos);
        ty1WithoutNullish = ty1.diff(nullish);
        TType::union(tcenv.subst, this.tenv, ty1WithoutNullish, ty2)
      }

    | InstanceOf(e1, Expr(_, Var(className))) ->
      _ = this.expr(tcenv, e1);
      _ = this.tenv.getClass(tcenv.context, className);
      TType::single(TPrimValue::boolean(pos))
    | InstanceOf(_, e2) -> typingError(Array[(e2.pos, "Unexpected instanceof")])
    | TypeOf(subExpr) ->
      _ = this.nonVoidExpr(pos, tcenv, subExpr);
      TType::single(TPrimValue::string(pos))

    | PostOp(pop, subExpr) ->
      pop match {
      | PODecr()
      | POIncr() ->
        num = TType::single(TPrimValue::number(pos));
        ty = this.expr(tcenv, subExpr);
        this.checkSubType(tcenv, pos, "Expected integer", ty, num);
        num
      | POExcl() -> notSupported(pos)
      }

    | c @ Closure(params, retTypeAstOpt, body) ->
      this.anonFunction(tcenv, None(), pos, c, params, retTypeAstOpt, body)
    | Async(Expr(closurePos, c @ Closure(params, retTypeAstOpt, body))) ->
      this.anonFunction(
        tcenv,
        Some(pos),
        closurePos,
        c,
        params,
        retTypeAstOpt,
        body,
      )
    | As _ -> notSupported(pos)
    | Async _ -> typingError(Array[(pos, "Invalid async")])
    | Await(ae) ->
      aeType = this.expr(tcenv, ae);
      aeType.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TPromise(ty, _)) -> ty
      | _ ->
        typingError(
          Array[(pos, "Invalid await"), (aeType.pos, "This is not a promise")],
        )
      }
    | EIf(e1, e2, e3) ->
      cond = this.expr(tcenv, e1);
      this.checkSubType(
        tcenv,
        e1.pos,
        "Invalid ? condition",
        cond,
        TType::single(TPrimValue::boolean(e1.pos)),
      );

      // Create scopes for the true and false branches with type refinements
      scopeCopy = tcenv.scope;

      // True branch - evaluate e2 with refinements from e1 being true
      trueScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = trueScope;
      this.evalCond(tcenv, e1, true);
      left = this.expr(tcenv, e2);
      tcenv.!scope = scopeCopy;

      // False branch - evaluate e3 with refinements from e1 being false
      falseScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = falseScope;
      this.evalCond(tcenv, e1, false);
      right = this.expr(tcenv, e3);
      tcenv.!scope = scopeCopy;

      TType::union(tcenv.subst, this.tenv, left, right)
    | AsConst(subExpr) ->
      this.asConstExpr(subExpr) match {
      | Some(ty) -> ty
      | None() ->
        typingError(
          Array[(pos, "'as const' can only be used with string literals")],
        )
      }
    | Params _ -> paramsError(pos)
    | Regexp _ -> typingError(Array[(pos, "TODO: regexp")])
    | Spread _ -> typingError(Array[(pos, "TODO: ...")])
    }
  }

  fun anonFunction(
    tcenv: mutable TCEnv,
    isAsync: ?PosRange,
    pos: PosRange,
    c: Closure,
    params: Array<(Name, ?Type)>,
    retTypeAstOpt: ?Type,
    body: ClosureBody,
  ): TType {
    paramTypes = mutable Vector[];
    for (param in params) {
      paramType = param.i1 match {
      | None() ->
        typingError(Array[(param.i0.pos, "Please add a type annotation")])
      | Some(ty) -> this.tenv.normalize(tcenv.context, ty)
      };
      paramTypes.push((param.i0, paramType));
    };
    retType = retTypeAstOpt match {
    | None() ->
      tvar = this.newTVar(tcenv, pos);
      isAsync match {
      | None() -> tvar
      | Some(asyncPos) -> TType::single(TPromise(tvar, asyncPos))
      }
    | Some(retTypeAst) -> this.tenv.normalize(tcenv.context, retTypeAst)
    };
    callingContext = CGNode::create(AnonymousLambda(pos, c));
    // Register a dependency from parent context on this lambda
    this.callgraph.recordCalls(
      tcenv.context,
      tcenv.scope.callingContext,
      CGNodes::singleton(callingContext),
    );
    savedScope = tcenv.scope.clone() with {callingContext};

    this.closure(
      tcenv.subst,
      savedScope,
      isAsync,
      paramTypes.toArray(),
      retType,
      body,
    );
    TType::single(
      TFuns::singleFun(
        TFun(
          Array[],
          paramTypes.map(x -> x.i1).toArray(),
          Array[],
          None(),
          pos,
          retType,
          CGNodes::singleton(callingContext),
        ),
        pos,
      ),
    )
  }

  /* Typechecks expression e as const */
  fun asConstExpr(e: Expr): ?TType {
    pos = e.pos;
    e.value match {
    | AsConst(subExpr) ->
      typingError(Array[(subExpr.pos, "Unnecessary 'as const'")])
    | Var(Name(_, "null")) -> Some(TType::single(TPrimUnit(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      Some(TType::single(TPrimUnit(TUndefined(), pos)))
    | Number(n) -> Some(TType::single(TPrimValue::single(TNum(), n, pos)))
    | BigInt(n) -> Some(TType::single(TPrimValue::single(TBigInt(), n, pos)))
    | Var(Name(_, "true")) ->
      Some(TType::single(TPrimValue::single(TBool(), "true", pos)))
    | Var(Name(_, "false")) ->
      Some(TType::single(TPrimValue::single(TBool(), "false", pos)))
    | EString(n) -> Some(TType::single(TPrimValue::single(TString(), n, pos)))
    | _ -> None()
    }
  }

  fun closure(
    subst: mutable Subst,
    scope: Scope,
    isAsync: ?PosRange,
    params: Array<(Name, TType)>,
    retType: TType,
    body: ClosureBody,
  ): void {
    tcenv = mutable TCEnv(subst.context, subst, Scope::fromSaved(scope));
    for (param in params) {
      tcenv.scope.bind(param.i0, param.i1, true)
    };
    body match {
    | CBExpr(e) ->
      this.checkSubType(
        tcenv,
        e.pos,
        "Invalid callback return",
        isAsync match {
        | None() -> this.expr(tcenv, e)
        | Some(asyncPos) ->
          TType::single(TPromise(this.expr(tcenv, e), asyncPos))
        },
        retType,
      )
    | CBBlock(bl) ->
      if (isAsync is Some _) !this.isAsync = true;
      !this.retType = Some(retType);
      _ = this.block(tcenv, bl)
    }
  }

  fun callConstructor(
    tcenv: mutable TCEnv,
    pos: PosRange,
    cstrType: CstrType,
    args: Array<TType>,
  ): void {
    cstrType.cstr match {
    | None() ->
      if (args.size() == 0) return void;
      typingError(Array[(pos, "Invalid new: constructor expects no arguments")])
    | Some(cstr) -> _ = this.call(tcenv, pos, cstr, Array[], args)
    }
  }

  fun assign(tcenv: mutable TCEnv, pos: PosRange, e1: Expr, e2: Expr): TType {
    this.checkLValue(e1);
    e1.value match {
    | Var(n) ->
      ty2 = this.expr(tcenv, e2);
      tcenv.scope.set(n, ty2, (x, y) ->
        this.checkSubType(tcenv, pos, "Invalid assignment", x, y)
      );
      ty2
    | Binop(
      BODot(),
      Expr(_, Var(local)),
      Expr(_, Var(fieldName)),
    ) if (tcenv.localObjects.containsKey(local.value)) ->
      fieldType = this.expr(tcenv, e2);
      tcenv.localObjects[local.value] match {
      | None() -> void
      | Some(objectType) ->
        this.checkSubType(
          tcenv,
          e2.pos,
          "Invalid assignment",
          fieldType,
          this.dot(tcenv, e1.pos, objectType, fieldName),
        )
      };
      this.assignLocalObject(tcenv, pos, local, fieldName, fieldType)
    | _ ->
      ty1 = this.expr(tcenv, e1);
      ty2 = this.expr(tcenv, e2);
      this.checkSubType(tcenv, e2.pos, "Invalid assignment", ty2, ty1);
      ty1
    }
  }

  fun assignLocalObject(
    tcenv: mutable TCEnv,
    pos: PosRange,
    local: Name,
    fieldName: Name,
    fieldType: TType,
  ): TType {
    objField = tcenv.scope
      .get(local)
      .getSTypes(tcenv.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TObject(fields, objPos)) ->
      fields.maybeGet(fieldName.value) match {
      | None() ->
        tcenv.usedObjects.maybeGet(local.value) match {
        | None() -> void
        | Some(usedPos) ->
          typingError(
            Array[
              (pos, "You are trying to add a field to this object"),
              (
                usedPos,
                "But this object has been already been used for something else",
              ),
            ],
          )
        };
        if (tcenv.scope.isThroughLoop(local)) {
          typingError(
            Array[(local.pos, "You cannot add a field to an object in a loop")],
          )
        };
        field = TField::create(
          fieldType.pos,
          fieldName.value,
          false,
          fieldType,
        ) match {
        | None() -> internal_error("TODO: converting an object to an algebraic")
        | Some(f) -> f
        };
        tcenv.scope.set(
          local,
          TType::single(
            TObject(
              interTFields(
                tcenv.subst,
                this.tenv,
                fields,
                TFields::create(Array[field], Array[]),
              ),
              objPos,
            ),
          ),
          (x, y) -> {
            this.checkSubType(tcenv, fieldType.pos, "Invalid assignment", x, y)
          },
        );
        fieldType
      | Some(fd) -> fd.type
      }
    | _ -> internal_error("Internal error: local object is not an object")
    };
    this.checkSubType(
      tcenv,
      fieldType.pos,
      "Invalid assignment",
      fieldType,
      objField,
    );
    fieldType
  }

  fun getArrayEltType(tcenv: mutable TCEnv, object: TObject): TType {
    object.fields.maybeGet("pop") match {
    | None() -> typingError(Array[(object.pos, "Expected an Array type")])
    | Some(popMethod) ->
      popF = popMethod.type
        .getSTypes(tcenv.subst, this.tenv, Covariant())
        .flatMap(stypes ~> stypes.singleElt())
        .fromSome() match {
      | TFuns(_, methods, _) ->
        for (met in methods) {
          break met
        } else {
          internal_error("Unexpected type for Array::pop")
        }
      | _ -> internal_error("Unexpected pop method type for")
      };
      popF.retType
    };
  }

  fun call(
    tcenv: mutable TCEnv,
    pos: PosRange,
    fty: TType,
    targs: Array<TType>,
    args: Array<TType>,
  ): TType {
    result: ?TType = None();
    fty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TFuns(funs, methods, _)) ->
      for (tfun in funs.values().concat(methods.values())) {
        this.callgraph.recordCalls(
          tcenv.context,
          tcenv.scope.callingContext,
          tfun.cgNodes,
        );
        if (targs.size() != 0 && targs.size() != tfun.tparams.size()) {
          typingError(
            Array[
              (
                pos,
                "Incompatible number of type arguments: " +
                  targs.size() +
                  " passed",
              ),
              (fty.pos, "Expected: " + tfun.tparams.size()),
            ],
          )
        };
        map = SortedMap[];
        for (i => tparamDecl in tfun.tparams) {
          !map[tparamDecl.id] = if (targs.isEmpty()) {
            this.newTVar(tcenv, pos)
          } else {
            targs[i]
          };
        };
        !tfun = (mutable Instantiate()).fun_(
          (tcenv.subst, this.tenv, map.chill()),
          tfun with {tparams => Array[]},
        );
        version = tcenv.subst.version;
        loop {
          for (i in Range(0, tfun.params.size())) {
            if (i >= args.size()) {
              typingError(
                Array[
                  (pos, "Invalid call"),
                  (
                    fty.pos,
                    "This function has " + tfun.params.size() + " parameters",
                  ),
                ],
              )
            };
            this.checkSubType(
              tcenv,
              pos,
              "Invalid call",
              args[i],
              tfun.params[i],
            )
          };
          for (j in Range(0, tfun.optionalParams.size())) {
            i = tfun.params.size() + j;
            if (i >= args.size()) break void;
            this.checkSubType(
              tcenv,
              pos,
              "Invalid call",
              args[i],
              tfun.optionalParams[j],
            )
          };
          if (tcenv.subst.version == version) break void;
          !version = tcenv.subst.version;
        };
        totalSize = tfun.params.size() + tfun.optionalParams.size();
        if (totalSize < args.size()) {
          tfun.spreadParam match {
          | None() ->
            typingError(
              Array[
                (pos, "Too many arguments"),
                (tfun.minSizeWitness, "For this function"),
              ],
            )
          | Some(spreadType) ->
            spreadType
              .getSTypes(tcenv.subst, this.tenv, Contravariant())
              .flatMap(stypes ~> stypes.singleElt()) match {
            | Some(object @ TObject _) ->
              eltType = this.getArrayEltType(tcenv, object);
              for (i in Range(totalSize, args.size())) {
                this.checkSubType(
                  tcenv,
                  pos,
                  "Invalid argument",
                  args[i],
                  eltType,
                );
              }
            | _ ->
              typingError(
                Array[
                  (pos, "Invalid call. Unexpected type for ..."),
                  (spreadType.pos, `${spreadType} is not an array`),
                ],
              )
            }
          }
        };
        !result = result match {
        | None() -> Some(tfun.retType)
        | Some(r) -> Some(TType::union(tcenv.subst, this.tenv, r, tfun.retType))
        };
      }
    | _ -> void
    };
    result match {
    | None() ->
      typingError(
        Array[
          (pos, "Invalid call"),
          (fty.pos, `Type ${fty} is not a function`),
        ],
      )
    | Some(x) -> x
    }
  }
}

module end;
