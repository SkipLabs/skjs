module SKJS;

base class AccessKind uses XXHashable {
  children =
  | AKNormal()
  | AKLValue()
  | AKOptionalChain()
}

// The stdlib gives SortedMap Hashable/Equality/Orderable but not XXHashable;
// add it (when keys and values are XXHashable) so records that accumulate into
// SortedMaps — e.g. ObjectSpreadState — can derive XXHashable. Folds over the
// entries in sorted order, so equal maps hash equal.
extension base class .SortedMap uses XXHashable[K: XXHashable, V: XXHashable] {
  fun xxhash[K: XXHashable, V: XXHashable](): XXHash {
    XXHash(
      this.reduce(
        (h, k, v) ->
          XXHash64.xxHash64(
            XXHash64.xxHash64(h, k.xxhash().value),
            v.xxhash().value,
          ),
        -1,
      ),
    )
  }
}

// Accumulator for one prospective branch of an object literal under
// construction: the named/symbol fields written so far plus the index
// signatures. The literal is built by threading a worklist of these through the
// field descriptors; distributing a spread over a union-typed source fans the
// worklist out — one state per source branch (SkipLabs/skjs#714).
class ObjectSpreadState{
  fields: SortedMap<FieldNameString, TField>,
  symbolFields: SortedMap<FieldNameString, TField>,
  tIndexes: TIndexes,
} uses XXHashable {
  const empty: ObjectSpreadState = ObjectSpreadState{
    fields => SortedMap[],
    symbolFields => SortedMap[],
    tIndexes => TIndexes::empty,
  };

  fun withField(field: TField): ObjectSpreadState {
    newFields = this.fields;
    !newFields[field.name] = field;
    this with {fields => newFields}
  }

  fun withSymbolField(field: TField): ObjectSpreadState {
    newSymbolFields = this.symbolFields;
    !newSymbolFields[field.name] = field;
    this with {symbolFields => newSymbolFields}
  }

  // Structural equality ignoring field declaration positions, used to
  // deduplicate the distribution worklist. The derived == is TField.pos-
  // sensitive, so semantically-identical states built from same-shaped but
  // separately-declared source types would never deduplicate (and, since the
  // hash is position-INsensitive, would pile into one linearly-rescanned hash
  // bucket) — inflating the worklist toward the branch cap for no semantic
  // difference. Keeping the first state of an equivalence class only affects
  // which positions later diagnostics point at.
  fun dedupEquals(other: ObjectSpreadState): Bool {
    static::fieldMapsEqualIgnoringPos(this.fields, other.fields) &&
      static::fieldMapsEqualIgnoringPos(
        this.symbolFields,
        other.symbolFields,
      ) &&
      static::optFieldsEqualIgnoringPos(
        this.tIndexes.stringIndex,
        other.tIndexes.stringIndex,
      ) &&
      static::optFieldsEqualIgnoringPos(
        this.tIndexes.numberIndex,
        other.tIndexes.numberIndex,
      ) &&
      static::optFieldsEqualIgnoringPos(
        this.tIndexes.symbolIndex,
        other.tIndexes.symbolIndex,
      )
  }

  private static fun fieldMapsEqualIgnoringPos(
    m1: SortedMap<FieldNameString, TField>,
    m2: SortedMap<FieldNameString, TField>,
  ): Bool {
    if (m1.size() != m2.size()) return false;
    it2 = m2.items();
    for ((k1, v1) in m1.items()) {
      it2.next() match {
      | Some((k2, v2)) ->
        if (!(k1 == k2 && v1.equalsIgnoringPos(v2))) return false
      | None() -> return false
      }
    };
    true
  }

  private static fun optFieldsEqualIgnoringPos(f1: ?TField, f2: ?TField): Bool {
    (f1, f2) match {
    | (None(), None()) -> true
    | (Some(a), Some(b)) -> a.equalsIgnoringPos(b)
    | _ -> false
    }
  }

  // Finish a branch: add the synthetic string/symbol index type variables that
  // let a fresh object literal be assigned to indexed types via subtyping (they
  // are invisible to field resolution), then build the TFields.
  fun toTFields(subst: mutable Subst, pos: PosRange): TFields {
    tIndexes = this.tIndexes;
    if (tIndexes.stringIndex.isNone()) {
      !tIndexes.stringIndex = Some(TField::createSyntheticIndex(subst, pos))
    };
    if (tIndexes.symbolIndex.isNone()) {
      !tIndexes.symbolIndex = Some(TField::createSyntheticIndex(subst, pos))
    };
    TFields::createFromSorted{
      fields => this.fields,
      symbolFields => this.symbolFields,
      tIndexes,
      // An object literal (or spread result) is a plain object: never
      // callable or constructible.
      call => CAbsent(),
      new => CAbsent(),
      isArray => Some(false),
    }
  }

  // Merge an object-spread source branch into this state. Pure (no diagnostics),
  // so it is safe to call once per (state, source branch) pair when distributing
  // a spread. Sound spread typing:
  //   - a non-optional source field wins (replaces existing);
  //   - otherwise keep the existing optionality, union the get type with the
  //     source's contribution (optional field / covering index / Top);
  //   - always read via the getter (spread copies values through getters).
  static fun merge(
    subst: mutable Subst,
    tenv: TEnv,
    state: ObjectSpreadState,
    branch: TFields,
    pos: PosRange,
  ): ObjectSpreadState {
    newFields = static::mergeFieldMap(
      subst,
      tenv,
      state.fields,
      branch.fields,
      name -> branch.indexForFieldName(name),
      name -> state.tIndexes.indexForFieldName(name),
      pos,
    );
    newSymbolFields = static::mergeFieldMap(
      subst,
      tenv,
      state.symbolFields,
      branch.symbolFields,
      _ -> branch.symbolIndex,
      _ -> state.tIndexes.symbolIndex,
      pos,
    );
    if (
      state.tIndexes.numberIndex.isSome() &&
      state.tIndexes.stringIndex.isNone()
    ) {
      invariant_violation(
        "Spread with existing number index but no string index",
      );
    };
    // A synthetic index is a subtyping artifact on a closed object literal,
    // not a real property bag, so it contributes nothing to the spread; an
    // absent index on a (named) source may still hide excess properties, so
    // that widens to Top. See mergeFieldMap and the index merges below.
    spreadStrIdx = branch.stringIndex match {
    | Some(f) if (!f.isSynthetic()) -> f.get
    | Some(_) -> TType::bottom(pos)
    | None() -> TType::top(pos)
    };
    mergedNumberIndex = (
      state.tIndexes.numberIndex,
      state.tIndexes.stringIndex,
      branch.numberIndex,
    ) match {
    | (None(), _, None()) -> None()
    | (None(), None(), Some(spreadNumIdx)) ->
      Some(
        TField::create{
          pos => spreadNumIdx.pos,
          name => spreadNumIdx.name.value,
          isOptional => true,
          isReadonly => None(),
          type => spreadNumIdx.get,
          access => FAPublic(),
        },
      )
    | (None(), Some(existingIdx), spreadNumIdx @ Some _)
    | (Some(existingIdx), _, spreadNumIdx) ->
      type = TType::union(
        subst,
        tenv,
        existingIdx.get,
        spreadNumIdx.map(f -> f.get).default(spreadStrIdx),
      );
      Some(
        TField::create{
          pos => existingIdx.pos,
          name => existingIdx.name.value,
          isOptional => true,
          isReadonly => None(),
          type,
          access => FAPublic(),
        },
      )
    };
    // A synthetic string/symbol index (an object-literal subtyping artifact)
    // must not merge into the accumulated index: the literal is closed, so it
    // adds no real index. Keep the existing index unchanged in that case,
    // rather than routing the literal's shared synthetic get-tvar into the
    // result (which chained spreads could then drive to a contradiction). A
    // real index still merges; an absent index still widens to an open Top
    // index via mergeSpreadIndex.
    mergedStringIndex = branch.stringIndex match {
    | Some(f) if (f.isSynthetic()) -> state.tIndexes.stringIndex
    | branchStringIndex ->
      Some(
        static::mergeSpreadIndex(
          subst,
          tenv,
          state.tIndexes.stringIndex,
          branchStringIndex,
          pos,
        ),
      )
    };
    mergedSymbolIndex = branch.symbolIndex match {
    | Some(f) if (f.isSynthetic()) -> state.tIndexes.symbolIndex
    | branchSymbolIndex ->
      Some(
        static::mergeSpreadIndex(
          subst,
          tenv,
          state.tIndexes.symbolIndex,
          branchSymbolIndex,
          pos,
        ),
      )
    };
    ObjectSpreadState{
      fields => newFields,
      symbolFields => newSymbolFields,
      tIndexes => TIndexes{
        stringIndex => mergedStringIndex,
        numberIndex => mergedNumberIndex,
        symbolIndex => mergedSymbolIndex,
      },
    }
  }

  // Merge one field map (named or symbol) of the state with the source
  // branch's, parameterized by the index lookups that back absent keys — the
  // same shape as TFields::interNamedFields. A non-optional source field wins;
  // an existing field otherwise unions its getter with the source's
  // contribution (field / covering index / Top); a source-only field keeps its
  // optionality, unioning an optional one with the state's covering index.
  private static fun mergeFieldMap(
    subst: mutable Subst,
    tenv: TEnv,
    stateFields: SortedMap<FieldNameString, TField>,
    branchFields: InternalKeyedArrayMap<FieldNameString, TField>,
    branchIndexFor: String -> ?TField,
    stateIndexFor: String -> ?TField,
    pos: PosRange,
  ): SortedMap<FieldNameString, TField> {
    newFields = SortedMap<FieldNameString, TField>[];
    for (existingField in stateFields) {
      branchFields.maybeGet(existingField.name) match {
      | Some(spreadField) if (!spreadField.isOptional) ->
        !newFields[spreadField.name] = TField::create{
          pos => spreadField.pos,
          name => spreadField.name.value,
          isOptional => false,
          isReadonly => None(),
          type => spreadField.get,
          access => FAPublic(),
        }
      | optSpreadField ->
        spreadGet = optSpreadField match {
        | Some(sf) -> sf.get
        | None() ->
          branchIndexFor(existingField.name.value) match {
          // A synthetic index is a subtyping artifact on an object literal
          // (added so `{x:1}` can satisfy `{[k:string]:number}`), not a real
          // runtime property bag. Spreading a closed object literal that
          // lacks this field contributes nothing to it, so keep the existing
          // field type — do NOT union in the synthetic index's get. Merging
          // it would couple unrelated siblings through the literal's shared
          // synthetic get-tvar and drive them to a spurious contradiction.
          | Some(idx) if (!idx.isSynthetic()) -> idx.get
          | Some(_) -> existingField.get
          // No index at all: a named-field source may still carry an untyped
          // excess property here via width subtyping, so widen to Top.
          | None() -> TType::top(pos)
          }
        };
        mergedGet = TType::union(subst, tenv, existingField.get, spreadGet);
        !newFields[existingField.name] = TField::create{
          pos => existingField.pos,
          name => existingField.name.value,
          isOptional => existingField.isOptional,
          isReadonly => None(),
          type => mergedGet,
          access => FAPublic(),
        }
      }
    };
    for (spreadField in branchFields) {
      if (!newFields.containsKey(spreadField.name)) {
        fieldGet = if (spreadField.isOptional) {
          stateIndexFor(spreadField.name.value) match {
          | Some(idx) -> TType::union(subst, tenv, idx.get, spreadField.get)
          | None() -> spreadField.get
          }
        } else {
          spreadField.get
        };
        !newFields[spreadField.name] = TField::create{
          pos => spreadField.pos,
          name => spreadField.name.value,
          isOptional => spreadField.isOptional,
          isReadonly => None(),
          type => fieldGet,
          access => FAPublic(),
        }
      }
    };
    newFields
  }

  // Merge the state's string (or symbol) index with the source branch's: no
  // existing index adopts the source's (or an open "SKJS_ObjectSpread" Top
  // index when the source has none — its possible excess properties); an
  // existing index unions its getter with the source's contribution.
  private static fun mergeSpreadIndex(
    subst: mutable Subst,
    tenv: TEnv,
    existingIndex: ?TField,
    branchIndex: ?TField,
    pos: PosRange,
  ): TField {
    spreadGet = branchIndex.map(f -> f.get).default(TType::top(pos));
    existingIndex match {
    | None() ->
      TField::create{
        pos => branchIndex.map(f -> f.pos).default(pos),
        name => branchIndex.map(f -> f.name.value).default("SKJS_ObjectSpread"),
        isOptional => true,
        isReadonly => None(),
        type => spreadGet,
        access => FAPublic(),
      }
    | Some(existingIdx) ->
      type = TType::union(subst, tenv, existingIdx.get, spreadGet);
      TField::create{
        pos => existingIdx.pos,
        name => existingIdx.name.value,
        isOptional => true,
        isReadonly => None(),
        type,
        access => FAPublic(),
      }
    }
  }
}

extension class TypeChecker {
  // Spread reads each property via its getter, so a private source field would
  // be exposed as a public one on the resulting object — laundering privacy.
  // Reject the spread (but keep going so the rest of the expression still
  // type-checks). Scans every branch of the source, reporting each offending
  // name once; serves both the named-field and symbol-field maps.
  private fun checkSpreadPrivacy(
    tcenv: mutable TCEnv,
    spreadPos: PosRange,
    sourceBranches: readonly Vector<TFields>,
    fieldsOf: TFields -> InternalKeyedArrayMap<FieldNameString, TField>,
    what: String,
  ): void {
    reported = mutable Set[];
    for (branch in sourceBranches) {
      for (spreadField in fieldsOf(branch)) {
        if (
          !(spreadField.access is FAPublic _) &&
          !reported.contains(spreadField.name.value)
        ) {
          reported.insert(spreadField.name.value);
          tcenv.error(
            Array[
              (
                spreadPos,
                `Cannot spread an object with non-public ${what} '${
                  spreadField.name.value
                }'`,
              ),
              (spreadField.pos, "Declared here"),
            ],
            SKJSCode(2072),
          )
        }
      }
    }
  }

  fun block(
    tcenv: mutable TCEnv,
    stmts: Array<Stmt>,
    cond: ?(Expr, Bool) = None(),
    // The scope of a `switch` clause that falls into this block, when there is
    // one: its statements have already run when the fallthrough is what reached
    // this block. See `Scope::uniteFallenInto`.
    fallenFrom: ?readonly Scope = None(),
  ): readonly Scope {
    scopeCopy = tcenv.scope;
    scope = tcenv.mcreateSubScope{isLoop => false};
    tcenv.!scope = scope;
    cond match {
    | None() -> void
    | Some((c, target)) -> this.evalCond(tcenv, c, target)
    };
    // After `cond`: the fallthrough entry is a separate way in, so its values
    // are unioned with the narrowed own-entry ones, not narrowed by `cond`.
    fallenFrom.each(from -> scope.uniteFallenInto(tcenv.subst, this, from));
    for (st in stmts) {
      this.stmt(tcenv, st)
    };
    tcenv.!scope = scopeCopy;
    scope
  }

  fun bind(
    tcenv: mutable TCEnv,
    kind: BindKind,
    pat: Pattern,
    type: TType,
    isAnnotated: Bool,
    isInitialized: Bool,
    isLocalObject: Bool,
  ): void {
    pos = pat.pos;
    pat.value match {
    | PVar(local) ->
      if (isLocalObject && !tcenv.scope.isThroughLoop(local)) {
        // Key by this binding's own declaration position; distinct same-name
        // bindings get distinct entries (no stale reuse).
        tcenv.localObjects![local.pos] = LOCanGrow(None())
      };
      tcenv.scope.bind(tcenv, local, type, isAnnotated, isInitialized)
    | PArray(arrPat, rest) ->
      stypes = type.getSTypes(tcenv.subst, this, Covariant());
      stypes.flatMap(s -> s.getSingleTuple(tcenv.subst, this)) match {
      | Some(tyl) ->
        for (i in Range(0, min(arrPat.size(), tyl.size()))) {
          arrPat[i] match {
          | None() -> /* skipped element */ void
          | Some((eltPat, Some(defaultExpr))) ->
            eltType = tyl[i];
            defaultType = this.expr(tcenv, defaultExpr, kind is BKConst());
            undefined = TType::single(TPrimUnit(TUndefined(), defaultExpr.pos));
            canBeUndefined = TType::isSub(
              tcenv.subst.clone(),
              this,
              undefined,
              eltType,
            ) is STOk();
            isAlwaysUndefined = TType::isSub(
              tcenv.subst.clone(),
              this,
              eltType,
              undefined,
            ) is STOk();
            if (!canBeUndefined) {
              tcenv.warning(
                Array[
                  (
                    defaultExpr.pos,
                    "This default is unreachable because the element cannot be 'undefined'",
                  ),
                ],
                SKJSCode(2063),
              )
            };
            if (isAlwaysUndefined) {
              tcenv.warning(
                Array[
                  (
                    defaultExpr.pos,
                    "This default is unreachable: the element is always 'undefined'",
                  ),
                ],
                SKJSCode(2037),
              )
            };
            boundType = if (canBeUndefined) {
              TType::union(
                tcenv.subst,
                this,
                TType::removeUndefined(tcenv.subst, this, eltType),
                defaultType,
              )
            } else {
              eltType
            };
            this.bind(
              tcenv,
              kind,
              eltPat,
              boundType,
              isAnnotated,
              isInitialized,
              false,
            )
          | Some((eltPat, None())) ->
            this.bind(
              tcenv,
              kind,
              eltPat,
              tyl[i],
              isAnnotated,
              isInitialized,
              false,
            )
          };
        };
        sizeOk = rest match {
        | Some(_) -> arrPat.size() <= tyl.size()
        | None() -> arrPat.size() == tyl.size()
        };
        if (!sizeOk) {
          fatalError(
            Array[
              (
                pos,
                `This destructuring pattern has ${arrPat.size()} elements, which does not match the tuple's length`,
              ),
              (
                type.pos,
                `It is incompatible with a tuple of size ${tyl.size()}`,
              ),
            ],
            SKJSCode(2036),
          )
        };
        rest match {
        | Some(restName) ->
          restType = TType::tuple(
            restName.pos,
            tyl.slice(arrPat.size()),
            false,
          );
          this.bind(
            tcenv,
            kind,
            Pattern(restName.pos, PVar(restName)),
            restType,
            isAnnotated,
            isInitialized,
            false,
          )
        | None() -> void
        }
      | None() ->
        stypes.flatMap(s ~> s.singleElt()) match {
        | Some(obj @ TObject _) ->
          eltType = this.getIteratorElementType(tcenv.subst, obj, pos) match {
          | Some(t) -> t
          | None() ->
            fatalError(
              Array[
                (pos, "Cannot use array-destructuring on a non-iterable type"),
                (
                  type.pos,
                  `This is not iterable, it is ${this.ppType(tcenv, type)}`,
                ),
              ],
              TSCode(2461),
            )
          };
          for (i in Range(0, arrPat.size())) {
            arrPat[i] match {
            | None() -> void
            | Some((eltPat, Some(defaultExpr))) ->
              defaultType = this.expr(tcenv, defaultExpr, kind is BKConst());
              boundType = TType::union(
                tcenv.subst,
                this,
                TType::removeUndefined(tcenv.subst, this, eltType),
                defaultType,
              );
              this.bind(
                tcenv,
                kind,
                eltPat,
                boundType,
                isAnnotated,
                isInitialized,
                false,
              )
            | Some((eltPat, None())) ->
              optionalEltType = TType::unionUndefined(
                tcenv.subst,
                this,
                eltType,
                eltPat.pos,
              );
              this.bind(
                tcenv,
                kind,
                eltPat,
                optionalEltType,
                isAnnotated,
                isInitialized,
                false,
              )
            }
          };
          rest match {
          | Some(restName) ->
            restType = TType::inst(
              Name(restName.pos, "Array"),
              TArgs(Array[eltType]),
            );
            this.bind(
              tcenv,
              kind,
              Pattern(restName.pos, PVar(restName)),
              restType,
              isAnnotated,
              isInitialized,
              false,
            )
          | None() -> void
          }
        | _ ->
          fatalError(
            Array[
              (pos, "Cannot use array-destructuring on this type"),
              (
                type.pos,
                `This is not a tuple, it is ${this.ppType(tcenv, type)}`,
              ),
            ],
            TSCode(2461),
          )
        }
      }

    | PObject{fields => objectFields, rest} ->
      fieldsToRemoveForRest = rest match {
      | None() -> SortedSet[]
      | Some(_name) ->
        SortedSet::createFromItems(objectFields.map(f -> f.i0.value))
      };
      type.getSTypes(tcenv.subst, this, Covariant()) match {
      | None() ->
        fatalError(
          Array[
            (pos, "Cannot use object-destructuring on this type"),
            (type.pos, `This is ${this.ppType(tcenv, type)}`),
          ],
          SKJSCode(2035),
        )
      | Some(stypes) ->
        for (stype in stypes) {
          (branches, typeForRest) = stype match {
          | tobj @ TObject(_, _, _) ->
            (tobj.getBranches(), tobj.removeFields(fieldsToRemoveForRest))
          | _ ->
            fatalError(
              Array[
                (pos, "Cannot use object-destructuring on this type"),
                (type.pos, `This is ${this.ppType(tcenv, type)}`),
              ],
              SKJSCode(2035),
            )
          };
          for (field in objectFields) {
            (fieldName, fieldPat, fieldDefault) = field;
            defaultOpt = fieldDefault.map(e ->
              (e.pos, this.expr(tcenv, e, kind is BKConst()))
            );
            defaultIsUseless = fieldDefault.map(e -> e.pos);
            typeForField = TType::bottom(fieldName.pos);
            for (fields in branches) {
              fields.maybeGet(fieldName.value) match {
              | None() ->
                // The key is absent, so a default is the ONLY thing that can
                // fire at runtime — it is not useless (#799). The 2339 error
                // below already covers the misuse.
                !defaultIsUseless = None();
                tcenv.error(
                  Array[
                    (
                      fieldName.pos,
                      `Property '${TypePp::escapeName(
                        fieldName.value,
                      )}' does not exist on this type`,
                    ),
                    (type.pos, `Out of ${this.ppType(tcenv, type)}`),
                  ],
                  TSCode(2339),
                )
              | Some(tfield) ->
                this.checkFieldAccess(tcenv, tfield, fieldName.pos);
                undefined = (pos) ->
                  TType::single(TPrimUnit(TUndefined(), pos));
                union = (t1, t2) -> TType::union(tcenv.subst, this, t1, t2);
                !typeForField = union(
                  typeForField,
                  defaultOpt match {
                  | Some((defaultPos, defaultType)) ->
                    if (
                      tfield.isOptional ||
                      TType::isSub(
                        tcenv.subst.clone(),
                        this,
                        undefined(defaultPos),
                        tfield.get,
                      ) is STOk()
                    ) {
                      !defaultIsUseless = None();
                      union(
                        TType::removeUndefined(tcenv.subst, this, tfield.get),
                        defaultType,
                      )
                    } else {
                      tfield.get
                    }
                  | None() ->
                    if (tfield.isOptional) {
                      union(tfield.get, undefined(tfield.pos))
                    } else {
                      tfield.get
                    }
                  },
                )
              }
            };
            defaultIsUseless match {
            | None() -> void
            | Some(defaultPos) ->
              tcenv.warning(
                Array[
                  (
                    defaultPos,
                    "This default is unreachable because the field cannot be 'undefined'",
                  ),
                ],
                SKJSCode(2063),
              )
            };
            this.bind(
              tcenv,
              kind,
              fieldPat,
              typeForField,
              isAnnotated,
              isInitialized,
              false,
            )
          };
          rest.each(name ->
            this.bind(
              tcenv,
              kind,
              Pattern(name.pos, PVar(name)),
              TType::single(typeForRest),
              isAnnotated,
              isInitialized,
              false,
            )
          )
        }
      }
    }
  }

  fun bindType(
    pos: PosRange,
    tcenv: mutable TCEnv,
    kind: BindKind,
    type: ?Type,
    value: ?Expr,
  ): (TType, Bool) {
    value match {
    | None() ->
      if (kind is BKConst()) {
        tcenv.error(
          Array[(pos, "A 'const' declaration must be initialized")],
          TSCode(1155),
        );
      };
      type match {
      | None() ->
        fatalError(
          Array[
            (
              pos,
              "A binding must have either a type annotation or an initializer",
            ),
          ],
          SKJSCode(2030),
        )
      | Some(annotAst) ->
        ty = this.normalize(tcenv, annotAst);
        (ty, false)
      }
    | Some(e) ->
      ty = this.expr(tcenv, e, kind is BKConst());
      // Wrap null/undefined initializers in a bound TVar so the variable
      // can be widened later (e.g., `let x = null; x = 1`).
      // We only do this here (not in expr) to avoid sealing container TVars
      // when null/undefined is passed as an argument (e.g., `x.push(null)`).
      !ty = e.value match {
      | Var(Name(_, "null")) if (type is None()) ->
        this.makeBoundTVar(tcenv, ty, FromNullLiteral(e.pos))
      | Var(Name(_, "undefined")) if (type is None()) ->
        this.makeBoundTVar(tcenv, ty, FromUndefinedLiteral(e.pos))
      | _ -> ty
      };
      type match {
      | None() -> (ty, true)
      | Some(annotAst) ->
        annot = this.normalize(tcenv, annotAst);
        this.checkSubType(
          tcenv,
          annotAst.pos,
          "Type of value is not assignable to the variable's type annotation",
          ty,
          annot,
          TSCode(2322),
        );
        (annot, true)
      }
    }
  }

  /* Typechecks expression  obj.fieldName
             or expression  obj?.fieldName
       where obj has type objType */
  fun dot(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    fieldName: Name,
    accessKind: AccessKind,
  ): TType {
    idx = Expr(fieldName.pos, EString(fieldName.value));
    this.get(tcenv, pos, objType, idx, accessKind)
  }

  // Returns the access modifier declared on the enclosing class for the
  // named field, or FAPublic if there is no enclosing class or the class
  // does not declare a field by that name. Used when growing `this`
  // inside a class so synthesized fields inherit the class's access.
  fun lookupEnclosingFieldAccess(
    tcenv: mutable TCEnv,
    fieldName: String,
  ): FieldAccess {
    this.enclosingClass match {
    | None() -> FAPublic()
    | Some(className) ->
      cls = this.getClass(tcenv, className);
      classFields = this.getClassFields(tcenv.context, cls);
      result: FieldAccess = FAPublic();
      for (classField in classFields) {
        classField match {
        | ClassFieldValue{
          name => FNNormal(Name(_, n)),
          modifiers,
        } if (n == fieldName) ->
          for (modifier in modifiers.modifiers) {
            modifier match {
            | ModPrivate _ -> !result = FAPrivate(className)
            | _ -> void
            }
          };
          break void
        | _ -> void
        }
      };
      result
    }
  }

  // Reports an error if `field` is private and the current enclosing
  // class is not the field's owner. Public fields are always allowed.
  fun checkFieldAccess(
    tcenv: mutable TCEnv,
    field: TField,
    accessPos: PosRange,
  ): void {
    field.access match {
    | FAPublic() -> void
    | FAPrivate(owner) ->
      this.enclosingClass match {
      | Some(
        enc,
      ) if (
        enc.value == owner.value &&
        enc.pos.fileName == owner.pos.fileName
      ) ->
        void
      | _ ->
        tcenv.error(
          Array[
            (
              accessPos,
              `Property '${TypePp::escapeName(
                field.name.value,
              )}' is private and only accessible within class '${owner}'`,
            ),
            (field.pos, "Declared here"),
          ],
          TSCode(2341),
        )
      }
    | FANever() ->
      tcenv.error(
        Array[
          (
            accessPos,
            `Property '${TypePp::escapeName(
              field.name.value,
            )}' has incompatible private declarations across the union and is not accessible`,
          ),
          (field.pos, "Declared here"),
        ],
        TSCode(2341),
      )
    | FAPhantom(inPos) ->
      tcenv.error(
        Array[
          (
            accessPos,
            `Property '${TypePp::escapeName(
              field.name.value,
            )}' was confirmed present by \`in\` but its declaration is unknown — accessing it is unsafe (it could be private)`,
          ),
          (inPos, "Presence checked here"),
        ],
        SKJSCode(2058),
      )
    }
  }

  /* Typechecks expression  obj[idx]
             or expression  obj.idx
             or expression  obj?.idx
     where obj has type objType

     Try to keep in synch with TEnv#keyOfType
  */
  // Synthesize the type of `.call` / `.apply` / `.bind` accessed on a function
  // value, deriving it from the underlying call signature `f`:
  //   f.call(thisArg, ...params) => R
  //   f.apply(thisArg, [params]) => R
  //   f.bind(thisArg)            => (the function with its `this` removed)
  // `.bind`'s result is `OmitThisParameter<f>` — just `f` with `thisParam`
  // cleared. `.call`/`.bind` carry the function's optional and rest parameters;
  // `.apply` models only required positional params (its argument tuple is
  // exact). Returns None (so the access falls through to "Unbound field") for
  // generic call signatures — which TS resolves to `unknown` through these
  // methods — rather than diverge. Partial-application `.bind(thisArg, ...args)`
  // is not modeled yet.
  fun maybeFunctionMethod(
    tcenv: mutable TCEnv,
    obj: TObject,
    fieldName: String,
    pos: PosRange,
  ): ?TType {
    if (fieldName != "call" && fieldName != "apply" && fieldName != "bind") {
      return None()
    };
    tfuns = obj.maybeGetCall(tcenv.subst, this) match {
    | Some(tf) -> tf
    | None() -> return None()
    };
    f = tfuns.fun_;
    // A generic call signature loses its type parameters through .call/.apply/
    // .bind in TS (they resolve to `unknown`), so rather than diverge we leave
    // those as "Unbound field" — a sound under-approximation.
    if (!f.tparams.isEmpty()) return None();
    // A shape method's carrier type is erased, so no sound thisArg check is
    // possible for a rebind — do not synthesize .call/.apply/.bind on it
    // (a sound under-approximation: the fields stay unbound).
    if (f.thisParam is ImplicitShape _) return None();
    // The thisArg of `.call`/`.apply`/`.bind` is checked against the function's
    // `this`: an implicit class `this` requires the receiver to be the class
    // instance (sound; TS resolves it to `unknown`), an explicit `this: T`
    // constrains to T, and no declared `this` accepts anything.
    thisType = f.thisParam.tyOpt().default(TType::top(pos));
    funType = (tfun: TFun) ->
      TType::single(TObject::createCall(TFuns::singleFun(tfun, pos)));
    synthOpt: ?TFun = if (fieldName == "call") {
      // (thisArg, ...params) => R — mirrors the function's optional/rest params.
      Some(
        TFun(
          Array[],
          NoThis(),
          Array[thisType].concat(f.params),
          f.optionalParams,
          f.spreadParam,
          f.retType,
          f.cgNodes,
        ),
      )
    } else if (fieldName == "apply") {
      // (thisArg, [params]) => R. The argument tuple is exact, so only required
      // positional parameters are modeled; fall back otherwise.
      if (!f.optionalParams.isEmpty() || f.spreadParam.isSome()) {
        None()
      } else {
        argsTuple = TType::tuple(pos, f.params, true);
        Some(
          TFun(
            Array[],
            NoThis(),
            Array[thisType, argsTuple],
            Array[],
            None(),
            f.retType,
            f.cgNodes,
          ),
        )
      }
    } else {
      // bind(thisArg) => the function with its `this` removed, preserving the
      // remaining (incl. optional/rest) parameters.
      bound = f with {thisParam => NoThis()};
      boundTy = funType(bound);
      Some(
        TFun(
          Array[],
          NoThis(),
          Array[thisType],
          Array[],
          None(),
          boundTy,
          f.cgNodes,
        ),
      )
    };
    synthOpt.map(synth -> funType(synth))
  }

  fun get(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    idx: Expr,
    accessKind: AccessKind,
  ): TType {
    this.getWithIndexType(
      tcenv,
      pos,
      objType,
      this.expr(tcenv, idx, true),
      idx.pos,
      accessKind,
    )
  }

  /* Like `get`, but for callers that have already typechecked the index
     expression. Reusing the precomputed `idxType` avoids a redundant second
     typecheck of the same expression. */
  fun getWithIndexType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    idxType: TType,
    idxPos: PosRange,
    accessKind: AccessKind,
  ): TType {
    idxSType = idxType
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(ty @ TPrimValue(TString(), _, _))
    | Some(ty @ TPrimValue(TNum(), _, _))
    | Some(ty @ TPrimValue(TSymbol(), _, _)) ->
      ty
    | _ ->
      fatalError(
        Array[(idxPos, "This type cannot be used as an index")],
        TSCode(2538),
      )
    };
    objType2 = ArrayLitTyping::refineForArrayUse(
      tcenv,
      this,
      objType,
      idxSType,
    );
    stypes = objType2.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> Vector::mcreateFromItems(stypes)
    | _ ->
      fatalError(
        Array[
          (
            pos,
            `Cannot access a property on type ${this.ppType(tcenv, objType2)}`,
          ),
        ],
        TSCode(2339),
      )
    };
    isOptionalChaining = accessKind is AKOptionalChain _;
    isLValue = accessKind is AKLValue _;
    optionalChainingIsUseless = isOptionalChaining;
    optionalChainingIsAlwaysUndefined = isOptionalChaining;

    (addResultCase, getResult) = {
      (init, add) = if (isLValue) (TType::top, TType::inter) else {
        (TType::bottom, TType::union)
      };
      result = init(pos);
      (ty -> !result = add(tcenv.subst, this, result, ty), () -> result)
    };

    while (!stypes.isEmpty()) {
      stype = stypes.pop();

      optionalChainingIsAlwaysUndefinedForThisSType = false;
      stype match {
      | obj @ TObject(_, _, objectPos) ->
        // Tuple-shaped TObjects inherit a read-only number-index signature
        // from ReadonlyArray, so `tup[5]` on a 3-tuple silently returns the
        // element union via that signature. Catch literal out-of-bound
        // indices here, before field lookup, with the same precise message
        // the TTuple arm emits.
        obj.isTuple().each(arity -> {
          idxSType match {
          | TPrimValue(TNum(), Some(numbers), _) ->
            numbers.singleElt().flatMap(lit -> lit.val.toIntOption()) match {
            | Some(n) if (n < 0 || n >= arity) ->
              tcenv.error(
                Array[(pos, "Tuple index is out of bounds")],
                TSCode(2493),
              )
            | _ -> void
            }
          | _ -> void
          }
        });
        if (idxSType is TPrimValue(TSymbol(), _, _)) {
          // Symbols mirror the string/number path below: a specific unique
          // symbol is a literal key (it names exactly one declared symbol
          // field, else falls back to the symbol index), while a general
          // `symbol` is a non-literal key that could name ANY symbol-keyed
          // property — so it resolves through the symbol index AND unions/
          // intersects every declared symbol field (read: union getters;
          // write: intersect setters).
          idxSType.literals match {
          | None() -> Some(idxSType)
          | Some(lits) ->
            lits
              .filterLiterals(symLit ->
                obj.maybeGetSymbol(tcenv.subst, this, symLit.val) match {
                | Some(fd) ->
                  this.checkFieldAccess(tcenv, fd, symLit.pos);
                  addResultCase(
                    TFields::resolveFieldType(
                      tcenv.subst,
                      this,
                      fd,
                      symLit.pos,
                      isLValue,
                    ),
                  );
                  false
                | None() -> true
                }
              )
              .map(remainingLits ->
                idxSType with {literals => Some(remainingLits)}
              )
          } match {
          | None() -> void
          | Some(remainingIdxSType) ->
            obj.maybeGetAccessibleIndexForKeyKind(
              tcenv.subst,
              this,
              TSymbol(),
            ) match {
            | None() ->
              // Unique symbols naming no declared field, or a general symbol,
              // with no symbol index to resolve through.
              if (remainingIdxSType.literals.isNone()) {
                fatalError(
                  Array[
                    (
                      pos,
                      "Cannot index this type with a non-literal key: it has no index signature",
                    ),
                    (idxPos, "Index has non-literal type symbol"),
                    (objectPos, "But object has no index field"),
                  ],
                  TSCode(7053),
                )
              } else {
                fatalError(
                  Array[
                    (pos, "This symbol property does not exist on the object"),
                  ],
                  TSCode(2339),
                )
              }
            | Some(index) ->
              ty = if (isLValue) index.set else {
                TType::unionUndefined(tcenv.subst, this, index.get, pos)
              };
              addResultCase(ty);
              // A general symbol may also name any declared symbol field.
              if (remainingIdxSType.literals.isNone()) {
                for (symFd in obj.namedFieldsForKeyKind(TSymbol())) {
                  addResultCase(
                    TFields::resolveFieldType(
                      tcenv.subst,
                      this,
                      symFd,
                      idxPos,
                      isLValue,
                    ),
                  )
                }
              }
            }
          }
        } else {
          idxSType.literals match {
          | None() -> Some(idxSType)
          | Some(lits) ->
            // Keys present in some branches but not all: collected here and
            // reported once below, rather than once per literal.
            partials: mutable Vector<String> = mutable Vector[];
            remaining = lits.filterLiterals(fieldLit ->
              obj.resolveLiteralAccess(tcenv.subst, this, fieldLit.val) match {
              | Some((fd, allBranches)) ->
                if (allBranches) {
                  this.checkFieldAccess(tcenv, fd, fieldLit.pos)
                } else {
                  partials.push(fieldLit.val)
                };
                addResultCase(
                  TFields::resolveFieldType(
                    tcenv.subst,
                    this,
                    fd,
                    fieldLit.pos,
                    isLValue,
                  ),
                );
                false
              // Not a declared field: synthesize .call/.apply/.bind on a
              // function-typed receiver (read-only access).
              | None() if (!isLValue) ->
                this.maybeFunctionMethod(
                  tcenv,
                  obj,
                  fieldLit.val,
                  fieldLit.pos,
                ) match {
                | Some(methodTy) ->
                  addResultCase(methodTy);
                  false
                | None() -> true
                }
              // Present in no branch: keep it for the not-found path below
              // (its index was already consulted per branch above).
              | None() -> true
              }
            );
            // Flag a partially-present access (the key may be absent at runtime)
            // but recover with the merged field's type rather than bailing (#716).
            if (!partials.isEmpty()) {
              keys = partials.map(k -> `'${k}'`).join(", ");
              plural = partials.size() > 1;
              tcenv.error(
                Array[
                  (
                    idxPos,
                    `Propert${if (plural) "ies" else "y"} ${keys} exist${if (
                      plural
                    ) "" else {
                      "s"
                    }} on some but not all members of the union type, so ${if (
                      plural
                    ) "they" else {
                      "it"
                    }} may be absent`,
                  ),
                ],
                TSCode(2339),
              )
            };
            remaining.map(remainingLits ->
              idxSType with {literals => Some(remainingLits)}
            )
          } match {
          | None() -> void
          | Some(remainingIdxSType) ->
            matchedIndex = obj.maybeGetAccessibleIndexForKeyKind(
              tcenv.subst,
              this,
              remainingIdxSType.kind,
            );
            // If string literal access fails on a number index, retry as
            // number for keys a number could produce (e.g. obj["0"] or
            // obj["Infinity"] on { [x: number]: T }).
            if (matchedIndex.isNone()) {
              !matchedIndex = remainingIdxSType match {
              | TPrimValue(
                TString(),
                Some(lits),
                _,
              ) if (lits.values().all(lit -> isJSNumberKeyName(lit.val))) ->
                // TODO: when both indexes exist, we should split the remainingIdxSType into the numeric and non-numeric parts
                obj.maybeGetAccessibleIndexForKeyKind(tcenv.subst, this, TNum())
              | _ -> None()
              }
            };
            if (matchedIndex.isNone() && obj.hasAccessibleIndex()) {
              // Object has indexes but not for this key kind. The access is
              // fundamentally invalid; we can't substitute an unrelated-kind
              // index value without manufacturing a cascade of dependent
              // errors (e.g. "Invalid call" from calling a number) — so bail
              // here instead of continuing.
              fatalError(
                Array[
                  (
                    pos,
                    `This index key is not assignable to the index signature: expected '${obj.accessibleIndexKeyKindsString()}', got '${
                      remainingIdxSType.kind
                    }'`,
                  ),
                ],
                TSCode(2345),
              )
            };
            matchedIndex match {
            | None() ->
              remainingIdxSType.literals match {
              | None() ->
                fatalError(
                  Array[
                    (
                      pos,
                      "Cannot index this type with a non-literal key: it has no index signature",
                    ),
                    (
                      idxPos,
                      `Index has non-literal type '${remainingIdxSType.kind}'`,
                    ),
                    (objectPos, "But object has no index field"),
                  ],
                  TSCode(7053),
                )
              | Some(lits) -> obj.getTypeTypingError(lits.toStringList(), pos)
              }
            | Some(index) ->
              ty = if (isLValue) index.set else {
                TType::unionUndefined(tcenv.subst, this, index.get, pos)
              };
              addResultCase(ty);
              // A general (non-literal) key may resolve to a declared field at
              // runtime, not just the index signature, so both directions must
              // account for the declared fields it could hit:
              //   - read: union their getter types, since the result could be
              //     any of them (e.g. reading `{ a: number; [k: string]:
              //     boolean }` with a string key yields `boolean | number`, not
              //     just `boolean`).
              //   - write: intersect their setter types (addResultCase combines
              //     with `inter` for lvalues), since the assigned value must be
              //     valid for whichever field the key turns out to name (writing
              //     to that same object requires `number & boolean`, i.e. the
              //     write is rejected — `k` could be "a").
              // For valid TypeScript these fields are subsumed by the index
              // value type (TS2411), so this changes nothing. It applies only to
              // non-literal keys: specific literals that reach here were already
              // checked against the declared fields and found absent, so they
              // only hit the index.
              if (remainingIdxSType.literals.isNone()) {
                for (namedFd in obj.namedFieldsForKeyKind(
                  remainingIdxSType.kind,
                )) {
                  addResultCase(
                    TFields::resolveFieldType(
                      tcenv.subst,
                      this,
                      namedFd,
                      idxPos,
                      isLValue,
                    ),
                  )
                }
              }
            }
          }
        }
      | prim @ TPrimValue _ ->
        obj = this.newObject(tcenv.subst, prim.asClassName(), Array[]);
        stypes.push(obj)

      | TPrimUnit(TUndefined(), undefPos)
      | TPrimUnit(
        TNull(),
        undefPos,
      ) if (isOptionalChaining) ->
        !optionalChainingIsUseless = false;
        !optionalChainingIsAlwaysUndefinedForThisSType = true;
        invariant(!isLValue);
        addResultCase(TType::single(TPrimUnit(TUndefined(), undefPos)))

      | _ ->
        fatalError(
          Array[
            (pos, "Property access is not allowed on this type"),
            (
              idxType.pos,
              "This has type " + this.ppType(tcenv, TType::single(stype)),
            ),
          ],
          TSCode(2339),
        )
      };
      !optionalChainingIsAlwaysUndefined =
        optionalChainingIsAlwaysUndefined &&
        optionalChainingIsAlwaysUndefinedForThisSType;
    };
    if (optionalChainingIsUseless) {
      tcenv.warning(
        Array[
          (
            pos,
            "This '?.' is unnecessary; the value is never nullish, so use '.' instead",
          ),
          (
            objType.pos,
            `${this.ppType(tcenv, objType)} is never null nor undefined`,
          ),
        ],
        ESLintCode("@typescript-eslint/no-unnecessary-condition"),
      )
    };
    if (optionalChainingIsAlwaysUndefined) {
      tcenv.warning(
        Array[
          (pos, "The result of this optional chain is always 'undefined'"),
          (
            objType.pos,
            `${this.ppType(tcenv, objType)} is always null or undefined`,
          ),
        ],
        ESLintCode("@typescript-eslint/no-unnecessary-condition"),
      )
    };
    getResult()
  }

  fun exprWithoutNullish(
    pos: PosRange,
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
    nonNullAssertion: Bool,
  ): (Bool, TType) {
    ty = this.expr(tcenv, e, mostPrecise);
    hasTop = false;
    hasVoid = false;
    hasNullOrUndefined = false;
    hasOthers = false;
    tyWithoutNullish = ty.mapSTypes(
      tcenv.subst,
      this,
      Some(Covariant()),
      stypesOpt ->
        stypesOpt match {
        | None() ->
          !hasTop = true;
          stypesOpt
        | Some(stypes) ->
          Some(
            stypes.filterSTypes(stype -> {
              stype match {
              | TPrimUnit(TNull(), _)
              | TPrimUnit(TUndefined(), _) ->
                !hasNullOrUndefined = true;
                return false
              | TPrimUnit(TVoid(), _) -> !hasVoid = true
              | _ -> !hasOthers = true
              };
              true
            }),
          )
        }
      ,
    );
    isValid = true;
    if (hasVoid) {
      !isValid = false;
      // Using a `void`-typed value here (`??`/`!` operand) is a hygiene lint,
      // not a soundness error: it is runtime-sound and tsc permits it. Report a
      // warning. `isValid` stays false so the follow-on null-strip check is
      // still suppressed.
      tcenv.warning(
        Array[
          (pos, "An expression of type 'void' cannot be used here"),
          (e.pos, `This expression has type ${this.ppType(tcenv, ty)}`),
        ],
        ESLintCode("@typescript-eslint/no-confusing-void-expression"),
      )
    } else if (!hasTop && !hasNullOrUndefined) {
      !isValid = false;
      tcenv.warning(
        Array[
          (
            pos,
            "This operator has no effect; the operand is never null or undefined",
          ),
          (e.pos, "This expression is never null or undefined"),
        ],
        ESLintCode("@typescript-eslint/no-unnecessary-condition"),
      );
    } else if (!hasTop && !hasOthers) {
      !isValid = false;
      // For `??` this is a harmless dead operator (the result is the right
      // operand), so it stays a warning. For a non-null assertion it is
      // unsound — `x!` would have the empty type and so satisfy any annotation
      // — so it must be a hard error.
      messages = Array[
        (
          pos,
          "This operator has no effect; the operand is always null or undefined",
        ),
        (e.pos, "This expression is always null or undefined"),
      ];
      eslintCode = ESLintCode("@typescript-eslint/no-unnecessary-condition");
      if (nonNullAssertion) {
        tcenv.error(messages, eslintCode)
      } else {
        tcenv.warning(messages, eslintCode)
      }
    };
    (isValid, tyWithoutNullish)
  }

  fun nonVoidExpr(
    pos: PosRange,
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
  ): TType {
    ty = this.expr(tcenv, e, mostPrecise);
    if (this.nonTopContainsVoid(tcenv, ty)) {
      // Same hygiene lint as in `exprWithoutNullish`: a `void`-typed operand of
      // `===`/`typeof` is runtime-sound and tsc-permissive, so it warns.
      tcenv.warning(
        Array[
          (pos, "An expression of type 'void' cannot be used here"),
          (e.pos, `This expression has type ${this.ppType(tcenv, ty)}`),
        ],
        ESLintCode("@typescript-eslint/no-confusing-void-expression"),
      )
    };
    ty
  }

  // Strict-comparison overlap diagnostic: warn when the operands' value sets
  // are provably disjoint, i.e. the comparison always has the same outcome.
  // Both operands expand to their simple-type branches and the comparison is
  // flagged when no branch pair can overlap. getSTypes over-approximates the
  // operand types, so disjoint branch sets soundly imply disjoint types;
  // types that expand to Top (unknown, unconstrained type parameters) bail
  // out, and constrained type parameters are checked through their
  // constraint.
  private fun checkComparisonOverlap(
    tcenv: mutable TCEnv,
    pos: PosRange,
    op_: BOStrictComparison,
    e1: Expr,
    e2: Expr,
    ty1: TType,
    ty2: TType,
  ): void {
    // Clone subst: this is a diagnostic check ("always false/true?"), not a
    // type assignment. It should not grow type variables.
    subst = tcenv.subst.clone();
    ty1.getSTypes(subst, this, Covariant()) match {
    | Some(stypes1) if (!stypes1.isEmpty()) ->
      ty2.getSTypes(subst, this, Covariant()) match {
      | Some(stypes2) if (!stypes2.isEmpty()) ->
        // A void operand is already an error (nonVoidExpr — void is
        // non-observable): skip the lint instead of piling a warning on top
        isVoid = (sty: SType) -> sty is TPrimUnit(TVoid(), _);
        if (stypes1.any(isVoid) || stypes2.any(isVoid)) {
          return void
        };
        overlap = stypes1.any(sty1 ->
          stypes2.any(sty2 -> SType::overlaps(subst, this, sty1, sty2))
        );
        if (!overlap) {
          // Two spellings of a beyond-precision number literal can denote
          // the same runtime double (9007199254740993 === 9007199254740992
          // is always true; 1e309 and 2e309 are both Infinity), so a
          // textual non-overlap proves nothing there: stay silent.
          if (
            this.hasImpreciseNumberLiteral(stypes1) ||
            this.hasImpreciseNumberLiteral(stypes2)
          ) {
            return void
          };
          alwaysResult = op_ match {
          | BOStrictEquality() -> "false"
          | BOStrictInequality() -> "true"
          };
          tcenv.warning(
            Array[
              (
                pos,
                `This comparison is always ${alwaysResult} because the operand types do not overlap`,
              ),
            ],
            SKJSCode(2040),
          )
        } else if (
          // Comparing against a literal is exempt: re-checking a narrowed
          // discriminant (e.g. `else if (color.kind === "blue")` on the
          // last variant of a union) is idiomatic, not a bug.
          !e1.isLiteral() &&
          !e2.isLiteral() &&
          this.isSameSingletonValue(stypes1, stypes2)
        ) {
          alwaysResult = op_ match {
          | BOStrictEquality() -> "true"
          | BOStrictInequality() -> "false"
          };
          tcenv.warning(
            Array[
              (
                pos,
                `This comparison is always ${alwaysResult} because the operands always hold the same single value`,
              ),
            ],
            SKJSCode(2074),
          )
        }
      | _ -> void
      }
    | _ -> void
    }
  }

  // Whether any number literal in these types is beyond IEEE-754 double
  // precision (see SKJS.isPreciseJSNumberLiteral).
  private fun hasImpreciseNumberLiteral(stypes: STypes): Bool {
    stypes.any(sty ->
      sty match {
      | TPrimValue(TNum(), Some(lits), _) ->
        lits.values().any(lit -> !isPreciseJSNumberLiteral(lit.val))
      | _ -> false
      }
    )
  }

  // Whether both operand types are the same singleton value type (a single
  // literal, null, or undefined), making strict equality always true. Sound
  // under over-approximation: a singleton over-approximation bounds the
  // operand to at most that one value.
  private fun isSameSingletonValue(stypes1: STypes, stypes2: STypes): Bool {
    (stypes1.singleElt(), stypes2.singleElt()) match {
    | (Some(sty1), Some(sty2)) ->
      (sty1, sty2) match {
      | (TPrimUnit(TNull(), _), TPrimUnit(TNull(), _))
      | (TPrimUnit(TUndefined(), _), TPrimUnit(TUndefined(), _)) ->
        true
      | (
        TPrimValue(kind1, Some(lits1), _),
        TPrimValue(kind2, Some(lits2), _),
      ) ->
        kind1 == kind2 &&
          ((lits1.singleElt(), lits2.singleElt()) match {
          | (Some(lit1), Some(lit2)) -> lit1.val == lit2.val
          | _ -> false
          })
      | _ -> false
      }
    | _ -> false
    }
  }

  private fun showTypes(
    tcenv: mutable TCEnv,
    args: Array<Expr>,
    expand: Bool,
    pos: PosRange,
  ): TType {
    if (!args.isEmpty()) {
      subst = tcenv.subst.clone();
      exprTy = this.expr(tcenv, args[0], true);
      max_depth = 10;
      actual = if (expand) {
        // Resolve single tvar to raw binding (without constraint intersection)
        // to avoid e.g. [string, number] & readonly unknown[] -> never.
        ty = exprTy.getSingleVar().flatMap(tvar -> subst.peekRaw(tvar)) match {
        | Some(rawBinding) -> rawBinding.expand(subst, this, Some(Covariant()))
        | None() -> exprTy.expand(subst, this, Some(Covariant()))
        };
        prettyPrintType(false, ty, subst, this, max_depth)
      } else {
        rawPrettyPrint(
          false,
          pp -> pp.type(0, Margin{max_depth}, exprTy),
          subst.values,
          this.verbose,
        )
      };
      print_error(actual);
      if (args.size() >= 2) {
        expectedTy = this.expr(tcenv, args[1], true);
        expectedTy.getConstantString() match {
        | Some(expected) ->
          if (actual != expected.val) {
            tcenv.error(
              Array[
                (
                  args[0].pos,
                  `__SKJS_show: expected ${expected.val}, got ${actual}`,
                ),
              ],
              SKJSCode(2059),
            )
          }
        | None() ->
          tcenv.error(
            Array[
              (
                args[1].pos,
                "__SKJS_show: second argument must be a string literal",
              ),
            ],
            SKJSCode(2059),
          )
        }
      };
      if (args.size() > 2) {
        tcenv.error(
          Array[(args[2].pos, "__SKJS_show: expected at most 2 arguments")],
          SKJSCode(2059),
        )
      }
    };
    TType::single(TPrimUnit(TVoid(), pos))
  }

  /* Typechecks expression e
     If mostPrecise, use the most precise type. */
  fun expr(
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
    isLValue: Bool = false,
  ): TType {
    key = (e.pos, mostPrecise, isLValue);
    tcenv.exprTypes.maybeGet(key) match {
    | Some(_ty) ->
      internal_error(
        "already type checked expression " +
          inspect(e).toString() +
          " @ " +
          e.pos.fileName.toString(),
      )
    | None() ->
      ty = this.exprImpl(tcenv, e, mostPrecise, isLValue);
      tcenv.!exprTypes[key] = ty;
      ty
    };
  }

  fun lookupExprType(tcenv: mutable TCEnv, e: Expr): TType {
    tcenv.exprTypes.maybeGet((e.pos, true, false)) match {
    | Some(ty) -> ty
    | None() ->
      tcenv.exprTypes.maybeGet((e.pos, false, false)) match {
      | Some(ty) -> ty
      // Not yet typechecked -- can't lookup.
      // Currently treating this as a loud internal failure, but could equally
      // fall back to actually typechecking here instead (making this essentially a
      // memoization table)
      | None() ->
        internal_error(
          "expresssion " +
            inspect(e).toString() +
            " @ " +
            e.pos.fileName.toString() +
            " not yet typechecked",
        )
      }
    }
  }
  private fun exprImpl(
    tcenv: mutable TCEnv,
    e: Expr,
    mostPrecise: Bool,
    isLValue: Bool,
  ): TType {
    if (mostPrecise) {
      if (isLValue) {
        tcenv.error(
          Array[
            (
              e.pos,
              "Internal error: expr call with both mostPrecise and isLValue",
            ),
          ],
          SKJSCode(9999),
        )
      };
      this.asConstExpr(tcenv, e) match {
      | Some(ty) -> return ty
      | None() -> void
      }
    };

    pos = e.pos;
    e.value match {
    | Number(_) -> TType::single(TPrimValue::number(pos))
    | BigInt(_) -> TType::single(TPrimValue::bigint(pos))
    | EString(_) -> TType::single(TPrimValue::string(pos))
    | TemplateLiteral(_parts, exprs) ->
      // Type check all embedded expressions - allow primitive types that can be converted to strings
      strType = TType::single(TPrimValue::string(pos));
      for (expr in exprs) {
        ety = this.expr(tcenv, expr, true);
        this.checkStringifiable(tcenv, expr.pos, ety);
      };
      strType

    | Var(Name(_, "true"))
    | Var(Name(_, "false")) ->
      TType::single(TPrimValue::boolean(pos))
    | Var(Name(_, "null")) -> TType::single(TPrimUnit(TNull(), pos))
    | Var(Name(_, "undefined")) -> TType::single(TPrimUnit(TUndefined(), pos))
    | Var(local) ->
      // Transition local objects to LOUsed state when read/referenced.
      // Once used, the type is frozen - no more fields can be added.
      // This ensures soundness: code that observed the object with N fields
      // won't be invalidated by later additions.
      tcenv.markLocalObjectUsed(local);
      tcenv.scope.maybeGet(local) match {
      | None() ->
        defs = this.defMap.getAll(tcenv, local);
        sawInterface = false;
        sawTypeAlias = false;
        for (def in defs) {
          def match {
          | fd @ TopLevelFunDef _ ->
            tFuns = this.funDecl(tcenv, None(), fd, fd.cgNode.fromSome());
            break TType::single(TObject::createCall(tFuns))
          | Class{kind => CKInterface()} -> !sawInterface = true
          | TypeDef _ -> !sawTypeAlias = true
          | c @ Class _ ->
            staticClass = this.newStatic(tcenv.subst, c.name);
            break staticClass
          | en @ Enum _ -> break this.enumStatic(tcenv, en)
          // EnumMemberDef is only synthesized in type position, never
          // returned by a value-position (typeOnly=false) lookup.
          | EnumMemberDef _ -> void
          | FDVar(kind, name, type, value) ->
            if (!(kind is VDKConst _)) {
              tcenv.error(
                Array[
                  (
                    name.pos,
                    "Only 'const' members are supported in this position by SKJS",
                  ),
                ],
                SKJSCode(2073),
              );
            };
            break type match {
            | None() ->
              value.flatMap(e -> this.asConstExpr(tcenv, e)) match {
              | None() -> this.newTVar(tcenv, pos, FromUntypedVar(pos))
              | Some(ty) -> ty
              }
            | Some(ty) ->
              this.normalize(tcenv, ty, kind is VDKConst _, Some(name.value))
            }
          }
        } else {
          if (sawInterface) {
            interfaceAsValueError(tcenv, local);
            // Continue as if the interface name were a value.
            this.newStatic(tcenv.subst, local)
          } else if (sawTypeAlias) {
            typeAliasAsValueError(local)
          } else {
            fatalError(Array[(pos, "Cannot find name")], TSCode(2304))
          }
        }
      | Some(localDef) -> localDef
      }
    | Object(efields) ->
      // Worklist of prospective result branches. Starts with one empty branch;
      // spreading a union-typed source fans it out (one branch per source
      // member), so most literals keep a single state.
      states = mutable Vector[ObjectSpreadState::empty];
      for (efield in efields) {
        // When Some, the field's value is routed through a growable field type
        // variable so a precise inferred type can widen to a non-literal
        // declared field type under the invariant subtyping a mutable field
        // requires (see the FDNormal arm). The wrap happens per worklist state:
        // each distributed branch must get its OWN tvar, or checking the branch
        // against one member of a union target would grow a shared tvar and
        // poison the other members' checks.
        growableFieldOrigin: ?TVarOrigin = None();
        (name, ty) = efield match {
        | FDNormal(name, y) ->
          ttype = this.expr(tcenv, y, true);
          // A field value is routed through a growable field type variable so
          // a precise inferred type can widen to a non-literal declared field
          // type under the invariant subtyping a mutable field requires. This
          // already covers object and primitive values; a function literal
          // (`{ fn: () => "x" }`) needs the same treatment so its literal
          // return type can widen to e.g. `() => string`, and an async arrow
          // (`{ fn: async () => "x" }`, parsed as `Async(Closure)`) likewise
          // so its `() => Promise<'x'>` widens to `() => Promise<string>`.
          //
          // Two facts make this safe. Soundness: the object literal is fresh,
          // so no alias holds the field at the narrower type and it may grow
          // to the declared type at the assignment. No lost inference: a field
          // position does not pin a type parameter (a primitive field does not
          // either) — which is the difference from a function passed directly
          // as a generic callback argument, whose return type does drive
          // type-parameter inference and so must keep its precise type (e.g.
          // `p.then(n => n.toString())`, `p.catch(() => 0)`).
          //
          // A plain variable reference needs it too: its type may have been
          // narrowed below the declared field type (`let r: List<T>` narrowed
          // to the non-null branch, then `{ head: x, tail: r }`), and a
          // function value referenced by name is no different from one written
          // inline. The freshness argument above does NOT carry over — the
          // variable is a live alias of the stored object — but growth is
          // still sound because it never replaces the field's type: Subst::grow
          // unions the bounds, so the variable's type remains a lower bound
          // that is checked against the declared field type with the full
          // invariant-interior subtyping. Only the fresh slot's own setter
          // obligation is discharged; the slot admits no interior write the
          // alias's own type does not already permit (pinned by
          // tests/expect-error/obj-literal-var-field-growth.ts).
          // Two variables must NOT grow, though:
          //   - a tracked local object, whose own precise binding stays
          //     observable: growing the field would widen the view of it that
          //     the container hands out, and a write through that view would
          //     corrupt the narrower type the local is still read at (see
          //     tests/expect-error/obj-literal-indexes.ts).
          //   - one that already stands for a type variable, which would be
          //     wrapped twice: the inner variable then grows to the outer
          //     one's bound and loses the literal it was solved to (#520, see
          //     tests/expect-error/tvar-widening-in-constraint-check.ts).
          if (
            y.value is Object _ ||
            y.value is Closure _ ||
            y.value is Async(Expr(_, Closure _)) ||
            (y.value match {
            | Var(n) ->
              tcenv.localObjectState(n).isNone() &&
                ttype.getSingleVar().isNone()
            | _ -> false
            }) ||
            ttype.isConcretePrimitive()
          ) {
            !growableFieldOrigin = Some(FromObjectField(y.pos))
          };
          (name, ttype)

        | FDSpread(spreadExpr) ->
          spreadTy = this.expr(tcenv, spreadExpr, mostPrecise);
          // Collect the source branches to distribute over. `{ ...(A | B) }`
          // is `(spread A) | (spread B)`: each object arm contributes its
          // TObject branches. A union arm that is a primitive spreading to a
          // no-op — any primitive EXCEPT a string (whose indexed characters
          // WOULD be copied, e.g. `{...'ab'}` is `{0:'a',1:'b'}`) and void
          // (which must never be observed) — contributes the accumulated
          // state UNCHANGED (the "spread did not fire" branch), which makes
          // the fields the object arms add optional in the distributed
          // union (the `cond && { x: T }` idiom, whose type is
          // `false | { x: T }`). A void or string arm, or any
          // non-object/non-primitive stype, makes the whole spread invalid.
          sourceBranches = mutable Vector<TFields>[];
          sawNoopPrimitive = false;
          sawInvalid = spreadTy.getSTypes(
            tcenv.subst,
            this,
            Covariant(),
          ) match {
          | None() -> true
          | Some(sTypes) ->
            invalid = false;
            for (stype in sTypes.values()) {
              stype match {
              | obj @ TObject _ -> sourceBranches.extend(obj.getBranches())
              | TPrimUnit(TVoid(), _)
              | TPrimValue(TString(), _, _) ->
                !invalid = true
              | TPrimValue _
              | TPrimUnit _ ->
                !sawNoopPrimitive = true
              }
            };
            invalid
          };
          if (sawInvalid || sourceBranches.isEmpty()) {
            tcenv.error(
              Array[
                (spreadExpr.pos, "Only an object type can be spread here"),
                (spreadTy.pos, `This has type ${this.ppType(tcenv, spreadTy)}`),
              ],
              SKJSCode(2038),
            );
            continue
          };
          // Sound spread typing (per source branch, in
          // ObjectSpreadState::merge): a non-optional source field wins;
          // otherwise keep the existing optionality and union the get type
          // with the source's contribution (optional field / covering index
          // / Top); values are read via getters.
          this.checkSpreadPrivacy(
            tcenv,
            spreadExpr.pos,
            sourceBranches,
            branch -> branch.fields,
            "field",
          );
          this.checkSpreadPrivacy(
            tcenv,
            spreadExpr.pos,
            sourceBranches,
            branch -> branch.symbolFields,
            "symbol field",
          );
          // Cross-product the worklist with the source branches, deduplicating
          // structurally-identical results at push time so converging spreads
          // (e.g. `{ ...x, ...x }`, or a final spread whose branches override
          // every discriminating field) count only DISTINCT branches toward
          // the cap. If the deduplicated distributed union would still exceed
          // the cap, stop distributing THIS spread and degrade (below).
          newStates = mutable Vector[];
          seenByHash = mutable Map<Int, mutable Vector<ObjectSpreadState>>[];
          overflow = false;
          // Dedup a candidate branch and push it; returns true if that pushed
          // the deduplicated worklist past the branch cap.
          pushState = candidate -> {
            bucket = seenByHash.getOrAdd(candidate.xxhash().value, () ->
              mutable Vector[]
            );
            if (bucket.all(seen -> !seen.dedupEquals(candidate))) {
              bucket.push(candidate);
              newStates.push(candidate);
              newStates.size() > kMaxObjectBranches
            } else {
              false
            }
          };
          for (state in states) {
            for (branch in sourceBranches) {
              if (
                pushState(
                  ObjectSpreadState::merge(
                    tcenv.subst,
                    this,
                    state,
                    branch,
                    spreadExpr.pos,
                  ),
                )
              ) {
                !overflow = true;
                break void
              }
            };
            if (overflow) break void;
            // The "spread did not fire" branch: a no-op primitive arm leaves
            // the accumulated state unchanged, so the object arms' fields
            // become optional in the union.
            if (sawNoopPrimitive && pushState(state)) {
              !overflow = true;
              break void
            }
          };
          if (overflow) {
            // The deduplicated cross-product would exceed kMaxObjectBranches.
            // Collapse the whole worklist to a SINGLE fully open object: an
            // arbitrary source (the empty TFields) drops every field name and
            // widens every value to `unknown` — covered by the resulting
            // `[string]/[symbol]: unknown` excess indexes — so all the per-state
            // results are supertyped by this one open object. Collapsing to size
            // 1 (rather than mapping every state) keeps any further union spreads
            // in the same literal bounded, instead of re-materializing ~cap
            // states each time (which drives peak memory up). A fully open object
            // is a supertype of every distributed branch (any object inhabits it)
            // and of the unchanged no-op-primitive state, so this stays sound —
            // a fresh literal's value inhabits it by its getters; it is only
            // imprecise, so warn rather than reject. A more precise collapse that
            // keeps fields common to every source branch is a possible follow-up
            // (SkipLabs/skjs#747).
            tcenv.warning(
              Array[
                (
                  spreadExpr.pos,
                  "This object spread distributes over more than " +
                    kMaxObjectBranches +
                    " union branches; its type is over-approximated to an open " +
                    "object, so some properties are typed 'unknown'",
                ),
              ],
              SKJSCode(9009),
            );
            !states = mutable Vector[
              ObjectSpreadState::merge(
                tcenv.subst,
                this,
                ObjectSpreadState::empty,
                TFields::empty(),
                spreadExpr.pos,
              ),
            ]
          } else {
            !states = newStates
          };
          // The source's call/construct signatures are dropped: object spread
          // copies only own enumerable properties, and a call/construct
          // signature is not one. The merged result never carries them (an
          // object literal populates no call/new), so there is nothing to do —
          // matching TypeScript and JavaScript.
          continue
        | FDComputed(keyExpr, valueExpr) ->
          keyType = this.expr(tcenv, keyExpr, true);
          valueTy = this.expr(tcenv, valueExpr, mostPrecise);
          keyType
            .getSTypes(tcenv.subst, this, Covariant())
            .flatMap(stypes -> stypes.singleElt())
            .flatMap(stype -> FieldKey::ofSType(keyExpr.pos, stype)) match {
          | Some(FKName(name, _)) -> (name, valueTy)
          | Some(FKSymbol(_, uniqueId)) ->
            field = TField::create{
              pos => keyExpr.pos,
              name => uniqueId,
              isOptional => false,
              isReadonly => None(),
              type => valueTy,
              access => FAPublic(),
            };
            for (i in Range(0, states.size())) {
              states![i] = states[i].withSymbolField(field)
            };
            continue
          | None() ->
            tcenv.error(
              Array[
                (
                  keyExpr.pos,
                  "A computed property key must be a literal or a 'unique symbol'",
                ),
              ],
              TSCode(1170),
            );
            continue
          }
        | fd @ FDMethod{name => FNNormal(name)} ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          tFuns = this.funDecl(tcenv, None(), fd, cgNode);
          (name, TType::single(TObject::createCall(tFuns)))
        };
        for (i in Range(0, states.size())) {
          fieldTy = growableFieldOrigin match {
          | Some(origin) -> this.makeBoundTVarForField(tcenv, ty, origin)
          | None() -> ty
          };
          field = TField::create{
            pos => name.pos,
            name => name.value,
            isOptional => false,
            isReadonly => None(),
            type => fieldTy,
            access => FAPublic(),
          };
          states![i] = states[i].withField(field)
        }
      };
      // Build one object branch per accumulated state (each adds its synthetic
      // indexes in toTFields): a single branch for a literal with no union
      // spread, otherwise the distributed union.
      branches = mutable Vector<TFields>[];
      for (state in states) {
        branches.push(state.toTFields(tcenv.subst, pos))
      };
      obj = TType::single(
        if (branches.size() == 1) {
          TObject::createSingleBranch(branches[0], None(), pos)
        } else {
          TObject::createFromBranches(branches, pos)
        },
      );
      for (efield in efields) {
        efield match {
        | fd @ FDMethod _ ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          this.funDef(tcenv.subst, Some((CKClass(), obj)), fd, cgNode)
        | _ -> void
        }
      };
      obj
    | Call(Expr(_, Var(Name(superPos, "super"))), targs, args) ->
      this.super match {
      | None() ->
        tcenv.error(
          Array[
            (superPos, "'super' can only be referenced inside a derived class"),
          ],
          TSCode(2335),
        )
      | Some((superCstr, super)) ->
        if (targs.size() != 0) {
          tcenv.error(
            Array[(pos, "'super' cannot be called with type arguments")],
            SKJSCode(2071),
          );
        };
        this.callConstructor(tcenv, pos, superCstr, args);
        thisName = Name(pos, "this");
        thisType = TType::inter(
          tcenv.subst,
          this,
          tcenv.scope.get(thisName),
          super,
        );
        tcenv.scope.set(thisName, thisType, (x, y) -> {
          this.checkSubType(
            tcenv,
            pos,
            "Arguments are not assignable to the base constructor's parameters",
            x,
            y,
            TSCode(2345),
          )
        })
      };
      TType::single(TPrimUnit(TVoid(), pos))

    | Call(Expr(_, Var(Name(_, "__SKJS_show"))), _, args) ->
      this.showTypes(tcenv, args, false, pos)
    | Call(Expr(_, Var(Name(_, "__SKJS_show_expanded"))), _, args) ->
      this.showTypes(tcenv, args, true, pos)
    | Call(f, targs, args) ->
      tcenv.markForInImpure(pos);
      normTargs = targs.map(ty -> this.normalize(tcenv, ty));
      // Resolve a callable value and invoke it with the given receiver.
      dispatchCall = (fty: TType, thisArgOpt: ?TType) -> {
        calleeObj = fty
          .getSTypes(tcenv.subst, this, Covariant())
          .flatMap(stypes ->
            stypes.singleElt() match {
            | Some(obj @ TObject _) -> Some(obj)
            | _ -> None()
            }
          );
        (calleeMode, calleePartialSig) = calleeObj
          .map(obj -> obj.callMode(tcenv.subst, this))
          .default((CUnknown(), None()));
        tfuns = calleeMode match {
        | CPresent(tf) -> tf
        | _ ->
          // Pick the honest detail: a constructible value or a Function-typed
          // value IS a function at runtime — what fails is the missing `new`
          // or the unknown signature, not function-ness.
          provablyConstructible = calleeObj.map(obj ->
            obj.newMode(tcenv.subst, this).i0
          ) match {
          | Some(CPresent _)
          | Some(CFunction()) ->
            true
          | _ -> false
          };
          detail = if (provablyConstructible) {
            `Type ${this.ppType(
              tcenv,
              fty,
            )} is constructable: did you mean to include 'new'?`
          } else if (calleeMode == CFunction()) {
            // Every branch proves [[Call]] either way; the phrasing follows
            // what the printed type shows. All-CFunction branches render
            // callable (Function and its extensions), so "is callable" reads
            // right; a mixed join means some arm prints as a plain object (a
            // typeof-narrowed union arm), where "is callable" would look
            // wrong to the reader — hedge with "may". All-CFunction is
            // exactly a CFunction mode with no partial signature.
            selfEvident = calleePartialSig is None();
            if (selfEvident) {
              `Type ${this.ppType(
                tcenv,
                fty,
              )} is callable, but its signature is unknown`
            } else {
              `Type ${this.ppType(
                tcenv,
                fty,
              )} may be callable, but its signature is unknown`
            }
          } else {
            `Type ${this.ppType(tcenv, fty)} is not a function`
          };
          errorArgs = Array[
            (pos, "This expression is not callable"),
            (fty.pos, detail),
          ];
          // Recovery typing: when some arms do offer a call signature, report
          // the (sound) error non-fatally and continue at their union — the
          // type tsc infers after (unsoundly) dropping the signature-less
          // arms — so the rest of the definition still gets checked.
          calleePartialSig match {
          | Some(partial) ->
            tcenv.error(errorArgs, TSCode(2349));
            partial
          | None() -> fatalError(errorArgs, TSCode(2349))
          }
        };
        this.call(tcenv, pos, tfuns, normTargs, args, mostPrecise, thisArgOpt)
      };
      // When the callee is `e1.field` / `e1[idx]`, capture the receiver so the
      // method's `this` is checked against it. For a (non-optional) union
      // receiver, distribute the call over each branch — each branch's method is
      // checked against that branch — since folding the union would intersect the
      // branch `this` types into a receiver no single branch satisfies. Optional
      // chaining (`?.`) is NOT distributed: its `undefined`/`void` branch is
      // short-circuited, not a real call receiver.
      // The receiver and index are each type-checked exactly once (the
      // exprTypes registry forbids re-checking); each branch resolves the
      // member from the precomputed index type.
      callViaReceiver = (
        e1: Expr,
        distribute: Bool,
        idx: Expr,
        getPos: PosRange,
        accessKind: AccessKind,
      ) -> {
        e1Ty = this.expr(tcenv, e1, mostPrecise);
        idxTy = this.expr(tcenv, idx, true);
        resolve = (recv: TType) ->
          this.getWithIndexType(
            tcenv,
            getPos,
            recv,
            idxTy,
            idx.pos,
            accessKind,
          );
        e1Ty.getSTypes(tcenv.subst, this, Covariant()) match {
        | Some(stypes) if (distribute && stypes.size() > 1) ->
          TType::unionN(
            tcenv.subst,
            this,
            pos,
            stypes.collect(Array).map(stype -> {
              branchTy = TType::single(stype);
              dispatchCall(resolve(branchTy), Some(branchTy))
            }),
          )
        | _ -> dispatchCall(resolve(e1Ty), Some(e1Ty))
        }
      };
      rty = f.value match {
      | Dot(dotKind, e1, fieldName) ->
        accessKind = dotKind match {
        | OptionalDot() -> AKOptionalChain()
        | NormalDot() -> AKNormal()
        };
        callViaReceiver(
          e1,
          dotKind is NormalDot _,
          Expr(fieldName.pos, EString(fieldName.value)),
          e1.pos,
          accessKind,
        )
      | Get(e1, idx) -> callViaReceiver(e1, true, idx, f.pos, AKNormal())
      | _ -> dispatchCall(this.expr(tcenv, f, mostPrecise), None())
      };
      f.value match {
      | Dot(
        NormalDot(),
        Expr(_, Var(Name(_, "console"))),
        Name(_, "assert"),
      ) if (args.size() >= 1) ->
        this.evalCond(tcenv, args[0], true)
      | _ -> void
      };
      rty
    | New(subExpr, targsAst, args) ->
      tcenv.markForInImpure(pos);
      tArgs = targsAst.map(targ -> this.normalize(tcenv, targ));
      classNameOpt = subExpr.value match {
      | Var(className) if (tcenv.scope.maybeGet(className) is None()) ->
        // Classify the definitions of `className` in a single pass.
        hasInterface = false;
        hasValue = false;
        hasClass = false;
        for (def in this.defMap.getAll(tcenv, className)) {
          def match {
          | Class{kind => CKInterface()} -> !hasInterface = true
          | Class _ ->
            !hasClass = true;
            !hasValue = true
          | TypeDef _ -> void
          | _ -> !hasValue = true
          }
        };
        if (hasInterface && !hasValue) {
          // A type-only interface used as a value: report TS2693 and continue
          // as if it were instantiable.
          interfaceAsValueError(tcenv, className);
          Some(className)
        } else if (!hasInterface && hasClass) {
          // A class uses the fast (type-space) constructor path.
          Some(className)
        } else {
          // A merged interface+value, or a value-only binding (e.g. a
          // `declare const` whose type has a construct signature): resolve
          // through the expression path below.
          None()
        }
      | _ -> None()
      };
      classNameOpt match {
      | Some(className) ->
        // Resolve once: the tparams (for the implicit type arguments), the
        // constructor, and the instance all come from the same class.
        c = this.getClass(tcenv.subst, className);
        if (targsAst.size() == 0) {
          !tArgs = this.makeTArgsOf(tcenv.subst, c, className)
        };
        cstr = this.newConstructorOf(tcenv.subst, c, className, tArgs);
        this.callConstructor(tcenv, pos, cstr, args);
        this.newOf(tcenv.subst, c, className, tArgs)
      | None() ->
        subExprTy = this.expr(tcenv, subExpr, mostPrecise);
        subExprTy.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ->
          stypes.singleElt()
        ) match {
        | Some(obj @ TObject _) ->
          obj.maybeGetNew(tcenv.subst, this) match {
          | Some(f) ->
            this.call(tcenv, pos, f, tArgs, args, mostPrecise, None())
          | None() ->
            fatalError(
              Array[
                (pos, "This expression is not constructable"),
                (
                  obj.pos,
                  `${this.ppType(tcenv, subExprTy)} has no constructor`,
                ),
              ],
              TSCode(2351),
            )
          }
        | _ ->
          fatalError(
            Array[
              (pos, "This expression is not constructable"),
              (
                subExprTy.pos,
                `${this.ppType(tcenv, subExprTy)} is not an object`,
              ),
            ],
            TSCode(2351),
          )
        }
      }

    | Get(arr, idx) ->
      objOrArray = this.expr(tcenv, arr, mostPrecise);
      accessKind = if (isLValue) AKLValue() else AKNormal();
      this.get(tcenv, pos, objOrArray, idx, accessKind)

    // We always interpret `[]` as an array, not a tuple.
    // Because an empty tuple is not very meaningful.
    | EArray(arr) if (arr.size() == 0) ->
      tvar = this.newTVar(tcenv, pos, FromEmptyArray(pos));
      TType::inst(Name(pos, "Array"), TArgs(Array[tvar]))

    | EArray(arr) ->
      hasSpread = arr.any(x -> x.value is Spread _);
      if (hasSpread) {
        eltType = TType::bottom(pos);
        for (x in arr) {
          xEltTy = x.value match {
          | Spread(spreadExpr) ->
            spreadTy = this.expr(tcenv, spreadExpr, true);
            this.getValueType(tcenv, x.pos, spreadTy, "spread")
          | _ -> this.expr(tcenv, x, mostPrecise)
          };
          !eltType = TType::union(tcenv.subst, this, eltType, xEltTy)
        };
        TType::inst(Name(pos, "Array"), TArgs(Array[eltType]))
      } else {
        ArrayLitTyping::typeFromLiteral(
          tcenv,
          pos,
          arr.map(x -> {
            ty = this.expr(tcenv, x, mostPrecise);
            if (x.value is Object _ || ty.isConcretePrimitive()) {
              this.makeBoundTVarForLiteralCommitment(
                tcenv,
                ty,
                FromArrayElement(x.pos),
              )
            } else {
              ty
            }
          }),
          // Under mostPrecise the element types are already precise, so fresh
          // literal tracking would be redundant.
          arr.map(x -> if (mostPrecise) None() else this.freshLiteralType(x)),
        )
      }

    | Unop(uop, subExpr) ->
      ty = this.expr(tcenv, subExpr, true);
      uop match {
      | UOExclamationMark() ->
        this.checkCondition(
          tcenv,
          pos,
          ty,
          "Operand of '!' must be of type 'boolean'",
        );
        TType::single(TPrimValue::boolean(pos))
      | nuop @ NumericUnaryOperator() ->
        invalid = false;
        plusOnBigInt = false;
        res = ty.mapSTypes(tcenv.subst, this, Some(Covariant()), stypesOpt ->
          stypesOpt match {
          | None() ->
            !invalid = true;
            stypesOpt
          | Some(stypes) ->
            Some(
              stypes.mapSTypes(stype ->
                stype match {
                | TPrimValue(k @ TNum(), _, primPos) ->
                  TPrimValue(k, None(), primPos)
                | TPrimValue(k @ TBigInt(), _, primPos) ->
                  // Unary '+' performs ToNumber, which throws on a bigint at
                  // runtime; '-' and '~' stay valid on bigints. Widened even
                  // in the error case: the headline below prints the widened
                  // operand type, matching tsc's TS2736 template.
                  if (nuop is UOPlus()) {
                    !plusOnBigInt = true;
                  };
                  TPrimValue(k, None(), primPos)
                | TPrimValue(k, Some _, primPos) ->
                  // Invalid for the operator, but still widened so the
                  // TS2736 headline below names base types like tsc
                  // ('a' | bigint reads 'bigint | string').
                  !invalid = true;
                  TPrimValue(k, None(), primPos)
                | _ ->
                  !invalid = true;
                  stype
                }
              ),
            )
          }
        );
        if (plusOnBigInt) {
          // tsc's TS2736 names the operand type with every literal member
          // widened to its base type; res is exactly that. The detail line
          // keeps the precise operand type.
          fatalError(
            Array[
              (
                pos,
                `Operator '+' cannot be applied to type ${this.ppType(
                  tcenv,
                  res,
                )}`,
              ),
              (subExpr.pos, `This has type ${this.ppType(tcenv, ty)}`),
            ],
            TSCode(2736),
          )
        };
        if (invalid) {
          fatalError(
            Array[
              (pos, `Unary operator '${nuop}' cannot be applied to this type`),
              (subExpr.pos, `This has type ${this.ppType(tcenv, ty)}`),
            ],
            SKJSCode(2039),
          )
        };
        res
      }

    | Dot(dotKind, e1, fieldName) ->
      accessKind = (isLValue, dotKind) match {
      | (true, OptionalDot()) ->
        tcenv.notSupported(pos, "optional dot in L-value");
        AKLValue()
      | (true, NormalDot()) -> AKLValue()
      | (false, OptionalDot()) -> AKOptionalChain()
      | (false, NormalDot()) -> AKNormal()
      };
      this.dot(
        tcenv,
        e1.pos,
        this.expr(tcenv, e1, mostPrecise),
        fieldName,
        accessKind,
      )

    | Binop(op, e1, e2) ->
      op match {
      | BOAddition() ->
        ty1 = this.expr(tcenv, e1, true);
        ty1.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
          stypes.singleElt()
        ) match {
        | Some(TPrimValue(k @ TNum(), _, primPos))
        | Some(TPrimValue(k @ TString(), _, primPos))
        | Some(TPrimValue(k @ TBigInt(), _, primPos)) ->
          ty2 = this.expr(tcenv, e2, true);
          res = TType::single(TPrimValue::full(k, primPos));
          this.checkSubType(
            tcenv,
            e2.pos,
            "Right operand of '+' is not assignable to the left operand's type",
            ty2,
            res,
            TSCode(2365),
          );
          res
        | _ ->
          fatalError(
            Array[
              (pos, "Operator '+' cannot be applied to these types"),
              (e1.pos, `For an object of type: ${this.ppType(tcenv, ty1)}`),
            ],
            TSCode(2365),
          )
        }
      | BOAssignment() ->
        tcenv.markForInImpure(pos);
        ty = this.assign(tcenv, pos, e1, e2, mostPrecise);
        // Record the assignment target's type. The `Var` and local-object
        // field-write branches of `assign` never typecheck `e1` themselves, so
        // this is the only place their lvalue type is recorded (the CFG builder
        // looks it up by `(e1.pos, _, true)`). A plain map write, not an
        // `expr` call, so it doesn't count as a second typecheck.
        tcenv.!exprTypes[(e1.pos, mostPrecise, true)] = ty;
        ty
      | op_ @ BOStrictComparison() ->
        ty1 = this.nonVoidExpr(pos, tcenv, e1, true);
        ty2 = this.nonVoidExpr(pos, tcenv, e2, true);
        this.checkComparisonOverlap(tcenv, pos, op_, e1, e2, ty1, ty2);
        TType::single(TPrimValue::boolean(pos))

      | op_ @ LazyLogicalOperator() ->
        (opStr, continuationTarget) = op_ match {
        | BOLogicalAnd() -> ("&&", true)
        | BOLogicalOr() -> ("||", false)
        };
        ty1 = this.expr(tcenv, e1, true);
        // The left operand is truthiness-tested, so it is checked per the
        // truthiness mode.
        this.checkCondition(
          tcenv,
          pos,
          ty1,
          `Operand of '${opStr}' must be of type 'boolean'`,
        );
        savedScope = tcenv.scope;
        branch2 = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = branch2;
        this.evalCond(tcenv, e1, continuationTarget);
        ty2 = this.expr(tcenv, e2, true);
        tcenv.!scope = savedScope;
        tcenv.popScope(this, branch2);
        // In `boolean` mode the operator must produce a boolean, so the right
        // operand is required to be boolean too. In the relaxed/javascript modes
        // `&&`/`||` are value-returning, so the right operand's value flows
        // through unchecked.
        this.truthiness match {
        | TBoolean() ->
          this.checkCondition(
            tcenv,
            e2.pos,
            ty2,
            `Operand of '${opStr}' must be of type 'boolean'`,
          )
        | TRelaxed()
        | TJavaScript() ->
          void
        };
        // Value-returning per JavaScript: when the right operand is not taken,
        // the result is the left operand's non-continuation part — `a`'s falsy
        // part for `&&` (continuationTarget true) and truthy part for `||`
        // (continuationTarget false), with value precision (`s && b` is
        // `"" | typeof b`, as in tsc). Boolean operands normalize back to
        // `boolean`.
        e1Part = ty1.truthinessValuePart(
          tcenv.subst,
          this,
          !continuationTarget,
        );
        TType::union(tcenv.subst, this, e1Part, ty2)

      | BOLessThan()
      | BOLessThanOrEqual()
      | BOGreaterThan()
      | BOGreaterThanOrEqual() ->
        getExprPrimKind = (e) -> {
          ty = this.expr(tcenv, e, true);
          ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
            stypes.singleElt()
          ) match {
          | Some(TPrimValue(k, _, _)) -> Some(k)
          | _ ->
            tcenv.error(
              Array[
                (
                  pos,
                  "A comparison operand must be a string, number, bigint, or boolean",
                ),
                (e1.pos, `This has type ${this.ppType(tcenv, ty)}`),
              ],
              SKJSCode(2070),
            );
            None()
          }
        };
        kind1 = getExprPrimKind(e1);
        kind2 = getExprPrimKind(e2);
        (kind1, kind2) match {
        | (Some(k1), Some(k2)) if (k1 != k2) ->
          tcenv.error(
            Array[
              (pos, "Both operands of a comparison must have the same type"),
              (e1.pos, `This has type '${k1}'`),
              (e2.pos, `This has type '${k2}'`),
            ],
            SKJSCode(2070),
          )
        | _ -> void
        };
        TType::single(TPrimValue::boolean(pos))

      | BOOpAssignment(assOp) ->
        this.expr(
          tcenv,
          Expr(pos, Binop(BOAssignment(), e1, Expr(pos, Binop(assOp, e1, e2)))),
          mostPrecise,
        )

      | BOExponentiation()
      | BOMultiplication()
      | BODivision()
      | BORemainder()
      | BOSubtraction()
      | BOBitwiseAnd()
      | BOBitwiseOr()
      | BOBitwiseXor()
      | BOLeftShift()
      | BOSignedRightShift()
      | BOZeroFilledRightShift() ->
        ty1 = this.expr(tcenv, e1, true);
        kind1 = this.checkIsNumeric(
          tcenv,
          e1.pos,
          "This operator requires a numeric operand",
          ty1,
        );
        ty2 = this.expr(tcenv, e2, true);
        kind2 = this.checkIsNumeric(
          tcenv,
          e2.pos,
          "This operator requires a numeric operand",
          ty2,
        );
        if (kind1 != kind2) {
          fatalError(
            Array[
              (
                pos,
                "Arithmetic operations require both operands to be the same numeric type",
              ),
              (e1.pos, `Left operand is ${kind1}`),
              (e2.pos, `Right operand is ${kind2}`),
            ],
            TSCode(2365),
          )
        };
        TType::single(TPrimValue::full(kind1, pos))

      | BONullishCoalescing() ->
        (_isValid, ty1WithoutNullish) = this.exprWithoutNullish(
          pos,
          tcenv,
          e1,
          mostPrecise,
          false,
        );
        ty2 = this.expr(tcenv, e2, mostPrecise);
        TType::union(tcenv.subst, this, ty1WithoutNullish, ty2)
      }

    | InstanceOf(e1, e2) ->
      _ = this.expr(tcenv, e1, true);
      // The RHS must be a value that is constructable or callable (a class,
      // function, or other Function-like value). A type-only interface used
      // here is already reported as TS2693 by typechecking it as a value.
      rhsTy = this.expr(tcenv, e2, true);
      if (!this.isInstanceofRhs(tcenv, rhsTy)) {
        tcenv.error(
          Array[
            (
              e2.pos,
              "The right-hand side of an 'instanceof' expression must be either of type 'any', a class, function, or other type assignable to the 'Function' interface type, or an object type with a 'Symbol.hasInstance' method.",
            ),
          ],
          TSCode(2359),
        )
      };
      TType::single(TPrimValue::boolean(pos))
    | In(e1, e2) ->
      t1 = this.expr(tcenv, e1, true);
      (fieldsOpt, symFieldsOpt) = this.inLhsFieldsFromType(
        tcenv,
        pos,
        e1.pos,
        t1,
      );
      t2 = this.expr(tcenv, e2, true);
      t2.getSTypes(tcenv.subst, this, Covariant()) match {
      | None() ->
        tcenv.error(
          Array[
            (
              pos,
              "The right-hand side of an 'in' expression must be an object",
            ),
            (e2.pos, "This has type 'unknown'"),
          ],
          TSCode(2361),
        )
      | Some(stypes2) ->
        canBeTrue = false;
        canBeFalse = false;
        for (stype2 in stypes2) {
          stype2 match {
          | TPrimUnit _
          | TPrimValue _ ->
            tcenv.error(
              Array[
                (
                  pos,
                  "The right-hand side of an 'in' expression must be an object",
                ),
                (e2.pos, `This has type ${this.ppType(tcenv, t2)}`),
              ],
              TSCode(2361),
            );
            !canBeTrue = true;
            !canBeFalse = true
          | obj @ TObject(_, _, _pos) ->
            // Object types are open under width subtyping, so an unnamed key
            // may exist at runtime and `true` stays reachable — UNLESS the
            // key is provably absent: not a named field and covered by a
            // never-valued index (e.g. Closed<T>), which states no such key
            // can hold a value. Unknown key sets (both None) and broad keys
            // stay conservatively reachable.
            !canBeTrue =
              canBeTrue ||
              (fieldsOpt.isNone() && symFieldsOpt.isNone()) ||
              obj.getBranches().any(branchFields -> {
                (fields, symbolFields) = branchFields match {
                | TFields{fields, symbolFields} -> (fields, symbolFields)
                };
                (fieldsOpt match {
                | None() -> false
                | Some(None()) ->
                  true // broad type, could be any key
                | Some(Some(fieldsToCheck)) ->
                  fieldsToCheck.values().any(fieldToCheck ->
                    fields
                      .maybeGet(FieldNameString(fieldToCheck.val))
                      .isSome() ||
                      branchFields.indexForFieldName(fieldToCheck.val) match {
                      | Some(idx) -> !idx.get.isBottom()
                      | None() ->
                        true // open: the key may exist at runtime
                      }
                  )
                }) ||
                  (symFieldsOpt match {
                  | None() -> false
                  | Some(None()) ->
                    true // broad symbol, could be any key
                  | Some(Some(symFieldsToCheck)) ->
                    symFieldsToCheck.values().any(symToCheck ->
                      symbolFields
                        .maybeGet(FieldNameString(symToCheck.val))
                        .isSome() ||
                        branchFields.symbolIndex match {
                        | Some(idx) -> !idx.get.isBottom()
                        | None() ->
                          true // open: the key may exist at runtime
                        }
                    )
                  })
              });
            // `k in (A | B)` can be false when some branch can lack k — k is
            // absent or optional in that branch. A shared index contributes
            // conservatively, the same way it did on a single object (the
            // all-branches index matches the old branch-merge). TODO: refine.
            !canBeFalse =
              canBeFalse ||
              obj.hasAccessibleIndex() ||
              obj.getBranches().any(branchFields -> {
                (fields, symbolFields) = branchFields match {
                | TFields{fields, symbolFields} -> (fields, symbolFields)
                };
                (fieldsOpt match {
                | None() ->
                  false // no field keys to check
                | Some(None()) ->
                  true // broad type, could be any key
                | Some(Some(fieldsToCheck)) ->
                  fieldsToCheck.values().any(fieldToCheck ->
                    fields.maybeGet(FieldNameString(fieldToCheck.val)) match {
                    | Some(tField) -> tField.isOptional
                    | None() -> true
                    }
                  )
                }) ||
                  (symFieldsOpt match {
                  | None() ->
                    false // no symbol keys to check
                  | Some(None()) ->
                    true // broad symbol, could be any key
                  | Some(Some(symFieldsToCheck)) ->
                    symFieldsToCheck.values().any(symToCheck ->
                      symbolFields.maybeGet(
                        FieldNameString(symToCheck.val),
                      ) match {
                      | Some(tField) -> tField.isOptional
                      | None() -> true
                      }
                    )
                  })
              })
          }
        };
        (canBeTrue, canBeFalse) match {
        | (true, true) -> void
        | (false, false) ->
          tcenv.error(
            Array[
              (
                pos,
                "This 'in' check can never succeed for these operand types",
              ),
              (e1.pos, `This has type ${this.ppType(tcenv, t1)}`),
              (e2.pos, `This has type ${this.ppType(tcenv, t2)}`),
            ],
            SKJSCode(2049),
          )
        | _ ->
          // The `in` result is statically known (always true or always false),
          // but the expression is well-typed and evaluating it is sound — this
          // is the `no-unnecessary-condition` lint rule, so report it as a
          // warning (matching the other sites for that rule) rather than a
          // build-failing error. (The `(false, false)` arm above stays an error:
          // it signals contradictory operand types, not a redundant condition.)
          tcenv.warning(
            Array[(pos, `This condition is always ${canBeTrue}`)],
            ESLintCode("@typescript-eslint/no-unnecessary-condition"),
          )
        }
      };
      TType::single(TPrimValue::boolean(pos))
    | TypeOf(subExpr) ->
      _ = this.nonVoidExpr(pos, tcenv, subExpr, true);
      TType::single(TPrimValue::string(pos))
    | VoidOp(subExpr) ->
      _ = this.expr(tcenv, subExpr, true);
      TType::single(TPrimUnit(TUndefined(), pos))

    | PostOp(pop, subExpr) ->
      pop match {
      | PODecr()
      | POIncr() ->
        num = TType::single(TPrimValue::number(pos));
        ty = this.expr(tcenv, subExpr, true);
        this.checkSubType(
          tcenv,
          pos,
          "The operand of an increment or decrement operator must be of type 'number'",
          ty,
          num,
          TSCode(2356),
        );
        num
      | POExcl() ->
        (isValid, tyWithoutNullish) = this.exprWithoutNullish(
          pos,
          tcenv,
          subExpr,
          mostPrecise,
          true,
        );
        if (isValid) {
          // Check if this is a for-in v[k]! pattern
          forInMatch = tcenv.getForInContext().flatMap(ctx -> {
            subExpr.value match {
            | Get(
              objExpr,
              Expr(_, Var(keyName)),
            ) if (
              keyName.value == ctx.keyVar &&
              ForInContext::exprToKey(objExpr) == Some(ctx.iterableKey)
            ) ->
              Some(ctx)
            | _ -> None()
            }
          });
          forInMatch match {
          | Some(ForInContext{impureCall => None()}) ->
            // Safe: v[k]! at beginning of for-in loop — allow it
            void
          | Some(ctx @ ForInContext{impureCall => Some(callPos)}) ->
            // Unsafe: v[k]! after side effects in for-in loop
            tcenv.error(
              Array[
                (
                  pos,
                  "The non-null assertion operator '!' is not allowed here",
                ),
                (callPos, "This call could have modified the collection"),
                (
                  subExpr.pos,
                  `Move this to the beginning of the for-in loop, e.g.: const value = ${ctx.iterableKey
                    .collect(Array)
                    .join(".")}[${ctx.keyVar}]!`,
                ),
              ],
              ESLintCode("@typescript-eslint/no-non-null-assertion"),
            )
          | None() ->
            // Not a for-in pattern — original error
            tcenv.error(
              Array[
                (pos, "The non-null assertion operator '!' is not allowed"),
                (
                  subExpr.pos,
                  "This assertion is unsound and may cause runtime errors",
                ),
              ],
              ESLintCode("@typescript-eslint/no-non-null-assertion"),
            )
          }
        };
        tyWithoutNullish
      }

    | c @ Closure(tparams, params, retTypeAstOpt, body) ->
      this.anonFunction(
        tcenv,
        None(),
        pos,
        c,
        tparams,
        params,
        retTypeAstOpt,
        body,
      )
    | Async(
      Expr(closurePos, c @ Closure(tparams, params, retTypeAstOpt, body)),
    ) ->
      this.anonFunction(
        tcenv,
        Some(pos),
        closurePos,
        c,
        tparams,
        params,
        retTypeAstOpt,
        body,
      )
    | As(subExpr, tyAst) ->
      annot = this.normalize(tcenv, tyAst);
      inferredTy = this.expr(tcenv, subExpr, true);
      this.checkSubType(
        tcenv,
        pos,
        "This 'as' cast is unsound: the source type is not assignable to the target type",
        inferredTy,
        annot,
        SKJSCode(2003),
      );
      annot
    | Satisfies(subExpr, tyAst) ->
      annot = this.normalize(tcenv, tyAst);
      inferredTy = this.expr(tcenv, subExpr, true);
      savedSubst = tcenv.subst.save();
      this.checkSubType(
        tcenv,
        pos,
        "Type does not satisfy the expected type",
        inferredTy,
        annot,
        TSCode(1360),
      );
      tcenv.subst.restore(savedSubst);
      inferredTy
    | Async _ ->
      fatalError(
        Array[(pos, "'async' is not allowed in this position")],
        SKJSCode(2043),
      )
    | Await(ae) ->
      aeType = this.expr(tcenv, ae, mostPrecise);
      // Unwrap the thenable branches and pass the non-thenable parts
      // through unchanged, like the runtime does (and like tsc types it).
      // Non-thenable parts are an error, but a non-fatal one as long as at
      // least one branch is a thenable: checking continues with the
      // combined result type.
      resultTys = mutable Vector[];
      hasThenable = false;
      hasNonThenable = false;
      aeType.getSTypes(tcenv.subst, this, Covariant()) match {
      | None() -> !hasNonThenable = true
      | Some(stypes) ->
        for (stype in stypes) {
          stype match {
          | obj @ TObject _ ->
            branches = obj.getBranches();
            for (fields in branches) {
              fields.getAwaitedType(tcenv.subst, this, pos) match {
              | Some(ty) ->
                !hasThenable = true;
                ty.maybeAwaited(tcenv.subst, this, pos) match {
                | Some(awaited) -> resultTys.push(awaited)
                | None() ->
                  // Continue with an unconstrained type: the unflattened
                  // type would re-trigger TS1062 at every later use.
                  this.errorSelfReferentialThenable(tcenv, pos);
                  resultTys.push(TType::top(pos))
                }
              | None() ->
                !hasNonThenable = true;
                passedThrough = if (branches.size() == 1) {
                  obj
                } else {
                  TObject::createSingleBranch(fields, None(), obj.pos)
                };
                resultTys.push(TType::single(passedThrough))
              }
            }
          | _ ->
            !hasNonThenable = true;
            resultTys.push(TType::single(stype))
          }
        }
      };
      if (!hasThenable) {
        // `await` of a non-thenable yields the value itself (the runtime and
        // tsc pass it through), so this is a lint concern (`await-thenable`,
        // where SKJS is deliberately stricter than tsc), not a soundness error.
        // Warn and recover with the operand type.
        tcenv.warning(
          Array[
            (pos, "'await' can only be applied to a Promise"),
            (aeType.pos, "This is not a promise"),
          ],
          ESLintCode("@typescript-eslint/await-thenable"),
        );
        aeType
      } else {
        if (hasNonThenable) {
          tcenv.warning(
            Array[
              (pos, "'await' can only be applied to a Promise"),
              (aeType.pos, "This is not always a promise"),
            ],
            ESLintCode("@typescript-eslint/await-thenable"),
          )
        };
        TType::unionN(tcenv.subst, this, pos, resultTys)
      }
    | EIf(e1, e2, e3) ->
      cond = this.expr(tcenv, e1, true);
      this.checkCondition(
        tcenv,
        e1.pos,
        cond,
        "A ternary condition must be of type 'boolean'",
      );

      // Create scopes for the true and false branches with type refinements
      scopeCopy = tcenv.scope;

      // True branch - evaluate e2 with refinements from e1 being true
      trueScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = trueScope;
      this.evalCond(tcenv, e1, true);
      left = this.expr(tcenv, e2, mostPrecise);
      tcenv.!scope = scopeCopy;

      // False branch - evaluate e3 with refinements from e1 being false
      falseScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = falseScope;
      this.evalCond(tcenv, e1, false);
      right = this.expr(tcenv, e3, mostPrecise);
      tcenv.!scope = scopeCopy;

      TType::union(tcenv.subst, this, left, right)
    | AsConst(subExpr) ->
      this.asConstExpr(tcenv, subExpr) match {
      | Some(ty) -> ty
      | None() ->
        subExpr.value match {
        // `[e0, e1, ...] as const` is a readonly tuple of the elements' const
        // types. asConstExpr stays pure (it does not type-check the elements),
        // so the tuple is built here. Spread elements are not yet supported and
        // fall through to the TS1355 arm below.
        | EArray(elts) if (elts.all(x -> !(x.value is Spread _))) ->
          this.constArrayLit(tcenv, subExpr.pos, elts)
        | _ ->
          tcenv.error(
            Array[
              (
                pos,
                "A 'const' assertion can only be applied to a string, number, boolean, array, or object literal",
              ),
            ],
            TSCode(1355),
          );
          this.expr(tcenv, subExpr, true)
        }
      }
    | Params _ -> paramsError(pos)
    | Regexp _ ->
      fatalError(
        Array[
          (pos, "Regular expression literals are not yet supported by SKJS"),
        ],
        SKJSCode(9010),
      )
    | Spread _ ->
      fatalError(
        Array[
          (
            pos,
            "Spread elements are not yet supported by SKJS in this position",
          ),
        ],
        SKJSCode(9011),
      )
    }
  }

  // Whether `rhsTy` is a valid `instanceof` right-hand side: every member of
  // the type is a Function-like object (each branch carries a construct or
  // call signature). Mirrors tsc's TS2359 acceptance (modulo
  // `Symbol.hasInstance`, which SKJS does not model).
  fun isInstanceofRhs(tcenv: mutable TCEnv, rhsTy: TType): Bool {
    rhsTy.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      stypes.all(stype ->
        stype match {
        | obj @ TObject _ -> obj.isFunctionLike()
        | _ -> false
        }
      )
    }
  }

  // The precise type of a direct primitive literal expression, or None for
  // anything else. Unlike asConstExpr this is pure and does not recurse into
  // composite expressions, so it can be used speculatively (e.g. to record
  // fresh array literal elements).
  fun freshLiteralType(e: Expr): ?TType {
    this.directLiteralSType(e).map(stype -> TType::single(stype))
  }

  // Builds the readonly tuple for `[e0, e1, ...] as const`: each element takes
  // its own `as const` type -- a nested array literal recurses into a nested
  // readonly tuple, and everything else takes its most-precise type (which
  // already routes a literal, or a redundant element-level `as const`, through
  // the most-precise shortcut, so each element is type-checked exactly once).
  // Kept out of asConstExpr so that asConstExpr never type-checks a
  // sub-expression. The caller guarantees `elts` has no spread elements.
  fun constArrayLit(
    tcenv: mutable TCEnv,
    pos: PosRange,
    elts: Array<Expr>,
  ): TType {
    TType::tuple(
      pos,
      elts.map(elt ->
        elt.value match {
        | EArray(nested) if (nested.all(x -> !(x.value is Spread _))) ->
          this.constArrayLit(tcenv, elt.pos, nested)
        | _ -> this.expr(tcenv, elt, true)
        }
      ),
      true,
    )
  }

  /* The precise type of a const-foldable expression -- a primitive literal, a
   * unary operator on one, or an `as const` around such a thing -- or None for
   * anything else.
   *
   * Pure: it never type-checks a sub-expression (no `this.expr`), so a None
   * result can be discarded and the caller can fall back to the full typing in
   * exprImpl without any duplicated work or re-typing crash. In particular it
   * does NOT build the readonly tuple for `[...] as const` -- that requires
   * type-checking the elements, so the AsConst case in exprImpl does it (via
   * constArrayLit) once None comes back here.
   *
   * Returns a full TType rather than a single SType only to spare the callers a
   * `TType::single` wrapper. */
  fun asConstExpr(tcenv: mutable TCEnv, e: Expr): ?TType {
    pos = e.pos;
    e.value match {
    | AsConst(subExpr) ->
      // A redundant 'as const' does not change the program's meaning, so this
      // is a warning rather than a build-breaking error. It is also not always
      // truly redundant (an 'as const' on an array/object literal changes a
      // mutable value into a readonly one), which is a further reason not to
      // block on it.
      tcenv.warning(
        Array[(subExpr.pos, "This 'as const' is unnecessary")],
        SKJSCode(2044),
      );
      this.asConstExpr(tcenv, subExpr)
    | Var(Name(_, "null")) -> Some(TType::single(TPrimUnit(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      Some(TType::single(TPrimUnit(TUndefined(), pos)))
    | Unop(UOExclamationMark(), subE) ->
      this.asConstExpr(tcenv, subE).map(ty ->
        ty.getSingleConstant() match {
        | Some(TPrimValue(TBool(), lits, _)) ->
          lits.flatMap(v -> v.singleElt()) match {
          | Some(lit) ->
            // Negating a boolean literal is redundant, not wrong: `!true` is a
            // valid, sound way to write `false`. So this is a warning (a
            // simplification hint), not a build-breaking error.
            tcenv.warning(
              Array[
                (pos, "This constant expression could have been simplified"),
                (subE.pos, `This has type '${lit.val}'`),
              ],
              SKJSCode(2060),
            );
            res = lit.val match {
            | "true" -> "false"
            | "false" -> "true"
            | _ ->
              internal_error(
                `asConstExpr on Unop(UOExclamationMark) encountered a non-true non-false boolean: ${
                  lit.val
                }`,
              )
            };
            TType::single(TPrimValue::single(TBool(), res, pos))
          | None() ->
            internal_error(
              `asConstExpr returned a non-literal boolean: ${this.ppType(
                tcenv,
                ty,
              )}`,
            )
          }
        | _ ->
          fatalError(
            Array[
              (pos, "Operator '!' cannot be applied to this type"),
              (subE.pos, `This has type ${this.ppType(tcenv, ty)}`),
            ],
            ESLintCode("@typescript-eslint/strict-boolean-expressions"),
          )
        }
      )
    | Unop(UOTild(), _) -> /* TODO */ None()
    | Unop(nuop @ ArithmeticUnaryOperator(), subE) ->
      this.asConstExpr(tcenv, subE).flatMap(ty ->
        ty.getSingleConstant() match {
        | Some(TPrimValue(k @ TNum(), valuesOpt, _))
        | Some(TPrimValue(k @ TBigInt(), valuesOpt, _)) ->
          Some(
            nuop match {
            | UOPlus() ->
              // Unary '+' performs ToNumber, which throws on a bigint at
              // runtime; tsc rejects it with TS2736 in every context,
              // including const assertions. The guard is load-bearing: the
              // enclosing OR-pattern also binds k to TNum, and '+' on a
              // number literal stays accepted.
              if (k is TBigInt()) {
                fatalError(
                  Array[
                    (pos, "Operator '+' cannot be applied to type 'bigint'"),
                    (subE.pos, `This has type ${this.ppType(tcenv, ty)}`),
                  ],
                  TSCode(2736),
                )
              } else {
                ty
              }
            | UOMinus() ->
              valuesOpt.flatMap(v -> v.singleElt()) match {
              | None() ->
                internal_error(
                  "asConstExpr should return literals with a single value",
                )
              | Some(lit) ->
                TType::single(
                  TPrimValue::single(k, negateJSNumberLiteral(lit.val), pos),
                )
              }
            },
          )
        | _ -> None()
        }
      )
    // Direct literals share the same single source of truth as
    // freshLiteralType. Unary +/- never reaches here: the recursive
    // arithmetic arm above catches it first (and, unlike directLiteralSType,
    // accepts '+' on a bigint -- pre-existing, see issue #671).
    | _ -> this.directLiteralSType(e).map(TType::single)
    }
  }

  fun anonFunction(
    tcenv: mutable TCEnv,
    isAsync: ?PosRange,
    pos: PosRange,
    c: Closure,
    tparams: Array<TypeParam>,
    params: Array<Param>,
    retTypeAstOpt: ?Type,
    body: ClosureBody,
    expectedParamTypes: Array<?TType> = Array[],
  ): TType {
    static::checkTypeParams(
      tcenv.subst,
      tparams,
      OptionalTypeParamsForbidden(),
    );
    !this = this.addTParams(tcenv.subst, tparams);
    paramTypes = this.processParams(
      tcenv,
      params,
      tparams,
      false,
      expectedParamTypes,
    );
    callingContext = CGNode::create(AnonymousLambda(pos, c));
    // Register a dependency from parent context on this lambda
    tcenv.recordCalls(CGNodes::singleton(callingContext));
    savedScope = tcenv.scope;
    savedCallingContext = tcenv.callingContext;
    // A jump target cannot cross a function boundary, so the lambda body
    // starts with no catchers: a break/continue inside it must find its own
    // loop or switch, never an enclosing function's (see `recordBreak`).
    savedJumpCatchers = tcenv.jumpCatchers;
    tcenv.!jumpCatchers = mutable Vector[];
    tcenv.!scope = tcenv.mcreateSubScope{isLoop => false, isFunction => true};
    tcenv.!callingContext = callingContext;

    this.bindParams(tcenv, params, paramTypes);

    retType = retTypeAstOpt match {
    | None() ->
      body match {
      | CBExpr(e) ->
        inferredType = this.expr(tcenv, e, true);
        isAsync match {
        | None() -> inferredType
        | Some(asyncPos) ->
          // An async body settles to its awaited type: `async () => p`
          // has type () => Promise<number> for p: Promise<number>.
          payload = inferredType.maybeAwaited(
            tcenv.subst,
            this,
            asyncPos,
          ) match {
          | Some(awaited) -> awaited
          | None() ->
            this.errorSelfReferentialThenable(tcenv, pos);
            inferredType
          };
          TType::promise(asyncPos, payload)
        }
      | CBBlock(bl) ->
        if (isAsync is Some _) !this.isAsync = true;
        tvar = isAsync match {
        | None() -> this.newTVar(tcenv, pos, FromLambdaReturn(pos))
        | Some(asyncPos) ->
          TType::promise(
            asyncPos,
            this.newTVar(tcenv, pos, FromLambdaReturn(pos)),
          )
        };
        !this.retType = Some(tvar);
        _ = this.block(tcenv, bl);
        tvar
      }
    | Some(annotatedTypeAst) ->
      annotatedType = this.normalize(tcenv, annotatedTypeAst);
      tcenv.collectErrors(() ->
        body match {
        | CBExpr(e) ->
          inferredType = this.expr(tcenv, e, true);
          this.checkSubType(
            tcenv,
            e.pos,
            "Type of the callback's returned value is not assignable to the expected return type",
            isAsync match {
            | None() -> inferredType
            | Some(asyncPos) ->
              payload = inferredType.maybeAwaited(
                tcenv.subst,
                this,
                asyncPos,
              ) match {
              | Some(awaited) -> awaited
              | None() ->
                this.errorSelfReferentialThenable(tcenv, pos);
                inferredType
              };
              TType::promise(asyncPos, payload)
            },
            annotatedType,
            TSCode(2322),
          )
        | CBBlock(bl) ->
          if (isAsync is Some _) !this.isAsync = true;
          !this.retType = Some(annotatedType);
          _ = this.block(tcenv, bl)
        }
      );
      annotatedType
    };

    tcenv.!scope = savedScope;
    tcenv.!callingContext = savedCallingContext;
    tcenv.!jumpCatchers = savedJumpCatchers;

    // Build a CFG for the lambda body, keyed by its AnonymousLambda node, just
    // like funDef does for named functions and methods. An expression body
    // `(x) => e` is lowered as an implicit `return e`.
    if (getConfig(tcenv.context).buildCfg) {
      cfgBody = body match {
      | CBBlock(bl) -> bl
      | CBExpr(e) -> Array[Stmt(e.pos, Return(e.pos, Some(e)))]
      };
      typedParams = params.mapWithIndex((i, param) ->
        (param.name, paramTypes[i])
      );
      cfg = CFGBuilder::build(
        callingContext.id.toString(),
        pos,
        typedParams,
        retType,
        cfgBody,
        tcenv.exprTypes,
        tcenv.stmtTerminations,
      );
      tcenv.results.!cfgs[callingContext] = cfg
    };

    normalParams = mutable Vector[];
    optionalParams = mutable Vector[];
    spreadParam: ?TType = None();
    for (i => param in params) {
      paramType = paramTypes[i];
      if (param.isRest is Some _) {
        !spreadParam = Some(paramType)
      } else {
        // An omittable parameter (`?` marker or a default) can be absent at
        // the call site, so its type includes undefined — matching how
        // normalizeFun builds a declared function's signature. The union is
        // idempotent for a `?` parameter (already widened) and load-bearing
        // for a defaulted one.
        param.omittablePos() match {
        | Some(optPos) ->
          optionalParams.push(
            TType::unionUndefined(tcenv.subst, this, paramType, optPos),
          )
        | None() -> normalParams.push(paramType)
        }
      }
    };

    funClauses = tparams.map(tparam -> this.makeTParam(tcenv.subst, tparam));
    TType::single(
      TObject::createCall(
        TFuns::singleFun(
          TFun(
            funClauses,
            NoThis(),
            normalParams.toArray(),
            optionalParams.toArray(),
            spreadParam,
            retType,
            CGNodes::singleton(callingContext),
          ),
          pos,
        ),
      ),
    )
  }

  fun callConstructor(
    tcenv: mutable TCEnv,
    pos: PosRange,
    cstrType: CstrType,
    args: Array<Expr>,
  ): void {
    cstrType.cstr match {
    | None() ->
      if (args.size() == 0) return void;
      tcenv.error(
        Array[(pos, "This constructor expects no arguments")],
        TSCode(2554),
      )
    | Some(cstr) ->
      _ = this.call(tcenv, pos, cstr, cstrType.tArgs, args, true, None())
    }
  }

  fun assign(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1: Expr,
    e2: Expr,
    mostPrecise: Bool,
  ): TType {
    this.checkLValue(tcenv, e1);
    e1.value match {
    | Var(n) ->
      ty2 = this.expr(tcenv, e2, mostPrecise);
      tcenv.scope.set(n, ty2, (x, y) ->
        this.checkSubType(
          tcenv,
          pos,
          "Type is not assignable to the variable's type",
          x,
          y,
          TSCode(2322),
        )
      );
      ty2
    | Dot(
      NormalDot(),
      Expr(_, Var(local)),
      fieldName,
    ) if (tcenv.localObjectState(local).isSome()) ->
      keyExpr = Expr(fieldName.pos, EString(fieldName.value));
      this.assignLocalObject(
        tcenv,
        pos,
        e1.pos,
        local,
        keyExpr,
        e2,
        mostPrecise,
      )
    | Get(
      Expr(_, Var(local)),
      keyExpr,
    ) if (tcenv.localObjectState(local).isSome()) ->
      this.assignLocalObject(
        tcenv,
        pos,
        e1.pos,
        local,
        keyExpr,
        e2,
        mostPrecise,
      )
    | EArray(elements) ->
      // `[a, b] = e` writes each target the way the equivalent single
      // assignment would. The whole expression evaluates to the right-hand
      // side, which is also what the CFG reads back for the left-hand side.
      ty2 = this.expr(tcenv, e2, mostPrecise);
      this.assignArray(tcenv, pos, elements, ty2, mostPrecise);
      ty2
    | _ ->
      ty1 = this.expr(tcenv, e1, false, true);
      ty2 = this.expr(tcenv, e2, mostPrecise);
      this.checkSubType(
        tcenv,
        e2.pos,
        "Type is not assignable to the assignment target's type",
        ty2,
        ty1,
        TSCode(2322),
      );
      ty1
    }
  }

  // Split a destructuring pattern's elements into the positional targets and
  // the trailing rest target, if any.
  private fun splitRest(
    tcenv: mutable TCEnv,
    elements: Array<Expr>,
  ): (Array<Expr>, ?Expr) {
    restInner: ?Expr = None();
    targets = mutable Vector[];
    for (i => elt in elements) {
      elt.value match {
      | Spread(inner) ->
        if (i == elements.size() - 1) {
          !restInner = Some(inner)
        } else {
          tcenv.error(
            Array[
              (
                elt.pos,
                "A rest element must be last in a destructuring pattern",
              ),
            ],
            TSCode(2462),
          )
        }
      | _ -> targets.push(elt)
      }
    };
    (targets.toArray(), restInner)
  }

  /*
   * Assigns the elements of `rhsType` to an array-destructuring pattern.
   *
   * The element types are derived the way `bind` derives them for a
   * destructuring declaration: per index from a tuple, or the iterator's
   * element type (widened with `undefined`, since the source may be shorter)
   * from anything else iterable. A target beyond the end of a tuple reads
   * `undefined` at runtime and is typed that way, which the target's own check
   * then reports — no separate arity diagnostic.
   */
  private fun assignArray(
    tcenv: mutable TCEnv,
    pos: PosRange,
    elements: Array<Expr>,
    rhsType: TType,
    mostPrecise: Bool,
  ): void {
    (targets, restInner) = this.splitRest(tcenv, elements);
    stypes = rhsType.getSTypes(tcenv.subst, this, Covariant());
    stypes.flatMap(s -> s.getSingleTuple(tcenv.subst, this)) match {
    | Some(tyl) ->
      for (i => elt in targets) {
        eltType = if (i < tyl.size()) {
          tyl[i]
        } else {
          TType::single(TPrimUnit(TUndefined(), elt.pos))
        };
        this.assignElement(tcenv, elt, eltType, mostPrecise)
      };
      restInner.each(inner -> {
        // Destructuring a rest allocates a fresh array, so nothing aliases it
        // at the tuple's arity: it can be read as a growable array just as well
        // as a tuple. Type it the way an array literal is typed — delayed, so
        // it commits to whichever the target asks for — rather than as a
        // committed tuple, which only an equally-shaped tuple could accept. An
        // *existing* tuple stays un-assignable to an array, since writing
        // through the array view would break its arity.
        start = min(targets.size(), tyl.size());
        restElts = tyl.slice(start);
        restType = if (restElts.isEmpty()) {
          eltTvar = this.newTVar(tcenv, inner.pos, FromEmptyArray(inner.pos));
          TType::inst(Name(inner.pos, "Array"), TArgs(Array[eltTvar]))
        } else {
          ArrayLitTyping::typeFromLiteral(
            tcenv,
            inner.pos,
            restElts,
            restElts.map(_ -> None()),
          )
        };
        this.assignTarget(tcenv, inner, restType, mostPrecise)
      })
    | None() ->
      stypes.flatMap(s ~> s.singleElt()) match {
      | Some(obj @ TObject _) ->
        baseElt = this.getIteratorElementType(tcenv.subst, obj, pos) match {
        | Some(t) -> t
        | None() ->
          fatalError(
            Array[
              (pos, "Cannot use array-destructuring on a non-iterable type"),
              (
                rhsType.pos,
                `This is not iterable, it is ${this.ppType(tcenv, rhsType)}`,
              ),
            ],
            TSCode(2461),
          )
        };
        for (elt in targets) {
          this.assignElement(
            tcenv,
            elt,
            TType::unionUndefined(tcenv.subst, this, baseElt, elt.pos),
            mostPrecise,
          )
        };
        restInner.each(inner ->
          this.assignTarget(
            tcenv,
            inner,
            TType::inst(Name(inner.pos, "Array"), TArgs(Array[baseElt])),
            mostPrecise,
          )
        )
      | _ ->
        fatalError(
          Array[
            (pos, "Cannot use array-destructuring on this type"),
            (
              rhsType.pos,
              `This is not a tuple, it is ${this.ppType(tcenv, rhsType)}`,
            ),
          ],
          TSCode(2461),
        )
      }
    }
  }

  // Assign one destructured element, applying its default first: `[x = d]`
  // parses as an assignment inside the pattern, and the default replaces the
  // element only when it is absent, exactly as in a declaration.
  private fun assignElement(
    tcenv: mutable TCEnv,
    elt: Expr,
    eltType: TType,
    mostPrecise: Bool,
  ): void {
    (target, targetType) = elt.value match {
    | Binop(BOAssignment(), lhs, defaultExpr) ->
      defaultType = this.expr(tcenv, defaultExpr, false);
      (
        lhs,
        TType::union(
          tcenv.subst,
          this,
          TType::removeUndefined(tcenv.subst, this, eltType),
          defaultType,
        ),
      )
    | _ -> (elt, eltType)
    };
    this.assignTarget(tcenv, target, targetType, mostPrecise)
  }

  // Write `valueType` to one destructuring target, routing it through the same
  // path the equivalent single assignment uses: a variable is narrowed and
  // checked by `Scope::set`, a property or index is checked against the type it
  // can be set to, and a nested pattern destructures in turn.
  private fun assignTarget(
    tcenv: mutable TCEnv,
    target: Expr,
    valueType: TType,
    mostPrecise: Bool,
  ): void {
    this.checkLValue(tcenv, target);
    target.value match {
    | Var(n) ->
      tcenv.scope.set(n, valueType, (x, y) ->
        this.checkSubType(
          tcenv,
          target.pos,
          "Type is not assignable to the variable's type",
          x,
          y,
          TSCode(2322),
        )
      )
    | EArray(nested) ->
      this.assignArray(tcenv, target.pos, nested, valueType, mostPrecise)
    | _ ->
      ty1 = this.expr(tcenv, target, false, true);
      this.checkSubType(
        tcenv,
        target.pos,
        "Type is not assignable to the assignment target's type",
        valueType,
        ty1,
        TSCode(2322),
      )
    }
  }

  /*
   * Adds a field to a local object via assignment: obj.field = value or obj[key] = value
   *
   * This implements the "growth" mechanism for local objects. When we see:
   *   let obj = {};
   *   obj.field = value;
   *
   * We:
   * 1. Resolve the key expression to a FieldKey (string/number/symbol literal)
   * 2. Check against bound type if present
   * 3. Look up existing field or check index signatures
   * 4. If no match, grow the object by adding the new field
   *
   * Errors if:
   * - Object has been used (LOUsed state)
   * - Adding field inside a loop
   */
  private fun assignLocalObject(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1Pos: PosRange,
    local: Name,
    keyExpr: Expr,
    e2: Expr,
    mostPrecise: Bool,
  ): TType {
    fieldType = this.expr(tcenv, e2, mostPrecise);
    keyType = this.expr(tcenv, keyExpr, true);
    fieldKeys = keyType
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes -> stypes.singleElt()) match {
    | Some(stype) -> FieldKey::allOfSType(keyExpr.pos, stype)
    | _ -> Array[]
    };
    if (fieldKeys.isEmpty()) {
      // Computed (non-literal) key: a named field can't be added, so this is an
      // ordinary element write. Validate the value against the object's index
      // via the shared element access (AKLValue = the setter direction), the
      // same as writing through an index on any object.
      elemType = this.getWithIndexType(
        tcenv,
        e1Pos,
        tcenv.scope.get(local),
        keyType,
        keyExpr.pos,
        AKLValue(),
      );
      this.checkSubType(
        tcenv,
        fieldType.pos,
        "Type is not assignable to the index signature's value type",
        fieldType,
        elemType,
        TSCode(2322),
      );
      fieldType
    } else {
      this.assignLocalObjectByKeys(
        tcenv,
        pos,
        e1Pos,
        local,
        keyExpr,
        keyType,
        fieldType,
        fieldKeys,
      )
    }
  }

  // Grows a local object by one or more literal keys.
  // When there are multiple keys (e.g. key: "a" | "b"), fields are optional.
  private fun assignLocalObjectByKeys(
    tcenv: mutable TCEnv,
    pos: PosRange,
    e1Pos: PosRange,
    local: Name,
    keyExpr: Expr,
    keyType: TType,
    fieldType: TType,
    fieldKeys: Array<FieldKey>,
  ): TType {
    isOptional = fieldKeys.size() > 1;
    used = tcenv.localObjectState(local) match {
    | Some(LOCanGrow(bound)) ->
      bound match {
      | None() -> void
      | Some(objectType) ->
        /* Not using the setter type here:
           LOCanGrow with a bound is only used for the this type in constructors
           so getters and setters have the same type, except for readonly-fields.
           But in constructors, all fields are writable, hence the usage of the getter type. */
        this.checkSubType(
          tcenv,
          fieldType.pos,
          "Type is not assignable to the field's type",
          fieldType,
          // The key was already typechecked by the caller; reuse its type
          // rather than re-typechecking keyExpr.
          this.getWithIndexType(
            tcenv,
            e1Pos,
            objectType,
            keyType,
            keyExpr.pos,
            AKNormal(),
          ),
          TSCode(2322),
        )
      };
      None()
    | Some(LOUsed(usedPos)) -> Some(usedPos)
    | None() -> None()
    };
    tcenv.scope
      .get(local)
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(obj @ TObject(_, _, objPos)) ->
      // A local object may be multi-branch: distributing an object spread over
      // a union yields one branch per member (SkipLabs/skjs#714). Handle each
      // branch independently — resolve every key as a named field or a covering
      // non-synthetic index and check the write against that slot; when the key
      // resolves to neither, grow the branch with a new field. The growth still
      // happens (so later assignments see the field), but is recorded so that a
      // used or in-loop object can be diagnosed afterwards.
      needsGrowth = false;
      grownObj = obj.mapOpt(branch -> {
        newFieldsMap = mutable Map[];
        newSymbolFieldsMap = mutable Map[];
        for (key in fieldKeys) {
          branch.maybeGetFieldOrIndex(key) match {
          | Some(fd) ->
            this.checkSubType(
              tcenv,
              fieldType.pos,
              "Type is not assignable to the field's type",
              fieldType,
              fd.set,
              TSCode(2322),
            )
          | None() ->
            !needsGrowth = true;
            // When growing `this` inside a class body (e.g. constructor
            // initialization of a parameter property), inherit the access
            // declared on the class so the constructor-exit subtype check sees
            // matching access kinds.
            access = if (local.value == "this") {
              this.lookupEnclosingFieldAccess(tcenv, key.value())
            } else {
              FAPublic()
            };
            field = TField::create{
              pos => key.pos(),
              name => key.value(),
              isOptional,
              isReadonly => None(),
              type => fieldType,
              access,
            };
            key match {
            | FKName _ -> newFieldsMap![field.name] = field
            | FKSymbol _ -> newSymbolFieldsMap![field.name] = field
            }
          }
        };
        if (newFieldsMap.isEmpty() && newSymbolFieldsMap.isEmpty()) {
          Some(branch)
        } else {
          newFields = TFields::create{
            fields => newFieldsMap,
            symbolFields => newSymbolFieldsMap,
            /* Local objects are not arrays but a type annotation may lose this information */
            isArray => Some(false),
          };
          // The added fields are absent from the branch, so the intersection
          // just inserts them; None (an isArray/signature clash) drops the
          // branch, mirroring TObject::inter.
          TFields::inter(tcenv.subst, this, branch, newFields)
        }
      });
      if (needsGrowth) {
        // A field was added to at least one branch. That's fine on a still-
        // growable object; a used (frozen) or in-loop object is diagnosed here,
        // but the grown type is still recorded so later code type-checks.
        used match {
        | None() -> void
        | Some(usedPos) ->
          tcenv.error(
            Array[
              (pos, "Cannot add a field to this object after it has been used"),
              (
                usedPos,
                "But this object has already been used for something else",
              ),
            ],
            SKJSCode(2065),
          )
        };
        if (tcenv.scope.isThroughLoop(local)) {
          tcenv.error(
            Array[(local.pos, "Cannot add a field to an object inside a loop")],
            SKJSCode(2069),
          )
        };
        newTy = grownObj match {
        | Some(o) -> TType::single(o)
        | None() -> TType::bottom(objPos)
        };
        tcenv.scope.set(local, newTy, (x, y) -> {
          this.checkSubType(
            tcenv,
            fieldType.pos,
            "Type is not assignable to the property's type",
            x,
            y,
            TSCode(2322),
          )
        })
      }
    | _ ->
      tcenv.error(
        Array[(pos, "Internal error: local object is not an object")],
        SKJSCode(9999),
      )
    };
    fieldType
  }

  fun inLhsFieldsFromType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    lhsPos: PosRange,
    lhsTy: TType,
  ): (??PrimLiterals, ??PrimLiterals) {
    lhsTy.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes1) if (!stypes1.isEmpty()) ->
      fieldLitsOpt: ??PrimLiterals = None();
      symLitsOpt: ??PrimLiterals = None();
      for (stype1 in stypes1) {
        stype1 match {
        | TPrimValue(TNum(), lits, _)
        | TPrimValue(TString(), lits, _) ->
          !fieldLitsOpt = fieldLitsOpt match {
          | Some(None()) -> Some(None())
          | None() -> Some(lits)
          | Some(Some(_)) if (lits.isNone()) -> Some(None())
          | Some(Some(existing)) -> Some(lits.map(more -> existing.union(more)))
          }
        | TPrimValue(TSymbol(), symLits, _) ->
          !symLitsOpt = symLitsOpt match {
          | Some(None()) -> Some(None())
          | None() -> Some(symLits)
          | Some(Some(_)) if (symLits.isNone()) -> Some(None())
          | Some(Some(existing)) ->
            Some(symLits.map(more -> existing.union(more)))
          }
        | _ ->
          fatalError(
            Array[
              (
                pos,
                "The left-hand side of an 'in' expression must be of type 'string', 'number', or 'symbol'",
              ),
              (lhsPos, `This has type ${this.ppType(tcenv, lhsTy)}`),
            ],
            TSCode(2360),
          )
        }
      };
      (fieldLitsOpt, symLitsOpt)
    | _ ->
      fatalError(
        Array[
          (
            pos,
            "The left-hand side of an 'in' expression must be of type 'string', 'number', or 'symbol'",
          ),
          (lhsPos, `This has type ${this.ppType(tcenv, lhsTy)}`),
        ],
        TSCode(2360),
      )
    }
  }

  // Given the expected type of a closure argument (a function type, possibly
  // `fn | undefined` for an optional parameter), return the contextual type
  // for each of the closure's parameters — used to fill in un-annotated ones.
  // Returns the empty array (no contextual typing) unless the expected type is
  // a single callable object (ignoring undefined/null branches) whose own call
  // signature is non-generic, so the extracted parameter types are concrete.
  fun expectedCallbackParamTypes(
    tcenv: mutable TCEnv,
    expectedFnTy: TType,
    closureParams: Array<Param>,
  ): Array<?TType> {
    stypes = expectedFnTy.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(s) -> s
    | None() -> return Array[]
    };
    cbFuns: ?TFuns = None();
    for (stype in stypes.values()) {
      stype match {
      | obj @ TObject _ ->
        obj.maybeGetCall(tcenv.subst, this) match {
        | Some(
          tfuns @ TFuns(f, _),
        ) if (f.tparams.isEmpty() && cbFuns is None()) ->
          !cbFuns = Some(tfuns)
        | _ -> return Array[]
        }
      | TPrimUnit(TUndefined(), _)
      | TPrimUnit(TNull(), _) ->
        void
      | _ -> return Array[]
      }
    };
    cbFuns match {
    | Some(tfuns) ->
      Array::fillBy(closureParams.size(), j -> tfuns.paramTypeAt(j))
    | None() -> Array[]
    }
  }

  // Type a call argument, applying contextual typing when it is a closure with
  // un-annotated parameters: fill those from the callee's expected parameter
  // type at this position. Restricted to a non-generic callee (so the expected
  // parameter types are concrete, not references to the callee's own
  // not-yet-inferred type parameters) at an unambiguous position (before any
  // spread argument). Everything else is typed as usual.
  fun typeCallArg(
    tcenv: mutable TCEnv,
    argExpr: Expr,
    tfuns: TFuns,
    argPos: Int,
    positionUnambiguous: Bool,
    mostPrecise: Bool,
  ): TType {
    if (positionUnambiguous) {
      tfuns match {
      | TFuns(calleeTFun, _) if (calleeTFun.tparams.isEmpty()) ->
        argExpr match {
        | Expr(closurePos, c @ Closure(tparams, ps, retTyAstOpt, body))
        | Expr(
          _,
          Async(Expr(closurePos, c @ Closure(tparams, ps, retTyAstOpt, body))),
        ) ->
          tfuns.paramTypeAt(argPos) match {
          | Some(expectedFnTy) ->
            return this.anonFunction(
              tcenv,
              if (argExpr.value is Async _) Some(argExpr.pos) else None(),
              closurePos,
              c,
              tparams,
              ps,
              retTyAstOpt,
              body,
              this.expectedCallbackParamTypes(tcenv, expectedFnTy, ps),
            )
          | None() -> void
          }
        | _ -> void
        }
      | _ -> void
      }
    };
    this.expr(tcenv, argExpr, mostPrecise)
  }

  fun call(
    tcenv: mutable TCEnv,
    pos: PosRange,
    tfuns: TFuns,
    targs: Array<TType>,
    argExprs: Array<Expr>,
    mostPrecise: Bool,
    thisArgOpt: ?TType,
  ): TType {
    args = mutable Vector<TType>[];
    moreArgs: ?TType = None();

    for (argExpr in argExprs) {
      argExpr.value match {
      | Spread(spreadExpr) ->
        spreadTy = this.expr(tcenv, spreadExpr, mostPrecise);
        stypes = spreadTy.getSTypes(tcenv.subst, this, Covariant());
        if (moreArgs is None()) {
          stypes.flatMap(s -> s.getSingleTuple(tcenv.subst, this)) match {
          | Some(tupElts) ->
            args.extend(tupElts);
            continue
          | None() -> void
          }
        };
        stypes.flatMap(s ~> s.singleElt()) match {
        | Some(obj @ TObject _) ->
          this.getIteratorElementType(tcenv.subst, obj, argExpr.pos) match {
          | None() ->
            tcenv.error(
              Array[
                (
                  argExpr.pos,
                  "A spread argument must be of an array or iterable type",
                ),
                (spreadTy.pos, `It has type ${this.ppType(tcenv, spreadTy)}`),
              ],
              SKJSCode(2045),
            )
          | Some(eltType) ->
            !moreArgs = Some(
              moreArgs match {
              | None() -> eltType
              | Some(ma) -> TType::union(tcenv.subst, this, ma, eltType)
              },
            )
          }
        | _ ->
          tcenv.error(
            Array[
              (
                argExpr.pos,
                "A spread argument must be of an array or iterable type",
              ),
              (spreadTy.pos, `It has type ${this.ppType(tcenv, spreadTy)}`),
            ],
            SKJSCode(2045),
          )
        }
      | _ ->
        // `args.size()` is this argument's positional index; `moreArgs is
        // None()` means no spread has been seen yet, so the position is
        // unambiguous and contextual typing of a closure argument is sound.
        argTy = this.typeCallArg(
          tcenv,
          argExpr,
          tfuns,
          args.size(),
          moreArgs is None(),
          mostPrecise,
        );
        moreArgs match {
        | None() -> args.push(argTy)
        | Some(ma) ->
          !moreArgs = Some(TType::union(tcenv.subst, this, ma, argTy))
        }
      }
    };

    tfuns match {
    | TFuns(tfun, fPos) ->
      tcenv.recordCalls(tfun.cgNodes);
      if (targs.size() != 0 && targs.size() != tfun.tparams.size()) {
        tcenv.error(
          Array[
            (
              pos,
              `Expected ${tfun.tparams.size()} type arguments, but got ${targs.size()}`,
            ),
            (fPos, `Expected: ${tfun.tparams.size()}`),
          ],
          TSCode(2558),
        )
      };
      map = SortedMap[];
      newTVars = mutable Vector[];
      for (i => tparamDecl in tfun.tparams) {
        !map[tparamDecl.id] = if (i < targs.size()) {
          targs[i]
        } else {
          tv = tcenv.subst.gen(pos);
          newTVars.push(tv);
          TType::var(tv)
        };
      };
      if (!newTVars.isEmpty()) {
        allNewTVars = newTVars.collect(Array);
        for (tv in allNewTVars) {
          tcenv.subst.setOrigin(tv, FromGenericCall(pos, allNewTVars))
        }
      };
      frozenMap = map.chill();
      // Validate each explicit type argument against its parameter's constraint.
      // Inferred arguments (the fresh TVars above) carry their constraint on the
      // variable and have it enforced at growth, so only explicit arguments need
      // checking here. The constraint is a subtyping obligation -- every
      // inhabitant of the argument must inhabit the bound -- so it is checked
      // with `isSub`. The constraint is instantiated with `frozenMap` first, so
      // a constraint that references another type parameter (a dependent
      // constraint like `<A, B extends A>`) is checked against that parameter's
      // argument. The clone keeps the speculative check from growing inference
      // variables on the live subst.
      //
      // Without this check, an argument that violates the bound is substituted
      // anyway; where the parameter occurs only covariantly (e.g. the return
      // type) the constraint-carrying occurrence (the parameter is normalized to
      // `param & constraint`) collapses to `never`, which is assignable to
      // anything and silently absorbs the violation -- unsound.
      for (i => tparamDecl in tfun.tparams) {
        if (i < targs.size()) {
          tparamDecl.cstr match {
          | None() -> void
          | Some(cstr) ->
            tArg = targs[i];
            cstrTy = (mutable Instantiate()).type(
              (tcenv.subst, this, frozenMap),
              cstr,
            );
            TType::isSub(tcenv.subst.clone(), this, tArg, cstrTy) match {
            | STOk() -> void
            | err @ STErrorOnTType _ ->
              tcenv.subtypingError(
                tcenv.subst,
                this,
                Array[
                  (pos, "Type argument does not satisfy the constraint"),
                  (tArg.pos, `This is of type: ${this.ppType(tcenv, tArg)}`),
                  (
                    cstr.pos,
                    `It does not satisfy the constraint: ${this.ppType(
                      tcenv,
                      cstrTy,
                    )}`,
                  ),
                ],
                err,
                TSCode(2344),
              )
            }
          }
        }
      };
      !tfun = (mutable Instantiate()).fun_(
        (tcenv.subst, this, frozenMap),
        tfun with {tparams => Array[]},
      );
      totalSize = tfun.params.size() + tfun.optionalParams.size();
      // Unified rest-argument mechanism (Stage A): if spreadParam is an unbound generic
      // type variable, infer/bind it from call-site arguments before param checking.
      callInvalid = VariadicTyping::inferRestTypeVar(
        tcenv,
        this,
        pos,
        tfun.spreadParam,
        totalSize,
        args,
        moreArgs,
      );

      if (callInvalid) {
        // Skip further param checking and return the function's return type
        // to avoid cascading diagnostics from void/return-type mismatches.
        return tfun.retType
      };

      // Check the receiver against the declared `this` parameter, if any.
      // A call with no receiver (free call) uses `this: void`, matching TS.
      tfun.thisParam match {
      | NoThis() -> void
      // A shape method is attach-only: at an attached call the receiver is
      // the object it was accessed on; a free call has lost it.
      | ImplicitShape() ->
        if (thisArgOpt is None _) {
          tcenv.error(
            Array[
              (
                pos,
                "A shape method can only be called on the object it was accessed on",
              ),
            ],
            SKJSCode(2075),
          )
        }
      // An implicit class `this` is the type of the object the method was
      // resolved from, so an attached call (`e1.m()` / `e1[k]()`, which supplies
      // `thisArgOpt`) inherently satisfies it. Skip the check there: for a union
      // receiver the method's `this` is the *intersection* of the branches, and
      // `union <: intersection` would spuriously fail even though each branch
      // trivially satisfies its own `this`. Only a free/detached call (receiver
      // `void`) needs the check, to reject `const g = o.m; g()`.
      | ImplicitClass _ if (thisArgOpt.isSome()) -> void
      // Explicit `this: T`, or a detached call on an implicit this.
      | tp ->
        expectedThis = tp.tyOpt().fromSome();
        actualThis = thisArgOpt match {
        | Some(t) -> t
        | None() -> TType::single(TPrimUnit(TVoid(), pos))
        };
        this.checkSubType(
          tcenv,
          pos,
          "The 'this' context is not assignable to method's 'this' type",
          actualThis,
          expectedThis,
          TSCode(2684),
        )
      };

      version = tcenv.subst.version;
      loop {
        for (i in Range(0, tfun.params.size())) {
          if (i >= args.size()) {
            tcenv.error(
              Array[
                (pos, "Too few arguments for this call"),
                (fPos, `This function has ${tfun.params.size()} parameters`),
              ],
              TSCode(2554),
            );
            break void
          } else {
            this.checkSubType(
              tcenv,
              pos,
              "Argument is not assignable to the parameter's type",
              args[i],
              tfun.params[i],
              TSCode(2345),
            )
          }
        };
        for (j in Range(0, tfun.optionalParams.size())) {
          i = tfun.params.size() + j;
          arg = if (i < args.size()) {
            args[i]
          } else {
            moreArgs match {
            | None() -> break void
            | Some(ma) -> ma
            }
          };
          this.checkSubType(
            tcenv,
            pos,
            "Argument is not assignable to the parameter's type",
            arg,
            tfun.optionalParams[j],
            TSCode(2345),
          )
        };
        if (tcenv.subst.version == version) {
          break void
        };
        !version = tcenv.subst.version;
      };
      VariadicTyping::checkRestArgs(
        tcenv,
        this,
        pos,
        tfun.spreadParam,
        totalSize,
        args,
        moreArgs,
      );
      tfun.retType
    }
  }
}

extension base class TEnv {
  // The precise literal SType of a direct primitive literal expression (`0`,
  // `'a'`, `true`, `1n`, `-1`, `+1`), or None for anything else. Pure (no
  // diagnostics) and non-recursive. Single source of truth for direct
  // literals, shared by freshLiteralType and asConstExpr's leaf cases so the
  // two cannot drift. Exception: unary expressions never reach here from
  // asConstExpr (its recursive arithmetic arm catches them first), and the
  // two intentionally disagree on `+1n` -- asConstExpr accepts it
  // (pre-existing), while this returns None so `+1n` is not a fresh literal
  // (issue #671).
  // Lives on TEnv (not TypeChecker) so def-to-type derivation in TEnv can
  // fold literal expressions too (e.g. enum member initializers).
  fun directLiteralSType(e: Expr): ?SType {
    pos = e.pos;
    e.value match {
    | Number(n) -> Some(TPrimValue::single(TNum(), n, pos))
    | BigInt(n) -> Some(TPrimValue::single(TBigInt(), n, pos))
    | EString(n) -> Some(TPrimValue::single(TString(), n, pos))
    | Var(Name(_, "true")) -> Some(TPrimValue::single(TBool(), "true", pos))
    | Var(Name(_, "false")) -> Some(TPrimValue::single(TBool(), "false", pos))
    | Unop(nuop @ ArithmeticUnaryOperator(), subE) ->
      // '+' only preserves number literals here: unary '+' on a bigint is a
      // runtime TypeError (TS2736 in tsc), so only '-' preserves bigint
      // literals.
      kindValue = (nuop, subE.value) match {
      | (_, Number(n)) -> Some((TNum(), n))
      | (UOMinus(), BigInt(n)) -> Some((TBigInt(), n))
      | _ -> None()
      };
      kindValue.map(kn -> {
        (kind, n) = kn;
        value = nuop match {
        | UOPlus() -> n
        | UOMinus() -> negateJSNumberLiteral(n)
        };
        TPrimValue::single(kind, value, pos)
      })
    | _ -> None()
    }
  }
}

module end;
