module SKJS;

extension class TypeChecker {
  fun isVoid(tcenv: mutable TCEnv, isAsync: Bool, ty: TType): Bool {
    clauses = ty.expandToClauses(tcenv.subst, this, Covariant());
    for (clause in clauses) {
      clause.stypes match {
      | None() -> return false
      | Some(stypes) ->
        stypes.singleElt() match {
        | Some(TPrimUnit(TVoid(), _)) if (!isAsync) -> void
        | Some(TPromise(realType, _)) if (isAsync) ->
          if (!this.isVoid(tcenv, false, realType)) {
            return false
          }
        | _ -> return false
        }
      }
    };
    true
  }

  // Returns true if the type is not Top but contains void
  fun nonTopContainsVoid(tcenv: mutable TCEnv, ty: TType): Bool {
    clauses = ty.expandToClauses(tcenv.subst, this, Covariant());
    for (clause in clauses) {
      clause.stypes match {
      | Some(stypes) if (stypes.any(stype ~> stype is TPrimUnit(TVoid(), _))) ->
        return true
      | _ -> void
      }
    };
    false
  }

  static private fun filterMethods(
    ty: TType,
    subst: mutable Subst,
    tenv: TEnv,
    methods: SortedSet<String>,
  ): TType {
    ty.getSTypes(subst, tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(obj @ TObject _) -> TType::single(obj.removeFields(methods))
    | _ ->
      subst.error(
        Array[(ty.pos, "Internal error: new should produce an object")],
      );
      ty
    }
  }

  fun checkSubType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
  ): void {
    TType::isSub(tcenv.subst, this, ty1, ty2) match {
    | STOk() -> void
    | err @ STErrorOnTType _ ->
      tcenv.error(Array[(pos, msg)], Some(err), tcenv.subst.values)
    }
  }

  fun checkIsVoid(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type void",
      ty,
      TType::single(TPrimUnit(TVoid(), ty.pos)),
    );
  }

  fun checkIsIgnorable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    if (
      ty.clauses.isEmpty() &&
      ty.insts.getUnique() is Some(TSInst(Name(_, "SKJS_Ignorable"), _))
    ) {
      return void
    };
    tyVoid = TType::single(TPrimUnit(TVoid(), ty.pos));
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type void or ignorable",
      ty,
      tyVoid,
    )
  }

  static fun isPossiblyNonVoidExpressionAllowedAsStatement(e: Expr): Bool {
    e.value match {
    | Binop(BOAssignment(), _, _)
    | Binop(BOOpAssignment(_), _, _)
    | PostOp(PODecr(), _)
    | PostOp(POIncr(), _) ->
      true
    | _ -> false
    }
  }

  fun checkBool(tcenv: mutable TCEnv, e: Expr): void {
    this.checkSubType(
      tcenv,
      e.pos,
      "A condition is expected to be of type boolean, not: ",
      this.expr(tcenv, e, true),
      TType::single(TPrimValue::boolean(e.pos)),
    );
  }

  fun checkStringifiable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    // Check if the type is a primitive type that can be converted to string
    // Allowed types: string, number, bigint, boolean, null, undefined
    isStringifiable = ty.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      stypes.all(stype ->
        stype match {
        | TPrimValue(TString(), _, _) -> true
        | TPrimValue(TNum(), _, _) -> true
        | TPrimValue(TBigInt(), _, _) -> true
        | TPrimValue(TBool(), _, _) -> true
        | TPrimUnit(TNull(), _) -> true
        | TPrimUnit(TUndefined(), _) -> true
        | TPrimUnit(TVoid(), _) -> false
        | _ -> false
        }
      )
    };

    if (!isStringifiable) {
      tcenv.error(
        Array[
          (
            pos,
            "Template literal expressions must be string, number, bigint, boolean, null, or undefined",
          ),
        ],
      );
    }
  }

  fun checkIsNumber(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): void {
    ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TNum(), _, _)) -> void
    | _ -> tcenv.error(Array[(pos, msg), (ty.pos, "This is not a number")])
    };
  }

  fun checkIsNumeric(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): TPrimValueKind {
    ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(kind @ TNum(), _, _))
    | Some(TPrimValue(kind @ TBigInt(), _, _)) ->
      kind
    | _ ->
      typingError(
        Array[
          (pos, msg),
          (ty.pos, "This is not a numeric type (number or bigint)"),
        ],
      )
    };
  }

  fun makeBoundTVar(tcenv: mutable TCEnv, ty: TType): TType {
    tvar = tcenv.subst.gen(ty.pos);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun makeBoundTVarForField(tcenv: mutable TCEnv, ty: TType): TType {
    tvar = tcenv.subst.genForField(ty.pos);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun newTVar(tcenv: mutable TCEnv, pos: PosRange): TType {
    tvar = tcenv.subst.gen(pos);
    TType::var(tvar)
  }

  fun checkLValue(tcenvb: mutable TCEnvBase, e: Expr): void {
    e.value match {
    | Var(Name(_, "super")) -> tcenvb.error(Array[(e.pos, "Invalid lvalue")])
    | Var _ -> void
    | Get _ -> void
    | EArray _ -> void
    | Dot(NormalDot(), e1, _) -> this.checkLValue(tcenvb, e1)
    | _ -> tcenvb.error(Array[(e.pos, "Invalid lvalue")])
    }
  }
}

fun paramsError<T>(pos: PosRange): T {
  typingError(
    Array[
      (
        pos,
        "Type annotations in parentheses are not valid in an expression." +
          "Use type assertions with 'as' keyword instead",
      ),
    ],
  )
}

module end;
