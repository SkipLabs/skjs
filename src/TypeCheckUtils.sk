module SKJS;

extension class TypeChecker {
  fun isVoid(tcenv: mutable TCEnv, isAsync: Bool, ty: TType): Bool {
    clauses = ty.expandToClauses(tcenv.subst, this, Covariant());
    for (clause in clauses) {
      clause.stypes match {
      | None() -> return false
      | Some(stypes) ->
        stypes.singleElt() match {
        | Some(TPrimUnit(TVoid(), _)) if (!isAsync) -> void
        | Some(TPromise(realType, _)) if (isAsync) ->
          if (!this.isVoid(tcenv, false, realType)) {
            return false
          }
        | _ -> return false
        }
      }
    };
    true
  }

  // Returns true if the type is not Top but contains void
  fun nonTopContainsVoid(tcenv: mutable TCEnv, ty: TType): Bool {
    clauses = ty.expandToClauses(tcenv.subst, this, Covariant());
    for (clause in clauses) {
      clause.stypes match {
      | Some(stypes) if (stypes.any(stype ~> stype is TPrimUnit(TVoid(), _))) ->
        return true
      | _ -> void
      }
    };
    false
  }

  static private fun filterMethods(
    ty: TType,
    subst: mutable Subst,
    tenv: TEnv,
    methods: SortedSet<String>,
  ): TType {
    ty.getSTypes(subst, tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(obj @ TObject _) -> TType::single(obj.removeFields(methods))
    | _ ->
      subst.error(
        Array[(ty.pos, "Internal error: new should produce an object")],
        SKJSCode(9999),
      );
      ty
    }
  }

  fun checkSubType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
    code: ErrorCode,
  ): void {
    TType::isSub(tcenv.subst, this, ty1, ty2) match {
    | STOk() -> void
    | err @ STErrorOnTType _ ->
      tcenv.subtypingError(tcenv.subst, this, Array[(pos, msg)], err, code)
    }
  }

  fun checkIsVoid(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type 'void'",
      ty,
      TType::single(TPrimUnit(TVoid(), ty.pos)),
      SKJSCode(2002),
    );
  }

  fun checkIsIgnorable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    if (
      ty.clauses.isEmpty() &&
      ty.insts.getUnique() is Some(TSInst(Name(_, "SKJS_Ignorable"), _))
    ) {
      return void
    };
    tyVoid = TType::single(TPrimUnit(TVoid(), ty.pos));
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type 'void' or ignorable",
      ty,
      tyVoid,
      SKJSCode(2002),
    )
  }

  static fun isPossiblyNonVoidExpressionAllowedAsStatement(e: Expr): Bool {
    e.value match {
    | Binop(BOAssignment(), _, _)
    | Binop(BOOpAssignment(_), _, _)
    | PostOp(PODecr(), _)
    | PostOp(POIncr(), _)
    | VoidOp(_) ->
      true
    | _ -> false
    }
  }

  fun checkBool(tcenv: mutable TCEnv, e: Expr): void {
    this.checkCondition(
      tcenv,
      e.pos,
      this.expr(tcenv, e, true),
      "A condition must be of type 'boolean'",
    )
  }

  // Emits the truthiness diagnostic (if any) for `ty` used in a boolean-test
  // position (if/while/for, ternary `?`, unary `!`, left operand of `&&`/`||`).
  // The `truthiness` mode only decides which types are flagged; type-checking
  // always continues afterwards with JavaScript value semantics, so the error
  // is recoverable (issue #654). `siteMsg` is the per-site wording used in
  // `boolean` mode, preserving today's diagnostics exactly.
  fun checkCondition(
    tcenv: mutable TCEnv,
    pos: PosRange,
    ty: TType,
    siteMsg: String,
  ): void {
    this.truthiness match {
    | TJavaScript() -> void
    // `boolean` mode is a pure type-conformance check: the condition must be
    // assignable to `boolean`. This is deliberately a different mechanism from
    // the relaxed modes below, which judge the *shape* of truthiness from
    // structural facts (`conditionVerdict`) rather than a subtype query —
    // keeping boolean mode's exact diagnostic and avoiding a subtype check on
    // the relaxed (default) hot path.
    | TBoolean() ->
      this.checkSubType(
        tcenv,
        pos,
        siteMsg,
        ty,
        TType::single(TPrimValue::boolean(pos)),
        ESLintCode("@typescript-eslint/strict-boolean-expressions"),
      )
    // `safe` and `typescript` share the always-truthy-function-ref check
    // (TS2774) but differ on void: `safe` rejects any void member, while
    // `typescript` matches tsc and rejects only a purely-`void` condition (a
    // `void | T` union is testable). The verdict supplies neutral facts; the
    // policy decisions live here.
    | relaxed @ TRelaxed() ->
      verdict = ty.conditionVerdict(tcenv.subst, this);
      voidIsError = relaxed match {
      | TSafe() -> verdict.containsVoid
      | TTypeScript() -> verdict.containsVoid && !verdict.hasObservable
      };
      if (voidIsError) {
        tcenv.error(
          Array[
            (pos, "An expression of type void cannot be tested for truthiness"),
          ],
          TSCode(1345),
        )
      } else if (
        // TS2774: every member is a callable object — a function or method
        // reference used directly as a condition, which is always truthy and
        // almost always a mistake. A callable object has no falsy values and is
        // never void, so `allCallable` already implies `falsyCount == FZero()`
        // and excludes any void member; `hasTruthy` is just the non-empty guard
        // (a callable object is truthy, the empty `never` type is not).
        verdict.allCallable &&
        verdict.hasTruthy
      ) {
        tcenv.error(
          Array[
            (
              pos,
              "This condition will always be true since this value is always defined",
            ),
          ],
          TSCode(2774),
        )
      } else if (
        // `safe` additionally requires a single falsy value, unless the type is
        // already structurally boolean (`allBoolean`) — testing a boolean is the
        // canonical safe truthiness test, and bool literals like `true` /
        // `false` don't fit the single-falsy rule. (`typescript` adds no check
        // beyond the void and TS2774 cases above.)
        relaxed is TSafe() &&
        !verdict.allBoolean &&
        (verdict.incomplete ||
          verdict.falsyCount != FOne() ||
          !verdict.hasTruthy)
      ) {
        tcenv.error(
          Array[
            (
              pos,
              "A condition is expected to be of type boolean or a type with a single falsy value",
            ),
          ],
          ESLintCode("@typescript-eslint/strict-boolean-expressions"),
        )
      }
    }
  }

  fun checkStringifiable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    // Check if the type is a primitive type that can be converted to string
    // Allowed types: string, number, bigint, boolean, null, undefined
    isStringifiable = ty.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      stypes.all(stype ->
        stype match {
        | TPrimValue(TString(), _, _) -> true
        | TPrimValue(TNum(), _, _) -> true
        | TPrimValue(TBigInt(), _, _) -> true
        | TPrimValue(TBool(), _, _) -> true
        | TPrimUnit(TNull(), _) -> true
        | TPrimUnit(TUndefined(), _) -> true
        | TPrimUnit(TVoid(), _) -> false
        | _ -> false
        }
      )
    };

    if (!isStringifiable) {
      tcenv.error(
        Array[
          (
            pos,
            "Template literal expressions must be of type string, number, bigint, boolean, null, or undefined",
          ),
        ],
        ESLintCode("@typescript-eslint/restrict-template-expressions"),
      );
    }
  }

  fun checkIsNumber(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): void {
    ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TNum(), _, _)) -> void
    | _ ->
      tcenv.error(
        Array[(pos, msg), (ty.pos, "This is not of type 'number'")],
        SKJSCode(2041),
      )
    };
  }

  fun checkIsNumeric(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): TPrimValueKind {
    ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(kind @ TNum(), _, _))
    | Some(TPrimValue(kind @ TBigInt(), _, _)) ->
      kind
    | _ ->
      fatalError(
        Array[
          (pos, msg),
          (ty.pos, "This is not a numeric type ('number' or 'bigint')"),
        ],
        SKJSCode(2041),
      )
    };
  }

  fun makeBoundTVar(
    tcenv: mutable TCEnv,
    ty: TType,
    origin: TVarOrigin,
  ): TType {
    tvar = tcenv.subst.gen(ty.pos);
    tcenv.subst.setOrigin(tvar, origin);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun makeBoundTVarForField(
    tcenv: mutable TCEnv,
    ty: TType,
    origin: TVarOrigin,
  ): TType {
    tvar = tcenv.subst.genForField(ty.pos);
    tcenv.subst.setOrigin(tvar, origin);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun newTVar(tcenv: mutable TCEnv, pos: PosRange, origin: TVarOrigin): TType {
    tvar = tcenv.subst.gen(pos);
    tcenv.subst.setOrigin(tvar, origin);
    TType::var(tvar)
  }

  fun checkLValue(tcenvb: mutable TCEnvBase, e: Expr): void {
    e.value match {
    | Var(Name(_, "super")) ->
      tcenvb.error(
        Array[
          (
            e.pos,
            "The left-hand side of an assignment must be a variable or a property access",
          ),
        ],
        TSCode(2364),
      )
    | Var _ -> void
    | Get _ -> void
    | EArray _ -> void
    | Dot(NormalDot(), e1, _) -> this.checkLValue(tcenvb, e1)
    | _ ->
      tcenvb.error(
        Array[
          (
            e.pos,
            "The left-hand side of an assignment must be a variable or a property access",
          ),
        ],
        TSCode(2364),
      )
    }
  }
}

fun paramsError<T>(pos: PosRange): T {
  fatalError(
    Array[
      (
        pos,
        "Type annotations in parentheses are not valid in an expression. " +
          "Use type assertions with 'as' keyword instead",
      ),
    ],
    SKJSCode(2061),
  )
}

module end;
