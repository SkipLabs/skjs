module SKJS;

extension class TypeChecker {
  fun isVoid(tcenv: mutable TCEnv, isAsync: Bool, ty: TType): Bool {
    clauses = ty.expand(tcenv.subst, this.tenv, Covariant());
    for (clause in clauses.clauses) {
      clause.stypes match {
      | None() -> return false
      | Some(stypes) ->
        stypes.singleElt() match {
        | Some(TPrimUnit(TVoid(), _)) if (!isAsync) -> void
        | Some(TPromise(realType, _)) if (isAsync) ->
          if (!this.isVoid(tcenv, false, realType)) {
            return false
          }
        | _ -> return false
        }
      }
    };
    true
  }

  // Returns true if the type is not Top but contains void
  fun nonTopContainsVoid(tcenv: mutable TCEnv, ty: TType): Bool {
    clauses = ty.expand(tcenv.subst, this.tenv, Covariant());
    for (clause in clauses.clauses) {
      clause.stypes match {
      | Some(stypes) if (stypes.any(stype ~> stype is TPrimUnit(TVoid(), _))) ->
        return true
      | _ -> void
      }
    };
    false
  }

  static private fun filterMethods(
    ty: TType,
    subst: mutable Subst,
    tenv: TEnv,
  ): TType {
    ty.getSTypes(subst, tenv, Covariant()).flatMap(stypes ~> {
      stypes.singleElt()
    }) match {
    | Some(TObject(fields, pos)) ->
      TType::single(
        TObject(
          fields.filterMap(field -> {
            fieldType = field.type;
            fieldType
              .mapSTypes(subst, tenv, Covariant(), fieldSTypes -> {
                fieldSTypes.filter(fieldSType ~> {
                  fieldSType match {
                  | TFuns(funs, _methods, _pos) if (funs.isEmpty()) -> false
                  | TFuns(_funs, methods, _pos) if (!methods.isEmpty()) ->
                    internal_error(
                      "TODO: encountered both non-empty funs and methods in filterMethod",
                    )
                  //Some(tfuns with {methods => Array[]})
                  | _ -> true
                  }
                })
              })
              .flatMap((fieldType) ->
                if (fieldType.isBottom()) None() else {
                  Some(field.mapType(_existingType -> fieldType))
                }
              )
          }),
          pos,
        ),
      )
    | _ -> internal_error("Internal error: new should produce an object")
    }
  }

  fun checkSubType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
  ): void {
    isSubTType(tcenv.subst, this.tenv, ty1, ty2) match {
    | STOk() -> void
    | STRec(reason, pos1, subTy2) ->
      typingError(
        Array[
          (pos, msg),
          (
            pos1,
            reason.toString(
              tcenv.subst,
              this.tenv,
              expandTVars(tcenv.subst, this.tenv, ty1),
            ),
          ),
          (
            subTy2.pos,
            "It is incompatible with: " +
              expandTVars(tcenv.subst, this.tenv, subTy2).toString(),
          ),
        ],
      )
    | err @ STError _ ->
      typingError(Array[(pos, err.toString(tcenv.subst, this.tenv, ty1))])
    }
  }

  fun checkIsVoid(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type void",
      ty,
      TType::single(TPrimUnit(TVoid(), ty.pos)),
    );
  }

  fun checkIsIgnorable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    tyVoid = TType::single(TPrimUnit(TVoid(), ty.pos));
    ignorable = TType::union(
      tcenv.subst,
      this.tenv,
      tyVoid,
      TType::single(
        TObject(
          TFields::create(
            Array[
              TField::create(pos, "__SKJS_Ignorable", false, tyVoid).fromSome(),
            ],
            Array[],
          ),
          pos,
        ),
      ),
    );
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type void or ignorable",
      ty,
      ignorable,
    )
  }

  static fun isPossiblyNonVoidExpressionAllowedAsStatement(e: Expr): Bool {
    e.value match {
    | Binop(BOAssignment(), _, _)
    | Binop(BOOpAssignment(_), _, _)
    | PostOp(PODecr(), _)
    | PostOp(POIncr(), _) ->
      true
    | _ -> false
    }
  }

  fun checkBool(tcenv: mutable TCEnv, e: Expr): void {
    this.checkSubType(
      tcenv,
      e.pos,
      "A condition is expected to be of type boolean, not: ",
      this.expr(tcenv, e),
      TType::single(TPrimValue::boolean(e.pos)),
    );
  }

  fun checkStringifiable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    // Check if the type is a primitive type that can be converted to string
    // Allowed types: string, number, bigint, boolean, null, undefined
    isStringifiable = ty.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      stypes.singleElt() match {
      | Some(TPrimValue(TString(), _, _)) -> true
      | Some(TPrimValue(TNum(), _, _)) -> true
      | Some(TPrimValue(TBigInt(), _, _)) -> true
      | Some(TPrimValue(TBool(), _, _)) -> true
      | Some(TPrimUnit(TNull(), _)) -> true
      | Some(TPrimUnit(TUndefined(), _)) -> true
      | Some(TPrimUnit(TVoid(), _)) -> true
      | _ -> false
      }
    };

    if (!isStringifiable) {
      typingError(
        Array[
          (
            pos,
            "Template literal expressions must be string, number, bigint, boolean, null, or undefined",
          ),
        ],
      );
    }
  }

  fun checkIsNumber(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): void {
    ty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TNum(), _, _)) -> void
    | _ -> typingError(Array[(pos, msg), (ty.pos, "This is not a number")])
    };
  }

  fun checkIsNumeric(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): TPrimValueKind {
    ty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(kind @ TNum(), _, _))
    | Some(TPrimValue(kind @ TBigInt(), _, _)) ->
      kind
    | _ ->
      typingError(
        Array[
          (pos, msg),
          (ty.pos, "This is not a numeric type (number or bigint)"),
        ],
      )
    };
  }

  fun makeBoundTVar(tcenv: mutable TCEnv, ty: TType): TType {
    tvar = tcenv.subst.gen(ty.pos);
    tcenv.subst.grow(this.tenv, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun newTVar(tcenv: mutable TCEnv, pos: PosRange): TType {
    tvar = tcenv.subst.gen(pos);
    TType::var(tvar)
  }

  fun checkLValue(e: Expr): void {
    e.value match {
    | Var(Name(_, "super")) -> typingError(Array[(e.pos, "Invalid lvalue")])
    | Var _ -> void
    | Get _ -> void
    | EArray _ -> void
    | Binop(BODot(), e1, Expr(_, Var(_))) -> this.checkLValue(e1)
    | _ -> typingError(Array[(e.pos, "Invalid lvalue")])
    }
  }
}

fun paramsError<T>(pos: PosRange): T {
  typingError(
    Array[
      (
        pos,
        "Type annotations in parentheses are not valid in an expression." +
          "Use type assertions with 'as' keyword instead",
      ),
    ],
  )
}

module end;
