module SKJS;

// See TypeChecker::viewInfoFor / checkSubTypeView.
base class ViewInfo {
  children =
  | VINone()
  // Ownership-transfer check. None = a fresh literal expression (transparent
  // check, nothing to retype). Some(n) = the first view of the unannotated
  // local n (transparent check, then retype n to the accumulated intersection).
  | VITransfer(?Name)
}

// Demote a transfer view to the no-retype form (a fresh literal): used where
// transfer transparency applies but no named local should be retyped — a call
// argument, a non-async return, an `as`/`satisfies`.
fun demoteToFresh(vi: ViewInfo): ViewInfo {
  vi match {
  | VITransfer _ -> VITransfer(None())
  | x -> x
  }
}

extension class TypeChecker {
  // tsc's TS1062, reported wherever an awaited-type computation
  // (TType::maybeAwaited) hits a then-callback cycle.
  fun errorSelfReferentialThenable(tcenv: mutable TCEnv, pos: PosRange): void {
    tcenv.error(
      Array[
        (
          pos,
          "Type is referenced directly or indirectly in the fulfillment callback of its own 'then' method",
        ),
      ],
      TSCode(1062),
    )
  }

  fun isVoid(tcenv: mutable TCEnv, isAsync: Bool, ty: TType): Bool {
    clauses = ty.expandToClauses(tcenv.subst, this, Covariant());
    for (clause in clauses) {
      clause.stypes match {
      | None() -> return false
      | Some(stypes) ->
        stypes.singleElt() match {
        | Some(TPrimUnit(TVoid(), _)) if (!isAsync) -> void
        | Some(obj @ TObject _) if (isAsync) ->
          obj.getAwaitedType(tcenv.subst, this, obj.pos) match {
          | Some(realType) ->
            if (!this.isVoid(tcenv, false, realType)) {
              return false
            }
          | None() -> return false
          }
        | _ -> return false
        }
      }
    };
    true
  }

  // Returns true if the type is not Top but contains void
  fun nonTopContainsVoid(tcenv: mutable TCEnv, ty: TType): Bool {
    clauses = ty.expandToClauses(tcenv.subst, this, Covariant());
    for (clause in clauses) {
      clause.stypes match {
      | Some(stypes) if (stypes.any(stype ~> stype is TPrimUnit(TVoid(), _))) ->
        return true
      | _ -> void
      }
    };
    false
  }

  static private fun filterMethods(
    ty: TType,
    subst: mutable Subst,
    tenv: TEnv,
    methods: SortedSet<String>,
  ): TType {
    ty.getSTypes(subst, tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(obj @ TObject _) -> TType::single(obj.removeFields(methods))
    | _ ->
      subst.error(
        Array[(ty.pos, "Internal error: new should produce an object")],
        SKJSCode(9999),
      );
      ty
    }
  }

  fun checkSubType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
    code: ErrorCode,
  ): void {
    TType::isSub(tcenv.subst, this, ty1, ty2) match {
    | STOk() -> void
    | err @ STErrorOnTType _ ->
      tcenv.subtypingError(tcenv.subst, this, Array[(pos, msg)], err, code)
    }
  }

  // How the checked expression relates to the type it is checked against
  // (its "view"):
  // - VITransfer(None): a fresh literal expression; the check is an ownership
  //   transfer (the value's only type afterwards is the view type).
  // - VITransfer(Some(n)): the FIRST view of the unannotated local object n;
  //   an ownership transfer after which n is retyped to the accumulation.
  // - VINone: plain subtyping.
  // Must be captured BEFORE evaluating the expression — evaluating a Var
  // flips its local-object state to LOUsed, which is what makes the
  // transfer right unique.
  fun viewInfoFor(tcenv: mutable TCEnv, e: Expr): ViewInfo {
    e.value match {
    | Object _ -> VITransfer(None())
    | EArray _ -> VITransfer(None())
    | Var(n) if (n.value != "this") ->
      tcenv.localObjectState(n) match {
      | Some(LOCanGrow _) -> VITransfer(Some(n))
      | _ -> VINone()
      }
    | _ -> VINone()
    }
  }

  // Collect the positions of the closed-literal marker indexes that belong
  // to the FRESH value being transferred. Only these markers are eligible
  // for setter waiving during the transfer check. The walk descends into a
  // field get (or array element) ONLY through a bare one-hop
  // FromObjectField / FromArrayElement bound TVar — that wrapper is the
  // freshness-provenance signal (literal field values get wrapped, embedded
  // variables do not), so the markers of an embedded, separately-typed
  // value are never eligible.
  fun collectEligibleMarkers(
    tcenv: mutable TCEnv,
    ty: TType,
  ): SortedSet<PosRange> {
    subst = tcenv.subst;
    eligible = mutable Vector<PosRange>[];
    seenTys = mutable Vector<TType>[];
    walkTy: (TType -> void) = _ -> void;
    walkWrapperTVar: (TVar -> void) = _ -> void;

    expandIfWrapper: (TType -> void) = innerTy -> {
      // Bare single-inst TVar of wrapper origin: expand to its bound.
      if (innerTy.clauses.isEmpty()) {
        insts = innerTy.insts.values().collect(Array);
        if (insts.size() == 1) {
          insts[0] match {
          | tvar @ TVar _ -> walkWrapperTVar(tvar)
          | _ -> void
          }
        }
      }
    };

    !walkWrapperTVar = tvar -> {
      subst.getOrigin(tvar) match {
      | Some(FromObjectField _)
      | Some(FromArrayElement _) ->
        subst.peekRaw(tvar) match {
        | Some(raw) -> walkTy(raw)
        | None() -> void
        }
      | _ -> void
      }
    };

    !walkTy = t -> {
      if (seenTys.contains(t)) return void;
      seenTys.push(t);
      for (clause in t.clauses.values()) {
        clause.stypes match {
        | None() -> void
        | Some(stypes) ->
          for (stype in stypes.values()) {
            stype match {
            | obj @ TObject _ ->
              _ = obj.map(fs -> {
                fs.closedLiteralPos match {
                | Some(p) ->
                  eligible.push(p);
                  // Nested fresh literals sit behind wrapper TVars in the
                  // field gets of this fresh literal.
                  _ = fs.map(
                    fd -> {
                      expandIfWrapper(fd.get);
                      fd
                    },
                    funs -> funs,
                  )
                | None() -> void
                };
                fs
              })
            | _ -> void
            }
          }
        }
      };
      for (inst in t.insts.values()) {
        inst match {
        | tvar @ TVar _ -> walkWrapperTVar(tvar)
        | TArrayLit(tvar, tupleElts, _freshElts) ->
          walkWrapperTVar(tvar);
          // Fresh object-literal elements live in tupleElts behind
          // FromArrayElement wrapper TVars; freshElts only records primitive
          // literal types (directLiteralSType), which carry no marker.
          for (e in tupleElts) expandIfWrapper(e)
        | _ -> void
        }
      }
    };
    walkTy(ty);
    result = SortedSet<PosRange>[];
    for (p in eligible) !result = result.set(p);
    result
  }

  // Run a subtype check as an OWNERSHIP TRANSFER: the eligible closed-literal
  // markers of ty1 impose no setter obligations (the value is fresh; its
  // type is replaced by the target). Set/reset of the mode brackets exactly
  // this one check; the flag lives on Subst (not SubstState) so inner
  // save/restore cannot toggle it.
  fun checkSubTypeTransfer(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
    code: ErrorCode,
  ): void {
    prevMode = tcenv.subst.transferMode;
    prevEligible = tcenv.subst.transferEligible;
    tcenv.subst.!transferEligible = this.collectEligibleMarkers(tcenv, ty1);
    tcenv.subst.!transferMode = true;
    this.checkSubType(tcenv, pos, msg, ty1, ty2, code);
    tcenv.subst.!transferMode = prevMode;
    tcenv.subst.!transferEligible = prevEligible
  }

  // checkSubType for expression-against-view positions.
  fun checkSubTypeView(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
    code: ErrorCode,
    view: ViewInfo,
  ): void {
    view match {
    | VINone() -> this.checkSubType(tcenv, pos, msg, ty1, ty2, code)
    // Fresh literal: transparent check, nothing to retype.
    | VITransfer(None()) ->
      this.checkSubTypeTransfer(tcenv, pos, msg, ty1, ty2, code)
    | VITransfer(Some(n)) ->
      if (tcenv.scope.isThroughLoop(n)) {
        // A local declared outside a loop cannot be retyped from inside it,
        // so the granted view would go unrecorded — a later write through
        // the view would invalidate the local's still-precise type. Check
        // plain instead (conservative; declare the local inside the loop or
        // annotate it to get the view).
        this.checkSubType(tcenv, pos, msg, ty1, ty2, code)
      } else {
        this.checkSubTypeTransfer(tcenv, pos, msg, ty1, ty2, code);
        // Ownership transfer: retype the local to the INTERSECTION of its
        // current type and the view type, so later views are plain-checked
        // against the accumulation of every view taken so far (not just the
        // latest). The view is the first inter argument so its real field and
        // index names/positions win the tiebreak: an index the view commits
        // de-markers that position, so a later index view of the same local is
        // plain-checked and rejected (testDualIndexedAssignment); meanwhile the
        // literal's closed marker survives wherever the view names no index, so
        // disjoint-key views of an existing-field literal compose without one
        // consuming the others (objCounterExample). Each view also lands as a
        // real named field, which keeps the aliasing witnesses rejected: real
        // fields are never waived, so a mutable view of a key an earlier
        // (readonly) view fixed fails the setter leg. Clone the subst so inter's
        // unifications do not leak into the main one. Retype even when the check
        // failed: the accumulated type governs from here on, avoiding cascades.
        retyped = TType::inter(tcenv.subst.clone(), this, ty2, ty1);
        tcenv.scope.set(n, retyped, (x, y) ->
          this.checkSubType(tcenv, pos, msg, x, y, code)
        )
      }
    }
  }

  // Clear the closed-literal marker from a fresh-literal value being stored
  // into a field (see assignLocalObjectByKeys). Operates only on a concrete
  // single-object type, NEVER expanding a TVar / type parameter to its bound
  // (so `this.field = paramOfTypeT` keeps type T). Without this, the stored
  // value would remain a closed literal and act as a closed `super` (its
  // implicit `never` index) in later field-type checks.
  fun stripClosedLiteralIndex(_tcenv: mutable TCEnv, ty: TType): TType {
    if (!ty.insts.isEmpty()) return ty;
    clausesArr = ty.clauses.values().collect(Array);
    if (clausesArr.size() != 1) return ty;
    clause = clausesArr[0];
    if (!clause.vars.isEmpty()) return ty;
    clause.stypes.flatMap(stypes -> stypes.singleElt()) match {
    | Some(obj @ TObject _) ->
      TType::single(obj.map(fs -> fs.clearClosedLiteral()))
    | _ -> ty
    }
  }

  // Strip a fresh-literal argument's closed marker when the parameter is a bare
  // unbound inference variable: the value is committed to inference as an
  // element (main's synthetic-index TVar behaved open in that position), so it
  // must not later act as a closed `super`. A concrete or object-shaped
  // parameter keeps the marker (needed for the ownership-transfer waiver).
  fun stripClosedForInferenceParam(
    tcenv: mutable TCEnv,
    argTy: TType,
    paramTy: TType,
  ): TType {
    paramTy.getSingleVar() match {
    | Some(tvar) if (tcenv.subst.isUnbound(tvar)) ->
      this.stripClosedLiteralIndex(tcenv, argTy)
    | _ -> argTy
    }
  }

  fun checkIsVoid(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type 'void'",
      ty,
      TType::single(TPrimUnit(TVoid(), ty.pos)),
      SKJSCode(2002),
    );
  }

  fun checkIsIgnorable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    if (
      ty.clauses.isEmpty() &&
      ty.insts.getUnique() is Some(TSInst(Name(_, "SKJS_Ignorable"), _))
    ) {
      return void
    };
    tyVoid = TType::single(TPrimUnit(TVoid(), ty.pos));
    this.checkSubType(
      tcenv,
      pos,
      "This expression was expected to be of type 'void' or ignorable",
      ty,
      tyVoid,
      SKJSCode(2002),
    )
  }

  static fun isPossiblyNonVoidExpressionAllowedAsStatement(e: Expr): Bool {
    e.value match {
    | Binop(BOAssignment(), _, _)
    | Binop(BOOpAssignment(_), _, _)
    | PostOp(PODecr(), _)
    | PostOp(POIncr(), _)
    | VoidOp(_) ->
      true
    | _ -> false
    }
  }

  fun checkBool(tcenv: mutable TCEnv, e: Expr): void {
    this.checkCondition(
      tcenv,
      e.pos,
      this.expr(tcenv, e, true),
      "A condition must be of type 'boolean'",
    )
  }

  // Emits the truthiness diagnostic (if any) for `ty` used in a boolean-test
  // position (if/while/for, ternary `?`, unary `!`, left operand of `&&`/`||`).
  // The `truthiness` mode only decides which types are flagged; type-checking
  // always continues afterwards with JavaScript value semantics, so the error
  // is recoverable (issue #654). `siteMsg` is the per-site wording used in
  // `boolean` mode, preserving today's diagnostics exactly.
  fun checkCondition(
    tcenv: mutable TCEnv,
    pos: PosRange,
    ty: TType,
    siteMsg: String,
  ): void {
    this.truthiness match {
    | TJavaScript() -> void
    // `boolean` mode is a pure type-conformance check: the condition must be
    // assignable to `boolean`. This is deliberately a different mechanism from
    // the relaxed modes below, which judge the *shape* of truthiness from
    // structural facts (`conditionVerdict`) rather than a subtype query —
    // keeping boolean mode's exact diagnostic and avoiding a subtype check on
    // the relaxed (default) hot path.
    | TBoolean() ->
      this.checkSubType(
        tcenv,
        pos,
        siteMsg,
        ty,
        TType::single(TPrimValue::boolean(pos)),
        ESLintCode("@typescript-eslint/strict-boolean-expressions"),
      )
    // `safe` and `typescript` share the always-truthy-function-ref check
    // (TS2774) but differ on void: `safe` rejects any void member, while
    // `typescript` matches tsc and rejects only a purely-`void` condition (a
    // `void | T` union is testable). The verdict supplies neutral facts; the
    // policy decisions live here.
    | relaxed @ TRelaxed() ->
      verdict = ty.conditionVerdict(tcenv.subst, this);
      voidIsError = relaxed match {
      | TSafe() -> verdict.containsVoid
      | TTypeScript() -> verdict.containsVoid && !verdict.hasObservable
      };
      if (voidIsError) {
        tcenv.error(
          Array[
            (pos, "An expression of type void cannot be tested for truthiness"),
          ],
          TSCode(1345),
        )
      } else if (
        // TS2774: every member is a callable object — a function or method
        // reference used directly as a condition, which is always truthy and
        // almost always a mistake. A callable object has no falsy values and is
        // never void, so `allCallable` already implies `falsyCount == FZero()`
        // and excludes any void member; `hasTruthy` is just the non-empty guard
        // (a callable object is truthy, the empty `never` type is not).
        verdict.allCallable &&
        verdict.hasTruthy
      ) {
        tcenv.error(
          Array[
            (
              pos,
              "This condition will always be true since this value is always defined",
            ),
          ],
          TSCode(2774),
        )
      } else if (
        // `safe` additionally requires a single falsy value, unless the type is
        // already structurally boolean (`allBoolean`) — testing a boolean is the
        // canonical safe truthiness test, and bool literals like `true` /
        // `false` don't fit the single-falsy rule. (`typescript` adds no check
        // beyond the void and TS2774 cases above.)
        relaxed is TSafe() &&
        !verdict.allBoolean &&
        (verdict.incomplete ||
          verdict.falsyCount != FOne() ||
          !verdict.hasTruthy)
      ) {
        tcenv.error(
          Array[
            (
              pos,
              "A condition is expected to be of type boolean or a type with a single falsy value",
            ),
          ],
          ESLintCode("@typescript-eslint/strict-boolean-expressions"),
        )
      }
    }
  }

  fun checkStringifiable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {
    // Check if the type is a primitive type that can be converted to string
    // Allowed types: string, number, bigint, boolean, null, undefined
    isStringifiable = ty.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      stypes.all(stype ->
        stype match {
        | TPrimValue(TString(), _, _) -> true
        | TPrimValue(TNum(), _, _) -> true
        | TPrimValue(TBigInt(), _, _) -> true
        | TPrimValue(TBool(), _, _) -> true
        | TPrimUnit(TNull(), _) -> true
        | TPrimUnit(TUndefined(), _) -> true
        | TPrimUnit(TVoid(), _) -> false
        | _ -> false
        }
      )
    };

    if (!isStringifiable) {
      tcenv.error(
        Array[
          (
            pos,
            "Template literal expressions must be of type string, number, bigint, boolean, null, or undefined",
          ),
        ],
        ESLintCode("@typescript-eslint/restrict-template-expressions"),
      );
    }
  }

  fun checkIsNumber(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): void {
    ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TNum(), _, _)) -> void
    | _ ->
      tcenv.error(
        Array[(pos, msg), (ty.pos, "This is not of type 'number'")],
        SKJSCode(2041),
      )
    };
  }

  fun checkIsNumeric(
    tcenv: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): TPrimValueKind {
    ty.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(kind @ TNum(), _, _))
    | Some(TPrimValue(kind @ TBigInt(), _, _)) ->
      kind
    | _ ->
      fatalError(
        Array[
          (pos, msg),
          (ty.pos, "This is not a numeric type ('number' or 'bigint')"),
        ],
        SKJSCode(2041),
      )
    };
  }

  fun makeBoundTVar(
    tcenv: mutable TCEnv,
    ty: TType,
    origin: TVarOrigin,
  ): TType {
    tvar = tcenv.subst.gen(ty.pos);
    tcenv.subst.setOrigin(tvar, origin);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun makeBoundTVarForField(
    tcenv: mutable TCEnv,
    ty: TType,
    origin: TVarOrigin,
  ): TType {
    tvar = tcenv.subst.genForField(ty.pos);
    tcenv.subst.setOrigin(tvar, origin);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun makeBoundTVarForLiteralCommitment(
    tcenv: mutable TCEnv,
    ty: TType,
    origin: TVarOrigin,
  ): TType {
    tvar = tcenv.subst.genForLiteralCommitment(ty.pos);
    tcenv.subst.setOrigin(tvar, origin);
    tcenv.subst.grow(this, tvar, ty, Contravariant());
    TType::var(tvar)
  }

  fun newTVar(tcenv: mutable TCEnv, pos: PosRange, origin: TVarOrigin): TType {
    tvar = tcenv.subst.gen(pos);
    tcenv.subst.setOrigin(tvar, origin);
    TType::var(tvar)
  }

  fun checkLValue(tcenvb: mutable TCEnvBase, e: Expr): void {
    e.value match {
    | Var(Name(_, "super")) ->
      tcenvb.error(
        Array[
          (
            e.pos,
            "The left-hand side of an assignment must be a variable or a property access",
          ),
        ],
        TSCode(2364),
      )
    | Var _ -> void
    | Get _ -> void
    | EArray _ -> void
    | Dot(NormalDot(), e1, _) -> this.checkLValue(tcenvb, e1)
    | _ ->
      tcenvb.error(
        Array[
          (
            e.pos,
            "The left-hand side of an assignment must be a variable or a property access",
          ),
        ],
        TSCode(2364),
      )
    }
  }
}

fun paramsError<T>(pos: PosRange): T {
  fatalError(
    Array[
      (
        pos,
        "Type annotations in parentheses are not valid in an expression. " +
          "Use type assertions with 'as' keyword instead",
      ),
    ],
    SKJSCode(2061),
  )
}

module end;
