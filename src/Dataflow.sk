// Forward intra-procedural worklist solver

module SKJS;

// Runs a forward data-flow analysis to a fixpoint over `cfg`, returning the
// pre-state computed for each reachable block. `domain` is a seed instance of
// the analysis: the solver calls its `init`/`bottom`/`transfer*` methods to
// bootstrap and to model each block, and merges states with `widen` (which
// defaults to `join`). Blocks unreachable from the entry are simply absent from
// the result — their pre-state is `bottom`.
//
// For each popped block the solver computes the block body `post`-state once,
// then pushes state along every successor edge using transferTerminator for normal
// control flow and transferExn for exceptional control flow (both mid-block implicit
// throws and block-terminating explicit `throw`s)

fun analyzeForward<D: AbstractDomain>(
  cfg: CFG,
  domain: D,
): SortedMap<CFGBlockId, D> {
  bottom = domain.bottom();
  preStates = SortedMap<CFGBlockId, D>[];
  !preStates[cfg.entry] = domain.init();

  // `queued` mirrors the set of block ids currently in `worklist`, so a block
  // is never enqueued twice concurrently. `CFGBlockId` is Orderable but not
  // Hashable, hence a SortedSet rather than a mutable Set.
  worklist = mutable Vector<CFGBlockId>[];
  worklist.push(cfg.entry);
  queued = SortedSet<CFGBlockId>[].set(cfg.entry);

  while (!worklist.isEmpty()) {
    blockId = worklist.pop();
    !queued = queued.remove(blockId);
    block = cfg.blocks.get(blockId);
    blockPre = preStates.maybeGet(blockId).default(bottom);
    // Block body only; the terminator is modeled per outgoing edge below.
    post = domain.transfer(block.instrs, blockPre);
    for ((label, target) in cfg.successors(block)) {
      edgeState = label match {
      | CFGEException() -> domain.transferExn(block, blockPre)
      | normal @ CFGENormalLabel _ ->
        domain.transferTerminator(block.terminator, post, normal)
      };
      old = preStates.maybeGet(target).default(bottom);
      merged = old.widen(edgeState);
      // `widen` is an upper bound, so `merged <= old` exactly when nothing grew.
      if (!(merged <= old)) {
        !preStates[target] = merged;
        if (!queued.contains(target)) {
          worklist.push(target);
          !queued = queued.set(target)
        }
      }
    }
  };
  preStates
}

module end;
