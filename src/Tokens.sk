/***************************************************************************/
/* Tokens recognized by the Lexer. */
/***************************************************************************/

module SKJS;

value class Token(kind: TokenKind, posStart: Pos, posEnd: Pos)

base class TokenKind uses Equality, XXHashable, Hashable, Show {
  children =
  | TKAddQM()
  | TKAddition()
  | TKAdditionAssignment()
  | TKAssignment()
  | TKBackTick()
  | TKBigInt()
  | TKBitwiseAnd()
  | TKBitwiseAndAssignment()
  | TKBitwiseOr()
  | TKBitwiseOrAssignment()
  | TKBitwiseXor()
  | TKBitwiseXorAssignment()
  | TKCloseCurly()
  | TKCloseParen()
  | TKCloseSquare()
  | TKClosure()
  | TKColon()
  | TKComma()
  | TKDecr()
  | TKDivision()
  | TKDivisionAssignment()
  | TKDot()
  | TKDotDotDot()
  | TKDoubleQuote()
  | TKEquality()
  | TKExclamationMark()
  | TKExclamationMarkDot()
  | TKExponentiation()
  | TKExponentiationAssignment()
  | TKGreaterThan()
  | TKGreaterThanOrEqual()
  | TKIncr()
  | TKInequality()
  | TKLeftShift()
  | TKLeftShiftAssignment()
  | TKLessThan()
  | TKLessThanOrEqual()
  | TKLogicalAnd()
  | TKLogicalAndAssignment()
  | TKLogicalOr()
  | TKLogicalOrAssignment()
  | TKMultiplication()
  | TKMultiplicationAssignment()
  | TKNullishCoalescing()
  | TKNullishCoalescingAssignment()
  | TKNumber()
  | TKOpenCurly()
  | TKOpenParen()
  | TKOpenSquare()
  | TKQuestionMark()
  | TKQuestionMarkDot()
  | TKQuote()
  | TKRemainder()
  | TKRemainderAssignment()
  | TKRemoveQM()
  | TKSemi()
  | TKSignedRightShift()
  | TKSignedRightShiftAssignment()
  | TKStrictEquality()
  | TKStrictInequality()
  | TKSubtraction()
  | TKSubtractionAssignment()
  | TKTild()
  | TKVar()
  | TKZeroFilledRightShift()
  | TKZeroFilledRightShiftAssignment()

  fun toString(): String
  | TKAddQM() -> "+?"
  | TKAddition() -> "+"
  | TKAdditionAssignment() -> "+="
  | TKAssignment() -> "="
  | TKBackTick() -> "`"
  | TKBigInt() -> "a bigint"
  | TKBitwiseAnd() -> "&"
  | TKBitwiseAndAssignment() -> "&="
  | TKBitwiseOr() -> "|"
  | TKBitwiseOrAssignment() -> "|="
  | TKBitwiseXor() -> "^"
  | TKBitwiseXorAssignment() -> "^="
  | TKCloseCurly() -> "}"
  | TKCloseParen() -> ")"
  | TKCloseSquare() -> "]"
  | TKClosure() -> "=>"
  | TKColon() -> ":"
  | TKComma() -> ","
  | TKDecr() -> "--"
  | TKDivision() -> "/"
  | TKDivisionAssignment() -> "/="
  | TKDot() -> "."
  | TKDotDotDot() -> "..."
  | TKDoubleQuote() -> "\""
  | TKEquality() -> "=="
  | TKExclamationMark() -> "!"
  | TKExclamationMarkDot() -> "!."
  | TKExponentiation() -> "**"
  | TKExponentiationAssignment() -> "**="
  | TKGreaterThan() -> ">"
  | TKGreaterThanOrEqual() -> ">="
  | TKIncr() -> "++"
  | TKInequality() -> "!="
  | TKLeftShift() -> "<<"
  | TKLeftShiftAssignment() -> "<<="
  | TKLessThan() -> "<"
  | TKLessThanOrEqual() -> "<="
  | TKLogicalAnd() -> "&&"
  | TKLogicalAndAssignment() -> "&&="
  | TKLogicalOr() -> "||"
  | TKLogicalOrAssignment() -> "||="
  | TKMultiplication() -> "*"
  | TKMultiplicationAssignment() -> "*="
  | TKNullishCoalescing() -> "??"
  | TKNullishCoalescingAssignment() -> "??="
  | TKNumber() -> "a number"
  | TKOpenCurly() -> "{"
  | TKOpenParen() -> "("
  | TKOpenSquare() -> "["
  | TKQuestionMark() -> "?"
  | TKQuestionMarkDot() -> "?."
  | TKQuote() -> "'"
  | TKRemainder() -> "%"
  | TKRemainderAssignment() -> "%="
  | TKRemoveQM() -> "-?"
  | TKSemi() -> ";"
  | TKSignedRightShift() -> ">>"
  | TKSignedRightShiftAssignment() -> ">>="
  | TKStrictEquality() -> "==="
  | TKStrictInequality() -> "!=="
  | TKSubtraction() -> "-"
  | TKSubtractionAssignment() -> "-="
  | TKTild() -> "~"
  | TKVar() -> "a variable name"
  | TKZeroFilledRightShift() -> ">>>"
  | TKZeroFilledRightShiftAssignment() -> ">>>="
}

/***************************************************************************/
// A special character is a character than can represent an operator
// with multiple characters. So for example, '.' can be "...", + can
// be "+=" etc ...
/***************************************************************************/

const specialChars: Set<Char> = Set[
  '.',
  '*',
  '/',
  '%',
  '+',
  '-',
  '<',
  '>',
  '=',
  '!',
  '&',
  '^',
  '|',
  '?',
];

/***************************************************************************/
// Table that associates an operator to a string.
/***************************************************************************/

const operators: Map<String, TokenKind> = Map[
  "++" => TKIncr(),
  "--" => TKDecr(),
  "-?" => TKRemoveQM(),
  "+?" => TKAddQM(),
  "**" => TKExponentiation(),
  "*" => TKMultiplication(),
  "/" => TKDivision(),
  "%" => TKRemainder(),
  "+" => TKAddition(),
  "-" => TKSubtraction(),
  "<<" => TKLeftShift(),
  ">>" => TKSignedRightShift(),
  ">>>" => TKZeroFilledRightShift(),
  "<" => TKLessThan(),
  "<=" => TKLessThanOrEqual(),
  ">" => TKGreaterThan(),
  ">=" => TKGreaterThanOrEqual(),
  "==" => TKEquality(),
  "!=" => TKInequality(),
  "===" => TKStrictEquality(),
  "!==" => TKStrictInequality(),
  "&" => TKBitwiseAnd(),
  "^" => TKBitwiseXor(),
  "|" => TKBitwiseOr(),
  "&&" => TKLogicalAnd(),
  "||" => TKLogicalOr(),
  "??" => TKNullishCoalescing(),
  "=" => TKAssignment(),
  "**=" => TKExponentiationAssignment(),
  "*=" => TKMultiplicationAssignment(),
  "/=" => TKDivisionAssignment(),
  "%=" => TKRemainderAssignment(),
  "+=" => TKAdditionAssignment(),
  "-=" => TKSubtractionAssignment(),
  "<<=" => TKLeftShiftAssignment(),
  ">>=" => TKSignedRightShiftAssignment(),
  ">>>=" => TKZeroFilledRightShiftAssignment(),
  "&=" => TKBitwiseAndAssignment(),
  "^=" => TKBitwiseXorAssignment(),
  "|=" => TKBitwiseOrAssignment(),
  "&&=" => TKLogicalAndAssignment(),
  "||=" => TKLogicalOrAssignment(),
  "??=" => TKNullishCoalescingAssignment(),
  "=>" => TKClosure(),
  "?." => TKQuestionMarkDot(),
  "!." => TKExclamationMarkDot(),
  "?" => TKQuestionMark(),
  "!" => TKExclamationMark(),
];

/***************************************************************************/
// Type to represent operators associativity.
/***************************************************************************/

base class Associativity {
  children =
  | ALeft()
  | ARight()
}

/***************************************************************************/
// Operators associativity and precedence.
/***************************************************************************/

const callPrecHigh: Int = 22;
const callPrecLow: Int = 21;
const postfixPrec: Int = 19;
const prefixPrec: Int = 18;
const asPrec: Int = 13;
const in_and_instanceofPrec: Int = 12;
const ternaryPrec: Int = 4;
const closurePrec: Int = 3;

const binaryOperators: Map<
  TokenKind,
  (Associativity, Int, BinaryOperator),
> = Map[
  /* 23: (x) (non-assoc) */
  /* 22: x[y], x.y, x?.y, x!.y, new x(y) (non-assoc) (callPrecHigh) */
  /* 21: x[y], x.y, x?.y, x!.y, new x(y), x(y) (non-assoc) (callPrecLow) */
  /* 20: new x (no argument list) (non-assoc) => not supported */
  /* 19: x++, x--, x! (postfixPrec) */
  /* 18: !x, ~x, ++x, --x, +x, -x, typeof x, void x, delete x, await x (prefixPrec) */
  TKExponentiation() => (ARight(), 17, BOExponentiation()),
  TKMultiplication() => (ALeft(), 16, BOMultiplication()),
  TKDivision() => (ALeft(), 16, BODivision()),
  TKRemainder() => (ALeft(), 16, BORemainder()),
  TKAddition() => (ALeft(), 15, BOAddition()),
  TKSubtraction() => (ALeft(), 15, BOSubtraction()),
  TKLeftShift() => (ALeft(), 14, BOLeftShift()),
  TKSignedRightShift() => (ALeft(), 14, BOSignedRightShift()),
  TKZeroFilledRightShift() => (ALeft(), 14, BOZeroFilledRightShift()),
  /* 13: x as y (left) */
  TKLessThan() => (ALeft(), 12, BOLessThan()),
  TKLessThanOrEqual() => (ALeft(), 12, BOLessThanOrEqual()),
  TKGreaterThan() => (ALeft(), 12, BOGreaterThan()),
  TKGreaterThanOrEqual() => (ALeft(), 12, BOGreaterThanOrEqual()),
  /* 12, also: x in y, x instanceof y */
  TKStrictEquality() => (ALeft(), 11, BOStrictEquality()),
  TKStrictInequality() => (ALeft(), 11, BOStrictInequality()),
  /* 11, also x == y, x != y (banned!) */
  TKBitwiseAnd() => (ALeft(), 10, BOBitwiseAnd()),
  TKBitwiseXor() => (ALeft(), 9, BOBitwiseXor()),
  TKBitwiseOr() => (ALeft(), 8, BOBitwiseOr()),
  TKLogicalAnd() => (ALeft(), 7, BOLogicalAnd()),
  TKLogicalOr() => (ALeft(), 6, BOLogicalOr()),
  TKNullishCoalescing() => (ALeft(), 5, BONullishCoalescing()),
  /* 4: x ? y : z (right) (ternaryPrec) */
  /* 3: x => y, async x => y (right) (closurePrec) */
  TKAssignment() => (ARight(), 2, BOAssignment()),
  TKExponentiationAssignment() => (
    ARight(),
    2,
    BOOpAssignment(BOExponentiation()),
  ),
  TKMultiplicationAssignment() => (
    ARight(),
    2,
    BOOpAssignment(BOMultiplication()),
  ),
  TKDivisionAssignment() => (ARight(), 2, BOOpAssignment(BODivision())),
  TKRemainderAssignment() => (ARight(), 2, BOOpAssignment(BORemainder())),
  TKAdditionAssignment() => (ARight(), 2, BOOpAssignment(BOAddition())),
  TKSubtractionAssignment() => (ARight(), 2, BOOpAssignment(BOSubtraction())),
  TKLeftShiftAssignment() => (ARight(), 2, BOOpAssignment(BOLeftShift())),
  TKSignedRightShiftAssignment() => (
    ARight(),
    2,
    BOOpAssignment(BOSignedRightShift()),
  ),
  TKZeroFilledRightShiftAssignment() => (
    ARight(),
    2,
    BOOpAssignment(BOZeroFilledRightShift()),
  ),
  TKBitwiseAndAssignment() => (ARight(), 2, BOOpAssignment(BOBitwiseAnd())),
  TKBitwiseXorAssignment() => (ARight(), 2, BOOpAssignment(BOBitwiseXor())),
  TKBitwiseOrAssignment() => (ARight(), 2, BOOpAssignment(BOBitwiseOr())),
  TKLogicalAndAssignment() => (ARight(), 2, BOOpAssignment(BOLogicalAnd())),
  TKLogicalOrAssignment() => (ARight(), 2, BOOpAssignment(BOLogicalOr())),
  TKNullishCoalescingAssignment() => (
    ARight(),
    2,
    BOOpAssignment(BONullishCoalescing()),
  ),
  /* 1.5: ...x, yield x, yield* x (non-assoc) */
  /* 1: x, y (left) */
];

module end;
