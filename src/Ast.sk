/***************************************************************************/
// The abstract syntax tree.

// This abstract syntax tree contains constructions that we don't want
// to support (such as namespaces). But identifying those constructions
// could still be useful to provide a good error messages.
/***************************************************************************/

module SKJS;

/***************************************************************************/
// <name> ::= <string>
/***************************************************************************/

value class Name(
  pos: PosRange,
  value: String,
) uses XXHashable, Hashable, Orderable {
  fun hash(): Int {
    // Custom hash that excludes position
    this.value.hash()
  }
}

/***************************************************************************/
// <def> ::=
//   | <expr>
//   | type <name> [ <type-param>* ] <type>
//   | class
//   | enum <name> { (<name> = <expr>?)* }
//   | namespace <name> { <def>* }
//   | module <name> { <def>* }
//   | export (type? <module-names> from <expr>?)
//   | export (type? default?) <def>
//   | export default (type?) <expr>
//   | export = <expr>
//   | export as <name>
//   | export import <name> = <expr>
//   | global { <def>* }
//   | import (type?) <module-names> <import-name> (from <import-kind>)
//   | import <name>
//   | declare <def>
//   | <var-def-kind> { <var-def>* }
/***************************************************************************/

class Def(pos: PosRange, value: Def_) uses XXHashable

base class Def_ uses XXHashable {
  children =
  | ToplevelExpr(Expr)
  | TypeDef{name: Name, tdefParams: Array<TypeParam>, body: Type}
  | Class{
    kind: ClassKind,
    name: Name,
    extends_: Array<Type>,
    implements: Array<Type>,
    tparams: Array<TypeParam>,
    fields: Array<FieldType>,
  }
  | Enum(isConst: ?PosRange, name: Name, fields: Array<(Name, ?Expr)>)
  | Namespace(name: Name, Array<Def>)
  | Module(name: Name, ?Array<Def>)
  | ExportNames(isType: ?PosRange, ModuleNames, maybeFrom: ?Expr)
  | Export(isType: ?PosRange, default: ?PosRange, def: Def_)
  | ExportDefault(isType: ?PosRange, name: Expr)
  | ExportEq(e: Expr)
  | ExportAs(name: Name)
  | ExportImport(name: Name, expr: Expr)
  | Global(Array<Def>)
  | Import(
    kind: ImportKind,
    isType: ?PosRange,
    ModuleNames,
    importFrom: ImportName,
  )
  | ImportExpr(Name)
  | Declare(Def)
  | VarDefs(kind: VarDefKind, varDefs: Array<VarDef>)
}

base class ImportName uses XXHashable {
  children =
  | INPath(Name)
  | INName(Name)
}

/***************************************************************************/
// <var-def> ::= <pattern> (: <type>)? (= <expr>)?
/***************************************************************************/

class VarDef(pat: Pattern, type: ?Type, value: ?Expr) uses XXHashable

/***************************************************************************/
// <pattern> ::=
//   | <name>
//   | <pattern> ::= [ <pattern>* ]
//   | <pattern> ::= { (<name> : <pattern>)* }
/***************************************************************************/

class Pattern(pos: PosRange, value: Pattern_) uses XXHashable

base class Pattern_ uses XXHashable {
  children =
  | PVar(Name)
  | PArray(Array<Pattern>)
  | PObject(Array<(Name, Pattern)>)
}

/***************************************************************************/
// <fun-def> ::=
//   (async?) <modifiers>? (get | set?)
//     <symbol>? [ < <type-param>* > ]? ( <param>* )
//       (: <type>?)
//     <fun-def-body>
/***************************************************************************/

class FunDef{
  pos: PosRange,
  isAsync: ?PosRange,
  isGetSet: ?FieldGetSet,
  name: ?Symbol,
  optional: ?PosRange,
  tparams: Array<TypeParam>,
  params: Array<Param>,
  retType: (PosRange, ?(Type)),
  body: FunDefBody,
  cgNode: ?CGNode,
} extends Def_, FieldType, Field uses XXHashable

base class FunDefBody uses XXHashable {
  children =
  | FDBNone(PosRange)
  | FDBSome(Array<Stmt>)
}

/***************************************************************************/
// <module-names> ::=
//   | * (as <name>)?
//   | { <module-def-name>* }
//   | <name>, { <module-def-name>* }
/***************************************************************************/

base class ModuleNames uses XXHashable {
  children =
  | MStar(?Name)
  | MCurly(Array<ModuleDefName>)
  | MName(Name, Array<ModuleDefName>)
}

/***************************************************************************/
// <module-def-name> ::= (type?) <name> (as <name>)?
/***************************************************************************/

class ModuleDefName(
  isType: ?PosRange,
  name: Name,
  asName: ?Name,
) uses XXHashable

/***************************************************************************/
// <type-param> ::= <name> (: <type>)? (= <type>)?
/***************************************************************************/

class TypeParam(
  id: Id,
  name: Name,
  constraint: ?Type,
  default: ?Type,
) uses XXHashable

/***************************************************************************/
// <param> ::= <modifiers> <param-names> ("?"?) (: <type>)? (= <expr>)?
/***************************************************************************/

class Param(
  pos: PosRange,
  modifiers: Modifiers,
  name: ParamNames,
  optional: ?PosRange,
  type: ?Type,
  default: ?Expr,
) uses XXHashable

/***************************************************************************/
// <param-names> ::=
//   | ... <name>
//   | <name> (: <type>)?
//   | [ <param-names>* ]
//   | { <param-names>* }
/***************************************************************************/

base class ParamNames uses XXHashable {
  children =
  | PNDDD(name: Name)
  | PNName(name: Name, type: ?Type)
  | PNSquare(Array<ParamNames>)
  | PNCurly(Array<ParamNames>)
}

/***************************************************************************/
// <stmt_> ::=
//   | ;
//   | <expr>
//   | break
//   | return <expr>?
//   | throw <expr>
//   | if ( <expr> ) <stmt>* (else <stmt>*)?
//   | for ( <stmt> in <expr> ) <stmt>*
//   | for ( <stmt> of <expr> ) <stmt>*
//   | for ( <stmt> ; <expr> ; <expr> ) <stmt>*
//   | while ( <expr> ) <stmt>*
//   | let <binding>*
//   | var <binding>*
//   | const <binding>*
//   | switch ( <expr> ) { <switch-branch>* }
//   | try { <stmt>* } (catch ( <pattern> (: <type>)? ) { <stmt>* })? (finally { <stmt>* })?
//   | { <stmt>* }
/***************************************************************************/

class Stmt(pos: PosRange, value: Stmt_) uses XXHashable
base class Stmt_ uses XXHashable {
  children =
  | StmtEmpty()
  | StmtExpr(Expr)
  | Break()
  | Continue()
  | Return(PosRange, ?Expr)
  | Throw(Expr)
  | If(Expr, Array<Stmt>, ?Array<Stmt>)
  | ForIn(Stmt, Expr, Array<Stmt>)
  | ForOf(Stmt, Expr, Array<Stmt>)
  | For(Stmt, Expr, Expr, Array<Stmt>)
  | While(Expr, Array<Stmt>)
  | Bind(BindKind, Array<Binding>)
  | Switch(Expr, Array<SwitchBranch>)
  | Block(Array<Stmt>)
  | Try(Array<Stmt>, ?CatchClause, ?Array<Stmt>)
}

/***************************************************************************/
// <binding> ::= <pattern> (: <type>)? (= <expr>)?
/***************************************************************************/

class Binding(pat: Pattern, type: ?Type, value: ?Expr) uses XXHashable

base class BindKind uses XXHashable {
  children =
  | BKLet()
  | BKConst()
  | BKVar()
}

/***************************************************************************/
// <switch-branch> ::=
//   | case <expr> : <stmt>*
//   | default : <stmt>*
/***************************************************************************/

base class SwitchBranch uses XXHashable {
  children =
  | Case(Expr, Array<Stmt>)
  | Default(Array<Stmt>)
}

/***************************************************************************/
// <catch-clause> ::= catch ( <pattern> (: <type>)? ) <stmt>*
/***************************************************************************/

class CatchClause(
  param: ?Pattern,
  type: ?Type,
  body: Array<Stmt>,
) uses XXHashable

/***************************************************************************/
// <expr> ::=
//   | <string-number>
//   | <name>
//   | ... <name>
//   | <string-kind> <string>
//   | typeof <expr>
//   | keyof <type>
//   | await <expr>
//   | <expr> [ <expr> ]
//   | new <name> ( <type>* ) ( <expr>* )
//   | <unop> <expr>
//   | <expr> <post-op>
//   | <expr> <binop> <expr>
//   | <expr> ( <type>* ) ( <expr>* )
//   | ( (<name> (: <type>)?)* )
//   | { <field>* }
//   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>
//   | [ <expr>* ]
//   | <expr> ? <expr> : <expr>
//   | <expr> instanceof <expr>
//   | <expr> as <type>
//   | /<regexp>/
//   | async <expr>
/***************************************************************************/

class Expr(pos: PosRange, value: Expr_) uses XXHashable

base class Expr_ uses XXHashable {
  children =
  | Number(String)
  | BigInt(String)
  | Var(Name)
  | Spread(Name)
  | EString(String)
  | TypeOf(Expr)
  | KeyOf(Type)
  | Await(Expr)
  | Get(Expr, Expr)
  | New(Name, Array<Type>, Array<Expr>)
  | Unop(UnaryOperator, Expr)
  | PostOp(PostOperator, Expr)
  | Binop(BinaryOperator, Expr, Expr)
  | Call(Expr, Array<Type>, Array<Expr>)
  | Params(Array<(Name, ?Type)>)
  | Object(Array<Field>)
  | Closure(Array<(Name, ?Type)>, ?Type, ClosureBody)
  | EArray(Array<Expr>)
  | EIf(Expr, Expr, Expr)
  | InstanceOf(Expr, Expr)
  | As(Expr, Type)
  | AsConst(Expr)
  | Regexp(String)
  | Async(Expr)
  | TemplateLiteral(Array<String>, Array<Expr>)
}

base class ClosureBody uses XXHashable {
  children =
  | CBExpr(Expr)
  | CBBlock(Array<Stmt>)
}

/***************************************************************************/
// <field> ::= <name> : <expr> | ... <expr>
/***************************************************************************/
base class Field uses XXHashable {
  children =
  | FDNormal(name: Name, expr: Expr)
  | FDSpread(expr: Expr)
}

/***************************************************************************/
// <post-op> ::= -- | ++ | !
/***************************************************************************/
base class PostOperator uses XXHashable {
  children =
  | PODecr()
  | POIncr()
  | POExcl()
}

/***************************************************************************/
// <symbol> ::=
//   | <name>
//   | [ <name> ]
//   | [ <name> in <type> (? <type>)? (<fn-op>)? ]
//   | [ <name> : <type> ]
/***************************************************************************/
base class Symbol uses XXHashable, Hashable, Orderable {
  children =
  | FNNormal(Name)
  | FNSymbol(Name)
  | FNIn(Name, Type, ?Type, ?FNOp)
  | FNColon(indexName: Name, indexType: Type)

  fun getName(): String
  | FNNormal(n) -> n.value
  | FNSymbol(n) -> n.value
  | FNIn(n, _, _, _) -> n.value
  | FNColon(n, _) -> n.value

  fun compare(other: Symbol): Order {
    this.getName().compare(other.getName())
  }

  fun hash(): Int {
    this.getName().hash()
  }

  fun xxhash(ignorePos: Bool = false): XXHash {
    this.getName().xxhash(ignorePos)
  }
}

class FieldGetSet(kind: FieldGetSetKind, pos: PosRange) uses XXHashable

/***************************************************************************/
// <field-type-value> ::=
//    <field-get-set>? <modifiers> <symbol> "?"? : <type> = <expr>?
/***************************************************************************/
base class FieldType{modifiers: Modifiers} uses XXHashable {
  fun isStatic(): Bool {
    this.modifiers.modifiers.containsKey("static")
  }
}

class FieldTypeValue{
  pos: PosRange,
  setGet: ?FieldGetSet,
  name: Symbol,
  optional: ?PosRange,
  type: Type,
  value: ?Expr,
} extends FieldType

/***************************************************************************/
// <type_> ::=
//   | " <string> "
//   | ' <string> '
//   | ` <string> `
//   | true | false
//   | <number>
//   | <bigint>
//   | <prim-kind>
//   | typeof <type>
//   | <type> []
//   | { <field-type>* }
//   | <name> < <type>* >
//   | <type> | <type>
//   | <type> & <type>
//   | [ <tuple-elt-type>* ]
//   | function ( <ta-fun-param>* ) : <type>
//   | <type> [ <type> ]
//   | <type> extends <type> ? <type> : <type>
//   | <type> extends <type>
//   | readonly <type>
//   | import ( <expr> , <name>? , <type>* )
//   | infer <name>
//   | []
//   | keyof <type>
//   | new <type>
//   | abstract <type>
//   | <type> is <type>
//   | asserts <name>
//   | <name> asserts <type>
//   | unique symbol
/***************************************************************************/

class Type(pos: PosRange, value: Type_) uses XXHashable

base class Type_ uses XXHashable {
  children =
  | TAStringLiteral(String)
  | TATemplate(String)
  | TANumLiteral(String)
  | TABigIntLiteral(String)
  | TAPrim(TPrimKind)
  | TATypeOf(Expr)
  | TAArray(Type)
  | TAObject(Array<FieldType>)
  | TAInst(Name, Array<Type>)
  | TAUnion(Type, Type)
  | TAInter(Type, Type)
  | TATuple(Array<TupleEltType>)
  | TAFun(Bool, Array<TypeParam>, Array<TAFunParam>, Type, CGNode)
  | TAGet(Type, Type)
  | TAExtendsQuestion(Type, Type, Type, Type)
  | TAExtends(Type, Type)
  | TAReadonly(Type)
  | TAImport(Expr, ?Name, ?Array<Type>)
  | TAInfer(Name)
  | TAEmptyArray()
  | TAKeyOf(Type)
  | TANew(Type)
  | TAAbstract(Type)
  | TAIs(Type, Type)
  | TAAsserts(Name)
  | TAAssertIs(Name, Type)
  | TAUniqueSymbol()
}

/***************************************************************************/
// <tuple-elt-type> ::= <name>? "?"? <type> | ... <name> <type>
/***************************************************************************/

base class TupleEltType uses XXHashable {
  children =
  | TEType(name: ?Name, optional: ?PosRange, Type)
  | TESpread(name: ?Name, Type)
}

/***************************************************************************/
// <ta-fun-param> ::= <ta-param-names> "?"? : <type>
/***************************************************************************/

class TAFunParam(
  name: ?TAParamNames,
  optional: ?PosRange,
  type: Type,
) uses XXHashable

/***************************************************************************/
// <ta-param-names> ::=
//   | <name>
//   | ... <name>
//   | { <curly-name>* } (as <name>)?
/***************************************************************************/

base class TAParamNames uses XXHashable {
  children =
  | TAParamName(Name)
  | TAParamSpread(Name)
  | TACurlyNames(Array<CurlyName>, ?Name)
}

/***************************************************************************/
// <curly-name> ::= <name> (: <type>)?
/***************************************************************************/

class CurlyName(name: Name, type: ?Type) uses XXHashable

/***************************************************************************/
// Modifiers
//
// TODO: introduce an ADT for the modifiers that we actually want to support
/***************************************************************************/

class Modifiers(
  isRemove: ?PosRange,
  modifiers: Map<String, Name>,
) uses XXHashable {
  static fun empty(): this {
    Modifiers(None(), Map[])
  }
}

/***************************************************************************/
/* Enums */
/***************************************************************************/

base class VarDefKind uses XXHashable {
  children =
  | VDKConst()
  | VDKVar()
  | VDKLet()
}

base class TPrimKind uses XXHashable {
  children =
  | TPKNull()
  | TPKBool()
  | TPKNum()
  | TPKString()
  | TPKBigInt()
}

base class FieldGetSetKind uses XXHashable {
  children =
  | FGet()
  | FSet()
}

base class ImportKind uses XXHashable {
  children =
  | IKFrom()
  | IKEq()
}

base class ClassKind uses XXHashable {
  children =
  | CKInterface()
  | CKClass()
  | CKAbstract()
}

base class FNOp uses XXHashable {
  children =
  | FNQuestion(PosRange)
  | FNRemove(PosRange)
  | FNAdd(PosRange)
}

base class UnaryOperator uses XXHashable {
  children =
  | UOExclamationMark()
  | UOTild()
  | UOMinus()
}

base class AssignableBinaryOperator extends BinaryOperator uses XXHashable {
  children =
  | BOMultiplication()
  | BODivision()
  | BORemainder()
  | BOAddition()
  | BOSubtraction()
  | BOLeftShift()
  | BOSignedRightShift()
  | BOZeroFilledRightShift()
  | BOBitwiseAnd()
  | BOBitwiseXor()
  | BOBitwiseOr()
  | BOLogicalAnd()
  | BOLogicalOr()
  | BONullishCoalescing()
}

base class BinaryOperator uses XXHashable {
  children =
  | BODot()
  | BOOptionalDot()
  | BOLessThan()
  | BOLessThanOrEqual()
  | BOGreaterThan()
  | BOGreaterThanOrEqual()
  | BOAs()
  | BOAssignment()
  | BOOpAssignment(AssignableBinaryOperator)
}

base class BOStrictComparison() extends BinaryOperator {
  children =
  | BOStrictEquality()
  | BOStrictInequality()
}

module end;
