/***************************************************************************/
// The abstract syntax tree.

// This abstract syntax tree contains constructions that we don't want
// to support (such as namespaces). But identifying those constructions
// could still be useful to provide a good error messages.
/***************************************************************************/

module SKJS;

/***************************************************************************/
// <name> ::= <string>
/***************************************************************************/

value class Name(
  pos: PosRange,
  value: String,
) uses XXHashable, Hashable, Orderable {
  fun toString(): String {
    this.value
  }
}

/***************************************************************************/
// <def> ::=
//   | <expr>
//   | type <name> [ <type-param>* ] <type>
//   | class
//   | enum <name> { (<name> = <expr>?)* }
//   | namespace <name> { <def>* }
//   | module <name> { <def>* }
//   | export type? <module-names>
//   | export type? <module-names> from <expr>
//   | export default <expr>
//   | export <def>
//   | export = <expr>
//   | export as <name>
//   | export import <name> = <expr>
//   | global { <def>* }
//   | import (type?) <module-names> <import-name> (from <import-kind>)
//   | import <name>
//   | declare <def>
//   | <var-def-kind> { <var-def>* }
/***************************************************************************/

class Def private (pos: PosRange, value: Def_) uses XXHashable {
  static fun create(pos: PosRange, value: Def_): this {
    value.defStableName() match {
    | None() -> static(pos, value)
    | Some(Name(p, _)) -> static(p, value)
    }
  }
}

base class Def_ uses XXHashable {
  children =
  | Expr
  | ExportNames(isType: ?PosRange, MCurly)
  | ExportNamesFrom(isType: ?PosRange, ExportFromModuleNames, from: Name)
  | ExportDeclare(Exportable)
  | ExportDefault(ExportDefaultable)
  | Export(def: Exportable)
  | ExportEq(e: Expr)
  | ExportAs(name: Name)
  | ExportImport(name: Name, expr: Expr)
  | Import(isType: ?PosRange, Array<ImportModuleNames>, importFrom: Name)
  | ImportExpr(Name)
  | Declare(Declarable)

  fun defStableName(): ?Name {
    this match {
    | TopLevelFunDef{name => FNNormal(n)} -> Some(n)
    | Class{name => n} -> Some(n)
    | TypeDef{name => n} -> Some(n)
    | Export(inner) -> inner.defStableName()
    | ExportDeclare(inner) -> inner.defStableName()
    | _ -> None()
    }
  }
}

base class Declarable extends Def_ {
  children =
  | Module(name: Name, ?Array<Def>)
  | Global(Array<Def>)
}

base class Exportable extends Declarable {
  children =
  | TopLevelFunDef
  | TypeDef{name: Name, tdefParams: Array<TypeParam>, bodyRef: TypeDefBodyRef}
  | Class{
    kind: ClassKind,
    name: Name,
    extends_: Array<Type>,
    implements: Array<Type>,
    tparams: Array<TypeParam>,
    bodyRef: ClassBodyRef,
  }
  | Enum(isConst: ?PosRange, name: Name, fields: Array<(Name, ?Expr)>)
  | Namespace(name: Name, Array<Def>)
  | VarDefs(kind: VarDefKind, varDefs: Array<VarDef>)
}

base class ExportDefaultable extends Def_
extension class Class extends ExportDefaultable
extension class TopLevelFunDef extends ExportDefaultable
extension class Expr extends ExportDefaultable

extension class TopLevelFunDef extends FunDefWithModifiers<FNNormal>

/***************************************************************************/
// <var-def> ::= <pattern> (: <type>)? (= <expr>)?
/***************************************************************************/

class VarDef(pat: Pattern, type: ?Type, value: ?Expr) uses XXHashable

/***************************************************************************/
// <pattern> ::=
//   | <name>
//   | <pattern> ::= [ (<pattern> (= <expr>)?)*, (...<name>)? ]
//   | <pattern> ::= { (<name> : <pattern> (= <expr>)?)*, (...<name>)? }
/***************************************************************************/

class Pattern(pos: PosRange, value: Pattern_) uses XXHashable

base class Pattern_ uses XXHashable {
  children =
  | PVar(name: Name)
  | PArray(
    elements: Array</* None means a skipped element */ ?(Pattern, ?Expr)>,
    rest: ?Name,
  )
  | PObject{fields: Array<(Name, Pattern, ?Expr)>, rest: ?Name}
}

/***************************************************************************/
// <fun-def> ::=
//   (async?) <modifiers>? (get | set?)
//     <symbol>? [ < <type-param>* > ]? ( <param>* )
//       (: <type>?)
//     <fun-def-body>
/***************************************************************************/

base class FunDef<+N: FunDefName>{
  isGetSet: ?FieldGetSet,
  name: N,
  optional: ?PosRange,
  sig: FunSig,
  body: FunBody,
  cgNode: ?CGNode,
} uses XXHashable

base class FunDefWithModifiers<+N: FunDefName>{
  isAsync: ?PosRange,
} extends FunDef<N>, WithModifiers

base class FunDefBody uses XXHashable {
  children =
  | FDBNone()
  | FDBSome(Array<Stmt>)
}

base class FunBody uses XXHashable {
  children =
  | FBInline(FunDefBody)
  | FBRef(BodyRef)
}

base class FunSig uses XXHashable {
  children =
  | FSInline(
    tparams: Array<TypeParam>,
    params: Array<Param>,
    retType: (PosRange, ?(Type)),
  )
  | FSRef(FunDefRef)
}

/***************************************************************************/
// <module-names> ::=
//   | *
//   | * as <name>
//   | { <module-def-name>* }
//   | <name>
/***************************************************************************/

base class ModuleNames uses XXHashable {
  children =
  | MStar()
  | MStarAs(Name)
  | MCurly(Array<ModuleDefName>)
  | MName(Name)
}

base class ImportModuleNames extends ModuleNames
extension class MStarAs extends ImportModuleNames
extension class MCurly extends ImportModuleNames
extension class MName extends ImportModuleNames

base class ExportFromModuleNames extends ModuleNames
extension class MStar extends ExportFromModuleNames
extension class MStarAs extends ExportFromModuleNames
extension class MCurly extends ExportFromModuleNames

/***************************************************************************/
// <module-def-name> ::= (type?) <name> (as <name>)?
/***************************************************************************/

class ModuleDefName(
  isType: ?PosRange,
  name: Name,
  asName: ?Name,
) uses XXHashable

/***************************************************************************/
// <type-param> ::= <name> (: <type>)? (= <type>)?
/***************************************************************************/

class TypeParam(
  id: Id,
  name: Name,
  constraint: ?Type,
  default: ?Type,
) uses XXHashable

/***************************************************************************/
// <param> ::= <modifiers> <param-names> ("?"?) (: <type>)? (= <expr>)?
/***************************************************************************/

base class ParamBase{
  isRest: ?PosRange,
  name: Pattern,
  optional: ?PosRange,
  type: ?Type,
} uses XXHashable {
  // Whether the argument may be omitted at a call site. The `?` marker
  // makes any parameter omittable; Param additionally treats a default
  // value as omittable.
  overridable fun isOmittable(): Bool {
    this.optional.isSome()
  }
}

class Param{
  pos: PosRange,
  modifiers: Modifiers,
  default: ?Expr,
} extends ParamBase {
  // Whether the argument may be omitted at a call site: either an explicit
  // `?` marker or a default value makes it omittable.
  fun isOmittable(): Bool {
    this.optional.isSome() || this.default.isSome()
  }
}

/***************************************************************************/
// <stmt_> ::=
//   | ;
//   | <expr>
//   | break
//   | return <expr>?
//   | throw <expr>
//   | if ( <expr> ) <stmt>* (else <stmt>*)?
//   | for ( <stmt> in <expr> ) <stmt>*
//   | for ( <stmt> of <expr> ) <stmt>*
//   | for ( <stmt> ; <expr> ; <expr> ) <stmt>*
//   | while ( <expr> ) <stmt>*
//   | let <binding>*
//   | var <binding>*
//   | const <binding>*
//   | switch ( <expr> ) { <switch-branch>* }
//   | try { <stmt>* } (catch ( <pattern> (: <type>)? ) { <stmt>* })? (finally { <stmt>* })?
//   | { <stmt>* }
/***************************************************************************/

class Stmt(pos: PosRange, value: Stmt_) uses XXHashable
base class Stmt_ uses XXHashable {
  children =
  | StmtEmpty()
  | StmtExpr(Expr)
  | Break()
  | Continue()
  | Return(PosRange, ?Expr)
  | Throw(Expr)
  | If(Expr, Array<Stmt>, ?Array<Stmt>)
  | ForInOf(ForInOfKind, Stmt, Expr, Array<Stmt>)
  | For(Stmt, Expr, Expr, Array<Stmt>)
  | While(Expr, Array<Stmt>)
  | Bind(BindKind, Array<Binding>)
  | Switch(Expr, Array<SwitchBranch>)
  | Block(Array<Stmt>)
  | Try(Array<Stmt>, ?CatchClause, ?Array<Stmt>)
}

base class ForInOfKind uses XXHashable {
  children =
  | ForIn()
  | ForOf()
}

/***************************************************************************/
// <binding> ::= <pattern> (: <type>)? (= <expr>)?
/***************************************************************************/

class Binding(pat: Pattern, type: ?Type, value: ?Expr) uses XXHashable

base class BindKind uses XXHashable {
  children =
  | BKLet()
  | BKConst()
  | BKVar()
}

/***************************************************************************/
// <switch-branch> ::=
//   | case <expr> : <stmt>*
//   | default : <stmt>*
/***************************************************************************/

value class SwitchBranch(
  case: SwitchCase,
  block: Array<Stmt>,
  pos: PosRange,
) uses XXHashable

base class SwitchCase uses XXHashable {
  children =
  | Case(Expr)
  | Default()
}

/***************************************************************************/
// <catch-clause> ::= catch ( <pattern> (: <type>)? ) <stmt>*
/***************************************************************************/

class CatchClause(
  param: ?Pattern,
  type: ?Type,
  body: Array<Stmt>,
) uses XXHashable

/***************************************************************************/
// <expr> ::=
//   | <string-number>
//   | <name>
//   | ... <expr>
//   | <string-kind> <string>
//   | typeof <expr>
//   | keyof <type>
//   | await <expr>
//   | <expr> [ <expr> ]
//   | new <expr> ( <type>* ) ( <expr>* )
//   | <unop> <expr>
//   | <expr> <post-op>
//   | <expr> <binop> <expr>
//   | <expr> ( <type>* ) ( <expr>* )
//   | ( (<name> (: <type>)?)* )
//   | { <field>* }
//   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>
//   | [ <expr>* ]
//   | <expr> ? <expr> : <expr>
//   | <expr> in <expr>
//   | <expr> instanceof <expr>
//   | <expr> as <type>
//   | /<regexp>/
//   | async <expr>
/***************************************************************************/

extension class Expr(pos: PosRange, value: Expr_) extends Def_ {
  // Whether this expression is a literal: a number, bigint, or string
  // literal (possibly signed), or `true`/`false`/`null`/`undefined`
  fun isLiteral(): Bool {
    this.value match {
    | Number _
    | BigInt _
    | EString _
    | Var(Name(_, "true"))
    | Var(Name(_, "false"))
    | Var(Name(_, "null"))
    | Var(Name(_, "undefined")) ->
      true
    // Signed numeric literals such as `-1` parse as a unary expression
    | Unop(ArithmeticUnaryOperator _, e1) ->
      e1.value match {
      | Number _
      | BigInt _ ->
        true
      | _ -> false
      }
    | _ -> false
    }
  }
}

base class Expr_ uses XXHashable {
  children =
  | Number(String)
  | BigInt(String)
  | Var(Name)
  | Spread(Expr)
  | EString(String)
  | TypeOf(Expr)
  | VoidOp(Expr)
  | Await(Expr)
  | Dot(DotKind, Expr, Name)
  | Get(Expr, Expr)
  | New(Expr, Array<Type>, Array<Expr>)
  | Unop(UnaryOperator, Expr)
  | PostOp(PostOperator, Expr)
  | Binop(BinaryOperator, Expr, Expr)
  | Call(Expr, Array<Type>, Array<Expr>)
  | Params(Array<Param>)
  | Object(Array<Field>)
  | Closure(Array<TypeParam>, Array<Param>, ?Type, ClosureBody)
  | EArray(Array<Expr>)
  | EIf(Expr, Expr, Expr)
  | In(Expr, Expr)
  | InstanceOf(Expr, Expr)
  | As(Expr, Type)
  | AsConst(Expr)
  | Satisfies(Expr, Type)
  | Regexp(String)
  | Async(Expr)
  | TemplateLiteral(Array<String>, Array<Expr>)
}

base class ClosureBody uses XXHashable {
  children =
  | CBExpr(Expr)
  | CBBlock(Array<Stmt>)
}

/***************************************************************************/
// <field> ::= <name> : <expr> | [<expr>] : <expr> | ... <expr>
/***************************************************************************/
base class Field uses XXHashable {
  children =
  | FDNormal(name: Name, expr: Expr)
  | FDComputed(key: Expr, value: Expr)
  | FDSpread(expr: Expr)
  | FDMethod
}

extension class FDMethod extends FunDefWithModifiers<FNNormal>

/***************************************************************************/
// <post-op> ::= -- | ++ | !
/***************************************************************************/
base class PostOperator uses XXHashable {
  children =
  | PODecr()
  | POIncr()
  | POExcl()
}

/***************************************************************************/
// <field-name> ::=
//   | <name>
//   | [ <name> ]
//   | [ <name> in <type> (? <type>)? (<fn-op>)? ]
//   | [ <name> : <type> ]
/***************************************************************************/
base class FieldName uses XXHashable {
  fun getName(): String
  | FNNormal(n)
  | FNIn(n, _, _, _)
  | FNColon(n, _) ->
    n.value
  | FNEmpty(_) -> "(anonymous)"
  | FNComputed(_) -> "(computed)"

  fun getPos(): PosRange
  | FNNormal(n) -> n.pos
  | FNIn(n, _, _, _) -> n.pos
  | FNColon(n, _) -> n.pos
  | FNEmpty(pos) -> pos
  | FNComputed(e) -> e.pos
}

base class NonEmptyFieldName extends FieldName
class FNEmpty(PosRange) extends FieldName

base class SimpleFieldName extends NonEmptyFieldName {
  children =
  | FNNormal(Name)
  | FNComputed(Expr)
}

base class IndexFieldName extends NonEmptyFieldName {
  children =
  | FNIn(Name, Type, ?Type, ?FNOp)
  | FNColon(indexName: Name, indexType: Type)
}

base class FunDefName extends FieldName
extension base class SimpleFieldName extends FunDefName
extension class FNEmpty extends FunDefName

class FieldGetSet(kind: FieldGetSetKind, pos: PosRange) uses XXHashable

/***************************************************************************/
// Object field types (used in object type literals: { field: Type })
/***************************************************************************/

base class ObjectField uses XXHashable

class ObjectFieldValue{
  pos: PosRange,
  readonly_: ?ObjectFieldReadonly,
  name: NonEmptyFieldName,
  optional: ?PosRange,
  type: ?Type,
} extends ObjectField

class ObjectFieldMethod extends FunDef<FunDefName>, ObjectField

/***************************************************************************/
// Class field types (used in class/interface bodies)
/***************************************************************************/

base class ClassField uses XXHashable {
  fun isStatic(): Bool;
}

class ClassFieldValue{
  pos: PosRange,
  name: NonEmptyFieldName,
  optional: ?PosRange,
  type: ?Type,
  value: ?Expr,
} extends ClassField, WithModifiers

class ClassFieldMethod extends
  FunDefWithModifiers<SimpleFieldName>,
  ClassField,
{}

base class WithModifiers{modifiers: Modifiers} uses XXHashable {
  fun isStatic(): Bool {
    this.modifiers.modifiers.any(mod -> mod is ModStatic _)
  }
}

/***************************************************************************/
// <type_> ::=
//   | " <string> "
//   | ' <string> '
//   | ` <string> `
//   | true | false
//   | <number>
//   | <bigint>
//   | <prim-kind>
//   | typeof <expr>
//   | <type> []
//   | { <field-type>* }
//   | <name> < <type>* >
//   | <type> | <type>
//   | <type> & <type>
//   | [ <tuple-elt-type>* ]
//   | function ( <ta-fun-param>* ) : <type>
//   | <type> [ <type> ]
//   | <type> extends <type> ? <type> : <type>
//   | <type> extends <type>
//   | readonly <type>
//   | import ( <expr> , <name>? , <type>* )
//   | infer <name>
//   | []
//   | keyof <type>
//   | new <type>
//   | abstract <type>
//   | <type> is <type>
//   | asserts <name>
//   | <name> asserts <type>
//   | unique symbol
/***************************************************************************/

class Type(pos: PosRange, value: Type_) uses XXHashable

base class Type_ uses XXHashable {
  children =
  | TAStringLiteral(String)
  | TATemplate(String)
  | TANumLiteral(String)
  | TABigIntLiteral(String)
  | TAPrim(TPrimKind)
  | TATypeOf(Expr)
  | TAArray(Type)
  | TAObject(Array<ObjectField>)
  | TAInst(Name, Array<Type>)
  | TAUnion(Type, Type)
  | TAInter(Type, Type)
  | TATuple(Array<TupleEltType>)
  | TAFun(Bool, Array<TypeParam>, Array<TAFunParam>, Type, CGNode)
  | TAGet(Type, Type)
  | TAExtendsQuestion(Type, Type, Type, Type)
  | TAExtends(Type, Type)
  | TAReadonly(Type)
  | TAImport(Expr, ?Name, ?Array<Type>)
  | TAInfer(Name)
  | TAEmptyArray()
  | TAKeyOf(Type)
  | TANew(Type)
  | TAAbstract(Type)
  | TAIs(Type, Type)
  | TAAsserts(Name)
  | TAAssertIs(Name, Type)
  | TAUniqueSymbol()
}

/***************************************************************************/
// <tuple-elt-type> ::= <name>? "?"? <type> | ... <name> <type>
/***************************************************************************/

base class TupleEltType uses XXHashable {
  children =
  | TEType(name: ?Name, optional: ?PosRange, Type)
  | TESpread(name: ?Name, Type)
}

/***************************************************************************/
// <ta-fun-param> ::= <ta-param-names> "?"? : <type>
/***************************************************************************/

class TAFunParam extends ParamBase

/***************************************************************************/
// Modifiers
/***************************************************************************/

base class ObjectFieldReadonly final (pos: PosRange) uses XXHashable, Equality {
  children =
  | OFReadonly
  | OFRemoveReadonly

  fun toString(): String
  | OFReadonly _ -> "readonly"
  | OFRemoveReadonly _ -> "-readonly"
}

base class Modifier final (pos: PosRange) uses XXHashable {
  children =
  | ModAbstract
  | ModAsync
  | ModPrivate
  | ModProtected
  | ModPublic
  | ModReadonly
  | ModStatic

  fun toString(): String
  | ModAbstract _ -> "abstract"
  | ModAsync _ -> "async"
  | ModPrivate _ -> "private"
  | ModProtected _ -> "protected"
  | ModPublic _ -> "public"
  | ModReadonly _ -> "readonly"
  | ModStatic _ -> "static"
}

class Modifiers(modifiers: Array<Modifier>) uses XXHashable {
  static fun empty(): this {
    Modifiers(Array[])
  }
}

/***************************************************************************/
/* Enums */
/***************************************************************************/

base class VarDefKind uses XXHashable {
  children =
  | VDKConst()
  | VDKVar()
  | VDKLet()
}

base class TPrimKind uses XXHashable {
  children =
  | TPKNull()
  | TPKBool()
  | TPKNum()
  | TPKString()
  | TPKBigInt()
  | TPKSymbol()
}

base class FieldGetSetKind uses XXHashable {
  children =
  | FGet()
  | FSet()
}

base class ClassKind uses XXHashable, Orderable {
  children =
  | CKInterface()
  | CKClass()
  | CKAbstract()
}

base class FNOp uses XXHashable {
  children =
  | FNQuestion(PosRange)
  | FNRemove(PosRange)
  | FNAdd(PosRange)
}

base class DotKind uses XXHashable {
  children =
  | NormalDot()
  | OptionalDot()
}

base class UnaryOperator uses XXHashable {
  children =
  | UOExclamationMark()
}

base class NumericUnaryOperator() extends UnaryOperator {
  children =
  | UOTild

  fun toString(): String
  | UOTild() -> "~"
  | UOMinus() -> "-"
  | UOPlus() -> "+"
}

base class ArithmeticUnaryOperator extends NumericUnaryOperator {
  children =
  | UOMinus
  | UOPlus
}

base class AssignableBinaryOperator extends BinaryOperator uses XXHashable {
  children =
  | BOExponentiation()
  | BOMultiplication()
  | BODivision()
  | BORemainder()
  | BOAddition()
  | BOSubtraction()
  | BOLeftShift()
  | BOSignedRightShift()
  | BOZeroFilledRightShift()
  | BOBitwiseAnd()
  | BOBitwiseXor()
  | BOBitwiseOr()
  | BONullishCoalescing()
}

base class LazyLogicalOperator() extends AssignableBinaryOperator {
  children =
  | BOLogicalAnd()
  | BOLogicalOr()
}

base class BinaryOperator uses XXHashable {
  children =
  | BOLessThan()
  | BOLessThanOrEqual()
  | BOGreaterThan()
  | BOGreaterThanOrEqual()
  | BOAssignment()
  | BOOpAssignment(AssignableBinaryOperator)
}

base class BOStrictComparison() extends BinaryOperator {
  children =
  | BOStrictEquality()
  | BOStrictInequality()
}

/***************************************************************************/
/* Body references and body data for incremental checking. */
/***************************************************************************/

value class FunDefRef(
  fileName: FPath,
  defName: String,
  occurrence: Int,
) uses XXHashable, Hashable, Orderable

value class ClassBodyRef(
  fileName: FPath,
  defName: String,
  occurrence: Int,
) uses XXHashable, Hashable, Orderable

value class TypeDefBodyRef(
  fileName: FPath,
  defName: String,
  occurrence: Int,
) uses XXHashable, Hashable, Orderable

value class FunDefSigData(
  tparams: Array<TypeParam>,
  params: Array<Param>,
  retType: (PosRange, ?(Type)),
) uses XXHashable
value class FunDefBodyData(body: FunDefBody) uses XXHashable
value class ClassBodyData(fieldRefs: Array<ClassFieldRef>) uses XXHashable
value class TypeDefBodyData(
  tdefParams: Array<TypeParam>,
  body: Type,
) uses XXHashable

value class ClassFieldRef(
  fileName: FPath,
  className: String,
  index: Int,
) uses XXHashable, Hashable, Orderable

value class ClassFieldData(field: ClassField) uses XXHashable

value class MethodBodyRef(
  fileName: FPath,
  className: String,
  classOccurrence: Int,
  methodName: String,
  occurrence: Int,
) uses XXHashable, Hashable, Orderable

value class MethodBodyData(body: FunDefBody) uses XXHashable

base class BodyRef uses XXHashable {
  children =
  | BRFunDef(FunDefRef)
  | BRMethod(MethodBodyRef)
}

module end;
