/***************************************************************************/
// The SKJS lexer.
/***************************************************************************/

module SKJS;

base class SymbolicPos uses Orderable, Hashable {
  children =
  | SPTopLevel()
  | SPClass(className: String)
  | SPMethod(className: String, metName: String)
  | SPFunction(funName: String)
}

mutable class Lexer{
  mutable currentSymbol: SymbolicPos = SPTopLevel(),
  mutable currentSymbolPos: Int = -1,

  // Track unique symbol locations encountered during parsing
  mutable symbolLocations: mutable Map<SymbolicPos, Int> = mutable Map[],

  // The name of the file that we are lexing
  fileName: String,

  // The relative path for consistent ID generation across machines
  relativeFileName: String,

  // The contents of the file
  contents: Array<Char>,

  // Are we lexing a type? If so << and >> are two separate tokens.
  // For example: Array<Array<number>>, we don't want the last >> to
  // be lexed as the operator '>>'.
  mutable inType: Bool = false,

  // The current position in the file
  mutable pos: Int = 0,

  // The last token that was lexed, None() if we haven't started.
  mutable lastTok: ?Token = None(),
} {
  // This method is useful to be able to "look ahead". There are a few
  // constructions where determining what we are parsing is a bit
  // complicated. For example, a call with explicit type arguments is
  // really tricky. Consider: foo<targs>(args), we have to parse all
  // the type arguments in "targs" to determine that we are dealing
  // with a type argument and not a comparison. That's when this
  // saving mechanism is used. So that we can try to parse something
  // and then come back to where we were once we know what we are
  // dealing with.
  readonly private fun save(): this {
    Lexer{
      fileName => this.fileName,
      relativeFileName => this.relativeFileName,
      contents => this.contents,
      pos => this.pos,
      lastTok => this.lastTok,
    }
  }

  // Returns true if the token is equal to the string passed as
  // parameter. Note that we do not allocate a string for the token on
  // purpose, we want to save as many allocations as possible.
  readonly fun isEqTok(tok: Token, str: String): Bool {
    pos = tok.posStart.value;
    for (c in str) {
      if (this.contents[pos] == c) {
        !pos = pos + 1;
        continue
      };
      return false;
    };
    pos == tok.posEnd.value
  }

  // Returns the string associated with a token.
  readonly fun getStrTok(tok: Token): String {
    str = String::fromChars(
      this.contents.slice(tok.posStart.value, tok.posEnd.value),
    );
    tok.kind match {
    | TKQuote() -> str.stripPrefix("'").stripSuffix("'").replace("\\'", "'")
    | TKDoubleQuote() ->
      str.stripPrefix("\"").stripSuffix("\"").replace("\\\"", "\"")
    | _ -> str
    }
  }

  // Returns the current token in the form a string.
  readonly fun getStr(): ?String {
    this.peek().map(x -> this.getStrTok(x))
  }

  // Returns true if the current token is equal to the string.
  readonly fun isEq(str: String): Bool {
    this.peek() match {
    | None() -> false
    | Some(tok) -> this.isEqTok(tok, str)
    }
  }

  // Creates a lexer from a saved point in the past.
  static private fun mcreateFromSaved(lexer: Lexer): mutable Lexer {
    mutable Lexer{
      fileName => lexer.fileName,
      relativeFileName => lexer.relativeFileName,
      contents => lexer.contents,
      pos => lexer.pos,
      lastTok => lexer.lastTok,
    }
  }

  mutable fun lookAhead(f: () -> Bool): Bool {
    saved = this.save();
    result = f();
    this.!pos = saved.pos;
    this.!lastTok = saved.lastTok;
    this.!inType = saved.inType;
    result
  }

  static fun mcreate(
    fileName: String,
    contents: String,
    rootOpt: ?DirName,
  ): mutable this {
    // Compute relative path for consistent ID generation across machines
    base = rootOpt match {
    | Some(root) -> root.toString()
    | None() -> getcwd()
    };
    relativeFileName = Path.relativeTo{path => fileName, base};
    mutable static{
      fileName,
      relativeFileName,
      contents => contents.chars().toArray(),
    }
  }

  readonly fun peekKind(): ?TokenKind {
    this.peek().map(x -> x.kind)
  }

  readonly fun peekStr(): ?String {
    this.peek().map(x -> this.getStrTok(x))
  }

  readonly fun error<T>(start: Int, errKind: LexingKind): T {
    error(LexingError(EPChar(this.fileName, Pos(start)), errKind))
  }

  readonly fun posEnd(): ErrorPos {
    EPChar(this.fileName, Pos(this.contents.size() - 1))
  }

  readonly fun posStart(tok: Token): ErrorPos {
    EPChar(this.fileName, tok.posStart)
  }

  // This is the method containing the main logic of the lexer. Note
  // that we are skipping whitespaces and comments before running the
  // actual logic.
  readonly fun peek(): ?Token {
    start = this.pos;
    // Skipping white spaces and comments
    loop {
      if (start >= this.contents.size()) return None();
      this.contents[start] match {
      | '\r' | '\t' | ' ' | '\n' ->
        !start = start + 1;
        continue
      | c if (c.code() == 65279) ->
        !start = start + 1;
        continue
      | '#' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '!'
      ) ->
        !start = start + 1;
        loop {
          if (start >= this.contents.size()) return None();
          if (this.contents[start] == '\n') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | '/' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '/'
      ) ->
        !start = start + 1;
        loop {
          if (start >= this.contents.size()) return None();
          if (this.contents[start] == '\n') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | '/' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '*'
      ) ->
        !start = start + 2;
        loop {
          if (start >= this.contents.size()) {
            this.error(start, UnterminatedComment())
          };
          if (this.contents[start] == '/' && this.contents[start - 1] == '*') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | _ -> break void
      }
    };
    pos = start;
    if (pos >= this.contents.size()) return None();
    mkToken = (kind: TokenKind) -> {
      Some(Token(kind, Pos(start), Pos(pos)))
    };
    this.contents[pos] match {
    | '(' ->
      !pos = pos + 1;
      mkToken(TKOpenParen())

    | ')' ->
      !pos = pos + 1;
      mkToken(TKCloseParen())

    | '[' ->
      !pos = pos + 1;
      mkToken(TKOpenSquare())
    | ']' ->
      !pos = pos + 1;
      mkToken(TKCloseSquare())

    | '{' ->
      !pos = pos + 1;
      mkToken(TKOpenCurly())
    | '}' ->
      !pos = pos + 1;
      mkToken(TKCloseCurly())

    | '\'' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString())
        };
        c = this.contents[pos];
        if (c == '\n') this.error(pos, NewLineInString());
        if (c == '\\') {
          !pos = pos + 2;
          continue
        };
        if (c == '\'') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKQuote())

    | '"' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString());
        };
        c = this.contents[pos];
        if (c == '\n') this.error(pos, NewLineInString());
        if (c == '\\') {
          !pos = pos + 2;
          continue
        };
        if (c == '"') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKDoubleQuote())

    | '`' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString());
        };
        c = this.contents[pos];
        if (c == '\\') {
          !pos = pos + 2;
          continue
        };
        if (c == '$') {
          !pos = pos + 1;
          if (pos >= this.contents.size()) {
            this.error(pos, UnterminatedString());
          };
          if (this.contents[pos] == '{') {
            count = 0;
            loop {
              if (pos >= this.contents.size()) {
                this.error(pos, UnterminatedString());
              };
              if (this.contents[pos] == '{') {
                !count = count + 1;
                !pos = pos + 1;
                continue
              };
              if (this.contents[pos] == '}') {
                !count = count - 1;
                if (count == 0) break void;
                !pos = pos + 1;
                continue;
              };
              !pos = pos + 1;
            }
          } else {
            continue
          };
        };
        if (c == '`') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKBackTick())

    | '.' ->
      !pos = pos + 1;
      if (
        pos + 1 < this.contents.size() &&
        this.contents[pos] == '.' &&
        this.contents[pos + 1] == '.'
      ) {
        !pos = pos + 2;
        mkToken(TKDotDotDot())
      } else {
        mkToken(TKDot())
      }

    | ',' ->
      !pos = pos + 1;
      mkToken(TKComma())

    | ';' ->
      !pos = pos + 1;
      mkToken(TKSemi())

    | ':' ->
      !pos = pos + 1;
      mkToken(TKColon())

    | '<' if (this.inType) ->
      !pos = pos + 1;
      mkToken(TKLessThan())

    | '>' if (this.inType) ->
      !pos = pos + 1;
      mkToken(TKGreaterThan())

    | c if (
      c >= 'a' && c <= 'z' ||
      c >= 'A' && c <= 'Z' ||
      c == '_' ||
      c == '$' ||
      c == '#'
    ) ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) break void;
        l = this.contents[pos];
        if (
          l >= 'a' && l <= 'z' ||
          l >= 'A' && l <= 'Z' ||
          l == '_' ||
          l == '$' ||
          l >= '0' && l <= '9'
        ) {
          !pos = pos + 1;
          continue
        };
        break void;
      };
      Some(Token(TKVar(), Pos(start), Pos(pos)))

    | c if (c >= '0' && c <= '9') ->
      loop {
        l = this.contents[pos];
        if (
          l >= '0' && l <= '9' ||
          l == 'E' ||
          l == 'e' ||
          l == '.' ||
          l == 'x' ||
          l == 'X' ||
          l == 'b' ||
          l == 'B' ||
          l == '_' ||
          l >= 'a' && l <= 'f' ||
          l >= 'A' && l <= 'F'
        ) {
          !pos = pos + 1;
          continue
        };
        break void;
      };
      if (pos < this.contents.size() && this.contents[pos] == 'n') {
        !pos = pos + 1;
        mkToken(TKBigInt())
      } else {
        mkToken(TKNumber())
      }

    | '~' ->
      !pos = pos + 1;
      mkToken(TKTild())

    | c ->
      savedPos = pos;
      if (!specialChars.contains(c)) {
        this.error(pos, UnknownCharacter(c));
      };
      loop {
        if (pos >= this.contents.size()) break void;
        if (specialChars.contains(this.contents[pos])) {
          !pos = pos + 1;
          continue;
        };
        break void;
      };
      str = String::fromChars(this.contents.slice(start, pos));
      operators.maybeGet(str) match {
      | None() ->
        if (str.startsWith("?")) {
          !pos = savedPos + 1;
          mkToken(TKQuestionMark())
        } else if (str.startsWith("!")) {
          !pos = savedPos + 1;
          mkToken(TKExclamationMark())
        } else if (str.startsWith("/")) {
          !pos = savedPos + 1;
          mkToken(TKDivision())
        } else {
          this.error(pos, UnknownOperator(str));
        }
      | Some(kind) -> mkToken(kind)
      }
    }
  }

  mutable fun next(): ?Token {
    tokOpt = this.peek();
    this.!lastTok = tokOpt;
    tokOpt match {
    | None() -> tokOpt
    | Some(tok) ->
      this.!pos = tok.posEnd.value;
      tokOpt
    }
  }

  readonly fun getLastPos(): Pos {
    this.lastTok.fromSome().posEnd
  }

  // Record a symbol location for tracking - only stores first occurrence
  mutable fun recordSymbolLocation(symbol: SymbolicPos, position: Int): void {
    this.symbolLocations.maybeGet(symbol) match {
    | None() -> this.symbolLocations.set(symbol, position)
    | Some(_existingPos) ->
      // Symbol already exists - keep the first occurrence, ignore subsequent ones
      // This allows for TypeScript method overloads and interface redeclarations
      void
    }
  }

  // Get recorded location for a symbol
  readonly fun getSymbolLocation(symbol: SymbolicPos): ?Int {
    this.symbolLocations.maybeGet(symbol)
  }

  // Check if a symbol is already defined
  readonly fun isSymbolDefined(symbol: SymbolicPos): Bool {
    this.symbolLocations.maybeGet(symbol).isSome()
  }

  // Get all recorded symbols and their locations
  readonly fun getAllSymbolLocations(): Map<SymbolicPos, Int> {
    this.symbolLocations.chill()
  }
}

module end;
