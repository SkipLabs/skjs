/***************************************************************************/
// The SKJS lexer.
/***************************************************************************/

module SKJS;

base class SymbolicPos uses Orderable, Hashable, XXHashable {
  children =
  | SPTopLevel()
  | SPClass(className: String)
  | SPMethod(className: String, metName: String)
  | SPFunction(funName: String)
  | SPConstant(constName: String)

  fun toString(): String
  | SPTopLevel() -> "toplevel"
  | SPClass(className) -> `class(${className})`
  | SPMethod(className, metName) -> `method(${className}.${metName})`
  | SPFunction(funName) -> `function(${funName})`
  | SPConstant(constName) -> `constant(${constName})`
}

mutable class Lexer private {
  mutable currentSymbol: SymbolicPos = SPTopLevel(),
  mutable currentSymbolPos: Int = -1,

  // Track unique symbol locations encountered during parsing
  symbolLocations: mutable Map<SymbolicPos, Int> = mutable Map[],

  // The name of the file that we are lexing
  fileName: FAbsolute,

  // The hash of the relative path for consistent ID generation across machines
  relativeFileNameHash: Int,

  // The contents of the file
  contents: Array<Char>,

  // Are we lexing a type? If so << and >> are two separate tokens.
  // For example: Array<Array<number>>, we don't want the last >> to
  // be lexed as the operator '>>'.
  mutable inType: Bool = false,

  // The current position in the file
  mutable pos: Int = 0,

  // The last token that was lexed, None() if we haven't started.
  mutable lastTok: ?Token = None(),
} {
  // Returns true if the token is equal to the string passed as
  // parameter. Note that we do not allocate a string for the token on
  // purpose, we want to save as many allocations as possible.
  readonly fun isEqTok(tok: Token, str: String): Bool {
    pos = tok.posStart.value;
    for (c in str) {
      if (this.contents[pos] != c) return false;
      !pos = pos + 1;
    };
    pos == tok.posEnd.value
  }

  // Returns the string associated with a token.
  readonly fun getTokenRawStringContent(tok: Token): String {
    String::fromChars(this.contents.slice(tok.posStart.value, tok.posEnd.value))
  }

  // Returns true if the current token is equal to the string.
  readonly fun isEq(str: String): Bool {
    this.peek() match {
    | None() -> false
    | Some(tok) -> this.isEqTok(tok, str)
    }
  }

  mutable fun lookAhead(f: () -> Bool): Bool {
    savedCurrentSymbol = this.currentSymbol;
    savedCurrentSymbolPos = this.currentSymbolPos;
    savedInType = this.inType;
    savedPos = this.pos;
    savedLastTok = this.lastTok;
    result = f();
    this.!currentSymbol = savedCurrentSymbol;
    this.!currentSymbolPos = savedCurrentSymbolPos;
    this.!inType = savedInType;
    this.!pos = savedPos;
    this.!lastTok = savedLastTok;
    result
  }

  mutable fun tryAhead<T>(f: () -> ?T): ?T {
    savedCurrentSymbol = this.currentSymbol;
    savedCurrentSymbolPos = this.currentSymbolPos;
    savedInType = this.inType;
    savedPos = this.pos;
    savedLastTok = this.lastTok;
    result = f();
    if (result is None()) {
      this.!currentSymbol = savedCurrentSymbol;
      this.!currentSymbolPos = savedCurrentSymbolPos;
      this.!inType = savedInType;
      this.!pos = savedPos;
      this.!lastTok = savedLastTok;
    };
    result
  }

  static fun mcreate(
    fileName: FAbsolute,
    contents: String,
    root: DAbsolute,
  ): mutable this {
    // Compute relative path for consistent ID generation across machines
    path = fileName.toString();
    base = root.toString();
    relativeFileNameHash = Path.relativeTo{path, base}.hash();
    mutable static{
      fileName,
      relativeFileNameHash,
      contents => contents.chars().toArray(),
    }
  }

  readonly fun peekKind(): ?TokenKind {
    this.peek().map(x -> x.kind)
  }

  readonly fun peekRawStr(): ?String {
    this.peek().map(this.getTokenRawStringContent)
  }

  readonly fun error<T>(start: Int, errKind: LexingKind): T {
    error(LexingError(EPChar(this.fileName, Pos(start)), errKind))
  }

  readonly fun posEnd(): ErrorPos {
    EPChar(this.fileName, Pos(this.contents.size() - 1))
  }

  readonly fun posStart(tok: Token): ErrorPos {
    EPChar(this.fileName, tok.posStart)
  }

  readonly fun getLastPos(): Pos {
    this.lastTok.fromSome().posEnd
  }

  readonly fun posRange(tok: Token): PosRange {
    PosRange::create(this, tok.posStart, tok.posEnd)
  }

  readonly fun posRange2(tokStart: Token, tokEnd: Token): PosRange {
    PosRange::create(this, tokStart.posStart, tokEnd.posEnd)
  }

  readonly fun posRangeFrom(tok: Token): PosRange {
    this.posRange2(tok, this.lastTok.fromSome())
  }

  // This is the method containing the main logic of the lexer. Note
  // that we are skipping whitespaces and comments before running the
  // actual logic.
  readonly fun peek(): ?Token {
    start = this.pos;
    // Skipping white spaces and comments
    loop {
      if (start >= this.contents.size()) return None();
      this.contents[start] match {
      | '\r' | '\t' | ' ' | '\n' ->
        !start = start + 1;
        continue
      | c if (c.code() == 65279) ->
        !start = start + 1;
        continue
      | '#' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '!'
      ) ->
        !start = start + 1;
        loop {
          if (start >= this.contents.size()) return None();
          if (this.contents[start] == '\n') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | '/' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '/'
      ) ->
        !start = start + 1;
        loop {
          if (start >= this.contents.size()) return None();
          if (this.contents[start] == '\n') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | '/' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '*'
      ) ->
        !start = start + 2;
        loop {
          if (start >= this.contents.size()) {
            this.error(start, UnterminatedComment())
          };
          if (this.contents[start] == '/' && this.contents[start - 1] == '*') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | _ -> break void
      }
    };
    pos = start;
    if (pos >= this.contents.size()) return None();
    mkToken = (kind: TokenKind) -> {
      Some(Token(kind, Pos(start), Pos(pos)))
    };
    this.contents[pos] match {
    | '(' ->
      !pos = pos + 1;
      mkToken(TKOpenParen())

    | ')' ->
      !pos = pos + 1;
      mkToken(TKCloseParen())

    | '[' ->
      !pos = pos + 1;
      mkToken(TKOpenSquare())
    | ']' ->
      !pos = pos + 1;
      mkToken(TKCloseSquare())

    | '{' ->
      !pos = pos + 1;
      mkToken(TKOpenCurly())
    | '}' ->
      !pos = pos + 1;
      mkToken(TKCloseCurly())

    | '\'' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString())
        };
        c = this.contents[pos];
        if (c == '\n') this.error(pos, NewLineInString());
        if (c == '\\') {
          !pos = pos + 2;
          continue
        };
        if (c == '\'') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKQuote())

    | '"' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString());
        };
        c = this.contents[pos];
        if (c == '\n') this.error(pos, NewLineInString());
        if (c == '\\') {
          !pos = pos + 2;
          continue
        };
        if (c == '"') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKDoubleQuote())

    | '`' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString());
        };
        c = this.contents[pos];
        if (c == '\\') {
          !pos = pos + 2;
          continue
        };
        if (c == '$') {
          !pos = pos + 1;
          if (pos >= this.contents.size()) {
            this.error(pos, UnterminatedString());
          };
          if (this.contents[pos] == '{') {
            count = 0;
            loop {
              if (pos >= this.contents.size()) {
                this.error(pos, UnterminatedString());
              };
              if (this.contents[pos] == '{') {
                !count = count + 1;
                !pos = pos + 1;
                continue
              };
              if (this.contents[pos] == '}') {
                !count = count - 1;
                if (count == 0) break void;
                !pos = pos + 1;
                continue;
              };
              !pos = pos + 1;
            }
          } else {
            continue
          };
        };
        if (c == '`') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKBackTick())

    | '.' ->
      !pos = pos + 1;
      if (
        pos + 1 < this.contents.size() &&
        this.contents[pos] == '.' &&
        this.contents[pos + 1] == '.'
      ) {
        !pos = pos + 2;
        mkToken(TKDotDotDot())
      } else {
        mkToken(TKDot())
      }

    | ',' ->
      !pos = pos + 1;
      mkToken(TKComma())

    | ';' ->
      !pos = pos + 1;
      mkToken(TKSemi())

    | ':' ->
      !pos = pos + 1;
      mkToken(TKColon())

    | '<' if (this.inType) ->
      !pos = pos + 1;
      mkToken(TKLessThan())

    | '>' if (this.inType) ->
      !pos = pos + 1;
      mkToken(TKGreaterThan())

    | c if (
      c >= 'a' && c <= 'z' ||
      c >= 'A' && c <= 'Z' ||
      c == '_' ||
      c == '$' ||
      c == '#'
    ) ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) break void;
        l = this.contents[pos];
        if (
          l >= 'a' && l <= 'z' ||
          l >= 'A' && l <= 'Z' ||
          l == '_' ||
          l == '$' ||
          l >= '0' && l <= '9'
        ) {
          !pos = pos + 1;
          continue
        };
        break void;
      };
      Some(Token(TKVar(), Pos(start), Pos(pos)))

    | c if (c >= '0' && c <= '9') ->
      loop {
        l = this.contents[pos];
        if (
          l >= '0' && l <= '9' ||
          l == 'E' ||
          l == 'e' ||
          l == '.' ||
          l == 'x' ||
          l == 'X' ||
          l == 'b' ||
          l == 'B' ||
          l == '_' ||
          l >= 'a' && l <= 'f' ||
          l >= 'A' && l <= 'F'
        ) {
          !pos = pos + 1;
          continue
        };
        break void;
      };
      if (pos < this.contents.size() && this.contents[pos] == 'n') {
        !pos = pos + 1;
        mkToken(TKBigInt())
      } else {
        mkToken(TKNumber())
      }

    | '~' ->
      !pos = pos + 1;
      mkToken(TKTild())

    | c ->
      if (!specialChars.contains(c)) {
        this.error(pos, UnknownCharacter(c));
      };
      while (
        pos < this.contents.size() &&
        specialChars.contains(this.contents[pos])
      ) {
        !pos = pos + 1
      };
      loop {
        str = String::fromChars(this.contents.slice(start, pos));
        operators.maybeGet(str) match {
        | Some(kind) -> break mkToken(kind)
        | None() ->
          !pos = pos - 1;
          if (pos <= start) {
            this.error(pos, UnknownOperator(str))
          }
        }
      }
    }
  }

  mutable fun next(): ?Token {
    tokOpt = this.peek();
    this.!lastTok = tokOpt;
    tokOpt match {
    | None() -> tokOpt
    | Some(tok) ->
      this.!pos = tok.posEnd.value;
      tokOpt
    }
  }

  // Record a symbol location for tracking - only stores first occurrence
  // and returns it
  mutable fun recordSymbolLocation(symbol: SymbolicPos, position: Int): Int {
    this.symbolLocations.maybeGet(symbol) match {
    | None() ->
      this.symbolLocations.set(symbol, position);
      position
    | Some(existingPos) ->
      // Symbol already exists - keep the first occurrence, ignore subsequent ones
      // This allows for TypeScript method overloads and interface redeclarations
      existingPos
    }
  }

  // Get recorded location for a symbol
  readonly fun getSymbolLocation(symbol: SymbolicPos): ?Int {
    this.symbolLocations.maybeGet(symbol)
  }

  // Check if a symbol is already defined
  readonly fun isSymbolDefined(symbol: SymbolicPos): Bool {
    this.symbolLocations.maybeGet(symbol).isSome()
  }

  // Get all recorded symbols and their locations
  readonly fun getAllSymbolLocations(): Map<SymbolicPos, Int> {
    this.symbolLocations.chill()
  }
}

module end;
