/***************************************************************************/
// The SKJS lexer.
/***************************************************************************/

module SKJS;

base class SymbolicPos uses Orderable, Hashable, XXHashable {
  children =
  | SPTopLevel()
  | SPClass(className: String)
  | SPMethod(className: String, metName: String)
  | SPFunction(funName: String)
  | SPConstant(constName: String)

  fun toString(): String
  | SPTopLevel() -> "toplevel"
  | SPClass(className) -> `class(${className})`
  | SPMethod(className, metName) -> `method(${className}.${metName})`
  | SPFunction(funName) -> `function(${funName})`
  | SPConstant(constName) -> `constant(${constName})`
}

mutable class Lexer private {
  mutable currentSymbol: SymbolicPos = SPTopLevel(),
  mutable currentSymbolPos: Int = -1,

  // Track unique symbol locations encountered during parsing
  symbolLocations: mutable Map<SymbolicPos, Int> = mutable Map[],

  // The name of the file that we are lexing
  fileName: FPath,

  // The hash of the relative path for consistent ID generation across machines
  relativeFileNameHash: Int,

  // The contents of the file
  contents: Array<Char>,

  // Are we lexing a type? If so << and >> are two separate tokens.
  // For example: Array<Array<number>>, we don't want the last >> to
  // be lexed as the operator '>>'.
  mutable inType: Bool = false,

  // The current position in the file
  mutable pos: Int = 0,

  // The last token that was lexed, None() if we haven't started.
  mutable lastTok: ?Token = None(),
} {
  // Returns true if the token is equal to the string passed as
  // parameter. Note that we do not allocate a string for the token on
  // purpose, we want to save as many allocations as possible.
  readonly fun isEqTok(tok: Token, str: String): Bool {
    pos = tok.posStart.value;
    for (c in str) {
      if (this.contents[pos] != c) return false;
      !pos = pos + 1;
    };
    pos == tok.posEnd.value
  }

  // Returns the string associated with a token.
  readonly fun getTokenRawStringContent(tok: Token): String {
    String::fromChars(this.contents.slice(tok.posStart.value, tok.posEnd.value))
  }

  // Advances past a backslash escape inside a string literal. A backslash
  // before a CRLF is a line continuation: consume the LF as well, so the
  // scanner does not mistake it for a raw newline ending the string. A
  // trailing backslash (the final character, with nothing to escape) would
  // otherwise push pos two past the buffer; capping at end-of-input keeps the
  // reported error position in bounds so an unterminated string renders
  // instead of panicking with "Out of bounds".
  readonly fun skipStringEscape(pos: Int): Int {
    size = this.contents.size();
    if (
      pos + 2 < size &&
      this.contents[pos + 1] == '\r' &&
      this.contents[pos + 2] == '\n'
    ) {
      pos + 3
    } else {
      min(pos + 2, size)
    }
  }

  // --- Template literals ---------------------------------------------------
  //
  // Templates are lexed incrementally as chunk tokens (Head/Middle/Tail/
  // NoSubstitution) via `scanTemplateChunk`, and the parser parses each
  // interpolation with the normal parser and asks for the next chunk. This is
  // mode-independent: expression context parses each interpolation as an
  // expression (Parser.parseTemplateLiteral), type context as a type
  // (Parser.parseTemplateType).
  //
  // `scanTemplateBody` below finds the extent of a WHOLE template without
  // parsing it, which incremental lexing cannot do. It is what blind
  // token-scanning lookahead uses to step over a template (see `skipTemplate`).

  // Scans raw template text from `start`, honoring backslash escapes (so `\${`
  // and `` \` `` are literal), and stops at the first UNescaped boundary:
  // returns (true, index-past-backtick) at a closing backtick, or
  // (false, index-past-"${") at an interpolation start. Errors (unterminated) at
  // end-of-input. This is the single-chunk scanner.
  readonly fun scanTemplateChunk(start: Int): (Bool, Int) {
    n = this.contents.size();
    pos = start;
    while (pos < n) {
      c = this.contents[pos];
      if (c == '\\') {
        !pos = this.skipStringEscape(pos)
      } else if (c == '`') {
        return (true, pos + 1)
      } else if (c == '$' && pos + 1 < n && this.contents[pos + 1] == '{') {
        return (false, pos + 2)
      } else {
        !pos = pos + 1
      }
    };
    this.error(n, UnterminatedString())
  }

  // Called by the parser right after it has consumed the `}` that closes a
  // template interpolation (so `this.pos` is the index just past that `}`, with
  // any whitespace/comments before the `}` already handled by peek/expect).
  // Scans the next raw chunk and returns a TKTemplateTail (stopped at the
  // closing backtick) or TKTemplateMiddle (stopped at the next `${`); advances
  // `pos`/`lastTok`. The returned token spans from just past `}` to the boundary
  // (it does not include the `}`).
  mutable fun nextTemplateContinuation(): Token {
    start = this.pos;
    (hitBacktick, endPos) = this.scanTemplateChunk(start);
    tok = Token(
      if (hitBacktick) TKTemplateTail() else TKTemplateMiddle(),
      Pos(start),
      Pos(endPos),
    );
    this.!pos = endPos;
    this.!lastTok = Some(tok);
    tok
  }

  // Returns the literal text of a template chunk token, stripping the
  // delimiters that its extent includes (opening backtick, `${`, closing
  // backtick), leaving the raw source text of that chunk (escapes not decoded).
  readonly fun templateChunkRawText(tok: Token): String {
    (s, e) = tok.kind match {
    | TKTemplateHead() -> (tok.posStart.value + 1, tok.posEnd.value - 2)
    | TKTemplateMiddle() -> (tok.posStart.value, tok.posEnd.value - 2)
    | TKTemplateTail() -> (tok.posStart.value, tok.posEnd.value - 1)
    | TKNoSubstitutionTemplate() ->
      (tok.posStart.value + 1, tok.posEnd.value - 1)
    | _ ->
      invariant_violation("templateChunkRawText: not a template chunk token")
    };
    String::fromChars(this.contents.slice(s, e))
  }

  // Repositions past the end of the template that `tok` (a Head chunk) opens,
  // without parsing its interpolations. Blind token-scanning lookahead must use
  // this rather than lexing on: resuming inside an interpolation would treat the
  // template's own closing backtick as the START of a new template and scan to
  // end-of-input, and interpolated parens would corrupt paren counting.
  // A NoSubstitution chunk spans its whole template already and needs no skip.
  mutable fun skipTemplate(tok: Token): void {
    this.!pos = this.scanTemplateBody(tok.posStart.value + 1)
  }

  // Scans a whole template literal body starting at `pos` (just past the opening
  // backtick) and returns the index just past the closing backtick. Skips
  // interpolations `${...}` — and the strings, templates, comments, and braces
  // nested within them — as well as backslash escapes, so a stray backtick,
  // brace, or dollar inside an interpolation is not mistaken for template
  // structure. This is extent-finding only; the interior is never parsed from
  // here. Errors (unterminated) at EOF.
  readonly fun scanTemplateBody(pos: Int): Int {
    n = this.contents.size();
    while (pos < n) {
      c = this.contents[pos];
      if (c == '\\') {
        !pos = this.skipStringEscape(pos)
      } else if (c == '`') {
        return pos + 1
      } else if (c == '$' && pos + 1 < n && this.contents[pos + 1] == '{') {
        !pos = this.scanInterpolation(pos + 1)
      } else {
        !pos = pos + 1
      }
    };
    this.error(n, UnterminatedString())
  }

  // Scans a template interpolation starting at `pos` (the '{' after '$') and
  // returns the index just past the matching '}'. Skips nested strings,
  // templates, comments, and braces so their contents are not miscounted.
  // Errors (unterminated) at end-of-input.
  readonly fun scanInterpolation(pos: Int): Int {
    n = this.contents.size();
    depth = 0;
    while (pos < n) {
      c = this.contents[pos];
      if (c == '{') {
        !depth = depth + 1;
        !pos = pos + 1
      } else if (c == '}') {
        !depth = depth - 1;
        !pos = pos + 1;
        if (depth == 0) return pos
      } else if (c == '\'' || c == '"') {
        !pos = this.scanStringLiteral(pos)
      } else if (c == '`') {
        !pos = this.scanTemplateBody(pos + 1)
      } else if (c == '/' && pos + 1 < n && this.contents[pos + 1] == '/') {
        // Line comment: skip to the next line terminator.
        !pos = pos + 2;
        while (pos < n && this.contents[pos] != '\n') !pos = pos + 1
      } else if (c == '/' && pos + 1 < n && this.contents[pos + 1] == '*') {
        // Block comment: skip to the closing '*/'.
        !pos = pos + 2;
        while (
          pos + 1 < n &&
          !(this.contents[pos] == '*' && this.contents[pos + 1] == '/')
        ) {
          !pos = pos + 1
        };
        !pos = min(pos + 2, n)
      } else {
        !pos = pos + 1
      }
    };
    this.error(n, UnterminatedString())
  }

  // Scans a single- or double-quoted string starting at `pos` (the opening
  // quote) and returns the index just past the matching quote, honoring
  // backslash escapes. Used only to find the extent of a string inside a
  // template interpolation in type context. Errors at end-of-input.
  readonly fun scanStringLiteral(pos: Int): Int {
    n = this.contents.size();
    quote = this.contents[pos];
    !pos = pos + 1;
    while (pos < n) {
      c = this.contents[pos];
      if (c == '\\') {
        !pos = this.skipStringEscape(pos)
      } else if (c == quote) {
        return pos + 1
      } else {
        !pos = pos + 1
      }
    };
    this.error(n, UnterminatedString())
  }

  // Returns true if the current token is equal to the string.
  readonly fun isEq(str: String): Bool {
    this.peek() match {
    | None() -> false
    | Some(tok) -> this.isEqTok(tok, str)
    }
  }

  mutable fun lookAhead(f: () -> Bool): Bool {
    savedCurrentSymbol = this.currentSymbol;
    savedCurrentSymbolPos = this.currentSymbolPos;
    savedInType = this.inType;
    savedPos = this.pos;
    savedLastTok = this.lastTok;
    result = f();
    this.!currentSymbol = savedCurrentSymbol;
    this.!currentSymbolPos = savedCurrentSymbolPos;
    this.!inType = savedInType;
    this.!pos = savedPos;
    this.!lastTok = savedLastTok;
    result
  }

  mutable fun tryAhead<T>(f: () -> ?T): ?T {
    savedCurrentSymbol = this.currentSymbol;
    savedCurrentSymbolPos = this.currentSymbolPos;
    savedInType = this.inType;
    savedPos = this.pos;
    savedLastTok = this.lastTok;
    result = f();
    if (result is None()) {
      this.!currentSymbol = savedCurrentSymbol;
      this.!currentSymbolPos = savedCurrentSymbolPos;
      this.!inType = savedInType;
      this.!pos = savedPos;
      this.!lastTok = savedLastTok;
    };
    result
  }

  static fun mcreate(fileName: FPath, contents: String): mutable this {
    relativeFileNameHash = fileName.hash();
    mutable static{
      fileName,
      relativeFileNameHash,
      contents => contents.chars().toArray(),
    }
  }

  readonly fun peekKind(): ?TokenKind {
    this.peek().map(x -> x.kind)
  }

  readonly fun peekRawStr(): ?String {
    this.peek().map(this.getTokenRawStringContent)
  }

  readonly fun error<T>(start: Int, errKind: LexingKind): T {
    throw ErrorExn(LexingError(EPChar(this.fileName, Pos(start)), errKind))
  }

  readonly fun posEnd(): ErrorPos {
    EPChar(this.fileName, Pos(this.contents.size() - 1))
  }

  readonly fun posStart(tok: Token): ErrorPos {
    EPChar(this.fileName, tok.posStart)
  }

  readonly fun getLastPos(): Pos {
    this.lastTok.fromSome().posEnd
  }

  readonly fun posRange(tok: Token): PosRange {
    PosRange::create(this, tok.posStart, tok.posEnd)
  }

  readonly fun posRange2(tokStart: Token, tokEnd: Token): PosRange {
    PosRange::create(this, tokStart.posStart, tokEnd.posEnd)
  }

  readonly fun posRangeFrom(tok: Token): PosRange {
    this.posRange2(tok, this.lastTok.fromSome())
  }

  // ECMA-262 sec 12.9.3: the source character immediately following a
  // NumericLiteral may not be an IdentifierStart -- `2z` is a syntax error,
  // not the tokens `2` and `z`. (A following digit cannot happen: the scan
  // consumed it.)
  readonly fun checkNoIdentifierAfterNumber(pos: Int): void {
    if (pos < this.contents.size() && isJSIdentifierStart(this.contents[pos])) {
      this.error(pos, IdentifierAfterNumber())
    }
  }

  // Scans a numeric literal from `pos` to its end and returns that end. The run
  // is taken permissively -- a second dot or a stray hex letter is consumed here
  // and rejected later by validateJSNumericLiteral -- which is also what lets a
  // leading-dot literal start the scan on its dot.
  readonly fun scanNumberEnd(pos: Int, isHex: Bool): Int {
    loop {
      if (pos >= this.contents.size()) break void;
      l = this.contents[pos];
      if (
        l >= '0' && l <= '9' ||
        l == 'E' ||
        l == 'e' ||
        l == '.' ||
        l == 'x' ||
        l == 'X' ||
        l == 'b' ||
        l == 'B' ||
        l == 'o' ||
        l == 'O' ||
        l == '_' ||
        l >= 'a' && l <= 'f' ||
        l >= 'A' && l <= 'F'
      ) {
        !pos = pos + 1;
        continue
      };
      // An ES ExponentPart may carry a sign (1e+3, 1e-3): consume a
      // '+'/'-' right after 'e'/'E' when a digit follows. Not in hex
      // literals, where 'e'/'E' is a digit and `0x1e+2` is an addition.
      if (
        !isHex &&
        (l == '+' || l == '-') &&
        (this.contents[pos - 1] == 'e' || this.contents[pos - 1] == 'E') &&
        pos + 1 < this.contents.size() &&
        this.contents[pos + 1] >= '0' &&
        this.contents[pos + 1] <= '9'
      ) {
        !pos = pos + 1;
        continue
      };
      break void;
    };
    pos
  }

  // The identifier character at `pos`, escaped or not, with the index just past
  // it -- provided it satisfies `ok`. An escape must denote a character valid at
  // its position, exactly as the literal spelling must (ECMA-262 sec 12.7).
  readonly fun identifierCharAt(pos: Int, ok: Char -> Bool): ?Int {
    if (pos >= this.contents.size()) return None();
    c = this.contents[pos];
    if (c != '\\') {
      return if (ok(c)) Some(pos + 1) else None()
    };
    decodeIdentifierEscape(this.contents, pos) match {
    | None() -> None()
    | Some(escape) ->
      (decoded, next) = escape;
      if (ok(decoded)) Some(next) else None()
    }
  }

  // A `#!` is a hashbang only at the very start of the file. A leading byte
  // order mark does not count against that (tsc strips it first), but anything
  // else does, including whitespace. Elsewhere a `#` begins a private name.
  readonly fun atHashbangStart(pos: Int): Bool {
    pos == 0 || (pos == 1 && this.contents[0].code() == 0xFEFF)
  }

  // This is the method containing the main logic of the lexer. Note
  // that we are skipping whitespaces and comments before running the
  // actual logic.
  readonly fun peek(): ?Token {
    start = this.pos;
    // Skipping white spaces and comments
    loop {
      if (start >= this.contents.size()) return None();
      this.contents[start] match {
      | c if (isJSWhiteSpace(c) || isJSLineTerminator(c)) ->
        !start = start + 1;
        continue
      | '#' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '!' &&
        this.atHashbangStart(start)
      ) ->
        !start = start + 1;
        loop {
          if (start >= this.contents.size()) return None();
          if (isJSLineTerminator(this.contents[start])) {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | '/' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '/'
      ) ->
        !start = start + 1;
        loop {
          if (start >= this.contents.size()) return None();
          if (isJSLineTerminator(this.contents[start])) {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | '/' if (
        start + 1 < this.contents.size() &&
        this.contents[start + 1] == '*'
      ) ->
        !start = start + 2;
        loop {
          if (start >= this.contents.size()) {
            this.error(start, UnterminatedComment())
          };
          if (this.contents[start] == '/' && this.contents[start - 1] == '*') {
            !start = start + 1;
            break void;
          };
          !start = start + 1;
        }
      | _ -> break void
      }
    };
    pos = start;
    if (pos >= this.contents.size()) return None();
    mkToken = (kind: TokenKind) -> {
      Some(Token(kind, Pos(start), Pos(pos)))
    };
    this.contents[pos] match {
    | '(' ->
      !pos = pos + 1;
      mkToken(TKOpenParen())

    | ')' ->
      !pos = pos + 1;
      mkToken(TKCloseParen())

    | '[' ->
      !pos = pos + 1;
      mkToken(TKOpenSquare())
    | ']' ->
      !pos = pos + 1;
      mkToken(TKCloseSquare())

    | '{' ->
      !pos = pos + 1;
      mkToken(TKOpenCurly())
    | '}' ->
      !pos = pos + 1;
      mkToken(TKCloseCurly())

    | '\'' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString())
        };
        c = this.contents[pos];
        // A string's body excludes LineTerminators. <LS>/<PS> are the
        // exception: ES2019 admits them into string literals.
        if (c == '\n' || c == '\r') this.error(pos, NewLineInString());
        if (c == '\\') {
          !pos = this.skipStringEscape(pos);
          continue
        };
        if (c == '\'') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKQuote())

    | '"' ->
      !pos = pos + 1;
      loop {
        if (pos >= this.contents.size()) {
          this.error(pos, UnterminatedString());
        };
        c = this.contents[pos];
        // A string's body excludes LineTerminators. <LS>/<PS> are the
        // exception: ES2019 admits them into string literals.
        if (c == '\n' || c == '\r') this.error(pos, NewLineInString());
        if (c == '\\') {
          !pos = this.skipStringEscape(pos);
          continue
        };
        if (c == '"') {
          !pos = pos + 1;
          break void;
        };
        !pos = pos + 1;
      };
      mkToken(TKDoubleQuote())

    | '`' ->
      // Emit only the first chunk; the parser parses each interpolation and
      // requests continuations (Middle/Tail). This is mode-independent: a
      // template is lexed the same way in expression and type context.
      (hitBacktick, endPos) = this.scanTemplateChunk(pos + 1);
      !pos = endPos;
      mkToken(if (hitBacktick) TKNoSubstitutionTemplate() else TKTemplateHead())

    | '.' if (
      pos + 1 < this.contents.size() &&
      this.contents[pos + 1] >= '0' &&
      this.contents[pos + 1] <= '9'
    ) ->
      // A digit after the dot begins a NumericLiteral: `.5` is `0.5`. The scan
      // starts at the dot, consuming it as it would the one in `5.5`, so the
      // token covers the whole literal. A leading dot is never hex, and a
      // BigInt has no fractional part, so no `n` suffix is taken here.
      !pos = this.scanNumberEnd(pos, false);
      this.checkNoIdentifierAfterNumber(pos);
      mkToken(TKNumber())

    | '.' ->
      !pos = pos + 1;
      if (
        pos + 1 < this.contents.size() &&
        this.contents[pos] == '.' &&
        this.contents[pos + 1] == '.'
      ) {
        !pos = pos + 2;
        mkToken(TKDotDotDot())
      } else {
        mkToken(TKDot())
      }

    | ',' ->
      !pos = pos + 1;
      mkToken(TKComma())

    | ';' ->
      !pos = pos + 1;
      mkToken(TKSemi())

    | ':' ->
      !pos = pos + 1;
      mkToken(TKColon())

    | '<' if (this.inType) ->
      !pos = pos + 1;
      mkToken(TKLessThan())

    | '>' if (this.inType) ->
      !pos = pos + 1;
      mkToken(TKGreaterThan())

    | c if (
      isJSIdentifierStart(c) ||
      c == '#' ||
      this.identifierCharAt(pos, isJSIdentifierStart).isSome()
    ) ->
      // A private name is `#` followed by an IdentifierName, so the character
      // after the `#` must be an IdentifierStart: `#1` and `#·x` are invalid
      // (tsc: TS1127), and the continue loop below must not begin on them.
      if (c == '#') {
        !pos = pos + 1;
        this.identifierCharAt(pos, isJSIdentifierStart) match {
        | Some(next) -> !pos = next
        | None() -> this.error(start, UnknownCharacter('#'))
        }
      } else {
        // The start character itself may be written as an escape.
        !pos = this.identifierCharAt(pos, isJSIdentifierStart).fromSome()
      };
      loop {
        this.identifierCharAt(pos, isJSIdentifierPart) match {
        | Some(next) ->
          !pos = next;
          continue
        | None() -> void
        };
        // A backslash here began an escape that does not denote a character
        // able to continue the name; it is not the end of the identifier but
        // an invalid character, as tsc reports it (TS1127).
        if (pos < this.contents.size() && this.contents[pos] == '\\') {
          this.error(pos, UnknownCharacter('\\'))
        };
        break void;
      };
      Some(Token(TKVar(), Pos(start), Pos(pos)))

    | c if (c >= '0' && c <= '9') ->
      isHex =
        c == '0' &&
        pos + 1 < this.contents.size() &&
        (this.contents[pos + 1] == 'x' || this.contents[pos + 1] == 'X');
      !pos = this.scanNumberEnd(pos, isHex);
      isBigInt = pos < this.contents.size() && this.contents[pos] == 'n';
      if (isBigInt) !pos = pos + 1;
      this.checkNoIdentifierAfterNumber(pos);
      mkToken(if (isBigInt) TKBigInt() else TKNumber())

    | '~' ->
      !pos = pos + 1;
      mkToken(TKTild())

    | c ->
      if (!specialChars.contains(c)) {
        this.error(pos, UnknownCharacter(c));
      };
      while (
        pos < this.contents.size() &&
        specialChars.contains(this.contents[pos])
      ) {
        !pos = pos + 1
      };
      loop {
        str = String::fromChars(this.contents.slice(start, pos));
        operators.maybeGet(str) match {
        | Some(kind) -> break mkToken(kind)
        | None() ->
          !pos = pos - 1;
          if (pos <= start) {
            this.error(pos, UnknownOperator(str))
          }
        }
      }
    }
  }

  mutable fun next(): ?Token {
    tokOpt = this.peek();
    this.!lastTok = tokOpt;
    tokOpt match {
    | None() -> tokOpt
    | Some(tok) ->
      this.!pos = tok.posEnd.value;
      tokOpt
    }
  }

  // Record a symbol location for tracking - only stores first occurrence
  // and returns it
  mutable fun recordSymbolLocation(symbol: SymbolicPos, position: Int): Int {
    this.symbolLocations.maybeGet(symbol) match {
    | None() ->
      this.symbolLocations.set(symbol, position);
      position
    | Some(existingPos) ->
      // Symbol already exists - keep the first occurrence, ignore subsequent ones
      // This allows for TypeScript method overloads and interface redeclarations
      existingPos
    }
  }

  // Get recorded location for a symbol
  readonly fun getSymbolLocation(symbol: SymbolicPos): ?Int {
    this.symbolLocations.maybeGet(symbol)
  }

  // Check if a symbol is already defined
  readonly fun isSymbolDefined(symbol: SymbolicPos): Bool {
    this.symbolLocations.maybeGet(symbol).isSome()
  }

  // Get all recorded symbols and their locations
  readonly fun getAllSymbolLocations(): Map<SymbolicPos, Int> {
    this.symbolLocations.chill()
  }
}

module end;
