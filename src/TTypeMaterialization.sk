/***************************************************************************/
/* Owner-local publication of normalized type data. */
/***************************************************************************/

module SKJS;

base class TypeComputationPurpose {
  children =
  | TCPChecking()
  | TCPTypeArgumentProbe()
  | TCPDiagnostic()
}

// Immutable output of mapped-key classification. A negative/abstract decision
// is data too: subsequent field construction relies on the entire decision.
value class MappedKeyShape(
  valid: Bool,
  isAbstract: Bool,
  hasString: Bool,
  hasNumber: Bool,
  hasSymbol: Bool,
  namedLiterals: Array<String>,
  symbolLiterals: Array<String>,
)

extension base class TEnv {
  // Normalize children in their source checking environment BEFORE entering
  // here. This preserves mandatory written-type-argument checks and typeof's
  // expression semantics. Only the consuming type operation runs in scratch.
  private fun materializeRead<T>(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    read: (mutable Subst, TEnv) -> T,
  ): T {
    subst = Subst::candidateOwner(tcenvb) match {
    | Some(owner) -> owner
    // With no owner, observation against an empty store still refuses any
    // foreign candidate payload read. It cannot invent a shape from top/bottom.
    | None() -> Subst::mcreate(tcenvb)
    };
    subst.typeComputationPurpose() match {
    | TCPTypeArgumentProbe()
    | TCPDiagnostic() ->
      // These states are detached and cannot confer checking-owner authority.
      // Their nested normalization must not restart a checking observation.
      read(subst, this)
    | TCPChecking() ->
      // Clear caller proof assumptions ONCE. Resetting these inside recursive
      // observed expansion destroys the guards that this snapshot just built.
      readEnv = if (subst.isObservingTypeReads()) {
        this
      } else {
        this.forTypeReadObservation()
      };
      subst.withCommittedTypeDecision<T>(scratch ->
        read(scratch, readEnv)
      ) match {
      | TRReady(value) -> value
      | TRUnavailable() ->
        invariant_violation(
          "A mandatory type materialization cannot be unavailable",
        )
      | TRBlocked() ->
        fatalError(
          Array[
            (
              pos,
              "A type projection or expansion could not be established without changing inference; add an explicit type annotation",
            ),
          ],
          SKJSCode(9037),
        )
      }
    }
  }

  // Checking receives only fixed-read operations. Detached probes/diagnostics
  // have a separate callback: their computations cannot publish checking facts.
  // This distinction is computation purpose, independent of candidate role.
  fun materializeReadContext<T>(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    read: (mutable TypeReadContext) -> T,
    detached: (mutable Subst, TEnv) -> T,
  ): T {
    subst = Subst::candidateOwner(tcenvb) match {
    | Some(owner) -> owner
    | None() -> Subst::mcreate(tcenvb)
    };
    subst.typeComputationPurpose() match {
    | TCPTypeArgumentProbe()
    | TCPDiagnostic() ->
      detached(subst, this)
    | TCPChecking() ->
      subst.withCommittedReadDecision<T>(this, read) match {
      | TRReady(value) -> value
      | TRUnavailable() ->
        invariant_violation(
          "A mandatory type materialization cannot be unavailable",
        )
      | TRBlocked() ->
        fatalError(
          Array[
            (
              pos,
              "A type projection or expansion could not be established without changing inference; add an explicit type annotation",
            ),
          ],
          SKJSCode(9037),
        )
      }
    }
  }

  private fun materializeTypeRead(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    read: (mutable Subst, TEnv) -> TType,
  ): TType {
    this.materializeRead<TType>(tcenvb, pos, read)
  }

  // A subtype decision used to choose a lasting program fact must not be
  // justified by solutions or seals in a discarded clone. Both true and false
  // inspect dependencies; establish them in the checking owner before return.
  fun materializeSubtypeDecision(
    tcenvb: mutable TCEnvBase,
    pos: PosRange,
    source: TType,
    target: TType,
  ): Bool {
    this.materializeReadContext<Bool>(
      tcenvb,
      pos,
      context -> context.isSubtype(source, target),
      (scratch, readEnv) ->
        TType::isSub(scratch, readEnv, source, target) is STOk()
      ,
    )
  }

  // The single memoizing named-expansion path. All callers, including inference
  // variable collection, share the same publication boundary. instantiate itself
  // also gates uncached/direct callers, so its raw implementation cannot escape.
  fun expandNamed(subst: mutable Subst, name: Name, targs: TArgs): TType {
    identity = this.typeDefinitionIdentity(subst, name);
    if (this.seenInstantiate.contains(identity)) {
      // A recursion cut is local to this call chain, not a reusable expansion.
      TType::inst(name, targs)
    } else {
      key = ExpansionKey(identity, targs);
      subst.seenExpansion.maybeGet(key) match {
      | Some(expanded) -> expanded
      | None() ->
        expanded = this.instantiate(subst, subst, name, targs);
        if (expanded != TType::inst(name, targs)) {
          // In scratch this remains local/provisional; in the live owner the
          // outer observation has already established its inspected payloads.
          subst.!seenExpansion[key] = expanded
        };
        expanded
      }
    }
  }
}

module end;
