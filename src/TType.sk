/***************************************************************************/
// This file defines all the operation on types used during the
// type-checking phase.
//
// All the class involved start with "T" for type, or "ST" for single
// type. A class that starts with "T" is just a type, a type that
// starts with "ST" means that it represents a single type out of a
// larger union.
//
// For example: the type number | undefined is represented by a class
// TType that contains a union of SType where the STypes are "number"
// and "undefined".
/***************************************************************************/

module SKJS;

/***************************************************************************/
// The class representing all the types.
//
// The class has 2 important parts:
//
//   - the clauses which represent both parameters and concrete single types
//   (number, undefined, null, ...) under a disjunctive normal form
//
//   - the instances (which represent type variables, unexpanded type
//   instances and unexpanded intersections).
//
// A few examples:
//   number | void           ==> TType(clauses = void | number)
//   Foo<number> | number    ==> TType(clauses = number, insts = Foo<number>)
//   T2 extends A | T1       ==> TType(clauses = T1 | T2 extends A)
//
// Note that some operations will require a so-called "expansion", an
// expansion consisting in getting rid of all the instances and turn
// them into clauses. Note that the expansion is only one
// level deep, so if a type is defined recursively, the expansion will
// not affect the instances defined inside the type.
//
// Interpretation:
// 〚 ttype 〛 = 〚 ttype.insts 〛 ⨆ 〚 ttype.clauses 〛
//
/***************************************************************************/

class TType private {
  // The position in the source-code that serves as a witness, when an
  // error occurs involving this type, we will use that position in
  // the error message.
  pos: PosRange,

  // The hash, it's important because we need to quickly determine if
  // two types are different. The hash is computed by smart constructors,
  // that's why the constructor is private
  private h: XXHash,

  // The list of type instances which can be:
  // - Type variables
  // - Unexpanded type instances MyClass<number>
  // - Unexpanded intersections TInter(t1, t2)
  insts: TInsts,

  // Single types and type parameters (universally quantified type variables), in a
  // sorted disjunctive normal form. So if you write: T1 & (T3 | T2)
  // that will be turned into T1 & T2 | T1 & T3.
  clauses: Clauses,
} uses XXHashable, Orderable {
  //
  // identity
  //

  fun compare(other: TType): Order {
    this.h.compare(other.h)
  }

  fun xxhash(ignorePos: Bool = false): XXHash {
    if (ignorePos) this.h else (this.insts, this.clauses).xxhash()
  }

  //
  // private CONSTRUCTORS
  //

  static private fun create(
    pos: PosRange,
    insts: TInsts,
    clauses: Clauses,
  ): TType {
    if (clauses.isTop()) {
      !insts = TInsts::empty();
    };
    h = (insts, clauses).xxhash(true);
    TType{h, pos, insts, clauses};
  }

  static private fun fromClauses(pos: PosRange, clauses: Clauses): TType {
    TType::create(pos, TInsts::empty(), clauses)
  }

  static private fun fromSTypes(pos: PosRange, sTypes: STypes): TType {
    TType::fromClauses(pos, Clauses::fromSTypes(sTypes))
  }

  static private fun fromTParam(pos: PosRange, tParam: TParam): TType {
    TType::fromClauses(pos, Clauses::single(tParam))
  }

  //
  // public CONSTRUCTORS
  //

  // Returns the type that is sub-type of all types. This type is
  // impossible to construct, meaning, a value of this type is always
  // unreachable code. However, that type can still be useful to
  // represent some values (like exceptions).
  static fun bottom(pos: PosRange): TType {
    TType::create(pos, TInsts::empty(), Clauses::empty())
  }

  // Returns the type that represents all possible values. Every other
  // type is sub-type of top.
  static fun top(pos: PosRange): TType {
    TType::create(pos, TInsts::empty(), Clauses::top())
  }

  // A single atomic type.
  static fun single(sType: SType): TType {
    TType::fromSTypes(sType.pos, STypes::single(sType))
  }

  // Type variable.
  static fun var(v: TVar): TType {
    TType::create(v.pos, TInsts::single(v), Clauses::empty())
  }

  // Unexpanded instance of a named generic type.
  static fun inst(name: Name, targs: TArgs): TType {
    x = TSInst(name, targs);
    TType::create(name.pos, TInsts::single(x), Clauses::empty())
  }

  static fun fromTParamWithConstraint(
    subst: mutable Subst,
    tenv: TEnv,
    pos: PosRange,
    tparam: TParamWithConstraint,
  ): TType {
    ty = TType::fromTParam(pos, tparam.withoutConstraint());
    tparam.cstr match {
    | None() -> ty
    | Some(cstr) -> TType::inter(subst, tenv, ty, cstr)
    }
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  static fun diff(left: TType, right: TType): TType {
    diffInsts = TInsts::diff(left.insts, right.insts);
    diffClauses = Clauses::diff(left.clauses, right.clauses);
    TType::create(left.pos, diffInsts, diffClauses)
  }

  // TRANSFORMERS

  fun withPos(pos: PosRange): TType {
    // pos is not part of the hash
    this with {pos}
  }

  fun rawMap(insts: (TInsts) -> TInsts, clauses: (Clauses) -> Clauses): TType {
    TType::create(this.pos, insts(this.insts), clauses(this.clauses))
  }

  // t.mapSTypes(subst, env, variance, f) is t with stypes updated by f
  fun mapSTypes(
    subst: mutable Subst,
    tenv: TEnv,
    variance: Variance,
    f: (?STypes) -> ?STypes,
  ): TType {
    res = Clauses::empty();
    for (clauses in this.expandedClausesIterator(subst, tenv, variance)) {
      !res = Clauses::union(subst, tenv, res, clauses.mapSTypes(f))
    };
    TType::fromClauses(this.pos, res)
  }

  private fun mapClauses(
    subst: mutable Subst,
    tenv: TEnv,
    f: Clause -> this,
  ): TType {
    if (this.clauses.isEmpty()) {
      this
    } else {
      accum = TType::create(this.pos, this.insts, Clauses::empty());
      for (clause in this.clauses.clauses) {
        !accum = TType::union(subst, tenv, accum, f(clause));
      };
      accum
    }
  }

  // t.mapTParams(subst, tenv, f) is t with each TParam p replaced by u
  // where f(p) is Some(u), or left unchanged if f(p) is None. The type's
  // unions and intersections are rebuilt using subst and tenv.
  fun mapTParams(
    subst: mutable Subst,
    tenv: TEnv,
    f: (TParam) -> ?TType,
  ): TType {
    this.mapClauses(subst, tenv, clause0 -> {
      clause1 = TType::top(this.pos);
      for (tparam in clause0.vars) {
        paramTy = f(tparam) match {
        | None() -> TType::fromTParam(this.pos, tparam)
        | Some(ty) -> ty
        };
        !clause1 = TType::inter(subst, tenv, clause1, paramTy)
      };
      clause0.stypes match {
      | None() -> clause1
      | Some(stypes) ->
        TType::inter(subst, tenv, clause1, TType::fromSTypes(this.pos, stypes))
      }
    })
  }

  // UTILITIES

  fun toString(): String {
    prettyPrintType(false, this)
  }

  // BOOLEAN PROPERTIES

  fun isBottom(): Bool {
    this.insts.isEmpty() && this.clauses.isEmpty()
  }

  fun isTop(): Bool {
    this.clauses.isTop()
  }

  fun isPrimitiveType(subst: mutable Subst, tenv: TEnv): Bool {
    this.getSTypes(subst, tenv, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      for (stype in stypes) {
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          continue
        | TTuple(tys, _) ->
          for (ty in tys) {
            if (!ty.isPrimitiveType(subst, tenv)) return false
          }
        | TAlgebraic _
        | TObject _
        | TPromise _ ->
          return false
        }
      };
      true
    }
  }

  // OTHER PROPERTIES

  // Returns the actual STypes after head expansion, forgetting type parameters,
  // so the return value over-approximates the type
  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, tenv: TEnv, variance: Variance): ?STypes {
    this.expand_(subst, tenv, variance).getSTypes(subst, tenv)
  }

  fun expandedClausesIterator(
    subst: mutable Subst,
    tenv: TEnv,
    variance: Variance,
  ): mutable Iterator<Clauses> {
    yield this.clauses;
    insts = Vector::mcreateFromIterator(this.insts.insts.values());
    seen = SortedSet::createFromItems(insts);
    while (!insts.isEmpty()) {
      inst = insts.pop();
      tyDef = inst match {
      | TSInst(name, targs) -> tenv.instantiate(subst, name, targs)
      | TInter(ty1, ty2) -> TType::inter(subst, tenv, ty1, ty2)
      | TUnion(ty1, ty2) -> TType::union(subst, tenv, ty1, ty2)
      | tvar @ TVar _ -> subst.get(tenv, tvar, variance)
      };
      yield tyDef.clauses;
      for (newInst in tyDef.insts) {
        if (seen.contains(newInst)) continue;
        !seen = seen.set(newInst);
        insts.push(newInst);
      }
    }
  }

  fun expand_(subst: mutable Subst, tenv: TEnv, variance: Variance): Clauses {
    res = Clauses::empty();
    for (clauses in this.expandedClausesIterator(subst, tenv, variance)) {
      if (clauses.isTop()) return Clauses::top();
      !res = Clauses::union(subst, tenv, res, clauses)
    };
    res
  }

  fun expand(subst: mutable Subst, tenv: TEnv, variance: Variance): TType {
    TType::fromClauses(this.pos, this.expand_(subst, tenv, variance))
  }

  fun getConstantString(): ?PrimLiteral {
    if (!this.insts.isEmpty()) None() else {
      this.clauses.getConstantString()
    }
  }

  fun getSingleVar(): ?TVar {
    if (this.clauses.isEmpty()) this.insts.getSingleVar() else {
      None()
    }
  }
}

base class Variance {
  children =
  | Covariant()
  | Contravariant()
}

/***************************************************************************/
/* Object types. */
/***************************************************************************/

// Regular Typescript (open) object type
// but disjoint from types in TAlgebraic
class TObject(fields: TFields) extends SType {
  fun removeFields(fieldsToRemove: SortedSet<String>): TObject {
    if (fieldsToRemove.isEmpty()) this else {
      this with {fields => this.fields.removeFields(fieldsToRemove)}
    }
  }
}

const kAlgebraicBranchFieldName: String = "kind";

class TAlgebraic(
  branches: InternalKeyedArrayMap<String, TConstr>,
) extends SType {
  static fun single(x: TConstr, pos: PosRange): TAlgebraic {
    TAlgebraic(InternalKeyedArrayMap::single(x), pos)
  }

  fun removeFields(fieldsToRemove: SortedSet<String>): TAlgebraic {
    if (fieldsToRemove.isEmpty()) this else {
      this with {
        branches => this.branches.map(branch ->
          branch.removeFields(fieldsToRemove)
        ),
      }
    }
  }
}

class TConstr(
  tag: String,
  tagPos: PosRange,
  // TODO: make fields private so that we don't try to access "kind" from fields
  fields: TFields,
) uses XXHashable, Orderable, Projectable<String> {
  fun map(f: TFields -> TFields): TConstr {
    TConstr(this.tag, this.tagPos, f(this.fields))
  }

  fun getType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
  ): TType {
    if (fieldName == kAlgebraicBranchFieldName) {
      TType::single(TPrimValue::single(TString(), this.tag, this.tagPos))
    } else {
      this.fields.getType(subst, tenv, fieldName, pos)
    }
  }

  fun removeFields(fieldsToRemove: SortedSet<String>): TConstr {
    if (fieldsToRemove.isEmpty()) this else {
      this with {fields => this.fields.removeFields(fieldsToRemove)}
    }
  }

  fun project(): String {
    this.tag
  }

  fun toString(): String {
    prettyPrintConstr(this)
  }
}

fun createObject(
  tcenvb: mutable TCEnvBase,
  pos: PosRange,
  algebraicBranchField: ?(PosRange, TType),
  fields: TFields,
): TType {
  seen = mutable Set<String>[];
  for (field in fields) {
    if (seen.contains(field.name)) {
      tcenvb.error(Array[(field.pos, "Duplicate field")])
    } else {
      seen.insert(field.name)
    }
  };
  algebraicBranchField match {
  | Some((algebraicBranchFieldPos, algebraicBranchFieldType)) ->
    algebraicBranchFieldType.getConstantString() match {
    | None() ->
      typingError(
        Array[
          (
            pos,
            `Algebraic field ${kAlgebraicBranchFieldName} was expected to be a constant string`,
          ),
          (algebraicBranchFieldPos, `Got ${algebraicBranchFieldType} instead.`),
        ],
      )
    | Some(lit) ->
      TType::single(
        TAlgebraic::single(
          TConstr(lit.val, lit.pos, fields),
          algebraicBranchFieldPos,
        ),
      )
    }
  | None() -> TType::single(TObject(fields, pos))
  }
}

/***************************************************************************/
/* Functions */
/* Use only as the call and new 'fields' of objects (TFields) */
/***************************************************************************/

class TFuns private (fun_: TFun, pos: PosRange) uses XXHashable, Orderable {
  static fun singleFun(x: TFun, pos: PosRange): TFuns {
    TFuns(x, pos)
  }

  static fun singleMethod(x: TFun, pos: PosRange): TFuns {
    TFuns(x, pos)
  }

  fun mapFuns(f: TFun -> TFun): TFuns {
    TFuns(f(this.fun_), this.pos)
  }
}

class TFun(
  tparams: Array<TParamWithConstraint>,
  thisParam: ?TType,
  params: Array<TType>,
  optionalParams: Array<TType>,
  spreadParam: ?ArrayType, /* A function can always accept more ignored parameters, so None() is like Some(Array<Top>) */
  retType: TType,
  cgNodes: CGNodes,
) uses XXHashable, Orderable {
  fun toString(): String {
    prettyPrintTFun(this)
  }
}

/***************************************************************************/
/* ArrayType for the spread parameter of functions */
/***************************************************************************/

base class ArrayType uses XXHashable, Orderable, Show {
  fun getPos(): PosRange;
  fun maybeGetEltType(
    subst: mutable Subst,
    tenv: TEnv,
    variance: Variance,
  ): ?TType;
  fun full(): TType;

  fun getEltType(subst: mutable Subst, tenv: TEnv, variance: Variance): TType {
    this.maybeGetEltType(subst, tenv, variance) match {
    | Some(res) -> res
    | None() ->
      variance match {
      | Covariant() -> TType::top(this.getPos())
      | Contravariant() -> TType::bottom(this.getPos())
      }
    }
  }

  static fun createFromElt(eltType: TType, pos: PosRange): ArrayType {
    ATArrayOf(eltType, pos)
  }

  static fun createFromFull(fullType: TType): ArrayType {
    ATFullType(fullType)
  }
}

class ATArrayOf(eltType: TType, pos: PosRange) extends ArrayType {
  fun getPos(): PosRange {
    this.pos
  }

  fun toString(): String {
    `Array<${this.eltType}>`
  }

  fun maybeGetEltType(
    _subst: mutable Subst,
    _tenv: TEnv,
    _variance: Variance,
  ): ?TType {
    Some(this.eltType)
  }

  fun full(): TType {
    TType::inst(Name(this.pos, "Array"), TArgs(Array[this.eltType]))
  }
}

class ATFullType(fullType: TType) extends ArrayType {
  fun getPos(): PosRange {
    this.fullType.pos
  }

  fun toString(): String {
    this.fullType.toString()
  }

  static fun getArrayObjectEltType(
    object: TObject,
    subst: mutable Subst,
    tenv: TEnv,
  ): ?TType {
    object.fields.maybeGet("pop").flatMap(popMethod ->
      popMethod.type.getSTypes(subst, tenv, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TObject(TFields{call => Some((_, TFuns(met, _)))}, _)) ->
        Some(met.retType)
      | _ -> None()
      }
    )
  }

  fun maybeGetEltType(
    subst: mutable Subst,
    tenv: TEnv,
    variance: Variance,
  ): ?TType {
    this.fullType.getSTypes(subst, tenv, variance).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(object @ TObject _) ->
      ATFullType::getArrayObjectEltType(object, subst, tenv)
    | _ -> None()
    }
  }

  fun full(): TType {
    this.fullType
  }
}

/***************************************************************************/
/* Tuples */
/***************************************************************************/

class TTuple(tuple: Array<TType>) extends SType

/***************************************************************************/
/* Single types */
/***************************************************************************/

/* Types with a single inhabitant:
- undefined for types void and undefined
- null for type null

In Typescript, void is both bottom and a supertype of everything when used as a
return type.

In SKJS, we decided (see https://github.com/SkipLabs/skjs/issues/75) that void
would be a distinct type from undefined. It contains the value undefined but
with no operations permitted on it.

We should ensure that nothing non-undefined can be of type void. */
base class TPrimUnitKind uses XXHashable, Orderable {
  children =
  | TUndefined()
  | TVoid()
  | TNull()

  fun toString(): String {
    this match {
    | TUndefined() -> "undefined"
    | TVoid() -> "void"
    | TNull() -> "null"
    }
  }
}

/* Types with literal subtypes: booleans, numbers, strings, and bigints. */
base class TPrimValueKind uses XXHashable, Orderable {
  children =
  | TNum()
  | TBool()
  | TString()
  | TBigInt()

  fun toString(): String {
    this match {
    | TNum() -> "number"
    | TBool() -> "boolean"
    | TString() -> "string"
    | TBigInt() -> "bigint"
    }
  }
}

base class STypeTag final () uses Orderable {
  children =
  | TagUndefined
  | TagVoid
  | TagNull
  | TagBool
  | TagNum
  | TagString
  | TagBigInt
  | TagTuple
  | TagPromise
  | TagObject
  | TagAlgebraic
}

base class SType private (
  pos: PosRange,
) uses XXHashable, Orderable, Projectable<STypeTag> {
  children =
  | TPromise(inner: TType)

  fun tag(): STypeTag {
    this match {
    | TPrimUnit(TUndefined(), _) -> TagUndefined()
    | TPrimUnit(TVoid(), _) -> TagVoid()
    | TPrimUnit(TNull(), _) -> TagNull()
    | TPrimValue(TBool(), _, _) -> TagBool()
    | TPrimValue(TNum(), _, _) -> TagNum()
    | TPrimValue(TString(), _, _) -> TagString()
    | TPrimValue(TBigInt(), _, _) -> TagBigInt()
    | TTuple _ -> TagTuple()
    | TPromise _ -> TagPromise()
    | TObject _ -> TagObject()
    | TAlgebraic _ -> TagAlgebraic()
    }
  }

  fun project(): STypeTag {
    this.tag()
  }

  fun toString(): String {
    prettyPrintSType(this, false)
  }
}

class TPrimUnit(kind: TPrimUnitKind) extends SType

class TPrimValue(kind: TPrimValueKind, literals: ?PrimLiterals) extends SType {
  static fun single(
    kind: TPrimValueKind,
    value: String,
    pos: PosRange,
  ): TPrimValue {
    TPrimValue(kind, Some(PrimLiterals::single(PrimLiteral(pos, value))), pos)
  }

  static fun full(kind: TPrimValueKind, pos: PosRange): TPrimValue {
    TPrimValue(kind, None(), pos)
  }

  static fun boolean(pos: PosRange): TPrimValue {
    TPrimValue::full(TBool(), pos)
  }

  static fun number(pos: PosRange): TPrimValue {
    TPrimValue::full(TNum(), pos)
  }

  static fun string(pos: PosRange): TPrimValue {
    TPrimValue::full(TString(), pos)
  }

  static fun bigint(pos: PosRange): TPrimValue {
    TPrimValue::full(TBigInt(), pos)
  }

  fun asClassName(): Name {
    Name(this.pos, this.kind.toString())
  }
}

class TField private (
  pos: PosRange,
  name: /* Invariant: name != kAlgebraicBranchFieldName */ String,
  isOptional: Bool,
  type: TType,
) uses XXHashable, Orderable, Projectable<String> {
  static fun create(
    pos: PosRange,
    name: String,
    isOptional: Bool,
    type: TType,
  ): ?TField {
    if (name == kAlgebraicBranchFieldName) None() else {
      Some(TField(pos, name, isOptional, type))
    }
  }

  fun withOptional(): TField {
    this with {isOptional => true}
  }

  fun mapType(f: TType -> TType): TField {
    this with {type => f(this.type)}
  }

  fun project(): String {
    this.name
  }
}

/* Fields such as { [keyName: KeyType]: ValueType } */
class TIndexField(
  pos: PosRange,
  keyName: String,
  keyType: TType,
  valueType: TType,
) uses XXHashable, Orderable {
  fun mapTypes(f: TType -> TType): TIndexField {
    keyType = f(this.keyType);
    valueType = f(this.valueType);
    this with {keyType, valueType}
  }
}

class TFields{
  fields: InternalKeyedArrayMap<String, TField>,
  indexes: Array<TIndexField>,
  /* There can be several index fields.
     Typescript allows only one per object, but is fine with
     intersecting two objects with index fields, so it's like having
     two of them. This array is expected to have zero or one element
     most of the time, or at most a few elements.

     TODO: allow only subtypes of string | number (| symbol)
     TODO: if a field name is included an index key type, then its
      type must be a subtype of the index key type
  */
  new: ?(/* optional */ Bool, TFuns),
  call: ?(/* optional */ Bool, TFuns),
} uses XXHashable, Orderable {
  static fun empty(): TFields {
    TFields{
      fields => InternalKeyedArrayMap::empty(),
      indexes => Array[],
      new => None(),
      call => None(),
    }
  }

  static fun create{
    fields: Array<TField> = Array[],
    indexes: Array<TIndexField> = Array[],
    new: ?TFuns = None(),
    call: ?TFuns = None(),
  }: TFields {
    TFields{
      fields => InternalKeyedArrayMap::createFromSortedIterator(
        fields.sortedBy(x ~> x.name).values(),
      ),
      indexes,
      new => new.map(tfuns ~> (false, tfuns)),
      call => call.map(tfuns ~> (false, tfuns)),
    }
  }

  fun isEmpty(): Bool {
    this.fields.isEmpty() && this.indexes.isEmpty()
  }

  fun map(
    fField: TField -> TField,
    fIndexField: TIndexField -> TIndexField,
    fTFuns: TFuns -> TFuns,
  ): TFields {
    TFields{
      fields => this.fields.map(fField),
      indexes => this.indexes.map(fIndexField),
      new => this.new.map(opt_tfuns -> (opt_tfuns.i0, fTFuns(opt_tfuns.i1))),
      call => this.call.map(opt_tfuns -> (opt_tfuns.i0, fTFuns(opt_tfuns.i1))),
    }
  }

  fun filterMap(f: TField -> ?TField): TFields {
    this with {fields => this.fields.filterMap(f)}
  }

  fun values(): mutable Iterator<TField> {
    this.fields.values()
  }

  fun maybeSingleIndex(): ?TIndexField {
    this.indexes.size() match {
    | 0 -> None()
    | 1 -> Some(this.indexes[0])
    | _ ->
      typingError(
        Array[
          (this.indexes[0].pos, "TODO: multiple indexes"),
          (this.indexes[1].pos, "Second one is here"),
        ],
      )
    }
  }

  fun maybeGet(fieldName: String): ?TField {
    this.fields.maybeGet(fieldName)
  }

  fun maybeGetType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
  ): ?TType {
    this.maybeGet(fieldName).map(fd -> {
      ty = fd.type;
      if (fd.isOptional) {
        TType::unionUndefined(subst, tenv, ty, pos)
      } else {
        ty
      }
    })
  }

  fun getTypeTypingError<T>(fieldName: String, pos: PosRange): T {
    typingError(
      Array[
        (pos, `Unbound field: ${fieldName}`),
        (
          pos,
          "Possible options are:\n" +
            this.fields.toArray().map(x -> x.name).join("\n"),
        ),
      ],
    )
  }

  fun getType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
  ): TType {
    this.maybeGetType(subst, tenv, fieldName, pos) match {
    | None() -> this.getTypeTypingError(fieldName, pos)
    | Some(ty) -> ty
    }
  }

  // Returns None() if the field already exist
  fun addField(fieldToAdd: TField): ?TFields {
    if (this.fields.containsKey(fieldToAdd.name)) None() else {
      Some(
        this with {
          fields => this.fields.union(
            InternalKeyedArrayMap::single(fieldToAdd),
          ),
        },
      )
    }
  }

  fun removeFields(fieldsToRemove: SortedSet<String>): TFields {
    if (fieldsToRemove.isEmpty()) this else {
      // TODO: better approximation of removing fields that may intersect with indexes
      this with {
        fields => this.fields.filter(field ->
          !fieldsToRemove.contains(field.name)
        ),
      }
    }
  }
}

class STypes private (
  private stypes: InternalKeyedArrayMap<STypeTag, SType>,
) uses XXHashable, Orderable {
  static fun empty(): STypes {
    STypes(InternalKeyedArrayMap::empty())
  }

  static fun single(x: SType): STypes {
    STypes(InternalKeyedArrayMap::single(x))
  }

  fun map(f: SType -> SType): STypes {
    STypes(this.stypes.map(f))
  }

  fun filter(f: SType -> Bool): STypes {
    STypes(this.stypes.filter(f))
  }

  fun filterMap(f: SType -> ?SType): STypes {
    STypes(this.stypes.filterMap(f))
  }

  fun isEmpty(): Bool {
    this.stypes.isEmpty()
  }

  fun size(): Int {
    this.stypes.size()
  }

  fun items(): mutable Iterator<(Int, SType)> {
    this.stypes.items()
  }

  fun values(): mutable Iterator<SType> {
    this.stypes.values()
  }

  fun any(f: SType -> Bool): Bool {
    this.stypes.any(f)
  }

  fun all(f: SType -> Bool): Bool {
    this.stypes.all(f)
  }

  fun singleElt(): ?SType {
    if (this.stypes.size() == 1) this.stypes.minimum() else None()
  }

  fun getConstantString(): ?PrimLiteral {
    this.singleElt() match {
    | Some(TPrimValue(TString(), Some(lits), _)) -> lits.singleElt()
    | _ -> None()
    }
  }

  fun staticValue(): ?String {
    this.singleElt() match {
    | Some(TPrimValue(_, Some(lits), _)) -> lits.singleElt().map(lit -> lit.val)
    | _ -> None()
    }
  }

  fun toString(): String {
    prettyPrintSTypes(this)
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  static fun diff(left: STypes, right: STypes): STypes {
    STypes(
      left.stypes.mapDiff(right.stypes, (leftSType, rightSType) ->
        (leftSType, rightSType) match {
        | (TPrimValue(k, lits1, pos), TPrimValue(_, lits2, _)) ->
          (lits1, lits2) match {
          // lits1 - lits2 = lits1 \ lits2
          | (Some(l1), Some(l2)) ->
            l1.diff(l2).map(l -> TPrimValue(k, Some(l), pos))
          // literal - full = bottom
          | (Some _, None()) -> None()
          // full - literal <= full
          | (None(), Some _) -> Some(leftSType)
          // full - full = bottom
          | (None(), None()) -> None()
          }
        // TPrimUnit tags uniquely determine value: left - right = bottom
        | (TPrimUnit _, TPrimUnit _) -> None()
        // left = right: left - right = bottom
        | _ if (leftSType == rightSType) -> None()
        // Over-approximate: left - right <= left
        | _ -> Some(leftSType)
        }
      ),
    )
  }
}

/* Type variable */
//
// Introduced:
// - for local variables
// - when instantiating a generic type or a function
//
// Interpretation:
// 〚 tvar 〛 = more or less* subst[tvar.id] ⨅ 〚 tvar.constraints 〛
// 〚 constraints 〛 = ⨅ 〚 c 〛 for c in constraints
//
// *see Subst#get
class TVar private (
  pos: PosRange,
  id: Int,
  constraints: SortedSet<TType>,
) extends TInst {
  static fun create(pos: PosRange, id: Int): TVar {
    TVar(pos, id, SortedSet[])
  }

  fun addConstraint(ty: TType): TVar {
    !this.constraints = this.constraints.set(ty);
    this
  }

  fun mapConstraints(f: TType -> TType): TVar {
    !this.constraints = this.constraints.map(f);
    this
  }
  fun xxhash(ignorePos: Bool = false): XXHash {
    XXHash(
      this.constraints.iterator().foldl(
        (seed, t) -> {
          XXHash64.xxHash64(seed, t.xxhash(ignorePos).value)
        },
        XXHash64.xxHash64(this.id, this.pos.xxhash(ignorePos).value),
      ),
    )
  }
}

/* Unexpanded named type */
// possibly with type arguments
class TSInst(name: Name, targs: TArgs) extends TInst {}

class TArgs(targs: Array<TType>) uses XXHashable, Orderable

base class TInst uses XXHashable, Orderable

/* "Instance"/Unexpanded types */
//
// Interpretation:
// 〚 tinsts 〛 = ⨆ 〚 inst 〛, for inst in tinsts.insts
class TInsts private (insts: ArraySet<TInst>) uses XXHashable, Orderable {
  static fun empty(): TInsts {
    TInsts(ArraySet::empty())
  }

  static fun single(inst: TInst): TInsts {
    TInsts(ArraySet::single(inst))
  }

  fun map(f: TInst -> TInst): TInsts {
    TInsts(this.insts.map(f))
  }

  fun filterMap(f: TInst -> ?TInst): TInsts {
    TInsts(this.insts.filterMap(f))
  }

  fun isEmpty(): Bool {
    this.insts.isEmpty()
  }

  fun values(): mutable Iterator<TInst> {
    this.insts.values()
  }

  fun getSingleVar(): ?TVar {
    this.insts.getUnique() match {
    | Some(var @ TVar _) -> Some(var)
    | _ -> None()
    }
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  static fun diff(left: TInsts, right: TInsts): TInsts {
    TInsts(left.insts.diff(right.insts))
  }
}

value class Id private (id: String) uses XXHashable, Orderable, Show {
  static fun create(name: String, id: Int, lexer: readonly Lexer): Id {
    Id(`${name}:${id}:${lexer.relativeFileNameHash}`)
  }

  fun prefixWith(pre: String): Id {
    Id(pre + this.id)
  }

  static fun createThis(): Id {
    Id("this")
  }

  fun toString(): String {
    this.id
  }
}

class TParamWithConstraint(
  name: String,
  fileName: FAbsolute,
  id: Id,
  cstr: ?TType,
) uses XXHashable, Orderable {
  //
  fun withoutConstraint(): TParam {
    TParam(this.name, this.fileName, this.id)
  }
}

class TParam(
  name: String,
  fileName: FAbsolute,
  id: Id,
) uses XXHashable, Orderable

/* Clause */
//
// Interpretation:
// 〚 clause 〛 = 〚 clause.vars 〛 ⨅ 〚 clause.stypes 〛
// 〚 vars 〛 = ⨅ 〚 v 〛, for v in vars
// 〚 stypes 〛 = Top     if stypes is None
//              〚 st 〛  if stypes = Some(st)
//                \-->  see STypes, this is a union
//
// In particular, Clause(ArraySet[], None()) represents ⊤
//                Clause(_, Some(STypes::empty())) represents ⊥
class Clause private (
  vars: ArraySet<TParam>,
  stypes: ?STypes,
) uses XXHashable, Orderable, Projectable<ArraySet<TParam>> {
  /* Invariant: Clause cannot be bottom */

  // Returns None if the result is bottom (i.e. if stypes is Some(bottom))
  static fun create(vars: ArraySet<TParam>, stypes: ?STypes): ?Clause {
    stypes match {
    | Some(s) if (s.isEmpty()) -> None()
    | _ -> Some(Clause(vars, stypes))
    }
  }

  // Returns None if the result is bottom (i.e. if stypes is bottom)
  static fun fromSTypes(stypes: STypes): ?Clause {
    Clause::create(ArraySet::empty(), Some(stypes))
  }

  static fun undefined(pos: PosRange): Clause {
    Clause(
      ArraySet::empty(),
      Some(STypes::single(TPrimUnit(TUndefined(), pos))),
    )
  }

  static fun top(): Clause {
    Clause(ArraySet::empty(), None())
  }

  // Returns None if the result is bottom
  fun map_(
    fVars: ArraySet<TParam> -> ArraySet<TParam>,
    fSTypesOpt: (?STypes) -> ?STypes,
  ): ?Clause {
    fSTypesOpt(this.stypes) match {
    | Some(sTypes) if (sTypes.isEmpty()) -> None()
    | sTypes -> Some(Clause(fVars(this.vars), sTypes))
    }
  }

  // Returns None if the result is bottom
  fun map(
    fTParam: TParam -> TParam,
    fSTypesOpt: (?STypes) -> ?STypes,
  ): ?Clause {
    this.map_(vars -> vars.map(fTParam), fSTypesOpt)
  }

  // t.mapSTypes(f) is t with stypes updated by f
  // Returns None if the result is bottom
  fun mapSTypes(f: (?STypes) -> ?STypes): ?Clause {
    this.map_(vars -> vars, f)
  }

  fun getConstantString(): ?PrimLiteral {
    if (!this.vars.isEmpty()) None() else {
      this.stypes.flatMap(sTypes -> sTypes.getConstantString())
    }
  }

  fun isTop(): Bool {
    this.stypes is None() && this.vars.isEmpty()
  }

  fun project(): ArraySet<TParam> {
    this.vars
  }

  fun toString(): String {
    prettyPrintClause(this)
  }

  /*
    t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
    i.e. such that t3 <= 1 and t3 | t2 >= t1
    Returns None if the result is bottom */
  static fun diff(left: Clause, right: Clause): ?Clause {
    (left.stypes, right.stypes) match {
    | (_, None()) ->
      None() // anything - Top = bottom
    | (None(), Some(_)) ->
      Some(left) // Top - Something <= Top (keep clause)
    | (Some(stypesLeft), Some(stypesRight)) ->
      // Compute the difference of the stypes
      diffResult = STypes::diff(stypesLeft, stypesRight);
      Clause::create(left.vars, Some(diffResult))
    }
  }
}

/* Clauses: type parameters and simple types in DNF */
//
// Interpretation:
// 〚 clauses 〛 = ⨆ 〚 c 〛, for c in clauses.clauses
class Clauses private (
  clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
) uses XXHashable, Orderable {
  /*
    Invariant: if one of the clauses is Top, then there are no other clauses
   */
  private static fun create(
    clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
  ): Clauses {
    if (clauses.any(c -> c.isTop())) Clauses::top() else Clauses(clauses)
  }

  static fun empty(): Clauses {
    Clauses(InternalKeyedArrayMap::empty())
  }

  static fun top(): Clauses {
    Clauses(InternalKeyedArrayMap::single(Clause::top()))
  }

  fun map(f: Clause -> ?Clause): Clauses {
    Clauses::create(
      InternalKeyedArrayMap::createFromIterator(
        this.clauses.values().filterMap(f),
      ),
    )
  }

  fun isEmpty(): Bool {
    this.clauses.isEmpty()
  }

  fun isTop(): Bool {
    this.clauses.singleElt() match {
    | None() -> false
    | Some(clause) -> clause.isTop()
    }
  }

  static fun singleClause(clause: Clause): Clauses {
    Clauses(InternalKeyedArrayMap::single(clause))
  }

  static fun single(tparam: TParam): Clauses {
    Clause::create(ArraySet::single(tparam), None()) match {
    | None() -> Clauses::empty()
    | Some(clause) -> Clauses(InternalKeyedArrayMap::single(clause))
    }
  }

  static fun fromSTypes(stypes: STypes): Clauses {
    Clause::fromSTypes(stypes) match {
    | None() -> Clauses::empty()
    | Some(clause) -> Clauses(InternalKeyedArrayMap::single(clause))
    }
  }

  fun getConstantString(): ?PrimLiteral {
    this.clauses.singleElt().flatMap(clause -> clause.getConstantString())
  }

  // t.mapSTypes(f) is t with stypes updated by f
  fun mapSTypes(f: (?STypes) -> ?STypes): Clauses {
    Clauses(this.clauses.filterMap(clause -> clause.mapSTypes(f)))
  }

  // Returns the actual STypes, forgetting type parameters,
  // so the return value over-approximates the type
  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, tenv: TEnv): ?STypes {
    result = STypes::empty();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(clauseSTypes) ->
        !result = STypes::union(subst, tenv, result, clauseSTypes)
      }
    };
    Some(result)
  }

  fun primKind(): ?Name {
    cand: ?TPrimValue = None();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(stypes) ->
        for (stype in stypes) {
          (stype, cand) match {
          | (prim @ TPrimValue _, None()) -> !cand = Some(prim)
          | (
            TPrimValue(kind, _, _),
            Some(TPrimValue(candKind, _, _)),
          ) if (kind == candKind) ->
            void
          | _ -> return None()
          }
        }
      }
    };
    cand.map(prim -> prim.asClassName())
  }

  fun getObject(): ?TObject {
    this.clauses.singleElt().flatMap(clause ->
      clause.stypes.flatMap(stypes -> {
        stypes.singleElt() match {
        | Some(obj @ TObject _) -> Some(obj)
        | _ -> None()
        }
      })
    )
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  static fun diff(left: Clauses, right: Clauses): Clauses {
    // For each left clause, subtract all right clauses whose vars are
    // subsets (that is, supertypes).
    Clauses::create(
      left.clauses.filterMap(clauseLeft -> {
        leftVars = clauseLeft.vars;
        init: ?Clause = Some(clauseLeft);
        right.clauses
          .values()
          .foldl(
            (acc, clauseRight) -> {
              if (leftVars.contains(clauseRight.vars)) {
                acc.flatMap(c -> Clause::diff(c, clauseRight))
              } else {
                acc
              }
            },
            init,
          )
      }),
    )
  }

  fun any(f: Clause -> Bool): Bool {
    this.clauses.any(f)
  }

  fun values(): mutable Iterator<Clause> {
    this.clauses.values()
  }

  fun toString(): String {
    prettyPrintClauses(this)
  }
}

module end;
