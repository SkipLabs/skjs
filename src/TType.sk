/***************************************************************************/
// This file defines all the operation on types used during the
// type-checking phase.
//
// All the class involved start with "T" for type, or "ST" for single
// type. A class that starts with "T" is just a type, a type that
// starts with "ST" means that it represents a single type out of a
// larger union.
//
// For example: the type number | undefined is represented by a class
// TType that contains a union of SType where the STypes are "number"
// and "undefined".
/***************************************************************************/

module SKJS;

/***************************************************************************/
// The class representing all the types.
//
// The class has 2 important parts:
//
//   - the clauses which represent both parameters and concrete single types
//   (number, undefined, null, ...) under a disjunctive normal form
//
//   - the instances (which represent type variables, unexpanded type
//   instances and unexpanded intersections).
//
// A few examples:
//   number | void           ==> TType(clauses = void | number)
//   Foo<number> | number    ==> TType(clauses = number, insts = Foo<number>)
//   T2 extends A | T1       ==> TType(clauses = T1 | T2 extends A)
//
// Note that some operations will require a so-called "expansion", an
// expansion consisting in getting rid of all the instances and turn
// them into clauses. Note that the expansion is only one
// level deep, so if a type is defined recursively, the expansion will
// not affect the instances defined inside the type.
//
// Interpretation:
// 〚 ttype 〛 = 〚 ttype.insts 〛 ⨆ 〚 ttype.clauses 〛
//
/***************************************************************************/

class TType private {
  // The position in the source-code that serves as a witness, when an
  // error occurs involving this type, we will use that position in
  // the error message.
  pos: PosRange,

  // The hash, it's important because we need to quickly determine if
  // two types are different. The hash is computed by smart constructors,
  // that's why the constructor is private
  private h: XXHash,

  // The list of type instances which can be:
  // - Type variables
  // - Unexpanded type instances MyClass<number>
  // - Unexpanded intersections TInter(t1, t2)
  insts: TInsts,

  // Single types and type parameters (universally quantified type variables), in a
  // sorted disjunctive normal form. So if you write: T1 & (T3 | T2)
  // that will be turned into T1 & T2 | T1 & T3.
  clauses: Clauses,
} uses XXHashable, Orderable {
  // CONSTRUCTORS

  // Returns the type that is sub-type of all types. This type is
  // impossible to construct, meaning, a value of this type is always
  // unreachable code. However, that type can still be useful to
  // represent some values (like exceptions).
  static fun bottom(pos: PosRange): this {
    static::create(pos, TInsts::empty(), Clauses::empty())
  }

  // Returns the type that represents all possible values. Every other
  // type is sub-type of top.
  static fun top(pos: PosRange): this {
    static::create(pos, TInsts::empty(), Clauses::top())
  }

  // A single atomic type.
  static fun single(sType: SType): this {
    static::fromSTypes(sType.pos, STypes::single(sType))
  }

  static fun stringOrNumber(
    pos: PosRange,
    strValues: ?ArrayValues = None(),
    nbrValues: ?ArrayValues = None(),
  ): this {
    static::fromSTypes(pos, STypes::stringOrNumber(pos, strValues, nbrValues))
  }

  static fun nullish(pos: PosRange): this {
    static::fromSTypes(pos, STypes::nullish(pos))
  }

  // Type variable.
  static fun var(v: TVar): this {
    static::create(v.pos, TInsts::single(v), Clauses::empty())
  }

  // Unexpanded instance of a named generic type.
  static fun inst(name: Name, targs: TArgs): this {
    x = TSInst(name, targs);
    static::create(name.pos, TInsts::single(x), Clauses::empty())
  }

  static private fun fromSTypes(pos: PosRange, sTypes: STypes): this {
    static::fromClauses(pos, Clauses::fromSTypes(sTypes))
  }

  static private fun fromTParam(
    pos: PosRange,
    tParam: TParam,
    stypes: ?STypes = None(),
  ): this {
    TType::fromClauses(pos, Clauses::single(tParam, stypes))
  }

  static fun fromTParamWithConstraint(
    subst: mutable Subst,
    tenv: TEnv,
    pos: PosRange,
    tparam: TParamWithConstraint,
    stypes: ?STypes,
  ): this {
    ty = TType::fromTParam(
      pos,
      TParam(tparam.name, tparam.fileName, tparam.id),
      stypes,
    );
    tparam.cstr match {
    | None() -> ty
    | Some(cstr) -> TType::inter(subst, tenv, ty, cstr)
    }
  }

  static private fun fromClauses(pos: PosRange, clauses: Clauses): this {
    static::create(pos, TInsts::empty(), clauses)
  }

  static private fun create(
    pos: PosRange,
    insts: TInsts,
    clauses: Clauses,
  ): this {
    if (clauses.isTop()) {
      !insts = TInsts::empty();
    };
    h = (insts, clauses).xxhash(true);
    static{h, pos, insts, clauses};
  }

  // TRANSFORMERS

  // t.mapSTypes(subst, env, variance, f) is t with stypes updated by f, or
  // None() if the result is Top
  fun mapSTypes(
    subst: mutable Subst,
    env: TEnv,
    variance: Variance,
    f: (STypes) -> STypes,
  ): ?this {
    this.getSTypes(subst, env, variance).map(stypes ->
      TType::fromSTypes(this.pos, f(stypes))
    )
  }

  private fun mapClauses(
    subst: mutable Subst,
    tenv: TEnv,
    f: Clause -> this,
  ): this {
    if (this.clauses.isEmpty()) {
      this
    } else {
      accum = TType::create(this.pos, this.insts, Clauses::empty());
      for (clause in this.clauses.clauses) {
        !accum = TType::union(subst, tenv, accum, f(clause));
      };
      accum
    }
  }

  // t.mapTParams(subst, tenv, f) is t with each TParam p replaced by u
  // where f(p) is Some(u), or left unchanged if f(p) is None. The type's
  // unions and intersections are rebuilt using subst and tenv.
  fun mapTParams(
    subst: mutable Subst,
    tenv: TEnv,
    f: (TParam) -> ?TType,
  ): this {
    this.mapClauses(subst, tenv, clause0 -> {
      clause1 = TType::top(this.pos);
      for (tparam in clause0.vars) {
        paramTy = f(tparam) match {
        | None() -> TType::fromTParam(this.pos, tparam)
        | Some(ty) -> ty
        };
        !clause1 = TType::inter(subst, tenv, clause1, paramTy)
      };
      clause0.stypes match {
      | None() -> clause1
      | Some(stypes) ->
        TType::inter(subst, tenv, clause1, TType::fromSTypes(this.pos, stypes))
      }
    })
  }

  fun withPos(pos: PosRange): this {
    // pos is not part of the hash
    this with {pos}
  }

  fun rawMap(insts: (TInsts) -> TInsts, clauses: (Clauses) -> Clauses): this {
    static::create(this.pos, insts(this.insts), clauses(this.clauses))
  }

  // UTILITIES

  fun toString(): String {
    prettyPrintType(false, this)
  }

  fun compare(other: this): Order {
    this.h.compare(other.h)
  }

  fun hash(): Int {
    this.h.value
  }

  fun xxhash(ignorePos: Bool = false): XXHash {
    if (ignorePos) this.h else (this.insts, this.clauses).xxhash()
  }

  // BOOLEAN PROPERTIES

  fun isBottom(): Bool {
    this.insts.isEmpty() && this.clauses.isEmpty()
  }

  fun isTop(): Bool {
    this.clauses.isTop()
  }

  fun isPrimitiveType(subst: mutable Subst, tenv: TEnv): Bool {
    this.getSTypes(subst, tenv, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      for (stype in stypes) {
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          continue
        | TTuple(tys, _) ->
          for (ty in tys) {
            if (!ty.isPrimitiveType(subst, tenv)) return false
          }
        | TAlgebraic _
        | TFuns _
        | TObject _
        | TPromise _ ->
          return false
        }
      };
      true
    }
  }

  fun isMethod(subst: mutable Subst, tenv: TEnv): Bool {
    this.getSTypes(subst, tenv, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      if (stypes.isEmpty()) return false;
      for (stype in stypes) {
        stype match {
        | TFuns(funs, _, _) if (funs.isEmpty()) -> void
        | _ -> return false
        }
      };
      true
    }
  }

  // OTHER PROPERTIES

  // Returns the actual STypes after head expansion, forgetting type parameters,
  // so the return value over-approximates the type
  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, tenv: TEnv, variance: Variance): ?STypes {
    this.expand_(subst, tenv, variance).getSTypes(subst, tenv)
  }

  fun expand_(subst: mutable Subst, tenv: TEnv, variance: Variance): Clauses {
    clauses = this.clauses;
    insts = Vector::mcreateFromItems(this.insts.insts);
    seen = SortedSet::createFromItems(insts);
    loop {
      if (insts.isEmpty()) return clauses;
      inst = insts.pop();
      tyDef = inst match {
      | TSInst(name, targs) -> tenv.instantiate(subst, name, targs)
      | TInter(ty1, ty2) -> TType::inter(subst, tenv, ty1, ty2)
      | TUnion(ty1, ty2) -> TType::union(subst, tenv, ty1, ty2)
      | tvar @ TVar _ -> subst.get(tenv, tvar, variance)
      };
      if (tyDef.isTop()) return Clauses::top();
      !clauses = Clauses::union(subst, tenv, clauses, tyDef.clauses);
      for (newInst in tyDef.insts) {
        if (seen.contains(newInst)) continue;
        !seen = seen.set(newInst);
        insts.push(newInst);
      }
    }
  }

  fun expand(subst: mutable Subst, tenv: TEnv, variance: Variance): TType {
    static::fromClauses(this.pos, this.expand_(subst, tenv, variance))
  }

  fun getConstantString(): ?(PosRange, String) {
    if (!this.insts.isEmpty()) None() else {
      this.clauses.getConstantString()
    }
  }

  fun getSingleVar(): ?TVar {
    if (this.clauses.isEmpty()) this.insts.getSingleVar() else {
      None()
    }
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  fun diff(other: TType): TType {
    diffInsts = this.insts.diff(other.insts);
    diffClauses = this.clauses.diff(other.clauses);
    static::create(this.pos, diffInsts, diffClauses)
  }
}

base class Variance {
  children =
  | Covariant()
  | Contravariant()
}

/***************************************************************************/
/* Object types. */
/***************************************************************************/

// Regular Typescript (open) object type
// but disjoint from types in TAlgebraic
class TObject(fields: TFields) extends SType

const kAlgebraicBranchFieldName: String = "kind";

class TAlgebraic(
  branches: InternalKeyedArrayMap<String, TConstr>,
) extends SType {
  static fun single(x: TConstr, pos: PosRange): this {
    static(InternalKeyedArrayMap::single(x), pos)
  }
}

class TConstr(
  tag: String,
  tagPos: PosRange,
  // TODO: make fields private so that we don't try to access "kind" from fields
  fields: TFields,
) uses XXHashable, Orderable, Projectable<String> {
  fun map(f: TFields -> TFields): this {
    static(this.tag, this.tagPos, f(this.fields))
  }

  fun getType(subst: mutable Subst, tenv: TEnv, fieldName: Name): TType {
    if (fieldName.value == kAlgebraicBranchFieldName) {
      pos = this.tagPos;
      TType::single(TPrimValue::single(TString(), this.tag, pos))
    } else {
      this.fields.getType(subst, tenv, fieldName)
    }
  }

  fun project(): String {
    this.tag
  }
}

fun createObject(
  pos: PosRange,
  algebraicBranchField: ?(PosRange, TType),
  fields: TFields,
): TType {
  seen = mutable Set<String>[];
  for (field in fields) {
    if (seen.contains(field.name)) {
      typingError(Array[(field.pos, "Duplicate field")])
    };
    seen.insert(field.name);
  };
  algebraicBranchField match {
  | Some((algebraicBranchFieldPos, algebraicBranchFieldType)) ->
    algebraicBranchFieldType.getConstantString() match {
    | None() ->
      typingError(
        Array[
          (
            pos,
            `Algebraic field ${kAlgebraicBranchFieldName} was expected to be a constant string`,
          ),
          (algebraicBranchFieldPos, `Got ${algebraicBranchFieldType} instead.`),
        ],
      )
    | Some((tagPos, tag)) ->
      TType::single(
        TAlgebraic::single(
          TConstr(tag, tagPos, fields),
          algebraicBranchFieldPos,
        ),
      )
    }
  | None() -> TType::single(TObject(fields, pos))
  }
}

/***************************************************************************/
/* Tuples */
/***************************************************************************/

class TTuple(tuple: Array<TType>) extends SType {
  fun toString(): String {
    internal_error("TODO TTuple toString")
  }
}

/***************************************************************************/
/* Funs */
/***************************************************************************/

class TFuns private (
  funs: InternalKeyedArrayMap<(Int, Int), TFun>,
  methods: InternalKeyedArrayMap<(Int, Int), TFun>,
) extends SType {
  /* Invariant: funs and methods are not both empty */

  static fun singleFun(x: TFun, pos: PosRange): this {
    static(
      InternalKeyedArrayMap::single(x),
      InternalKeyedArrayMap::empty(),
      pos,
    )
  }

  static fun singleMethod(x: TFun, pos: PosRange): this {
    static(
      InternalKeyedArrayMap::empty(),
      InternalKeyedArrayMap::single(x),
      pos,
    )
  }

  fun mapFuns(f: TFun -> TFun): this {
    static(this.funs.map(f), this.methods.map(f), this.pos)
  }
}

class TFun(
  tparams: Array<TParamWithConstraint>,
  params: Array<TType>,
  optionalParams: Array<TType>,
  spreadParam: ?TType,
  minSizeWitness: PosRange,
  retType: TType,
  cgNodes: CGNodes,
) uses XXHashable, Orderable, Projectable<(Int, Int)> {
  fun toString(): String {
    prettyPrintSType(TFuns::singleFun(this, PosRange::none))
  }

  fun project(): (Int, Int) {
    (this.tparams.size(), this.params.size())
  }
}

/***************************************************************************/
/* Single types */
/***************************************************************************/

/* Types with a single inhabitant:
- undefined for types void and undefined
- null for type null

In Typescript, void is both bottom and a supertype of everything when used as a
return type.

In SKJS, we decided (see https://github.com/SkipLabs/skjs/issues/75) that void
would be a distinct type from undefined. It contains the value undefined but
with no operations permitted on it.

We should ensure that nothing non-undefined can be of type void. */
base class TPrimUnitKind uses XXHashable, Orderable {
  children =
  | TUndefined()
  | TVoid()
  | TNull()

  fun toString(): String {
    this match {
    | TUndefined() -> "undefined"
    | TVoid() -> "void"
    | TNull() -> "null"
    }
  }
}

/* Types with literal subtypes: booleans, numbers, strings, and bigints. */
base class TPrimValueKind uses XXHashable, Orderable {
  children =
  | TNum()
  | TBool()
  | TString()
  | TBigInt()

  fun toString(): String {
    this match {
    | TNum() -> "number"
    | TBool() -> "boolean"
    | TString() -> "string"
    | TBigInt() -> "bigint"
    }
  }
}

base class SType private (
  pos: PosRange,
) uses XXHashable, Orderable, Projectable<Int> {
  children =
  | TPromise(TType)

  fun tag(): Int {
    this match {
    | TPrimUnit(TUndefined(), _) -> 0
    | TPrimUnit(TVoid(), _) -> 1
    | TPrimUnit(TNull(), _) -> 2
    | TPrimValue(TBool(), _, _) -> 3
    | TPrimValue(TNum(), _, _) -> 4
    | TPrimValue(TString(), _, _) -> 5
    | TPrimValue(TBigInt(), _, _) -> 6
    | TTuple _ -> 7
    | TPromise _ -> 8
    | TObject _ -> 9
    | TAlgebraic _ -> 10
    | TFuns _ -> 11
    }
  }

  fun project(): Int {
    this.tag()
  }
}

class TPrimUnit(kind: TPrimUnitKind) extends SType

class TPrimValue(kind: TPrimValueKind, values: ?ArrayValues) extends SType {
  static fun single(kind: TPrimValueKind, value: String, pos: PosRange): this {
    static(kind, Some(ArrayValues::single((pos, value))), pos)
  }

  static fun full(kind: TPrimValueKind, pos: PosRange): this {
    static(kind, None(), pos)
  }

  static fun boolean(pos: PosRange): this {
    static::full(TBool(), pos)
  }

  static fun number(pos: PosRange): this {
    static::full(TNum(), pos)
  }

  static fun string(pos: PosRange): this {
    static::full(TString(), pos)
  }

  static fun bigint(pos: PosRange): this {
    static::full(TBigInt(), pos)
  }
}

class TField private (
  pos: PosRange,
  name: /* Invariant: name != kAlgebraicBranchFieldName */ String,
  isOptional: Bool,
  type: TType,
) uses XXHashable, Orderable, Projectable<String> {
  static fun create(
    pos: PosRange,
    name: String,
    isOptional: Bool,
    type: TType,
  ): ?this {
    if (name == kAlgebraicBranchFieldName) None() else {
      Some(static(pos, name, isOptional, type))
    }
  }

  fun withOptional(): this {
    this with {isOptional => true}
  }

  fun mapType(f: TType -> TType): this {
    this with {type => f(this.type)}
  }

  fun project(): String {
    this.name
  }
}

/* Fields such as { [keyName: KeyType]: ValueType } */
class TIndexField(
  pos: PosRange,
  keyName: String,
  keyType: TType,
  valueType: TType,
) uses XXHashable, Orderable {
  fun mapTypes(f: TType -> TType): this {
    keyType = f(this.keyType);
    valueType = f(this.valueType);
    this with {keyType, valueType}
  }
}

class TFields private (
  fields: InternalKeyedArrayMap<String, TField>,
  indexes: Array<TIndexField>,
  /* There can be several index fields.
     Typescript allows only one per object, but is fine with
     intersecting two objects with index fields, so it's like having
     two of them. This array is expected to have zero or one element
     most of the time, or at most a few elements.

     TODO: allow only subtypes of string | number (| symbol)
     TODO: if a field name is included an index key type, then its
      type must be a subtype of the index key type
  */
) uses XXHashable, Orderable {
  static fun empty(): this {
    static(InternalKeyedArrayMap::empty(), Array[])
  }

  static fun create(fields: Array<TField>, indexes: Array<TIndexField>): this {
    static(
      InternalKeyedArrayMap::createFromSortedIterator(
        fields.sortedBy(x ~> x.name).values(),
      ),
      indexes,
    )
  }

  fun isEmpty(): Bool {
    this.fields.isEmpty() && this.indexes.isEmpty()
  }

  fun map(
    fField: TField -> TField,
    fIndexField: TIndexField -> TIndexField,
  ): this {
    static(this.fields.map(fField), this.indexes.map(fIndexField))
  }

  fun filterMap(f: TField -> ?TField): this {
    static(this.fields.filterMap(f), this.indexes)
  }

  fun values(): mutable Iterator<TField> {
    this.fields.values()
  }

  fun maybeSingleIndex(): ?TIndexField {
    this.indexes.size() match {
    | 0 -> None()
    | 1 -> Some(this.indexes[0])
    | _ -> internal_error("TODO: multiple indexes")
    }
  }

  fun maybeGet(fieldName: String): ?TField {
    this.fields.maybeGet(fieldName)
  }

  fun maybeGetType(subst: mutable Subst, tenv: TEnv, fieldName: Name): ?TType {
    this.maybeGet(fieldName.value).map(fd -> {
      ty = fd.type;
      if (fd.isOptional) {
        ty.unionUndefined(subst, tenv, fieldName.pos)
      } else {
        ty
      }
    })
  }

  fun getTypeTypingError<T>(fieldName: Name): T {
    typingError(
      Array[
        (fieldName.pos, `Unbound field: ${fieldName.value}`),
        (
          fieldName.pos,
          "Possible options are:\n" +
            this.fields.filter(x -> x.name != "constructor")
              .toArray()
              .map(x -> x.name)
              .join("\n"),
        ),
      ],
    )
  }

  fun getType(subst: mutable Subst, tenv: TEnv, fieldName: Name): TType {
    this.maybeGetType(subst, tenv, fieldName) match {
    | None() -> this.getTypeTypingError(fieldName)
    | Some(ty) -> ty
    }
  }
}

class STypes private (
  private stypes: InternalKeyedArrayMap<Int, SType>,
) uses XXHashable, Orderable {
  static fun empty(): this {
    static(InternalKeyedArrayMap::empty())
  }

  static fun single(x: SType): this {
    static(InternalKeyedArrayMap::single(x))
  }

  static fun nullish(pos: PosRange): this {
    static(
      InternalKeyedArrayMap::two(
        (TPrimUnit(TNull(), pos) : SType),
        TPrimUnit(TUndefined(), pos),
      ),
    )
  }

  static fun stringOrNumber(
    pos: PosRange,
    strValues: ?ArrayValues = None(),
    nbrValues: ?ArrayValues = None(),
  ): this {
    static(
      InternalKeyedArrayMap::two(
        (TPrimValue(TString(), strValues, pos) : SType),
        TPrimValue(TNum(), nbrValues, pos),
      ),
    )
  }

  fun map(f: SType -> SType): this {
    static(this.stypes.map(f))
  }

  fun filter(f: SType -> Bool): this {
    static(this.stypes.filter(f))
  }

  fun filterMap(f: SType -> ?SType): this {
    static(this.stypes.filterMap(f))
  }

  fun isEmpty(): Bool {
    this.stypes.isEmpty()
  }

  fun size(): Int {
    this.stypes.size()
  }

  fun items(): mutable Iterator<(Int, SType)> {
    this.stypes.items()
  }

  fun values(): mutable Iterator<SType> {
    this.stypes.values()
  }

  fun any(f: SType -> Bool): Bool {
    this.stypes.any(f)
  }

  fun all(f: SType -> Bool): Bool {
    this.stypes.all(f)
  }

  fun singleElt(): ?SType {
    if (this.stypes.size() == 1) this.stypes.minimum() else None()
  }

  fun getConstantString(): ?(PosRange, String) {
    this.singleElt() match {
    | Some(TPrimValue(TString(), Some(values), _)) -> values.singleElt()
    | _ -> None()
    }
  }

  fun staticValue(): ?String {
    this.singleElt() match {
    | Some(TPrimValue(_, Some(values), _)) -> values.singleElt().map(v -> v.i1)
    | _ -> None()
    }
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  fun diff(other: STypes): STypes {
    (noMatch1, _noMatch2, _present) = mapInter(
      this.stypes.values(),
      other.stypes.values(),
      x ~> x.project(),
      (x, _) ~> x,
    );
    static(InternalKeyedArrayMap::createFromSortedIterator(noMatch1.iterator()))
  }
}

/* Type variable */
//
// Introduced:
// - for local variables
// - when instantiating a generic type or a function
//
// Interpretation:
// 〚 tvar 〛 = more or less* subst[tvar.id] ⨅ 〚 tvar.constraints 〛
// 〚 constraints 〛 = ⨅ 〚 c 〛 for c in constraints
//
// *see Subst#get
class TVar private (
  pos: PosRange,
  id: Int,
  constraints: SortedMap<Int, TType>,
) extends TInst {
  static fun create(pos: PosRange, id: Int): this {
    static(pos, id, SortedMap[])
  }

  fun addConstraint(ty: TType): this {
    !this.constraints[ty.hash()] = ty;
    this
  }

  fun mapConstraints(f: TType -> TType): this {
    !this.constraints = this.constraints.map((_id, ty) -> f(ty));
    this
  }
  fun xxhash(ignorePos: Bool = false): XXHash {
    XXHash(
      this.constraints.items().foldl(
        (seed, kv) -> {
          k = kv.i0.xxhash(ignorePos).value;
          v = kv.i1.xxhash(ignorePos).value;
          XXHash64.xxHash64(XXHash64.xxHash64(seed, k), v)
        },
        XXHash64.xxHash64(this.id, this.pos.xxhash(ignorePos).value),
      ),
    )
  }
}

/* Unexpanded named type */
// possibly with type arguments
class TSInst(name: Name, targs: TArgs) extends TInst {}

class TArgs(targs: Array<TType>) uses XXHashable, Orderable

base class TInst uses XXHashable, Orderable

/* "Instance"/Unexpanded types */
//
// Interpretation:
// 〚 tinsts 〛 = ⨆ 〚 inst 〛, for inst in tinsts.insts
class TInsts private (insts: Array<TInst>) uses XXHashable, Orderable {
  static fun empty(): this {
    static(Array[])
  }

  static fun single(inst: TInst): this {
    TInsts(Array[inst])
  }

  fun map(f: TInst -> TInst): this {
    static(this.insts.map(f))
  }

  fun isEmpty(): Bool {
    this.insts.isEmpty()
  }

  fun values(): mutable Iterator<TInst> {
    this.insts.values()
  }

  fun getSingleVar(): ?TVar {
    if (this.insts.size() == 1) {
      this.insts[0] match {
      | res @ TVar _ -> Some(res)
      | _ -> None()
      }
    } else {
      None()
    }
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  fun diff(other: TInsts): TInsts {
    (noMatch1, _noMatch2, _present) = mapInter(
      this.values(),
      other.values(),
      x ~> x,
      (x, _) ~> x,
    );
    static(noMatch1)
  }
}

value class Id private (id: String) uses XXHashable, Orderable, Show {
  static fun create(name: String, id: Int, lexer: readonly Lexer): this {
    static(`${name}:${id}:${lexer.relativeFileName.hash()}`)
  }

  fun prefixWith(pre: String): this {
    static(pre + this.id)
  }

  static fun createThis(): this {
    static("this")
  }

  fun toString(): String {
    this.id
  }
}

class TParamWithConstraint(
  name: String,
  fileName: String,
  id: Id,
  cstr: ?TType,
) uses XXHashable, Orderable

class TParam(name: String, fileName: String, id: Id) uses XXHashable, Orderable

/* Clause */
//
// Interpretation:
// 〚 clause 〛 = 〚 clause.vars 〛 ⨅ 〚 clause.stypes 〛
// 〚 vars 〛 = ⨅ 〚 v 〛, for v in vars
// 〚 stypes 〛 = Top     if stypes is None
//              〚 st 〛  if stypes = Some(st)
//                \-->  see STypes, this is a union
//
// In particular, Clause(ArraySet[], None()) represents ⊤
//                Clause(_, Some(STypes::empty())) represents ⊥
class Clause private (
  vars: ArraySet<TParam>,
  stypes: ?STypes,
) uses XXHashable, Orderable, Projectable<ArraySet<TParam>> {
  /* Invariant: Clause cannot be bottom */

  // Returns None if the result is bottom (i.e. if stypes is Some(bottom))
  static fun create(vars: ArraySet<TParam>, stypes: ?STypes): ?this {
    stypes match {
    | Some(s) if (s.isEmpty()) -> None()
    | _ -> Some(static(vars, stypes))
    }
  }

  // Returns None if the result is bottom (i.e. if stypes is bottom)
  static fun fromSTypes(stypes: STypes): ?this {
    static::create(ArraySet::empty(), Some(stypes))
  }

  static fun undefined(pos: PosRange): this {
    static(
      ArraySet::empty(),
      Some(STypes::single(TPrimUnit(TUndefined(), pos))),
    )
  }

  static fun top(): this {
    static(ArraySet::empty(), None())
  }

  // Returns None if the result is bottom
  fun map(fTParam: TParam -> TParam, fSTypes: STypes -> STypes): ?this {
    this.stypes.map(fSTypes) match {
    | Some(sTypes) if (sTypes.isEmpty()) -> None()
    | stypes ->
      vars = this.vars.map(fTParam);
      Some(static(vars, stypes))
    }
  }

  fun getConstantString(): ?(PosRange, String) {
    if (!this.vars.isEmpty()) None() else {
      this.stypes.flatMap(sTypes -> sTypes.getConstantString())
    }
  }

  fun isTop(): Bool {
    this.stypes is None() && this.vars.isEmpty()
  }

  fun project(): ArraySet<TParam> {
    this.vars
  }

  /*
    t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
    i.e. such that t3 <= 1 and t3 | t2 >= t1
    Returns None if the result is bottom */
  fun diff(other: ?STypes): ?Clause {
    (this.stypes, other) match {
    | (_, None()) ->
      None() // anything - Top = bottom
    | (None(), Some(_)) ->
      Some(this) // Top - Something <= Top (keep clause)
    | (Some(stypesThis), Some(stypesOther)) ->
      // Compute the difference of the stypes
      diffResult = stypesThis.diff(stypesOther);
      Clause::create(this.vars, Some(diffResult))
    }
  }
}

/* Clauses: type parameters and simple types in DNF */
//
// Interpretation:
// 〚 clauses 〛 = ⨆ 〚 c 〛, for c in clauses.clauses
class Clauses private (
  clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
) uses XXHashable, Orderable {
  /*
    Invariant: if one of the clauses is Top, then there are no other clauses
   */
  private static fun create(
    clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
  ): this {
    if (clauses.any(c -> c.isTop())) static::top() else Clauses(clauses)
  }

  static fun empty(): this {
    Clauses(InternalKeyedArrayMap::empty())
  }

  static fun top(): this {
    Clauses(InternalKeyedArrayMap::single(Clause::top()))
  }

  fun map(f: Clause -> ?Clause): this {
    static::create(
      InternalKeyedArrayMap::createFromIterator(
        this.clauses.values().filterMap(f),
      ),
    )
  }

  fun isEmpty(): Bool {
    this.clauses.isEmpty()
  }

  fun isTop(): Bool {
    this.clauses.singleElt() match {
    | None() -> false
    | Some(clause) -> clause.isTop()
    }
  }

  static fun singleClause(clause: Clause): this {
    static(InternalKeyedArrayMap::single(clause))
  }

  static fun single(tparam: TParam, stypes: ?STypes = None()): this {
    Clause::create(ArraySet::single(tparam), stypes) match {
    | None() -> static::empty()
    | Some(clause) -> static(InternalKeyedArrayMap::single(clause))
    }
  }

  static fun fromSTypes(stypes: STypes): this {
    Clause::fromSTypes(stypes) match {
    | None() -> static::empty()
    | Some(clause) -> static(InternalKeyedArrayMap::single(clause))
    }
  }

  fun getConstantString(): ?(PosRange, String) {
    this.clauses.singleElt().flatMap(clause -> clause.getConstantString())
  }

  // Returns the actual STypes, forgetting type parameters,
  // so the return value over-approximates the type
  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, tenv: TEnv): ?STypes {
    result = STypes::empty();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(clauseSTypes) ->
        !result = STypes::union(subst, tenv, result, clauseSTypes)
      }
    };
    Some(result)
  }

  fun primKind(): ?TPrimValueKind {
    cand: ?TPrimValueKind = None();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(stypes) ->
        for (stype in stypes) {
          stype match {
          | TPrimValue(kind, _, _) if (cand is None()) -> !cand = Some(kind)
          | TPrimValue(kind, _, _) -> if (cand != Some(kind)) return None()
          | _ -> return None()
          }
        }
      }
    };
    cand
  }

  fun getObject(): ?TObject {
    this.clauses.singleElt().flatMap(clause ->
      clause.stypes.flatMap(stypes -> {
        stypes.singleElt() match {
        | Some(obj @ TObject _) -> Some(obj)
        | _ -> None()
        }
      })
    )
  }

  /* t1.diff(t2)  computes t3, an over-approximation of t1 \ t2
     i.e. such that t3 <= t1 and t3 | t2 >= t1
   */
  fun diff(other: Clauses): Clauses {
    noParamOtherOpt = other.clauses.maybeGet(ArraySet::empty());

    // Use merge to handle the diff operation
    diffClauses = this.clauses.merge(
      other.clauses,
      (clauseThisOpt, clauseOtherOpt) -> {
        (clauseThisOpt, clauseOtherOpt, noParamOtherOpt) match {
        | (Some(clauseThis), None(), None()) ->
          Some(clauseThis) // Keep clause from this
        | (None(), _, _) ->
          None() // Don't include clauses only in other
        | (Some(clauseThis), Some(another), None())
        | (Some(clauseThis), None(), Some(another)) ->
          clauseThis.diff(another.stypes)
        | (Some(clauseThis), Some(clauseOther), Some(noParamOther)) ->
          clauseThis.diff(clauseOther.stypes).flatMap(c ->
            c.diff(noParamOther.stypes)
          )
        }
      },
    );

    static::create(diffClauses)
  }

  fun any(f: Clause -> Bool): Bool {
    this.clauses.any(f)
  }

  fun values(): mutable Iterator<Clause> {
    this.clauses.values()
  }
}

/***************************************************************************/
/* Sub-typing */
/***************************************************************************/

/* Result for a check of subtyping of types T1 and T2 */
base class STResult

/* T1 ⊑ T2 */
class STOk() extends STResult

/* All other cases: T1 ⋢ T2 */
base class STError extends STResult {
  children =
  | STNoConstraint()
  | STMissingField(String)
  | STMissingSpread()
  | STTooManySType(SType)
  | STTooManyTConstr(TConstr)
  | STTooManyTTuple(TTuple)
  | STTooManyTFun(TFun)
  | STInvalidClause(Clause)
  | STRec(STError, PosRange, TType)

  fun toString(subst: mutable Subst, tenv: TEnv, ty: TType): String {
    this match {
    | STNoConstraint() -> "This type parameter does not define a constraint"
    | STMissingSpread() -> "Missing ... parameter"
    | STMissingField(fieldName) ->
      `The field '${fieldName}' is missing\n` +
        `Out of the type: ${expandTVars(subst, tenv, ty)}`
    | STTooManySType(sty) ->
      sty match {
      | TPrimUnit(kind, _) -> `This is a ${kind}`
      | TPrimValue(TString(), None(), _) ->
        "This is of type string. " +
          "Use 'as const' to create a string literal type, for example: \"foo\" as const or 'foo' as const."
      | TPrimValue(kind, None(), _) -> `This is of type ${kind}`
      | TPrimValue(kind, Some(x), _) ->
        `This is a static ${kind}: ` +
          x.values.map(x -> `'${x.i1}'`).join(" | ")

      | TPromise _ -> "This is a Promise"
      | TAlgebraic _ ->
        "This is a constructor (the field kind is a static string)"
      | TFuns _ ->
        "This is a function of type: " +
          prettyPrintType(false, TType::single(sty))
      | TObject _ -> "This is an object"
      | TTuple(tuple, _) -> "This is a tuple of size " + tuple.size()
      }
    | STTooManyTConstr(_) -> "This is a constructor"
    | STTooManyTTuple(tuple) -> "This is a tuple of size " + tuple.tuple.size()
    | STTooManyTFun(f) ->
      "This is a function: " +
        prettyPrintType(
          false,
          TType::single(TFuns::singleFun(f, f.minSizeWitness)),
        )
    | STInvalidClause(clause) -> "This is of type " + prettyPrintClause(clause)
    | STRec(st, _, ty2) -> st.toString(subst, tenv, ty2)
    }
  }
}

module end;
