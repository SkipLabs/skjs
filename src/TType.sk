/*****************************************************************************/
// This file defines all the operation on types used during the
// type-checking phase.
//
// All the class involved start with "T" for type, or "ST" for single
// type. A class that starts with "T" is just a type, a type that
// starts with "ST" means that it represents a single type out of a
// larger union.
//
// For example: the type number | undefined is represented by a class
// TType that contains a union of SType where the STypes are "number"
// and "undefined".
/*****************************************************************************/

module SKJS;

// Arbitrary hash for Top
const kTopHash: Int = "Top".hash();

/*****************************************************************************/
// The class representing all the types.
//
// The class has 3 important parts:
//
//   - the stypes (which represent concrete single types, like number,
//   undefined, null etc ...)
//
//   - the instances (which represent type variables, unexpanded type
//   instances and unexpanded intersections).
//
//   - the parameters (normalized under a disjunctive normal form).
//
// A few examples:
//   number | void           ==> TType(stypes = void | number)
//   Foo<number> | number    ==> TType(stypes = number, insts = Foo<number>)
//   T2 extends A | T1       ==> TType(clauses = T1 | T2 extends A)
//
// Note that some operations will require a so-called "expansion", and
// expansion consisting in getting rid of all the instances and turn
// them into stypes + type params. Note that the expansion is only one
// level deep, so if a type is defined recursively, the expansion will
// not affect the instances defined inside the type.
/*****************************************************************************/

class TType private {
  // The position in the source-code that serves as a witness, when an
  // error occurs involving this type, we will use that position in
  // the error message.
  pos: PosRange,

  // The hash, it's important because we need to quickly determine if
  // two types are different. The hash is computed by smart constructors,
  // that's why the default constructor is private
  private h: Int,

  // This field is true if the type represents TOP (meaning, the type
  // that contains all possible values). Note that TOP and BOTTOM have
  // the same representation outside of this field. Why is that? We
  // could have introduced an algebraic data type of the form: TOP |
  // BOTTOM | TTYPE. The reason is that outside of those 3 operations:
  // sub-typing, intersection and union, we really want to treat TOP
  // and BOTTOM the same way. For example, imagine you are writing x.y
  // where the type of x is BOTTOM. Technically, that operation is
  // correct. But do we really want to allow it? Why would anyone
  // write an operation that we know is unreachable. From that
  // perspective, x.y when x is bottom should do the same thing as
  // when x is TOP, it should result in an error. And this
  // representation makes it nice and easy.
  isTop: Bool,

  // The list of type instances which can be:
  // - Type variables
  // - Unexpanded type instances MyClass<number>
  // - Unexpanded intersections TInter(t1, t2)
  insts: TInsts,

  // The type parameters (universally quantified type variables), in a
  // sorted disjunctive normal form. So if you write: T1 & (T3 | T2)
  // that will be turned into T1 & T2 | T1 & T3.
  clauses: Clauses,
} uses Hashable, Orderable {
  // CONSTRUCTORS

  // Returns the type that is sub-type of all types. This type is
  // impossible to construct, meaning, a value of this type is always
  // unreachable code. However, that type can still be useful to
  // represent some values (like exceptions).
  static fun bottom(pos: PosRange): this {
    static::create(pos, TInsts::empty(), Clauses::empty())
  }

  // Returns the type that represents all possible values. Every other
  // type is sub-type of top.
  static fun top(pos: PosRange): this {
    insts = TInsts::empty();
    clauses = Clauses::empty();
    static{h => kTopHash, pos, isTop => true, insts, clauses}
  }

  // Creates an unexpanded instance.
  static fun inst(name: Name, targs: TArgs): this {
    static::fromTInst(name.posRange, TSInst(name, targs))
  }

  static fun single(pos: PosRange, sType: SType): this {
    static::fromSTypes(pos, STypes::single(sType))
  }

  static fun fromTInst(pos: PosRange, tInst: TInst): this {
    static::fromTInsts(pos, TInsts::single(tInst))
  }

  static fun fromTInsts(pos: PosRange, tInsts: TInsts): this {
    static::create(pos, tInsts, Clauses::empty())
  }

  static fun fromSTypes(pos: PosRange, sTypes: STypes): this {
    static::fromClauses(pos, Clauses::fromSTypes(sTypes))
  }

  fun toString(): String {
    prettyPrintType(false, this)
  }

  static fun fromClauses(pos: PosRange, clauses: Clauses): this {
    static::create(pos, TInsts::empty(), clauses)
  }

  static fun fromTParam(pos: PosRange, tparam: TParam): this {
    static::create(pos, TInsts::empty(), Clauses::single(tparam))
  }

  static fun create(pos: PosRange, insts: TInsts, clauses: Clauses): this {
    h = (insts, clauses).hash();
    static{h, pos, isTop => false, insts, clauses};
  }

  static fun expandPrim(pos: PosRange, kind: TPrimValueKind): TType {
    kind match {
    | TString _ ->
      TType::fromTInst(pos, TSInst(Name(pos, "string"), TArgs(Array[])))
    | TBool _ ->
      TType::fromTInst(pos, TSInst(Name(pos, "boolean"), TArgs(Array[])))
    | TNum _ ->
      TType::fromTInst(pos, TSInst(Name(pos, "number"), TArgs(Array[])))
    }
  }

  fun withClauses(clauses: Clauses): this {
    if (this.isTop) {
      if (!clauses.isEmpty()) {
        invariant_violation("clauses should be empty when isTop")
      };
      this
    } else {
      static::create(this.pos, this.insts, clauses)
    }
  }

  fun withPos(pos: PosRange): this {
    // pos is not part of the hash
    this with {pos}
  }

  fun rawMap(insts: (TInsts) -> TInsts, clauses: (Clauses) -> Clauses): this {
    if (this.isTop) this else {
      static::create(this.pos, insts(this.insts), clauses(this.clauses))
    }
  }

  fun compare(other: this): Order {
    (this.h, this.insts, this.clauses).compare(
      (other.h, other.insts, other.clauses),
    )
  }

  fun hash(): Int {
    this.h
  }

  fun isBottom(): Bool {
    !this.isTop && this.insts.isEmpty() && this.clauses.isEmpty()
  }

  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, env: TEnv, variance: Variance): ?STypes {
    this.expand(subst, env, variance) match {
    | None() -> None()
    | Some(clauses) ->
      result = STypes::empty();
      for (clause in clauses.clauses) {
        clause.stypes match {
        | None() -> return None()
        | Some(clauseSTypes) ->
          !result = STypes::union(subst, env, result, clauseSTypes)
        }
      };
      Some(result)
    }
  }

  // Returns None() if the result is Top
  fun expand(subst: mutable Subst, env: TEnv, variance: Variance): ?Clauses {
    if (this.isTop) return None();
    clauses = this.clauses;
    insts = Vector::mcreateFromItems(this.insts.insts);
    seen = Set::mcreateFromItems(insts);
    loop {
      if (insts.isEmpty()) return Some(clauses);
      inst = insts.pop();
      tyDef = inst match {
      | TSInst(name, targs) -> env.instantiate(subst.context, name, targs)
      | TInter(ty1, ty2) -> interTType(subst, env, ty1, ty2)
      | tvar @ TVar _ -> subst.get(env, tvar, variance)
      };
      if (tyDef.isTop) return None();
      !clauses = Clauses::union(subst, env, clauses, tyDef.clauses);
      for (newInst in tyDef.insts) {
        if (seen.contains(newInst)) continue;
        seen.insert(newInst);
        insts.push(newInst);
      }
    }
  }

  fun getTag(): ?String {
    if (this.insts.insts.size() > 0) {
      None()
    } else {
      cand: ?String = None();
      for (clause in this.clauses.clauses) {
        clause.stypes match {
        | None() -> return None()
        | Some(stypes) ->
          stypes.singleElt() match {
          | Some(TPrimValue(TString(), Some(s), _)) ->
            (s.singleElt().map(elt ~> elt.i1), cand) match {
            | (None(), _) -> return None()
            | (x @ Some(_), None()) -> !cand = x
            | (Some(x1), Some(x2)) if (x1 == x2) -> void
            | _ -> return None()
            }
          | _ -> void
          }
        }
      };
      cand
    }
  }

  fun isTag(): Bool {
    this.getTag().isSome()
  }

  fun containsUndefined(): Bool {
    if (this.isTop) return true;
    for (clause in this.clauses.clauses) {
      clause.stypes match {
      | None() -> return true
      | Some(stypes) -> if (stypes.containsUndefined()) return true
      }
    };
    false
  }

  fun withUndefined(undefinedPosRange: PosRange): this {
    if (this.containsUndefined()) return this;
    if (this.clauses.clauses.size() == 0) {
      !this.clauses = Clauses::fromSTypes(
        STypes::empty().addUndefined(undefinedPosRange),
      );
    } else {
      !this.clauses.clauses = this.clauses.clauses.map(clause -> {
        clause.stypes match {
        | None() -> clause
        | Some(stypes) ->
          !clause.stypes = Some(stypes.addUndefined(undefinedPosRange));
          clause
        }
      });
    };
    this
  }

  fun filterMethods(subst: mutable Subst, env: TEnv): this {
    this.getSTypes(subst, env, Covariant()).flatMap(stypes ~> {
      stypes.singleElt()
    }) match {
    | Some(TObject(TFields(fields), pos)) ->
      static::single(
        this.pos,
        TObject(
          TFields(
            fields.filterMap(field -> {
              fieldType = field.type;
              fieldSTypesOpt = fieldType.getSTypes(subst, env, Covariant());
              fieldSTypes = fieldSTypesOpt match {
              | None() -> return None()
              | Some(x) -> x
              };
              !fieldSTypes = fieldSTypes.filterMap(fieldSType ~> {
                fieldSType match {
                | TFuns(funs, _methods, _pos) if (funs.isEmpty()) -> None()
                | TFuns(_funs, methods, _pos) if (!methods.isEmpty()) ->
                  invariant_violation(
                    "TODO: encountered both non-empty funs and methods in filterMethod",
                  )
                //Some(tfuns with {methods => Array[]})
                | _ -> Some(fieldSType)
                }
              });
              !fieldType = TType::fromSTypes(fieldType.pos, fieldSTypes);
              if (fieldType.isBottom()) None() else {
                Some(field with {type => fieldType})
              }
            }),
          ),
          pos,
        ),
      )
    | _ -> invariant_violation("Internal error: new should produce an object")
    }
  }

  static fun union(
    subst: mutable Subst,
    env: TEnv,
    ty1: this,
    ty2: this,
  ): this {
    if (ty1.isTop) return ty1;
    if (ty2.isTop) return ty2;
    types = unionTInsts(ty1.insts, ty2.insts);
    clauses = Clauses::union(subst, env, ty1.clauses, ty2.clauses);
    static::create(ty1.pos, types, clauses)
  }
}

base class Variance {
  children =
  | Covariant()
  | Contravariant()
}

/*****************************************************************************/
/* Object types. */
/*****************************************************************************/

class TObject(fields: TFields) extends SType

class TAlgebraic(
  branches: InternalKeyedArrayMap<String, TConstr>,
) extends SType {
  static fun single(x: TConstr, pos: PosRange): this {
    static(InternalKeyedArrayMap::single(x), pos)
  }

  static fun inter(
    subst: mutable Subst,
    env: TEnv,
    a1: TAlgebraic,
    a2: TAlgebraic,
  ): TAlgebraic {
    static(
      a1.branches.mapInter(a2.branches, (x, y) ->
        TConstr(interTFields(subst, env, x.fields, y.fields))
      ),
      a1.pos,
    )
  }

  static fun union(
    subst: mutable Subst,
    env: TEnv,
    a1: TAlgebraic,
    a2: TAlgebraic,
  ): TAlgebraic {
    static(
      a1.branches.mapUnion(a2.branches, (x, y) ->
        TConstr(unionTFields(subst, env, x.fields, y.fields))
      ),
      a1.pos,
    )
  }

  static fun isSub(
    subst: mutable Subst,
    env: TEnv,
    a1: TAlgebraic,
    a2: TAlgebraic,
  ): STResult {
    a1.branches.leq(a2.branches, (b1, b2O) ->
      b2O match {
      | Some(b2) ->
        TFields::isSub(subst, env, b1.fields, b2.fields) match {
        | STOk() -> Success(void)
        | err -> Failure(err)
        }
      | None() -> Failure(STTooManyTConstr(b1))
      }
    ) match {
    | Success(void) -> STOk()
    | Failure(err) -> err
    }
  }
}

class TConstr(fields: TFields) uses Hashable, Orderable, Projectable<String> {
  fun project(): String {
    this.fields.getKind()
  }
}

fun createObject(pos: PosRange, fields: TFields): TType {
  seen = mutable Set<String>[];
  for (field in fields) {
    if (seen.contains(field.name)) {
      typingError(Array[(field.pos, "Duplicate field")])
    };
    seen.insert(field.name);
  };
  if (
    seen.contains("kind") &&
    fields.maybeGet("kind").fromSome().type.isTag()
  ) {
    TType::single(pos, TAlgebraic::single(TConstr(fields), pos))
  } else {
    TType::single(pos, TObject(fields, pos))
  }
}

/*****************************************************************************/
/* Tuples */
/*****************************************************************************/

class TTuple(tuple: Array<TType>) extends SType {
  fun toString(): String {
    invariant_violation("TODO TTuple toString")
  }
}

/*****************************************************************************/
/* Funs */
/*****************************************************************************/

class TFuns(
  funs: InternalKeyedArrayMap<(Int, Int), TFun>,
  methods: InternalKeyedArrayMap<(Int, Int), TFun>,
) extends SType {
  static fun singleFun(x: TFun, pos: PosRange): this {
    static(
      InternalKeyedArrayMap::single(x),
      InternalKeyedArrayMap::empty(),
      pos,
    )
  }

  static fun singleMethod(x: TFun, pos: PosRange): this {
    static(
      InternalKeyedArrayMap::empty(),
      InternalKeyedArrayMap::single(x),
      pos,
    )
  }

  static fun inter(
    subst: mutable Subst,
    env: TEnv,
    f1: TFuns,
    f2: TFuns,
  ): TFuns {
    static(
      f1.funs.mapInter(f2.funs, (x, y) -> interTFun(subst, env, x, y)),
      f1.methods.mapInter(f2.methods, (x, y) -> interTFun(subst, env, x, y)),
      f1.pos,
    )
  }

  static fun union(
    subst: mutable Subst,
    env: TEnv,
    f1: TFuns,
    f2: TFuns,
  ): TFuns {
    static(
      f1.funs.mapUnion(f2.funs, (x, y) -> unionTFun(subst, env, x, y)),
      f1.methods.mapUnion(f2.methods, (x, y) -> unionTFun(subst, env, x, y)),
      f1.pos,
    )
  }

  private static fun isSubTFun(
    subst: mutable Subst,
    env: TEnv,
    f1: TFun,
    f2O: ?TFun,
  ): Result<void, STResult> {
    f2O match {
    | Some(f2) ->
      isSubTFun(subst, env, f1, f2) match {
      | STOk() -> Success(void)
      | err -> Failure(err)
      }
    | None() -> Failure(STTooManyTFun(f1))
    }
  }

  static fun isSub(
    subst: mutable Subst,
    env: TEnv,
    funs1: TFuns,
    funs2: TFuns,
  ): STResult {
    funs1.funs.leq(funs2.funs, (x, y) ->
      static::isSubTFun(subst, env, x, y)
    ) match {
    | Failure(err) -> err
    | Success(void) ->
      funs1.methods.leq(funs2.methods, (x, y) ->
        static::isSubTFun(subst, env, x, y)
      ) match {
      | Failure(err) -> err
      | Success(void) ->
        ok: STResult = STOk();
        ok
      }
    }
  }
}

class TFun(
  clauses: Array<TParamWithConstraint>,
  params: Array<TType>,
  optionalParams: Array<TType>,
  spreadParam: ?TType,
  minSizeWitness: PosRange,
  lambdas: Array<Lambda>,
  retType: TType,
) uses Hashable, Orderable, Projectable<(Int, Int)> {
  fun toString(): String {
    invariant_violation("TODO TFun toString()")
  }

  fun project(): (Int, Int) {
    (this.clauses.size(), this.params.size())
  }
}

class Lambda(
  pos: PosRange,
  compute: (mutable Subst, Array<TType>, TType) ~> void,
) uses Hashable, Orderable {
  fun hash(): Int {
    this.pos.hash()
  }
  fun compare(other: Lambda): Order {
    this.pos.compare(other.pos)
  }
}

/*****************************************************************************/
/* Single types */
/*****************************************************************************/

base class TPrimVoidKind uses Hashable, Orderable {
  children =
  | TUndefined()
  | TVoid()
  | TNull()

  fun toString(): String {
    this match {
    | TUndefined() -> "undefined"
    | TVoid() -> "void"
    | TNull() -> "null"
    }
  }
}

base class TPrimValueKind uses Hashable, Orderable {
  children =
  | TNum()
  | TBool()
  | TString()

  fun toString(): String {
    this match {
    | TNum() -> "number"
    | TBool() -> "boolean"
    | TString() -> "string"
    }
  }
}

base class SType(pos: PosRange) uses Hashable, Orderable, Projectable<Int> {
  children =
  | TPrimVoid(TPrimVoidKind)
  | TPromise(TType)

  fun tag(): Int {
    this match {
    | TPrimVoid(TUndefined _, _) -> 0
    | TPrimVoid(TVoid _, _) -> 1
    | TPrimVoid(TNull _, _) -> 2
    | TPrimValue(TBool _, _, _) -> 3
    | TPrimValue(TNum _, _, _) -> 4
    | TPrimValue(TString _, _, _) -> 5
    | TTuple _ -> 7
    | TPromise _ -> 8
    | TObject _ -> 9
    | TAlgebraic _ -> 10
    | TFuns _ -> 11
    }
  }

  fun project(): Int {
    this.tag()
  }
}

class TPrimValue(kind: TPrimValueKind, values: ?ArrayValues) extends SType

class TField(
  pos: PosRange,
  name: String,
  isOptional: Bool,
  type: TType,
) uses Hashable, Orderable, Projectable<String> {
  fun withOptional(): this {
    this with {isOptional => true}
  }

  fun project(): String {
    this.name
  }
}

class TFields(
  fields: InternalKeyedArrayMap<String, TField>,
) uses Hashable, Orderable {
  static fun empty(): this {
    static(InternalKeyedArrayMap::empty())
  }

  static fun create(fields: Array<TField>): this {
    static(
      InternalKeyedArrayMap::createFromIterator(
        fields.sortedBy(x ~> x.name).values(),
      ),
    )
  }

  fun values(): mutable Iterator<TField> {
    this.fields.values()
  }

  fun maybeGet(fieldName: String): ?TField {
    idx = SKStore.binSearch(
      i ~> this.fields[i].name,
      fieldName,
      0,
      this.fields.size() - 1,
    );
    if (idx < 0 || idx >= this.fields.size()) return None();
    if (this.fields[idx].name != fieldName) return None();
    Some(this.fields[idx])
  }

  fun getType(fieldName: Name): TType {
    this.maybeGet(fieldName.value) match {
    | None() ->
      typingError(
        Array[
          (fieldName.posRange, "Unbound field: " + fieldName.value),
          (
            fieldName.posRange,
            "Possible options are:\n" +
              this.fields.filter(x -> x.name != "constructor")
                .toArray()
                .map(x -> x.name)
                .join("\n"),
          ),
        ],
      )
    | Some(fd) ->
      ty = fd.type;
      if (fd.isOptional) ty.withUndefined(fieldName.posRange) else ty
    }
  }

  fun getKind(): String {
    this.maybeGet("kind")
      .fromSome()
      .type.getTag()
      .fromSome("Internal error: getKind on non constructor")
  }

  static fun isSub(
    subst: mutable Subst,
    env: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): STResult {
    fields1.fields.geq(fields2.fields, (f1O, f2) ->
      f1O match {
      | None() ->
        if (f2.isOptional) {
          Success(void)
        } else {
          Failure(STMissingField(f2.name))
        }
      | Some(f1) ->
        if (f1.isOptional && !f2.isOptional) {
          Failure(STMissingField(f1.name))
        } else {
          isSubTType(subst, env, f1.type, f2.type) match {
          | STOk() -> Success(void)
          | err -> Failure(err)
          }
        }
      }
    ) match {
    | Success(void) -> STOk()
    | Failure(err) -> err
    }
  }
}

class STypes private (
  private stypes: InternalKeyedArrayMap<Int, SType>,
) uses Hashable, Orderable {
  static fun empty(): this {
    static(InternalKeyedArrayMap::empty())
  }

  static fun single(x: SType): this {
    static(InternalKeyedArrayMap::single(x))
  }

  static fun union(
    subst: mutable Subst,
    env: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): STypes {
    static(
      stypes1.stypes.mapUnion(stypes2.stypes, (x, y) ->
        unionSType(subst, env, x, y)
      ),
    )
  }

  // inter returns None when the greatest lower bound of the args is bottom
  static fun inter(
    subst: mutable Subst,
    env: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): ?STypes {
    stypes1.stypes
      .mapInterOption(stypes2.stypes, (x, y) -> interSType(subst, env, x, y))
      .map(x -> static(x))
  }

  static fun isSub(
    subst: mutable Subst,
    env: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): STResult {
    stypes1.stypes.leq(stypes2.stypes, (t1, t2O) ->
      t2O match {
      | Some(t2) ->
        isSubSType(subst, env, t1, t2) match {
        | STOk() -> Success(void)
        | err -> Failure(err)
        }
      | None() -> Failure(STTooManySType(t1))
      }
    ) match {
    | Success(void) -> STOk()
    | Failure(err) -> err
    }
  }

  fun map(f: SType -> SType): this {
    static(this.stypes.map(f))
  }

  fun filterMap(f: SType -> ?SType): this {
    static(this.stypes.filterMap(f))
  }

  fun isEmpty(): Bool {
    this.stypes.isEmpty()
  }

  fun size(): Int {
    this.stypes.size()
  }

  fun items(): mutable Iterator<(Int, SType)> {
    this.stypes.items()
  }

  fun values(): mutable Iterator<SType> {
    this.stypes.values()
  }

  fun any(f: SType -> Bool): Bool {
    this.stypes.any(f)
  }

  fun all(f: SType -> Bool): Bool {
    this.stypes.all(f)
  }

  fun singleElt(): ?SType {
    if (this.stypes.size() == 1) this.stypes.minimum() else None()
  }

  fun containsUndefined(): Bool {
    this.stypes.any(stype ->
      stype match {
      | TPrimVoid(TUndefined(), _) -> true
      | _ -> false
      }
    )
  }

  fun addUndefined(pos: PosRange): this {
    if (this.containsUndefined()) {
      invariant_violation("type already contains undefined")
    };
    undef: SType = TPrimVoid(TUndefined(), pos);
    static(this.stypes.union(InternalKeyedArrayMap::single(undef)))
  }

  fun staticValue(): ?String {
    this.singleElt() match {
    | Some(TPrimValue(_, Some(values), _)) if (values.values.size() == 1) ->
      Some(values.values[0].i1)
    | _ -> None()
    }
  }
}

class TVar private (
  pos: PosRange,
  id: Int,
  constraints: SortedMap<Int, TType>,
) extends TInst {
  static fun create(pos: PosRange, id: Int): this {
    static(pos, id, SortedMap[])
  }

  fun addConstraint(ty: TType): this {
    !this.constraints[ty.hash()] = ty;
    this
  }

  fun mapConstraints(f: TType -> TType): this {
    !this.constraints = this.constraints.map((_id, ty) -> f(ty));
    this
  }
}
class TArgs(targs: Array<TType>) uses Hashable, Orderable
class TSInst(name: Name, targs: TArgs) extends TInst
class TInter(ty1: TType, ty2: TType) extends TInst

base class TInst uses Hashable, Orderable

class TInsts(insts: Array<TInst>) uses Hashable, Orderable {
  static fun empty(): this {
    static(Array[])
  }

  static fun single(inst: TInst): this {
    TInsts(Array[inst])
  }

  fun isEmpty(): Bool {
    this.insts.isEmpty()
  }

  fun values(): mutable Iterator<TInst> {
    this.insts.values()
  }

  fun toArray(): Array<TInst> {
    this.insts
  }
}

value class Id(id: String) uses Hashable, Orderable, Show {
  fun toString(): String {
    this.id
  }
}

class TParamWithConstraint(
  name: String,
  fileName: String,
  id: Id,
  cstr: ?TType,
) uses Hashable, Orderable

class TParam(name: String, fileName: String, id: Id) uses Hashable, Orderable

class Clause(
  vars: ArraySet<TParam>,
  stypes: ?STypes,
) uses Hashable, Orderable, Projectable<ArraySet<TParam>> {
  fun inter(subst: mutable Subst, env: TEnv, other: Clause): ?Clause {
    vars = this.vars.union(other.vars);
    (this.stypes, other.stypes) match {
    | (None(), _) -> Some(Clause(vars, other.stypes))
    | (_, None()) -> Some(Clause(vars, this.stypes))
    | (Some(stypes1), Some(stypes2)) ->
      STypes::inter(subst, env, stypes1, stypes2).map(stypes ->
        Clause(vars, Some(stypes))
      )
    }
  }

  fun union(subst: mutable Subst, env: TEnv, other: Clause): Clause {
    if (this.vars != other.vars) {
      invariant_violation("clause vars must be equal for union")
    };
    stypesOpt = (this.stypes, other.stypes) match {
    | (None(), None()) -> None()
    | (x @ Some(_), None())
    | (None(), x @ Some(_)) ->
      x
    | (Some(x), Some(y)) -> Some(STypes::union(subst, env, x, y))
    };
    Clause(this.vars, stypesOpt)
  }

  fun interSTypes(subst: mutable Subst, env: TEnv, stypes: STypes): ?Clause {
    if (stypes.isEmpty()) invariant_violation("stypes should not be empty");
    vars = this.vars;
    this.stypes match {
    | None() -> Some(Clause(vars, Some(stypes)))
    | Some(thisSTypes) ->
      STypes::inter(subst, env, thisSTypes, stypes).map(stypes ->
        Clause(vars, Some(stypes))
      )
    }
  }

  fun toString(): String {
    this.vars.toArray().map(x -> x.name + ":" + x.id).join(" & ")
  }

  fun project(): ArraySet<TParam> {
    this.vars
  }
}

// The type parameters are in DNF
class Clauses(
  clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
) uses Hashable, Orderable {
  static fun empty(): this {
    Clauses(InternalKeyedArrayMap::empty())
  }

  fun isEmpty(): Bool {
    this.clauses.isEmpty()
  }

  static fun single(tparam: TParam): this {
    Clauses(
      InternalKeyedArrayMap::single(Clause(ArraySet::single(tparam), None())),
    )
  }

  static fun fromTypeParam(tparam: TypeParam, stypes: ?STypes): this {
    static(
      InternalKeyedArrayMap::single(
        Clause(
          ArraySet::single(
            TParam(tparam.name.value, tparam.name.posRange.fileName, tparam.id),
          ),
          stypes,
        ),
      ),
    )
  }
  static fun fromTParamWithConstraint(
    tparam: TParamWithConstraint,
    stypes: ?STypes,
  ): this {
    static(
      InternalKeyedArrayMap::single(
        Clause(
          ArraySet::single(TParam(tparam.name, tparam.fileName, tparam.id)),
          stypes,
        ),
      ),
    )
  }

  static fun fromSTypes(stypes: STypes): this {
    if (stypes.isEmpty()) {
      return static(
        InternalKeyedArrayMap::createFromIterator(Array[].iterator()),
      )
    };
    static(
      InternalKeyedArrayMap::single(
        Clause(ArraySet::createFromIterator(Array[].iterator()), Some(stypes)),
      ),
    )
  }

  static fun inter(
    subst: mutable Subst,
    env: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): Clauses {
    result = SortedMap[];
    for (clause1 in clauses1.clauses) {
      for (clause2 in clauses2.clauses) {
        clause1.inter(subst, env, clause2) match {
        | None() -> void
        | Some(inter) ->
          inter.stypes match {
          | Some(x) if (x.isEmpty()) -> continue
          | _ -> void
          };
          if (!result.containsKey(inter.vars)) {
            !result[inter.vars] = inter;
          } else {
            !result[inter.vars] = result[inter.vars].union(subst, env, inter)
          }
        }
      }
    };
    Clauses(
      InternalKeyedArrayMap::createFromIterator(
        result.items().map(x -> x.i1).iterator(),
      ),
    )
  }

  static fun union(
    subst: mutable Subst,
    env: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): Clauses {
    Clauses(
      clauses1.clauses.mapUnion(clauses2.clauses, (x, y) ->
        x.union(subst, env, y)
      ),
    )
  }

  static fun isSub(
    subst: mutable Subst,
    env: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): STResult {
    for (inter1 in clauses1.clauses) {
      errors = List[];
      for (inter2 in clauses2.clauses) {
        if (!inter1.vars.contains(inter2.vars)) {
          continue;
        };
        (inter1.stypes, inter2.stypes) match {
        | (None(), None()) -> break void
        | (Some _, None()) -> break void
        | (None(), Some _) -> continue
        | (Some(x1), Some(x2)) ->
          STypes::isSub(subst, env, x1, x2) match {
          | STOk() -> break void
          | err ->
            !errors = List.Cons(err, errors);
            continue
          }
        }
      } else {
        return errors match {
        | List.Cons(err, List.Nil()) -> err
        | _ ->
          STInvalidTypeParams(
            inter1.vars.toArray().map(x -> x.name.toString()).join(" & "),
          )
        }
      }
    };
    STOk()
  }

  fun primKind(): ?TPrimValueKind {
    cand: ?TPrimValueKind = None();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(stypes) ->
        for (stype in stypes) {
          stype match {
          | TPrimValue(kind, _, _) if (cand is None()) -> !cand = Some(kind)
          | TPrimValue(kind, _, _) -> if (cand != Some(kind)) return None()
          | _ -> return None()
          }
        }
      }
    };
    cand
  }

  fun getObject(): ?SType {
    if (this.clauses.size() != 1) return None();
    this.clauses[0].stypes match {
    | None() -> None()
    | Some(stypes) ->
      if (stypes.size() != 1) return None();
      stypes.singleElt() match {
      | Some(obj @ TObject _) -> Some(obj)
      | _ -> None()
      }
    }
  }
}

/*****************************************************************************/
/* Sub-typing */
/*****************************************************************************/

base class STResult {
  children =
  | STOk()
  | STNoConstraint()
  | STMissingField(String)
  | STMissingSpread()
  | STTooManySType(SType)
  | STTooManyTConstr(TConstr)
  | STTooManyTTuple(TTuple)
  | STTooManyTFun(TFun)
  | STInvalidTypeParam(String)
  | STInvalidTypeParams(String)
  | STTop()
  | STRec(STResult, PosRange, TType)

  fun toString(subst: mutable Subst, env: TEnv, ty: TType): String {
    this match {
    | STOk() ->
      invariant_violation("Internal error: STResult should never go to String")
    | STTop() -> "This is of type any"
    | STNoConstraint() -> "This type parameter does not define a constraint"
    | STMissingSpread() -> "Missing ... parameter"
    | STMissingField(fieldName) ->
      "The field '" +
        fieldName +
        "' is missing" +
        "\n" +
        "Out of the type: " +
        expandTVars(subst, env, ty).toString()
    | STTooManySType(sty) ->
      sty match {
      | TPrimVoid(kind, _) -> "This is a " + kind.toString()
      | TPrimValue(kind, None(), _) -> "This is of type " + kind.toString()
      | TPrimValue(kind, Some(x), _) ->
        `This is a static ${kind.toString()}: ` +
          x.values.map(x -> "'" + x.i1 + "'").join(" | ")

      | TPromise _ -> "This is a Promise"
      | SKJS.TAlgebraic _ ->
        "This is a constructor (the field kind is a static string)"
      | SKJS.TFuns _ ->
        "This is a function of type: " +
          prettyPrintType(false, TType::single(PosRange::none, sty))
      | SKJS.TObject _ -> "This is an object"
      | SKJS.TTuple(tuple, _) -> "This is a tuple of size " + tuple.size()
      }
    | STTooManyTConstr(_) -> "This is a constructor"
    | STTooManyTTuple(tuple) -> "This is a tuple of size " + tuple.tuple.size()
    | STTooManyTFun(f) ->
      "This is a function: " +
        prettyPrintType(
          false,
          TType::single(PosRange::none, TFuns::singleFun(f, PosRange::none)),
        )
    | STInvalidTypeParam(n) -> "This is of type " + n
    | STInvalidTypeParams(n) -> "This is of type " + n
    | STRec(st, _, ty2) -> st.toString(subst, env, ty2)
    }
  }
}

fun isSubTType(
  subst: mutable Subst,
  env: TEnv,
  u1: TType,
  u2: TType,
): STResult {
  if (u2.isTop) return STOk();
  if (env.seenSub.contains((subst.version, u1, u2))) return STOk();
  !env.seenSub = env.seenSub.set((subst.version, u1, u2));
  savedSubst = subst.save();
  for (inst in u1.insts) {
    inst match {
    | tvar @ TVar(_, _, constraints) ->
      for (_ => cstr in constraints) {
        status = isSubTType(subst, env, u2, cstr);
        if (status is STOk()) continue;
        return status;
      };
      subst.grow(env, tvar, u2, false)
    | _ -> void
    }
  };
  for (inst in u2.insts) {
    inst match {
    | tvar @ TVar(_, _, constraints) ->
      for (_ => cstr in constraints) {
        status = isSubTType(subst, env, u1, cstr);
        if (status is STOk()) continue;
        return status;
      };
      subst.grow(env, tvar, u1, true)
    | _ -> void
    }
  };
  u1expanded = u1.expand(subst, env, Covariant());
  u2expanded = u2.expand(subst, env, Contravariant());
  (clauses1, clauses2) = (u1expanded, u2expanded) match {
  | (_, None()) -> return STOk()
  | (None(), Some(_)) -> return STTop()
  | (Some(clauses1), Some(clauses2)) -> (clauses1, clauses2)
  };
  Clauses::isSub(subst, env, clauses1, clauses2) match {
  | STOk() -> STOk()
  | err @ STRec _ ->
    subst.restore(savedSubst);
    err
  | other @ STTooManySType(stype) ->
    subst.restore(savedSubst);
    STRec(other, stype.pos, u2)
  | other ->
    subst.restore(savedSubst);
    STRec(other, u1.pos, u2)
  }
}

fun isSubSType(
  subst: mutable Subst,
  env: TEnv,
  sty1: SType,
  sty2: SType,
): STResult {
  (sty1, sty2) match {
  | (TPrimVoid(_, _), TPrimVoid(_, _)) -> STOk()

  | (TPrimValue(_, None(), _), TPrimValue(_, None(), _)) -> STOk()
  | (TPrimValue(_, None(), _), TPrimValue(_, Some _, _)) -> STTooManySType(sty1)
  | (TPrimValue(_, Some _, _), TPrimValue(_, None(), _)) -> STOk()

  | (TPrimValue(k, Some(s1), _), TPrimValue(_, Some(s2), _)) ->
    for (elt in s1.values) {
      if (!s2.contains(elt.i1)) {
        break STTooManySType(
          TPrimValue(k, Some(ArrayValues::single(elt)), elt.i0),
        )
      }
    } else {
      STOk()
    }

  | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
    isSubTTuple(subst, env, tuple1, tuple2)

  | (TPromise(ty1, _), TPromise(ty2, _)) -> isSubTType(subst, env, ty1, ty2)
  | (funs1 @ TFuns _, funs2 @ TFuns _) -> TFuns::isSub(subst, env, funs1, funs2)
  | (obj1 @ TObject _, obj2 @ TObject _) -> isSubTObject(subst, env, obj1, obj2)
  | (TAlgebraic _, TObject _)
  | (TObject _, TAlgebraic _) ->
    STTooManySType(sty1)
  | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->
    TAlgebraic::isSub(subst, env, a1, a2)
  | _ -> invariant_violation("Internal error")
  }
}

fun isSubTTuple(
  subst: mutable Subst,
  env: TEnv,
  tuple1: TTuple,
  tuple2: TTuple,
): STResult {
  if (tuple1.tuple.size() < tuple2.tuple.size()) {
    return STTooManySType(tuple1)
  };
  for (i in Range(0, tuple2.tuple.size())) {
    isSubTType(subst, env, tuple1.tuple[i], tuple2.tuple[i]) match {
    | STOk() -> void
    | err -> return err
    }
  };
  STOk()
}

fun isSubTFun(subst: mutable Subst, env: TEnv, f1: TFun, f2: TFun): STResult {
  if (f1.clauses.size() != f2.clauses.size()) {
    invariant_violation("function clause sizes must match")
  };
  if (!f2.lambdas.isEmpty()) {
    typingError(Array[(f2.lambdas[0].pos, "Please add a type annotation")]);
  };
  tsubst = mutable Map[];
  for (i in Range(0, f1.clauses.size())) {
    tparam1 = f1.clauses[i];
    tparam2 = f2.clauses[i];
    (tparam1.cstr, tparam2.cstr) match {
    | (None(), None()) -> void
    | (Some _, None()) -> void
    | (None(), Some _) -> return STNoConstraint()
    | (Some(ty1), Some(ty2)) ->
      isSubTType(subst, env, ty2, ty1) match {
      | STOk() -> void
      | err -> return err
      }
    };
    tsubst![tparam2.id] = tparam1;
  };
  !f2 = RenameClauses().fun_(tsubst.chill(), f2);
  params1 = f1.params;
  params2 = f2.params;
  for (i in Range(0, params1.size())) {
    isSubTType(subst, env, params2[i], params1[i]) match {
    | STOk() -> void
    | err -> return err
    }
  };
  for (lambda in f1.lambdas) {
    lambda.compute(subst, params2, f2.retType)
  };
  f2.spreadParam match {
  | None() -> void
  | Some(spread2) ->
    f1.spreadParam match {
    | None() -> return STMissingSpread()
    | Some(spread1) ->
      isSubTType(subst, env, spread1, spread2) match {
      | STOk() -> void
      | err -> return err
      }
    }
  };
  isSubTType(subst, env, f1.retType, f2.retType)
}

fun isSubTObject(
  subst: mutable Subst,
  env: TEnv,
  obj1: TObject,
  obj2: TObject,
): STResult {
  TFields::isSub(subst, env, obj1.fields, obj2.fields)
}

fun isSubBranch(
  subst: mutable Subst,
  env: TEnv,
  b1: TConstr,
  b2: TConstr,
): STResult {
  TFields::isSub(subst, env, b1.fields, b2.fields)
}

/*****************************************************************************/
/* Unions. */
/*****************************************************************************/

fun unionTFields(
  subst: mutable Subst,
  env: TEnv,
  fields1: TFields,
  fields2: TFields,
): TFields {
  (noMatch1, noMatch2, fields) = mapInter(
    fields1.values(),
    fields2.values(),
    x ~> x.name,
    (x, y) -> {
      if (x.name != y.name) invariant_violation("field names must match");
      TField(
        x.pos,
        x.name,
        x.isOptional || y.isOptional,
        TType::union(subst, env, x.type, y.type),
      )
    },
  );
  !fields = fields
    .concat(noMatch1.map(x -> x.withOptional()))
    .concat(noMatch2.map(x -> x.withOptional()))
    .sortedBy(x ~> x.name);
  TFields::create(fields)
}

fun unionTObject(
  subst: mutable Subst,
  env: TEnv,
  obj1: TObject,
  obj2: TObject,
): TObject {
  TObject(unionTFields(subst, env, obj1.fields, obj2.fields), obj1.pos)
}

fun unionSType(
  subst: mutable Subst,
  env: TEnv,
  sty1: SType,
  sty2: SType,
): SType {
  (sty1, sty2) match {
  | (TPrimVoid(_, _), TPrimVoid(_, _)) -> sty1

  | (TPrimValue(_, None(), _), TPrimValue(_, None(), _)) -> sty1
  | (TPrimValue(_, None(), _), TPrimValue(_, Some _, _)) -> sty1
  | (TPrimValue(_, Some _, _), TPrimValue(_, None(), _)) -> sty2
  | (TPrimValue(k1, Some(s1), pos), TPrimValue(k2, Some(s2), _)) ->
    if (k1 != k2) invariant_violation("primitive value kinds must match");
    TPrimValue(k1, Some(s1.union(s2)), pos)

  | (TPromise(ty1, pos), TPromise(ty2, _)) ->
    TPromise(TType::union(subst, env, ty1, ty2), pos)
  | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
    unionTTuple(subst, env, tuple1, tuple2)
  | (obj1 @ TObject _, obj2 @ TObject _) -> unionTObject(subst, env, obj1, obj2)
  | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->
    TAlgebraic::union(subst, env, a1, a2)
  | (f1 @ TFuns _, f2 @ TFuns _) -> TFuns::union(subst, env, f1, f2)
  | _ -> invariant_violation("Internal error")
  }
}

fun unionTFun(subst: mutable Subst, env: TEnv, f1: TFun, f2: TFun): TFun {
  if (f1.clauses.size() != f2.clauses.size()) {
    invariant_violation("function clause sizes must match")
  };
  if (!f1.lambdas.isEmpty()) {
    typingError(Array[(f1.lambdas[0].pos, "Please add a type annotation")]);
  };
  if (!f2.lambdas.isEmpty()) {
    typingError(Array[(f2.lambdas[0].pos, "Please add a type annotation")]);
  };
  tsubst = mutable Map[];
  clauses = mutable Vector[];
  for (i in Range(0, f1.clauses.size())) {
    tparam1 = f1.clauses[i];
    tparam2 = f2.clauses[i];
    tsubst![tparam2.id] = tparam1;
    cstr = (tparam1.cstr, tparam2.cstr) match {
    | (None(), None()) -> None()
    | (None(), Some(x)) -> Some(x)
    | (Some(x), None()) -> Some(x)
    | (Some(x), Some(y)) -> Some(interTType(subst, env, x, y))
    };
    clauses.push(tparam1 with {cstr});
  };
  !f2 = RenameClauses().fun_(tsubst.chill(), f2);
  params = mutable Vector[];
  for (i in Range(0, f1.params.size())) {
    params.push(interTType(subst, env, f1.params[i], f2.params[i]));
  };
  optionalParams = mutable Vector[];
  for (i in Range(0, min(f1.optionalParams.size(), f2.optionalParams.size()))) {
    optionalParams.push(
      interTType(subst, env, f1.optionalParams[i], f2.optionalParams[i]),
    );
  };
  spreadParam = (f1.spreadParam, f2.spreadParam) match {
  | (Some(ty1), Some(ty2)) -> Some(interTType(subst, env, ty1, ty2))
  | _ -> None()
  };
  retType = TType::union(subst, env, f1.retType, f2.retType);
  totalSize1 = f1.params.size() + f1.optionalParams.size();
  totalSize2 = f2.params.size() + f2.optionalParams.size();
  sizeWitness = if (totalSize1 <= totalSize2) f1.minSizeWitness else {
    f2.minSizeWitness
  };
  TFun(
    clauses.toArray(),
    params.toArray(),
    optionalParams.toArray(),
    spreadParam,
    sizeWitness,
    Array[],
    retType,
  )
}

fun unionTTuple(
  subst: mutable Subst,
  env: TEnv,
  tuple1: TTuple,
  tuple2: TTuple,
): TTuple {
  result = mutable Vector[];
  for (i in Range(0, min(tuple1.tuple.size(), tuple2.tuple.size()))) {
    result.push(TType::union(subst, env, tuple1.tuple[i], tuple2.tuple[i]));
  };
  if (tuple1.tuple.size() < tuple2.tuple.size()) {
    for (i in Range(tuple1.tuple.size(), tuple2.tuple.size())) {
      posEnd = PosRange(tuple1.pos.fileName, tuple1.pos.end, tuple1.pos.end);
      result.push(
        TType::union(
          subst,
          env,
          TType::single(tuple1.pos, TPrimVoid(TUndefined(), posEnd)),
          tuple2.tuple[i],
        ),
      );
    }
  } else if (tuple2.tuple.size() < tuple1.tuple.size()) {
    for (i in Range(tuple2.tuple.size(), tuple1.tuple.size())) {
      posEnd = PosRange(tuple2.pos.fileName, tuple2.pos.end, tuple2.pos.end);
      result.push(
        TType::union(
          subst,
          env,
          tuple1.tuple[i],
          TType::single(tuple2.pos, TPrimVoid(TUndefined(), posEnd)),
        ),
      );
    }
  };
  TTuple(result.toArray(), tuple1.pos)
}

fun unionTInsts(insts1: TInsts, insts2: TInsts): TInsts {
  TInsts(
    mapUnion(insts1.values(), insts2.values(), x ~> x, x ~> x, (x, _) ~> x),
  )
}

/*****************************************************************************/
/* Intersections */
/*****************************************************************************/

fun interTFields(
  subst: mutable Subst,
  env: TEnv,
  fields1: TFields,
  fields2: TFields,
): TFields {
  fields = mapUnion(
    fields1.values(),
    fields2.values(),
    x ~> x.name,
    x ~> x,
    (x, y) -> {
      if (x.name != y.name) invariant_violation("field names must match");
      TField(
        x.pos,
        x.name,
        x.isOptional && y.isOptional,
        interTType(subst, env, x.type, y.type),
      )
    },
  );
  TFields::create(fields)
}

fun interTObject(
  subst: mutable Subst,
  env: TEnv,
  obj1: TObject,
  obj2: TObject,
): TObject {
  TObject(interTFields(subst, env, obj1.fields, obj2.fields), obj1.pos)
}

// interSType returns None when the greatest lower bound of the args is bottom
fun interSType(
  subst: mutable Subst,
  env: TEnv,
  sty1: SType,
  sty2: SType,
): ?SType {
  (sty1, sty2) match {
  | (TPrimVoid(k1, _), TPrimVoid(k2, _)) ->
    if (k1 != k2) invariant_violation("primitive void kinds must match");
    Some(sty1)

  | (
    tPrimValue1 @ TPrimValue(k1, values1, _),
    tPrimValue2 @ TPrimValue(k2, values2, _),
  ) ->
    if (k1 != k2) invariant_violation("primitive value kinds must match");
    (values1, values2) match {
    | (_, None()) -> Some(tPrimValue1)
    | (None(), Some _) -> Some(tPrimValue2)
    | (Some(s1), Some(s2)) ->
      Some(s1.inter(s2)).map(values ~>
        tPrimValue1 with {values => Some(values)}
      )
    }

  | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
    Some(interTTuple(subst, env, tuple1, tuple2))

  | (TPromise(ty1, pos1), TPromise(ty2, _)) ->
    Some(TPromise(interTType(subst, env, ty1, ty2), pos1))

  | (obj1 @ TObject _, obj2 @ TObject _) ->
    Some(interTObject(subst, env, obj1, obj2))
  | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->
    Some(TAlgebraic::inter(subst, env, a1, a2))

  | (f1 @ TFuns _, f2 @ TFuns _) -> Some(TFuns::inter(subst, env, f1, f2))
  | _ -> invariant_violation("Internal error")
  }
}

fun interTFun(subst: mutable Subst, env: TEnv, f1: TFun, f2: TFun): TFun {
  if (f1.clauses.size() != f2.clauses.size()) {
    invariant_violation("function clause sizes must match")
  };
  tsubst = mutable Map[];
  clauses = mutable Vector[];
  for (i in Range(0, f1.clauses.size())) {
    tparam1 = f1.clauses[i];
    tparam2 = f2.clauses[i];
    tsubst![tparam2.id] = tparam1;
    cstr = (tparam1.cstr, tparam2.cstr) match {
    | (None(), None()) -> None()
    | (None(), Some(x)) -> Some(x)
    | (Some(x), None()) -> Some(x)
    | (Some(x), Some(y)) -> Some(TType::union(subst, env, x, y))
    };
    clauses.push(tparam1 with {cstr});
  };
  !f2 = RenameClauses().fun_(tsubst.chill(), f2);
  params = mutable Vector[];
  for (i in Range(0, f1.params.size())) {
    params.push(TType::union(subst, env, f1.params[i], f2.params[i]));
  };
  optionalSize = min(f1.optionalParams.size(), f2.optionalParams.size());
  optionalParams = mutable Vector[];
  for (i in Range(0, optionalSize)) {
    optionalParams.push(
      TType::union(subst, env, f1.optionalParams[i], f2.optionalParams[i]),
    );
  };
  if (f1.optionalParams.size() < f2.optionalParams.size()) {
    for (i in Range(f1.optionalParams.size(), f2.optionalParams.size())) {
      optionalParams.push(f2.optionalParams[i]);
    }
  } else if (f2.optionalParams.size() < f1.optionalParams.size()) {
    for (i in Range(f2.optionalParams.size(), f1.optionalParams.size())) {
      optionalParams.push(f1.optionalParams[i]);
    }
  };
  totalSize1 = f1.params.size() + f1.optionalParams.size();
  totalSize2 = f2.params.size() + f2.optionalParams.size();
  sizeWitness = if (totalSize1 >= totalSize2) f1.minSizeWitness else {
    f2.minSizeWitness
  };
  spreadParam = (f1.spreadParam, f2.spreadParam) match {
  | (None(), None()) -> None()
  | (ty @ Some _, None()) -> ty
  | (None(), ty @ Some _) -> ty
  | (Some(ty1), Some(ty2)) -> Some(TType::union(subst, env, ty1, ty2))
  };
  retType = interTType(subst, env, f1.retType, f2.retType);
  if (f1.lambdas.size() != 0) {
    typingError(Array[(f1.lambdas[0].pos, "Please add a type annotation")]);
  };
  if (f2.lambdas.size() != 0) {
    typingError(Array[(f2.lambdas[0].pos, "Please add a type annotation")]);
  };
  TFun(
    clauses.toArray(),
    params.toArray(),
    optionalParams.toArray(),
    spreadParam,
    sizeWitness,
    Array[],
    retType,
  )
}

fun interTTuple(
  subst: mutable Subst,
  env: TEnv,
  tuple1: TTuple,
  tuple2: TTuple,
): TTuple {
  result = mutable Vector[];
  for (i in Range(0, min(tuple1.tuple.size(), tuple2.tuple.size()))) {
    result.push(interTType(subst, env, tuple1.tuple[i], tuple2.tuple[i]));
  };
  if (tuple1.tuple.size() < tuple2.tuple.size()) {
    for (i in Range(tuple1.tuple.size(), tuple2.tuple.size())) {
      result.push(tuple2.tuple[i]);
    }
  } else if (tuple2.tuple.size() < tuple1.tuple.size()) {
    for (i in Range(tuple2.tuple.size(), tuple1.tuple.size())) {
      result.push(tuple1.tuple[i]);
    }
  };
  TTuple(result.toArray(), tuple1.pos)
}

fun interTType(subst: mutable Subst, env: TEnv, ty1: TType, ty2: TType): TType {
  if (ty1.isTop) return ty2;
  if (ty2.isTop) return ty1;
  if (env.seenInter.contains((ty1, ty2))) {
    return TType::create(
      ty1.pos,
      TInsts::single(TInter(ty1, ty2)),
      Clauses::inter(subst, env, ty1.clauses, ty2.clauses),
    );
  };
  !env.seenInter = env.seenInter.set((ty1, ty2));
  if (
    ty1.insts.insts.size() == 1 &&
    ty1.insts.insts[0] is TVar _ &&
    ty1.clauses.isEmpty()
  ) {
    ty1.insts.insts[0] match {
    | tvar @ TVar(pos, _, _) ->
      return TType::fromTInst(pos, tvar.addConstraint(ty2))
    | _ -> invariant_violation("Already checked it was a TVar")
    }
  };
  if (
    ty2.insts.insts.size() == 1 &&
    ty2.insts.insts[0] is TVar _ &&
    ty2.clauses.isEmpty()
  ) {
    ty2.insts.insts[0] match {
    | tvar @ TVar(pos, _, _) ->
      return TType::fromTInst(pos, tvar.addConstraint(ty1))
    | _ -> invariant_violation("Already checked it was a TVar")
    }
  };
  clauses1 = ty1.expand(subst, env, Covariant()) match {
  | None() -> return ty2
  | Some(x) -> x
  };
  clauses2 = ty2.expand(subst, env, Covariant()) match {
  | None() -> return ty1
  | Some(x) -> x
  };
  (clauses1.primKind(), clauses2.getObject()) match {
  | (Some(primKind), Some(stype)) ->
    isSubTType(
      subst,
      env,
      TType::expandPrim(ty1.pos, primKind),
      TType::single(ty2.pos, stype),
    ) match {
    | STOk() -> return ty1
    | _ -> void
    }
  | _ -> void
  };
  (clauses2.primKind(), clauses1.getObject()) match {
  | (Some(primKind), Some(stype)) ->
    isSubTType(
      subst,
      env,
      TType::expandPrim(ty2.pos, primKind),
      TType::single(ty1.pos, stype),
    ) match {
    | STOk() -> return ty2
    | _ -> void
    }
  | _ -> void
  };
  clauses = Clauses::inter(subst, env, clauses1, clauses2);
  TType::create(ty1.pos, TInsts::empty(), clauses);
}

/*****************************************************************************/
/* Type transformation class. */
/*****************************************************************************/

base class ApplyType {
  type Env;

  deferred fun type(env: this::Env, ty: TType): TType {
    if (ty.isTop) this.top(env, ty) else this.nonTop(env, ty)
  }

  overridable deferred fun top(_env: this::Env, top: TType): TType {
    top
  }

  overridable deferred fun nonTop(env: this::Env, ty: TType): TType {
    ty.rawMap(
      (insts) -> this.insts(env, insts),
      (clauses) -> this.typeParams(env, clauses),
    )
  }

  overridable deferred fun typeParams(
    env: this::Env,
    clauses: Clauses,
  ): Clauses {
    Clauses(clauses.clauses.map(x -> this.clause(env, x)))
  }

  overridable deferred fun clause(env: this::Env, clause: Clause): Clause {
    Clause(
      clause.vars.map(x -> this.typeParam(env, x)),
      clause.stypes.map(x -> this.stypes(env, x)),
    )
  }

  overridable deferred fun typeParamWithConstraint(
    env: this::Env,
    tparam: TParamWithConstraint,
  ): TParamWithConstraint {
    TParamWithConstraint(
      tparam.name,
      tparam.fileName,
      tparam.id,
      tparam.cstr.map(c -> this.type(env, c)),
    )
  }

  overridable deferred fun typeParam(_env: this::Env, tparam: TParam): TParam {
    TParam(tparam.name, tparam.fileName, tparam.id)
  }

  overridable deferred fun stypes(env: this::Env, stypes: STypes): STypes {
    stypes.map(stype -> this.stype(env, stype))
  }

  overridable deferred fun stype(env: this::Env, stype: SType): SType {
    stype match {
    | x @ TPrimVoid _
    | x @ TPrimValue _ ->
      x
    | TPromise(ty, pos) -> TPromise(this.type(env, ty), pos)
    | algs @ TAlgebraic _ -> this.algebraic(env, algs)
    | funs @ TFuns _ -> this.funs(env, funs)
    | obj @ TObject _ -> this.object(env, obj)
    | tuples @ TTuple _ -> this.tuple(env, tuples)
    }
  }

  overridable deferred fun algebraic(
    env: this::Env,
    algebraic: TAlgebraic,
  ): TAlgebraic {
    TAlgebraic(algebraic.branches.map(x -> this.constr(env, x)), algebraic.pos)
  }

  overridable deferred fun constr(env: this::Env, constr: TConstr): TConstr {
    TConstr(this.fields(env, constr.fields))
  }

  overridable deferred fun object(env: this::Env, object: TObject): TObject {
    TObject(this.fields(env, object.fields), object.pos)
  }

  overridable deferred fun funs(env: this::Env, funs: TFuns): TFuns {
    TFuns(
      funs.funs.map(x -> this.fun_(env, x)),
      funs.methods.map(x -> this.fun_(env, x)),
      funs.pos,
    )
  }

  overridable deferred fun fun_(env: this::Env, f: TFun): TFun {
    TFun(
      f.clauses.map(x -> this.typeParamWithConstraint(env, x)),
      f.params.map(x -> this.type(env, x)),
      f.optionalParams.map(x -> this.type(env, x)),
      f.spreadParam.map(x -> this.type(env, x)),
      f.minSizeWitness,
      f.lambdas,
      this.type(env, f.retType),
    )
  }

  overridable deferred fun fields(env: this::Env, fields: TFields): TFields {
    TFields(fields.fields.map(x -> this.field(env, x)))
  }

  overridable deferred fun field(env: this::Env, field: TField): TField {
    TField(field.pos, field.name, field.isOptional, this.type(env, field.type))
  }

  overridable deferred fun tuple(env: this::Env, tuple: TTuple): TTuple {
    TTuple(tuple.tuple.map(x -> this.type(env, x)), tuple.pos)
  }

  overridable deferred fun insts(env: this::Env, insts: TInsts): TInsts {
    TInsts(insts.insts.map(x -> this.inst(env, x)))
  }

  overridable deferred fun inst(env: this::Env, inst: TInst): TInst {
    inst match {
    | TSInst(name, targs) -> TSInst(name, this.targs(env, targs))
    | TInter(ty1, ty2) -> TInter(this.type(env, ty1), this.type(env, ty2))
    | tvar @ TVar _ -> tvar.mapConstraints(ty -> this.type(env, ty))
    }
  }

  overridable deferred fun targs(env: this::Env, targs: TArgs): TArgs {
    TArgs(targs.targs.map(x -> this.type(env, x)))
  }
}

class RenameClauses() extends ApplyType {
  type Env = Map<Id, TParamWithConstraint>;
  fun typeParamWithConstraint(
    subst: this::Env,
    tparam: TParamWithConstraint,
  ): TParamWithConstraint {
    if (subst.containsKey(tparam.id)) {
      subst[tparam.id]
    } else {
      tparam
    }
  }

  fun typeParam(subst: this::Env, tparam: TParam): TParam {
    if (subst.containsKey(tparam.id)) {
      newTParam = subst[tparam.id];
      TParam(newTParam.name, newTParam.fileName, newTParam.id)
    } else {
      tparam
    }
  }
}

class FilterType() extends ApplyType {
  type Env = (SType ~> Bool, SType ~> SType);

  fun insts(_env: this::Env, insts: TInsts): TInsts {
    insts
  }

  fun stypes(env: this::Env, stypes: STypes): STypes {
    stypes.filterMap(x -> if (env.i0(x)) Some(env.i1(x)) else None())
  }
}

class Instantiate() extends ApplyType {
  type Env = (mutable Subst, TEnv, Map<Id, TType>);

  fun nonTop(env: this::Env, ty: TType): TType {
    !ty = ty.rawMap(
      (insts) -> this.insts(env, insts),
      (clauses) -> this.typeParams(env, clauses),
    );
    if (ty.clauses.clauses.isEmpty()) return ty;
    (subst, tenv, map) = env;
    clauses = ty.clauses.clauses;
    result = ty.withClauses(Clauses::empty());
    for (clause in clauses) {
      clauseTy = TType::top(ty.pos);
      for (tparam in clause.vars) {
        if (map.containsKey(tparam.id)) {
          paramTy = map[tparam.id];
          !clauseTy = interTType(subst, tenv, clauseTy, paramTy)
        } else {
          !clauseTy = interTType(
            subst,
            tenv,
            clauseTy,
            TType::fromTParam(ty.pos, tparam),
          )
        }
      };
      clause.stypes match {
      | None() -> void
      | Some(stypes) ->
        !clauseTy = interTType(
          subst,
          tenv,
          clauseTy,
          TType::fromSTypes(ty.pos, stypes),
        )
      };
      !result = TType::union(subst, tenv, result, clauseTy);
    };
    result
  }
}

class ExpandTVars() extends ApplyType {
  type Env = (mutable Subst, TEnv);

  fun nonTop(env: this::Env, ty: TType): TType {
    !ty = ty.rawMap(
      (insts) -> this.insts(env, insts),
      (clauses) -> this.typeParams(env, clauses),
    );
    (subst, tenv) = env;
    ty.expand(subst, tenv, Covariant()) match {
    | None() -> TType::top(ty.pos)
    | Some(clauses) -> TType::create(ty.pos, TInsts::empty(), clauses)
    }
  }
}

fun expandTVars(subst: mutable Subst, tenv: TEnv, ty: TType): TType {
  (ExpandTVars()).type((subst, tenv), ty)
}

/*****************************************************************************/
/* Class that maintains the environment for type variables. */
/*****************************************************************************/

base class SubstValue {
  children =
  | SVOpen(TType)
  | SVClosed(TType)
}

class SavedSubst{version: Int, values: SortedMap<Int, SubstValue>}

mutable class Subst private {
  context: mutable SKStore.Context,
  mutable version: Int = 0,
  private mutable values: SortedMap<Int, SubstValue> = SortedMap[],
} {
  static fun mcreate{context: mutable SKStore.Context}: mutable this {
    mutable static{context}
  }

  readonly fun save(): SavedSubst {
    SavedSubst{version => this.version, values => this.values}
  }

  mutable fun restore(saved: SavedSubst): void {
    this.!version = saved.version;
    this.!values = saved.values;
  }

  mutable fun grow(env: TEnv, tvar: TVar, ty: TType, isContra: Bool): void {
    if (!this.values.containsKey(tvar.id)) {
      this.!values[tvar.id] = if (isContra) SVOpen(ty) else SVClosed(ty);
      return void;
    };
    this.values[tvar.id] match {
    | SVOpen(ty2) ->
      newTy = TType::union(this, env, ty2, ty);
      if (newTy == ty2) return void;
      this.!version = this.version + 1;
      this.!values[tvar.id] = if (isContra) SVOpen(newTy) else SVClosed(newTy)
    | SVClosed(_) -> void
    }
  }

  mutable fun get(env: TEnv, tvar: TVar, variance: Variance): TType {
    result = variance match {
    | Covariant() ->
      (if (!this.values.containsKey(tvar.id)) {
        SVOpen(TType::bottom(tvar.pos));
      } else {
        this.values[tvar.id]
      }) match {
      | SVOpen(ty) ->
        this.!values[tvar.id] = SVClosed(ty);
        ty
      | SVClosed(ty) -> ty
      }
    | Contravariant() ->
      if (!this.values.containsKey(tvar.id)) {
        TType::bottom(tvar.pos)
      } else {
        this.values[tvar.id] match {
        | SVOpen(ty)
        | SVClosed(ty) ->
          ty
        }
      }
    };
    for (cstr in tvar.constraints) {
      !result = interTType(this, env, result, cstr);
    };
    result
  }

  mutable fun gen(pos: PosRange): TVar {
    id = this.version;
    this.!version = this.version + 1;
    TVar::create(pos, id)
  }

  readonly fun isOpen(tvar: TVar): Bool {
    this.values.maybeGet(tvar.id) match {
    | Some(SVOpen _) -> true
    | _ -> false
    }
  }
}

module end;
