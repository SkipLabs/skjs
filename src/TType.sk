/***************************************************************************/
// This file defines all the operation on types used during the
// type-checking phase.
//
// All the class involved start with "T" for type, or "ST" for single
// type. A class that starts with "T" is just a type, a type that
// starts with "ST" means that it represents a single type out of a
// larger union.
//
// For example: the type number | undefined is represented by a class
// TType that contains a union of SType where the STypes are "number"
// and "undefined".
/***************************************************************************/

module SKJS;

/***************************************************************************/
// The class representing all the types.
//
// The class has 2 important parts:
//
//   - the clauses which represent both parameters and concrete single types
//   (number, undefined, null, ...) under a disjunctive normal form
//
//   - the instances (which represent type variables, unexpanded type
//   instances and unexpanded intersections).
//
// A few examples:
//   number | void           ==> TType(clauses = void | number)
//   Foo<number> | number    ==> TType(clauses = number, insts = Foo<number>)
//   T2 extends A | T1       ==> TType(clauses = T1 | T2 extends A)
//
// Note that some operations will require a so-called "expansion", an
// expansion consisting in getting rid of all the instances and turn
// them into clauses. Note that the expansion is only one
// level deep, so if a type is defined recursively, the expansion will
// not affect the instances defined inside the type.
//
// Interpretation:
// 〚 ttype 〛 = 〚 ttype.insts 〛 ⨆ 〚 ttype.clauses 〛
//
/***************************************************************************/

class TType private {
  // The position in the source-code that serves as a witness, when an
  // error occurs involving this type, we will use that position in
  // the error message.
  pos: PosRange,

  // The hash, it's important because we need to quickly determine if
  // two types are different. The hash is computed by smart constructors,
  // that's why the constructor is private
  private h: XXHash,

  // The list of type instances which can be:
  // - Type variables
  // - Unexpanded type instances MyClass<number>
  // - Unexpanded intersections TInter(tys)
  insts: TInsts,

  // Single types and type parameters (universally quantified type variables), in a
  // sorted disjunctive normal form. So if you write: T1 & (T3 | T2)
  // that will be turned into T1 & T2 | T1 & T3.
  clauses: Clauses,
} uses XXHashable, Hashable, Orderable {
  private const empty: TType = TType::bottom(PosRange::none);

  //
  // identity
  //

  fun compare(other: TType): Order {
    this.h.compare(other.h)
  }

  fun hash(): Int {
    this.h.value
  }

  fun xxhash(): XXHash {
    this.h
  }

  //
  // private CONSTRUCTORS
  //

  static private fun create(
    pos: PosRange,
    insts: TInsts,
    clauses: Clauses,
  ): TType {
    if (clauses.isTop()) {
      !insts = TInsts::empty();
    };
    h = (insts, clauses).xxhash();
    TType{h, pos, insts, clauses};
  }

  static private fun fromClauses(pos: PosRange, clauses: Clauses): TType {
    TType::create(pos, TInsts::empty(), clauses)
  }

  static private fun fromSTypes(pos: PosRange, sTypes: STypes): TType {
    TType::fromClauses(pos, Clauses::fromSTypes(sTypes))
  }

  static private fun fromTParam(pos: PosRange, tParam: TParam): TType {
    TType::fromClauses(pos, Clauses::single(tParam))
  }

  //
  // public CONSTRUCTORS
  //

  // Returns the type that is sub-type of all types. This type is
  // impossible to construct, meaning, a value of this type is always
  // unreachable code. However, that type can still be useful to
  // represent some values (like exceptions).
  static fun bottom(pos: PosRange): TType {
    TType::create(pos, TInsts::empty(), Clauses::empty())
  }

  // Returns the type that represents all possible values. Every other
  // type is sub-type of top.
  static fun top(pos: PosRange): TType {
    TType::create(pos, TInsts::empty(), Clauses::top())
  }

  // A single atomic type.
  static fun single(sType: SType): TType {
    TType::fromSTypes(sType.pos, STypes::single(sType))
  }

  // Type variable.
  static fun var(v: TVar): TType {
    TType::create(v.pos, TInsts::single(v), Clauses::empty())
  }

  // Unexpanded instance of a named generic type.
  static fun inst(name: Name, targs: TArgs): TType {
    x = TSInst(name, targs);
    TType::create(name.pos, TInsts::single(x), Clauses::empty())
  }

  // Convert Array<T> to ReadonlyArray<T>. Used for rest parameters.
  static fun arrayToReadonlyArray(ty: TType): TType {
    if (!ty.clauses.isEmpty()) return ty;
    ty.insts.getUnique() match {
    | Some(TSInst(Name(pos, "Array"), targs)) ->
      TType::inst(Name(pos, "ReadonlyArray"), targs)
    | _ -> ty
    }
  }

  // Delayed array literal instance.
  static fun arrayLit(tvar: TVar, tupleElts: Array<TType>): TType {
    TType::create(
      tvar.pos,
      TInsts::single(TArrayLit(tvar, tupleElts)),
      Clauses::empty(),
    )
  }

  static fun tuple(
    pos: PosRange,
    tArgs: Array<TType>,
    isReadonly: Bool,
  ): TType {
    base = if (isReadonly) readonlyTupleName else tupleName;
    TType::inst(Name(pos, `${base}${tArgs.size()}`), TArgs(tArgs))
  }

  static fun fromTParamWithConstraint(
    subst: mutable Subst,
    tenv: TEnv,
    pos: PosRange,
    tparam: TParamWithConstraint,
  ): TType {
    ty = TType::fromTParam(pos, tparam.withoutConstraint());
    tparam.cstr match {
    | None() -> ty
    | Some(cstr) -> TType::inter(subst, tenv, ty, cstr)
    }
  }

  // Remove a single primitive constant from a type's clauses. Used for:
  //   - Object field defaults: (fieldType \ undefined) | default
  //   - Array destructuring defaults: same pattern
  //   - Constant-based refinement: `x.kind !== "foo"` narrows x.kind
  // For TPrimUnit (undefined/null/void): drops the matching unit entirely.
  // For TPrimValue with literals: subtracts literals; drops if empty.
  // For TPrimValue full TBool (no literals): computes exact complement
  // (boolean - true = false) since the full set is {true, false}.
  // For TPrimValue full of other kinds: keeps unchanged (over-approximation).
  static fun removeConstant(
    subst: mutable Subst,
    tenv: TEnv,
    ty: TType,
    prim: TPrim,
  ): TType {
    expanded = ty.expand(subst, tenv, None());
    newClauses = expanded.clauses.mapSTypes(stypesOpt ->
      stypesOpt.map(stypes ->
        stypes.filterMap(stype ->
          (stype, prim) match {
          | (TPrimUnit(k1, _), TPrimUnit(k2, _)) if (k1 == k2) -> None()
          | (
            TPrimValue(k1, Some(lits1), pos),
            TPrimValue(k2, Some(lits2), _),
          ) if (k1 == k2) ->
            lits1.diff(lits2).map(l -> TPrimValue(k1, Some(l), pos))
          | (
            TPrimValue(k1 @ TBool _, None(), pos),
            TPrimValue(k2, Some(lits2), _),
          ) if (k1 == k2) ->
            // lits2 is a non-empty subset of {true, false}; a size-2 lits2
            // should have been normalized to None() (full).
            invariant(lits2.size() == 1);
            other = if (lits2.contains("true")) "false" else {
              invariant(lits2.contains("false"));
              "true"
            };
            Some(
              TPrimValue(
                k1,
                Some(PrimLiterals::single(PrimLiteral(pos, other))),
                pos,
              ),
            )
          | _ -> Some(stype)
          }
        )
      )
    );
    TType::create(ty.pos, expanded.insts, newClauses)
  }

  static fun removeUndefined(
    subst: mutable Subst,
    tenv: TEnv,
    ty: TType,
  ): TType {
    TType::removeConstant(
      subst,
      tenv,
      ty,
      TPrimUnit(TUndefined(), PosRange::none),
    )
  }

  // TRANSFORMERS

  fun withPos(pos: PosRange): TType {
    // pos is not part of the hash
    this with {pos}
  }

  fun rawMap(
    fInsts: (TInsts) -> (TInsts, readonly Vector<Clauses>),
    fClauses: (Clauses) -> Clauses,
  ): TType {
    (insts, extraClauses) = fInsts(this.insts);
    clauses = fClauses(this.clauses);
    if (!extraClauses.isEmpty()) {
      if (clauses.isEmpty() && extraClauses.size() == 1) {
        !clauses = extraClauses[0];
      } else {
        // internal_error: no subst available because rawMap is called from
        // generic type transformers (e.g. RenameClauses) whose Env may not
        // contain a substitution.
        from = rawPrettyPrint(false, pp -> pp.type(0, Margin{}, this));
        to = rawPrettyPrint(false, pp ->
          pp.type(0, Margin{}, TType::create(this.pos, insts, Clauses::top()))
        );
        internal_error(`Unexpected extra clauses when mapping ${from} to ${to}`)
      }
    };
    TType::create(this.pos, insts, clauses)
  }

  // t.mapSTypes(subst, env, expandTVars, f) is t expanded, with f applied
  // to each clause's stypes before they are unioned. Note that if t expands
  // to Top, it has one clause with None stypes, which is presented to f.
  fun mapSTypes(
    subst: mutable Subst,
    tenv: TEnv,
    expandTVars: ?Variance,
    f: (?STypes) -> ?STypes,
  ): TType {
    this.expandToVectors(subst, tenv, expandTVars) match {
    | None() ->
      f(None()) match {
      | Some(stypes) -> TType::fromSTypes(this.pos, stypes)
      | None() -> TType::top(this.pos)
      }
    | Some((insts, clauses)) ->
      mappedClauses: mutable Vector<Clause> = mutable Vector[];
      for (clause0 in clauses) {
        Clause::create(clause0.vars, f(clause0.stypes)) match {
        | None() -> void
        | Some(clause) -> mappedClauses.push(clause)
        }
      };
      TType::create(
        this.pos,
        TInsts::unionN(insts),
        Clauses::unionN(subst, tenv, mappedClauses),
      )
    }
  }

  private fun mapClauses(
    subst: mutable Subst,
    tenv: TEnv,
    f: Clause -> this,
  ): TType {
    if (this.clauses.isEmpty()) {
      this
    } else {
      accum = TType::create(this.pos, this.insts, Clauses::empty());
      for (clause in this.clauses) {
        !accum = TType::union(subst, tenv, accum, f(clause));
      };
      accum
    }
  }

  // t.mapTParams(subst, tenv, f) is t with each TParam p replaced by u
  // where f(p) is Some(u), or left unchanged if f(p) is None. The type's
  // unions and intersections are rebuilt using subst and tenv.
  fun mapTParams(
    subst: mutable Subst,
    tenv: TEnv,
    f: (TParam) -> ?TType,
  ): TType {
    this.mapClauses(subst, tenv, clause0 -> {
      clause1 = TType::top(this.pos);
      for (tparam in clause0.vars) {
        paramTy = f(tparam) match {
        | None() -> TType::fromTParam(this.pos, tparam)
        | Some(ty) -> ty
        };
        !clause1 = TType::inter(subst, tenv, clause1, paramTy)
      };
      clause0.stypes match {
      | None() -> clause1
      | Some(stypes) ->
        TType::inter(subst, tenv, clause1, TType::fromSTypes(this.pos, stypes))
      }
    })
  }

  // UTILITIES

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintType(false, this, subst, tenv)
  }

  // BOOLEAN PROPERTIES

  fun isBottom(): Bool {
    this.insts.isEmpty() && this.clauses.isEmpty()
  }

  fun isTop(): Bool {
    this.clauses.isTop()
  }

  fun isConcretePrimitive(): Bool {
    if (!this.insts.isEmpty()) return false;
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return false
      | Some(stypes) ->
        if (
          !stypes.all(stype -> stype is TPrimUnit _ || stype is TPrimValue _)
        ) {
          return false
        }
      }
    };
    true
  }

  fun isPrimitiveType(subst: mutable Subst, tenv: TEnv): Bool {
    this.getSTypes(subst, tenv, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      for (stype in stypes) {
        stype match {
        | TPrimUnit _
        | TPrimValue _ ->
          continue
        | TObject _
        | TPromise _ ->
          return false
        }
      };
      true
    }
  }

  // OTHER PROPERTIES

  // Returns the actual STypes after head expansion, forgetting type parameters,
  // so the return value over-approximates the type
  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, tenv: TEnv, variance: Variance): ?STypes {
    this.expandToClauses(subst, tenv, variance).getSTypes(subst, tenv)
  }

  fun expandToVectors(
    subst: mutable Subst,
    tenv: TEnv,
    expandTVars: ?Variance,
  ): ?(mutable Vector<TInst>, mutable Vector<Clause>) /* None is Top */ {
    if (this.isTop()) return None();
    clauses = Vector::mcreateFromItems(this.clauses);
    insts: mutable Vector<TInst> = mutable Vector[];
    todo = Vector::mcreateFromItems(this.insts);
    seen = SortedSet::createFromItems(todo);
    while (!todo.isEmpty()) {
      inst = todo.pop();
      tyDef = inst match {
      | tsinst @ TSInst(name, targs) ->
        subst.seenExpansion.maybeGet(tsinst) match {
        | None() ->
          expandedType = tenv.instantiate(subst, subst, name, targs);
          subst.!seenExpansion[tsinst] = expandedType;
          expandedType
        | Some(expandedType) -> expandedType
        }
      | tInter @ TInter _ -> tInter.expand(subst, tenv)
      | tvar @ TVar _ ->
        expandTVars match {
        | Some(variance) -> subst.get(tenv, tvar, variance)
        | None() ->
          insts.push(tvar);
          continue
        }
      | arrLit @ TArrayLit _ -> ArrayLitTyping::expand(subst, tenv, arrLit)
      };
      if (tyDef.clauses.isTop()) {
        return None();
      };
      clauses.extend(tyDef.clauses);
      for (newInst in tyDef.insts) {
        if (seen.contains(newInst)) continue;
        !seen = seen.set(newInst);
        todo.push(newInst);
      }
    };
    Some((insts, clauses))
  }

  fun expand(subst: mutable Subst, tenv: TEnv, expandTVars: ?Variance): TType {
    this.expandToVectors(subst, tenv, expandTVars) match {
    | None() -> TType::top(this.pos)
    | Some((insts, clauses)) ->
      TType::create(
        this.pos,
        TInsts::unionN(insts),
        Clauses::unionN(subst, tenv, clauses),
      )
    }
  }

  fun expandToClauses(
    subst: mutable Subst,
    tenv: TEnv,
    variance: Variance,
  ): Clauses {
    this.expandToVectors(subst, tenv, Some(variance)) match {
    | None() -> Clauses::top()
    | Some((_, clauses)) -> Clauses::unionN(subst, tenv, clauses)
    }
  }

  fun expandTVarsForPp(subst: mutable Subst, tenv: TEnv): TType {
    clauses = mutable Vector[];
    insts = Vector::mcreateFromItems(this.insts);
    seenTVars = mutable Set[];
    i = 0;
    while (i < insts.size()) {
      ty = insts[i] match {
      | tv @ TVar _ ->
        if (seenTVars.contains(tv.id)) TType::empty else {
          seenTVars.insert(tv.id);
          subst.get(tenv, tv, Covariant())
        }
      | arrLit @ TArrayLit _ -> ArrayLitTyping::expand(subst, tenv, arrLit)
      | TSInst _
      | TInter _ ->
        !i = i + 1;
        continue
      };
      clauses.extend(ty.clauses);
      lastInst = insts.pop();
      if (i < insts.size()) insts![i] = lastInst;
      insts.extend(ty.insts)
    };
    if (
      seenTVars.isEmpty() &&
      clauses.isEmpty() &&
      insts.size() == this.insts.size()
    ) {
      this
    } else {
      clauses.extend(this.clauses);
      TType::create(
        this.pos,
        TInsts::createFromMVector(insts),
        Clauses::unionN(subst, tenv, clauses),
      )
    }
  }

  fun getConstantString(): ?PrimLiteral {
    if (!this.insts.isEmpty()) None() else {
      this.clauses.getConstantString()
    }
  }

  fun getSingleConstant(): ?TPrim {
    if (!this.insts.isEmpty()) None() else {
      this.clauses.getSingleConstant()
    }
  }

  fun getSingleVar(): ?TVar {
    if (this.clauses.isEmpty()) this.insts.getSingleVar() else {
      None()
    }
  }

  fun getSingleInter(): ?TInter {
    if (this.clauses.isEmpty()) this.insts.getSingleInter() else {
      None()
    }
  }
}

base class Variance {
  children =
  | Covariant()
  | Contravariant()
}

/***************************************************************************/
/* Object types. */
/***************************************************************************/

// Regular Typescript (open) object type
//
// Interpretation:
// 〚 obj 〛 = ⨆ 〚 b 〛, for b in obj.branches
//
// Invariant: branches is not empty
class TObject private (
  private branches: ArraySet<TFields>,
  unexpandedType: ?TSInst,
) extends SType {
  /* Constructors */

  static fun createSingleBranch(
    tFields: TFields,
    inst: ?TSInst,
    pos: PosRange,
  ): TObject {
    TObject(ArraySet::single(tFields), inst, pos)
  }

  static fun createEmpty(pos: PosRange): TObject {
    TObject::createSingleBranch(TFields::empty(), None(), pos)
  }

  static fun createCallWithPos(tFuns: TFuns, pos: PosRange): TObject {
    TObject::createSingleBranch(
      TFields::create{call => Some(tFuns)},
      None(),
      pos,
    )
  }

  static fun createCall(tFuns: TFuns): TObject {
    TObject::createCallWithPos(tFuns, tFuns.pos)
  }

  static fun createNew(tFuns: TFuns, pos: PosRange): TObject {
    TObject::createSingleBranch(
      TFields::create{new => Some(tFuns)},
      None(),
      pos,
    )
  }

  /* Transformers */

  fun map(f: TFields -> TFields): TObject {
    TObject(this.branches.mapToSet(f), None(), this.pos)
  }

  fun mapOpt(f: TFields -> ?TFields): ?TObject {
    branches = this.branches.filterMap(f);
    if (branches.isEmpty()) None() else Some(this with {branches})
  }

  fun mapCall(f: (?(Bool, TFuns)) -> ??(Bool, TFuns)): ?TObject {
    this.mapOpt(fields -> fields.mapCall(f))
  }

  fun filterFields(f: TField -> Bool): TObject {
    this.map(fields -> fields.filterFields(f))
  }

  fun filterSymbolFields(f: TField -> Bool): TObject {
    this.map(fields -> fields.filterSymbolFields(f))
  }

  fun removeFields(fieldsToRemove: SortedSet<String>): TObject {
    if (fieldsToRemove.isEmpty()) this else {
      this.map(fields -> fields.removeFields(fieldsToRemove))
    }
  }

  /* Accessors */

  fun getFields(subst: mutable Subst, tenv: TEnv): TFields {
    branches = this.branches.values();
    result = branches.next().fromSome();
    for (fields in branches) {
      !result = TFields::union(subst, tenv, result, fields)
    };
    result
  }

  fun getAllFields(): mutable Iterator<TFields> {
    this.branches.values()
  }

  fun getBranches(): Array<TFields> {
    this.branches.toArray()
  }

  // Returns Some(arity) when every branch of this TObject is a tuple of the
  // same arity (via TFields::isTuple). Avoids the Subst that `asTuple` needs
  // for element unioning — useful for callers that only care about length
  // (e.g. out-of-bound index checks).
  fun isTuple(): ?Int {
    this.branches.values().next().flatMap(first -> first.isTuple()) match {
    | res @ Some(arity) if (
      this.branches.all(fields ->
        fields.isTuple() match {
        | Some(otherArity) -> otherArity == arity
        | None() -> false
        }
      )
    ) ->
      res
    | _ -> None()
    }
  }

  // Returns Some(elts) when every branch of this TObject is a tuple of the
  // same arity (via TFields::asTuple). Elements of branches are unioned
  // positionally. Returns None() if any branch is not a tuple or arities
  // differ (the caller sees the raw TObject in that case).
  fun asTuple(subst: mutable Subst, tenv: TEnv): ?Array<TType> {
    branches = this.branches.toArray();
    if (branches.isEmpty()) return None();
    first = branches[0].asTuple() match {
    | Some(elts) -> elts
    | None() -> return None()
    };
    if (branches.size() == 1) return Some(first);
    arity = first.size();
    branchesElts = mutable Vector[first];
    for (i in Range(1, branches.size())) {
      branches[i].asTuple() match {
      | Some(elts) if (elts.size() == arity) -> branchesElts.push(elts)
      | _ -> return None()
      }
    };
    Some(
      Array::fillBy(arity, i ->
        TType::unionN_it(
          subst,
          tenv,
          this.pos,
          branchesElts.values().map(be -> be[i]),
        )
      ),
    )
  }

  fun maybeGetType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
  ): ?TType {
    tys = mutable Vector[];
    for (fields in this.branches) {
      fields.maybeGetType(subst, tenv, fieldName, pos, false) match {
      | None() -> return None()
      | Some(ty) -> tys.push(ty)
      }
    };
    Some(TType::unionN(subst, tenv, pos, tys))
  }

  fun getType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
  ): TType {
    this.maybeGetType(subst, tenv, fieldName, pos) match {
    | Some(res) -> res
    | None() -> this.getFields(subst, tenv).getTypeTypingError(fieldName, pos)
    }
  }

  fun maybeGetSymbolType(
    subst: mutable Subst,
    tenv: TEnv,
    uniqueId: String,
    pos: PosRange,
    isLValue: Bool,
  ): ?TType {
    tys = mutable Vector[];
    for (fields in this.branches) {
      fields.maybeGetSymbolType(subst, tenv, uniqueId, pos, isLValue) match {
      | None() -> return None()
      | Some(ty) -> tys.push(ty)
      }
    };
    Some(
      (if (isLValue) TType::interN else TType::unionN)(subst, tenv, pos, tys),
    )
  }

  // Looks up a symbol-keyed field across all branches, merging each
  // branch's TField via TField::union (so get/set/isOptional/access all
  // combine consistently). Returns None if any branch lacks the field,
  // matching maybeGetSymbolType's all-branches semantics. Used when the
  // caller needs the TField (e.g. to consult access) rather than just
  // the resolved type.
  fun maybeGetSymbol(
    subst: mutable Subst,
    tenv: TEnv,
    uniqueId: String,
  ): ?TField {
    result: ?TField = None();
    for (fields in this.branches) {
      fields.maybeGetSymbol(uniqueId) match {
      | None() -> return None()
      | Some(fd) ->
        !result = Some(
          result match {
          | None() -> fd
          | Some(prev) -> TField::union(subst, tenv, prev, fd)
          },
        )
      }
    };
    result
  }

  fun maybeGetCall(subst: mutable Subst, tenv: TEnv): ?(Bool, TFuns) {
    result: ?(Bool, TFuns) = None();
    for (fields in this.branches) {
      (fields, result) match {
      | (TFields{call => None()}, _) -> return None()
      | (TFields{call => first @ Some _}, None()) -> !result = first
      | (TFields{call => Some((opt2, tFuns2))}, Some((opt1, tFuns1))) ->
        !result = Some(
          (opt1 || opt2, TFuns::union(subst, tenv, tFuns1, tFuns2)),
        )
      }
    };
    result
  }

  fun maybeGetRetType(subst: mutable Subst, tenv: TEnv): ?TType {
    tys = mutable Vector[];
    for (fields in this.branches) {
      fields match {
      | TFields{call => Some((_, TFuns(fun_, _)))} -> tys.push(fun_.retType)
      | TFields{call => None()} -> return None()
      }
    };
    Some(TType::unionN(subst, tenv, this.pos, tys))
  }

  fun maybeGetNew(subst: mutable Subst, tenv: TEnv): ?(Bool, TFuns) {
    result: ?(Bool, TFuns) = None();
    for (fields in this.branches) {
      (fields, result) match {
      | (TFields{new => None()}, _) -> return None()
      | (TFields{new => first @ Some _}, None()) -> !result = first
      | (TFields{new => Some((opt2, tFuns2))}, Some((opt1, tFuns1))) ->
        !result = Some(
          (opt1 || opt2, TFuns::union(subst, tenv, tFuns1, tFuns2)),
        )
      }
    };
    result
  }
}

/***************************************************************************/
/* Functions */
/* Use only as the call and new 'fields' of objects (TFields) */
/***************************************************************************/

class TFuns private (fun_: TFun, pos: PosRange) uses XXHashable, Orderable {
  static fun singleFun(x: TFun, pos: PosRange): TFuns {
    TFuns(x, pos)
  }

  static fun singleMethod(x: TFun, pos: PosRange): TFuns {
    TFuns(x, pos)
  }

  fun mapFuns(f: TFun -> TFun): TFuns {
    TFuns(f(this.fun_), this.pos)
  }
}

class TFun(
  tparams: Array<TParamWithConstraint>,
  thisParam: ?TType,
  params: Array<TType>,
  optionalParams: Array<TType>,
  spreadParam: ?TType, /* A function can always accept more ignored parameters, so None() is like Some(Array<Top>) */
  retType: TType,
  cgNodes: CGNodes,
) uses XXHashable, Orderable {
  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintTFun(subst, tenv, this)
  }
}

/***************************************************************************/
/* Rest-parameter element extraction */
/***************************************************************************/

// Element extraction for a rest-parameter type: expand to a single TObject and
// walk its Symbol.iterator protocol. Returns None for tuples, intersections, or
// anything that doesn't reduce to a single iterable object.
fun maybeGetRestElementType(
  subst: mutable Subst,
  tenv: TEnv,
  spreadType: TType,
  variance: Variance,
): ?TType {
  spreadType.getSTypes(subst, tenv, variance).flatMap(stypes ~>
    stypes.singleElt()
  ) match {
  | Some(obj @ TObject(_, _, objectPos)) ->
    tenv.getIteratorElementType(subst, obj, objectPos)
  | _ -> None()
  }
}

// Like maybeGetRestElementType but supplies a variance-appropriate fallback
// (Top for covariant, Bottom for contravariant) instead of None.
fun getRestElementType(
  subst: mutable Subst,
  tenv: TEnv,
  spreadType: TType,
  variance: Variance,
): TType {
  maybeGetRestElementType(subst, tenv, spreadType, variance) match {
  | Some(res) -> res
  | None() ->
    variance match {
    | Covariant() -> TType::top(spreadType.pos)
    | Contravariant() -> TType::bottom(spreadType.pos)
    }
  }
}

/***************************************************************************/
/* Single types */
/***************************************************************************/

/* Types with a single inhabitant:
- undefined for types void and undefined
- null for type null

In Typescript, void is both bottom and a supertype of everything when used as a
return type.

In SKJS, we decided (see https://github.com/SkipLabs/skjs/issues/75) that void
would be a distinct type from undefined. It contains the value undefined but
with no operations permitted on it.

We should ensure that nothing non-undefined can be of type void. */
base class TPrimUnitKind uses XXHashable, Orderable {
  children =
  | TUndefined()
  | TVoid()
  | TNull()

  fun toString(): String {
    this match {
    | TUndefined() -> "undefined"
    | TVoid() -> "void"
    | TNull() -> "null"
    }
  }
}

/* Types with literal subtypes: booleans, numbers, strings, bigints, and symbols. */
base class TPrimValueKind uses XXHashable, Orderable {
  children =
  | TNum()
  | TBool()
  | TString()
  | TBigInt()
  | TSymbol()

  fun toString(): String {
    this match {
    | TNum() -> "number"
    | TBool() -> "boolean"
    | TString() -> "string"
    | TBigInt() -> "bigint"
    | TSymbol() -> "symbol"
    }
  }
}

// Restricted key kind for FKName: only string or number
base class FKNameKind extends TPrimValueKind
extension class TNum extends FKNameKind
extension class TString extends FKNameKind

// Represents either a string/number field name or a symbol key
base class FieldKey {
  children =
  | FKName(name: Name, kind: FKNameKind)
  | FKSymbol(keyPos: PosRange, uniqueId: String)

  fun pos(): PosRange {
    this match {
    | FKName(name, _) -> name.pos
    | FKSymbol(keyPos, _) -> keyPos
    }
  }

  fun value(): String {
    this match {
    | FKName(name, _) -> name.value
    | FKSymbol(_, uniqueId) -> uniqueId
    }
  }

  static fun ofSType(pos: PosRange, stype: SType): ?FieldKey {
    stype match {
    | TPrimValue(k @ TString(), Some(lits), _)
    | TPrimValue(k @ TNum(), Some(lits), _) ->
      lits.singleElt().map(lit -> FKName(Name(pos, lit.val), k))
    | TPrimValue(TSymbol(), Some(lits), _) ->
      lits.singleElt().map(lit -> FKSymbol(pos, lit.val))
    | _ -> None()
    }
  }

  // Like ofSType but returns all literals, not just when there's exactly one.
  static fun allOfSType(pos: PosRange, stype: SType): Array<FieldKey> {
    stype match {
    | TPrimValue(k @ TString(), Some(lits), _)
    | TPrimValue(k @ TNum(), Some(lits), _) ->
      lits.values().map(lit -> FKName(Name(pos, lit.val), k)).collect(Array)
    | TPrimValue(TSymbol(), Some(lits), _) ->
      lits.values().map(lit -> FKSymbol(pos, lit.val)).collect(Array)
    | _ -> Array[]
    }
  }

  fun toType(): TType {
    TType::single(
      TPrimValue::single(this.toPrimValueKind(), this.value(), this.pos()),
    )
  }

  fun toPrimValueKind(): TPrimValueKind {
    this match {
    | FKName(_, kind) -> kind
    | FKSymbol _ -> TSymbol()
    }
  }
}

base class STypeTag final () uses Orderable {
  children =
  | TagUndefined
  | TagVoid
  | TagNull
  | TagBool
  | TagNum
  | TagString
  | TagBigInt
  | TagSymbol
  | TagPromise
  | TagObject
}

base class SType private (
  pos: PosRange,
) uses XXHashable, Orderable, Projectable<STypeTag> {
  children =
  | TPromise(inner: TType)

  fun tag(): STypeTag {
    this match {
    | TPrimUnit(TUndefined(), _) -> TagUndefined()
    | TPrimUnit(TVoid(), _) -> TagVoid()
    | TPrimUnit(TNull(), _) -> TagNull()
    | TPrimValue(TBool(), _, _) -> TagBool()
    | TPrimValue(TNum(), _, _) -> TagNum()
    | TPrimValue(TString(), _, _) -> TagString()
    | TPrimValue(TBigInt(), _, _) -> TagBigInt()
    | TPrimValue(TSymbol(), _, _) -> TagSymbol()
    | TPromise _ -> TagPromise()
    | TObject _ -> TagObject()
    }
  }

  overridable fun isTuple(): ?Int {
    None()
  }

  fun project(): STypeTag {
    this.tag()
  }

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintSType(subst, tenv, this, false)
  }
}

base class TPrim extends SType {
  fun sameConstant(other: TPrim): Bool {
    (this, other) match {
    | (TPrimUnit(k1, _), TPrimUnit(k2, _)) -> k1 == k2
    | (TPrimValue(k1, Some(l1), _), TPrimValue(k2, Some(l2), _)) ->
      k1 == k2 && l1.size() == 1 && l1 == l2
    | _ -> false
    }
  }
}
extension class TPrimUnit extends TPrim
extension class TPrimValue extends TPrim

class TPrimUnit(kind: TPrimUnitKind) extends SType

class TPrimValue(kind: TPrimValueKind, literals: ?PrimLiterals) extends SType {
  static fun single(
    kind: TPrimValueKind,
    value: String,
    pos: PosRange,
  ): TPrimValue {
    TPrimValue(kind, Some(PrimLiterals::single(PrimLiteral(pos, value))), pos)
  }

  static fun full(kind: TPrimValueKind, pos: PosRange): TPrimValue {
    TPrimValue(kind, None(), pos)
  }

  static fun boolean(pos: PosRange): TPrimValue {
    TPrimValue::full(TBool(), pos)
  }

  static fun number(pos: PosRange): TPrimValue {
    TPrimValue::full(TNum(), pos)
  }

  static fun string(pos: PosRange): TPrimValue {
    TPrimValue::full(TString(), pos)
  }

  static fun bigint(pos: PosRange): TPrimValue {
    TPrimValue::full(TBigInt(), pos)
  }

  static fun symbol(pos: PosRange): TPrimValue {
    TPrimValue::full(TSymbol(), pos)
  }

  fun asClassName(): Name {
    Name(this.pos, this.kind.toString())
  }
}

// Accessibility of a class field or method.
// Non-class object types (and synthetic indexes) keep FAPublic.
// FAPrivate carries the declaring class's declaration `Name` (whose pos
// also identifies the declaring file), used at access sites to enforce
// visibility. `protected` is silently accepted at parse time but lowered
// to FAPublic — SKJS does not enforce it.
// FANever is the result of unioning/intersecting two FAPrivate fields with
// different owners — no enclosing class can satisfy both, so all access is
// rejected.
// FAPhantom marks a field synthesized by the `in` operator narrowing when
// the type carries no matching index: presence is runtime-confirmed, but
// the underlying declaration (and visibility) is unknown. Carries the
// position of the `in` check so diagnostics can cite it. Access through a
// phantom always errors — it might be a private field of some class.
base class FieldAccess uses XXHashable, Orderable {
  children =
  | FAPublic()
  | FAPrivate(owner: Name)
  | FANever()
  | FAPhantom(inPos: PosRange)

  // Most-restrictive combination: access succeeds on the result iff
  // access succeeds on both inputs. Used when fields are unioned or
  // intersected across object branches.
  fun combine(other: FieldAccess): FieldAccess {
    (this, other) match {
    | (FAPublic(), x)
    | (x, FAPublic()) ->
      x
    | (
      FAPrivate(o1),
      FAPrivate(o2),
    ) if (o1.value == o2.value && o1.pos.fileName == o2.pos.fileName) ->
      FAPrivate(o1)
    | (FAPrivate _, FAPrivate _)
    | (FANever(), _)
    | (_, FANever()) ->
      FANever()
    | (p @ FAPhantom _, _)
    | (_, p @ FAPhantom _) ->
      p
    }
  }

  // Returns true when a field whose declared access is `this` can be
  // viewed through a target field whose declared access is `target`.
  // Access kinds must match exactly — a private field is structurally
  // distinct from a public one with the same name (TypeScript's nominal
  // treatment of private). FANever is trivially compatible — nothing
  // can access the target anyway. A phantom can only stand in for
  // another phantom (or FANever) — it cannot masquerade as a real
  // public/private declaration.
  fun isCompatibleWith(target: FieldAccess): Bool {
    target match {
    | FANever() -> true
    | FAPrivate(t) ->
      this match {
      | FAPrivate(s) -> s.value == t.value && s.pos.fileName == t.pos.fileName
      | _ -> false
      }
    | FAPublic() -> this is FAPublic _
    | FAPhantom _ -> this is FAPhantom _
    }
  }
}

class TField{
  pos: PosRange,
  name: FieldNameString,
  isOptional: Bool,
  get: TType,
  set: TType,
  access: FieldAccess,
} uses XXHashable, Orderable, Projectable<FieldNameString> {
  static fun create{
    pos: PosRange,
    name: String,
    isOptional: Bool,
    isReadonly: ?PosRange,
    type: TType,
    access: FieldAccess,
  }: TField {
    setType = isReadonly match {
    | Some(roPos) -> TType::bottom(roPos)
    | None() -> type
    };
    TField{
      pos,
      name => FieldNameString(name),
      isOptional,
      get => type,
      set => setType,
      access,
    }
  }

  // Create a synthetic index field with separate get/set TVars.
  // Used for object literal indexes that should be transparent to the
  // setter direction of subtyping (see kSyntheticIndexName).
  static fun createSyntheticIndex(subst: mutable Subst, pos: PosRange): TField {
    getTvar = subst.gen(pos);
    subst.setOrigin(getTvar, FromSyntheticIndex(pos));
    get = TType::var(getTvar);
    setTvar = subst.gen(pos);
    subst.setOrigin(setTvar, FromSyntheticIndex(pos));
    set = TType::var(setTvar);
    TField{
      pos,
      name => FieldNameString(kSyntheticIndexName),
      isOptional => true,
      get,
      set,
      access => FAPublic(),
    }
  }

  // True if this field is the synthetic index created for object literals
  // (see kSyntheticIndexName). Used to keep the internal name out of
  // user-visible output while still letting it participate in subtyping.
  fun isSynthetic(): Bool {
    this.name.value == kSyntheticIndexName
  }

  // Create a virtual field from an index, renamed for use in union.
  // Indexes are already optional (isOptional = true).
  fun asNamed(name: FieldNameString): TField {
    this with {name}
  }

  fun mapType(f: TType -> TType): TField {
    this with {get => f(this.get), set => f(this.set)}
  }

  fun withGet(get: TType, isOptional: Bool): TField {
    this with {get, isOptional}
  }

  fun withIsOptional(isOptional: Bool): TField {
    this with {isOptional}
  }

  fun project(): FieldNameString {
    this.name
  }
}

/* Which primitive key kinds an index signature accepts */
value class IndexKeyKinds private {
  hasString: Bool,
  hasNumber: Bool,
  hasSymbol: Bool,
} {
  /* Returns None() if all three values are false */
  static fun create{
    hasString: Bool,
    hasNumber: Bool,
    hasSymbol: Bool,
  }: ?IndexKeyKinds {
    if (hasString || hasNumber || hasSymbol) {
      Some(IndexKeyKinds{hasString, hasNumber, hasSymbol})
    } else {
      None()
    }
  }
}

// Wrapper around String that sorts numeric field names (tuple indices)
// before non-numeric ones. This ensures tuple fields are processed first
// in intersection, union, and subtyping, so their type variables are
// resolved before other fields/methods with union types.
value class FieldNameString(
  value: String,
) uses Orderable, Hashable, Show, XXHashable {
  fun compare(other: FieldNameString): Order {
    (this.value.toIntOption(), other.value.toIntOption()) match {
    | (Some(a), Some(b)) -> a.compare(b)
    | (Some(_), None()) -> LT()
    | (None(), Some(_)) -> GT()
    | (None(), None()) -> this.value.compare(other.value)
    }
  }

  fun toString(): String {
    this.value
  }
}

const kArrayBrandFieldName: String = "__SKJS_isArray";
// Prefix on the synthetic TInst name used as a placeholder for a class
// field declared without a type annotation. The class_ check still
// reports "Type annotation expected" at declaration time for non-ambient
// classes; the placeholder lets ambient declarations (where class_
// doesn't run) round-trip. See TEnv::addFields and TEnv::instantiate.
const kMissingTypeAnnotationPrefix: String = "Missing_type_annotation_for_";
// Synthetic index signatures on object literals.
//
// Object literals like `{ x: 1, y: 2 }` get fresh type variables as string
// and symbol index signatures. This allows them to be assigned to indexed
// types like `{ [k: string]: number }` via normal subtyping: the TVar
// unifies with the target index's value type.
//
// These synthetic indexes are named __SKJS_internal_index to distinguish them
// from user-declared indexes. They must be:
// - Visible to subtyping (indexForFieldName, isSub_IndexPair) so that object
//   literals can satisfy indexed type constraints.
// - Invisible to field resolution (hasNonSyntheticIndex,
//   nonSyntheticIndexForKeyKind, nonSyntheticIndexKeyKindsString) so that
//   `obj.z` on `{ x: 1 }` still reports "Unbound field" rather than resolving
//   through the synthetic index.
const kSyntheticIndexName: String = "__SKJS_internal_index";

base class TIndexesBase protected {
  // At most one index per key kind: string, number, symbol.
  // Key types are validated by resolveIndexKeyKinds.
  // Field/index value type compatibility is checked during subtyping.
  // Stored as TField (key kind is implicit in which field).
  // Indexes are optional (isOptional = true): any indexed key may not exist.
  // The pretty-printer uses a separate indexField() path that doesn't
  // print `?`, so this doesn't affect display.
  stringIndex: ?TField = None(),
  numberIndex: ?TField = None(),
  symbolIndex: ?TField = None(),
} {
  // Find the matching index for a named field:
  // numeric string names try numberIndex first, then stringIndex;
  // all other names use stringIndex.
  fun indexForFieldName(name: String): ?TField {
    if (isJSNumericString(name) && this.numberIndex.isSome()) {
      this.numberIndex
    } else {
      this.stringIndex
    }
  }
}

class TIndexes{} extends TIndexesBase {
  const empty: TIndexes = TIndexes{};

  // Split indexes by key kind and merge duplicates per kind.
  // When multiple indexes cover the same kind, their value types are merged:
  //   getter (covariant) → intersection, setter (contravariant) → union.
  static fun create(
    tcenvb: mutable TCEnvBase,
    tenv: TEnv,
    indexes: readonly Vector<(IndexKeyKinds, TField)>,
  ): TIndexes {
    stringIndexes: mutable Vector<TField> = mutable Vector[];
    numberIndexes: mutable Vector<TField> = mutable Vector[];
    symbolIndexes: mutable Vector<TField> = mutable Vector[];
    for ((keyKinds, f) in indexes) {
      if (keyKinds.hasString) stringIndexes.push(f);
      if (keyKinds.hasNumber) numberIndexes.push(f);
      if (keyKinds.hasSymbol) symbolIndexes.push(f);
    };
    stringIndex = TIndexes::mergeIndexesForKind(tcenvb, tenv, stringIndexes);
    numberIndex = TIndexes::mergeIndexesForKind(tcenvb, tenv, numberIndexes);
    symbolIndex = TIndexes::mergeIndexesForKind(tcenvb, tenv, symbolIndexes);
    TIndexes{stringIndex, numberIndex, symbolIndex}
  }

  // Merge multiple indexes for the same key kind into a single TField.
  // Getter (covariant) → intersection, setter (contravariant) → union.
  private static fun mergeIndexesForKind(
    tcenvb: mutable TCEnvBase,
    tenv: TEnv,
    indexes: readonly Vector<TField>,
  ): ?TField {
    indexesIt = indexes.iterator();
    result = indexesIt.next() match {
    | None() -> return None()
    | Some(first) -> first
    };
    subst = Subst::mcreate(tcenvb);
    for (other in indexesIt) {
      !result = TField::interIndex(subst, tenv, result, other);
    };
    Some(result)
  }
}

class TFields protected {
  fields: InternalKeyedArrayMap<
    FieldNameString,
    TField,
  > = InternalKeyedArrayMap::empty(),
  // Fields keyed by unique symbol ID (e.g. Symbol.iterator)
  symbolFields: InternalKeyedArrayMap<
    FieldNameString,
    TField,
  > = InternalKeyedArrayMap::empty(),
  new: ?(/* optional */ Bool, TFuns) = None(),
  call: ?(/* optional */ Bool, TFuns) = None(),
  // None = unknown, Some(true) = is array, Some(false) = not array
  isArray: ?Bool = None(),
} extends TIndexesBase uses XXHashable, Orderable {
  static fun empty(): TFields {
    TFields{}
  }

  private static fun createFromSortedIterator{
    fields: mutable Iterator<TField>,
    symbolFields: mutable Iterator<TField>,
    tIndexes: TIndexesBase,
    new: ?TFuns = None(),
    call: ?TFuns = None(),
    isArray: ?Bool = None(),
  }: TFields {
    TFields{
      fields => InternalKeyedArrayMap::createFromSortedIterator(fields),
      symbolFields => InternalKeyedArrayMap::createFromSortedIterator(
        symbolFields,
      ),
      stringIndex => tIndexes.stringIndex,
      numberIndex => tIndexes.numberIndex,
      symbolIndex => tIndexes.symbolIndex,
      new => new.map(tFuns ~> (false, tFuns)),
      call => call.map(tFuns ~> (false, tFuns)),
      isArray,
    }
  }

  // Create TFields from pre-sorted SortedMaps (object literal handler).
  static fun createFromSorted{
    fields: SortedMap<FieldNameString, TField> = SortedMap[],
    symbolFields: SortedMap<FieldNameString, TField> = SortedMap[],
    tIndexes: TIndexesBase = TIndexes::empty,
    isArray: ?Bool = None(),
  }: TFields {
    TFields::createFromSortedIterator{
      fields => fields.values(),
      symbolFields => symbolFields.values(),
      tIndexes,
      isArray,
    }
  }

  static fun create{
    fields: mutable Map<FieldNameString, TField> = mutable Map[],
    symbolFields: readonly Map<FieldNameString, TField> = Map[],
    tIndexes: TIndexesBase = TIndexes::empty,
    new: ?TFuns = None(),
    call: ?TFuns = None(),
    isArray: ?Bool = None(),
  }: TFields {
    brandKey = FieldNameString(kArrayBrandFieldName);
    fields.maybeGet(brandKey) match {
    | Some(brandField) ->
      fields.remove(brandKey);
      brandField.get.getSingleConstant() match {
      | Some(TPrimValue(TBool(), Some(lits), _)) ->
        lits.singleElt() match {
        | Some(PrimLiteral(_pos, "true")) -> Some(true)
        | Some(PrimLiteral(_pos, "false")) -> Some(false)
        | _ -> None()
        }
      | _ -> None()
      } match {
      | None() ->
        error(
          Array[
            (
              brandField.get.pos,
              `Brand field ${kArrayBrandFieldName} expected to be either true or false, instead got ${rawPrettyPrint(
                false,
                pp -> pp.type(0, Margin{}, brandField.get),
              )}`,
            ),
          ],
        )
      | brandIsArray @ Some _ -> !isArray = brandIsArray
      }
    | None() -> void
    };
    TFields::createFromSortedIterator{
      fields => fields.values().collect(Array).sortedBy(x ~> x.name).values(),
      symbolFields => symbolFields
        .values()
        .collect(Array)
        .sortedBy(x ~> x.name)
        .values(),
      tIndexes,
      new,
      call,
      isArray,
    }
  }

  static fun singleField(field: TField): TFields {
    TFields{fields => InternalKeyedArrayMap::single(field)}
  }

  static fun singleSymbolField(field: TField): TFields {
    TFields{symbolFields => InternalKeyedArrayMap::single(field)}
  }

  fun isEmpty(): Bool {
    this.fields.isEmpty() &&
      this.symbolFields.isEmpty() &&
      !this.hasNonSyntheticIndex() &&
      this.new.isNone() &&
      this.call.isNone()
  }

  fun map(fField: TField -> TField, fTFuns: TFuns -> TFuns): TFields {
    TFields{
      fields => this.fields.mapKeyed(fField),
      symbolFields => this.symbolFields.mapKeyed(fField),
      stringIndex => this.stringIndex.map(fField),
      numberIndex => this.numberIndex.map(fField),
      symbolIndex => this.symbolIndex.map(fField),
      new => this.new.map(opt_tfuns -> (opt_tfuns.i0, fTFuns(opt_tfuns.i1))),
      call => this.call.map(opt_tfuns -> (opt_tfuns.i0, fTFuns(opt_tfuns.i1))),
      isArray => this.isArray,
    }
  }

  fun mapCall(f: (?(Bool, TFuns)) -> ??(Bool, TFuns)): ?TFields {
    f(this.call).map(call -> this with {call})
  }

  fun filterFields(f: TField -> Bool): TFields {
    this with {fields => this.fields.filterKeyed(f)}
  }

  fun filterMapFields(f: TField -> ?TField): TFields {
    this with {fields => this.fields.filterMap(f)}
  }

  // Updates the named field in place, leaving all other fields unchanged.
  fun updateField(fieldName: String, f: TField -> TField): TFields {
    this with {
      fields => this.fields.mapKeyed(fd ->
        if (fd.name.value == fieldName) f(fd) else fd
      ),
    }
  }

  // Updates the named symbol field in place, leaving all other fields
  // unchanged.
  fun updateSymbolField(uniqueId: String, f: TField -> TField): TFields {
    this with {
      symbolFields => this.symbolFields.mapKeyed(fd ->
        if (fd.name.value == uniqueId) f(fd) else fd
      ),
    }
  }

  // Like updateField/updateSymbolField but dispatches on a FieldKey.
  fun updateFieldByKey(key: FieldKey, f: TField -> TField): TFields {
    key match {
    | FKName(name, _) -> this.updateField(name.value, f)
    | FKSymbol(_, uniqueId) -> this.updateSymbolField(uniqueId, f)
    }
  }

  private static fun nonSynthetic(index: ?TField): ?TField {
    index.flatMap(f -> if (f.isSynthetic()) None() else Some(f))
  }

  fun hasNonSyntheticIndex(): Bool {
    TFields::nonSynthetic(this.stringIndex).isSome() ||
      TFields::nonSynthetic(this.numberIndex).isSome() ||
      TFields::nonSynthetic(this.symbolIndex).isSome()
  }

  // Human-readable string of supported index key kinds (e.g. "number").
  fun nonSyntheticIndexKeyKindsString(): String {
    parts: mutable Vector<String> = mutable Vector[];
    if (TFields::nonSynthetic(this.stringIndex).isSome()) parts.push("string");
    if (TFields::nonSynthetic(this.numberIndex).isSome()) parts.push("number");
    if (TFields::nonSynthetic(this.symbolIndex).isSome()) parts.push("symbol");
    parts.join(" | ")
  }

  // Find an index that accepts the given key kind.
  // For number keys, try numberIndex first, then fall back to stringIndex
  // (since JS coerces number keys to strings).
  // Excludes synthetic indexes (used only for subtyping object literals).
  fun nonSyntheticIndexForKeyKind(kind: TPrimValueKind): ?TField {
    idx = kind match {
    | TString() -> this.stringIndex
    | TNum() ->
      this.numberIndex match {
      | Some _ -> this.numberIndex
      | None() -> this.stringIndex
      }
    | TSymbol() -> this.symbolIndex
    | _ -> None()
    };
    TFields::nonSynthetic(idx)
  }

  // Named fields that a general (non-literal) key of `kind` could resolve to
  // at runtime. Used by element access (`x[k]`) to keep the result sound when
  // the key isn't a known literal: such a key may land on a declared field
  // rather than the index signature, so the field types must be unioned in.
  //   - A general string key may hit ANY field name (including numeric ones).
  //   - A general number key only hits field names of the form `String(n)`.
  //   - A symbol key never hits a string-named field.
  // TypeScript forbids declared fields whose type isn't assignable to the
  // index type (TS2411), so for valid programs these fields are subsumed by
  // the index value type and unioning them is a no-op; SKJS does not enforce
  // TS2411, so the union is what makes the read sound.
  fun namedFieldsForKeyKind(kind: TPrimValueKind): Array<TField> {
    kind match {
    | TString() -> this.fields.toArray()
    | TNum() ->
      // A number key `n` reaches the field named `String(n)`. Beyond the finite
      // canonical numeric strings (isJSNumericString is `isFinite`-only by
      // contract), that includes the three non-finite results of
      // `Number.prototype.toString`: "Infinity", "-Infinity", and "NaN".
      this.fields.toArray().filter(fd -> {
        name = fd.name.value;
        isJSNumericString(name) ||
          name == "Infinity" ||
          name == "-Infinity" ||
          name == "NaN"
      })
    | _ -> Array[]
    }
  }

  fun maybeGet(fieldName: String): ?TField {
    this.fields.maybeGet(FieldNameString(fieldName))
  }

  // Returns Some(length) when this TFields is an array-branded object whose
  // `length` field has a non-negative literal-number type N AND every
  // positional field `0..N-1` is present.
  fun isTuple(): ?Int {
    if (this.isArray != Some(true)) return None();
    lengthField = this.maybeGet("length") match {
    | Some(f) -> f
    | None() -> return None()
    };
    length = lengthField.get.getSingleConstant() match {
    | Some(TPrimValue(TNum(), Some(lits), _)) ->
      lits.singleElt() match {
      | Some(PrimLiteral(_, v)) -> v.toIntOption()
      | None() -> None()
      }
    | _ -> None()
    } match {
    | Some(n) if (n >= 0) -> n
    | _ -> return None()
    };
    for (i in Range(0, length)) {
      if (this.maybeGet(i.toString()) is None _) return None();
    };
    Some(length)
  }

  // Returns Some(elts) when this TFields is tuple-shaped per `isTuple`,
  // i.e. an array-branded object with a non-negative literal length and
  // every positional field present.
  fun asTuple(): ?Array<TType> {
    this.isTuple().map(length ->
      Array::fillBy(length, i -> this.maybeGet(i.toString()).fromSome().get)
    )
  }

  fun maybeGetSymbol(uniqueId: String): ?TField {
    this.symbolFields.maybeGet(FieldNameString(uniqueId))
  }

  static fun resolveFieldType(
    subst: mutable Subst,
    tenv: TEnv,
    fd: TField,
    pos: PosRange,
    isLValue: Bool,
  ): TType {
    if (isLValue) {
      fd.set
    } else if (fd.isOptional) {
      TType::unionUndefined(subst, tenv, fd.get, pos)
    } else {
      fd.get
    }
  }

  fun maybeGetType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
    isLValue: Bool,
  ): ?TType {
    this.maybeGet(fieldName).map(fd ->
      TFields::resolveFieldType(subst, tenv, fd, pos, isLValue)
    )
  }

  fun maybeGetSymbolType(
    subst: mutable Subst,
    tenv: TEnv,
    uniqueId: String,
    pos: PosRange,
    isLValue: Bool,
  ): ?TType {
    this.maybeGetSymbol(uniqueId).map(fd ->
      TFields::resolveFieldType(subst, tenv, fd, pos, isLValue)
    )
  }

  fun maybeGetField(key: FieldKey): ?TField {
    key match {
    | FKName(name, _) -> this.maybeGet(name.value)
    | FKSymbol(_, uniqueId) -> this.maybeGetSymbol(uniqueId)
    }
  }

  fun getTypeTypingError<T>(fieldName: String, pos: PosRange): T {
    error(
      Array[
        (pos, `Unbound field: ${fieldName}`),
        (
          pos,
          "Possible options are:\n" +
            this.fields.toArray().map(x -> x.name).join("\n"),
        ),
      ],
    )
  }

  fun getType(
    subst: mutable Subst,
    tenv: TEnv,
    fieldName: String,
    pos: PosRange,
    isLValue: Bool = false,
  ): TType {
    this.maybeGetType(subst, tenv, fieldName, pos, isLValue) match {
    | None() -> this.getTypeTypingError(fieldName, pos)
    | Some(ty) -> ty
    }
  }

  // Returns None() if the field already exist
  fun addField(fieldToAdd: TField): ?TFields {
    if (this.fields.containsKey(fieldToAdd.name)) None() else {
      Some(
        this with {
          fields => this.fields.union(
            InternalKeyedArrayMap::single(fieldToAdd),
          ),
        },
      )
    }
  }

  fun addSymbolField(fieldToAdd: TField): ?TFields {
    if (this.symbolFields.containsKey(fieldToAdd.name)) None() else {
      Some(
        this with {
          symbolFields => this.symbolFields.union(
            InternalKeyedArrayMap::single(fieldToAdd),
          ),
        },
      )
    }
  }

  fun filterSymbolFields(f: TField -> Bool): TFields {
    this with {symbolFields => this.symbolFields.filterKeyed(f)}
  }

  fun removeFields(fieldsToRemove: SortedSet<String>): TFields {
    if (fieldsToRemove.isEmpty()) this else {
      // TODO: better approximation of removing fields that may intersect with indexes
      this with {
        fields => this.fields.filterKeyed(field ->
          !fieldsToRemove.contains(field.name.value)
        ),
      }
    }
  }

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintFields(subst, tenv, this)
  }
}

class STypes private (
  private stypes: InternalKeyedArrayMap<STypeTag, SType>,
) extends Sequence<SType> uses XXHashable, Orderable {
  static fun empty(): STypes {
    STypes(InternalKeyedArrayMap::empty())
  }

  static fun single(x: SType): STypes {
    STypes(InternalKeyedArrayMap::single(x))
  }

  fun mapSTypes(f: SType -> SType): STypes {
    STypes(this.stypes.mapKeyed(f))
  }

  fun filterSTypes(f: SType -> Bool): STypes {
    STypes(this.stypes.filterKeyed(f))
  }

  fun filterMap(f: SType -> ?SType): STypes {
    STypes(this.stypes.filterMap(f))
  }

  fun isEmpty(): Bool {
    this.stypes.isEmpty()
  }

  fun size(): Int {
    this.stypes.size()
  }

  fun items(): mutable Iterator<(Int, SType)> {
    this.stypes.items()
  }

  fun values(): mutable Iterator<SType> {
    this.stypes.values()
  }

  fun any(f: SType -> Bool): Bool {
    this.stypes.any(f)
  }

  fun all(f: SType -> Bool): Bool {
    this.stypes.all(f)
  }

  fun singleElt(): ?SType {
    if (this.stypes.size() == 1) this.stypes.minimum() else None()
  }

  fun getConstantString(): ?PrimLiteral {
    this.singleElt() match {
    | Some(TPrimValue(TString(), Some(lits), _)) -> lits.singleElt()
    | _ -> None()
    }
  }

  fun getSingleConstant(): ?TPrim {
    this.singleElt().flatMap(stype ->
      stype match {
      | prim @ TPrimValue(_, Some(lits), _) if (lits.size() == 1) -> Some(prim)
      | prim @ TPrimUnit _ -> Some(prim)
      | _ -> None()
      }
    )
  }

  fun getSingleTuple(subst: mutable Subst, tenv: TEnv): ?Array<TType> {
    this.singleElt() match {
    | Some(obj @ TObject _) -> obj.asTuple(subst, tenv)
    | _ -> None()
    }
  }

  fun staticValue(): ?String {
    this.singleElt() match {
    | Some(TPrimValue(_, Some(lits), _)) -> lits.singleElt().map(lit -> lit.val)
    | _ -> None()
    }
  }

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintSTypes(subst, tenv, this)
  }
}

/* Type variable */
//
// Introduced:
// - for local variables
// - when instantiating a generic type or a function
//
// Interpretation:
// 〚 tvar 〛 = more or less* subst[tvar.id] ⨅ 〚 tvar.constraints 〛
// 〚 constraints 〛 = ⨅ 〚 c 〛 for c in constraints
//
// *see Subst#get
base class TVarID private final (
  value: Int,
) uses Orderable, XXHashable, Hashable {
  children =
  // A normal type variable identifier
  | TVID
  // A type variable that was introduced to infer the type of a field
  // in a literal object.
  | TVIDForField

  static fun create(id: Int): TVarID {
    TVID(id)
  }

  static fun createForField(id: Int): TVarID {
    TVIDForField(id)
  }

  fun toString(): String {
    this.value.toString()
  }

  fun isForField(): Bool
  | TVIDForField _ -> true
  | TVID _ -> false

  fun xxhash(): XXHash {
    XXHash(this.value)
  }
}

base class TVarOrigin {
  children =
  | FromGenericCall(PosRange, Array<TVar>)
  | FromGenericInst(PosRange, Array<TVar>)
  | FromArrayLiteral(PosRange)
  | FromEmptyArray(PosRange)
  | FromAsyncReturn(PosRange)
  | FromLambdaReturn(PosRange)
  | FromNullLiteral(PosRange)
  | FromUndefinedLiteral(PosRange)
  | FromObjectField(PosRange)
  | FromSyntheticIndex(PosRange)
  | FromArrayElement(PosRange)
  | FromUntypedVar(PosRange)
}

class TVar private (
  pos: PosRange,
  id: TVarID,
  constraints: SortedSet<TType>,
) extends TInst {
  static fun create(pos: PosRange, id: TVarID): TVar {
    TVar(pos, id, SortedSet[])
  }

  fun isForField(): Bool {
    this.id.isForField()
  }

  fun setConstraint(ty: TType): TVar {
    !this.constraints = this.constraints.set(ty);
    this
  }

  fun mapConstraints(f: TType -> TType): TVar {
    !this.constraints = this.constraints.map(f);
    this
  }
  fun xxhash(): XXHash {
    XXHash(
      this.constraints.iterator().foldl(
        (seed, t) -> {
          XXHash64.xxHash64(seed, t.xxhash().value)
        },
        XXHash64.xxHash64(this.id.xxhash().value, this.pos.xxhash().value),
      ),
    )
  }
}

/* Array literal with delayed typing.
 * Invariant: tupleElts must be non-empty (empty array literals are handled separately). */
class TArrayLit(tvar: TVar, tupleElts: Array<TType>) extends TInst {}

/* Unexpanded named type */
// possibly with type arguments
class TSInst(name: Name, targs: TArgs) extends TInst {}

class TArgs(targs: Array<TType>) uses XXHashable, Hashable, Orderable

base class TInst uses XXHashable, Hashable, Orderable

/* "Instance"/Unexpanded types */
//
// Interpretation:
// 〚 tinsts 〛 = ⨆ 〚 inst 〛, for inst in tinsts.insts
class TInsts private (
  insts: ArraySet<TInst>,
) extends Sequence<TInst> uses XXHashable, Orderable {
  static fun empty(): TInsts {
    TInsts(ArraySet::empty())
  }

  static fun single(inst: TInst): TInsts {
    TInsts(ArraySet::single(inst))
  }

  static fun createFromMVector(insts: mutable Vector<TInst>): this {
    static(ArraySet::createFromMVector(insts))
  }

  fun mapInsts(f: TInst -> TInst): TInsts {
    TInsts(this.insts.mapToSet(f))
  }

  fun filterMap(
    f: TInst -> Result<TInst, TType>,
  ): (TInsts, readonly Vector<Clauses>) {
    insts = mutable Vector[];
    extraClauses = mutable Vector[];
    for (inst in this.insts) {
      f(inst) match {
      | Success(i) -> insts.push(i)
      | Failure(t) ->
        insts.extend(t.insts);
        extraClauses.push(t.clauses)
      }
    };
    (TInsts(ArraySet::createFromMVector(insts)), extraClauses)
  }

  fun size(): Int {
    this.insts.size()
  }

  fun isEmpty(): Bool {
    this.insts.isEmpty()
  }

  fun values(): mutable Iterator<TInst> {
    this.insts.values()
  }

  fun items(): mutable Iterator<(Int, TInst)> {
    this.insts.items()
  }

  fun getUnique(): ?TInst {
    this.insts.getUnique()
  }

  fun getSingleInter(): ?TInter {
    this.getUnique() match {
    | Some(inter @ TInter _) -> Some(inter)
    | _ -> None()
    }
  }

  fun getSingleVar(): ?TVar {
    this.getUnique() match {
    | Some(var @ TVar _) -> Some(var)
    | _ -> None()
    }
  }

  fun getSingleArrayLit(): ?TArrayLit {
    this.getUnique() match {
    | Some(arrLit @ TArrayLit _) -> Some(arrLit)
    | _ -> None()
    }
  }

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintTInsts(subst, tenv, this)
  }
}

value class Id private (id: String) uses XXHashable, Orderable, Show {
  static fun create(name: String, id: Int, lexer: readonly Lexer): Id {
    Id(`${name}:${id}:${lexer.relativeFileNameHash}`)
  }

  fun prefixWith(pre: String): Id {
    Id(pre + this.id)
  }

  static fun createThis(): Id {
    Id("this")
  }

  static fun createSynthetic(id: String): Id {
    Id(`synthetic:${id}`)
  }

  fun toString(): String {
    this.id
  }
}

class TParamWithConstraint(
  name: String,
  fileName: FPath,
  id: Id,
  cstr: ?TType,
) uses XXHashable, Orderable {
  //
  fun withoutConstraint(): TParam {
    TParam(this.name, this.fileName, this.id)
  }
}

class TParam(name: String, fileName: FPath, id: Id) uses XXHashable, Orderable

/* Clause */
//
// Interpretation:
// 〚 clause 〛 = 〚 clause.vars 〛 ⨅ 〚 clause.stypes 〛
// 〚 vars 〛 = ⨅ 〚 v 〛, for v in vars
// 〚 stypes 〛 = Top     if stypes is None
//              〚 st 〛  if stypes = Some(st)
//                \-->  see STypes, this is a union
//
// In particular, Clause(ArraySet[], None()) represents ⊤
//                Clause(_, Some(STypes::empty())) represents ⊥
class Clause private (
  vars: ArraySet<TParam>,
  stypes: ?STypes,
) uses XXHashable, Orderable, Projectable<ArraySet<TParam>> {
  /* Invariant: Clause cannot be bottom */

  // Returns None if the result is bottom (i.e. if stypes is Some(bottom))
  static fun create(vars: ArraySet<TParam>, stypes: ?STypes): ?Clause {
    stypes match {
    | Some(s) if (s.isEmpty()) -> None()
    | _ -> Some(Clause(vars, stypes))
    }
  }

  // Returns None if the result is bottom (i.e. if stypes is bottom)
  static fun fromSTypes(stypes: STypes): ?Clause {
    Clause::create(ArraySet::empty(), Some(stypes))
  }

  static fun undefined(pos: PosRange): Clause {
    Clause(
      ArraySet::empty(),
      Some(STypes::single(TPrimUnit(TUndefined(), pos))),
    )
  }

  static fun top(): Clause {
    Clause(ArraySet::empty(), None())
  }

  // Returns None if the result is bottom
  fun map_(
    fVars: ArraySet<TParam> -> ArraySet<TParam>,
    fSTypesOpt: (?STypes) -> ?STypes,
  ): ?Clause {
    fSTypesOpt(this.stypes) match {
    | Some(sTypes) if (sTypes.isEmpty()) -> None()
    | sTypes -> Some(Clause(fVars(this.vars), sTypes))
    }
  }

  // Returns None if the result is bottom
  fun map(
    fTParam: TParam -> TParam,
    fSTypesOpt: (?STypes) -> ?STypes,
  ): ?Clause {
    this.map_(vars -> vars.mapToSet(fTParam), fSTypesOpt)
  }

  // t.mapSTypes(f) is t with stypes updated by f
  // Returns None if the result is bottom
  fun mapSTypes(f: (?STypes) -> ?STypes): ?Clause {
    this.map_(vars -> vars, f)
  }

  fun getConstantString(): ?PrimLiteral {
    this.stypes.flatMap(sTypes -> sTypes.getConstantString())
  }

  fun getSingleConstant(): ?TPrim {
    this.stypes.flatMap(sTypes -> sTypes.getSingleConstant())
  }

  fun isTop(): Bool {
    this.stypes is None() && this.vars.isEmpty()
  }

  fun project(): ArraySet<TParam> {
    this.vars
  }

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintClause(subst, tenv, this)
  }
}

/* Clauses: type parameters and simple types in DNF */
//
// Interpretation:
// 〚 clauses 〛 = ⨆ 〚 c 〛, for c in clauses.clauses
class Clauses private (
  clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
) extends Sequence<Clause> uses XXHashable, Orderable {
  /*
    Invariant: if one of the clauses is Top, then there are no other clauses
   */
  private static fun create(
    clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,
  ): Clauses {
    if (clauses.any(c -> c.isTop())) Clauses::top() else Clauses(clauses)
  }

  static fun empty(): Clauses {
    Clauses(InternalKeyedArrayMap::empty())
  }

  static fun top(): Clauses {
    Clauses(InternalKeyedArrayMap::single(Clause::top()))
  }

  fun filterMap(f: Clause -> ?Clause): Clauses {
    Clauses::create(
      InternalKeyedArrayMap::createFromIterator(
        this.clauses.values().filterMap(f),
      ),
    )
  }

  fun size(): Int {
    this.clauses.size()
  }

  fun isEmpty(): Bool {
    this.clauses.isEmpty()
  }

  fun isTop(): Bool {
    this.clauses.singleElt() match {
    | None() -> false
    | Some(clause) -> clause.isTop()
    }
  }

  static fun singleClause(clause: Clause): Clauses {
    Clauses(InternalKeyedArrayMap::single(clause))
  }

  static fun single(tparam: TParam): Clauses {
    Clause::create(ArraySet::single(tparam), None()) match {
    | None() -> Clauses::empty()
    | Some(clause) -> Clauses(InternalKeyedArrayMap::single(clause))
    }
  }

  static fun fromSTypes(stypes: STypes): Clauses {
    Clause::fromSTypes(stypes) match {
    | None() -> Clauses::empty()
    | Some(clause) -> Clauses(InternalKeyedArrayMap::single(clause))
    }
  }

  fun getConstantString(): ?PrimLiteral {
    this.clauses.singleElt().flatMap(clause -> clause.getConstantString())
  }

  fun getSingleConstant(): ?TPrim {
    this.clauses.singleElt().flatMap(clause -> clause.getSingleConstant())
  }

  // Returns the tuple if clauses is a single clause whose only stype is a Tuple.
  fun getSingleTuple(subst: mutable Subst, tenv: TEnv): ?Array<TType> {
    this.clauses.singleElt().flatMap(clause ->
      clause.stypes.flatMap(sTypes -> sTypes.getSingleTuple(subst, tenv))
    )
  }

  // t.mapSTypes(f) is t with stypes updated by f
  fun mapSTypes(f: (?STypes) -> ?STypes): Clauses {
    Clauses::create(this.clauses.filterMap(clause -> clause.mapSTypes(f)))
  }

  // Returns the actual STypes, forgetting type parameters,
  // so the return value over-approximates the type
  // Returns None() if the type eventually expands to Top
  fun getSTypes(subst: mutable Subst, tenv: TEnv): ?STypes {
    result = STypes::empty();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(clauseSTypes) ->
        !result = STypes::union(subst, tenv, result, clauseSTypes)
      }
    };
    Some(result)
  }

  fun primKind(): ?Name {
    cand: ?TPrimValue = None();
    for (clause in this.clauses) {
      clause.stypes match {
      | None() -> return None()
      | Some(stypes) ->
        for (stype in stypes) {
          (stype, cand) match {
          | (prim @ TPrimValue _, None()) -> !cand = Some(prim)
          | (
            TPrimValue(kind, _, _),
            Some(TPrimValue(candKind, _, _)),
          ) if (kind == candKind) ->
            void
          | _ -> return None()
          }
        }
      }
    };
    cand.map(prim -> prim.asClassName())
  }

  fun getObject(): ?TObject {
    this.clauses.singleElt().flatMap(clause ->
      clause.stypes.flatMap(stypes -> {
        stypes.singleElt() match {
        | Some(obj @ TObject _) -> Some(obj)
        | _ -> None()
        }
      })
    )
  }

  fun any(f: Clause -> Bool): Bool {
    this.clauses.any(f)
  }

  fun values(): mutable Iterator<Clause> {
    this.clauses.values()
  }

  fun toString(subst: mutable Subst, tenv: TEnv): String {
    prettyPrintClauses(subst, tenv, this)
  }
}

module end;
