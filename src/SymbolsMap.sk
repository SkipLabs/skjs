/***************************************************************************/
// Module resolving Symbols.
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Symbols directory. */
/***************************************************************************/

class SymbolsFile(symbols: Map<SymbolicPos, Int>) extends SKStore.File

fun makeSymbolsDir(
  context: mutable SKStore.Context,
  parsedFiles: SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>,
): SKStore.EHandle<SKStore.SID, SymbolsFile> {
  parsedFiles.map(
    SKStore.SID::keyType,
    SymbolsFile::type,
    context,
    SKStore.DirName::create("/skjs/symbols/"),
    (_context, writer, fileName, values) ~> {
      writer.set(
        SKStore.SID(fileName.toString()),
        SymbolsFile(values.first.symbols),
      )
    },
  )
}

/***************************************************************************/
/* Symbols map (associates Symbols to a filename) */
/***************************************************************************/

class SymbolsMap{dir: SKStore.EHandle<SKStore.SID, SymbolsFile>} {
  static fun create(
    context: mutable SKStore.Context,
    parsedFiles: SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>,
  ): this {
    static{dir => makeSymbolsDir(context, parsedFiles)}
  }
  fun get(
    context: mutable SKStore.Context,
    fileName: String,
  ): Map<SymbolicPos, Int> {
    this.dir.get(context, SKStore.SID(fileName)).symbols
  }
}

module end;
