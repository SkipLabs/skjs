/***************************************************************************/
// Module resolving Symbols.
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Symbols directory. */
/***************************************************************************/

class SymbolsFile(symbols: Map<SymbolicPos, Int>) extends SKStore.File

fun makeSymbolsDir(
  context: mutable SKStore.Context,
  parsedFiles: SKStore.EHandle<FPath, ParsedResultAndSymbolsFile>,
): SKStore.EHandle<FPath, SymbolsFile> {
  parsedFiles.map(
    FPath::keyType,
    SymbolsFile::type,
    context,
    SKStore.DirName::create("/skjs/symbols/"),
    (_context, writer, fileName, values) ~> {
      writer.set(fileName, SymbolsFile(values.first.symbols))
    },
  )
}

/***************************************************************************/
/* Symbols map (associates Symbols to a filename) */
/***************************************************************************/

class SymbolsMap{dir: SKStore.EHandle<FPath, SymbolsFile>} {
  static fun create(
    context: mutable SKStore.Context,
    parsedFiles: SKStore.EHandle<FPath, ParsedResultAndSymbolsFile>,
  ): this {
    static{dir => makeSymbolsDir(context, parsedFiles)}
  }
  fun get(
    context: mutable SKStore.Context,
    fileName: FPath,
  ): Map<SymbolicPos, Int> {
    this.dir.get(context, fileName).symbols
  }
}

/***************************************************************************/
/* Body maps (one per def kind) */
/***************************************************************************/

class FunDefSigMapKey(value: FunDefRef) extends SKStore.Key
class FunDefSigMapFile(value: FunDefSigData) extends SKStore.File

class FunDefSigMap{dir: SKStore.EHandle<FunDefSigMapKey, FunDefSigMapFile>} {
  static fun create(
    context: mutable SKStore.Context,
    parsedFiles: SKStore.EHandle<FPath, ParsedResultAndSymbolsFile>,
  ): this {
    static{
      dir => parsedFiles.map(
        FunDefSigMapKey::keyType,
        FunDefSigMapFile::type,
        context,
        SKStore.DirName::create("/skjs/bodies/funsig/"),
        (_context, writer, _fileName, values) ~> {
          for (ref => data in values.first.funDefSigs) {
            writer.set(FunDefSigMapKey(ref), FunDefSigMapFile(data))
          }
        },
      ),
    }
  }
  fun get(context: mutable SKStore.Context, key: FunDefRef): FunDefSigData {
    this.dir.get(context, FunDefSigMapKey(key)).value
  }
}

