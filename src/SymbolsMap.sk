/***************************************************************************/
// Module resolving Symbols.
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Symbols directory. */
/***************************************************************************/

class SymbolsFile(symbols: Map<SymbolicPos, Int>) extends SKStore.File

fun makeSymbolsDir(
  context: mutable SKStore.Context,
  parsedFiles: SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>,
): SKStore.EHandle<FAbsolute, SymbolsFile> {
  parsedFiles.map(
    FAbsolute::keyType,
    SymbolsFile::type,
    context,
    SKStore.DirName::create("/skjs/symbols/"),
    (_context, writer, fileName, values) ~> {
      writer.set(fileName, SymbolsFile(values.first.symbols))
    },
  )
}

/***************************************************************************/
/* Symbols map (associates Symbols to a filename) */
/***************************************************************************/

class SymbolsMap{dir: SKStore.EHandle<FAbsolute, SymbolsFile>} {
  static fun create(
    context: mutable SKStore.Context,
    parsedFiles: SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>,
  ): this {
    static{dir => makeSymbolsDir(context, parsedFiles)}
  }
  fun get(
    context: mutable SKStore.Context,
    fileName: String,
  ): Map<SymbolicPos, Int> {
    this.dir.get(context, FAbsolute::create(fileName)).symbols
  }
}

module end;
