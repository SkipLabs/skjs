/***************************************************************************/
/* Typing Errors */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Error Detail Configuration */
/***************************************************************************/

// A single error detail specification with optional file/line filter
class ErrorDetailSpec(
  filePattern: ?String, // None = applies to all files, Some = specific file pattern
  line: ?Int, // None = applies to all lines, Some = specific line
  detail: STErrorDetail,
) {
  // Check if this spec matches the given file and line
  fun matches(fileName: String, lineNum: Int): Bool {
    fileMatches = this.filePattern match {
    | None() -> true
    | Some(pattern) ->
      fileName.contains(pattern) // Simple contains for now
    };
    lineMatches = this.line match {
    | None() -> true
    | Some(l) -> l == lineNum
    };
    fileMatches && lineMatches
  }

  // Return specificity score (higher = more specific)
  // Used to determine which spec wins when multiple match
  fun specificity(): Int {
    fileScore = if (this.filePattern.isSome()) 2 else 0;
    lineScore = if (this.line.isSome()) 1 else 0;
    fileScore + lineScore
  }
}

// Configuration for error detail levels across the codebase
class ErrorDetailConfig(specs: Array<ErrorDetailSpec>) {
  // Get the appropriate STErrorDetail for a given file and line
  fun getDetail(fileName: String, lineNum: Int): STErrorDetail {
    // Find all matching specs
    matchingSpecs = this.specs.filter(spec -> spec.matches(fileName, lineNum));

    // If no specs match, use default
    if (matchingSpecs.isEmpty()) {
      return STErrorDetail(1, 0, false)
    };

    // Return the most specific matching spec
    bestSpec = matchingSpecs.reduce(
      (best, current) -> {
        if (current.specificity() > best.specificity()) {
          current
        } else {
          best
        }
      },
      matchingSpecs[0],
    );
    bestSpec.detail
  }

  static fun default(): ErrorDetailConfig {
    ErrorDetailConfig(Array[])
  }
}

class TypingError(
  messages: Array<(PosRange, String)>,
  stErr: ?(STError<TType>, PosRange, PosRange),
) extends Error {
  fun toString(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
    errorDetailConfig: ErrorDetailConfig = ErrorDetailConfig::default(),
  ): String {
    result = mutable Vector[];
    messages = this.messages;
    this.stErr match {
    | Some((e, pos1, pos2)) ->
      // Get the appropriate detail level based on error location
      detail = if (this.messages.isEmpty()) {
        // Fallback to default when no message position available
        STErrorDetail(1, 0, false)
      } else {
        firstPos = this.messages[0].i0;
        fileName = firstPos.fileName.toString();
        resolver = static::resolver(
          firstPos.fileName,
          context,
          newLinesMap,
          symbolsMap,
        );
        relPos = resolver.relPosRange(firstPos);
        errorDetailConfig.getDetail(fileName, relPos.start.line)
      };
      !messages = messages.concat(e.toError(pos1, pos2, detail).toArray())
    | None() -> void
    };
    for (message in messages) {
      pos = message.i0;
      fileName = pos.fileName;
      resolver = static::resolver(fileName, context, newLinesMap, symbolsMap);
      result.push(resolver.relPosRange(message.i0).toString());
      result.push(message.i1);
    };
    result.join("\n")
  }
}

fun typingError<T>(
  messages: Array<(PosRange, String)>,
  stErr: ?(STError<TType>, PosRange, PosRange) = None(),
): T {
  throw ErrorExn(TypingError(messages, stErr))
}

fun notSupported<T>(pos: PosRange, what: String): T {
  typingError(Array[(pos, `Construction not supported: ${what}`)])
}

module end;
