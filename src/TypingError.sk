/***************************************************************************/
/* Typing Errors */
/***************************************************************************/

module SKJS;

class TypingError(messages: Array<(PosRange, String)>) extends Error {
  fun toString(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): String {
    result = mutable Vector[];
    for (message in this.messages) {
      pos = message.i0;
      fileName = pos.fileName;
      resolver = static::resolver(fileName, context, newLinesMap, symbolsMap);
      result.push(resolver.relPosRange(message.i0).toString());
      result.push(message.i1);
    };
    result.join("\n")
  }
}

fun typingError<T>(messages: Array<(PosRange, String)>): T {
  throw ErrorExn(TypingError(messages))
}

fun notSupported<T>(pos: PosRange, what: String = ""): T {
  message = if (what == "") "Construction not supported" else {
    `Construction not supported: ${what}`
  };
  typingError(Array[(pos, message)])
}

class TypingErrors(errors: Array<TypingError>) extends .Exception

mutable class TypingErrorCollection(
  keepGoing: Bool,
  private typingErrors: mutable Vector<TypingError> = mutable Vector[],
) {
  mutable fun push(messages: Array<(PosRange, String)>): void {
    if (this.keepGoing) {
      this.typingErrors.push(TypingError(messages))
    } else {
      typingError(messages)
    }
  }

  mutable fun collect(f: () -> void): void {
    if (this.keepGoing) {
      try {
        f()
      } catch {
      | ErrorExn(err @ TypingError _) -> this.typingErrors.push(err)
      | TypingErrors(errs) -> this.typingErrors.extend(errs)
      | exn -> throw exn
      }
    } else {
      f()
    }
  }

  mutable fun emit(): void {
    if (!this.typingErrors.isEmpty()) {
      exn = TypingErrors(this.typingErrors.toArray());
      this.typingErrors.clear();
      throw exn
    }
  }
}

module end;
