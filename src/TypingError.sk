/***************************************************************************/
/* Typing Errors */
/***************************************************************************/

module SKJS;

class TypingError(
  messages: Array<(PosRange, String)>,
  stErr: ?(STError<TType>, PosRange, PosRange),
) extends Error {
  fun toString(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): String {
    result = mutable Vector[];
    messages = this.messages;
    this.stErr match {
    | Some((e, pos1, pos2)) ->
      !messages = messages.concat(
        e.toError(pos1, pos2, STErrorDetail(2, 2, true)).toArray(),
      )
    | None() -> void
    };
    for (message in messages) {
      pos = message.i0;
      fileName = pos.fileName;
      resolver = static::resolver(fileName, context, newLinesMap, symbolsMap);
      result.push(resolver.relPosRange(message.i0).toString());
      result.push(message.i1);
    };
    result.join("\n")
  }
}

fun typingError<T>(
  messages: Array<(PosRange, String)>,
  stErr: ?(STError<TType>, PosRange, PosRange) = None(),
): T {
  throw ErrorExn(TypingError(messages, stErr))
}

fun notSupported<T>(pos: PosRange, what: String): T {
  typingError(Array[(pos, `Construction not supported: ${what}`)])
}

module end;
