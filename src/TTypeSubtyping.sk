/***************************************************************************/
// Subtyping operations for types.
/***************************************************************************/

module SKJS;

/* Result for a check of subtyping of types T1 and T2 */
base class STResult<+T>

/* T1 ⊑ T2 */
class STOk<+T>() extends STResult<T>

/* All other cases: T1 ⋢ T2 */
base class STError<+T> extends STResult<T> {
  fun toError(
    _pos: PosRange,
    _subst: mutable Subst,
    _tenv: TEnv,
  ): List<(PosRange, String)>;
}

class STMissing<+T>() extends STError<T> {
  fun toError(
    pos: PosRange,
    _subst: mutable Subst,
    _tenv: TEnv,
  ): List<(PosRange, String)> {
    List[(pos, "Missing")]
  }
}

base class STErrorOnSType extends STError<SType> {
  children =
  | STTooManySType(SType)

  fun toError(
    _pos: PosRange,
    _subst: mutable Subst,
    _tenv: TEnv,
  ): List<(PosRange, String)>
  | STTooManySType(sty) ->
    msg = sty match {
    | TPrimUnit(kind, _) -> `This is a ${kind}`
    | TPrimValue(TString(), None(), _) ->
      "This is of type string. " +
        "Use 'as const' to create a string literal type, for example: \"foo\" as const or 'foo' as const."
    | TPrimValue(kind, None(), _) -> `This is of type ${kind}`
    | TPrimValue(kind, Some(x), _) ->
      `This is a static ${kind}: ` + x.toStringList(true)

    | TPromise _ -> "This is a Promise"
    | TAlgebraic _ ->
      "This is a constructor (the field kind is a static string)"
    | TObject _ -> "This is an object"
    | TTuple(tuple, _) -> "This is a tuple of size " + tuple.size()
    };
    List[(sty.pos, msg)]
}

base class STErrorOnTTuple extends STError<TTuple> {
  children =
  | STTooManyTTuple(TTuple)
  | STRecTuple(TTuple, TTuple, Int, STError<TType>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STTooManyTTuple(tuple) ->
    List[(tuple.pos, `This is a tuple of size ${tuple.tuple.size()}`)]
  | STRecTuple(_tup1, _tup2, _i, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnTPromise extends STError<TPromise> {
  children =
  | STRecPromise(TPromise, TPromise, STError<TType>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STRecPromise(_p1, _p2, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnObject extends STError<TObject> {
  children =
  | STRecObject(TObject, TObject, STError<TFields>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STRecObject(_o1, _o2, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnSTypes extends STError<STypes> {
  children =
  | STRecSTypes(STypes, STypes, STError<SType>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STRecSTypes(_stypes1, _stypes2, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnClauses extends STError<Clauses> {
  children =
  | STRecClauses(Clauses, Clauses, Clause, List<(Clause, STError<STypes>)>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)> {
    this match {
    | STRecClauses(
      _clauses1,
      _clauses2,
      _inter1,
      List.Cons((_inter2, err), List.Nil()),
    ) ->
      err.toError(pos, subst, tenv)
    | STRecClauses(_clauses1, _clauses2, inter1, _) ->
      List[(pos, "This is of type " + prettyPrintClause(inter1))]
    }
  }
}

base class STErrorOnTType extends STError<TType> {
  children =
  | STRecType(TType, TType, STError<Clauses>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STRecType(_ty1, _ty2, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnTFuns extends STError<TFuns> {
  children =
  | STRecTFuns(TFuns, TFuns, STError<TFun>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STRecTFuns(_f1, _f2, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnTFun extends STError<TFun> {
  children =
  | STTypeParameterMismatch()
  | STInvalidSpread(ArrayType)
  | STRecFunTParam(TFun, TFun, Int, STError<TType>)
  | STRecFunThisParam(TFun, TFun, STError<TType>)
  | STRecFunParam(TFun, TFun, Int, STError<TType>)
  | STRecFunOptionalSpread(TFun, TFun, Int, STError<TType>)
  | STRecFunSpread(TFun, TFun, STError<TType>)
  | STRecFunReturn(TFun, TFun, STError<TType>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)> {
    this match {
    | STRecFunTParam(_f1, _f2, _i, STMissing()) ->
      List[(pos, "This type parameter does not define a constraint")]
    | STRecFunThisParam(_f1, _f2, STMissing()) ->
      List[(pos, "Missing this parameter")]
    | STRecFunParam(_f1, _f2, _i, STMissing()) ->
      List[(pos, "Missing parameter")]
    | STRecFunSpread(_f1, _f2, STMissing()) ->
      List[(pos, "Missing ... parameter")]
    | STTypeParameterMismatch() -> List[(pos, "Type parameter mismatch")]
    | STInvalidSpread(spread) -> List[(pos, `Invalid spread type: ${spread}`)]
    | STRecFunTParam(_f1, _f2, _i, err)
    | STRecFunThisParam(_f1, _f2, err)
    | STRecFunParam(_f1, _f2, _i, err)
    | STRecFunOptionalSpread(_f1, _f2, _i, err)
    | STRecFunSpread(_f1, _f2, err)
    | STRecFunReturn(_f1, _f2, err) ->
      err.toError(pos, subst, tenv)
    }
  }
}

base class STErrorOnTAlgebraic extends STError<TAlgebraic> {
  children =
  | STTooManyTConstr(TConstr)
  | STRecAlgebraicOnBranch(
    TAlgebraic,
    TAlgebraic,
    tag: String,
    STError<TConstr>,
  )

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STTooManyTConstr(constr) -> List[(constr.tagPos, "This is a constructor")]
  | STRecAlgebraicOnBranch(_a1, _a2, _tag, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnTContr extends STError<TConstr> {
  children =
  | STRecConstr(TConstr, TConstr, STError<TFields>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)>
  | STRecConstr(_c1, _c2, err) -> err.toError(pos, subst, tenv)
}

base class STErrorOnTFields extends STError<TFields> {
  children =
  | STRecFieldsCall(TFields, TFields, STError<TFuns>)
  | STRecFieldsNew(TFields, TFields, STError<TFuns>)
  | STRecFieldsIndexKey(
    TFields,
    TFields,
    TIndexField,
    TIndexField,
    STError<TType>,
  )
  | STRecFieldsIndexValue(
    TFields,
    TFields,
    TIndexField,
    TIndexField,
    STError<TType>,
  )
  | STRecFieldsFieldIndex(TFields, TFields, TField, TIndexField, STError<TType>)
  | STRecFieldsIndexField(TFields, TFields, TIndexField, TField, STError<TType>)
  | STRecFieldsField(TFields, TFields, String, STError<TType>)

  fun toError(
    pos: PosRange,
    subst: mutable Subst,
    tenv: TEnv,
  ): List<(PosRange, String)> {
    this match {
    | STRecFieldsCall(_fields1, _fields2_, STMissing()) ->
      List[(pos, "Missing call signature")]
    | STRecFieldsNew(_fields1, _fields2, STMissing()) ->
      List[(pos, "Missing constructor")]
    | STRecFieldsField(_fields1, _fields2, fieldName, STMissing()) ->
      List[(pos, `The field '${fieldName}' is missing`)]
    | STRecFieldsCall(_fields1, _fields2, err)
    | STRecFieldsNew(_fields1, _fields2, err) ->
      err.toError(pos, subst, tenv)
    | STRecFieldsIndexKey(_fields1, _fields2, _index1, _index2, err)
    | STRecFieldsIndexValue(_fields1, _fields2, _index1, _index2, err)
    | STRecFieldsFieldIndex(_fields1, _fields2, _field1, _index2, err)
    | STRecFieldsIndexField(_fields1, _fields2, _index1, _field2, err)
    | STRecFieldsField(_fields1, _fields2, _fieldName, err) ->
      err.toError(pos, subst, tenv)
    }
  }
}

extension class TAlgebraic {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    a1: TAlgebraic,
    a2: TAlgebraic,
  ): STResult<TAlgebraic> {
    a1.branches.leq(a2.branches, (b1, b2O) ->
      b2O match {
      | Some(b2) ->
        TConstr::isSub(subst, tenv, b1, b2) match {
        | STOk() -> Success(void)
        | err @ STError _ ->
          Failure(STRecAlgebraicOnBranch(a1, a2, b1.tag, err))
        }
      | None() -> Failure(STTooManyTConstr(b1))
      }
    ) match {
    | Success(void) -> STOk()
    | Failure(err) -> err
    }
  }
}

extension class TConstr {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    x: TConstr,
    y: TConstr,
  ): STResult<TConstr> {
    if (x.tag != y.tag) {
      invariant_violation(`TConstr::isSub called on tags ${x.tag} != ${y.tag}`)
    };
    TFields::isSub(subst, tenv, x.fields, y.fields) match {
    | STOk() -> STOk()
    | err @ STError _ -> STRecConstr(x, y, err)
    }
  }
}

extension class TFuns {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    funs1: TFuns,
    funs2: TFuns,
  ): STResult<TFuns> {
    TFun::isSub(subst, tenv, funs1.fun_, funs2.fun_) match {
    | STOk() -> STOk()
    | err @ STError _ -> STRecTFuns(funs1, funs2, err)
    }
  }
}

extension class TFields {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): STResult<TFields> {
    TFields::isSubOptTFuns(subst, tenv, fields1.call, fields2.call) match {
    | STOk() -> void
    | err @ STError _ -> return STRecFieldsCall(fields1, fields2, err)
    };
    TFields::isSubOptTFuns(subst, tenv, fields1.new, fields2.new) match {
    | STOk() -> void
    | err @ STError _ -> return STRecFieldsNew(fields1, fields2, err)
    };
    index1o = fields1.maybeSingleIndex();
    index2o = fields2.maybeSingleIndex();
    (index1o, index2o) match {
    | (_, None()) -> void
    | (Some(index1), Some(index2)) ->
      TType::isSub(subst, tenv, index2.keyType, index1.keyType) match {
      | err @ STError _ ->
        return STRecFieldsIndexKey(fields1, fields2, index1, index2, err)
      | STOk() -> void
      };
      TType::isSub(subst, tenv, index1.valueType, index2.valueType) match {
      | err @ STError _ ->
        return STRecFieldsIndexValue(fields1, fields2, index1, index2, err)
      | STOk() -> void
      }
    | (None(), Some(index2)) ->
      for (f1 in fields1.fields) {
        f1keyType = TType::single(
          TPrimValue::single(TString(), f1.name, f1.pos),
        );
        TType::isSub(subst.clone(), tenv, f1keyType, index2.keyType) match {
        | STError _ -> void
        | STOk() ->
          TType::isSub(subst, tenv, f1.type, index2.valueType) match {
          | err @ STError _ ->
            return STRecFieldsFieldIndex(fields1, fields2, f1, index2, err)
          | STOk() -> void
          }
        }
      }
    };
    for (ior in fields1.fields.iterDiffInterDiff(fields2.fields)) {
      ior match {
      | Left(_) -> void
      | Right(f2) ->
        if (!f2.isOptional) {
          return STRecFieldsField(fields1, fields2, f2.name, STMissing())
        };
        index1o match {
        | None() -> void
        | Some(index1) ->
          f2keyType = TType::single(
            TPrimValue::single(TString(), f2.name, f2.pos),
          );
          TType::isSub(subst.clone(), tenv, f2keyType, index1.keyType) match {
          | STError _ -> void
          | STOk() ->
            TType::isSub(subst, tenv, index1.valueType, f2.type) match {
            | err @ STError _ ->
              return STRecFieldsIndexField(fields1, fields2, index1, f2, err)
            | STOk() -> void
            }
          }
        }
      | Both(f1, f2) ->
        if (f1.isOptional && !f2.isOptional) {
          return STRecFieldsField(fields1, fields2, f1.name, STMissing())
        } else {
          f2type = if (f2.isOptional) {
            TType::unionUndefined(subst, tenv, f2.type, f2.pos)
          } else {
            f2.type
          };
          TType::isSub(subst, tenv, f1.type, f2type) match {
          | STOk() -> void
          | err @ STError _ ->
            return STRecFieldsField(fields1, fields2, f1.name, err)
          }
        }
      }
    };
    STOk()
  }

  static fun isSubOptTFuns(
    subst: mutable Subst,
    tenv: TEnv,
    f1opt: ?(Bool, TFuns),
    f2opt: ?(Bool, TFuns),
  ): STResult<TFuns> {
    (f1opt, f2opt) match {
    | (_, None())
    | (None(), Some((true, _))) ->
      STOk()
    | (None(), Some((false, _)))
    | (Some((true, _)), Some((false, _))) ->
      STMissing()
    | (Some((_opt1, call1)), Some((_opt2, call2))) ->
      TFuns::isSub(subst, tenv, call1, call2)
    }
  }
}

extension class STypes {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): STResult<STypes> {
    stypes1.stypes.leq(stypes2.stypes, (sty1, sty2O) ->
      sty2O match {
      | Some(sty2) ->
        invariant(
          sty1.tag() == sty2.tag(),
          "leq ensures iteration with identical tags",
        );
        (sty1, sty2) match {
        | (TPrimUnit _, TPrimUnit _) -> STOk()

        | (TPrimValue(_, None(), _), TPrimValue(_, None(), _)) -> STOk()
        | (TPrimValue(_, None(), _), TPrimValue(_, Some _, _)) ->
          STTooManySType(sty1)
        | (TPrimValue(_, Some _, _), TPrimValue(_, None(), _)) -> STOk()

        | (TPrimValue(k, Some(lits1), _), TPrimValue(_, Some(lits2), _)) ->
          for (elt in lits1.values()) {
            if (!lits2.contains(elt.val)) {
              break STTooManySType(
                TPrimValue(k, Some(PrimLiterals::single(elt)), elt.pos),
              )
            }
          } else {
            STOk()
          }

        | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
          TTuple::isSub(subst, tenv, tuple1, tuple2)

        | (p1 @ TPromise(ty1, _), p2 @ TPromise(ty2, _)) ->
          TType::isSub(subst, tenv, ty1, ty2) match {
          | STOk() -> STOk()
          | err @ STError _ -> STRecPromise(p1, p2, err)
          }
        | (obj1 @ TObject _, obj2 @ TObject _) ->
          TObject::isSub(subst, tenv, obj1, obj2)
        | (TAlgebraic _, TObject _)
        | (TObject _, TAlgebraic _) ->
          STTooManySType(sty1)
        | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->
          TAlgebraic::isSub(subst, tenv, a1, a2)
        | _ -> internal_error("Internal error")
        } match {
        | STOk() -> Success(void)
        | err @ STError _ -> Failure(err)
        }
      | None() -> Failure(STTooManySType(sty1))
      }
    ) match {
    | Success(void) -> STOk()
    | Failure(err) -> STRecSTypes(stypes1, stypes2, err)
    }
  }
}

extension class Clauses {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): STResult<Clauses> {
    for (inter1 in clauses1.clauses) {
      errors = List[];
      for (inter2 in clauses2.clauses) {
        if (!inter1.vars.contains(inter2.vars)) {
          continue;
        };
        (inter1.stypes, inter2.stypes) match {
        | (None(), None()) -> break void
        | (Some _, None()) -> break void
        | (None(), Some _) -> continue
        | (Some(x1), Some(x2)) ->
          STypes::isSub(subst, tenv, x1, x2) match {
          | STOk() -> break void
          | err @ STError _ ->
            !errors = List.Cons((inter2, err), errors);
            continue
          }
        }
      } else {
        return STRecClauses(clauses1, clauses2, inter1, errors)
      }
    };
    STOk()
  }
}

extension class TType {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    u1: TType,
    u2: TType,
  ): STResult<TType> {
    if (u1 == u2) return STOk();
    pair = (u1, u2);
    if (subst.seenSub.contains(pair)) return STOk();
    res = TType::isSub_(subst, tenv, u1, u2);
    if (res is STOk()) {
      subst.!seenSub = subst.seenSub.set(pair)
    };
    res
  }

  private static fun isSub_(
    subst: mutable Subst,
    tenv: TEnv,
    u1: TType,
    u2: TType,
  ): STResult<TType> {
    if (u2.isTop()) return STOk();
    if (tenv.seenSub.contains((subst.version, u1, u2))) return STOk();
    !tenv.seenSub = tenv.seenSub.set((subst.version, u1, u2));
    savedSubst = subst.save();
    for (inst in u2.insts) {
      inst match {
      | tvar @ TVar(_, _, constraints) ->
        substCopy = subst.save();
        if (
          constraints.all(cstr -> TType::isSub(subst, tenv, u1, cstr) is STOk())
        ) {
          subst.grow(tenv, tvar, TType::diff(u1, u2), Contravariant())
        } else {
          subst.restore(substCopy)
        }
      | _ -> void
      }
    };
    for (inst in u1.insts) {
      inst match {
      | tvar @ TVar(_, _, constraints) ->
        substCopy = subst.save();
        if (
          constraints.all(cstr -> TType::isSub(subst, tenv, u2, cstr) is STOk())
        ) {
          subst.grow(tenv, tvar, TType::diff(u2, u1), Covariant())
        } else {
          subst.restore(substCopy)
        }
      | _ -> void
      }
    };
    clauses1 = u1.expand_(subst, tenv, Covariant());
    clauses2 = u2.expand_(subst, tenv, Contravariant());
    Clauses::isSub(subst, tenv, clauses1, clauses2) match {
    | STOk() -> STOk()
    | err @ STError _ ->
      subst.restore(savedSubst);
      STRecType(u1, u2, err)
    }
  }
}

extension class TTuple {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    tuple1: TTuple,
    tuple2: TTuple,
  ): STResult<TTuple> {
    if (tuple1.tuple.size() < tuple2.tuple.size()) {
      return STTooManyTTuple(tuple1)
    };
    for (i in Range(0, tuple2.tuple.size())) {
      TType::isSub(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]) match {
      | STOk() -> void
      | err @ STError _ -> return STRecTuple(tuple1, tuple2, i, err)
      }
    };
    STOk()
  }
}

extension class TFun {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFun,
    f2: TFun,
  ): STResult<TFun> {
    if (f1.tparams.size() != f2.tparams.size()) {
      return STTypeParameterMismatch()
    };
    tsubst = SortedMap[];
    for (i in Range(0, f1.tparams.size())) {
      tparam1 = f1.tparams[i];
      tparam2 = f2.tparams[i];
      (tparam1.cstr, tparam2.cstr) match {
      | (None(), None()) -> void
      | (Some _, None()) -> void
      | (None(), Some _) -> return STRecFunTParam(f1, f2, i, STMissing())
      | (Some(ty1), Some(ty2)) ->
        TType::isSub(subst, tenv, ty2, ty1) match {
        | STOk() -> void
        | err @ STError _ -> return STRecFunTParam(f1, f2, i, err)
        }
      };
      !tsubst[tparam2.id] = tparam1;
    };
    !f2 = (mutable RenameClauses()).fun_(tsubst, f2);
    (f1.thisParam, f2.thisParam) match {
    | (_, None()) -> void
    | (None(), Some(_)) -> return STRecFunThisParam(f1, f2, STMissing())
    | (Some(this1), Some(this2)) ->
      TType::isSub(subst, tenv, this2, this1) match {
      | STOk() -> void
      | err @ STError _ -> return STRecFunThisParam(f1, f2, err)
      }
    };

    if (f1.params.size() > f2.params.size()) {
      return STRecFunParam(f1, f2, f2.params.size(), STMissing())
    };

    spread1elt = f1.spreadParam match {
    | None() -> None()
    | Some(spread1) ->
      spread1.maybeGetEltType(subst, tenv, Contravariant()) match {
      | None() -> return STInvalidSpread(spread1)
      | some @ Some _ -> some
      }
    };

    for (i => p2 in f2.params) {
      io1 = i - f1.params.size();
      p1 = if (io1 < 0) {
        f1.params[i]
      } else if (io1 < f1.optionalParams.size()) {
        f1.optionalParams[io1]
      } else {
        spread1elt match {
        | None() -> break void
        | Some(p) -> p
        }
      };
      TType::isSub(subst, tenv, p2, p1) match {
      | STOk() -> void
      | err @ STError _ -> return STRecFunParam(f1, f2, i, err)
      }
    };

    for (io2 => p2 in f2.optionalParams) {
      i = io2 + f2.params.size();
      io1 = i - f1.params.size();
      p1 = if (io1 < 0) {
        internal_error("f1.params.size() <= f2.params.size() checked above")
      } else if (io1 < f1.optionalParams.size()) {
        f1.optionalParams[io1]
      } else {
        spread1elt match {
        | None() -> break void
        | Some(p) -> p
        }
      };
      TType::isSub(subst, tenv, p2, p1) match {
      | STOk() -> void
      | err @ STError _ -> return STRecFunParam(f1, f2, i, err)
      }
    };

    f2.spreadParam match {
    | None() ->
      if (
        f1.params.size() + f1.optionalParams.size() >
        f2.params.size() + f2.optionalParams.size()
      ) {
        return STRecFunParam(
          f1,
          f2,
          f2.params.size() + f2.optionalParams.size(),
          STMissing(),
        )
      };
      if (f1.spreadParam.isSome()) {
        return STRecFunSpread(f1, f2, STMissing())
      }
    | Some(spread2) ->
      spread2elt = spread2.maybeGetEltType(subst, tenv, Covariant()) match {
      | None() -> return STInvalidSpread(spread2)
      | Some(spread2elt) -> spread2elt
      };
      for (io1 in Range(
        f2.params.size() + f2.optionalParams.size() - f1.params.size(),
        f1.optionalParams.size(),
      )) {
        TType::isSub(subst, tenv, spread2elt, f1.optionalParams[io1]) match {
        | STOk() -> void
        | err @ STError _ ->
          return STRecFunOptionalSpread(f1, f2, io1 + f1.params.size(), err)
        }
      };
      spread1elt match {
      | None() -> void
      | Some(s1) ->
        TType::isSub(subst, tenv, spread2elt, s1) match {
        | STOk() -> void
        | err @ STError _ -> return STRecFunSpread(f1, f2, err)
        }
      }
    };
    TType::isSub(subst, tenv, f1.retType, f2.retType) match {
    | STOk() -> STOk()
    | err @ STError _ -> STRecFunReturn(f1, f2, err)
    }
  }
}

extension base class ArrayType {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    arr1: ArrayType,
    arr2: ArrayType,
  ): STResult<TType> {
    (
      arr1.maybeGetEltType(subst, tenv, Covariant()),
      arr2.maybeGetEltType(subst, tenv, Contravariant()),
    ) match {
    | (Some(elt1), Some(elt2)) -> TType::isSub(subst, tenv, elt1, elt2)
    | _ -> TType::isSub(subst, tenv, arr1.full(), arr2.full())
    }
  }
}

extension class TObject {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    obj1: TObject,
    obj2: TObject,
  ): STResult<TObject> {
    TFields::isSub(subst, tenv, obj1.fields, obj2.fields) match {
    | STOk() -> STOk()
    | err @ STError _ -> STRecObject(obj1, obj2, err)
    }
  }
}

module end;
