/***************************************************************************/
// Subtyping operations for types.
//
// INVARIANT: Every isSub function must guarantee that when it returns
// STError, the subst is unchanged (either restored or never mutated).
// This ensures callers can safely try speculative subtype checks without
// manual save/restore.
/***************************************************************************/

module SKJS;

/* Controls the level of detail in subtyping error messages */
class STErrorDetail(
  // Maximum depth for STRecType intermediate steps (type wrapper contexts)
  maxRecTypeDepth: Int,
  // Maximum depth for other intermediate steps
  maxIntermediateDepth: Int,
  // Whether to show intermediate detail messages (e.g., "They differ in element 2")
  showIntermediateMessages: Bool,
) extends ErrorDetailBase {
  // Create a new detail with decreased intermediate depth
  fun decreaseIntermediate(): STErrorDetail {
    STErrorDetail(
      this.maxRecTypeDepth,
      this.maxIntermediateDepth - 1,
      this.showIntermediateMessages,
    )
  }

  // Create a new detail with decreased RecType depth
  fun decreaseRecType(): STErrorDetail {
    STErrorDetail(
      this.maxRecTypeDepth - 1,
      this.maxIntermediateDepth,
      this.showIntermediateMessages,
    )
  }

  // Ensure intermediate depth is at least 1 when RecType depth is positive
  fun ensureIntermediateDepth(): STErrorDetail {
    if (this.maxRecTypeDepth >= 1 && this.maxIntermediateDepth < 1) {
      !this.maxIntermediateDepth = 1
    };
    this
  }
}

/* Result for a check of subtyping of types T1 and T2 */
base class STResult<+T>

/* T1 ⊑ T2 */
class STOk<+T>() extends STResult<T>

/* All other cases: T1 ⋢ T2 */
base class STError<+T> extends STResult<T> uses Equality {
  overridable macro fun ==<U>(other: STError<U>): Bool {
    other match {
    | otherTyped @ #ThisClass _ ->
      _ = otherTyped;
      #forEachField (#field) {
        if (!isEqual(this.#field, otherTyped.#field)) {
          return false;
        }
      };
      true

    | _ -> false
    }
  }

  overridable fun !=<U>(other: STError<U>): Bool {
    !(this == other)
  }

  static fun readonlyHint(
    suggestReadonly: ?PosRange,
  ): List<(PosRange, String)> {
    suggestReadonly match {
    | None() -> List[]
    | Some(pos) ->
      List[(pos, "This would not be an error if this field were readonly")]
    }
  }
}

base class STErrorOnSTypeBase<+T: SType> extends STError<T> {
  fun toError(
    mutable Subst,
    TEnv,
    _pos1: PosRange,
    _pos2: PosRange,
    _detail: STErrorDetail,
  ): List<(PosRange, String)>;
}

base class STErrorOnSType(
  suggestReadonly: ?PosRange = None(),
) extends STErrorOnSTypeBase<SType> {
  children =
  | STTooManySType(sType1: SType, sTypes2: STypes)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    _pos1: PosRange,
    pos2: PosRange,
    _detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STTooManySType(sType1, sTypes2, suggestReadonly) ->
    sTypes2.singleElt() match {
    | Some(sType2) -> !pos2 = sType2.pos
    | None() -> void
    };
    List[
      (sType1.pos, `Type ${sType1.toString(subst, tenv)}`),
      (pos2, `is not compatible with type ${sTypes2.toString(subst, tenv)}`),
    ].concat(STError::readonlyHint(suggestReadonly))
}

base class STErrorOnTPrimValue(
  prim1: TPrimValue,
  prim2: TPrimValue,
  suggestReadonly: ?PosRange = None(),
) extends STErrorOnSTypeBase<TPrimValue> {
  children =
  | STPrimValueFullSpecific()
  | STPrimMissingValue(elt: PrimLiteral)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    _pos1: PosRange,
    _pos2: PosRange,
    _detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STPrimValueFullSpecific(prim1, prim2, suggestReadonly) ->
    List[
      (prim1.pos, `Full type ${prim1.toString(subst, tenv)}`),
      (
        prim2.pos,
        `is not compatible with specific type ${prim2.toString(subst, tenv)}`,
      ),
    ].concat(STError::readonlyHint(suggestReadonly))
  | STPrimMissingValue(elt, prim1, prim2, suggestReadonly) ->
    List[
      (prim1.pos, `Type ${prim1.toString(subst, tenv)}`),
      (prim2.pos, `is not compatible with type ${prim2.toString(subst, tenv)}`),
      (elt.pos, `Value '${elt.val}' is missing`),
    ].concat(STError::readonlyHint(suggestReadonly))
}

base class STErrorOnTTuple(
  tup1: TTuple,
  tup2: TTuple,
  suggestReadonly: ?PosRange = None(),
) extends STErrorOnSTypeBase<TTuple> {
  children =
  | STTooManyTTuple()
  | STRecTuple(STErrorOnTType, Int)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    _pos1: PosRange,
    _pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STTooManyTTuple(tup1, tup2, suggestReadonly) ->
    List[
      (
        tup1.pos,
        `Tuple type of size ${tup1.tuple.size()} ${tup1.toString(subst, tenv)}`,
      ),
      (
        tup2.pos,
        `is not compatible with tuple type of size ${tup2.tuple.size()} ${tup2.toString(
          subst,
          tenv,
        )}`,
      ),
    ].concat(STError::readonlyHint(suggestReadonly))
  | STRecTuple(err, i, tup1, tup2, _) ->
    pos1 = tup1.tuple[i].pos;
    msgs = err.toError(subst, tenv, detail.decreaseIntermediate());
    if (detail.maxIntermediateDepth > 0) {
      if (tup1.tuple.size() > 1 && detail.showIntermediateMessages) {
        !msgs = List.Cons((pos1, `They differ in element ${i}`), msgs)
      };
      List.Cons(
        (tup1.pos, `Tuple type ${tup1.toString(subst, tenv)}`),
        List.Cons(
          (
            tup2.pos,
            `is not compatible with tuple type ${tup2.toString(subst, tenv)}`,
          ),
          msgs,
        ),
      )
    } else {
      msgs
    }
}

base class STErrorOnTPromise(
  p1: TPromise,
  p2: TPromise,
) extends STErrorOnSTypeBase<TPromise> {
  children =
  | STRecPromise(STErrorOnTType)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    _pos1: PosRange,
    _pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STRecPromise(err, p1, p2) ->
    msgs = err.toError(subst, tenv, detail.decreaseIntermediate());
    if (detail.maxIntermediateDepth > 0) {
      List.Cons(
        (p1.pos, `Promise type ${p1.toString(subst, tenv)}`),
        List.Cons(
          (
            p2.pos,
            `is not compatible with promise type ${p2.toString(subst, tenv)}`,
          ),
          msgs,
        ),
      )
    } else {
      msgs
    }
}

base class STErrorOnObject(
  o1: TObject,
  o2: TObject,
) extends STErrorOnSTypeBase<TObject> {
  children =
  | STRecObject(List<(TFields, STErrorOnTFields)>, fields1: TFields)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    _pos1: PosRange,
    _pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STRecObject(errs, fields1, o1, o2) ->
    msgs = List::createFromItems(errs)
      .map(fields2_err -> {
        (fields2, err) = fields2_err;
        if (o2.getBranches().size() > 1) {
          msgs = err.toError(
            subst,
            tenv,
            o1.pos,
            o2.pos,
            detail.decreaseIntermediate(),
          );
          if (detail.maxIntermediateDepth > 0) {
            List.Cons(
              (o1.pos, `Type ${fields1.toString(subst, tenv)}`),
              List.Cons(
                (
                  o2.pos,
                  `is not compatible with type ${fields2.toString(
                    subst,
                    tenv,
                  )}`,
                ),
                msgs,
              ),
            )
          } else {
            msgs
          }
        } else {
          err.toError(subst, tenv, o1.pos, o2.pos, detail)
        }
      })
      .flatten();
    if (detail.maxIntermediateDepth > 0) {
      if (msgs.isEmpty()) {
        !msgs = List[
          (o1.pos, `Type ${fields1.toString(subst, tenv)}`),
          (o2.pos, `is not compatible with ${o2.toString(subst, tenv)}`),
        ];
      };
      if (o1.getBranches().size() > 1 != o2.getBranches().size() > 1) {
        !msgs = List.Cons(
          (o1.pos, `Type ${o1.toString(subst, tenv)}`),
          List.Cons(
            (o2.pos, `is not compatible with ${o2.toString(subst, tenv)}`),
            msgs,
          ),
        )
      }
    };
    msgs
}

base class STErrorOnSTypes(
  sTypes1: STypes,
  sTypes2: STypes,
) extends STError<STypes> {
  children =
  | STRecSTypes(STErrorOnSTypeBase<SType>)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    pos1: PosRange,
    pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STRecSTypes(err, sTypes1, sTypes2) ->
    !pos1 = sTypes1.singleElt().map(sType -> sType.pos).default(pos1);
    !pos2 = sTypes2.singleElt().map(sType -> sType.pos).default(pos2);
    if (sTypes1.size() != 1 || sTypes2.size() != 1) {
      msgs = err.toError(
        subst,
        tenv,
        pos1,
        pos2,
        detail.decreaseIntermediate(),
      );
      if (detail.maxIntermediateDepth > 0) {
        List.Cons(
          (pos1, `Type ${sTypes1.toString(subst, tenv)}`),
          List.Cons(
            (
              pos2,
              `is not compatible with type ${sTypes2.toString(subst, tenv)}`,
            ),
            msgs,
          ),
        )
      } else {
        msgs
      }
    } else {
      err.toError(subst, tenv, pos1, pos2, detail)
    }
}

base class STErrorOnClauses(
  clauses1: Clauses,
  clauses2: Clauses,
) extends STError<Clauses> {
  children =
  | STRecClauses(List<(Clause, STErrorOnSTypes)>, clause1: Clause)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    pos1: PosRange,
    pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STRecClauses(errs, clause1, clauses1, clauses2) ->
    msgs = List::createFromItems(errs)
      .map(clause2_err -> {
        (clause2, err) = clause2_err;
        if (!clause1.vars.isEmpty() || !clause2.vars.isEmpty()) {
          msgs = err.toError(
            subst,
            tenv,
            pos1,
            pos2,
            detail.decreaseIntermediate(),
          );
          if (detail.maxIntermediateDepth > 0) {
            List.Cons(
              (pos1, `Type ${clause1.toString(subst, tenv)}`),
              List.Cons(
                (
                  pos2,
                  `is not compatible with type ${clause2.toString(
                    subst,
                    tenv,
                  )}`,
                ),
                msgs,
              ),
            )
          } else {
            msgs
          }
        } else {
          err.toError(subst, tenv, pos1, pos2, detail)
        }
      })
      .flatten();
    if (detail.maxIntermediateDepth > 0) {
      if (msgs.isEmpty() || clauses2.clauses.size() > errs.size()) {
        !msgs = List.Cons(
          (pos1, `Type ${clause1.toString(subst, tenv)}`),
          List.Cons(
            (
              pos2,
              `is not compatible with type ${clauses2.toString(subst, tenv)}`,
            ),
            msgs,
          ),
        )
      };
      if (clauses1.clauses.size() > 1) {
        !msgs = List.Cons(
          (pos1, `Type ${clauses1.toString(subst, tenv)}`),
          List.Cons(
            (
              pos2,
              `is not compatible with type ${clauses2.toString(subst, tenv)}`,
            ),
            msgs,
          ),
        )
      }
    };
    msgs
}

base class STErrorOnTType(ty1: TType, ty2: TType) extends STError<TType> {
  children =
  | STRecType(STErrorOnClauses)
  | STRecTypeWithHint(STErrorOnClauses, List<(PosRange, String)>)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STRecType(err, ty1, ty2) ->
    if (!ty1.insts.isEmpty() || !ty2.insts.isEmpty()) {
      msgs = err.toError(
        subst,
        tenv,
        ty1.pos,
        ty2.pos,
        detail.decreaseRecType(),
      );
      if (detail.maxRecTypeDepth > 0) {
        ty1Str = prettyPrintType(false, ty1, subst, tenv);
        ty2Str = prettyPrintType(false, ty2, subst, tenv);
        List.Cons(
          (ty1.pos, `Type ${ty1Str}`),
          List.Cons((ty2.pos, `is not compatible with type ${ty2Str}`), msgs),
        )
      } else {
        msgs
      }
    } else {
      err.toError(
        subst,
        tenv,
        ty1.pos,
        ty2.pos,
        detail.ensureIntermediateDepth(),
      )
    }
  | STRecTypeWithHint(err, hints, ty1, ty2) ->
    msgs = STRecType(err, ty1, ty2).toError(subst, tenv, detail);
    msgs.concat(hints)
}

base class STErrorOnTFuns(f1: TFuns, f2: TFuns) extends STError<TFuns> {
  children =
  | STRecTFuns(STErrorOnTFun)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    pos1: PosRange,
    pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)>
  | STRecTFuns(err, _f1, _f2) -> err.toError(subst, tenv, pos1, pos2, detail)
}

base class STErrorOnTFun(f1: TFun, f2: TFun) extends STError<TFun> {
  children =
  | STTypeParameterMismatch()
  | STInvalidSpread(TType)
  | STRecFunTParam(?STErrorOnTType, Int)
  | STRecFunThisParam(?STErrorOnTType)
  | STRecFunParam(?STErrorOnTType, Int)
  | STRecFunOptionalSpread(STErrorOnTType, Int)
  | STRecFunSpread(?STErrorOnTType)
  | STRecFunReturn(STErrorOnTType)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    pos1: PosRange,
    pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)> {
    (recMsg, msgs) = this match {
    | STRecFunTParam(None(), i, f1, _f2) ->
      iStr = if (f1.tparams.size() > 1) ` ${i + 1}` else "";
      (
        None(),
        List[(pos1, `The type parameter${iStr} does not define a constraint`)],
      )
    | STRecFunThisParam(None(), _f1, _f2) ->
      (None(), List[(pos1, "The this parameter is missing")])
    | STRecFunParam(None(), i, _f1, _f2) ->
      (None(), List[(pos2, `The parameter ${i + 1} is missing`)])
    | STRecFunSpread(None(), _f1, _f2) ->
      (None(), List[(pos2, "The rest parameter is missing")])
    | STTypeParameterMismatch(_f1, _f2) ->
      (None(), List[(pos1, "Their number of type parameters differ")])
    | STInvalidSpread(rest, _f1, _f2) ->
      restStr = prettyPrintType(false, rest, subst, tenv);
      (None(), List[(pos1, `Invalid type for a rest parameter: ${restStr}`)])
    | STRecFunTParam(Some(err), i, f1, _f2) ->
      iStr = if (f1.tparams.size() > 1) ` ${i + 1}` else "";
      (
        Some((pos1, `Their type parameters${iStr} are not compatible`)),
        err.toError(subst, tenv, detail.decreaseIntermediate()),
      )
    | STRecFunThisParam(Some(err), _f1, _f2) ->
      (
        Some((pos1, "Their this parameters are not compatible")),
        err.toError(subst, tenv, detail.decreaseIntermediate()),
      )
    | STRecFunParam(Some(err), i, _f1, _f2) ->
      (
        Some((pos1, `Their parameters ${i + 1} are not compatible`)),
        err.toError(subst, tenv, detail.decreaseIntermediate()),
      )
    | STRecFunOptionalSpread(err, i, _f1, _f2) ->
      (
        Some(
          (
            pos1,
            `The parameter ${i + 1} is not compatible with the rest parameter`,
          ),
        ),
        err.toError(subst, tenv, detail.decreaseIntermediate()),
      )
    | STRecFunSpread(Some(err), _f1, _f2) ->
      (
        Some((pos1, "Their rest parameters are not compatible")),
        err.toError(subst, tenv, detail.decreaseIntermediate()),
      )
    | STRecFunReturn(err, _f1, _f2) ->
      (
        Some((pos1, "Their return types are not compatible")),
        err.toError(subst, tenv, detail.decreaseIntermediate()),
      )
    };
    recMsg match {
    | Some(m) ->
      if (detail.maxIntermediateDepth > 0 && detail.showIntermediateMessages) {
        !msgs = List.Cons(m, msgs)
      } else {
        return msgs
      }
    | None() -> void
    };
    List.Cons(
      (pos1, `Function type ${this.f1.toString(subst, tenv)}`),
      List.Cons(
        (
          pos2,
          `is not compatible with function type ${this.f2.toString(
            subst,
            tenv,
          )}`,
        ),
        msgs,
      ),
    )
  }
}

base class FieldMismatchKind uses Equality {
  children =
  | FMKGetter()
  | FMKSetter()

  fun readonlyHintPos(pos: PosRange): ?PosRange {
    this match {
    | FMKGetter() -> None()
    | FMKSetter() -> Some(pos)
    }
  }
}

base class STErrorOnTFields(
  fields1: TFields,
  fields2: TFields,
) extends STError<TFields> {
  children =
  | STRecFieldsCall(?STErrorOnTFuns)
  | STRecFieldsNew(?STErrorOnTFuns)
  | STRecFieldsIndexValue(STErrorOnTType, TField, TField, FieldMismatchKind)
  | STRecFieldsMissingIndex(STErrorOnTType, TField)
  | STRecFieldsFieldIndex(STErrorOnTType, TField, TField, FieldMismatchKind)
  | STRecFieldsIndexField(STErrorOnTType, TField, TField, FieldMismatchKind)
  | STRecFieldsMissingField(TField)
  | STRecFieldsField(?STErrorOnTType, TField, TField, FieldMismatchKind)
  | STRecFieldsFieldAccess(TField, TField)

  fun toError(
    subst: mutable Subst,
    tenv: TEnv,
    pos1: PosRange,
    pos2: PosRange,
    detail: STErrorDetail,
  ): List<(PosRange, String)> {
    showTypes =
      !this.fields1.fields.isEmpty() ||
      this.fields1.hasNonSyntheticIndex() ||
      !this.fields2.fields.isEmpty() ||
      this.fields2.hasNonSyntheticIndex() ||
      (
        this.fields1.new,
        this.fields1.call,
        this.fields2.new,
        this.fields2.call,
      ) match {
      | (Some((false, _)), None(), Some((false, _)), None())
      | (None(), Some((false, _)), None(), Some((false, _))) ->
        false
      | _ -> true
      };
    detailForRec = if (showTypes) detail.decreaseIntermediate() else detail;
    (recMsgs, msgs, suggestReadonly) = this match {
    | STRecFieldsCall(None(), _fields1, _fields2) ->
      (List.Nil(), List[(pos1, "Missing call signature")], None())
    | STRecFieldsNew(None(), _fields1, _fields2) ->
      (List.Nil(), List[(pos1, "Missing constructor signature")], None())
    | STRecFieldsMissingField(field, _fields1, _fields2) ->
      (
        List.Nil(),
        List[(field.pos, `The field '${field.name.value}' is missing`)],
        None(),
      )
    | STRecFieldsCall(Some(err), _fields1, _fields2) ->
      (
        List[(pos1, `They differ in their call signature`)],
        err.toError(subst, tenv, pos1, pos2, detailForRec),
        None(),
      )
    | STRecFieldsNew(Some(err), _fields1, _fields2) ->
      (
        List[(pos1, `They differ in their constructor signature`)],
        err.toError(subst, tenv, pos1, pos2, detailForRec),
        None(),
      )
    | STRecFieldsIndexValue(err, index1, index2, kind, _fields1, _fields2) ->
      (
        List[
          (index1.pos, `Value type of index field '${index1.name.value}'`),
          (
            index2.pos,
            `is not compatible with value type of index field '${
              index2.name.value
            }'`,
          ),
        ],
        err.toError(subst, tenv, detailForRec),
        kind.readonlyHintPos(index2.pos),
      )
    | STRecFieldsMissingIndex(err, index2, _fields1, _fields2) ->
      (
        List[
          (
            index2.pos,
            `Missing index signature '${index2.name.value}' in source type`,
          ),
        ],
        err.toError(subst, tenv, detailForRec),
        None(),
      )
    | STRecFieldsFieldIndex(err, field1, index2, kind, _fields1, _fields2) ->
      (
        List[
          (field1.pos, `Field '${field1.name.value}'`),
          (
            index2.pos,
            `is not compatible with index field '${index2.name.value}'`,
          ),
        ],
        err.toError(subst, tenv, detailForRec),
        kind.readonlyHintPos(index2.pos),
      )
    | STRecFieldsIndexField(err, index1, field2, kind, _fields1, _fields2) ->
      (
        List[
          (index1.pos, `Index field '${index1.name.value}'`),
          (field2.pos, `is not compatible with field '${field2.name.value}'`),
        ],
        err.toError(subst, tenv, detailForRec),
        kind.readonlyHintPos(field2.pos),
      )
    | STRecFieldsField(err, field1, field2, kind, _fields1, _fields2) ->
      msg = kind match {
      | FMKSetter() if (field1.set.isBottom()) ->
        `Field '${
          field1.name.value
        }' is readonly and cannot be used where a mutable field is expected`
      | FMKSetter() ->
        `Their field '${field1.name.value}' have incompatible set types`
      | FMKGetter() -> `Their field '${field1.name.value}' are not compatible`
      };
      (
        List[(field1.pos, msg)],
        err.map(e -> e.toError(subst, tenv, detailForRec)).default(List.Nil()),
        kind.readonlyHintPos(field2.pos),
      )
    | STRecFieldsFieldAccess(field1, field2, _fields1, _fields2) ->
      (
        List.Nil(),
        List[
          (
            field1.pos,
            `Field '${
              field1.name.value
            }' has incompatible accessibility with the target type`,
          ),
          (field2.pos, "Target declaration is here"),
        ],
        None(),
      )
    };
    !msgs = msgs.concat(STError::readonlyHint(suggestReadonly));
    if (
      recMsgs is List.Nil() ||
      (showTypes && detail.maxIntermediateDepth > 0)
    ) {
      if (detail.showIntermediateMessages) {
        !msgs = recMsgs.concat(msgs)
      };
      List.Cons(
        (pos1, `Type ${this.fields1.toString(subst, tenv)}`),
        List.Cons(
          (
            pos2,
            `is not compatible with type ${this.fields2.toString(subst, tenv)}`,
          ),
          msgs,
        ),
      )
    } else {
      msgs
    }
  }
}

extension class TFuns {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    funs1: TFuns,
    funs2: TFuns,
  ): STResult<TFuns> {
    TFun::isSub(subst, tenv, funs1.fun_, funs2.fun_) match {
    | STOk() -> STOk()
    | err @ STErrorOnTFun _ -> STRecTFuns(err, funs1, funs2)
    }
  }
}

extension class TFields {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): STResult<TFields> {
    savedSubst = subst.save();
    res = TFields::isSub_(subst, tenv, fields1, fields2);
    if (res is STError _) subst.restore(savedSubst);
    res
  }

  // Check a single index kind: if super has an index, sub must also
  // have a compatible index for that kind.
  private static fun isSub_IndexPair(
    subst: mutable Subst,
    tenv: TEnv,
    idx1: ?TField,
    idx2: ?TField,
    fields1: TFields,
    fields2: TFields,
  ): STResult<TFields> {
    (idx1, idx2) match {
    | (_, None()) -> STOk()
    | (Some(index1), Some(index2)) ->
      TType::isSub(subst, tenv, index1.get, index2.get) match {
      | err @ STErrorOnTType _ ->
        STRecFieldsIndexValue(
          err,
          index1,
          index2,
          FMKGetter(),
          fields1,
          fields2,
        )
      | STOk() ->
        TType::isSub(subst, tenv, index2.set, index1.set) match {
        | err @ STErrorOnTType _ ->
          STRecFieldsIndexValue(
            err,
            index1,
            index2,
            FMKSetter(),
            fields1,
            fields2,
          )
        | STOk() -> STOk()
        }
      }
    | (None(), Some(index2)) ->
      // Sub has no index for this kind. Check against top/bottom so that
      // TVars in index2 still get unified. For concrete types this fails;
      // for synthetic index TVars this succeeds (unifying with top/bottom).
      TType::isSub(subst, tenv, TType::top(index2.pos), index2.get) match {
      | err @ STErrorOnTType _ ->
        STRecFieldsMissingIndex(err, index2, fields1, fields2)
      | STOk() ->
        TType::isSub(subst, tenv, index2.set, TType::bottom(index2.pos)) match {
        | err @ STErrorOnTType _ ->
          STRecFieldsMissingIndex(err, index2, fields1, fields2)
        | STOk() -> STOk()
        }
      }
    }
  }

  // Check subtyping for named fields (sub vs super).
  // indexFor looks up the index covering a given field name in the given TFields.
  private static fun isSub_NamedFields(
    subst: mutable Subst,
    tenv: TEnv,
    namedFields1: InternalKeyedArrayMap<FieldNameString, TField>,
    namedFields2: InternalKeyedArrayMap<FieldNameString, TField>,
    indexFor: (TFields, FieldNameString) -> ?TField,
    fields1: TFields,
    fields2: TFields,
  ): STResult<TFields> {
    for (ior in namedFields1.iterDiffInterDiff(namedFields2)) {
      ior match {
      | Left(f1) ->
        // Sub has extra field: check it against super's index
        indexFor(fields2, f1.name) match {
        | None() -> void
        | Some(idx2) ->
          TType::isSub(subst, tenv, f1.get, idx2.get) match {
          | err @ STErrorOnTType _ ->
            return STRecFieldsFieldIndex(
              err,
              f1,
              idx2,
              FMKGetter(),
              fields1,
              fields2,
            )
          | STOk() ->
            TType::isSub(subst, tenv, idx2.set, f1.set) match {
            | err @ STErrorOnTType _ ->
              return STRecFieldsFieldIndex(
                err,
                f1,
                idx2,
                FMKSetter(),
                fields1,
                fields2,
              )
            | STOk() -> void
            }
          }
        }
      | Right(f2) ->
        if (!f2.isOptional) {
          return STRecFieldsMissingField(f2, fields1, fields2)
        };
        // When sub has an index, use it to satisfy super's optional fields
        indexFor(fields1, f2.name) match {
        | None() -> return STRecFieldsMissingField(f2, fields1, fields2)
        | Some(idx1) ->
          TType::isSub(subst, tenv, idx1.get, f2.get) match {
          | err @ STErrorOnTType _ ->
            return STRecFieldsIndexField(
              err,
              idx1,
              f2,
              FMKGetter(),
              fields1,
              fields2,
            )
          | STOk() ->
            TType::isSub(subst, tenv, f2.set, idx1.set) match {
            | err @ STErrorOnTType _ ->
              return STRecFieldsIndexField(
                err,
                idx1,
                f2,
                FMKSetter(),
                fields1,
                fields2,
              )
            | STOk() -> void
            }
          }
        }
      | Both(f1, f2) ->
        if (f1.isOptional && !f2.isOptional) {
          return STRecFieldsMissingField(f1, fields1, fields2)
        };
        if (!f1.access.isCompatibleWith(f2.access)) {
          return STRecFieldsFieldAccess(f1, f2, fields1, fields2)
        };
        // Readonly field cannot satisfy a mutable field: skip the setter isSub
        // to avoid spurious success from TVar inference.
        if (f1.set.isBottom() && !f2.set.isBottom()) {
          return STRecFieldsField(None(), f1, f2, FMKSetter(), fields1, fields2)
        };
        TType::isSub(subst, tenv, f2.set, f1.set) match {
        | STOk() -> void
        | err @ STErrorOnTType _ ->
          return STRecFieldsField(
            Some(err),
            f1,
            f2,
            FMKSetter(),
            fields1,
            fields2,
          )
        };
        f2type = if (f2.isOptional) {
          TType::unionUndefined(subst, tenv, f2.get, f2.pos)
        } else {
          f2.get
        };
        TType::isSub(subst, tenv, f1.get, f2type) match {
        | STOk() -> void
        | err @ STErrorOnTType _ ->
          return STRecFieldsField(
            Some(err),
            f1,
            f2,
            FMKGetter(),
            fields1,
            fields2,
          )
        }
      }
    };
    STOk()
  }

  private static fun isSub_(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): STResult<TFields> {
    // Process fields first so that tuple index type variables are resolved
    // before call/new signatures with union types.
    TFields::isSub_NamedFields(
      subst,
      tenv,
      fields1.fields,
      fields2.fields,
      (fs, name) -> fs.indexForFieldName(name.value),
      fields1,
      fields2,
    ) match {
    | err @ STError _ -> return err
    | STOk() -> void
    };
    // Per-kind index checks: for each kind, if super has an index,
    // sub must also have a compatible index (or named fields that satisfy it).
    TFields::isSub_IndexPair(
      subst,
      tenv,
      fields1.stringIndex,
      fields2.stringIndex,
      fields1,
      fields2,
    ) match {
    | err @ STError _ -> return err
    | STOk() -> void
    };
    // Effective number index: fall back to string when no number index,
    // since string index covers numeric keys.
    (
      fields1.numberIndex,
      fields1.stringIndex,
      fields2.numberIndex,
      fields2.stringIndex,
    ) match {
    | (None(), _, None(), _) -> void
    | (effectiveNum1 @ Some _, _, None(), effectiveNum2)
    | (effectiveNum1 @ Some _, _, effectiveNum2, _)
    | (None(), effectiveNum1, effectiveNum2, _) ->
      TFields::isSub_IndexPair(
        subst,
        tenv,
        effectiveNum1,
        effectiveNum2,
        fields1,
        fields2,
      ) match {
      | err @ STError _ -> return err
      | STOk() -> void
      }
    };
    TFields::isSub_IndexPair(
      subst,
      tenv,
      fields1.symbolIndex,
      fields2.symbolIndex,
      fields1,
      fields2,
    ) match {
    | err @ STError _ -> return err
    | STOk() -> void
    };
    // Symbol fields: same logic as string fields
    TFields::isSub_NamedFields(
      subst,
      tenv,
      fields1.symbolFields,
      fields2.symbolFields,
      (fs, _) -> fs.symbolIndex,
      fields1,
      fields2,
    ) match {
    | err @ STError _ -> return err
    | STOk() -> void
    };
    TFields::isSubOptTFuns(subst, tenv, fields1.call, fields2.call) match {
    | None() -> return STRecFieldsCall(None(), fields1, fields2)
    | Some(STOk()) -> void
    | Some(err @ STErrorOnTFuns _) ->
      return STRecFieldsCall(Some(err), fields1, fields2)
    };
    TFields::isSubOptTFuns(subst, tenv, fields1.new, fields2.new) match {
    | None() -> return STRecFieldsNew(None(), fields1, fields2)
    | Some(STOk()) -> void
    | Some(err @ STErrorOnTFuns _) ->
      return STRecFieldsNew(Some(err), fields1, fields2)
    };
    STOk()
  }

  static fun isSubOptTFuns(
    subst: mutable Subst,
    tenv: TEnv,
    f1opt: ?(Bool, TFuns),
    f2opt: ?(Bool, TFuns),
  ): ?STResult<TFuns> {
    (f1opt, f2opt) match {
    | (_, None())
    | (None(), Some((true, _))) ->
      Some(STOk())
    | (None(), Some((false, _)))
    | (Some((true, _)), Some((false, _))) ->
      None()
    | (Some((_opt1, call1)), Some((_opt2, call2))) ->
      Some(TFuns::isSub(subst, tenv, call1, call2))
    }
  }
}

extension class STypes {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): STResult<STypes> {
    savedSubst = subst.save();
    stypes1.stypes.leq(stypes2.stypes, (sty1, sty2O) ->
      sty2O match {
      | Some(sty2) ->
        invariant(
          sty1.tag() == sty2.tag(),
          "leq ensures iteration with identical tags",
        );
        (sty1, sty2) match {
        | (TPrimUnit _, TPrimUnit _) -> STOk()

        | (prim1 @ TPrimValue _, prim2 @ TPrimValue _) ->
          TPrimValue::isSub(prim1, prim2)

        | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
          TTuple::isSub(subst, tenv, tuple1, tuple2)

        | (p1 @ TPromise _, p2 @ TPromise _) ->
          TPromise::isSub(subst, tenv, p1, p2)

        | (obj1 @ TObject _, obj2 @ TObject _) ->
          TObject::isSub(subst, tenv, obj1, obj2)

        | _ -> internal_error("Internal error")
        } match {
        | STOk() -> Success(void)
        | err @ STErrorOnSTypeBase _ -> Failure(err)
        }
      | None() -> Failure(STTooManySType(sty1, stypes2))
      }
    ) match {
    | Success(void) -> STOk()
    | Failure(err) ->
      subst.restore(savedSubst);
      STRecSTypes(err, stypes1, stypes2)
    }
  }
}

extension class Clauses {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): STResult<Clauses> {
    savedSubst = subst.save();
    for (inter1 in clauses1) {
      errors = List[];
      for (inter2 in clauses2) {
        if (!inter1.vars.contains(inter2.vars)) {
          continue;
        };
        (inter1.stypes, inter2.stypes) match {
        | (None(), None()) -> break void
        | (Some _, None()) -> break void
        | (None(), Some _) -> continue
        | (Some(x1), Some(x2)) ->
          STypes::isSub(subst, tenv, x1, x2) match {
          | STOk() -> break void
          | err @ STErrorOnSTypes _ ->
            !errors = List.Cons((inter2, err), errors);
            continue
          }
        }
      } else {
        subst.restore(savedSubst);
        return STRecClauses(errors, inter1, clauses1, clauses2)
      }
    };
    STOk()
  }
}

extension class TType {
  //
  private static fun originSuggestions(
    subst: mutable Subst,
    tenv: TEnv,
    u1: TType,
    u2: TType,
  ): List<(PosRange, String)> {
    hints = List<(PosRange, String)>[];
    // Use a clone so that union side effects don't affect the real subst.
    clonedSubst = subst.clone();
    for (inst in u2.insts) {
      inst match {
      | tvar @ TVar _ if (clonedSubst.isClosed(tvar)) ->
        rawSealed = clonedSubst.peekRaw(tvar) match {
        | Some(ty) -> ty
        | None() -> continue
        };
        sealedType = rawSealed.expandTVarsForPp(clonedSubst, tenv);
        expandedU1 = u1.expandTVarsForPp(clonedSubst, tenv);
        widerType = TType::union(clonedSubst, tenv, sealedType, expandedU1);
        widerStr = widerType.toString(clonedSubst, tenv);
        clonedSubst.getOrigin(tvar) match {
        | Some(FromGenericInst(pos, allTVars))
        | Some(FromGenericCall(pos, allTVars)) ->
          targs = allTVars.map(tv -> {
            if (tv.id == tvar.id) {
              widerStr
            } else {
              clonedSubst.peekRaw(tv) match {
              | Some(ty) ->
                ty
                  .expandTVarsForPp(clonedSubst, tenv)
                  .toString(clonedSubst, tenv)
              | None() -> "unknown"
              }
            }
          });
          targsStr = targs.join(", ");
          !hints = List.Cons(
            (
              pos,
              `Consider adding explicit type arguments, e.g., <${targsStr}>`,
            ),
            hints,
          )
        | Some(FromEmptyArray(pos))
        | Some(FromArrayLiteral(pos)) ->
          !hints = List.Cons(
            (
              pos,
              `Consider adding a type annotation, e.g., Array<${widerStr}>`,
            ),
            hints,
          )
        | Some(FromAsyncReturn(pos))
        | Some(FromLambdaReturn(pos)) ->
          !hints = List.Cons(
            (
              pos,
              `Consider adding a return type annotation, e.g., ${widerStr}`,
            ),
            hints,
          )
        | Some(FromNullLiteral(pos))
        | Some(FromUndefinedLiteral(pos))
        | Some(FromUntypedVar(pos))
        | Some(FromObjectField(pos))
        | Some(FromArrayElement(pos))
        | Some(FromSyntheticIndex(pos)) ->
          !hints = List.Cons(
            (pos, `Consider adding a type annotation, e.g., ${widerStr}`),
            hints,
          )
        | None() -> void
        }
      | _ -> void
      }
    };
    hints
  }

  // Collect TVars from `insts` that should be grown by growTVars.
  //
  // Bare TVars are collected unconditionally (grow handles SVOpen by
  // unioning, SVClosed by ignoring).
  //
  // TInter members that are bare TVars are extracted if unbound.
  //
  // TSInst entries are expanded one level via the seenExpansion cache and
  // recursed into, exposing TVars hidden inside head-transparent type
  // aliases like `Maybe<T> = T | null`.
  //
  // TArrayLit is ignored: its commitment TVar is not an inference TVar in
  // the lattice-growth sense but a form-selector (Tuple vs Array),
  // committed by ArrayLitTyping based on the shape of the other side rather
  // than by bound-growth.
  private static fun collectTVars(
    subst: mutable Subst,
    tenv: TEnv,
    insts: TInsts,
    tvarsToGrow: mutable Vector<TVar>,
    seen: mutable Set<TInst>,
  ): void {
    for (inst in insts) {
      if (!seen.maybeInsert(inst)) {
        continue
      } else {
        inst match {
        | tvar @ TVar _ -> tvarsToGrow.push(tvar)
        | TInter(tys) ->
          for (ty in tys) {
            ty.getSingleVar() match {
            | Some(tvar @ TVar _) if (subst.isUnbound(tvar)) ->
              tvarsToGrow.push(tvar)
            | _ -> void
            }
          }
        | tsinst @ TSInst(name, targs) ->
          expandedType = subst.seenExpansion.maybeGet(tsinst) match {
          | None() ->
            e = tenv.instantiate(subst, name, targs);
            subst.!seenExpansion[tsinst] = e;
            e
          | Some(e) -> e
          };
          static::collectTVars(
            subst,
            tenv,
            expandedType.insts,
            tvarsToGrow,
            seen,
          )
        | TArrayLit _ -> void
        }
      }
    }
  }

  // TVar growth: iterate openTy.insts looking for unbound TVars to grow
  // from boundTy via per-disjunct matching. Then walk into objects/
  // functions structurally to grow TVars hidden inside type aliases.
  //
  // `openTy` is the type whose TVars we grow in this call (an "open type",
  // containing free TVars awaiting inference). `boundTy` provides the
  // bound; its own TVars (if any) are treated as opaque here. The
  // complementary call (with variance flipped) handles the other side's
  // TVars.
  private static fun growTVars(
    subst: mutable Subst,
    tenv: TEnv,
    boundTy: TType,
    openTy: TType,
    variance: Variance,
  ): void {
    tvarsToGrow: mutable Vector<TVar> = mutable Vector[];
    static::collectTVars(subst, tenv, openTy.insts, tvarsToGrow, mutable Set[]);

    expandedOpen = openTy.expand(subst, tenv, None());

    // Check if disjunct is covered by any non-TVar branch of expandedOpen.
    // expand(None()) unfolds TSInst and TInter into clauses, so iterating
    // expandedOpen.clauses visits every non-TVar branch. TVars remain in
    // expandedOpen.insts and are ignored here -- they are what the grow
    // loop is about to populate. `any` short-circuits on the first hit;
    // `subst.restore(saved)` rolls back unification side effects from each
    // probe before the next one.
    isCovered = (disjunct: TType) -> {
      saved = subst.save();
      expandedOpen.clauses.any(clause ->
        clause.stypes match {
        | Some(stypes) ->
          stypes.any(stype -> {
            hit = TType::isSub(
              subst,
              tenv,
              disjunct,
              TType::single(stype),
            ) is STOk();
            subst.restore(saved);
            hit
          })
        | None() -> false
        }
      )
    };

    // Grow tvar with boundTy minus the non-TVar branches of expandedOpen.
    // When expandedOpen has no non-TVar branches (bare TVar), grows with
    // the full boundTy; otherwise expands boundTy and checks each disjunct
    // individually, growing only the uncovered ones. expand(None()) unfolds
    // TSInst/TInter/TArrayLit into clauses so aliases on boundTy are
    // decomposed the same way openTy's are, giving symmetric precision.
    expandedBound = boundTy.expand(subst, tenv, None());
    growUncovered = (tvar: TVar) -> {
      if (expandedOpen.clauses.isEmpty()) {
        subst.grow(tenv, tvar, boundTy, variance)
      } else {
        for (boundInst in expandedBound.insts) {
          boundInst match {
          | tv @ TVar _ ->
            disjunct = TType::var(tv);
            if (!isCovered(disjunct)) {
              subst.grow(tenv, tvar, disjunct, variance)
            }
          // After expand(None()), insts contains only TVars; TSInst,
          // TInter, and TArrayLit have been expanded into clauses.
          | _ -> void
          }
        };
        for (clause in expandedBound.clauses) {
          clause.stypes match {
          | Some(stypes) ->
            for (stype in stypes) {
              disjunct = TType::single(stype);
              if (!isCovered(disjunct)) {
                subst.grow(tenv, tvar, disjunct, variance)
              }
            }
          | _ -> void
          }
        }
      }
    };

    // Each growUncovered call commits to subst, so subsequent isCovered
    // probes for later TVars observe the grown state. Iteration order is
    // the collectTVars traversal order (stable, structural); changing it
    // can change which disjuncts are grown into which TVars.
    for (tvar in tvarsToGrow) {
      substCopy = subst.save();
      if (
        tvar.constraints.all(cstr ->
          TType::isSub(subst, tenv, boundTy, cstr) is STOk()
        )
      ) {
        growUncovered(tvar)
      } else {
        subst.restore(substCopy)
      }
    };

    // Structural decomposition: walk into objects/functions to grow TVars
    // nested inside type structure. This handles cases the top-level loop
    // cannot reach, e.g. TVars inside function return types behind type
    // aliases.
    //
    // Limitations:
    //  - Clauses::getObject returns Some only for a single-object clause.
    //    When either side is a union of object types (discriminated or
    //    otherwise), descent is skipped and the top-level isSub call is
    //    left to handle the TVars without pre-seeding. Precise per-branch
    //    pairing would require matching clauses across the two sides.
    //  - Only object fields and call/new return types are descended into.
    //  - Tuple element types (TTuple) and promise payloads (TPromise) are
    //    not descended, so TVars hidden inside `[A, B]` or `Promise<A>`
    //    behind an alias are not pre-seeded and are left to the top-level
    //    isSub call.
    (expandedOpen.clauses.getObject(), boundTy.clauses.getObject()) match {
    | (Some(openObj), Some(boundObj)) ->
      openFields = openObj.getFields(subst, tenv);
      boundFields = boundObj.getFields(subst, tenv);
      for (of in openFields.fields.toArray()) {
        boundFields.maybeGet(of.name.value) match {
        | Some(bf) -> static::growTVars(subst, tenv, bf.get, of.get, variance)
        | None() -> void
        }
      };
      (openFields.call, boundFields.call) match {
      | (Some((_, openFuns)), Some((_, boundFuns))) ->
        // Function return type only. TFun::isSub_ checks params before
        // return, so any TVar that appears in both would otherwise see only
        // its param-side bound when the param checks run -- the return-side
        // contribution would arrive too late to inform them. Pre-growing the
        // return seeds that bound first, tightening the subsequent per-param
        // isSub calls. Params themselves are skipped here: TFun::isSub_ pairs
        // them positionally, which is strictly more precise than the bulk
        // grow this pre-pass would do.
        static::growTVars(
          subst,
          tenv,
          boundFuns.fun_.retType,
          openFuns.fun_.retType,
          variance,
        )
      | _ -> void
      };
      (openFields.new, boundFields.new) match {
      | (Some((_, openFuns)), Some((_, boundFuns))) ->
        // Constructor signatures: same return-first rationale as call
        // signatures above. The constructed instance type is the return,
        // and TVars nested there (e.g. `new <A>(x: T): Container<A>`) need
        // seeding before per-param isSub runs.
        static::growTVars(
          subst,
          tenv,
          boundFuns.fun_.retType,
          openFuns.fun_.retType,
          variance,
        )
      | _ -> void
      }
    | _ -> void
    }
  }

  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    u1: TType,
    u2: TType,
  ): STResult<TType> {
    if (u1 == u2) return STOk();
    pair = (u1, u2);
    if (subst.seenSub.contains(pair)) return STOk();
    res = TType::isSub_(subst, tenv, u1, u2);
    if (res is STOk()) {
      subst.!seenSub = subst.seenSub.set(pair)
    };
    res
  }

  private static fun isSub_(
    subst: mutable Subst,
    tenv: TEnv,
    u1: TType,
    u2: TType,
  ): STResult<TType> {
    if (u2.isTop()) return STOk();
    if (tenv.seenSub.contains((subst.version, u1, u2))) return STOk();
    !tenv.seenSub = tenv.seenSub.set((subst.version, u1, u2));

    // Shortcut: TInter(tys) <: u2 if u2 is one of the tys
    u1.getSingleInter() match {
    | Some(TInter(tys)) if (tys.containsElt(u2)) -> return STOk()
    | _ -> void
    };

    ArrayLitTyping::subtyping(subst, tenv, u1, u2) match {
    | Some(res) -> return res
    | None() -> void
    };

    savedSubst = subst.save();
    // grow TVars in u2 from u1
    static::growTVars(subst, tenv, u1, u2, Contravariant());
    // seal TVars in u1 from u2
    static::growTVars(subst, tenv, u2, u1, Covariant());
    clauses1 = u1.expandToClauses(subst, tenv, Covariant());
    clauses2 = u2.expandToClauses(subst, tenv, Contravariant());

    // Special case: tuple-like lhs against array-like rhs.
    // We accept only when ReadonlyArray<U(tuple elems)> <: rhs.
    substCopy = subst.save();
    VariadicTyping::tupleToArraySubtyping(subst, tenv, clauses1, u2) match {
    | Some(res) ->
      if (!(res is STOk())) subst.restore(substCopy);
      return res
    | None() -> subst.restore(substCopy)
    };

    Clauses::isSub(subst, tenv, clauses1, clauses2) match {
    | STOk() -> STOk()
    | err @ STErrorOnClauses _ ->
      hints = static::originSuggestions(subst, tenv, u1, u2);
      subst.restore(savedSubst);
      STRecTypeWithHint(err, hints, u1, u2)
    }
  }
}

extension class TTuple {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    tuple1: TTuple,
    tuple2: TTuple,
  ): STResult<TTuple> {
    if (tuple1.tuple.size() < tuple2.tuple.size()) {
      return STTooManyTTuple(tuple1, tuple2)
    };
    savedSubst = subst.save();
    for (i in Range(0, tuple2.tuple.size())) {
      TType::isSub(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]) match {
      | STOk() -> void
      | err @ STErrorOnTType _ ->
        subst.restore(savedSubst);
        return STRecTuple(err, i, tuple1, tuple2)
      }
    };
    STOk()
  }
}

extension class TPromise {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    promise1: TPromise,
    promise2: TPromise,
  ): STResult<TPromise> {
    TType::isSub(subst, tenv, promise1.inner, promise2.inner) match {
    | STOk() -> STOk()
    | err @ STErrorOnTType _ -> STRecPromise(err, promise1, promise2)
    }
  }
}

extension class TPrimValue {
  static fun isSub(prim1: TPrimValue, prim2: TPrimValue): STResult<TPrimValue> {
    invariant(
      prim1.tag() == prim2.tag(),
      "TPrimValue::isSub expects to be called with identical tags",
    );
    (prim1.literals, prim2.literals) match {
    | (_, None()) -> STOk()
    | (None(), Some _) -> STPrimValueFullSpecific(prim1, prim2)
    | (Some(lits1), Some(lits2)) ->
      for (elt in lits1.values()) {
        if (!lits2.contains(elt.val)) {
          return STPrimMissingValue(elt, prim1, prim2)
        }
      };
      STOk()
    }
  }
}

extension class TFun {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFun,
    f2: TFun,
  ): STResult<TFun> {
    savedSubst = subst.save();
    res = TFun::isSub_(subst, tenv, f1, f2);
    if (res is STError _) {
      subst.restore(savedSubst)
    } else {
      // Record subtyping edges: f1's cgNodes should be reachable from f2's
      f1.cgNodes.nodes.each(subNode -> {
        f2.cgNodes.nodes.each(supNode -> {
          if (subNode != supNode) {
            subst.results.recordSubtypingEdge(subNode, supNode)
          }
        })
      })
    };
    res
  }

  private static fun isSub_(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFun,
    f2: TFun,
  ): STResult<TFun> {
    if (f1.tparams.size() != f2.tparams.size()) {
      return STTypeParameterMismatch(f1, f2)
    };
    tsubst = SortedMap[];
    for (i in Range(0, f1.tparams.size())) {
      tparam1 = f1.tparams[i];
      tparam2 = f2.tparams[i];
      (tparam1.cstr, tparam2.cstr) match {
      | (None(), None()) -> void
      | (Some _, None()) -> void
      | (None(), Some _) -> return STRecFunTParam(None(), i, f1, f2)
      | (Some(ty1), Some(ty2)) ->
        TType::isSub(subst, tenv, ty2, ty1) match {
        | STOk() -> void
        | err @ STErrorOnTType _ -> return STRecFunTParam(Some(err), i, f1, f2)
        }
      };
      !tsubst[tparam2.id] = tparam1;
    };
    !f2 = (mutable RenameClauses()).fun_(tsubst, f2);
    (f1.thisParam, f2.thisParam) match {
    | (_, None()) -> void
    | (None(), Some(_)) -> return STRecFunThisParam(None(), f1, f2)
    | (Some(this1), Some(this2)) ->
      TType::isSub(subst, tenv, this2, this1) match {
      | STOk() -> void
      | err @ STErrorOnTType _ -> return STRecFunThisParam(Some(err), f1, f2)
      }
    };

    // Flatten tuple rest params to positional params for both sides.
    // E.g. (...args: [A, B]) => R becomes (a: A, b: B) => R.
    // Optional params before the tuple become positionally required
    // since they can't be skipped to reach the tuple args.
    (
      f2params,
      f2optionalParams,
      f2spreadParam,
    ) = VariadicTyping::resolveSpreadToTuple(
      subst,
      tenv,
      f2.spreadParam,
    ) match {
    | Some(tupleElts) ->
      combined = mutable Vector[];
      combined.extend(f2.params);
      combined.extend(f2.optionalParams);
      combined.extend(tupleElts);
      (combined.toArray(), Array[], None())
    | None() -> (f2.params, f2.optionalParams, f2.spreadParam)
    };
    (
      f1params,
      f1optionalParams,
      f1spreadParam,
    ) = VariadicTyping::resolveSpreadToTuple(
      subst,
      tenv,
      f1.spreadParam,
    ) match {
    | Some(tupleElts) ->
      combined = mutable Vector[];
      combined.extend(f1.params);
      combined.extend(f1.optionalParams);
      combined.extend(tupleElts);
      (combined.toArray(), Array[], None())
    | None() -> (f1.params, f1.optionalParams, f1.spreadParam)
    };

    if (f1params.size() > f2params.size()) {
      return STRecFunParam(None(), f2params.size(), f1, f2)
    };

    spread1elt = f1spreadParam match {
    | None() -> None()
    | Some(spread1) ->
      maybeGetRestElementType(subst, tenv, spread1, Contravariant()) match {
      | None() -> return STInvalidSpread(spread1, f1, f2)
      | some @ Some _ -> some
      }
    };

    for (i => p2 in f2params) {
      io1 = i - f1params.size();
      p1 = if (io1 < 0) {
        f1params[i]
      } else if (io1 < f1optionalParams.size()) {
        f1optionalParams[io1]
      } else {
        spread1elt match {
        | None() -> break void
        | Some(p) -> p
        }
      };
      TType::isSub(subst, tenv, p2, p1) match {
      | STOk() -> void
      | err @ STErrorOnTType _ -> return STRecFunParam(Some(err), i, f1, f2)
      }
    };

    for (io2 => p2 in f2optionalParams) {
      i = io2 + f2params.size();
      io1 = i - f1params.size();
      p1 = if (io1 < 0) {
        internal_error("f1.params.size() <= f2.params.size() checked above")
      } else if (io1 < f1optionalParams.size()) {
        f1optionalParams[io1]
      } else {
        spread1elt match {
        | None() -> break void
        | Some(p) -> p
        }
      };
      TType::isSub(subst, tenv, p2, p1) match {
      | STOk() -> void
      | err @ STErrorOnTType _ -> return STRecFunParam(Some(err), i, f1, f2)
      }
    };

    f2spreadParam match {
    | None() ->
      if (
        f1params.size() + f1optionalParams.size() >
        f2params.size() + f2optionalParams.size()
      ) {
        return STRecFunParam(
          None(),
          f2params.size() + f2optionalParams.size(),
          f1,
          f2,
        )
      };
      if (f1spreadParam.isSome()) {
        return STRecFunSpread(None(), f1, f2)
      }
    | Some(spread2) ->
      spread2elt = maybeGetRestElementType(
        subst,
        tenv,
        spread2,
        Covariant(),
      ) match {
      | None() -> return STInvalidSpread(spread2, f1, f2)
      | Some(spread2elt) -> spread2elt
      };
      for (io1 in Range(
        f2params.size() + f2optionalParams.size() - f1params.size(),
        f1optionalParams.size(),
      )) {
        TType::isSub(subst, tenv, spread2elt, f1optionalParams[io1]) match {
        | STOk() -> void
        | err @ STErrorOnTType _ ->
          return STRecFunOptionalSpread(err, io1 + f1params.size(), f1, f2)
        }
      };
      spread1elt match {
      | None() -> void
      | Some(s1) ->
        TType::isSub(subst, tenv, spread2elt, s1) match {
        | STOk() -> void
        | err @ STErrorOnTType _ -> return STRecFunSpread(Some(err), f1, f2)
        }
      }
    };
    TType::isSub(subst, tenv, f1.retType, f2.retType) match {
    | STOk() -> STOk()
    | err @ STErrorOnTType _ -> STRecFunReturn(err, f1, f2)
    }
  }
}

extension class TObject {
  static fun isSub(
    subst: mutable Subst,
    tenv: TEnv,
    obj1: TObject,
    obj2: TObject,
  ): STResult<TObject> {
    savedSubst = subst.save();
    for (fields1 in obj1.branches) {
      errors = List[];
      for (fields2 in obj2.branches) {
        savedBranchSubst = subst.save();
        TFields::isSub(subst, tenv, fields1, fields2) match {
        | STOk() -> break void
        | err @ STErrorOnTFields _ ->
          !errors = List.Cons((fields2, err), errors);
          subst.restore(savedBranchSubst)
        }
      } else {
        subst.restore(savedSubst);
        return STRecObject(errors, fields1, obj1, obj2)
      }
    };
    STOk()
  }
}

module end;
