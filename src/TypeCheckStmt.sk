module SKJS;

extension class TypeChecker {
  fun stmt(tcenv: mutable TCEnv, st: Stmt): void {
    st.value match {
    | Break() -> void
    | Continue() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(tcenv, e);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsVoid(tcenv, e.pos, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))
      | Some(e) -> (e.pos, this.expr(tcenv, e, true))
      };
      rtype = if (this.isAsync) {
        TType::single(TPromise(etype, epos))
      } else {
        etype
      };
      this.checkSubType(tcenv, epos, "Invalid return type", rtype, retType)

    | Bind(BKVar(), vars) ->
      if (vars.size() == 0) internal_error("vars size should not be 0");
      typingError(
        Array[(vars[0].pat.pos, "Don't use var, use let or const instead")],
      )

    | Bind(bkind, bindings) ->
      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          tcenv,
          bkind,
          binding.type,
          binding.value,
        );
        this.bind(
          tcenv,
          bkind,
          binding.pat,
          ty,
          isInitialized,
          binding.value is Some(Expr(_, Object _)),
        )
      }

    | If(e, block1, block2opt) ->
      block2 = block2opt.default(Array[]);
      this.checkBool(tcenv, e);
      scope1 = this.block(tcenv, block1, Some((e, true)));
      scope2 = this.block(tcenv, block2, Some((e, false)));
      (isTerminalBlock(false, block1), isTerminalBlock(false, block2)) match {
      | (true, true) -> void /* TODO: everything that follows is unreachable */
      | (true, false) -> tcenv.popScopeReplace(scope2)
      | (false, true) -> tcenv.popScopeReplace(scope1)
      | (false, false) -> tcenv.mergeScope(this.tenv, scope1, scope2)
      }

    | For(initStmt, cond, incr, block) ->
      (_void, initScope) = tcenv.withSubScope{
        isLoop => false,
        f => () -> {
          this.stmt(tcenv, initStmt);
          (_void, loopScope) = tcenv.withSubScope{
            isLoop => true,
            f => () -> {
              this.checkBool(tcenv, cond);
              loopBody = this.block(tcenv, block);
              tcenv.popScopeReplace(loopBody);
              _ = this.expr(tcenv, incr);
            },
          };
          tcenv.popScope(this.tenv, loopScope)
        },
      };
      tcenv.popScopeReplace(initScope)
    | Block(stmts) ->
      for (stmt in stmts) {
        this.stmt(tcenv, stmt)
      }
    | ForInOf(kind, initStmt, iterable, block) ->
      (_void, initScope) = tcenv.withSubScope{
        isLoop => false,
        f => () -> {
          iterableType = this.expr(tcenv, iterable, true);
          ty = kind match {
          | ForIn() ->
            this.tenv.forInKeys(tcenv.subst, iterableType, iterable.pos)
          | ForOf() -> this.getValueType(tcenv, iterable.pos, iterableType)
          };

          this.bindLoopVar(tcenv, initStmt, ty);

          (_void, loopScope) = tcenv.withSubScope{
            isLoop => true,
            f => () -> {
              loopBody = this.block(tcenv, block);
              tcenv.popScopeReplace(loopBody)
            },
          };
          tcenv.popScope(this.tenv, loopScope)
        },
      };
      tcenv.popScopeReplace(initScope)

    | Throw(e) -> _ = this.expr(tcenv, e)
    | While(cond, block) ->
      (_void, loopScope) = tcenv.withSubScope{
        isLoop => true,
        f => () -> {
          this.checkBool(tcenv, cond);
          loopBody = this.block(tcenv, block, Some((cond, true)));
          tcenv.popScopeReplace(loopBody)
        },
      };
      tcenv.popScope(this.tenv, loopScope)
    | Switch(e, branches) ->
      this.switchCheckExhaustiveness(tcenv, e, branches);
      this.switch(tcenv, e, branches)
    | Try(tryBlock, catchClause, finallyBlock) ->
      (_void, tryScope) = tcenv.withSubScope{
        isLoop => false,
        f => () -> {
          for (stmt in tryBlock) {
            this.stmt(tcenv, stmt)
          }
        },
      };
      tcenv.popScope(this.tenv, tryScope);

      catchClause match {
      | Some(CatchClause(param, type, catchBlock)) ->
        (_void2, catchScope) = tcenv.withSubScope{
          isLoop => false,
          f => () -> {
            param match {
            | Some(pat) ->
              errorType = type match {
              | Some(t) -> // If we trusted user: this.tenv.normalize(tcenv.context, t)
                typingError(
                  Array[
                    (
                      t.pos,
                      "Do not specify a type annotation for caught exceptions as it cannot be trusted",
                    ),
                  ],
                )
              | None() -> TType::top(pat.pos)
              };
              this.bind(tcenv, BKLet(), pat, errorType, true, false)
            | None() -> void
            };
            for (stmt in catchBlock) {
              this.stmt(tcenv, stmt)
            }
          },
        };
        tcenv.popScope(this.tenv, catchScope)
      | None() -> void
      };

      finallyBlock match {
      | Some(finallyStmts) ->
        (_void2, finallyScope) = tcenv.withSubScope{
          isLoop => false,
          f => () -> {
            for (stmt in finallyStmts) {
              this.stmt(tcenv, stmt)
            }
          },
        };
        tcenv.popScope(this.tenv, finallyScope)
      | None() -> void
      }
    }
  }

  fun switch(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    if (branches.size() == 0) {
      typingError(Array[(e.pos, "Missing branch")])
    };
    checkBreak = block -> {
      term = StmtTermination::block(block);
      if (term.mayFallthrough) {
        if (block.size() == 0) {
          internal_error("block size should not be 0")
        };
        last = block[block.size() - 1];
        typingError(Array[(last.pos, "Missing break")])
      }
    };
    scope = branches[0] match {
    | Case(v, block) ->
      checkBreak(block);
      cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
      this.block(tcenv, block, Some((cond, true)))
    | Default(_) -> typingError(Array[(e.pos, "Missing branch")])
    };
    for (i in Range(1, branches.size())) {
      tcenv.mergeScope(
        this.tenv,
        scope,
        branches[i] match {
        | Case(v, block) ->
          checkBreak(block);
          cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
          this.block(tcenv, block, Some((cond, true)))
        | Default(stmts) -> this.block(tcenv, stmts)
        },
      )
    }
  }

  fun switchCheckExhaustiveness(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    condType = this.expr(tcenv, e, true);
    cases = condType
      .getSTypes(tcenv.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(values), _)) ->
      Set::mcreateFromItems(values.values.map(x -> x.i1))
    | _ -> return void
    };
    for (branch in branches) {
      branch match {
      | Case(v, _) ->
        this.expr(tcenv, v, true)
          .getSTypes(tcenv.subst, this.tenv, Covariant())
          .flatMap(stypes ~> stypes.staticValue()) match {
        | Some(staticValue) ->
          if (!cases.contains(staticValue)) {
            typingError(Array[(v.pos, "Unused branch")])
          };
          cases.remove(staticValue)
        | None() -> void
        }

      | Default(stmts) ->
        if (cases.isEmpty()) {
          if (stmts.isEmpty()) {
            internal_error("Internal error: empty default");
          };
          typingError(Array[(stmts[0].pos, "Unused branch")])
        };
        cases.clear()
      }
    };
    if (!cases.isEmpty()) {
      typingError(Array[(e.pos, "Missing branches:\n" + cases.join("\n"))]);
    }
  }

  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {
    initStmt.value match {
    | Bind(kind, bindings) ->
      if (bindings.size() != 1) {
        typingError(
          Array[
            (
              initStmt.pos,
              "Loop variable declaration must have exactly one binding",
            ),
          ],
        )
      };
      binding = bindings[0];
      this.bind(tcenv, kind, binding.pat, varType, true, false)
    | _ ->
      typingError(Array[(initStmt.pos, "Invalid loop variable declaration")])
    }
  }

  fun getValueType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): TType {
    stypes = iterableType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ -> typingError(Array[(pos, "Invalid iterable type for for-of loop")])
    };

    result = TType::bottom(pos);
    for (stype in stypes) {
      stype match {
      | TObject(fields, _objectPos) ->
        if (fields.indexes.isEmpty()) {
          typingError(Array[(pos, "Invalid iterable type for for-of loop")])
        };
        for (index in fields.indexes) {
          !result = TType::union(
            tcenv.subst,
            this.tenv,
            result,
            index.valueType,
          )
        }
      | TTuple(tuple, _) ->
        for (elementType in tuple) {
          !result = TType::union(tcenv.subst, this.tenv, result, elementType)
        }
      | TPrimValue(TString(), _, _) ->
        !result = TType::union(
          tcenv.subst,
          this.tenv,
          result,
          TType::single(TPrimValue::string(pos)),
        )
      | _ ->
        typingError(
          Array[
            (pos, "for-of loop requires an array, string, or iterable type"),
          ],
        )
      }
    };
    result
  }
}

module end;
