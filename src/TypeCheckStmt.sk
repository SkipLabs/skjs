module SKJS;

extension class TypeChecker {
  fun stmt(tcenv: mutable TCEnv, st: Stmt): void {
    st.value match {
    | Break() -> void
    | Continue() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(tcenv, e);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsVoid(tcenv, e.pos, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))
      | Some(e) -> (e.pos, this.expr(tcenv, e, true))
      };
      rtype = if (this.isAsync) {
        TType::single(TPromise(etype, epos))
      } else {
        etype
      };
      this.checkSubType(tcenv, epos, "Invalid return type", rtype, retType)

    | Bind(BKVar(), _vars) ->
      typingError(Array[(st.pos, "Don't use var, use let or const instead")])

    | Bind(bkind, bindings) ->
      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          tcenv,
          bkind,
          binding.type,
          binding.value,
        );
        this.bind(
          tcenv,
          bkind,
          binding.pat,
          ty,
          isInitialized,
          binding.value is Some(Expr(_, Object _)),
        )
      }

    | If(e, block1, block2opt) ->
      block2 = block2opt.default(Array[]);
      this.checkBool(tcenv, e);
      (_void1, scope1) = tcenv.withSubScope<void>{
        isLoop => false,
        f => () -> {
          this.evalCond(tcenv, e, true);
          this.stmts(tcenv, block1)
        },
      };
      (_void2, scope2) = tcenv.withSubScope<void>{
        isLoop => false,
        f => () -> {
          this.evalCond(tcenv, e, false);
          this.stmts(tcenv, block2)
        },
      };
      (isTerminalBlock(false, block1), isTerminalBlock(false, block2)) match {
      | (true, true) -> void /* TODO: everything that follows is unreachable */
      | (true, false) -> tcenv.popScopeReplace(scope2)
      | (false, true) -> tcenv.popScopeReplace(scope1)
      | (false, false) -> tcenv.mergeScope(this.tenv, scope1, scope2)
      }

    | For(initStmt, cond, incr, block) ->
      tcenv.withSubScopeReplace(() -> {
        this.stmt(tcenv, initStmt);
        tcenv.withinLoop(() -> {
          this.checkBool(tcenv, cond);
          _ = tcenv.withForkedSubScopes<void>(
            this.tenv,
            () -> {
              this.evalCond(tcenv, cond, true);
              tcenv.withSubScopeReplace(() -> this.stmts(tcenv, block));
              _ = this.expr(tcenv, incr)
            },
            () -> {
              this.evalCond(tcenv, cond, false);
            },
          )
        })
      })

    | Block(stmts) -> this.stmts(tcenv, stmts)

    | ForInOf(kind, initStmt, iterable, block) ->
      tcenv.withSubScopeReplace(() -> {
        iterableType = this.expr(tcenv, iterable, true);
        ty = kind match {
        | ForIn() ->
          this.tenv.forInKeys(tcenv.subst, iterableType, iterable.pos)
        | ForOf() -> this.getValueType(tcenv, iterable.pos, iterableType)
        };

        this.bindLoopVar(tcenv, initStmt, ty);

        tcenv.withinLoop(() -> {
          _ = tcenv.withForkedSubScopes<void>(
            this.tenv,
            () -> {
              this.stmts(tcenv, block)
            },
            () -> void,
          )
        })
      })

    | Throw(e) -> _ = this.expr(tcenv, e)
    | While(cond, block) ->
      tcenv.withinLoop(() -> {
        this.checkBool(tcenv, cond);
        _ = tcenv.withForkedSubScopes<void>(
          this.tenv,
          () -> {
            this.evalCond(tcenv, cond, true);
            this.stmts(tcenv, block)
          },
          () -> {
            this.evalCond(tcenv, cond, false)
          },
        )
      })
    | Switch(e, branches) -> this.switch(tcenv, e, branches)
    | Try(tryBlock, catchClause, finallyBlock) ->
      tcenv.withSubScopeMerge{
        isLoop => false,
        tenv => this.tenv,
        f => () -> this.stmts(tcenv, tryBlock),
      };

      catchClause match {
      | Some(CatchClause(param, type, catchBlock)) ->
        tcenv.withSubScopeMerge{
          isLoop => false,
          tenv => this.tenv,
          f => () -> {
            param match {
            | Some(pat) ->
              errorType = type match {
              | Some(t) -> // If we trusted user: this.tenv.normalize(tcenv.context, t)
                typingError(
                  Array[
                    (
                      t.pos,
                      "Do not specify a type annotation for caught exceptions as it cannot be trusted",
                    ),
                  ],
                )
              | None() -> TType::top(pat.pos)
              };
              this.bind(tcenv, BKLet(), pat, errorType, true, false)
            | None() -> void
            };
            this.stmts(tcenv, catchBlock)
          },
        }
      | None() -> void
      };

      finallyBlock match {
      | Some(finallyStmts) ->
        tcenv.withSubScopeMerge{
          isLoop => false,
          tenv => this.tenv,
          f => () -> this.stmts(tcenv, finallyStmts),
        }
      | None() -> void
      }
    }
  }

  fun switch(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    if (branches.size() == 0) {
      typingError(Array[(e.pos, "Missing branch")])
    };
    if (branches.size() == 1) {
      typingError(Array[(e.pos, "Useless switch")])
    };
    exhaustive = this.switchCheckExhaustiveness(tcenv, e, branches);
    if (exhaustive) {
      this.switchHelper(tcenv, e, Vector::createFromItems(branches), 0)
    } else {
      branches1 = Vector::mcreateFromItems(branches);
      branches1.push(Default(Array[], e.pos));
      this.switchHelper(tcenv, e, branches1, 0)
    }
  }

  /* Interprets branches as
     if (e == branch[i]) ... else ... */
  private fun switchHelper(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: readonly Vector<SwitchBranch>,
    i: Int,
  ): void {
    branches[i] match {
    | Case(v, block, pos) ->
      cond = Expr(pos, Binop(BOStrictEquality(), e, v));
      if (i >= branches.size() - 1) {
        /* Last branch: because we know there are at least 2 branches, we are already in a sub-scope */
        this.evalCond(tcenv, cond, true);
        this.stmts(tcenv, block)
      } else {
        term = StmtTermination::block(block);
        if (term.mayFallthrough) {
          errorPos = if (block.size() == 0) pos else {
            block[block.size() - 1].pos
          };
          typingError(Array[(errorPos, "Missing break")]);
        };
        _ = tcenv.withForkedSubScopes<void>(
          this.tenv,
          () -> {
            this.evalCond(tcenv, cond, true);
            this.stmts(tcenv, block)
          },
          () -> {
            this.evalCond(tcenv, cond, false);
            this.switchHelper(tcenv, e, branches, i + 1)
          },
        );
      }
    | Default(block, pos) ->
      if (i < branches.size() - 1) {
        typingError(
          Array[
            (branches[i + 1].pos, "default must be the last branch"),
            (pos, "default branch is here"),
          ],
        )
      };
      /* Last branch: because we know there are at least 2 branches, we are already in a sub-scope */
      this.stmts(tcenv, block)
    }
  }

  fun switchCheckExhaustiveness(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): Bool {
    condType = this.expr(tcenv, e, true);
    cases = condType
      .getSTypes(tcenv.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(values), _)) ->
      Map::mcreateFromItems(values.values.map(x -> (x.i1, x.i0)))
    | _ ->
      /* branches.size() > 1 from the caller */
      return branches[branches.size() - 1] is Default _
    };
    for (branch in branches) {
      if (cases.isEmpty()) {
        typingError(Array[(branch.pos, "Unused branch")])
      };
      branch match {
      | Case(v, _, pos) ->
        this.expr(tcenv, v, true)
          .getSTypes(tcenv.subst, this.tenv, Covariant())
          .flatMap(stypes ~> stypes.staticValue()) match {
        | Some(staticValue) ->
          if (!cases.containsKey(staticValue)) {
            typingError(Array[(pos, "Unused branch")])
          };
          cases.remove(staticValue)
        | None() -> void
        }

      | Default(_stmts, _pos) -> cases.clear()
      }
    };
    if (!cases.isEmpty()) {
      missingCases = Vector::mcreateFromIterator(
        cases.items().map(x -> (x.i1, x.i0)),
      );
      missingCases.sortBy(x ~> x.i1);
      typingError(
        Array[(e.pos, "Missing branches")].concat(missingCases.toArray()),
      );
    };
    true
  }

  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {
    initStmt.value match {
    | Bind(kind, bindings) ->
      if (bindings.size() != 1) {
        typingError(
          Array[
            (
              initStmt.pos,
              "Loop variable declaration must have exactly one binding",
            ),
          ],
        )
      };
      binding = bindings[0];
      this.bind(tcenv, kind, binding.pat, varType, true, false)
    | _ ->
      typingError(Array[(initStmt.pos, "Invalid loop variable declaration")])
    }
  }

  fun getValueType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): TType {
    stypes = iterableType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ -> typingError(Array[(pos, "Invalid iterable type for for-of loop")])
    };

    result = TType::bottom(pos);
    for (stype in stypes) {
      stype match {
      | TObject(fields, _objectPos) ->
        if (fields.indexes.isEmpty()) {
          typingError(Array[(pos, "Invalid iterable type for for-of loop")])
        };
        for (index in fields.indexes) {
          !result = TType::union(
            tcenv.subst,
            this.tenv,
            result,
            index.valueType,
          )
        }
      | TTuple(tuple, _) ->
        for (elementType in tuple) {
          !result = TType::union(tcenv.subst, this.tenv, result, elementType)
        }
      | TPrimValue(TString(), _, _) ->
        !result = TType::union(
          tcenv.subst,
          this.tenv,
          result,
          TType::single(TPrimValue::string(pos)),
        )
      | _ ->
        typingError(
          Array[
            (pos, "for-of loop requires an array, string, or iterable type"),
          ],
        )
      }
    };
    result
  }
}

module end;
