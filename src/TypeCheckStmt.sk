module SKJS;

extension class TypeChecker {
  fun stmt(tcenv: mutable TCEnv, st: Stmt): void {
    tcenv.!stmtTerminations[st.pos] = StmtTermination::stmt(tcenv, st);
    st.value match {
    | Break() -> void
    | Continue() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(tcenv, e, false);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsIgnorable(tcenv, e.pos, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))
      | Some(e) -> (e.pos, this.expr(tcenv, e, true))
      };
      // In an async function the returned expression and the declared
      // return type are compared by awaited type, like tsc: `return p`
      // settles to p's payload at runtime, and an annotation's nested
      // promise layers flatten the same way.
      msg = "Type of returned value is not assignable to the function's return type";
      if (this.isAsync) {
        (
          etype.maybeAwaited(tcenv.subst, this, epos),
          retType.maybeAwaited(tcenv.subst, this, retType.pos),
        ) match {
        | (Some(subTy), Some(superTy)) ->
          this.checkSubType(tcenv, epos, msg, subTy, superTy, TSCode(2322))
        | (None(), _) ->
          // The returned value is a self-referential thenable (TS1062);
          // the comparison is meaningless and skipped.
          this.errorSelfReferentialThenable(tcenv, epos)
        | (Some _, None()) ->
          // A self-referential annotation is reported once, at the
          // declaration.
          void
        }
      } else {
        this.checkSubType(tcenv, epos, msg, etype, retType, TSCode(2322))
      }

    | Bind(bkind, bindings) ->
      if (bkind is BKVar()) {
        // `var` stays an error rather than a warning: unlike `let`/`const` it is
        // function-scoped and hoisted, which SKJS's block-scoped narrow-on-write
        // typing does not yet model. Supporting it soundly is tracked in
        // SkipLabs/skjs#841.
        tcenv.error(
          Array[(st.pos, "Unexpected 'var'; use 'let' or 'const' instead")],
          ESLintCode("no-var"),
        )
      };

      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          tcenv,
          bkind,
          binding.type,
          binding.value,
        );
        // Detect local objects: object literals (Object _) bound to variables.
        // These can grow by adding fields via assignment (obj.newField = value)
        // before being used. See TypeCheckEnv.sk:LocalObjectState for details.
        isLocalObject =
          binding.type.isNone() &&
          binding.value is Some(Expr(_, Object _));
        tcenv.!exprTypes[(binding.pat.pos, false, true)] = ty;
        this.bind(
          tcenv,
          bkind,
          binding.pat,
          ty,
          binding.type.isSome(),
          isInitialized,
          isLocalObject,
        )
      }

    | If(e, block1, block2opt) ->
      block2 = block2opt.default(Array[]);
      this.checkBool(tcenv, e);
      scope1 = this.block(tcenv, block1, Some((e, true)));
      scope2 = this.block(tcenv, block2, Some((e, false)));
      (isTerminalBlock(tcenv, block1), isTerminalBlock(tcenv, block2)) match {
      | (true, true) -> void /* TODO: everything that follows is unreachable */
      | (true, false) -> tcenv.popScopeReplace(scope2)
      | (false, true) -> tcenv.popScopeReplace(scope1)
      | (false, false) -> tcenv.mergeScope(this, scope1, scope2)
      }

    | For(initStmt, cond, incr, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;
      this.stmt(tcenv, initStmt);
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      loopBody = this.block(tcenv, block);
      tcenv.popScopeReplace(loopBody);
      _ = this.expr(tcenv, incr, false);
      tcenv.!scope = initScope;
      tcenv.popScope(this, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope)
    | Block(stmts) ->
      for (stmt in stmts) {
        this.stmt(tcenv, stmt)
      }
    | ForInOf(kind, initStmt, iterable, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;

      iterableType = this.expr(tcenv, iterable, true);
      ty = kind match {
      | ForIn() ->
        this.checkForInIterable(tcenv, iterable.pos, iterableType);
        TType::single(TPrimValue::string(st.pos))
      | ForOf() ->
        this.getValueType(tcenv, iterable.pos, iterableType, "for-of loop")
      };

      this.bindLoopVar(tcenv, initStmt, ty);

      // Enter for-in context for safe v[k]! detection
      enteredForIn =
        kind is ForIn() &&
        initStmt.value match {
        | Bind(_, bindings) if (bindings.size() == 1) ->
          bindings[0].pat.value match {
          | PVar(keyVar) ->
            ForInContext::exprToKey(iterable) match {
            | Some(iterableKey) ->
              tcenv.enterForIn(keyVar.value, iterableKey);
              true
            | None() -> false
            }
          | _ -> false
          }
        | _ -> false
        };

      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      loopBody = this.block(tcenv, block);
      tcenv.popScopeReplace(loopBody);
      tcenv.!scope = initScope;
      tcenv.popScope(this, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope);

      if (enteredForIn) tcenv.exitForIn()

    | Throw(e) -> _ = this.expr(tcenv, e, false)
    | While(cond, block) ->
      scopeCopy = tcenv.scope;
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      loopBody = this.block(tcenv, block, Some((cond, true)));
      tcenv.popScopeReplace(loopBody);
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this, loopScope)
    | Switch(e, branches) -> this.switch(tcenv, e, branches)
    | Try(tryBlock, catchClause, finallyBlock) ->
      scopeCopy = tcenv.scope;
      tryScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = tryScope;
      for (stmt in tryBlock) {
        this.stmt(tcenv, stmt)
      };
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this, tryScope);

      catchClause match {
      | Some(CatchClause(param, type, catchBlock)) ->
        catchScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = catchScope;
        param match {
        | Some(pat) ->
          errorType = type match {
          | Some(t) ->
            tcenv.error(
              Array[
                (
                  t.pos,
                  "A 'catch' clause variable may not have a type annotation",
                ),
              ],
              SKJSCode(2018),
            );
            this.normalize(tcenv, t)
          | None() -> TType::top(pat.pos)
          };
          tcenv.!exprTypes[(pat.pos, false, true)] = errorType;
          this.bind(tcenv, BKLet(), pat, errorType, false, true, false)
        | None() -> void
        };
        for (stmt in catchBlock) {
          this.stmt(tcenv, stmt)
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this, catchScope)
      | None() -> void
      };

      finallyBlock match {
      | Some(finallyStmts) ->
        finallyScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = finallyScope;
        for (stmt in finallyStmts) {
          this.stmt(tcenv, stmt)
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this, finallyScope)
      | None() -> void
      }
    }
  }

  fun switch(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    if (branches.size() == 0) {
      // An empty switch evaluates the scrutinee and does nothing else, which is
      // sound and which tsc accepts silently. Pointless, so still worth saying,
      // but a lint concern rather than an error — like the single-branch switch
      // just below.
      //
      // Report it before checking the scrutinee, not after: the scrutinee is
      // real code that reports its own errors, and one of those can abort the
      // definition, which would take this warning with it.
      tcenv.warning(
        Array[(e.pos, "A switch statement must have at least one case")],
        SKJSCode(2010),
      );
      _ = this.expr(tcenv, e, true);
      return void
    };
    if (branches.size() == 1) {
      tcenv.warning(
        Array[
          (
            e.pos,
            "This switch has a single branch; use an 'if' statement instead",
          ),
        ],
        SKJSCode(2011),
      )
    };
    condType = this.expr(tcenv, e, true);
    // The values the scrutinee can take, when they are enumerable. Otherwise
    // (e.g. a general `boolean`) there is no value set to judge reachability or
    // exhaustiveness against, and `casesKnown` turns both off; an empty `cases`
    // cannot stand in for that, since it reads as "everything is handled".
    (cases, casesKnown) = condType
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(lits), _)) ->
      (Map::mcreateFromIterator(lits.values().map(x -> (x.val, x.pos))), true)
    | _ -> (mutable Map<String, PosRange>[], false)
    };
    // Kept for truthful unreachability reasons: a case value can be
    // unreachable because it is not in the switched type at all, or because
    // an earlier case (e.g. an alias enum member with the same value) already
    // handled it. As each value is handled it moves from `cases` into
    // `handledBy` (which also records the handling case's position, to point
    // at it in the latter warning), so a value still in the switched type is
    // in exactly one of the two.
    handledBy = mutable Map<String, PosRange>[];
    // Two `default` positions, which differ only in a switch that has more than
    // one (already an error): the first names the clause a duplicate conflicts
    // with, and answers whether the switch has a `default` at all; the last is
    // the one reported unreachable below.
    seenDefault: ?PosRange = None();
    lastDefaultPos: ?PosRange = None();
    // A branch that always returns or throws never reaches the code after the
    // switch, so its scope is not one of the paths out and is left out of the
    // merge (`If` does the same, via `isTerminalBlock`). The block is still
    // checked either way — only its scope is dropped.
    scopes = mutable Vector<readonly Scope>[];
    // A block reached by falling through earlier clauses runs whenever any of
    // their labels matches, so it is narrowed by their disjunction, not just its
    // own label — refining `case 1: case 2: <body>` to `2` alone would be
    // unsound, since the body also runs when the scrutinee is `1`. A clause
    // falls into the next exactly when its block can complete normally, which an
    // empty one always does and one with statements does unless it breaks or
    // returns; `fallenInto` accumulates the labels of both. A `default` among
    // them makes the block reachable for any unmatched value, which no
    // disjunction of labels describes, so the group is then narrowed by nothing.
    fallenInto: ?Expr = None();
    fallenIntoDefault = false;
    // `default` runs only for a value no `case` matched, so its body is narrowed
    // by that: the conjunction of `scrutinee !== <label>` over the cases. Every
    // case counts, including any written after the `default` — where the clauses
    // sit says nothing about which values reach it.
    //
    // Which is why the labels are typed here rather than as each clause is
    // reached below: a condition can only be refined once the types of what it
    // compares are known, so a `default` could otherwise only rule out the cases
    // that happened to precede it.
    noCaseMatched: ?Expr = None();
    for (branch in branches) {
      branch match {
      | SwitchBranch(Case(v), _, _) ->
        _ = this.expr(tcenv, v, true);
        ne = Expr(e.pos, (Binop(BOStrictInequality(), e, v)));
        !noCaseMatched = Some(
          noCaseMatched match {
          | None() -> ne
          | Some(acc) -> Expr(e.pos, (Binop(BOLogicalAnd(), acc, ne)))
          },
        )
      | SwitchBranch(Default(), _, _) -> void
      }
    };
    for (i in Range(0, branches.size())) {
      block = branches[i].block;
      // How the block ends answers both questions asked of it below: whether it
      // falls through into the next clause, and whether it is a path out of the
      // switch at all.
      blockTerm = StmtTermination::block(tcenv, block);
      cond = branches[i] match {
      | SwitchBranch(Case(v), _, pos) ->
        // Typed with the other labels above, along with everything that reads a
        // label's type: this and the narrowing of the block below.
        condVType = this.lookupExprType(tcenv, v);
        // A switch case must be a plain value, so that case-evaluation order
        // and `===` narrowing are sound. Enum member reads (`E.A`, `E["A"]`,
        // `E[0]` on an unshadowed enum name) are plain data-property reads and
        // exempt — a bare name never throws and enum members are not accessors;
        // every other case must be provably non-throwing. This lives here
        // rather than in the Termination pass because the exemption needs name
        // resolution, which that pass has no defMap for.
        enumMemberBase = v.value match {
        | Dot(NormalDot(), Expr(_, Var(b)), _) -> Some(b)
        | Get(
          Expr(_, Var(b)),
          key,
        ) if (this.directLiteralSType(key) is Some _) ->
          Some(b)
        | _ -> None()
        };
        isEnumMember = enumMemberBase match {
        | Some(b) ->
          tcenv.scope.maybeGet(b) is None() &&
            this.defMap.getAll(tcenv, b).any(d -> d is Enum _)
        | None() -> false
        };
        if (!isEnumMember) {
          StmtTermination::expr(v).mayNonThrough().each(term ->
            tcenv.error(
              Array[
                (
                  v.pos,
                  `A switch case expression must be a plain value, but this one may ${term}.`,
                ),
              ],
              SKJSCode(2055),
            )
          )
        };
        if (casesKnown) {
          condVType.getSTypes(tcenv.subst, this, Covariant()).flatMap(stypes ~>
            stypes.staticValue()
          ) match {
          | Some(staticValue) ->
            if (cases.containsKey(staticValue)) {
              cases.remove(staticValue);
              handledBy![staticValue] = pos
            } else {
              handledBy.maybeGet(staticValue) match {
              | Some(earlierPos) ->
                tcenv.warning(
                  Array[
                    (
                      pos,
                      "This case is unreachable: its value is already handled by an earlier case",
                    ),
                    (earlierPos, "The value is first handled here"),
                  ],
                  SKJSCode(2014),
                )
              | None() ->
                tcenv.warning(
                  Array[
                    (
                      pos,
                      "This case is unreachable: its value is not in the switched type",
                    ),
                  ],
                  SKJSCode(2014),
                )
              }
            }
          | None() -> void
          }
        };
        // Falling *through* means running one clause's statements and then
        // running the next clause's too. An empty clause has none to run — it
        // is how several labels are given one body — and the last clause has
        // nothing to fall into, so neither is a fallthrough. tsc's
        // `noFallthroughCasesInSwitch` exempts both for the same reason.
        //
        // Whether the rest is an error is that option's to say. SKJS turns it on
        // where tsc leaves it off, but a switch that asks for the fallthrough
        // gets it: only the diagnostic is withheld, never the narrowing of the
        // clause fallen into, which is what keeps the fallthrough sound.
        if (
          this.noFallthroughCasesInSwitch &&
          blockTerm.mayFallthrough &&
          block.size() != 0 &&
          i != branches.size() - 1
        ) {
          tcenv.error(
            Array[
              (
                block[block.size() - 1].pos,
                "Fallthrough case in switch; add a 'break'",
              ),
            ],
            TSCode(7029),
          )
        };
        eq = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
        reachedBy = fallenInto match {
        | None() -> eq
        | Some(prev) -> Expr(e.pos, (Binop(BOLogicalOr(), prev, eq)))
        };
        cond = if (fallenIntoDefault) None() else Some((reachedBy, true));
        if (blockTerm.mayFallthrough) {
          !fallenInto = Some(reachedBy)
        } else {
          !fallenInto = None();
          !fallenIntoDefault = false
        };
        cond
      | SwitchBranch(Default(), _, pos) ->
        // A switch may contain at most one `default` clause; a second one is a
        // JavaScript SyntaxError (tsc reports TS1113). Reject every `default`
        // after the first.
        seenDefault match {
        | Some(firstDefaultPos) ->
          tcenv.error(
            Array[
              (
                pos,
                "A 'default' clause cannot appear more than once in a 'switch' statement",
              ),
              (firstDefaultPos, "First 'default' clause was here"),
            ],
            TSCode(1113),
          )
        | None() -> !seenDefault = Some(pos)
        };
        !lastDefaultPos = Some(pos);
        if (i != branches.size() - 1) {
          // A `default` clause that is not last is a lint concern, not a
          // soundness error: at runtime `default` is only taken when no `case`
          // matches, so its position never changes which branch runs. tsc does
          // not reject it.
          tcenv.warning(
            Array[
              (
                pos,
                "The 'default' clause should be the last branch of a switch",
              ),
            ],
            ESLintCode("default-case-last"),
          )
        };
        cond = noCaseMatched match {
        // No case to rule out: the `default` runs whatever the scrutinee is.
        | None() -> None()
        | Some(noCase) ->
          // Empty clauses falling in bring their own labels, which the body is
          // reached by just as much as by matching no case at all.
          Some(
            (
              fallenInto match {
              | None() -> noCase
              | Some(prev) -> Expr(e.pos, (Binop(BOLogicalOr(), noCase, prev)))
              },
              true,
            ),
          )
        };
        if (blockTerm.mayFallthrough) {
          !fallenIntoDefault = true
        } else {
          !fallenInto = None();
          !fallenIntoDefault = false
        };
        cond
      };
      scopeBranch = this.block(tcenv, block, cond);
      if (!blockTerm.isTerminal()) scopes.push(scopeBranch)
    };
    // A `default` covers exactly the values matched by no `case`, before or
    // after it in source order, so its reachability depends on the full set of
    // cases and is settled only now: judging it inline would let a non-last
    // `default` wrongly pre-empt the cases that follow it (clearing them from
    // `cases`, which then mis-flags them "not in the switched type").
    if (casesKnown) {
      lastDefaultPos match {
      | Some(pos) ->
        if (cases.isEmpty()) {
          tcenv.warning(
            Array[
              (
                pos,
                "This 'default' case is unreachable: all values of the switched type are already handled",
              ),
            ],
            SKJSCode(2014),
          )
        } else {
          cases.clear()
        }
      | None() -> void
      };
      if (!cases.isEmpty()) {
        missingCases = Vector::mcreateFromIterator(
          cases.items().map(x -> (x.i1, x.i0)),
        );
        missingCases.sortBy(x ~> x.i1);
        // A non-exhaustive switch is a lint concern, not a soundness error: tsc
        // does not require exhaustiveness, and SKJS does not rely on this
        // verdict — reachability/termination is decided separately and
        // syntactically (a switch is exhaustive-for-termination only with a
        // literal `default`), as is the scope merge's untouched path below.
        // Deriving those from the verdict instead is SkipLabs/skjs#863.
        tcenv.warning(
          Array[
            (
              e.pos,
              "Switch is not exhaustive; the following cases are unhandled",
            ),
          ].concat(missingCases.toArray()),
          ESLintCode("@typescript-eslint/switch-exhaustiveness-check"),
        )
      }
    };
    // Each remaining branch is a path out of the switch, so they must all be
    // merged at once: folding the two-scope `merge` pairwise against a fixed
    // first branch discards every branch in between, leaving only first and last.
    //
    // Without a `default` there is one more path — matching no clause at all,
    // which leaves every binding at its pre-switch value. (Exhaustiveness is
    // taken syntactically here: a switch that covers its scrutinee's type
    // without a `default` still counts this path, which only widens. See
    // SkipLabs/skjs#863.)
    tcenv.mergeScopes(this, scopes.toArray(), seenDefault is None())
  }

  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {
    initStmt.value match {
    | Bind(kind, bindings) ->
      if (bindings.size() != 1) {
        tcenv.error(
          Array[
            (
              initStmt.pos,
              "A loop variable declaration must declare exactly one binding",
            ),
          ],
          SKJSCode(2016),
        )
      };
      for (binding in bindings) {
        tcenv.!exprTypes[(binding.pat.pos, false, true)] = varType;
        this.bind(
          tcenv,
          kind,
          binding.pat,
          varType,
          binding.type.isSome(),
          true,
          false,
        )
      }
    | _ ->
      tcenv.error(
        Array[
          (
            initStmt.pos,
            "A loop variable must be a simple 'let' or 'const' binding",
          ),
        ],
        SKJSCode(2017),
      )
    }
  }

  fun checkForInIterable(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): void {
    // TypeScript error code: TS2407
    iterableType.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> void
    | Some(stypes) ->
      if (
        !stypes.isEmpty() &&
        stypes.all(stype ->
          stype match {
          | TObject _ -> true
          | _ -> false
          }
        )
      ) return void
    };
    tcenv.error(
      Array[
        (
          pos,
          "The right-hand side of a 'for...in' statement must be an object or array type",
        ),
        (
          iterableType.pos,
          `Here it has type ${this.ppType(tcenv, iterableType)}`,
        ),
      ],
      TSCode(2407),
    )
  }

  fun getValueType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
    iterationKind: String,
  ): TType {
    result = TType::bottom(pos);

    stypes = iterableType.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ ->
      tcenv.error(
        Array[(pos, `Type is not iterable in a '${iterationKind}'`)],
        TSCode(2488),
      );
      return result
    };

    for (stype in stypes) {
      stype match {
      | obj @ TObject _ ->
        this.getIteratorElementType(tcenv.subst, obj, pos) match {
        | Some(elementType) ->
          !result = TType::union(tcenv.subst, this, result, elementType)
        | None() ->
          tcenv.error(
            Array[(pos, `Type is not iterable in a '${iterationKind}'`)],
            TSCode(2488),
          )
        }
      | TPrimValue(TString(), _, _) ->
        !result = TType::union(
          tcenv.subst,
          this,
          result,
          TType::single(TPrimValue::string(pos)),
        )
      | _ ->
        tcenv.error(
          Array[
            (
              pos,
              `${iterationKind} requires an array, string, or iterable type`,
            ),
          ],
          TSCode(2488),
        )
      }
    };
    result
  }
}

module end;
