module SKJS;

extension class TypeChecker {
  fun stmt(tcenv: mutable TCEnv, st: Stmt): void {
    tcenv.!stmtTerminations[st.pos] = StmtTermination::stmt(tcenv, st);
    st.value match {
    | Break() -> void
    | Continue() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(tcenv, e, false);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsIgnorable(tcenv, e.pos, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))
      | Some(e) -> (e.pos, this.expr(tcenv, e, true))
      };
      // In an async function the returned expression and the declared
      // return type are compared by awaited type, like tsc: `return p`
      // settles to p's payload at runtime, and an annotation's nested
      // promise layers flatten the same way.
      msg = "Type of returned value is not assignable to the function's return type";
      if (this.isAsync) {
        (
          etype.maybeAwaited(tcenv.subst, this, epos),
          retType.maybeAwaited(tcenv.subst, this, retType.pos),
        ) match {
        | (Some(subTy), Some(superTy)) ->
          this.checkSubType(tcenv, epos, msg, subTy, superTy, TSCode(2322))
        | (None(), _) ->
          // The returned value is a self-referential thenable (TS1062);
          // the comparison is meaningless and skipped.
          this.errorSelfReferentialThenable(tcenv, epos)
        | (Some _, None()) ->
          // A self-referential annotation is reported once, at the
          // declaration.
          void
        }
      } else {
        this.checkSubType(tcenv, epos, msg, etype, retType, TSCode(2322))
      }

    | Bind(bkind, bindings) ->
      if (bkind is BKVar()) {
        tcenv.error(
          Array[(st.pos, "Unexpected 'var'; use 'let' or 'const' instead")],
          ESLintCode("no-var"),
        )
      };

      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          tcenv,
          bkind,
          binding.type,
          binding.value,
        );
        // Detect local objects: object literals (Object _) bound to variables.
        // These can grow by adding fields via assignment (obj.newField = value)
        // before being used. See TypeCheckEnv.sk:LocalObjectState for details.
        isLocalObject =
          binding.type.isNone() &&
          binding.value is Some(Expr(_, Object _));
        tcenv.!exprTypes[binding.pat.pos] = ty;
        this.bind(tcenv, bkind, binding.pat, ty, isInitialized, isLocalObject)
      }

    | If(e, block1, block2opt) ->
      block2 = block2opt.default(Array[]);
      this.checkBool(tcenv, e);
      scope1 = this.block(tcenv, block1, Some((e, true)));
      scope2 = this.block(tcenv, block2, Some((e, false)));
      (isTerminalBlock(tcenv, block1), isTerminalBlock(tcenv, block2)) match {
      | (true, true) -> void /* TODO: everything that follows is unreachable */
      | (true, false) -> tcenv.popScopeReplace(scope2)
      | (false, true) -> tcenv.popScopeReplace(scope1)
      | (false, false) -> tcenv.mergeScope(this, scope1, scope2)
      }

    | For(initStmt, cond, incr, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;
      this.stmt(tcenv, initStmt);
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      loopBody = this.block(tcenv, block);
      tcenv.popScopeReplace(loopBody);
      _ = this.expr(tcenv, incr, false);
      tcenv.!scope = initScope;
      tcenv.popScope(this, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope)
    | Block(stmts) ->
      for (stmt in stmts) {
        this.stmt(tcenv, stmt)
      }
    | ForInOf(kind, initStmt, iterable, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;

      iterableType = this.expr(tcenv, iterable, true);
      ty = kind match {
      | ForIn() ->
        this.checkForInIterable(tcenv, iterable.pos, iterableType);
        TType::single(TPrimValue::string(st.pos))
      | ForOf() ->
        this.getValueType(tcenv, iterable.pos, iterableType, "for-of loop")
      };

      this.bindLoopVar(tcenv, initStmt, ty);

      // Enter for-in context for safe v[k]! detection
      enteredForIn =
        kind is ForIn() &&
        initStmt.value match {
        | Bind(_, bindings) if (bindings.size() == 1) ->
          bindings[0].pat.value match {
          | PVar(keyVar) ->
            ForInContext::exprToKey(iterable) match {
            | Some(iterableKey) ->
              tcenv.enterForIn(keyVar.value, iterableKey);
              true
            | None() -> false
            }
          | _ -> false
          }
        | _ -> false
        };

      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      loopBody = this.block(tcenv, block);
      tcenv.popScopeReplace(loopBody);
      tcenv.!scope = initScope;
      tcenv.popScope(this, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope);

      if (enteredForIn) tcenv.exitForIn()

    | Throw(e) -> _ = this.expr(tcenv, e, false)
    | While(cond, block) ->
      scopeCopy = tcenv.scope;
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      loopBody = this.block(tcenv, block, Some((cond, true)));
      tcenv.popScopeReplace(loopBody);
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this, loopScope)
    | Switch(e, branches) -> this.switch(tcenv, e, branches)
    | Try(tryBlock, catchClause, finallyBlock) ->
      scopeCopy = tcenv.scope;
      tryScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = tryScope;
      for (stmt in tryBlock) {
        this.stmt(tcenv, stmt)
      };
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this, tryScope);

      catchClause match {
      | Some(CatchClause(param, type, catchBlock)) ->
        catchScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = catchScope;
        param match {
        | Some(pat) ->
          errorType = type match {
          | Some(t) ->
            tcenv.error(
              Array[
                (
                  t.pos,
                  "A 'catch' clause variable may not have a type annotation",
                ),
              ],
              SKJSCode(2018),
            );
            this.normalize(tcenv, t)
          | None() -> TType::top(pat.pos)
          };
          tcenv.!exprTypes[pat.pos] = errorType;
          this.bind(tcenv, BKLet(), pat, errorType, true, false)
        | None() -> void
        };
        for (stmt in catchBlock) {
          this.stmt(tcenv, stmt)
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this, catchScope)
      | None() -> void
      };

      finallyBlock match {
      | Some(finallyStmts) ->
        finallyScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = finallyScope;
        for (stmt in finallyStmts) {
          this.stmt(tcenv, stmt)
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this, finallyScope)
      | None() -> void
      }
    }
  }

  fun switch(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    if (branches.size() == 0) {
      tcenv.error(
        Array[(e.pos, "A switch statement must have at least one case")],
        SKJSCode(2010),
      );
      return void
    };
    if (branches.size() == 1) {
      tcenv.warning(
        Array[
          (
            e.pos,
            "This switch has a single branch; use an 'if' statement instead",
          ),
        ],
        SKJSCode(2011),
      )
    };
    _exhaustive = this.switchCheckExhaustiveness(tcenv, e, branches);
    checkBreak = (pos, block) -> {
      term = StmtTermination::block(tcenv, block);
      if (term.mayFallthrough) {
        if (block.size() != 0) {
          !pos = block[block.size() - 1].pos;
        };
        tcenv.error(
          Array[(pos, "Fallthrough case in switch; add a 'break'")],
          TSCode(7029),
        )
      }
    };
    scope = branches[0] match {
    | SwitchBranch(Case(v), block, pos) ->
      checkBreak(pos, block);
      cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
      this.block(tcenv, block, Some((cond, true)))
    | SwitchBranch(Default(), block, _) ->
      tcenv.error(
        Array[
          (e.pos, "The 'default' clause must be the last branch of a switch"),
        ],
        ESLintCode("default-case-last"),
      );
      this.block(tcenv, block, None())
    };
    for (i in Range(1, branches.size())) {
      cond = branches[i] match {
      | SwitchBranch(Case(v), block, pos) ->
        checkBreak(pos, block);
        Some((Expr(e.pos, (Binop(BOStrictEquality(), e, v))), true))
      | SwitchBranch(Default(), _, _) -> None()
      };
      scopeBranch = this.block(tcenv, branches[i].block, cond);
      tcenv.mergeScope(this, scope, scopeBranch)
    }
  }

  fun switchCheckExhaustiveness(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): Bool {
    condType = this.expr(tcenv, e, true);
    cases = condType
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(lits), _)) ->
      Map::mcreateFromIterator(lits.values().map(x -> (x.val, x.pos)))
    | _ ->
      /* branches.size() > 1 from the caller */
      return branches[branches.size() - 1] is SwitchBranch(Default(), _, _)
    };
    for (branch in branches) {
      if (cases.isEmpty()) {
        tcenv.warning(
          Array[
            (
              branch.pos,
              "This case is unreachable: its value is not in the switched type",
            ),
          ],
          SKJSCode(2014),
        );
        break void
      };
      branch match {
      | SwitchBranch(Case(v), _, pos) ->
        this.expr(tcenv, v, true)
          .getSTypes(tcenv.subst, this, Covariant())
          .flatMap(stypes ~> stypes.staticValue()) match {
        | Some(staticValue) ->
          if (!cases.containsKey(staticValue)) {
            tcenv.warning(
              Array[
                (
                  pos,
                  "This case is unreachable: its value is not in the switched type",
                ),
              ],
              SKJSCode(2014),
            )
          } else {
            cases.remove(staticValue)
          }
        | None() -> void
        }
      | SwitchBranch(Default(), _stmts, _pos) -> cases.clear()
      }
    };
    if (!cases.isEmpty()) {
      missingCases = Vector::mcreateFromIterator(
        cases.items().map(x -> (x.i1, x.i0)),
      );
      missingCases.sortBy(x ~> x.i1);
      tcenv.error(
        Array[
          (
            e.pos,
            "Switch is not exhaustive; the following cases are unhandled",
          ),
        ].concat(missingCases.toArray()),
        ESLintCode("@typescript-eslint/switch-exhaustiveness-check"),
      );
    };
    true
  }

  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {
    initStmt.value match {
    | Bind(kind, bindings) ->
      if (bindings.size() != 1) {
        tcenv.error(
          Array[
            (
              initStmt.pos,
              "A loop variable declaration must declare exactly one binding",
            ),
          ],
          SKJSCode(2016),
        )
      };
      for (binding in bindings) {
        tcenv.!exprTypes[binding.pat.pos] = varType;
        this.bind(tcenv, kind, binding.pat, varType, true, false)
      }
    | _ ->
      tcenv.error(
        Array[
          (
            initStmt.pos,
            "A loop variable must be a simple 'let' or 'const' binding",
          ),
        ],
        SKJSCode(2017),
      )
    }
  }

  fun checkForInIterable(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): void {
    // TypeScript error code: TS2407
    iterableType.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> void
    | Some(stypes) ->
      if (
        !stypes.isEmpty() &&
        stypes.all(stype ->
          stype match {
          | TObject _ -> true
          | _ -> false
          }
        )
      ) return void
    };
    tcenv.error(
      Array[
        (
          pos,
          "The right-hand side of a 'for...in' statement must be an object or array type",
        ),
        (
          iterableType.pos,
          `Here it has type ${this.ppType(tcenv, iterableType)}`,
        ),
      ],
      TSCode(2407),
    )
  }

  fun getValueType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
    iterationKind: String,
  ): TType {
    result = TType::bottom(pos);

    stypes = iterableType.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ ->
      tcenv.error(
        Array[(pos, `Type is not iterable in a '${iterationKind}'`)],
        TSCode(2488),
      );
      return result
    };

    for (stype in stypes) {
      stype match {
      | obj @ TObject _ ->
        this.getIteratorElementType(tcenv.subst, obj, pos) match {
        | Some(elementType) ->
          !result = TType::union(tcenv.subst, this, result, elementType)
        | None() ->
          tcenv.error(
            Array[(pos, `Type is not iterable in a '${iterationKind}'`)],
            TSCode(2488),
          )
        }
      | TPrimValue(TString(), _, _) ->
        !result = TType::union(
          tcenv.subst,
          this,
          result,
          TType::single(TPrimValue::string(pos)),
        )
      | _ ->
        tcenv.error(
          Array[
            (
              pos,
              `${iterationKind} requires an array, string, or iterable type`,
            ),
          ],
          TSCode(2488),
        )
      }
    };
    result
  }
}

module end;
