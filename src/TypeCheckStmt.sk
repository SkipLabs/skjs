module SKJS;

extension class TypeChecker {
  fun stmt(tcenv: mutable TCEnv, st: Stmt): void {
    st.value match {
    | Break() -> void
    | Continue() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(tcenv, e, false);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsIgnorable(tcenv, e.pos, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))
      | Some(e) -> (e.pos, this.expr(tcenv, e, true))
      };
      rtype = if (this.isAsync) {
        TType::single(TPromise(etype, epos))
      } else {
        etype
      };
      this.checkSubType(tcenv, epos, "Invalid return type", rtype, retType)

    | Bind(bkind, bindings) ->
      if (bkind is BKVar()) {
        tcenv.error(Array[(st.pos, "Don't use var, use let or const instead")])
      };

      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          tcenv,
          bkind,
          binding.type,
          binding.value,
        );
        this.bind(
          tcenv,
          bkind,
          binding.pat,
          ty,
          isInitialized,
          binding.value is Some(Expr(_, Object _)),
        )
      }

    | If(e, block1, block2opt) ->
      block2 = block2opt.default(Array[]);
      this.checkBool(tcenv, e);
      scope1 = this.block(tcenv, block1, Some((e, true)));
      scope2 = this.block(tcenv, block2, Some((e, false)));
      (isTerminalBlock(tcenv, block1), isTerminalBlock(tcenv, block2)) match {
      | (true, true) -> void /* TODO: everything that follows is unreachable */
      | (true, false) -> tcenv.popScopeReplace(scope2)
      | (false, true) -> tcenv.popScopeReplace(scope1)
      | (false, false) -> tcenv.mergeScope(this.tenv, scope1, scope2)
      }

    | For(initStmt, cond, incr, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;
      this.stmt(tcenv, initStmt);
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      loopBody = this.block(tcenv, block);
      tcenv.popScopeReplace(loopBody);
      _ = this.expr(tcenv, incr, false);
      tcenv.!scope = initScope;
      tcenv.popScope(this.tenv, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope)
    | Block(stmts) ->
      for (stmt in stmts) {
        this.stmt(tcenv, stmt)
      }
    | ForInOf(kind, initStmt, iterable, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;

      iterableType = this.expr(tcenv, iterable, true);
      ty = kind match {
      | ForIn() ->
        this.checkForInIterable(tcenv, iterable.pos, iterableType);
        TType::single(TPrimValue::string(st.pos))
      | ForOf() -> this.getValueType(tcenv, iterable.pos, iterableType)
      };

      this.bindLoopVar(tcenv, initStmt, ty);

      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      loopBody = this.block(tcenv, block);
      tcenv.popScopeReplace(loopBody);
      tcenv.!scope = initScope;
      tcenv.popScope(this.tenv, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope)

    | Throw(e) -> _ = this.expr(tcenv, e, false)
    | While(cond, block) ->
      scopeCopy = tcenv.scope;
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      loopBody = this.block(tcenv, block, Some((cond, true)));
      tcenv.popScopeReplace(loopBody);
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this.tenv, loopScope)
    | Switch(e, branches) -> this.switch(tcenv, e, branches)
    | Try(tryBlock, catchClause, finallyBlock) ->
      scopeCopy = tcenv.scope;
      tryScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = tryScope;
      for (stmt in tryBlock) {
        this.stmt(tcenv, stmt)
      };
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this.tenv, tryScope);

      catchClause match {
      | Some(CatchClause(param, type, catchBlock)) ->
        catchScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = catchScope;
        param match {
        | Some(pat) ->
          errorType = type match {
          | Some(t) ->
            tcenv.error(
              Array[
                (
                  t.pos,
                  "Do not specify a type annotation for caught exceptions as it cannot be trusted",
                ),
              ],
            );
            this.tenv.normalize(tcenv, t)
          | None() -> TType::top(pat.pos)
          };
          this.bind(tcenv, BKLet(), pat, errorType, true, false)
        | None() -> void
        };
        for (stmt in catchBlock) {
          this.stmt(tcenv, stmt)
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this.tenv, catchScope)
      | None() -> void
      };

      finallyBlock match {
      | Some(finallyStmts) ->
        finallyScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = finallyScope;
        for (stmt in finallyStmts) {
          this.stmt(tcenv, stmt)
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this.tenv, finallyScope)
      | None() -> void
      }
    }
  }

  fun switch(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    if (branches.size() == 0) {
      tcenv.error(Array[(e.pos, "Missing branch")]);
      return void
    };
    if (branches.size() == 1) {
      tcenv.error(Array[(e.pos, "Useless switch")])
    };
    _exhaustive = this.switchCheckExhaustiveness(tcenv, e, branches);
    checkBreak = (pos, block) -> {
      term = StmtTermination::block(tcenv, block);
      if (term.mayFallthrough) {
        if (block.size() != 0) {
          !pos = block[block.size() - 1].pos;
        };
        tcenv.error(Array[(pos, "Missing break")])
      }
    };
    scope = branches[0] match {
    | SwitchBranch(Case(v), block, pos) ->
      checkBreak(pos, block);
      cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
      this.block(tcenv, block, Some((cond, true)))
    | SwitchBranch(Default(), block, _) ->
      tcenv.error(Array[(e.pos, "Missing branch")]);
      this.block(tcenv, block, None())
    };
    for (i in Range(1, branches.size())) {
      cond = branches[i] match {
      | SwitchBranch(Case(v), block, pos) ->
        checkBreak(pos, block);
        Some((Expr(e.pos, (Binop(BOStrictEquality(), e, v))), true))
      | SwitchBranch(Default(), _, _) -> None()
      };
      scopeBranch = this.block(tcenv, branches[i].block, cond);
      tcenv.mergeScope(this.tenv, scope, scopeBranch)
    }
  }

  fun switchCheckExhaustiveness(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): Bool {
    condType = this.expr(tcenv, e, true);
    cases = condType
      .getSTypes(tcenv.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(lits), _)) ->
      Map::mcreateFromIterator(lits.values().map(x -> (x.val, x.pos)))
    | _ ->
      /* branches.size() > 1 from the caller */
      return branches[branches.size() - 1] is SwitchBranch(Default(), _, _)
    };
    for (branch in branches) {
      if (cases.isEmpty()) {
        tcenv.error(Array[(branch.pos, "Unused branch")]);
        break void
      };
      branch match {
      | SwitchBranch(Case(v), _, pos) ->
        this.expr(tcenv, v, true)
          .getSTypes(tcenv.subst, this.tenv, Covariant())
          .flatMap(stypes ~> stypes.staticValue()) match {
        | Some(staticValue) ->
          if (!cases.containsKey(staticValue)) {
            tcenv.error(Array[(pos, "Unused branch")])
          } else {
            cases.remove(staticValue)
          }
        | None() -> void
        }
      | SwitchBranch(Default(), _stmts, _pos) -> cases.clear()
      }
    };
    if (!cases.isEmpty()) {
      missingCases = Vector::mcreateFromIterator(
        cases.items().map(x -> (x.i1, x.i0)),
      );
      missingCases.sortBy(x ~> x.i1);
      tcenv.error(
        Array[(e.pos, "Missing branches")].concat(missingCases.toArray()),
      );
    };
    true
  }

  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {
    initStmt.value match {
    | Bind(kind, bindings) ->
      if (bindings.size() != 1) {
        tcenv.error(
          Array[
            (
              initStmt.pos,
              "Loop variable declaration must have exactly one binding",
            ),
          ],
        )
      };
      for (binding in bindings) {
        this.bind(tcenv, kind, binding.pat, varType, true, false)
      }
    | _ ->
      tcenv.error(Array[(initStmt.pos, "Invalid loop variable declaration")])
    }
  }

  fun checkForInIterable(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): void {
    // TypeScript error code: TS2407
    iterableType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
    | None() -> void
    | Some(stypes) ->
      if (
        !stypes.isEmpty() &&
        stypes.all(stype ->
          stype match {
          | TObject _
          | TTuple _ ->
            true
          | _ -> false
          }
        )
      ) return void
    };
    tcenv.error(
      Array[
        (pos, "for-in loop requires an object or array type"),
        (iterableType.pos, `Here it has type ${iterableType}`),
      ],
    )
  }

  fun getValueType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): TType {
    result = TType::bottom(pos);

    stypes = iterableType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ ->
      tcenv.error(Array[(pos, "Invalid iterable type for for-of loop")]);
      return result
    };

    for (stype in stypes) {
      stype match {
      | TObject(_, _, fields, _objectPos) ->
        if (fields.indexes.isEmpty()) {
          tcenv.error(Array[(pos, "Invalid iterable type for for-of loop")])
        };
        for (index in fields.indexes) {
          !result = TType::union(
            tcenv.subst,
            this.tenv,
            result,
            index.valueType,
          )
        }
      | TTuple(tuple, _) ->
        for (elementType in tuple) {
          !result = TType::union(tcenv.subst, this.tenv, result, elementType)
        }
      | TPrimValue(TString(), _, _) ->
        !result = TType::union(
          tcenv.subst,
          this.tenv,
          result,
          TType::single(TPrimValue::string(pos)),
        )
      | _ ->
        tcenv.error(
          Array[
            (pos, "for-of loop requires an array, string, or iterable type"),
          ],
        )
      }
    };
    result
  }
}

module end;
