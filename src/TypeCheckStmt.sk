module SKJS;

extension class TypeChecker {
  // Checking a statement also answers how it ends: the termination is computed
  // from the same walk, arm by arm, and cached for the CFG. Computing it here
  // rather than in a separate walker means each construct is walked once — a
  // diagnostic owned by the walk (SKJS 2056) is reported once, and a switch
  // knows its own exhaustiveness at the moment it answers (no side-channel).
  fun stmt(tcenv: mutable TCEnv, st: Stmt): StmtTermination {
    if (getConfig(tcenv.context).emitSkjsTypeClaims) {
      vars = mutable Vector<TypeClaimVar>[];
      for (kv in tcenv.scope.visibleRefs().items()) {
        ref = kv.i1;
        // The declared type is worth a separate claim only when a write has
        // narrowed away from it; otherwise it says nothing `type` does not.
        declared = if (ref.declaredType == ref.type) None() else {
          Some(ref.declaredType)
        };
        vars.push(TypeClaimVar(kv.i0, ref.type, ref.isMutable, declared))
      };
      tcenv.claimedEnvs.push(TypeClaimEnv(st.pos, vars.toArray()))
    };
    term = st.value match {
    | Break() ->
      tcenv.recordBreak(st.pos);
      StmtTermination::break_
    | Continue() ->
      tcenv.recordContinue(st.pos);
      StmtTermination::continue_
    | StmtEmpty() -> StmtTermination::skip
    | StmtExpr(e) ->
      ty = this.expr(tcenv, e, false);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsIgnorable(tcenv, e.pos, ty)
      };
      StmtTermination::expr(e)
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))
      | Some(e) -> (e.pos, this.returnExprType(tcenv, e))
      };
      // In an async function the returned expression and the declared
      // return type are compared by awaited type, like tsc: `return p`
      // settles to p's payload at runtime, and an annotation's nested
      // promise layers flatten the same way.
      msg = "Type of returned value is not assignable to the function's return type";
      if (this.isAsync) {
        (
          etype.maybeAwaited(tcenv.subst, this, epos),
          retType.maybeAwaited(tcenv.subst, this, retType.pos),
        ) match {
        | (Some(subTy), Some(superTy)) ->
          this.checkSubType(tcenv, epos, msg, subTy, superTy, TSCode(2322))
        | (None(), _) ->
          // The returned value is a self-referential thenable (TS1062);
          // the comparison is meaningless and skipped.
          this.errorSelfReferentialThenable(tcenv, epos)
        | (Some _, None()) ->
          // A self-referential annotation is reported once, at the
          // declaration.
          void
        }
      } else {
        this.checkSubType(tcenv, epos, msg, etype, retType, TSCode(2322))
      };
      StmtTermination::exprOpt(eOpt).then(StmtTermination::return_)

    | Bind(bkind, bindings) ->
      if (bkind is BKVar()) {
        // `var` stays an error rather than a warning: unlike `let`/`const` it is
        // function-scoped and hoisted, which SKJS's block-scoped narrow-on-write
        // typing does not yet model. Supporting it soundly is tracked in
        // SkipLabs/skjs#841.
        tcenv.error(
          Array[(st.pos, "Unexpected 'var'; use 'let' or 'const' instead")],
          ESLintCode("no-var"),
        )
      };

      for (binding in bindings) {
        // Pattern names shadow outer declarations before the source and
        // defaults run, but become readable only as each binding initializes.
        binding.pat.value match {
        | PVar _ -> void
        | PArray _
        | PObject _ ->
          this.reserveBindingNames(
            tcenv,
            binding.pat,
            TType::top(binding.pat.pos),
            !(bkind is BKConst()),
          )
        };
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          tcenv,
          bkind,
          binding.type,
          binding.value,
        );
        // Detect local objects: object literals (Object _) bound to variables.
        // These can grow by adding fields via assignment (obj.newField = value)
        // before being used. See TypeCheckEnv.sk:LocalObjectState for details.
        isLocalObject =
          binding.type.isNone() &&
          binding.pat.value is PVar _ &&
          binding.value is Some(Expr(_, Object _));
        // Completed values retain their symbolic contents contracts regardless
        // of initializer syntax. Object literals may still be initializing
        // their shape; bare candidates retain their evolving-binding rule.
        hasContentsContract =
          !isLocalObject &&
          !ty.isFieldFree() &&
          ty.getSingleVar().isNone();
        tcenv.!exprTypes[(binding.pat.pos, false, true)] = ty;
        this.bind(
          tcenv,
          bkind,
          binding.pat,
          ty,
          binding.type.isSome() || hasContentsContract,
          isInitialized,
          isLocalObject,
          false,
          binding.value.map(e -> this.stableAliasExprType(tcenv, e, ty)),
        );
        if (binding.type.isNone()) {
          (binding.pat.value, binding.value) match {
          | (PVar(alias), Some(Expr(_, Var(source)))) ->
            tcenv.scope.inheritAliasContract(alias, source)
          | _ -> void
          }
        }
      };
      StmtTermination::seq(bindings, StmtTermination::binding)

    | If(e, block1, block2opt) ->
      block2 = block2opt.default(Array[]);
      this.checkBool(tcenv, e);
      (scope1, term1) = this.block(tcenv, block1, Some((e, true)));
      (scope2, term2) = this.block(tcenv, block2, Some((e, false)));
      // A branch that cannot complete normally is not a path out of the `if`:
      // a return/throw branch never re-joins the flow, one that loops forever
      // never leaves, and a break/continue branch re-joins after the enclosing
      // switch or loop — through its jump edge, which carries the state at the
      // jump to that merge. So only a branch that can fall through contributes
      // its scope here, and a jump guard (`if (x === undefined) continue;`)
      // leaves the other branch's narrowing to survive alone.
      (term1.mayFallthrough, term2.mayFallthrough) match {
      | (false, false) ->
        void /* TODO: everything that follows is unreachable */
      | (false, true) -> tcenv.popScopeReplace(scope2)
      | (true, false) -> tcenv.popScopeReplace(scope1)
      | (true, true) -> tcenv.mergeScope(this, scope1, scope2)
      };
      StmtTermination::cond(e).if_(() -> term1, () -> term2)

    | For(initStmt, cond, incr, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;
      initTerm = this.stmt(tcenv, initStmt);
      firstLocalSkolem = tcenv.subst.nextSkolemId;
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      writes = mutable CaptureWrites{};
      writes.expr(cond);
      writes.expr(incr);
      writes.stmts(block);
      tcenv.beginLoopWrites(loopScope.widenLoopBindings(writes.result()));
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      // The loop catches the `break`/`continue` inside its body — they bind to
      // it, not to an enclosing switch — and its exits carry their edges: a
      // jump leaves mid-body with the state at the jump, which the body's
      // end-of-block state no longer holds.
      ((loopBody, bodyTerm), catcher) = tcenv.withJumpCatcher(true, () ->
        this.block(tcenv, block, Some((cond, true)))
      );
      tcenv.popScopeReplace(loopBody);
      // A `continue` runs the increment on its way back to the header, so its
      // edges are folded in before the increment is checked; a `break` skips
      // it, so its edges join after.
      for (snap in catcher.continues) {
        loopScope.uniteSnapshot(tcenv.subst, this, snap)
      };
      _ = this.expr(tcenv, incr, false);
      for (snap in catcher.breaks) {
        loopScope.uniteSnapshot(tcenv.subst, this, snap)
      };
      this.checkHiddenBindingEscape(tcenv, st.pos, firstLocalSkolem, initScope);
      loopScope.limitLoopExit(tcenv.subst, this, tcenv.loopWriteBounds.pop());
      tcenv.!scope = initScope;
      tcenv.popScope(this, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope);
      initTerm.thenk(() ->
        StmtTermination::cond(cond).loop_(() ->
          bodyTerm.thenk(() ~> StmtTermination::expr(incr))
        )
      )
    | Block(stmts) ->
      blockTerm = StmtTermination::skip;
      for (stmt in stmts) {
        !blockTerm = blockTerm.then(this.stmt(tcenv, stmt))
      };
      blockTerm
    | ForInOf(kind, initStmt, iterable, block) ->
      scopeCopy = tcenv.scope;
      initScope = tcenv.mcreateSubScope{isLoop => false};
      tcenv.!scope = initScope;

      iterableType = this.expr(tcenv, iterable, true);
      ty = kind match {
      | ForIn() ->
        this.checkForInIterable(tcenv, iterable.pos, iterableType);
        TType::single(TPrimValue::string(st.pos))
      | ForOf() ->
        this.getValueType(tcenv, iterable.pos, iterableType, "for-of loop")
      };

      this.bindLoopVar(tcenv, initStmt, ty);

      // The variable position must be a plain target, so that binding it per
      // iteration cannot itself divert control. Reported here, once — the
      // termination walk that used to own this diagnostic reported it once per
      // walk (SkipLabs/skjs#891).
      StmtTermination::forInOfVar(initStmt).mayNonThrough().each(way ->
        tcenv.error(
          Array[
            (
              initStmt.pos,
              `A for-loop variable initializer must be a plain value, but this one may ${way}.`,
            ),
          ],
          SKJSCode(2056),
        )
      );

      // Enter for-in context for safe v[k]! detection
      enteredForIn =
        kind is ForIn() &&
        initStmt.value match {
        | Bind(_, bindings) if (bindings.size() == 1) ->
          bindings[0].pat.value match {
          | PVar(keyVar) ->
            ForInContext::exprToKey(iterable) match {
            | Some(iterableKey) ->
              tcenv.enterForIn(keyVar.value, iterableKey);
              true
            | None() -> false
            }
          | _ -> false
          }
        | _ -> false
        };

      firstLocalSkolem = tcenv.subst.nextSkolemId;
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      tcenv.!scope = loopScope;
      // See the `For` case: the loop catches its body's jumps and folds their
      // edges into its exit. With no condition or increment to run on the way
      // out, break and continue edges join at the same point.
      writes = mutable CaptureWrites{};
      writes.stmts(block);
      tcenv.beginLoopWrites(loopScope.widenLoopBindings(writes.result()));
      ((loopBody, bodyTerm), catcher) = tcenv.withJumpCatcher(true, () ->
        this.block(tcenv, block)
      );
      tcenv.popScopeReplace(loopBody);
      for (snap in catcher.continues) {
        loopScope.uniteSnapshot(tcenv.subst, this, snap)
      };
      for (snap in catcher.breaks) {
        loopScope.uniteSnapshot(tcenv.subst, this, snap)
      };
      this.checkHiddenBindingEscape(tcenv, st.pos, firstLocalSkolem, scopeCopy);
      loopScope.limitLoopExit(tcenv.subst, this, tcenv.loopWriteBounds.pop());
      tcenv.!scope = initScope;
      tcenv.popScope(this, loopScope);
      tcenv.!scope = scopeCopy;
      tcenv.popScopeReplace(initScope);

      if (enteredForIn) tcenv.exitForIn();
      StmtTermination::expr(iterable).thenk(() ->
        CondTermination::any.loop_(() -> bodyTerm)
      )

    | Throw(e) ->
      _ = this.expr(tcenv, e, false);
      StmtTermination::expr(e).then(StmtTermination::throw_)
    | While(cond, block) ->
      scopeCopy = tcenv.scope;
      firstLocalSkolem = tcenv.subst.nextSkolemId;
      loopScope = tcenv.mcreateSubScope{isLoop => true};
      writes = mutable CaptureWrites{};
      writes.expr(cond);
      writes.stmts(block);
      tcenv.beginLoopWrites(loopScope.widenLoopBindings(writes.result()));
      tcenv.!scope = loopScope;
      this.checkBool(tcenv, cond);
      // See the `For` case: the loop catches its body's jumps and folds their
      // edges into its exit. A `continue` re-enters the header, whose
      // condition turning false then leaves the loop with the edge's state, so
      // both kinds of edge reach the code after and join at the same point.
      ((loopBody, bodyTerm), catcher) = tcenv.withJumpCatcher(true, () ->
        this.block(tcenv, block, Some((cond, true)))
      );
      tcenv.popScopeReplace(loopBody);
      for (snap in catcher.continues) {
        loopScope.uniteSnapshot(tcenv.subst, this, snap)
      };
      for (snap in catcher.breaks) {
        loopScope.uniteSnapshot(tcenv.subst, this, snap)
      };
      this.checkHiddenBindingEscape(tcenv, st.pos, firstLocalSkolem, scopeCopy);
      loopScope.limitLoopExit(tcenv.subst, this, tcenv.loopWriteBounds.pop());
      tcenv.!scope = scopeCopy;
      tcenv.popScope(this, loopScope);
      StmtTermination::cond(cond).loop_(() -> bodyTerm)
    | Switch(e, branches) -> this.switch(tcenv, e, branches)
    | Try(tryBlock, catchClause, finallyBlock) ->
      scopeCopy = tcenv.scope;
      // A jump out of the try or catch blocks leaves through the `finally`,
      // whose writes must then reach what the edge carries; mark the catchers
      // now so those edges can be found once the finally is checked.
      edgeMarks = tcenv.jumpEdgeMarks();
      // Log every write the try block makes: an exception can leave it after
      // any prefix, so the catch and finally entries below union the log in
      // (SkipLabs/skjs#963). Each block gets its own log; what escapes to any
      // enclosing try is decided at the end, gated on who can actually throw.
      (tryTerm, tryLog) = tcenv.withTryWriteLog(() -> {
        tryScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = tryScope;
        term = StmtTermination::skip;
        for (stmt in tryBlock) {
          !term = term.then(this.stmt(tcenv, stmt))
        };
        tcenv.!scope = scopeCopy;
        tcenv.popScope(this, tryScope);
        term
      });

      (afterCatchTerm, catchLogOpt) = catchClause match {
      | Some(CatchClause(param, type, catchBlock)) ->
        catchScope = tcenv.mcreateSubScope{isLoop => false};
        // Entered only when the try threw — after any prefix of it, so with
        // any value the try wrote.
        catchScope.uniteTryWrites(tcenv.subst, this, tryLog);
        (catchTerm, catchLog) = tcenv.withTryWriteLog(() -> {
          tcenv.!scope = catchScope;
          param match {
          | Some(pat) ->
            errorType = type match {
            | Some(t) ->
              tcenv.error(
                Array[
                  (
                    t.pos,
                    "A 'catch' clause variable may not have a type annotation",
                  ),
                ],
                SKJSCode(2018),
              );
              this.normalize(tcenv, t)
            | None() -> TType::top(pat.pos)
            };
            tcenv.!exprTypes[(pat.pos, false, true)] = errorType;
            this.bind(tcenv, BKLet(), pat, errorType, false, true, false)
          | None() -> void
          };
          term = StmtTermination::skip;
          for (stmt in catchBlock) {
            !term = term.then(this.stmt(tcenv, stmt))
          };
          tcenv.!scope = scopeCopy;
          term
        });
        if (catchTerm.mayFallthrough) {
          tcenv.popScope(this, catchScope)
        } else {
          // The catch never completes normally, so its state is not part of
          // the flow after the construct — merging it would put states there
          // that only exceptions ever saw. It still leaves along its own
          // ways out: a break/continue travels its jump edge (recorded with
          // the seeds in scope), and a return or throw unwinds through every
          // enclosing finally — the enclosing log carries it there.
          tcenv.propagateScopeToTryLog(this, catchScope)
        };
        // TODO: warning if tryTerm.mayThrow is false
        // Remove mayThrow from try and combine with catch
        (tryTerm.noThrow() / catchTerm, Some(catchLog))
      | None() -> (tryTerm, None())
      };

      (finalTerm, finallyLogOpt, finallyMayThrow) = finallyBlock match {
      | Some(finallyStmts) ->
        finallyScope = tcenv.mcreateSubScope{isLoop => false};
        // The finally runs however the try (or catch) ended — normally, or
        // thrown out of after any prefix — so it unions both blocks' writes.
        finallyScope.uniteTryWrites(tcenv.subst, this, tryLog);
        catchLogOpt.each(catchLog ->
          finallyScope.uniteTryWrites(tcenv.subst, this, catchLog)
        );
        (finallyTerm, finallyLog) = tcenv.withTryWriteLog(() -> {
          tcenv.!scope = finallyScope;
          term = StmtTermination::skip;
          for (stmt in finallyStmts) {
            !term = term.then(this.stmt(tcenv, stmt))
          };
          tcenv.!scope = scopeCopy;
          tcenv.popScope(this, finallyScope);
          tcenv.foldFinallyIntoJumpEdges(this, edgeMarks, finallyScope);
          term
        });
        // TODO: warning if afterCatchTerm always loops or terminates normally
        (
          afterCatchTerm.finally(finallyTerm),
          Some(finallyLog),
          finallyTerm.mayThrow,
        )
      | None() -> (afterCatchTerm, None(), false)
      };
      // What escapes to an enclosing try is what an exception can leave THIS
      // construct carrying, beyond the end states the ordinary merges already
      // hold. With a catch, the try's exceptions are absorbed: the try's (and
      // the catch's) intermediate states escape only if the catch itself may
      // throw; without one, they escape if the try may. The finally's own
      // intermediates escape only if it may throw. An inner try whose catch
      // absorbs everything therefore keeps its intermediate states to itself.
      escapeCarriesBody = catchLogOpt match {
      | Some _ -> afterCatchTerm.mayThrow
      | None() -> tryTerm.mayThrow
      };
      if (escapeCarriesBody) {
        tcenv.propagateTryWrites(this, tryLog);
        catchLogOpt.each(catchLog -> tcenv.propagateTryWrites(this, catchLog))
      };
      // The finally's own writes leave with any exception that passes through
      // it — one it throws itself, or one leaving the blocks it cleans up
      // after — not only with its own.
      if (escapeCarriesBody || finallyMayThrow) {
        finallyLogOpt.each(finallyLog ->
          tcenv.propagateTryWrites(this, finallyLog)
        )
      };
      // A logged value that outlived the construct normally is in flight in
      // any enclosing try — a later throw there carries it, however calmly
      // this construct resolved. Its post-construct view says what survived.
      tcenv.propagateSurvivorsToTryLog(this, tryLog);
      catchLogOpt.each(catchLog ->
        tcenv.propagateSurvivorsToTryLog(this, catchLog)
      );
      finallyLogOpt.each(finallyLog ->
        tcenv.propagateSurvivorsToTryLog(this, finallyLog)
      );
      finalTerm
    };
    tcenv.!stmtTerminations[st.pos] = term;
    term
  }

  fun switch(
    tcenv: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): StmtTermination {
    if (branches.size() == 0) {
      // An empty switch evaluates the scrutinee and does nothing else, which is
      // sound and which tsc accepts silently. Pointless, so still worth saying,
      // but a lint concern rather than an error — like the single-branch switch
      // just below.
      //
      // Report it before checking the scrutinee, not after: the scrutinee is
      // real code that reports its own errors, and one of those can abort the
      // definition, which would take this warning with it.
      tcenv.warning(
        Array[(e.pos, "A switch statement must have at least one case")],
        SKJSCode(2010),
      );
      _ = this.expr(tcenv, e, true);
      return StmtTermination::expr(e)
    };
    if (branches.size() == 1) {
      tcenv.warning(
        Array[
          (
            e.pos,
            "This switch has a single branch; use an 'if' statement instead",
          ),
        ],
        SKJSCode(2011),
      )
    };
    condType = this.expr(tcenv, e, true);
    // The values the scrutinee can take, when they are enumerable. Otherwise
    // (e.g. a general `boolean`) there is no value set to judge reachability or
    // exhaustiveness against, and `casesKnown` turns both off; an empty `cases`
    // cannot stand in for that, since it reads as "everything is handled".
    (cases, casesKnown) = condType
      .getSTypes(tcenv.subst, this, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(lits), _)) ->
      (Map::mcreateFromIterator(lits.values().map(x -> (x.val, x.pos))), true)
    | Some(TPrimValue(TBool _, None(), pos)) ->
      // A boolean carries no literals when it can be either, so listing its
      // values means naming them: unlike a `number` or a `string`, there are
      // only the two. (A boolean that can be only one keeps that literal, and is
      // read above.)
      (mutable Map["true" => pos, "false" => pos], true)
    | _ -> (mutable Map<String, PosRange>[], false)
    };
    // Kept for truthful unreachability reasons: a case value can be
    // unreachable because it is not in the switched type at all, or because
    // an earlier case (e.g. an alias enum member with the same value) already
    // handled it. As each value is handled it moves from `cases` into
    // `handledBy` (which also records the handling case's position, to point
    // at it in the latter warning), so a value still in the switched type is
    // in exactly one of the two.
    handledBy = mutable Map<String, PosRange>[];
    // A clause's scope is one of the paths out of the switch only when it can
    // reach the code after: by a `break`, or — for the last clause — by falling
    // off the end. A clause that falls into the next one does not exit there; it
    // runs on, and its writes are carried into the clause it falls into (the
    // real exit), so merging its scope too would add a phantom path that skips
    // whatever the fallen-into clause does. A clause that only returns, throws,
    // continues, or loops forever does not reach the code after either. The
    // block is still checked either way — only its scope is dropped. (`If` has
    // no fall-through between arms, so it drops on `isTerminal` alone.)
    scopes = mutable Vector<readonly Scope>[];
    // `default` runs only for a value no `case` matched, so its body is narrowed
    // by that: the conjunction of `scrutinee !== <label>` over the cases. Every
    // case counts, including any written after the `default` — where the clauses
    // sit says nothing about which values reach it.
    //
    // Which is why the labels are typed here rather than as each clause is
    // reached below: a condition can only be refined once the types of what it
    // compares are known, so a `default` could otherwise only rule out the cases
    // that happened to precede it.
    noCaseMatched: ?Expr = None();
    for (branch in branches) {
      branch match {
      | SwitchBranch(Case(v), _, _) ->
        _ = this.expr(tcenv, v, true);
        ne = Expr(e.pos, (Binop(BOStrictInequality(), e, v)));
        !noCaseMatched = Some(
          noCaseMatched match {
          | None() -> ne
          | Some(acc) -> Expr(e.pos, (Binop(BOLogicalAnd(), acc, ne)))
          },
        )
      | SwitchBranch(Default(), _, _) -> void
      }
    };
    // Two `default` positions, which differ only in a switch that has more
    // than one (already an error): the first names the clause a duplicate
    // conflicts with, and answers whether the switch has a `default` at all;
    // the last is the one reported unreachable below.
    seenDefault: ?PosRange = None();
    lastDefaultPos: ?PosRange = None();
    // A block is reached both by matching its own label and by falling
    // through every clause above it that runs on into it, so it is entered
    // with the union of what each of those entries leaves. Its own label
    // narrows the scrutinee to that label (the `cond` below); the fallthrough
    // entries come through `fallenFrom` — the falling clause's whole scope,
    // unioned into this block after its own narrowing (see `block`'s
    // parameter of the same name).
    //
    // Carrying the scope, not a disjunction of labels, is what keeps this
    // right when a clause reassigns: the fallthrough entry brings whatever
    // the falling clause actually left the scrutinee at — its reassigned
    // value, not the label it matched — and every other write it made along
    // with it. A clause falls into the next exactly when its block can
    // complete normally, which an empty one always does and one with
    // statements does unless it breaks or returns; `fallenFrom` is set to its
    // scope then, and accumulates, since that scope was itself entered from
    // the clauses above it.
    fallenFrom: ?readonly Scope = None();
    // How the switch ends, folded from how each clause ends as it is checked.
    // Each clause may fall into the next, and only the last falls out of the
    // switch; what has been chained so far is taken as `maybe` before
    // continuing, since the switch is entered at whichever clause matches —
    // chaining the clauses as they are would stop at the first that cannot
    // complete normally and never reach the ones after it. Starting from
    // `skip` costs nothing: it is what a clause chains onto unchanged.
    branchesTerm = StmtTermination::skip;
    // Catch the `break` edges out of this switch: a mid-clause break leaves with
    // a state the clause's end-of-block scope no longer holds, so it is recorded
    // as a snapshot and unioned into the post-switch merge below, rather than
    // read off the end-of-block scope.
    (_, catcher) = tcenv.withJumpCatcher(false, () -> {
      for (i in Range(0, branches.size())) {
        block = branches[i].block;
        cond = branches[i] match {
        | SwitchBranch(Case(v), _, pos) ->
          // Typed with the other labels above, along with everything that reads a
          // label's type: this and the narrowing of the block below.
          condVType = this.lookupExprType(tcenv, v);
          // A switch case must be a plain value, so that case-evaluation order
          // and `===` narrowing are sound. Enum member reads (`E.A`, `E["A"]`,
          // `E[0]` on an unshadowed enum name) are plain data-property reads and
          // exempt — a bare name never throws and enum members are not accessors;
          // every other case must be provably non-throwing. This lives here
          // rather than in the Termination pass because the exemption needs name
          // resolution, which that pass has no defMap for.
          enumMemberBase = v.value match {
          | Dot(NormalDot(), Expr(_, Var(b)), _) -> Some(b)
          | Get(
            Expr(_, Var(b)),
            key,
          ) if (this.directLiteralSType(key) is Some _) ->
            Some(b)
          | _ -> None()
          };
          isEnumMember = enumMemberBase match {
          | Some(b) ->
            tcenv.scope.maybeGet(b) is None() &&
              this.defMap.getAll(tcenv, b).any(d -> d is Enum _)
          | None() -> false
          };
          if (!isEnumMember) {
            StmtTermination::expr(v).mayNonThrough().each(term ->
              tcenv.error(
                Array[
                  (
                    v.pos,
                    `A switch case expression must be a plain value, but this one may ${term}.`,
                  ),
                ],
                SKJSCode(2055),
              )
            )
          };
          if (casesKnown) {
            condVType
              .getSTypes(tcenv.subst, this, Covariant())
              .flatMap(stypes ~> stypes.staticValue()) match {
            | Some(staticValue) ->
              if (cases.containsKey(staticValue)) {
                cases.remove(staticValue);
                handledBy![staticValue] = pos
              } else {
                handledBy.maybeGet(staticValue) match {
                | Some(earlierPos) ->
                  tcenv.warning(
                    Array[
                      (
                        pos,
                        "This case is unreachable: its value is already handled by an earlier case",
                      ),
                      (earlierPos, "The value is first handled here"),
                    ],
                    SKJSCode(2014),
                  )
                | None() ->
                  tcenv.warning(
                    Array[
                      (
                        pos,
                        "This case is unreachable: its value is not in the switched type",
                      ),
                    ],
                    SKJSCode(2014),
                  )
                }
              }
            | None() -> void
            }
          };
          // The own-label entry narrows the scrutinee to this label; the entries
          // by fallthrough are unioned in through `fallenFrom`, each already
          // carrying whatever the falling clause left the scrutinee at.
          eq = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
          Some((eq, true))
        | SwitchBranch(Default(), _, pos) ->
          // A switch may contain at most one `default` clause; a second one is a
          // JavaScript SyntaxError (tsc reports TS1113). Reject every `default`
          // after the first.
          seenDefault match {
          | Some(firstDefaultPos) ->
            tcenv.error(
              Array[
                (
                  pos,
                  "A 'default' clause cannot appear more than once in a 'switch' statement",
                ),
                (firstDefaultPos, "First 'default' clause was here"),
              ],
              TSCode(1113),
            )
          | None() -> !seenDefault = Some(pos)
          };
          !lastDefaultPos = Some(pos);
          if (i != branches.size() - 1) {
            // A `default` clause that is not last is a lint concern, not a
            // soundness error: at runtime `default` is only taken when no `case`
            // matches, so its position never changes which branch runs. tsc does
            // not reject it.
            tcenv.warning(
              Array[
                (
                  pos,
                  "The 'default' clause should be the last branch of a switch",
                ),
              ],
              ESLintCode("default-case-last"),
            )
          };
          // The `default`'s own entry is every value no `case` matched; the
          // entries by fallthrough are unioned in through `fallenFrom`, as for a
          // `case`.
          noCaseMatched match {
          // No case to rule out: the `default` runs whatever the scrutinee is.
          | None() -> None()
          | Some(noCase) -> Some((noCase, true))
          }
        };
        (scopeBranch, blockTerm) = this.block(tcenv, block, cond, fallenFrom);
        // Falling *through* means running one clause's statements and then
        // running the next clause's too. An empty clause has none to run — it is
        // how several labels are given one body — and the last clause has nothing
        // to fall into, so neither is a fallthrough. tsc's
        // `noFallthroughCasesInSwitch` exempts both for the same reason.
        //
        // What kind of clause it is does not enter into it: a `default` runs its
        // statements and falls into the clause after it exactly as a `case` does,
        // and tsc reports it the same way.
        //
        // Whether the rest is an error is that option's to say. SKJS turns it on
        // where tsc leaves it off, but a switch that asks for the fallthrough
        // gets it: only the diagnostic is withheld, never the typing of the
        // clause fallen into, which is what keeps the fallthrough sound.
        if (
          this.noFallthroughCasesInSwitch &&
          blockTerm.mayFallthrough &&
          block.size() != 0 &&
          i != branches.size() - 1
        ) {
          tcenv.error(
            Array[
              (
                block[block.size() - 1].pos,
                "Fallthrough case in switch; add a 'break'",
              ),
            ],
            TSCode(7029),
          )
        };
        !branchesTerm = branchesTerm.maybe().then(blockTerm);
        isLastBranch = i == branches.size() - 1;
        // Only a clause that reaches the code after the switch by falling off the
        // end — the last one, completing normally — contributes its end-of-block
        // scope. A clause that breaks reaches there too, but by a jump whose state
        // the catcher recorded; reading its end-of-block scope instead would miss
        // a mid-clause break and double-count the final one.
        if (isLastBranch && blockTerm.mayFallthrough) {
          scopes.push(scopeBranch)
        };
        // This clause falls into the next exactly when its block can complete
        // normally; its scope is then the next clause's fallthrough entry.
        !fallenFrom = if (blockTerm.mayFallthrough) Some(scopeBranch) else {
          None()
        }
      }
    });
    // A `default` covers exactly the values matched by no `case`, before or
    // after it in source order, so its reachability depends on the full set of
    // cases and is settled only now: judging it inline would let a non-last
    // `default` wrongly pre-empt the cases that follow it (clearing them from
    // `cases`, which then mis-flags them "not in the switched type").
    // Whether the cases alone leave no value unmatched — read before the
    // `default` below clears what is left, which would make the two
    // indistinguishable.
    casesLeaveNothing = casesKnown && cases.isEmpty();
    if (casesKnown) {
      lastDefaultPos match {
      | Some(pos) ->
        if (cases.isEmpty()) {
          tcenv.warning(
            Array[
              (
                pos,
                "This 'default' case is unreachable: all values of the switched type are already handled",
              ),
            ],
            SKJSCode(2014),
          )
        } else {
          cases.clear()
        }
      | None() -> void
      };
      if (!cases.isEmpty()) {
        missingCases = Vector::mcreateFromIterator(
          cases.items().map(x -> (x.i1, x.i0)),
        );
        missingCases.sortBy(x ~> x.i1);
        // A non-exhaustive switch is a lint concern, not a soundness error: tsc
        // does not require exhaustiveness, and SKJS does not rely on this
        // verdict — reachability/termination is decided separately and
        // syntactically (a switch is exhaustive-for-termination only with a
        // literal `default`), as is the scope merge's untouched path below.
        // Deriving those from the verdict instead is SkipLabs/skjs#863.
        tcenv.warning(
          Array[
            (
              e.pos,
              "Switch is not exhaustive; the following cases are unhandled",
            ),
          ].concat(missingCases.toArray()),
          ESLintCode("@typescript-eslint/switch-exhaustiveness-check"),
        )
      }
    };
    // Every `break` out of the switch is one more path to the code after it,
    // carrying the state recorded at the jump; fold each in as a sibling scope.
    for (snap in catcher.breaks) {
      scopes.push(tcenv.snapshotScope(snap))
    };
    // Each remaining branch is a path out of the switch, so they must all be
    // merged at once: folding the two-scope `merge` pairwise against a fixed
    // first branch discards every branch in between, leaving only first and last.
    //
    // Unless some clause always runs, there is one more path — matching none of
    // them, which leaves every binding at its pre-switch value. A `default`
    // always runs when nothing else did; so do the cases, when between them they
    // leave no value unmatched.
    tcenv.mergeScopes(
      this,
      scopes.toArray(),
      seenDefault is None() && !casesLeaveNothing,
    );
    // How the switch ends. `break` becomes a fallthrough once, on the whole
    // switch — converting it per clause would make a clause that breaks look
    // like it continues into the next one, when it leaves the switch entirely.
    // Some clause always runs when there is a `default`, and equally when the
    // cases leave no value unmatched — known right here, no side-channel: the
    // fold and the exhaustiveness verdict come from the same checked walk.
    !branchesTerm = branchesTerm.breakToFallthrough();
    switchIsExhaustive = seenDefault.isSome() || casesLeaveNothing;
    switchTerm = if (switchIsExhaustive) branchesTerm else branchesTerm.maybe();
    StmtTermination::expr(e).thenk(() -> switchTerm)
  }

  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {
    initStmt.value match {
    | Bind(kind, bindings) ->
      if (bindings.size() != 1) {
        tcenv.error(
          Array[
            (
              initStmt.pos,
              "A loop variable declaration must declare exactly one binding",
            ),
          ],
          SKJSCode(2016),
        )
      };
      for (binding in bindings) {
        tcenv.!exprTypes[(binding.pat.pos, false, true)] = varType;
        this.bind(
          tcenv,
          kind,
          binding.pat,
          varType,
          binding.type.isSome(),
          true,
          false,
        )
      }
    | _ ->
      tcenv.error(
        Array[
          (
            initStmt.pos,
            "A loop variable must be a simple 'let' or 'const' binding",
          ),
        ],
        SKJSCode(2017),
      )
    }
  }

  fun checkForInIterable(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
  ): void {
    // TypeScript error code: TS2407
    iterableType.getSTypes(tcenv.subst, this, Covariant()) match {
    | None() -> void
    | Some(stypes) ->
      if (
        !stypes.isEmpty() &&
        stypes.all(stype ->
          stype match {
          | TObject _ -> true
          | _ -> false
          }
        )
      ) return void
    };
    tcenv.error(
      Array[
        (
          pos,
          "The right-hand side of a 'for...in' statement must be an object or array type",
        ),
        (
          iterableType.pos,
          `Here it has type ${this.ppType(tcenv, iterableType)}`,
        ),
      ],
      TSCode(2407),
    )
  }

  fun getValueType(
    tcenv: mutable TCEnv,
    pos: PosRange,
    iterableType: TType,
    iterationKind: String,
  ): TType {
    result = TType::bottom(pos);

    stypes = iterableType.getSTypes(tcenv.subst, this, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ ->
      tcenv.error(
        Array[(pos, `Type is not iterable in a '${iterationKind}'`)],
        TSCode(2488),
      );
      return result
    };

    for (stype in stypes) {
      stype match {
      | obj @ TObject _ ->
        this.getIteratorElementType(tcenv.subst, obj, pos) match {
        | Some(elementType) ->
          !result = TType::union(tcenv.subst, this, result, elementType)
        | None() ->
          tcenv.error(
            Array[(pos, `Type is not iterable in a '${iterationKind}'`)],
            TSCode(2488),
          )
        }
      | TPrimValue(TString(), _, _) ->
        !result = TType::union(
          tcenv.subst,
          this,
          result,
          TType::single(TPrimValue::string(pos)),
        )
      | _ ->
        tcenv.error(
          Array[
            (
              pos,
              `${iterationKind} requires an array, string, or iterable type`,
            ),
          ],
          TSCode(2488),
        )
      }
    };
    result
  }
}

module end;
