module SKJS;

/*****************************************************************************/
// Version
/*****************************************************************************/

const kVersion: String = "0.9";

/*****************************************************************************/
// Help
/*****************************************************************************/

fun help(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("help")
      .arg(
        Cli.Arg::string("command")
          .positional()
          .about(
            "If specified, the subcommand for which help is to be displayed",
          ),
      )
      .about("Displays help for a skjs subcommand"),
    execHelp,
  )
}

fun execHelp(args: Cli.ParseResults): void {
  optSubcmd = args.maybeGetString("command");
  optSubcmd.flatMap(subcmd ->
    args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)
  ) match {
  | Some(cmd) -> print_string(Cli.usage(cmd, true, Some(args.cmd)))
  | _ ->
    optSubcmd match {
    | Some(subcmd) -> print_error(`error: Invalid subcommand ${subcmd}.`)
    | _ -> print_error("error: No subcommand specified.")
    };
    print_string(Cli.usage(args.cmd, true))
  };
}

/*****************************************************************************/
// Main entry point
/*****************************************************************************/

fun main(): void {
  saved = SKStore.newObstack();
  cmd = Cli.Command("skjs")
    .about("SKJS skdb js development framework")
    .arg(
      Cli.Arg::bool("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .arg(
      Cli.Arg::bool("verbose")
        .short("v")
        .long("verbose")
        .about("Use verbose output")
        .global(),
    );
  suppliers = Array[check, run, help];
  commands = mutable Map[];
  for (supplier in suppliers) {
    (subcommand, cmdFn) = supplier();
    !cmd = cmd.subcommand(subcommand);
    commands.set(subcommand.name, cmdFn);
  };
  !cmd = cmd.help();
  args = cmd.parseArgs();
  if (args.getBool("version")) {
    print_string(Environ.args().next().default("skjs") + " " + kVersion);
    SKStore.destroyObstack(saved);
    skipExit(0);
  } else {
    args.maybeGetSubcommand() match {
    | Some(subcmd) ->
      commands.maybeGet(subcmd) match {
      | Some(handler) ->
        skipExit(
          if (args.getBool("backtrace")) {
            handler(args);
            SKStore.destroyObstack(saved);
            0
          } else {
            try {
              handler(args);
              SKStore.destroyObstack(saved);
              0
            } catch {
            | exn ->
              e = SKStore.destroyObstackWithValue(saved, List[exn]).getHead();
              throw e
            }
          },
        )
      | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
      }
    | None() ->
      print_string(Cli.usage(args.cmd, true));
      SKStore.destroyObstack(saved);
      skipExit(0)
    }
  };
}

/*****************************************************************************/
/* Runs a specific file */
/*****************************************************************************/

fun run(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("run")
      .about("runs the file")
      .arg(
        Cli.StringArg{name => "path"}
          .positional()
          .required()
          .about("path to main"),
      )
      .arg(
        Cli.BoolArg{name => "backtrace"}
          .short("b")
          .long("backtrace")
          .about("Internal (debugging)"),
      ),
    execRun,
  )
}

fun execRun(args: Cli.ParseResults): void {
  status = execCheckWithStatus(args);
  if (status != 0) return void;
  fileName = args.maybeGetString("path") match {
  | Some(path) ->
    if (!path.startsWith("./")) {
      print_error("File does not start with ./: " + path);
      skipExit(2);
    };
    if (!FileSystem.exists(path)) {
      print_error("File not found: " + path);
      skipExit(2);
    };
    path
  | None() ->
    invariant_violation("Internal error: path was declared as required")
  };
  Posix.execvp(Array["bun", fileName])
}

/*****************************************************************************/
/* Typechecks the files */
/*****************************************************************************/

fun check(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("check")
      .about("Typechecks")
      .arg(
        Cli.Arg::string("src-file")
          .positional()
          .repeatable()
          .about("Files to check (default: src/**/*.ts)"),
      )
      .arg(
        Cli.Arg::bool("backtrace")
          .short("b")
          .long("backtrace")
          .about("Internal (debugging)"),
      )
      .arg(
        Cli.Arg::string("baseUrl")
          .value_name("PATH")
          .about("Base directory from which to resolve modules"),
      )
      .arg(
        Cli.Arg::string("builtins-file")
          .value_name("FILENAME")
          .default("./src/builtins.ts")
          .about("Path to the file containing builtins declarations"),
      ),
    execCheck,
  )
}

fun execCheck(args: Cli.ParseResults): void {
  _ = execCheckWithStatus(args);
}

fun execCheckWithStatus(args: Cli.ParseResults): Int {
  backtrace = args.getBool("backtrace");
  baseUrlOpt = args.maybeGetString("baseUrl");
  builtinsArgFileName = args.getString("builtins-file");
  srcFiles: Sequence<String> = args.getArray("src-file");

  rootOpt: ?DirName = None();
  baseUrlOpt match {
  | Some(baseUrl) -> !rootOpt = Some(DirName::create(Path.resolve(baseUrl)))
  | None() -> void
  };
  if (srcFiles.isEmpty()) {
    root = rootOpt match {
    | Some(root) -> root
    | None() -> DirName::create(FileSystem.realpath("."))
    };
    !rootOpt = Some(root);
    srcDir = `${root}src/`;
    if (!FileSystem.exists(srcDir)) {
      print_error(`Could not find src/ dir in: ${root}`);
      skipExit(2);
    };
    !srcFiles = FileSystem.readFilesRecursive(srcDir, fileName ->
      fileName.endsWith(".ts")
    );
  } else {
    !srcFiles = srcFiles.map(f -> Path.resolve(f));
  };
  if (srcFiles.isEmpty()) {
    print_error("No source files!");
    skipExit(2);
  };
  builtinsFileName = FileName::create(Path.resolve(builtinsArgFileName));
  if (!builtinsFileName.exists()) {
    print_error("Builtins not found: " + builtinsFileName.toString());
    return 1;
  };
  !srcFiles = Array[srcFiles, Array[builtinsFileName.toString()]].flatten();

  context = mutable SKStore.Context{};
  files = Files::create(context, srcFiles);
  newLinesMap = NewLinesMap::create(context, files);
  index = FileNameIndex::create(context, files.filesContent);
  parsedFiles = files.parse(context, newLinesMap);
  fileDefsMap = FileDefsMap::create(context, index, rootOpt, parsedFiles);
  builtinDefs = fileDefsMap.get(context, builtinsFileName);
  builtins = builtinDefs.defs.items().map(x -> x.i0).collect(Set);
  defMap = DefMap{index, fileDefsMap, builtins, builtinsFileName};
  tenv = TEnv{defMap};
  status = 0;
  checker = TypeChecker{
    builtins,
    backtrace,
    newLinesMap,
    defMap,
    tenv,
    builtinsFileName,
  };
  for (fileName in files.srcFiles) {
    parsedFile = parsedFiles.getArray(context, SKStore.SID(fileName));
    if (parsedFile.size() == 0) invariant_violation("could not parse?");
    parsedFile[0].value match {
    | PROk(defs) ->
      errors = checker.check(context, defs);
      if (errors.size() != 0) !status = 2;
      for (error in errors) {
        print_string(error);
      }
    | PRError(err) ->
      !status = 2;
      print_error(err.toString())
    }
  };
  status
}

module end;
