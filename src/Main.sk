module SKJS;

/*****************************************************************************/
// Version
/*****************************************************************************/

const kVersion: String = "0.9";

/*****************************************************************************/
// Help
/*****************************************************************************/

fun help(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("help")
      .arg(
        Cli.StringArg("command")
          .positional()
          .about(
            "If specified, the subcommand for which help is to be displayed",
          ),
      )
      .about("Displays help for a skjs subcommand"),
    execHelp,
  )
}

fun execHelp(args: Cli.ParseResults): void {
  optSubcmd = args.maybeGetString("command");
  optSubcmd.flatMap(subcmd ->
    args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)
  ) match {
  | Some(cmd) -> print_string(Cli.usage(cmd, true, Some(args.cmd)))
  | _ ->
    optSubcmd match {
    | Some(subcmd) -> print_error(`error: Invalid subcommand ${subcmd}.`)
    | _ -> print_error("error: No subcommand specified.")
    };
    print_string(Cli.usage(args.cmd, true))
  };
}

/*****************************************************************************/
// Main entry point
/*****************************************************************************/

fun main(): void {
  saved = SKStore.newObstack();
  cmd = Cli.Command("skjs")
    .about("SKJS skdb js development framework")
    .arg(
      Cli.BoolArg("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .arg(
      Cli.BoolArg("verbose")
        .short("v")
        .long("verbose")
        .about("Use verbose output")
        .global(),
    );
  suppliers = Array[check, run, help];
  commands = mutable Map[];
  for (supplier in suppliers) {
    (subcommand, cmdFn) = supplier();
    !cmd = cmd.subcommand(subcommand);
    commands.set(subcommand.name, cmdFn);
  };
  !cmd = cmd.help();
  args = cmd.parseArgs();
  if (args.getBool("version")) {
    print_string(Environ.args().next().default("skjs") + " " + kVersion);
    SKStore.destroyObstack(saved);
    skipExit(0);
  } else {
    args.maybeGetSubcommand() match {
    | Some(subcmd) ->
      commands.maybeGet(subcmd) match {
      | Some(handler) ->
        skipExit(
          if (args.getBool("backtrace")) {
            handler(args);
            SKStore.destroyObstack(saved);
            0
          } else {
            try {
              handler(args);
              SKStore.destroyObstack(saved);
              0
            } catch {
            | exn ->
              e = SKStore.destroyObstackWithValue(saved, List[exn]).getHead();
              throw e
            }
          },
        )
      | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
      }
    | None() ->
      print_string(Cli.usage(args.cmd, true));
      SKStore.destroyObstack(saved);
      skipExit(0)
    }
  };
}

/*****************************************************************************/
/* Runs a specific file */
/*****************************************************************************/

fun run(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("run")
      .about("runs the file")
      .arg(Cli.StringArg("path").positional().required().about("path to main"))
      .arg(
        Cli.BoolArg("backtrace")
          .short("b")
          .long("backtrace")
          .about("Internal (debugging)"),
      ),
    execRun,
  )
}

fun execRun(args: Cli.ParseResults): void {
  status = execCheckWithStatus(args);
  if (status != 0) return void;
  debug(status);
  fileName = args.maybeGetString("path") match {
  | Some(path) ->
    if (!path.startsWith("./")) {
      print_error("File does not start with ./: " + path);
      skipExit(2);
    };
    if (!FileSystem.exists(path)) {
      print_error("File not found: " + path);
      skipExit(2);
    };
    path
  | None() ->
    invariant_violation("Internal error: path was declared as required")
  };
  Posix.execvp(Array["bun", fileName])
}

/*****************************************************************************/
/* Typechecks the files */
/*****************************************************************************/

fun check(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("check")
      .about("Typechecks")
      .arg(
        Cli.BoolArg("backtrace")
          .short("b")
          .long("backtrace")
          .about("Internal (debugging)"),
      ),
    execCheck,
  )
}

fun execCheck(args: Cli.ParseResults): void {
  _ = execCheckWithStatus(args);
}

fun execCheckWithStatus(args: Cli.ParseResults): Int {
  backtrace = args.getBool("backtrace");
  context = mutable SKStore.Context{};
  rootDirStr = FileSystem.realpath(".") + "/";
  root = DirName::create(rootDirStr);
  files = Files::create(context, rootDirStr);
  newLinesMap = NewLinesMap::create(context, files);
  index = FileNameIndex::create(context, files.filesContent);
  parsedFiles = files.parse(context, newLinesMap, rootDirStr + "src/");
  fileDefsMap = FileDefsMap::create(context, index, root, parsedFiles);
  defMap = DefMap{root, index, fileDefsMap};
  tenv = TEnv{defMap};
  checker = TypeChecker{backtrace, newLinesMap, defMap, tenv};
  status = 0;
  for (fileName in files.srcFiles) {
    parsedFile = parsedFiles.getArray(context, SKStore.SID(fileName));
    if (parsedFile.size() == 0) invariant_violation("could not parse?");
    parsedFile[0].value match {
    | PROk(defs) ->
      errors = checker.check(context, defs);
      if (errors.size() != 0) !status = 2;
      for (error in errors) {
        print_string(error);
      }
    | PRError(err) ->
      !status = 2;
      print_error(err.toString())
    }
  };
  status
}

module end;
