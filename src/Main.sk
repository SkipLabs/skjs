module SKJS;

/***************************************************************************/
// Version
/***************************************************************************/

const kVersion: String = "0.9";

/***************************************************************************/
// Help
/***************************************************************************/

fun help(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("help")
      .arg(
        Cli.Arg::string("command")
          .positional()
          .about(
            "If specified, the subcommand for which help is to be displayed",
          ),
      )
      .about("Displays help for a skjs subcommand"),
    execHelp,
  )
}

fun execHelp(args: Cli.ParseResults): void {
  optSubcmd = args.maybeGetString("command");
  optSubcmd.flatMap(subcmd ->
    args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)
  ) match {
  | Some(cmd) -> print_string(Cli.usage(cmd, true, Some(args.cmd)))
  | _ ->
    optSubcmd match {
    | Some(subcmd) -> print_error(`error: Invalid subcommand ${subcmd}.`)
    | _ -> print_string(Cli.usage(args.cmd, true))
    }
  };
}

/***************************************************************************/
// Main entry point
/***************************************************************************/

fun main_no_exit(): void {
  saved = SKStore.newObstack();
  cmd = Cli.Command("skjs")
    .about("SKJS SKIP development framework")
    .arg(
      Cli.Arg::bool("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .arg(
      Cli.Arg::bool("verbose")
        .short("v")
        .long("verbose")
        .about("Use verbose output")
        .global(),
    );
  suppliers = Array[check, run, help];
  commands = mutable Map[];
  for (supplier in suppliers) {
    (subcommand, cmdFn) = supplier();
    !cmd = cmd.subcommand(subcommand);
    commands.set(subcommand.name, cmdFn);
  };
  !cmd = cmd.help();
  args = cmd.parseArgs();
  if (args.getBool("version")) {
    print_string(Environ.args().next().default("skjs") + " " + kVersion);
    SKStore.destroyObstack(saved);
    throw Exit(0);
  } else {
    args.maybeGetSubcommand() match {
    | Some(subcmd) ->
      commands.maybeGet(subcmd) match {
      | Some(handler) ->
        throw Exit(
          if (args.getBool("backtrace", Some(false))) {
            handler(args);
            SKStore.destroyObstack(saved);
            0
          } else {
            try {
              handler(args);
              SKStore.destroyObstack(saved);
              0
            } catch {
            | exn ->
              e = SKStore.destroyObstackWithValue(saved, exn);
              throw e
            }
          },
        )
      | _ -> internal_error(`Unknown subcommand ${subcmd}`)
      }
    | None() ->
      print_string(Cli.usage(args.cmd, true));
      SKStore.destroyObstack(saved);
      throw Exit(0)
    }
  };
}

class Exit(code: Int) extends Exception

fun main(): void {
  try {
    main_no_exit()
  } catch {
  | Exit(code) -> skipExit(code)
  | e -> throw e
  }
}

/***************************************************************************/
/* Runs a specific file */
/***************************************************************************/

fun run(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("run")
      .about("Typecheck, then run using Bun runtime")
      .arg(
        Cli.Arg::string("main")
          .value_name("PATH")
          .about(
            "Path to main (defaults to first source file, required if none are provided at command line)",
          ),
      )
      .args(checkArgs),
    execRun,
  )
}

fun execRun(args: Cli.ParseResults): void {
  status = execCheckWithStatus(args);
  if (status != 0) return void;
  fileName = args.getArray("src-file").maybeFirst() match {
  | Some(firstSrcFile) -> firstSrcFile
  | None() ->
    args.maybeGetString("main") match {
    | Some(mainSrcFile) -> mainSrcFile
    | None() ->
      print_error("--main is required when no source files are provided");
      throw Exit(2)
    }
  };
  if (!fileName.startsWith("./")) {
    print_error("File does not start with ./: " + fileName);
    throw Exit(2);
  };
  if (!FileSystem.exists(fileName)) {
    print_error("File not found: " + fileName);
    throw Exit(2);
  };
  Posix.execvp(Array["bun", fileName])
}

/***************************************************************************/
/* Typechecks the files */
/***************************************************************************/

const checkArgs: Array<Cli.Arg> = Array[
  Cli.Arg::string("src-file")
    .positional()
    .repeatable()
    .about("Source files (default: **/*.ts)"),
  Cli.Arg::string("directory")
    .long("directory")
    .short("C")
    .value_name("dir")
    .about(
      "Change to directory dir before reading files or doing anything else.",
    ),
  Cli.Arg::string("init").about("Initializes persistent cache"),
  Cli.Arg::string("data").about("Uses persistent cache"),
  Cli.Arg::bool("backtrace")
    .short("b")
    .long("backtrace")
    .about("Internal (debugging)"),
  Cli.Arg::string("base-url")
    .value_name("PATH")
    .about(
      "Base directory from which to resolve modules (default: working directory)",
    ),
  Cli.Arg::string("import-stubs")
    .value_name("IMPORT-PATH")
    .repeatable()
    .about("Path to directory containing stubs for imports"),
  Cli.Arg::bool("log-affected-files").about(
    "Output a list of files potentially affected by changes since laqst run.  Requires `--data` persistent cache.",
  ),
  Cli.Arg::bool("keep-going")
    .long("keep-going")
    .short("k")
    .default(false)
    .about("Do not stop at the first lexing/parsing error"),
  Cli.Arg::string("error-detail")
    .long("error-detail")
    .repeatable()
    .about(
      "Control subtyping error detail level. Formats: <level>, <line>, <file>, <line>:<level>, <file>:<level>, <file>:<line>:<level>. " +
        "Levels: hide, minimal/0, default/1, normal/2, verbose/3, full/max. Multiple specs can be separated by ';'. Can be specified multiple times.",
    ),
  Cli.Arg::string("error-format")
    .long("error-format")
    .value_name("FORMAT")
    .about(
      `Error output format. Available formats: ${ErrorFormat::all}. (default: ${
        ErrorFormat::default
      })`,
    )
    .default(ErrorFormat::default),
  Cli.Arg::string("project")
    .long("project")
    .short("p")
    .value_name("PATH")
    .about(
      "Path to tsconfig.json or directory containing one (auto-discovered when no source files are provided)",
    ),
];

fun check(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("check").about("Typecheck some source file(s)").args(checkArgs),
    execCheck,
  )
}

fun execCheck(args: Cli.ParseResults): void {
  status = execCheckWithStatus(args);
  throw Exit(status);
}

const sinkDirName: SKStore.DirName = SKStore.DirName::create("/sink/");

fun execCheckWithStatus(args: Cli.ParseResults): Int {
  args.maybeGetString("directory") match {
  | Some(newDirectory) -> Environ.set_current_dir(newDirectory)
  | None() -> void
  };
  errorHandling = (
    args.getBool("backtrace"),
    args.getBool("keep-going"),
  ) match {
  | (true, true) ->
    print_error(
      "--backtrace and --keep-going cannot both be used at the same time",
    );
    throw Exit(2)
  | (true, false) -> EHBacktrace()
  | (false, true) -> EHKeepGoing()
  | (false, false) -> EHDefault()
  };
  cliSrcFiles = args.getArray("src-file");
  importStubs = args.getArray("import-stubs");
  cliBaseUrl = args.maybeGetString("base-url");

  // Resolve source files and root via tsconfig.json if applicable.
  // Decision tree (matches tsc behavior):
  // 1. Explicit src-file args -> use directly, no tsconfig
  // 2. --project/-p specified -> load that tsconfig
  // 3. No files, no --project -> auto-discover tsconfig.json
  (root, srcFiles, compilerOptions) = if (!cliSrcFiles.isEmpty()) {
    // Reject combining --project with explicit source files (matches tsc TS5042)
    if (args.maybeGetString("project").isSome()) {
      print_error(
        "Option 'project' cannot be mixed with source files on a command line",
      );
      throw Exit(2)
    };
    // Explicit files provided: no tsconfig processing
    (cliBaseUrl.default("."), cliSrcFiles, TsCompilerOptions{})
  } else {
    tsconfigPath: ?String = args.maybeGetString("project") match {
    | Some(projectPath) ->
      resolveTsConfigPath(projectPath) match {
      | Success(p) -> Some(p)
      | Failure(err) ->
        print_error(err);
        throw Exit(2)
      }
    | None() ->
      // Auto-discover: walk up from cwd looking for tsconfig.json
      findTsConfig(getcwd())
    };
    tsconfigPath match {
    | None() ->
      // No tsconfig found, fall through to existing behavior
      (cliBaseUrl.default("."), Array[], TsCompilerOptions{})
    | Some(configPath) ->
      (config, diagnostics) = try {
        loadTsConfig(configPath)
      } catch {
      | exn ->
        print_error(`Failed to parse ${configPath}: ${exn.getMessage()}`);
        throw Exit(2)
      };
      // Report tsconfig lint diagnostics
      for (diag in diagnostics) {
        prefix = if (diag.isWarning) "warning" else "error";
        print_error(`${configPath}:${diag.line}: ${prefix}: ${diag.message}`);
      };
      resolvedFiles: Array<String> = resolveConfigFiles(config);
      if (resolvedFiles.isEmpty()) {
        print_error(`No input files found from ${configPath}`);
        throw Exit(2)
      };
      // Determine root: CLI --base-url overrides tsconfig baseUrl/rootDir
      effectiveRoot = cliBaseUrl match {
      | Some(cliRoot) -> cliRoot
      | None() ->
        configDirStr = config.configDir.toString();
        config.compilerOptions.baseUrl match {
        | Some(bu) -> Path.join(configDirStr, bu)
        | None() ->
          config.compilerOptions.rootDir match {
          | Some(rd) -> Path.join(configDirStr, rd)
          | None() -> configDirStr
          }
        }
      };
      (effectiveRoot, resolvedFiles, config.compilerOptions)
    }
  };

  if (importStubs.size() > 1) {
    print_error(
      "More than one --import-stubs specified; using first one for builtins file",
    );
  };
  logAffectedFiles = args.getBool("log-affected-files");
  if (logAffectedFiles) {
    if (args.maybeGetString("init").isSome()) {
      print_error(
        "--log-affected-files is incompatible with --init; run with --data after initializing",
      );
      throw Exit(2);
    };
    if (args.maybeGetString("data").isNone()) {
      print_error(
        "--log-affected-files requires a persisted cache of results; did you run with --init? ",
      );
      throw Exit(2);
    };
  };

  // Parse error detail specifications
  // Each argument can contain semicolon-separated specs
  errorDetailSpecs = args.getArray("error-detail").flatMap(arg ->
    arg.split(";").map(spec ->
      ErrorDetailConfig::parseSpec(spec) match {
      | Success(s) -> s
      | Failure(err) ->
        print_error(err);
        throw Exit(2)
      }
    )
  );
  errorDetailConfig = ErrorDetailConfig(errorDetailSpecs);

  errorFormat = ErrorFormat::ofString(args.getString("error-format")) match {
  | Success(ef) -> ef
  | Failure(fmt) ->
    print_error(
      `Unknown error format: ${fmt}. Available formats: ${ErrorFormat::all}`,
    );
    throw Exit(2)
  };

  errorsDirName = SKStore.DirName::create("/check/errors/");

  context = SKStore.runWithGcReturnContext(
    SKStore.Context::create{},
    (context) ~> {
      files = Files::create(context, root, srcFiles, importStubs) match {
      | Failure(err) ->
        print_error(err);
        return SKStore.CStop(None())
      | Success(checker) -> checker
      };

      initDir = getInitDir(context);
      _ = applyOrReuseMap(
        initDir,
        SKStore.UnitID::keyType,
        SKStore.VoidFile::type,
        context,
        sinkDirName,
        (context, _writer, _key, _values) ~> {
          Checker::create{
            context,
            files,
            errorHandling,
            errorDetailConfig,
            compilerOptions,
          } match {
          | Failure(errs) ->
            _ = applyOrReuseMap(
              initDir,
              SKStore.UnitID::keyType,
              ErrorMessageFile::type,
              context,
              errorsDirName,
              (_context, writer, _key, _values) ~> {
                writer.setArray(
                  SKStore.UnitID::singleton,
                  errs.map(err -> ErrorMessageFile(err)),
                )
              },
            )
          | Success(checker) ->
            checked = checker.checkFiles(context);
            _ = checked.map(
              SKStore.UnitID::keyType,
              ErrorMessageFile::type,
              context,
              errorsDirName,
              (context, writer, _key, valueIter) ~> {
                (parseErrorOpt, typeErrors) = valueIter.getUnique() match {
                | None() ->
                  internal_error("Unexpected missing value in print-errors")
                | Some(CheckResult(_, x, y, _, _, _)) -> (x, y)
                };
                errors = mutable Vector[];
                parseErrorOpt match {
                | None() -> void
                | Some(err) ->
                  errors.push(
                    ErrorMessageFile(checker.errorToMessage(context, err)),
                  )
                };

                for (error in typeErrors) {
                  errors.push(
                    ErrorMessageFile(checker.errorToMessage(context, error)),
                  );
                };
                writer.setArray(SKStore.UnitID::singleton, errors.toArray());
              },
            );
            _ = CallGraph::build(context, checked)
          }
        },
      );
      tick = context.getTick();
      context.update();
      hasErrors = context
        .maybeGetEagerDir(errorsDirName)
        .map(dir -> dir.getArrayRaw(SKStore.UnitID::singleton).size() != 0)
        .default(true);
      if (logAffectedFiles && !hasErrors) {
        CallGraph::create(context).each(callgraph -> {
          handle = SKStore.EHandle(
            ResolvedDefKey::keyType,
            ResolvedDefFile::type,
            resolvedDefsDirName,
          );
          (_reset, keys) = context
            .unsafeGetEagerDir(resolvedDefsDirName)
            .getChangesAfter(tick);
          defs = mutable Vector[];
          for (key in keys) {
            key match {
            | k @ ResolvedDefKey _ ->
              defs.extend(handle.unsafeGetArray(context, k))
            | _ -> internal_error("Unexpected key type")
            }
          };
          callgraph
            .affectedFiles(context, defs.map(x -> x.orig).toArray())
            .each(f -> print_string(f.toString()));
        })
      };

      SKStore.CStop(None())
    },
  );
  context.maybeGetEagerDir(errorsDirName) match {
  | None() -> 2
  | Some(dir) ->
    errors = dir.getArrayRaw(SKStore.UnitID::singleton);
    printErrors(errors, errorFormat);
    if (errors.size() != 0) 2 else 0
  }
}

fun printErrors(errors: Array<SKStore.File>, errorFormat: ErrorFormat): void {
  msgs = errors
    .map(e -> ErrorMessageFile::type(e).value)
    .filter(msg -> !msg.isEmpty());
  errorFormat match {
  | EFJson() -> errorMessagesToJson(msgs).writeToStream(print_error_raw, 2)
  | textErrorFormat @ TextErrorFormat _ ->
    for (errMsg in msgs) {
      print_error(formatErrorMessage(errMsg, textErrorFormat));
      // Blank line separator between errors
      print_error("")
    }
  }
}

class CheckResult(
  fileName: FPath,
  parseError: ?LexingOrParsingError,
  errors: Array<Error>,
  callgraph: SortedMap<CGNode, Array<CGNode>> = SortedMap[],
  classHierarchy: SortedMap<CHNode, SortedSet<CHNode>> = SortedMap[],
  subtypingEdges: SortedSet<(CGNode, CGNode)> = SortedSet[],
) extends SKStore.File

class Checker private {
  files: Files,
  parsedFiles: SKStore.EHandle<FPath, ParsedResultFile>,
  checker: TypeChecker,
  newLinesMap: NewLinesMap,
  symbolsMap: SymbolsMap,
  funDefSigMap: FunDefSigMap,
  funDefBodyMap: FunDefBodyMap,
  classBodyMap: ClassBodyMap,
  classFieldMap: ClassFieldMap,
  typeDefBodyMap: TypeDefBodyMap,
  methodBodyMap: MethodBodyMap,
  errorDetailConfig: ErrorDetailConfig,
} {
  /* Returns Failure for parse errors only if errorHandling is EHDefault */
  static fun create{
    context: mutable SKStore.Context,
    files: Files,
    errorHandling: ErrorHandling,
    errorDetailConfig: ErrorDetailConfig,
    compilerOptions: TsCompilerOptions = TsCompilerOptions{},
  }: Result<this, Array<ErrorMessage>> {
    newLinesMap = NewLinesMap::create(context, files);
    (
      parsedAndSymbolsFiles,
      symbolsMap,
      funDefSigMap,
      funDefBodyMap,
      classBodyMap,
      classFieldMap,
      typeDefBodyMap,
      methodBodyMap,
    ) = files.parse(context, newLinesMap, errorHandling) match {
    | Success(r) -> r
    | Failure(errs) -> return Failure(errs)
    };
    parsedFiles = removeSymbols(context, parsedAndSymbolsFiles);
    builtinsFileName = files.builtinsFileName;
    defMap = DefMap::create(
      context,
      builtinsFileName,
      files.rootMap,
      parsedFiles,
      compilerOptions,
    );
    checker = TypeChecker{
      defMap,
      errorHandling,
      funDefSigMap,
      funDefBodyMap,
      classBodyMap,
      classFieldMap,
      typeDefBodyMap,
      methodBodyMap,
    };
    Success(
      static{
        files,
        parsedFiles,
        checker,
        newLinesMap,
        symbolsMap,
        funDefSigMap,
        funDefBodyMap,
        classBodyMap,
        classFieldMap,
        typeDefBodyMap,
        methodBodyMap,
        errorDetailConfig,
      },
    )
  }

  fun checkFiles(
    context: mutable SKStore.Context,
  ): SKStore.EHandle<FPath, CheckResult> {
    checkDir = SKStore.LHandle::create(
      DefKey::keyType,
      TCResultsAccFile::type,
      context,
      SKStore.DirName::create("/defs/"),
      (context, _self, key) ~> {
        results = try {
          Success(this.checker.checkDef(context, key.def).chill())
        } catch {
        | e -> Failure(e)
        };
        Array[TCResultsAccFile(results)]
      },
    );
    this.parsedFiles.map(
      FPath::keyType,
      CheckResult::type,
      context,
      SKStore.DirName::create("/check-results/"),
      (context, writer, fileName, valueIter) ~> {
        parsedFile = valueIter.first;
        parsedFile.value match {
        | PROk(defs) ->
          results = this.checker.check(context, checkDir, fileName, defs);
          fileDefErrors = this.checker.defMap.getNamingErrors(
            context,
            fileName,
          );
          errors = fileDefErrors.concat(results.errors);
          writer.set(
            fileName,
            CheckResult(
              fileName,
              None(),
              errors,
              results.callgraph,
              results.classHierarchy,
              results.subtypingEdges,
            ),
          )
        | PRError(err) ->
          writer.set(fileName, CheckResult(fileName, Some(err), Array[]))
        }
      },
    );
  }

  fun errorToMessage(
    context: mutable SKStore.Context,
    err: Error,
  ): ErrorMessage {
    err.toErrorMessage(
      context,
      this.files.rootMap,
      this.newLinesMap,
      this.symbolsMap,
      this.errorDetailConfig,
    )
  }
}

base class ErrorHandling uses Orderable {
  children =
  | EHDefault()
  | EHBacktrace()
  | EHKeepGoing()
}

module end;
