module SKJS;

/*****************************************************************************/
// Version
/*****************************************************************************/

const kVersion: String = "0.9";

/*****************************************************************************/
// Help
/*****************************************************************************/

fun help(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("help")
      .arg(
        Cli.StringArg("command")
          .positional()
          .about(
            "If specified, the subcommand for which help is to be displayed",
          ),
      )
      .about("Displays help for a skjs subcommand"),
    execHelp,
  )
}

fun execHelp(args: Cli.ParseResults): void {
  optSubcmd = args.maybeGetString("command");
  optSubcmd.flatMap(subcmd ->
    args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)
  ) match {
  | Some(cmd) -> print_string(Cli.usage(cmd, true, Some(args.cmd)))
  | _ ->
    optSubcmd match {
    | Some(subcmd) -> print_error(`error: Invalid subcommand ${subcmd}.`)
    | _ -> print_error("error: No subcommand specified.")
    };
    print_string(Cli.usage(args.cmd, true))
  };
}

/*****************************************************************************/
// Main entry point
/*****************************************************************************/

fun main(): void {
  saved = SKStore.newObstack();
  cmd = Cli.Command("skjs")
    .about("SKJS skdb js development framework")
    .arg(
      Cli.BoolArg("version")
        .short("V")
        .long("version")
        .about("Print version info and exit"),
    )
    .arg(
      Cli.BoolArg("verbose")
        .short("v")
        .long("verbose")
        .about("Use verbose output")
        .global(),
    );
  suppliers = Array[check, help];
  commands = mutable Map[];
  for (supplier in suppliers) {
    (subcommand, cmdFn) = supplier();
    !cmd = cmd.subcommand(subcommand);
    commands.set(subcommand.name, cmdFn);
  };
  !cmd = cmd.help();
  args = cmd.parseArgs();
  if (args.getBool("version")) {
    print_string(Environ.args().next().default("skjs") + " " + kVersion);
    SKStore.destroyObstack(saved);
    skipExit(0);
  } else {
    args.maybeGetSubcommand() match {
    | Some(subcmd) ->
      commands.maybeGet(subcmd) match {
      | Some(handler) ->
        skipExit(
          if (args.getBool("backtrace")) {
            handler(args);
            SKStore.destroyObstack(saved);
            0
          } else {
            try {
              handler(args);
              SKStore.destroyObstack(saved);
              0
            } catch {
            | exn ->
              e = SKStore.destroyObstackWithValue(saved, List[exn]).getHead();
              throw e
            }
          },
        )
      | _ -> invariant_violation(`Unknown subcommand ${subcmd}`)
      }
    | None() ->
      print_string(Cli.usage(args.cmd, true));
      SKStore.destroyObstack(saved);
      skipExit(0)
    }
  };
}

/*****************************************************************************/
/* Checks that JSON objects match a schema */
/*****************************************************************************/

fun check(): (Cli.Command, Cli.ParseResults ~> void) {
  (
    Cli.Command("check")
      .about("Typechecks")
      .arg(
        Cli.BoolArg("backtrace")
          .short("b")
          .long("backtrace")
          .about("Internal (debugging)"),
      ),
    execCheck,
  )
}

fun readLineOpt(): ?String {
  try {
    read_line()
  } catch {
  | EndOfFile _ -> None()
  | exn -> throw exn
  }
}

fun defName(def: Def): Name {
  def.value match {
  | FunDef{name} ->
    name match {
    | Some(FNNormal(n)) -> n
    | _ -> invariant_violation("TODO fundef unexpected name")
    }
  | TypeDef{name} -> name
  | Class{name} -> name
  | Enum(_, name, _) -> name
  | Namespace(name, _) -> name
  | Declare(d) -> defName(d)
  | VarDefs(_, varDefs) ->
    if (varDefs.size() > 1) {
      invariant_violation("TODO multiple var defs for default")
    };
    invariant(varDefs.size() != 0);
    varDefs[0].pat.value match {
    | PVar(x) -> x
    | _ -> invariant_violation("TODO pattern defs for default")
    }
  | _ ->
    debug(class(def));
    invariant_violation("TODO defName")
  }
}

fun import(
  context: mutable SKStore.Context,
  cache: mutable Map<String, Array<Def>>,
  index: FileNameIndex,
  root: DirName,
  dirName: DirName,
  moduleName: String,
): void {
  debug(("IMPORT", dirName.toString(), moduleName));
  unixName = resolveName(context, index, root, dirName, moduleName) match {
  | None() -> return void
  | Some(x) -> x
  };
  fileName = unixName.toString();
  debug(("RESOLVED", fileName));
  if (!fileName.endsWith(".ts") && !fileName.endsWith(".tsx")) return void;
  if (cache.containsKey(fileName)) return void;
  content = FileSystem.readTextFile(fileName);
  lexer = Lexer::mcreate(fileName, content);
  parser = mutable Parser(lexer);
  cache![fileName] = Array[];
  imports = mutable Vector[];
  exportNames = mutable Set[];
  defs = mutable Map<String, Def>[];
  globals = mutable Vector[];
  exportDefault: ?Name = None();
  exportEq: ?Name = None();
  for (def in parser.toplevelDefs()) {
    def.value match {
    | Export(_, default, d) ->
      defName = defName(Def(def.pos, d));
      if (default is Some _) {
        if (exportDefault is Some _) {
          invariant_violation("TODO two export default");
        };
        !exportDefault = Some(defName)
      };
      defs![defName.value] = def

    | ExportDefault(_, Expr(_, Var(name))) ->
      if (exportDefault is Some _) {
        invariant_violation("TODO two export default");
      };
      exportNames.insert(name.value);
      !exportDefault = Some(name)
    | ExportDefault(_, _) ->
      invariant_violation("TODO export default not variable")
    | ExportNames(_, _moduleNames, e) ->
      e.map(x -> x.value) match {
      | None() ->
        void //invariant_violation("TODO export None()")
      | Some(EString(_, s)) -> imports.push(s)
      | _ -> invariant_violation("TODO export non-string")
      }
    //      invariant_violation("TODO export names")
    | Import(_kind, _, _names, INPath(mName)) -> imports.push(mName.value)
    | Import(_kind, _, _names, _) -> invariant_violation("TODO other import")
    | ExportEq(Expr(_, Var(n))) ->
      if (exportEq is Some _) {
        invariant_violation("TODO ExportEq defined twice")
      };
      !exportEq = Some(n)
    | ExportEq(_) -> invariant_violation("TODO ExportEq other")
    | ExportAs _ -> void
    | ExportImport _ ->
      debug(lexer.fileName);
      invariant_violation("TODO export import")
    | ImportExpr _ -> void
    | Declare(Def(_, Global(x)))
    | Global(x) ->
      globals.extend(x)
    | Module _
    | Namespace _
    | ToplevelExpr _
    | Declare _
    | TypeDef _
    | VarDefs _
    | Class _
    | Enum _
    | FunDef _ ->
      defs![defName(def).value] = def
    }
  };
  for (s in imports) {
    import(context, cache, index, root, unixName.dirName, s)
  }
}

fun execCheck(args: Cli.ParseResults): void {
  backtrace = args.getBool("backtrace");
  context = mutable SKStore.Context{};
  rootDirStr = FileSystem.realpath(".") + "/";
  root = DirName::create(rootDirStr);
  files = Files::create(context, rootDirStr);
  newLinesMap = NewLinesMap::create(context, files);
  index = FileNameIndex::create(context, files.filesContent);
  parsedFiles = files.parse(context, newLinesMap, rootDirStr + "src/");
  fileDefsMap = FileDefsMap::create(context, index, root, parsedFiles);
  defMap = DefMap{root, index, fileDefsMap};
  tenv = TEnv{defMap};
  checker = TypeChecker{backtrace, newLinesMap, defMap, tenv};
  doFile = fileName -> {
    parsedFile = parsedFiles.getArray(context, SKStore.SID(fileName));
    if (parsedFile.size() == 0) invariant_violation("could not parse?");
    parsedFile[0].value match {
    | PROk(defs) ->
      errors = checker.check(context, defs);
      for (error in errors) {
        print_string(error);
      }
    | PRError(err) -> print_error(err.toString())
    }
  };

  for (fileName in files.srcFiles) {
    if (backtrace) doFile(fileName) else {
      try {
        doFile(fileName)
      } catch {
      | ErrorExn(err) -> print_error(err.toString(context, newLinesMap))
      | exn -> throw exn
      }
    }
  };
}

module end;
