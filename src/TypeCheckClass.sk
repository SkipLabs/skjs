module SKJS;

extension class TypeChecker {
  // Whether two declarations of the same name declare the same type
  // parameters (names in order; arity included). tsc additionally compares
  // constraints and defaults; SKJS compares names only.
  private static fun tparamsIdentical(
    a: Array<TypeParam>,
    b: Array<TypeParam>,
  ): Bool {
    a.map(tp -> tp.name.value) == b.map(tp -> tp.name.value)
  }

  fun class_(tcenvl: mutable TCEnvLight, c: Class): void {
    !this.enclosingClass = Some(c.name);
    if (c.kind is CKInterface()) {
      // tsc TS2428: all declarations of a merged interface must declare
      // identical type parameters. class_ runs once per declaration (the
      // DefKey occurrence), so each offending declaration reports its own
      // error here.
      for (def in this.defMap.getAll(tcenvl, c.name, true)) {
        def match {
        | other @ Class{kind => CKInterface()} if (
          other.bodyRef != c.bodyRef
        ) ->
          if (!static::tparamsIdentical(c.tparams, other.tparams)) {
            tcenvl.error(
              Array[
                (
                  c.name.pos,
                  `All declarations of '${
                    c.name.value
                  }' must have identical type parameters.`,
                ),
              ],
              TSCode(2428),
            )
          }
        | _ -> void
        }
      }
    };
    classFields = this.getClassFields(tcenvl.context, c);
    // TS2392 fires only on a second constructor IMPLEMENTATION; the
    // signature-only declarations of a constructor overload set are fine.
    ctorImpl: ?ClassFieldMethod = None();
    for (fieldType in classFields) {
      fieldType match {
      | fd @ ClassFieldMethod{name => FNNormal(Name(fdPos, "constructor"))} if (
        fd.hasBody
      ) ->
        ctorImpl match {
        | Some(existingConstructor) ->
          tcenvl.error(
            Array[
              (fdPos, "Multiple constructor implementations are not allowed."),
              (existingConstructor.name.getPos(), "Previous implementation"),
            ],
            TSCode(2392),
          )
        | None() -> !ctorImpl = Some(fd)
        }
      | _ -> void
      }
    };
    static::checkTypeParams(tcenvl, c.tparams, OptionalTypeParamsForbidden());
    subst = Subst::createCheckingOwner(tcenvl);
    !this = this.addTParams(subst, c.tparams);
    targs = TArgs(c.tparams.map(tparam -> this.bindings[tparam.name.value]));
    fileName = c.name.pos.fileName;
    thisType = TType::classThisType(subst, this, c.name, targs.targs);
    // A class is ambient when it is an interface or comes from a .d.ts file
    // (tsc treats .d.ts files as ambient throughout); ambient classes never
    // need method/constructor implementations. `declare class` never reaches
    // class_ (checkDef_ has a dedicated Declare arm).
    classIsAmbient =
      c.kind is CKInterface() ||
      fileName.toString().endsWith(".d.ts");
    // Method/constructor overload groups span all declarations of the merged
    // name (interface merging), so collect them across defs, not just this
    // declaration. implMethodKeys holds `static:`-prefixed method names that
    // have an implementation somewhere in the group — used to suppress the
    // per-member "Method implementation is missing" error for signature-only
    // overloads (funDef reports it only when the group has no impl at all).
    implMethodKeys = mutable Set<String>[];
    ctorGroupHasImpl = false;
    groupDecls = mutable Vector[c];
    for (def in this.defMap.getAll(tcenvl, c.name, true)) {
      def match {
      | other @ Class _ -> groupDecls.push(other)
      | _ -> void
      }
    };
    for (decl in groupDecls) {
      for (f in this.getClassFields(tcenvl.context, decl)) {
        f match {
        | fd @ ClassFieldMethod _ ->
          if (fd.hasBody) {
            fd.name match {
            | FNNormal(n) ->
              if (n.value == "constructor") {
                !ctorGroupHasImpl = true
              } else {
                key = if (fd.isStatic()) {
                  `static:${n.value}`
                } else {
                  n.value
                };
                implMethodKeys.insert(key)
              }
            | _ -> void
            }
          }
        | _ -> void
        }
      }
    };
    // Run the overload-group checks once, from the first declaration of the
    // name (class_ runs once per declaration / DefKey occurrence).
    isFirstDecl = groupDecls.isEmpty() || groupDecls[0].name.pos == c.name.pos;
    if (isFirstDecl) {
      this.checkMethodOverloadGroups(
        tcenvl,
        c,
        groupDecls.toArray(),
        thisType,
        targs,
        classIsAmbient,
      )
    };
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        tcenvl.error(
          Array[(c.name.pos, "A class can only extend a single class")],
          TSCode(1174),
        )
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentReference, parentTArgs) ->
          parentName = this.heritageName(tcenvl, parentReference, isInterface);
          if (this.hasClassDef(tcenvl, parentName)) {
            parentClass = this.getClass(tcenvl, parentName);
            if (!isInterface && parentClass.kind is CKInterface()) {
              // A class extending an interface is only valid if a merged value
              // declaration provides a runtime constructor; an interface alone
              // has no value to use as a superclass.
              hasValueDef = this.defMap.getAll(tcenvl, parentName).any(def ->
                def match {
                | Class{kind => CKInterface()}
                | TypeDef _ ->
                  false
                | _ -> true
                }
              );
              if (!hasValueDef) {
                tcenvl.error(
                  Array[
                    (
                      parentName.pos,
                      `Cannot extend an interface '${parentName}'. Did you mean 'implements'?`,
                    ),
                  ],
                  TSCode(2689),
                )
              }
            };
            if (
              !isInterface &&
              parentClass.kind is CKClass() &&
              !this.defMap.getAll(tcenvl, parentReference).any(def ->
                def match {
                | Class{name} -> name.pos == parentClass.name.pos
                | _ -> false
                }
              )
            ) {
              tcenvl.error(
                Array[
                  (
                    parentReference.pos,
                    "The superclass name resolves to a different value",
                  ),
                ],
                TSCode(2507),
              )
            };
            // parentClass is already resolved above; pass it on rather than
            // resolving the same name twice more.
            superCstr = this.newConstructorOf(
              subst,
              parentClass,
              parentName,
              parentTArgs.map(ty -> this.normalize(subst, ty)),
            );
            super = this.newOf(
              subst,
              parentClass,
              parentName,
              parentTArgs.map(ty -> this.normalize(subst, ty)),
            );
            // An interface extending a class inherits its members but not its
            // identity (interfaces are structural), so it is checked against
            // the base's structural view.
            if (isInterface) {
              !super = TType::withoutClassIdentity(subst, this, super)
            };
            if (!isInterface) {
              !this.super = Some((superCstr, super));
            };
            tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
            tcenv.recordClassHierarchy{child => c, parent => parentClass};
            this.checkSubType(
              tcenv,
              parentName.pos,
              "This class incorrectly extends its base class",
              thisType,
              super,
              TSCode(2415),
            )
          } else {
            // The base is not a class/interface. An interface may still extend
            // a type alias that resolves to an object type; its members were
            // merged into `thisType` structurally by `addFieldsFromAliasBase`.
            // Verify the interface body is compatible with the base (catching
            // an incompatible field override, TS2430) and skip the class-
            // hierarchy bookkeeping, which has no parent Class to record.
            if (!isInterface) {
              // A type used as a value: `class C extends Alias` is invalid.
              tcenvl.error(
                Array[
                  (
                    parentName.pos,
                    `'${parentName}' only refers to a type, but is being used as a value here.`,
                  ),
                ],
                TSCode(2693),
              )
            } else {
              super = this.normalize(subst, ext);
              // Run the compatibility check only when the alias is a single-
              // branch object with no call/construct signature — i.e. exactly
              // what `addFieldsFromAliasBase` could merge in full. A non-object
              // base already reported TS2312 there, and a call/construct base
              // reported notSupported; in both cases the structural merge is
              // incomplete, so `thisType` would spuriously fail the subtype
              // check and pile on a second error.
              super
                .expand(subst, this, Some(Covariant()))
                .clauses.getObject() match {
              | Some(obj) if (obj.getBranches().size() == 1) ->
                tfields = obj.getBranches()[0];
                if (
                  !(tfields.call is CPresent _) &&
                  !(tfields.call is CFunction()) &&
                  !(tfields.new is CPresent _)
                ) {
                  tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
                  this.checkSubType(
                    tcenv,
                    parentName.pos,
                    "This interface incorrectly extends its base type",
                    thisType,
                    super,
                    TSCode(2430),
                  )
                }
              | _ -> void
              }
            }
          }
        | _ ->
          tcenvl.error(
            Array[(c.name.pos, "An 'extends' clause must reference a class")],
            TSCode(2507),
          )
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        if (this.hasClassDef(tcenvl, parentName)) {
          // `implements` is a structural contract: the implementer must have
          // the members, but it is not an instance of the implemented class.
          super = TType::withoutClassIdentity(
            subst,
            this,
            this.new(
              subst,
              parentName,
              parentTArgs.map(ty -> this.normalize(subst, ty)),
            ),
          );
          tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
          tcenv.recordClassHierarchy{
            child => c,
            parent => this.getClass(tcenvl, parentName),
          };
          this.checkSubType(
            tcenv,
            parentName.pos,
            `This class incorrectly implements '${parentName}'`,
            thisType,
            super,
            TSCode(2420),
          )
        } else {
          // The name is a type alias, not a class/interface. Unlike `extends`,
          // `implements` contributes no members to the class body, so no
          // structural merge is needed — only the conformance check.
          super = this.normalize(subst, interface);
          super
            .expand(subst, this, Some(Covariant()))
            .clauses.getObject() match {
          | Some(obj) if (obj.getBranches().size() == 1) ->
            tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
            this.checkSubType(
              tcenv,
              parentName.pos,
              `This class incorrectly implements '${parentName}'`,
              thisType,
              super,
              TSCode(2420),
            )
          | _ ->
            tcenvl.error(
              Array[
                (
                  c.name.pos,
                  "An 'implements' clause must reference an interface or class",
                ),
              ],
              TSCode(2422),
            )
          }
        }
      | _ ->
        tcenvl.error(
          Array[
            (
              c.name.pos,
              "An 'implements' clause must reference an interface or class",
            ),
          ],
          TSCode(2422),
        )
      }
    };
    hasConstructor = false;
    for (fieldType in classFields) {
      fieldType match {
      | field @ ClassFieldValue _ ->
        if (field.definiteAssignment && !this.conformance) {
          tcenvl.error(
            Array[
              (
                field.pos,
                "Definite assignment assertion ('!') on a class field is not supported by SKJS",
              ),
            ],
            SKJSCode(9039),
          )
        };
        isStatic = false;
        isReadonly = false;
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic _ -> !isStatic = true
          | ModReadonly _ -> !isReadonly = true
          | ModPublic _
          | ModPrivate _
          | ModProtected _ ->
            void /* private is recorded in TField in addFields; protected is treated as public */
          | mod ->
            tcenvl.error(
              Array[
                (
                  modifier.pos,
                  `Field modifier '${mod}' is not yet supported by SKJS`,
                ),
              ],
              SKJSCode(9008),
            )
          }
        };

        if (isStatic) {
          if (c.kind is CKInterface()) {
            // TS#1070: 'static' modifier cannot appear on a type member
            fatalError(
              Array[
                (
                  field.pos,
                  "'static' modifier cannot appear on a type member.",
                ),
              ],
              TSCode(1070),
            )
          };
          if (!isReadonly) {
            tcenvl.error(
              Array[(field.pos, "A static field must be marked 'readonly'")],
              SKJSCode(2019),
            )
          };
          field.optional.each(pos ->
            tcenvl.error(
              Array[(pos, "A static field cannot be optional")],
              SKJSCode(2020),
            )
          );
          bindingName = field.name match {
          | FNNormal(n) -> Some(`${c.name.value}.${n.value}`)
          | _ -> None()
          };
          this.validateToplevelConst(
            tcenvl,
            field.pos,
            field.type,
            field.value,
            bindingName,
          )
        } else {
          typeOpt = field.type match {
          | None() ->
            tcenvl.error(
              Array[
                (
                  field.pos,
                  `Member '${field.name.getName()}' must have an explicit type annotation`,
                ),
              ],
              TSCode(7008),
            );
            None()
          | Some(ty) -> Some(this.normalize(subst, ty))
          };
          (field.value, typeOpt) match {
          | (None(), _)
          | (_, None()) ->
            void
          | (Some(e), Some(type)) ->
            tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
            // Field initializers run in declaration order with `this` bound
            // to the instance, so bind `this` here — as the partially
            // initialized instance (only fields with initializers declared
            // before this one, mirroring the constructor's partialThisType)
            // so a read of a not-yet-initialized field stays rejected.
            fieldPos = field.pos;
            tcenv.scope.bind(
              tcenv,
              Name(field.pos, "this"),
              this.new(subst, c.name, targs.targs, ft ~>
                (ft.value is Some _ && ft.pos < fieldPos)
              ),
              true,
              true,
              false,
            );
            this.checkSubType(
              tcenv,
              e.pos,
              "Type of field initializer is not assignable to the field's declared type",
              this.expr(tcenv, e, true),
              type,
              TSCode(2322),
            );
            tcenv.validateHiddenEscapes()
          }
        }
      | fd @ ClassFieldMethod _ ->
        if (fd.name is FNNormal(Name(_, "constructor"))) {
          !hasConstructor = true;
          partialThisType = this.new(subst, c.name, targs.targs, fieldType ~>
            (fieldType is ClassFieldValue{value => Some _})
          );
          methods = classFields
            .iterator()
            .filterMap(fieldType ->
              fieldType match {
              | ClassFieldMethod{name} ->
                name match {
                | FNNormal(Name(_, methodName)) -> Some(methodName)
                | _ ->
                  tcenvl.error(
                    Array[
                      (
                        name.getPos(),
                        "A method name must be a plain identifier",
                      ),
                    ],
                    SKJSCode(1009),
                  );
                  None()
                }
              | ClassFieldValue _ -> None()
              }
            )
            .collect(SortedSet);
          // A signature-only constructor overload is fine when the group has
          // an implementation (or the class is ambient); only a group with no
          // implementation at all keeps the TS2391 from constructor().
          allowMissing = classIsAmbient || ctorGroupHasImpl;
          this.constructor(
            subst,
            thisType,
            partialThisType,
            fd,
            Some(c.name),
            methods,
            allowMissing,
          )
        } else {
          cgNode = CGNode::create(Method(fd.name, c.name, fd.isStatic()));
          // A signature-only overload of a method group that has an
          // implementation must not report "Method implementation is missing"
          // (funDef emits it for body-less methods of a real class); check
          // its signature only, like an ambient method.
          isSigOnlyOfImplGroup =
            !fd.hasBody &&
            !classIsAmbient &&
            c.kind is CKClass() &&
            implMethodKeys.contains(
              if (fd.isStatic()) {
                `static:${fd.name.getName()}`
              } else {
                fd.name.getName()
              },
            );
          thisTypeOpt = if (isSigOnlyOfImplGroup) {
            None()
          } else {
            Some((c.kind, thisType))
          };
          tcenvl.collectErrors(() -> {
            this.funDef(subst, thisTypeOpt, fd, cgNode)
          })
        }
      }
    };
    if (c.kind is CKClass() && !hasConstructor) {
      for (fieldType in classFields) {
        fieldType match {
        | field @ ClassFieldValue _ ->
          // Skip static fields (already validated) and `foo!: T` definite
          // assignment assertions (conformance mode)
          if (!field.isStatic() && !field.definiteAssignment) {
            field.value match {
            | None() ->
              if (field.optional is None()) {
                tcenvl.error(
                  Array[
                    (
                      field.pos,
                      `Field '${field.name.getName()}' has no initializer and is not assigned in the constructor`,
                    ),
                  ],
                  TSCode(2564),
                )
              }
            | Some(_) -> void
            }
          }
        | ClassFieldMethod _ -> void
        }
      }
    }
  }

  // Validates a same-named group of method declarations (across all merged
  // declarations of the class/interface name) as one overload set:
  // - TS2393 on every implementation after the first;
  // - TS2391 when the implementation is not the last member of the group;
  // - TS2394 when an overload signature is compatible with neither the
  //   implementation signature (subtype) nor the implementation BODY
  //   re-checked under the overload's signature (the sound check — see
  //   checkFunOverloadGroup for top-level functions).
  // Ambient classes (interfaces, .d.ts) need no implementation, so only the
  // compatibility check applies — and with no bodies there, nothing to check.
  private fun checkMethodOverloadGroups(
    tcenvl: mutable TCEnvLight,
    c: Class,
    decls: Array<Class>,
    thisType: TType,
    targs: TArgs,
    classIsAmbient: Bool,
  ): void {
    // Group non-constructor methods by (name, static), in declaration order
    // across all declarations of the merged name; deduplicate by position.
    groups = mutable Map<String, Array<ClassFieldMethod>>[];
    for (decl in decls) {
      for (f in this.getClassFields(tcenvl.context, decl)) {
        f match {
        | fd @ ClassFieldMethod _ ->
          fd.name match {
          | FNNormal(n) if (n.value != "constructor") ->
            key = if (fd.isStatic()) {
              `static:${n.value}`
            } else {
              n.value
            };
            vec = groups.maybeGet(key).default(Array[]);
            if (!vec.any(m -> m.name.getPos() == fd.name.getPos())) {
              groups![key] = vec.concat(Array[fd])
            }
          | _ -> void
          }
        | _ -> void
        }
      }
    };
    groups.each((_, members) -> {
      bodies = members.filter(fd -> fd.hasBody);
      if (bodies.size() > 1) {
        // tsc TS2393, reported at every implementation after the first.
        for (i in Range(1, bodies.size())) {
          tcenvl.error(
            Array[
              (bodies[i].name.getPos(), "Duplicate function implementation"),
            ],
            TSCode(2393),
          )
        }
      };
      if (bodies.size() == 1 && !members[members.size() - 1].hasBody) {
        // tsc TS2391: the implementation must immediately follow the overload
        // signatures.
        tcenvl.error(
          Array[
            (
              members[members.size() - 1].name.getPos(),
              "Function implementation is missing or not immediately following the declaration",
            ),
          ],
          TSCode(2391),
        )
      };
      // Implementation compatibility (sound, stricter than tsc's loose
      // "comparable" rule): for each signature-only overload O, either the
      // implementation signature is a subtype of O, or the implementation
      // body re-checked with O's signature type-checks.
      overloadSigs = members.filter(fd -> !fd.hasBody);
      if (!classIsAmbient && bodies.size() == 1 && !overloadSigs.isEmpty()) {
        implFd = bodies[0];
        implIsStatic = implFd.isStatic();
        implicitThisOpt = if (implIsStatic) {
          None()
        } else {
          Some(thisType)
        };
        implCgNode = CGNode::create(Method(implFd.name, c.name, implIsStatic));
        implTFuns = this.funDecl(tcenvl, implicitThisOpt, implFd, implCgNode);
        implTy = TType::single(TObject::createCall(implTFuns));
        for (ovFd in overloadSigs) {
          ovPos = ovFd.name.getPos();
          {
            ovImplicitThisOpt = if (ovFd.isStatic()) {
              None()
            } else {
              Some(thisType)
            };
            ovCgNode = CGNode::create(
              Method(ovFd.name, c.name, ovFd.isStatic()),
            );
            ovTFuns = this.funDecl(tcenvl, ovImplicitThisOpt, ovFd, ovCgNode);
            ovTy = TType::single(TObject::createCall(ovTFuns));
            subst = Subst::createCheckingOwner(tcenvl);
            sigOk = TType::isSub(subst, this, implTy, ovTy) is STOk();
            bodyOk = false;
            if (!sigOk) {
              implSig = this.getFunSig(tcenvl.context, implFd);
              ovSig = this.getFunSig(tcenvl.context, ovFd);
              trialFd = implFd with {
                sig => FSInline(
                  ovSig.tparams,
                  static::overloadTrialParams(implSig, ovSig),
                  ovSig.retType,
                ),
              };
              trialResults = TCResultsAcc::mcreate{
                errorHandling => this.errorHandling,
              };
              trialEnvl = mutable TCEnvLight{
                context => tcenvl.context,
                results => trialResults,
              };
              subst2 = Subst::createCheckingOwner(trialEnvl);
              exn = catchError(() ->
                this.funDef(
                  subst2,
                  Some((c.kind, thisType)),
                  trialFd,
                  implCgNode,
                  true,
                )
              );
              !bodyOk = exn.isNone() && trialResults.errors.isEmpty()
            };
            if (!sigOk && !bodyOk) {
              tcenvl.error(
                Array[
                  (
                    ovPos,
                    "Overload signature is not compatible with its implementation signature",
                  ),
                  (
                    implFd.name.getPos(),
                    "The implementation signature is declared here",
                  ),
                ],
                TSCode(2394),
              )
            }
          }
        }
      }
    });
    // Constructor overload group: same rules as methods, on the `new`
    // signatures. TS2392 (duplicate implementation) is reported in class_'s
    // preamble; TS2391 (missing / not-last implementation) comes from
    // constructor() per declaration.
    ctors = mutable Vector[];
    for (decl in decls) {
      for (f in this.getClassFields(tcenvl.context, decl)) {
        f match {
        | fd @ ClassFieldMethod _ if (
          fd.name is FNNormal(Name(_, "constructor"))
        ) ->
          if (!ctors.any(m -> m.name.getPos() == fd.name.getPos())) {
            ctors.push(fd)
          }
        | _ -> void
        }
      }
    };
    ctorArr = ctors.toArray();
    ctorBodies = ctorArr.filter(fd -> fd.hasBody);
    ctorSigs = ctorArr.filter(fd -> !fd.hasBody);
    if (!classIsAmbient && ctorBodies.size() == 1 && !ctorSigs.isEmpty()) {
      implFd = ctorBodies[0];
      implTFuns = this.makeConstructor(tcenvl, c.name, c.tparams, implFd);
      implTy = TType::single(TObject::createNew(implTFuns, c.name.pos));
      for (ovFd in ctorSigs) {
        ovPos = ovFd.name.getPos();
        {
          ovTFuns = this.makeConstructor(tcenvl, c.name, c.tparams, ovFd);
          ovTy = TType::single(TObject::createNew(ovTFuns, c.name.pos));
          subst = Subst::createCheckingOwner(tcenvl);
          sigOk = TType::isSub(subst, this, implTy, ovTy) is STOk();
          bodyOk = false;
          if (!sigOk) {
            implSig = this.getFunSig(tcenvl.context, implFd);
            ovSig = this.getFunSig(tcenvl.context, ovFd);
            trialFd = implFd with {
              sig => FSInline(
                ovSig.tparams,
                static::overloadTrialParams(implSig, ovSig),
                ovSig.retType,
              ),
            };
            trialResults = TCResultsAcc::mcreate{
              errorHandling => this.errorHandling,
            };
            trialEnvl = mutable TCEnvLight{
              context => tcenvl.context,
              results => trialResults,
            };
            subst2 = Subst::createCheckingOwner(trialEnvl);
            allFields = mutable Vector[];
            for (decl in decls) {
              for (f in this.getClassFields(tcenvl.context, decl)) {
                allFields.push(f)
              }
            };
            partialThisType = this.new(
              subst2,
              c.name,
              targs.targs,
              fieldType ~> (fieldType is ClassFieldValue{value => Some _}),
            );
            methodNames = allFields
              .toArray()
              .filterMap(f ->
                f match {
                | ClassFieldMethod{name => FNNormal(Name(_, mn))} -> Some(mn)
                | _ -> None()
                }
              )
              .collect(SortedSet);
            exn = catchError(() ->
              this.constructor(
                subst2,
                thisType,
                partialThisType,
                trialFd,
                Some(c.name),
                methodNames,
                true,
                true,
              )
            );
            !bodyOk = exn.isNone() && trialResults.errors.isEmpty()
          };
          if (!sigOk && !bodyOk) {
            tcenvl.error(
              Array[
                (
                  ovPos,
                  "Overload signature is not compatible with its implementation signature",
                ),
                (
                  implFd.name.getPos(),
                  "The implementation signature is declared here",
                ),
              ],
              TSCode(2394),
            )
          }
        }
      }
    }
  }

  fun constructor(
    subst: mutable Subst,
    thisType: TType,
    partialThisType: TType,
    fd: ClassFieldMethod,
    className: ?Name,
    methods: SortedSet<String>,
    allowMissingBody: Bool = false,
    inOverloadTrial: Bool = false,
  ): void {
    cstrSig = this.getFunSig(subst.context, fd);
    if (cstrSig.retType.i1 is Some _) {
      subst.error(
        Array[
          (
            cstrSig.retType.i0,
            "A constructor cannot have a return type annotation",
          ),
        ],
        TSCode(1093),
      );
    };
    // A constructor cannot declare an explicit `this` parameter (TS2681).
    if (cstrSig.params.size() > 0) {
      cstrSig.params[0].name.value match {
      | PVar(Name(thisPos, "this")) ->
        subst.error(
          Array[(thisPos, "A constructor cannot have a 'this' parameter")],
          TSCode(2681),
        )
      | _ -> void
      }
    };
    for (modifier in fd.modifiers.modifiers) {
      subst.error(
        Array[
          (
            modifier.pos,
            `'${modifier}' modifier cannot appear on a constructor`,
          ),
        ],
        TSCode(1089),
      );
    };
    fdPos = fd.name.getPos();
    cgNode = CGNode::create(
      className match {
      | Some(cname) -> Constructor(cname, fdPos.fileName)
      | None() -> AnonymousFunDef(fd)
      },
    );
    (!this, tcenv, typedParams) = this.funDefSetup(
      subst,
      Some(partialThisType),
      fd,
      cgNode,
    );
    tcenv.!inOverloadTrial = inOverloadTrial;
    // `this` is bound in funDefSetup as `Name(fdPos, "this")`, so its
    // declaration position (the localObjects key) is fdPos.
    tcenv.localObjects![fdPos] = LOCanGrow(Some(thisType));
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      subst.error(
        Array[(asyncPos, "'async' modifier cannot appear on a constructor")],
        TSCode(1089),
      )
    };
    this.getFunBody(subst.context, fd) match {
    | FDBNone() ->
      // allowMissingBody: a signature-only constructor overload of a group
      // that has an implementation (or an ambient class) — no error.
      if (!allowMissingBody) {
        subst.error(
          Array[(fdPos, "Constructor implementation is missing")],
          TSCode(2391),
        )
      }
    | FDBSome(body) ->
      (blockScope, _) = this.block(tcenv, body);
      blockThisType = blockScope.get(Name(fdPos, "this"));
      objType = static::filterMethods(
        blockThisType,
        tcenv.subst,
        this,
        methods,
      );
      fullType = static::filterMethods(thisType, tcenv.subst, this, methods);
      this.checkSubType(
        tcenv,
        fdPos,
        "Constructor does not initialize all fields to their declared types",
        objType,
        fullType,
        TSCode(2322),
      );
      tcenv.validateHiddenEscapes();
      if (getConfig(tcenv.context).buildCfg) {
        cfg = CFGBuilder::build(
          cgNode.id.toString(),
          fdPos,
          typedParams,
          // Constructors cannot have a return type annotation; model the
          // return type as void, matching TS semantics
          TType::single(TPrimUnit(TVoid(), fdPos)),
          body,
          tcenv.exprTypes,
          tcenv.stmtTerminations,
        );
        tcenv.results.!cfgs[cgNode] = cfg
      }
    };
  }
}

module end;
