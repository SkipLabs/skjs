module SKJS;

extension class TypeChecker {
  fun class_(tcenvl: mutable TCEnvLight, c: Class): void {
    context = tcenvl.context;
    results = tcenvl.results;
    constructor: ?ClassFieldTypeMethod = None();
    for (fieldType in c.fields) {
      fieldType match {
      | fd @ ClassFieldTypeMethod _ if (
        fd.name is FNNormal(Name(_, "constructor"))
      ) ->
        constructor match {
        | Some(existingConstructor) ->
          results.error(
            Array[
              (fd.pos, "Multiple constructor implementations are not allowed."),
              (existingConstructor.pos, "Previous implementation"),
            ],
          )
        | None() -> !constructor = Some(fd)
        }
      | _ -> void
      }
    };
    results.collectErrors(() ->
      static::checkTypeParams(c.tparams, OptionalTypeParamsForbidden())
    );
    subst = Subst::mcreate{context, results};
    targs = TArgs(
      c.tparams.map(tparam -> {
        // invariant(tparam.default is None()); // checked in checkTypeParams
        ttypeParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.pos.fileName,
          tparam.id,
          tparam.constraint.map(c -> this.tenv.normalize(subst, c)),
        );
        TType::fromTParamWithConstraint(
          subst,
          this.tenv,
          tparam.name.pos,
          ttypeParam,
        )
      }),
    );
    !this.tenv = this.tenv.addTParams(subst, c.tparams);
    fileName = c.name.pos.fileName;
    cstr = TType::inst(c.name, targs);
    thisType = TType::fromTParamWithConstraint(
      subst,
      this.tenv,
      c.name.pos,
      TParamWithConstraint(
        "this",
        fileName,
        Id::createThis(),
        Some(cstr.expand(subst, this.tenv, Covariant())),
      ),
    );
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        results.error(Array[(c.name.pos, "Cannot extend more than one class")])
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentName, parentTArgs) ->
          superCstr = this.tenv.newConstructor(
            subst,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(subst, ty)),
          );
          super = this.tenv.new(
            subst,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(subst, ty)),
          );
          if (!isInterface) {
            !this.super = Some((superCstr, super));
          };
          tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
          tcenv.recordClassHierarchy{
            child => c,
            parent => this.tenv.getClass(context, parentName),
          };
          results.collectErrors(() ->
            this.checkSubType(
              tcenv,
              parentName.pos,
              "Invalid extends",
              thisType,
              super,
            )
          )
        | _ -> results.error(Array[(c.name.pos, "Invalid extend")])
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        super = this.tenv.new(
          subst,
          parentName,
          parentTArgs.map(ty -> this.tenv.normalize(subst, ty)),
        );
        tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
        tcenv.recordClassHierarchy{
          child => c,
          parent => this.tenv.getClass(context, parentName),
        };
        results.collectErrors(() ->
          this.checkSubType(
            tcenv,
            parentName.pos,
            "Invalid implements",
            thisType,
            super,
          )
        )
      | _ -> results.error(Array[(c.name.pos, "Invalid implements")])
      }
    };
    hasConstructor = false;
    for (fieldType in c.fields) {
      fieldType match {
      | field @ ClassFieldTypeValue _ ->
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic(pos) ->
            results.error(Array[(pos, "static fields are forbidden")])
          | ModPublic _ -> void /* public is the default */
          | ModPrivate _
          | ModProtected _
          | ModReadonly _ ->
            /* TODO: intentionally ignore accessibility modifiers since TypeScript do check them */ void
          | mod ->
            results.error(
              Array[
                (
                  modifier.pos,
                  `TODO: field modifier '${mod}' (TypeChecker#class_)`,
                ),
              ],
            )
          }
        };
        typeOpt = field.type match {
        | None() ->
          results.error(Array[(field.pos, "Type annotation expected")]);
          None()
        | Some(ty) -> Some(this.tenv.normalize(subst, ty))
        };
        (field.value, typeOpt) match {
        | (None(), _)
        | (_, None()) ->
          void
        | (Some(e), Some(type)) ->
          tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
          results.collectErrors(() ->
            this.checkSubType(
              tcenv,
              e.pos,
              "Invalid assignment",
              this.expr(tcenv, e, true),
              type,
            )
          )
        }
      | fd @ ClassFieldTypeMethod _ ->
        if (fd.name is FNNormal(Name(_, "constructor"))) {
          !hasConstructor = true;
          partialThisType = this.tenv.new(
            subst,
            c.name,
            targs.targs,
            fieldType ~> (fieldType is ClassFieldTypeValue{value => Some _}),
          );
          methods = c.fields
            .iterator()
            .filterMap(fieldType ->
              fieldType match {
              | ClassFieldTypeMethod{pos, name} ->
                name match {
                | FNNormal(Name(_, methodName)) -> Some(methodName)
                | _ ->
                  results.error(Array[(pos, "Invalid method name")]);
                  None()
                }
              | ClassFieldTypeValue _ -> None()
              }
            )
            .collect(SortedSet);
          this.constructor(
            subst,
            thisType,
            partialThisType,
            fd,
            Some(c.name),
            methods,
            results,
          )
        } else {
          cgNode = CGNode::create(
            Method(fd.name, c.name, fd.pos.fileName, fd.isStatic()),
          );
          results.collectErrors(() -> {
            this.funDef(subst, Some((c.kind, thisType)), fd, cgNode, results)
          })
        }
      }
    };
    if (c.kind is CKClass() && !hasConstructor) {
      for (fieldType in c.fields) {
        fieldType match {
        | field @ ClassFieldTypeValue _ ->
          field.value match {
          | None() ->
            if (field.optional is None()) {
              results.error(Array[(field.pos, "Uninitialized field")])
            }
          | Some(_) -> void
          }
        | ClassFieldTypeMethod _ -> void
        }
      }
    }
  }

  fun constructor(
    subst: mutable Subst,
    thisType: TType,
    partialThisType: TType,
    fd: ClassFieldTypeMethod,
    className: ?Name,
    methods: SortedSet<String>,
    results: mutable TCResults,
  ): void {
    if (fd.retType.i1 is Some _) {
      results.error(
        Array[(fd.retType.i0, "Constructors don't have return types")],
      );
    };
    for (modifier in fd.modifiers.modifiers) {
      results.error(
        Array[(modifier.pos, "Constructors cannot have modifiers")],
      );
    };
    cgNode = CGNode::create(
      className match {
      | Some(cname) -> Constructor(cname, fd.pos.fileName)
      | None() -> AnonymousFunDef(fd)
      },
    );
    (!this, tcenv) = this.funDefSetup(
      subst,
      Some(partialThisType),
      fd,
      cgNode,
      results,
    );
    tcenv.localObjects!["this"] = LOCanGrow(Some(thisType));
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      results.error(Array[(asyncPos, "Constructors cannot be async")])
    };
    fd.body match {
    | FDBNone(pos) -> results.error(Array[(pos, "Missing definition")])
    | FDBSome(body) ->
      blockScope = this.block(tcenv, body);
      blockThisType = blockScope.get(Name(fd.pos, "this"));
      objType = static::filterMethods(
        blockThisType,
        tcenv.subst,
        this.tenv,
        methods,
      );
      fullType = static::filterMethods(
        thisType,
        tcenv.subst,
        this.tenv,
        methods,
      );
      results.collectErrors(() ->
        this.checkSubType(
          tcenv,
          fd.pos,
          "Invalid initialization",
          objType,
          fullType,
        )
      )
    };
  }
}

module end;
