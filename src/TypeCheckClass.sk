module SKJS;

extension class TypeChecker {
  fun class_(context: mutable SKStore.Context, c: Class): void {
    constructor: ?FunDef = None();
    for (fieldType in c.fields) {
      fieldType match {
      | fd @ FunDef _ if (fd.name is Some(FNNormal(Name(_, "constructor")))) ->
        constructor match {
        | Some(existingConstructor) ->
          typingError(
            Array[
              (fd.pos, "Multiple constructor implementations are not allowed."),
              (existingConstructor.pos, "Previous implementation"),
            ],
          )
        | None() -> !constructor = Some(fd)
        }
      | _ -> void
      }
    };
    static::checkTypeParams(c.tparams);
    subst = Subst::mcreate{context};
    targs = TArgs(
      c.tparams.map(tparam -> {
        if (tparam.default is Some _) {
          typingError(
            Array[
              (
                tparam.name.pos,
                "Optional type parameters are not supported for classes",
              ),
            ],
          )
        };
        ttypeParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.pos.fileName,
          tparam.id,
          tparam.constraint.map(c -> this.tenv.normalize(context, c)),
        );
        TType::fromTParamWithConstraint(
          subst,
          this.tenv,
          tparam.name.pos,
          ttypeParam,
        )
      }),
    );
    !this.tenv = this.tenv.addTParams(subst, c.tparams);
    fileName = c.name.pos.fileName;
    cstr = TType::inst(c.name, targs);
    thisType = TType::fromTParamWithConstraint(
      subst,
      this.tenv,
      c.name.pos,
      TParamWithConstraint(
        "this",
        fileName,
        Id::createThis(),
        Some(cstr.expand(subst, this.tenv, Covariant())),
      ),
    );
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        typingError(Array[(c.name.pos, "Cannot extend more than one class")])
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentName, parentTArgs) ->
          superCstr = this.tenv.newConstructor(
            context,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
          );
          super = this.tenv.new(
            context,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
          );
          if (!isInterface) {
            !this.super = Some((superCstr, super));
          };
          scope = Scope::mcreateToplevel(fileName);
          tcenv = mutable TCEnv(context, subst, scope);
          this.checkSubType(
            tcenv,
            parentName.pos,
            "Invalid extends",
            thisType,
            super,
          )
        | _ -> typingError(Array[(c.name.pos, "Invalid extend")])
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        super = this.tenv.new(
          context,
          parentName,
          parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
        );
        scope = Scope::mcreateToplevel(fileName);
        tcenv = mutable TCEnv(context, subst, scope);
        this.checkSubType(
          tcenv,
          parentName.pos,
          "Invalid implements",
          thisType,
          super,
        )
      | _ -> typingError(Array[(c.name.pos, "Invalid implements")])
      }
    };
    hasConstructor = false;
    for (fieldType in c.fields) {
      fieldType match {
      | field @ FieldTypeValue _ ->
        field.setGet match {
        | None() -> void
        | Some(FieldGetSet(_, pos)) -> notSupported(pos)
        };
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic(pos) ->
            typingError(Array[(pos, "static fields are forbidden")])
          | ModPublic _ -> void /* public is the default */
          | ModPrivate _
          | ModProtected _
          | ModReadonly _ ->
            /* TODO: intentionally ignore accessibility modifiers since TypeScript do check them */ void
          | mod ->
            typingError(
              Array[
                (
                  modifier.pos,
                  `TODO: field modifier '${mod}' (TypeChecker#class_)`,
                ),
              ],
            )
          }
        };
        type = this.tenv.normalize(context, field.type);
        field.value match {
        | None() -> void
        | Some(e) ->
          scope = Scope::mcreateToplevel(fileName);
          tcenv = mutable TCEnv(context, subst, scope);
          this.checkSubType(
            tcenv,
            e.pos,
            "Invalid assignment",
            this.expr(tcenv, e, true),
            type,
          )
        }
      | fd @ FunDef _ ->
        if (fd.name is Some(FNNormal(Name(_, "constructor")))) {
          !hasConstructor = true;
          partialThisType = this.tenv.new(
            context,
            c.name,
            targs.targs,
            fieldType ~> (fieldType is FieldTypeValue{value => Some _}),
          );
          _ = this.constructor(
            subst,
            thisType,
            partialThisType,
            fd,
            Some(c.name),
          )
        } else {
          cgNode = CGNode::create(
            Method(fd.name, c.name, fd.pos.fileName, fd.isStatic()),
          );
          _ = this.funDef(subst, Some((c.kind, thisType)), fd, cgNode)
        }
      }
    };
    if (c.kind is CKInterface() || c.kind is CKAbstract()) return void;
    if (!hasConstructor) {
      for (fieldType in c.fields) {
        fieldType match {
        | field @ FieldTypeValue _ ->
          field.value match {
          | None() ->
            if (field.optional is None()) {
              typingError(Array[(field.pos, "Uninitialized field")])
            }
          | Some(_) -> void
          }
        | FunDef _ -> void
        }
      }
    }
  }

  fun constructor(
    subst: mutable Subst,
    thisType: TType,
    partialThisType: TType,
    fd: FunDef,
    className: ?Name,
  ): void {
    if (fd.retType.i1 is Some _) {
      typingError(
        Array[(fd.retType.i0, "Constructors don't have return types")],
      );
    };
    for (modifier in fd.modifiers.modifiers) {
      typingError(Array[(modifier.pos, "Constructors cannot have modifiers")]);
    };
    cgNode = CGNode::create(
      className match {
      | Some(cname) -> Constructor(cname, fd.pos.fileName)
      | None() -> AnonymousFunDef(fd)
      },
    );
    (!this, tcenv) = this.funDefSetup(subst, Some(partialThisType), fd, cgNode);
    tcenv.localObjects!["this"] = Some(thisType);
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      typingError(Array[(asyncPos, "Constructors cannot be async")])
    };
    fd.body match {
    | FDBNone(pos) -> typingError(Array[(pos, "Missing definition")])
    | FDBSome(body) ->
      blockScope = this.block(tcenv, body);
      blockThisType = blockScope.get(Name(fd.pos, "this"));
      objType = static::filterMethods(blockThisType, tcenv.subst, this.tenv);
      fullType = static::filterMethods(thisType, tcenv.subst, this.tenv);
      this.checkSubType(
        tcenv,
        fd.pos,
        "Invalid initialization",
        objType,
        fullType,
      )
    };
  }
}

module end;
