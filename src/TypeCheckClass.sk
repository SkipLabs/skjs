module SKJS;

extension class TypeChecker {
  fun class_(tcenvl: mutable TCEnvLight, c: Class): void {
    !this.enclosingClass = Some(c.name);
    classFields = this.getClassFields(tcenvl.context, c);
    constructor: ?ClassFieldMethod = None();
    for (fieldType in classFields) {
      fieldType match {
      | fd @ ClassFieldMethod{name => FNNormal(Name(fdPos, "constructor"))} ->
        constructor match {
        | Some(existingConstructor) ->
          tcenvl.error(
            Array[
              (fdPos, "Multiple constructor implementations are not allowed."),
              (existingConstructor.name.getPos(), "Previous implementation"),
            ],
          )
        | None() -> !constructor = Some(fd)
        }
      | _ -> void
      }
    };
    static::checkTypeParams(tcenvl, c.tparams, OptionalTypeParamsForbidden());
    subst = Subst::mcreate(tcenvl);
    targs = TArgs(
      c.tparams.map(tparam -> {
        // invariant(tparam.default is None()); // checked in checkTypeParams
        ttypeParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.pos.fileName,
          tparam.id,
          tparam.constraint.map(c -> this.normalize(subst, c)),
        );
        TType::fromTParamWithConstraint(
          subst,
          this,
          tparam.name.pos,
          ttypeParam,
        )
      }),
    );
    !this = this.addTParams(subst, c.tparams);
    fileName = c.name.pos.fileName;
    cstr = TType::inst(c.name, targs);
    thisType = TType::fromTParamWithConstraint(
      subst,
      this,
      c.name.pos,
      TParamWithConstraint(
        "this",
        fileName,
        Id::createThis(),
        Some(cstr.expand(subst, this, Some(Covariant()))),
      ),
    );
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        tcenvl.error(Array[(c.name.pos, "Cannot extend more than one class")])
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentName, parentTArgs) ->
          superCstr = this.newConstructor(
            subst,
            parentName,
            parentTArgs.map(ty -> this.normalize(subst, ty)),
          );
          super = this.new(
            subst,
            parentName,
            parentTArgs.map(ty -> this.normalize(subst, ty)),
          );
          if (!isInterface) {
            !this.super = Some((superCstr, super));
          };
          tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
          tcenv.recordClassHierarchy{
            child => c,
            parent => this.getClass(tcenvl, parentName),
          };
          this.checkSubType(
            tcenv,
            parentName.pos,
            "This class incorrectly extends its base class",
            thisType,
            super,
            TSCode(2415),
          )
        | _ ->
          tcenvl.error(
            Array[(c.name.pos, "An 'extends' clause must reference a class")],
            TSCode(2507),
          )
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        super = this.new(
          subst,
          parentName,
          parentTArgs.map(ty -> this.normalize(subst, ty)),
        );
        tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
        tcenv.recordClassHierarchy{
          child => c,
          parent => this.getClass(tcenvl, parentName),
        };
        this.checkSubType(
          tcenv,
          parentName.pos,
          `This class incorrectly implements '${parentName}'`,
          thisType,
          super,
          TSCode(2420),
        )
      | _ ->
        tcenvl.error(
          Array[
            (
              c.name.pos,
              "An 'implements' clause must reference an interface or class",
            ),
          ],
          TSCode(2422),
        )
      }
    };
    hasConstructor = false;
    for (fieldType in classFields) {
      fieldType match {
      | field @ ClassFieldValue _ ->
        isStatic = false;
        isReadonly = false;
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic _ -> !isStatic = true
          | ModReadonly _ -> !isReadonly = true
          | ModPublic _
          | ModPrivate _
          | ModProtected _ ->
            void /* private is recorded in TField in addFields; protected is treated as public */
          | mod ->
            tcenvl.error(
              Array[
                (
                  modifier.pos,
                  `Field modifier '${mod}' is not yet supported by SKJS`,
                ),
              ],
              SKJSCode(9008),
            )
          }
        };

        if (isStatic) {
          if (c.kind is CKInterface()) {
            // TS#1070: 'static' modifier cannot appear on a type member
            fatalError(
              Array[
                (
                  field.pos,
                  "'static' modifier cannot appear on a type member.",
                ),
              ],
            )
          };
          if (!isReadonly) {
            tcenvl.error(Array[(field.pos, "Static fields must be readonly")])
          };
          field.optional.each(pos ->
            tcenvl.error(Array[(pos, "Static fields cannot be optional")])
          );
          bindingName = field.name match {
          | FNNormal(n) -> Some(`${c.name.value}.${n.value}`)
          | _ -> None()
          };
          this.validateToplevelConst(
            tcenvl,
            field.pos,
            field.type,
            field.value,
            bindingName,
          )
        } else {
          typeOpt = field.type match {
          | None() ->
            tcenvl.error(
              Array[
                (
                  field.pos,
                  `Type annotation expected for '${field.name.getName()}'`,
                ),
              ],
            );
            None()
          | Some(ty) -> Some(this.normalize(subst, ty))
          };
          (field.value, typeOpt) match {
          | (None(), _)
          | (_, None()) ->
            void
          | (Some(e), Some(type)) ->
            tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
            this.checkSubType(
              tcenv,
              e.pos,
              "Type of field initializer is not assignable to the field's declared type",
              this.expr(tcenv, e, true),
              type,
              TSCode(2322),
            )
          }
        }
      | fd @ ClassFieldMethod _ ->
        if (fd.name is FNNormal(Name(_, "constructor"))) {
          !hasConstructor = true;
          partialThisType = this.new(subst, c.name, targs.targs, fieldType ~>
            (fieldType is ClassFieldValue{value => Some _})
          );
          methods = classFields
            .iterator()
            .filterMap(fieldType ->
              fieldType match {
              | ClassFieldMethod{name} ->
                name match {
                | FNNormal(Name(_, methodName)) -> Some(methodName)
                | _ ->
                  tcenvl.error(Array[(name.getPos(), "Invalid method name")]);
                  None()
                }
              | ClassFieldValue _ -> None()
              }
            )
            .collect(SortedSet);
          this.constructor(
            subst,
            thisType,
            partialThisType,
            fd,
            Some(c.name),
            methods,
          )
        } else {
          cgNode = CGNode::create(Method(fd.name, c.name, fd.isStatic()));
          tcenvl.collectErrors(() -> {
            this.funDef(subst, Some((c.kind, thisType)), fd, cgNode)
          })
        }
      }
    };
    if (c.kind is CKClass() && !hasConstructor) {
      for (fieldType in classFields) {
        fieldType match {
        | field @ ClassFieldValue _ ->
          // Skip static fields (already validated)
          if (!field.isStatic()) {
            field.value match {
            | None() ->
              if (field.optional is None()) {
                tcenvl.error(
                  Array[
                    (
                      field.pos,
                      `Uninitialized field '${field.name.getName()}'`,
                    ),
                  ],
                )
              }
            | Some(_) -> void
            }
          }
        | ClassFieldMethod _ -> void
        }
      }
    }
  }

  fun constructor(
    subst: mutable Subst,
    thisType: TType,
    partialThisType: TType,
    fd: ClassFieldMethod,
    className: ?Name,
    methods: SortedSet<String>,
  ): void {
    cstrSig = this.getFunSig(subst.context, fd);
    if (cstrSig.retType.i1 is Some _) {
      subst.error(
        Array[(cstrSig.retType.i0, "Constructors don't have return types")],
      );
    };
    for (modifier in fd.modifiers.modifiers) {
      subst.error(
        Array[
          (modifier.pos, `Constructors cannot have modifier '${modifier}'`),
        ],
      );
    };
    fdPos = fd.name.getPos();
    cgNode = CGNode::create(
      className match {
      | Some(cname) -> Constructor(cname, fdPos.fileName)
      | None() -> AnonymousFunDef(fd)
      },
    );
    (!this, tcenv) = this.funDefSetup(subst, Some(partialThisType), fd, cgNode);
    tcenv.localObjects!["this"] = LOCanGrow(Some(thisType));
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      subst.error(Array[(asyncPos, "Constructors cannot be async")])
    };
    this.getFunBody(subst.context, fd) match {
    | FDBNone() -> subst.error(Array[(fdPos, "Missing definition")])
    | FDBSome(body) ->
      blockScope = this.block(tcenv, body);
      blockThisType = blockScope.get(Name(fdPos, "this"));
      objType = static::filterMethods(
        blockThisType,
        tcenv.subst,
        this,
        methods,
      );
      fullType = static::filterMethods(thisType, tcenv.subst, this, methods);
      this.checkSubType(
        tcenv,
        fdPos,
        "Constructor does not initialize all fields to their declared types",
        objType,
        fullType,
        TSCode(2322),
      )
    };
  }
}

module end;
