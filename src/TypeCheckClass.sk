module SKJS;

extension class TypeChecker {
  fun class_(tcenvl: mutable TCEnvLight, c: Class): void {
    constructor: ?ClassFieldTypeMethod = None();
    for (fieldType in c.fields) {
      fieldType match {
      | fd @ ClassFieldTypeMethod _ if (
        fd.name is FNNormal(Name(_, "constructor"))
      ) ->
        constructor match {
        | Some(existingConstructor) ->
          tcenvl.error(
            Array[
              (fd.pos, "Multiple constructor implementations are not allowed."),
              (existingConstructor.pos, "Previous implementation"),
            ],
          )
        | None() -> !constructor = Some(fd)
        }
      | _ -> void
      }
    };
    static::checkTypeParams(tcenvl, c.tparams, OptionalTypeParamsForbidden());
    subst = Subst::mcreate(tcenvl);
    targs = TArgs(
      c.tparams.map(tparam -> {
        // invariant(tparam.default is None()); // checked in checkTypeParams
        ttypeParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.pos.fileName,
          tparam.id,
          tparam.constraint.map(c -> this.normalize(subst, c)),
        );
        TType::fromTParamWithConstraint(
          subst,
          this,
          tparam.name.pos,
          ttypeParam,
        )
      }),
    );
    !this = this.addTParams(subst, c.tparams);
    fileName = c.name.pos.fileName;
    cstr = TType::inst(c.name, targs);
    thisType = TType::fromTParamWithConstraint(
      subst,
      this,
      c.name.pos,
      TParamWithConstraint(
        "this",
        fileName,
        Id::createThis(),
        Some(cstr.expand(subst, this, Some(Covariant()))),
      ),
    );
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        tcenvl.error(Array[(c.name.pos, "Cannot extend more than one class")])
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentName, parentTArgs) ->
          superCstr = this.newConstructor(
            subst,
            parentName,
            parentTArgs.map(ty -> this.normalize(subst, ty)),
          );
          super = this.new(
            subst,
            parentName,
            parentTArgs.map(ty -> this.normalize(subst, ty)),
          );
          if (!isInterface) {
            !this.super = Some((superCstr, super));
          };
          tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
          tcenv.recordClassHierarchy{
            child => c,
            parent => this.getClass(tcenvl, parentName),
          };
          this.checkSubType(
            tcenv,
            parentName.pos,
            "Invalid extends",
            thisType,
            super,
          )
        | _ -> tcenvl.error(Array[(c.name.pos, "Invalid extend")])
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        super = this.new(
          subst,
          parentName,
          parentTArgs.map(ty -> this.normalize(subst, ty)),
        );
        tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
        tcenv.recordClassHierarchy{
          child => c,
          parent => this.getClass(tcenvl, parentName),
        };
        this.checkSubType(
          tcenv,
          parentName.pos,
          `Invalid implements: ${parentName}`,
          thisType,
          super,
        )
      | _ -> tcenvl.error(Array[(c.name.pos, "Invalid implements")])
      }
    };
    hasConstructor = false;
    for (fieldType in c.fields) {
      fieldType match {
      | field @ ClassFieldTypeValue _ ->
        isStatic = false;
        isReadonly = false;
        for (modifier in field.modifiers.modifiers) {
          modifier match {
          | ModStatic _ -> !isStatic = true
          | ModReadonly _ -> !isReadonly = true
          | ModPublic _ -> void /* public is the default */
          | ModPrivate _
          | ModProtected _ ->
            /* TODO: intentionally ignore accessibility modifiers since TypeScript do check them */ void
          | mod ->
            tcenvl.error(
              Array[
                (
                  modifier.pos,
                  `TODO: field modifier '${mod}' (TypeChecker#class_)`,
                ),
              ],
            )
          }
        };

        if (isStatic) {
          if (c.kind is CKInterface()) {
            // TS#1070: 'static' modifier cannot appear on a type member
            error(
              Array[
                (
                  field.pos,
                  "'static' modifier cannot appear on a type member.",
                ),
              ],
            )
          };
          if (!isReadonly) {
            tcenvl.error(Array[(field.pos, "static fields must be readonly")])
          };
          field.optional.each(pos ->
            tcenvl.error(Array[(pos, "static fields cannot be optional")])
          );
          this.validateToplevelConst(tcenvl, field.pos, field.type, field.value)
        } else {
          typeOpt = field.type match {
          | None() ->
            tcenvl.error(Array[(field.pos, "Type annotation expected")]);
            None()
          | Some(ty) -> Some(this.normalize(subst, ty))
          };
          (field.value, typeOpt) match {
          | (None(), _)
          | (_, None()) ->
            void
          | (Some(e), Some(type)) ->
            tcenv = TCEnv::mcreate(subst, CGNode::toplevel(fileName));
            this.checkSubType(
              tcenv,
              e.pos,
              "Invalid assignment",
              this.expr(tcenv, e, true),
              type,
            )
          }
        }
      | fd @ ClassFieldTypeMethod _ ->
        if (fd.name is FNNormal(Name(_, "constructor"))) {
          !hasConstructor = true;
          partialThisType = this.new(subst, c.name, targs.targs, fieldType ~>
            (fieldType is ClassFieldTypeValue{value => Some _})
          );
          methods = c.fields
            .iterator()
            .filterMap(fieldType ->
              fieldType match {
              | ClassFieldTypeMethod{pos, name} ->
                name match {
                | FNNormal(Name(_, methodName)) -> Some(methodName)
                | _ ->
                  tcenvl.error(Array[(pos, "Invalid method name")]);
                  None()
                }
              | ClassFieldTypeValue _ -> None()
              }
            )
            .collect(SortedSet);
          this.constructor(
            subst,
            thisType,
            partialThisType,
            fd,
            Some(c.name),
            methods,
          )
        } else {
          cgNode = CGNode::create(
            Method(fd.name, c.name, fd.pos.fileName, fd.isStatic()),
          );
          tcenvl.collectErrors(() -> {
            this.funDef(subst, Some((c.kind, thisType)), fd, cgNode)
          })
        }
      }
    };
    if (c.kind is CKClass() && !hasConstructor) {
      for (fieldType in c.fields) {
        fieldType match {
        | field @ ClassFieldTypeValue _ ->
          // Skip static fields (already validated)
          if (!field.isStatic()) {
            field.value match {
            | None() ->
              if (field.optional is None()) {
                tcenvl.error(Array[(field.pos, "Uninitialized field")])
              }
            | Some(_) -> void
            }
          }
        | ClassFieldTypeMethod _ -> void
        }
      }
    }
  }

  fun constructor(
    subst: mutable Subst,
    thisType: TType,
    partialThisType: TType,
    fd: ClassFieldTypeMethod,
    className: ?Name,
    methods: SortedSet<String>,
  ): void {
    if (fd.retType.i1 is Some _) {
      subst.error(
        Array[(fd.retType.i0, "Constructors don't have return types")],
      );
    };
    for (modifier in fd.modifiers.modifiers) {
      subst.error(Array[(modifier.pos, "Constructors cannot have modifiers")]);
    };
    cgNode = CGNode::create(
      className match {
      | Some(cname) -> Constructor(cname, fd.pos.fileName)
      | None() -> AnonymousFunDef(fd)
      },
    );
    (!this, tcenv) = this.funDefSetup(subst, Some(partialThisType), fd, cgNode);
    tcenv.localObjects!["this"] = LOCanGrow(Some(thisType));
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      subst.error(Array[(asyncPos, "Constructors cannot be async")])
    };
    fd.body match {
    | FDBNone(pos) -> subst.error(Array[(pos, "Missing definition")])
    | FDBSome(body) ->
      blockScope = this.block(tcenv, body);
      blockThisType = blockScope.get(Name(fd.pos, "this"));
      objType = static::filterMethods(
        blockThisType,
        tcenv.subst,
        this,
        methods,
      );
      fullType = static::filterMethods(thisType, tcenv.subst, this, methods);
      this.checkSubType(
        tcenv,
        fd.pos,
        "Invalid initialization",
        objType,
        fullType,
      )
    };
  }
}

module end;
