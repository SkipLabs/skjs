/***************************************************************************/
/* Type transformation class. */
/***************************************************************************/

module SKJS;

mutable base class ApplyType(
  visiting: SortedSet<TType> = SortedSet[],
  mutable seen: SortedMap<TType, TType> = SortedMap[],
) {
  type Env;

  overridable deferred mutable fun type(env: this::Env, ty: TType): TType {
    if (this.visiting.contains(ty)) {
      typingError(
        Array[(ty.pos, "Internal error:  found a Cyclic type in ApplyType")],
      )
    };
    this.seen.maybeGet(ty) match {
    | None() ->
      !this.visiting = this.visiting.set(ty);
      result = this.type_(env, ty);
      this.!seen[ty] = result;
      result
    | Some(x) -> x
    }
  }

  overridable deferred mutable fun type_(env: this::Env, ty: TType): TType {
    ty.rawMap(
      (insts) -> this.insts(env, insts),
      (clauses) -> this.clauses(env, clauses),
    )
  }

  overridable deferred mutable fun clauses(
    env: this::Env,
    clauses: Clauses,
  ): Clauses {
    clauses.map(c -> this.clause(env, c))
  }

  overridable deferred mutable fun clause(
    env: this::Env,
    clause: Clause,
  ): ?Clause {
    clause.map(
      x -> this.typeParam(env, x),
      sTypesOpt -> this.sTypesOpt(env, sTypesOpt),
    )
  }

  overridable deferred mutable fun typeParamWithConstraint(
    env: this::Env,
    tparam: TParamWithConstraint,
  ): TParamWithConstraint {
    TParamWithConstraint(
      tparam.name,
      tparam.fileName,
      tparam.id,
      tparam.cstr.map(c -> this.type(env, c)),
    )
  }

  overridable deferred mutable fun typeParam(
    _env: this::Env,
    tparam: TParam,
  ): TParam {
    TParam(tparam.name, tparam.fileName, tparam.id)
  }

  overridable deferred mutable fun sTypesOpt(
    env: this::Env,
    sTypesOpt: ?STypes, /* None represents Top */
  ): ?STypes {
    sTypesOpt.map(sTypes -> this.stypes(env, sTypes))
  }

  overridable deferred mutable fun stypes(
    env: this::Env,
    stypes: STypes,
  ): STypes {
    stypes.map(stype -> this.stype(env, stype))
  }

  overridable deferred mutable fun stype(env: this::Env, stype: SType): SType {
    stype match {
    | x @ TPrimUnit _
    | x @ TPrimValue _ ->
      x
    | TPromise(ty, pos) -> TPromise(this.type(env, ty), pos)
    | algs @ TAlgebraic _ -> this.algebraic(env, algs)
    | obj @ TObject _ -> this.object(env, obj)
    | tuples @ TTuple _ -> this.tuple(env, tuples)
    }
  }

  overridable deferred mutable fun algebraic(
    env: this::Env,
    algebraic: TAlgebraic,
  ): TAlgebraic {
    TAlgebraic(algebraic.branches.map(x -> this.constr(env, x)), algebraic.pos)
  }

  overridable deferred mutable fun constr(
    env: this::Env,
    constr: TConstr,
  ): TConstr {
    constr.map(fields -> this.fields(env, fields))
  }

  overridable deferred mutable fun object(
    env: this::Env,
    object: TObject,
  ): TObject {
    object.map(fields -> this.fields(env, fields))
  }

  overridable deferred mutable fun funs(env: this::Env, funs: TFuns): TFuns {
    funs.mapFuns(x -> this.fun_(env, x))
  }

  overridable deferred mutable fun fun_(env: this::Env, f: TFun): TFun {
    TFun(
      f.tparams.map(x -> this.typeParamWithConstraint(env, x)),
      f.thisParam.map(x -> this.type(env, x)),
      f.params.map(x -> this.type(env, x)),
      f.optionalParams.map(x -> this.type(env, x)),
      f.spreadParam.map(x -> this.arrayType(env, x)),
      this.type(env, f.retType),
      f.cgNodes,
    )
  }

  overridable deferred mutable fun arrayType(
    env: this::Env,
    arr: ArrayType,
  ): ArrayType {
    arr match {
    | ATArrayOf(eltType, pos) -> ATArrayOf(this.type(env, eltType), pos)
    | ATFullType(fullType) -> ATFullType(this.type(env, fullType))
    }
  }

  overridable deferred mutable fun fields(
    env: this::Env,
    fields: TFields,
  ): TFields {
    fields.map(
      x -> this.field(env, x),
      x -> this.indexField(env, x),
      x -> this.funs(env, x),
    )
  }

  overridable deferred mutable fun field(
    env: this::Env,
    field: TField,
  ): TField {
    field.mapType(ty -> this.type(env, ty))
  }

  overridable deferred mutable fun indexField(
    env: this::Env,
    indexField: TIndexField,
  ): TIndexField {
    indexField.mapTypes(ty -> this.type(env, ty))
  }

  overridable deferred mutable fun tuple(
    env: this::Env,
    tuple: TTuple,
  ): TTuple {
    TTuple(tuple.tuple.map(x -> this.type(env, x)), tuple.pos)
  }

  overridable deferred mutable fun insts(
    env: this::Env,
    insts: TInsts,
  ): TInsts {
    insts.filterMap(x -> this.inst(env, x))
  }

  overridable deferred mutable fun inst(env: this::Env, inst: TInst): ?TInst {
    inst match {
    | TSInst(name, targs) -> Some(TSInst(name, this.targs(env, targs)))
    | TInter(ty1, ty2) ->
      TInter::create(this.type(env, ty1), this.type(env, ty2))
    | tvar @ TVar _ -> Some(tvar.mapConstraints(ty -> this.type(env, ty)))
    | TArrayLit(tvar, tupleElts) ->
      Some(
        TArrayLit(
          tvar.mapConstraints(ty -> this.type(env, ty)),
          tupleElts.map(ty -> this.type(env, ty)),
        ),
      )
    }
  }

  overridable deferred mutable fun targs(env: this::Env, targs: TArgs): TArgs {
    TArgs(targs.targs.map(x -> this.type(env, x)))
  }
}

mutable class RenameClauses() extends ApplyType {
  type Env = SortedMap<Id, TParamWithConstraint>;
  mutable fun typeParamWithConstraint(
    subst: this::Env,
    tparam: TParamWithConstraint,
  ): TParamWithConstraint {
    if (subst.containsKey(tparam.id)) {
      subst[tparam.id]
    } else {
      tparam
    }
  }

  mutable fun typeParam(subst: this::Env, tparam: TParam): TParam {
    if (subst.containsKey(tparam.id)) {
      newTParam = subst[tparam.id];
      TParam(newTParam.name, newTParam.fileName, newTParam.id)
    } else {
      tparam
    }
  }
}

mutable class Instantiate() extends ApplyType {
  type Env = (mutable Subst, TEnv, SortedMap<Id, TType>);

  mutable fun type_(env: this::Env, ty: TType): TType {
    !ty = ty.rawMap(
      (insts) -> this.insts(env, insts),
      (clauses) -> this.clauses(env, clauses),
    );
    (subst, tenv, map) = env;
    ty.mapTParams(subst, tenv, (tparam) -> map.maybeGet(tparam.id))
  }
}

mutable class ExpandTVars() extends ApplyType {
  type Env = (mutable Subst, TEnv);

  mutable fun type_(env: this::Env, ty: TType): TType {
    !ty = ty.rawMap(
      (insts) -> this.insts(env, insts),
      (clauses) -> this.clauses(env, clauses),
    );
    (subst, tenv) = env;
    ty.expand(subst, tenv, Some(Covariant()));
  }
}

fun expandTVars(subst: mutable Subst, tenv: TEnv, ty: TType): TType {
  (mutable ExpandTVars()).type((subst, tenv), ty)
}

module end;
