/***************************************************************************/
// Logic that resolves exports/imports in a file.
//
// Note that a lot of that logic is poorly tested and probably
// wrong. We probably don't want to support most of the constructions
// in there anyway.
//
// The things that we should support properly:
// import { x, y, z } from ...;
// export { x, y, z } from ...
//
// The rest is too old. I am pushing the code as is, but this needs cleanup.
/***************************************************************************/

module alias S = SKStore;

module SKJS;

base class IDefMap {
  fun getType(mutable TCEnvBase, Name): TypeOnlyDef;
  fun getAll(
    mutable TCEnvBase,
    Name,
    typeOnly: Bool = false,
  ): Array<FileDefElt>;
  fun getNamingErrors(
    _context: mutable S.Context,
    _fileName: FPath,
  ): Array<NamingError>;
}

class DefMap(fileDefsDir: S.LHandle<FPath, FileDefs>) extends IDefMap {
  static fun create(
    context: mutable S.Context,
    fs: Fs,
    builtinsFileName: FPath,
    rootMap: RootMap,
    parsedFiles: S.EHandle<FPath, ParsedResultFile>,
    compilerOptions: TsCompilerOptions = TsCompilerOptions{},
  ): this {
    static(
      S.LHandle::create(
        FPath::keyType,
        FileDefs::type,
        context,
        S.DirName::create("/skjs/fileDefs/"),
        (context, _self, fileName) ~> {
          parsedFile = parsedFiles.maybeGet(context, fileName) match {
          | Some(parsedFile) -> parsedFile
          | None() ->
            print_error(
              `Cannot find file ${fileName}. Make sure it is included in the source files provided on the command line`,
            );
            throw Exit(2)
          };
          includes = if (fileName != builtinsFileName) {
            Array[builtinsFileName]
          } else {
            Array[]
          };
          parsedFile.value match {
          | PROk(defs) ->
            Array[
              FileDefsState::createFileDefs(
                context,
                fs,
                fileName.dirPath(),
                includes,
                rootMap,
                compilerOptions,
                defs,
              ),
            ]
          | _ -> Array[]
          }
        },
      ),
    )
  }

  fun getNamingErrors(
    context: mutable S.Context,
    fileName: FPath,
  ): Array<NamingError> {
    this.fileDefsDir.maybeGet(context, fileName) match {
    | Some(fileDefs) -> fileDefs.errors
    | None() -> Array[]
    }
  }

  fun getType(tcenvb: mutable TCEnvBase, path: Name): TypeOnlyDef {
    for (def in this.getAll(tcenvb, path, true)) {
      def match {
      | d @ TypeOnlyDef _ -> return d
      | _ ->
        invariant_violation("Passing typeOnly should return only TypeOnlyDef")
      }
    };
    fatalError(Array[(path.pos, `Type ${path} not found`)])
  }

  fun getAll(
    tcenvb: mutable TCEnvBase,
    path: Name,
    typeOnly: Bool = false,
  ): Array<FileDefElt> {
    tupleKind(path.value) match {
    | Some(kind) -> return Array[synthesizeTupleClass(path, kind)]
    | None() -> void
    };
    fileName = path.pos.fileName;
    tmp = this.getPath(tcenvb, fileName, path.value, typeOnly);
    result = mutable Vector[];
    for (elt in tmp) {
      elt match {
      | e @ FileDefElt _ -> result.push(e)
      | FDNamespace _ ->
        tcenvb.error(
          Array[
            (
              path.pos,
              `Internal error: encountered a namespace while getting '${path}'`,
            ),
          ],
        )
      }
    };
    result.toArray()
  }

  private fun getPath(
    tcenvb: mutable TCEnvBase,
    fileName: FPath,
    path: String,
    typeOnly: Bool,
  ): readonly Vector<FileDef> {
    defs: readonly Vector<FileDef> = Vector[
      FDNamespace(false, None(), this.getFileDefs(tcenvb, fileName)),
    ];
    pathElts = path.split(".");
    for (i => pathElt in pathElts) {
      dotTypeOnly = typeOnly && i >= pathElts.size() - 1;
      !defs = this.dot(tcenvb, defs, pathElt, dotTypeOnly)
    };
    defs
  }

  private fun dot(
    tcenvb: mutable TCEnvBase,
    defs: readonly Vector<FileDef>,
    name: String,
    typeOnly: Bool,
  ): readonly Vector<FileDef> {
    result = mutable Vector[];
    for (d in defs) {
      d match {
      | TopLevelFunDef{name => fdName} ->
        tcenvb.error(
          Array[
            (
              fdName.getPos(),
              `Qualified name access ('${name}') is not yet supported by SKJS`,
            ),
          ],
          SKJSCode(9003),
        )
      | TypeDef{name => Name(pos, _)}
      | Class{name => Name(pos, _)}
      | Enum(_isConst, Name(pos, _), _fields)
      | FDVar(_kind, Name(pos, _), _type, _value) ->
        tcenvb.error(
          Array[
            (
              pos,
              `Qualified name access ('${name}') is not yet supported by SKJS`,
            ),
          ],
          SKJSCode(9003),
        )
      | FDNamespace(nsTypeOnly, _posOpt, nsDefs) ->
        getTypeOnly = typeOnly || nsTypeOnly;
        this.getInDefs(tcenvb, nsDefs, name, getTypeOnly, result)
      }
    };
    result
  }

  private fun getInDefs(
    tcenvb: mutable TCEnvBase,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    invariant(name != "", "getInDefs expects a non-empty name");
    for (fileName in fileDefs.includes) {
      this.getInDefs(
        tcenvb,
        this.getFileDefs(tcenvb, fileName),
        name,
        typeOnly,
        result,
      )
    };
    fileDefs.imports.maybeGet(name) match {
    | Some(imports) ->
      this.getFromImports(
        tcenvb,
        imports,
        "",
        typeOnly,
        fileDefs.modules,
        result,
      )
    | None() -> void
    };
    fileDefs.defs.maybeGet(name) match {
    | Some(defs) ->
      if (typeOnly) {
        for (d in defs) {
          d match {
          | tod @ TypeOnlyDef _ -> result.push(tod)
          | _ -> void
          }
        }
      } else {
        result.extend(defs)
      }
    | None() -> void
    };
  }

  private fun getExported(
    tcenvb: mutable TCEnvBase,
    fileName: FPath,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    fileDefs = this.getFileDefs(tcenvb, fileName);
    if (name == "") {
      result.push(FDNamespace(typeOnly, None(), fileDefs))
    } else {
      this.getExportedInDefs(tcenvb, fileDefs, name, typeOnly, result)
    }
  }

  private fun getExportedInDefs(
    tcenvb: mutable TCEnvBase,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    invariant(name != "", "getExportedInDefs expects a non-empty name");
    fileDefs.reexports.maybeGet("") match {
    | Some(wholeModuleReexports) ->
      this.getFromImports(
        tcenvb,
        wholeModuleReexports,
        name,
        typeOnly,
        fileDefs.modules,
        result,
      )
    | None() -> void
    };
    fileDefs.exported.maybeGet(name) match {
    | Some(origNames) ->
      for (origName in origNames) {
        this.getInDefs(tcenvb, fileDefs, origName, typeOnly, result)
      }
    | None() -> void
    };
    fileDefs.reexports.maybeGet(name) match {
    | Some(reexports) ->
      this.getFromImports(
        tcenvb,
        reexports,
        "",
        typeOnly,
        fileDefs.modules,
        result,
      )
    | None() -> void
    }
  }

  private fun getFromImports(
    tcenvb: mutable TCEnvBase,
    imports: Array<Imported>,
    suffix: String,
    typeOnly: Bool,
    modules: Map<String, Vector<FileDefs>>,
    result: mutable Vector<FileDef>,
  ): void {
    for (import in imports) {
      name = import.origName + suffix;
      getTypeOnly = typeOnly || import.typeOnly;
      this.getExported(tcenvb, import.from.fileName, name, getTypeOnly, result);
      modules.maybeGet(import.from.name) match {
      | Some(augmentations) ->
        for (augmentation in augmentations) {
          this.getExportedInDefs(
            tcenvb,
            augmentation,
            name,
            getTypeOnly,
            result,
          )
        }
      | None() -> void
      }
    }
  }

  private fun getFileDefs(tcenvb: mutable TCEnvBase, fn: FPath): FileDefs {
    this.fileDefsDir.get(tcenvb.context, fn)
  }
}

class FileDefs{
  defs: Map<String, Array<FileDef>>,
  imports: Map<String, Array<Imported>>,
  exported: Map<String, Array<String>>,
  reexports: Map<String, Array<Imported>>,
  modules: Map<String, Vector/* Array makes skc fail */ <FileDefs>>,
  includes: Array<FPath>,
  errors: Array<NamingError> = Array[],
} extends S.File

base class FileDef {
  fun getPos(): ?PosRange {
    this match {
    | TopLevelFunDef{name => FNNormal(n)} -> Some(n.pos)
    | TypeDef{name => n} -> Some(n.pos)
    | Class{name => n} -> Some(n.pos)
    | Enum(_, n, _) -> Some(n.pos)
    | FDVar(_, n, _, _) -> Some(n.pos)
    | FDNamespace(_, posOpt, _) -> posOpt
    }
  }
}
base class FileDefElt extends FileDef
extension class TopLevelFunDef extends FileDefElt
extension class TypeDef extends FileDefElt
extension class Class extends FileDefElt
extension class Enum extends FileDefElt
class FDVar(
  kind: VarDefKind,
  name: Name,
  type: ?Type,
  value: ?Expr,
) extends FileDefElt
class FDNamespace(
  typeOnly: Bool,
  posOpt: ?PosRange,
  defs: FileDefs,
) extends FileDef

base class TypeOnlyDef extends FileDefElt
extension class TypeDef extends TypeOnlyDef
extension class Class extends TypeOnlyDef
extension class Enum extends TypeOnlyDef

value class Imported{
  typeOnly: Bool,
  origName: /* Empty string = whole module */ String,
  from: ModuleName,
}

value class ModuleName{name: String, fileName: FPath}

// Tracks which TypeScript declaration spaces a definition occupies.
// Some declarations occupy multiple spaces (e.g., class occupies both
// value and type).
value class DeclSpaces private {private val: Bool, private typ: Bool} {
  const value: this = DeclSpaces{val => true, typ => false};
  const type: this = DeclSpaces{val => false, typ => true};
  const valueAndType: this = DeclSpaces{val => true, typ => true};

  fun overlaps(other: this): Bool {
    (this.val && other.val) || (this.typ && other.typ)
  }

  static fun ofFileDef(def: FileDef): this {
    def match {
    | TopLevelFunDef _
    | FDVar _
    | FDNamespace _ ->
      static::value
    | TypeDef _
    | Class{kind => CKInterface()} ->
      static::type
    | Class{kind => CKClass()}
    | Class{kind => CKAbstract()}
    | Enum _ ->
      static::valueAndType
    }
  }
}

fun mapPush<K: Hashable & Equality, V>(
  m: mutable Map<K, mutable Vector<V>>,
  k: K,
  x: V,
): void {
  m.maybeGet(k) match {
  | None() -> m![k] = mutable Vector<V>[x]
  | Some(v) -> v.push(x)
  }
}

mutable class FileDefsState private {
  context: mutable S.Context,
  fs: Fs,
  dirName: DPath,
  rootMap: RootMap,
  compilerOptions: TsCompilerOptions,
  defs: mutable Map<String, mutable Vector<FileDef>> = mutable Map[],
  imports: mutable Map<String, mutable Vector<Imported>> = mutable Map[],
  exported: mutable Map<
    /* Empty string = whole module re-export */ String,
    mutable Vector<String>,
  > = mutable Map[],
  reexports: mutable Map<String, mutable Vector<Imported>> = mutable Map[],
  modules: mutable Map<String, mutable Vector<FileDefs>> = mutable Map[],
  includes: mutable Vector<FPath> = mutable Vector[],
  fileErrors: mutable Vector<NamingError> = mutable Vector[],
} {
  static fun createFileDefs(
    context: mutable S.Context,
    fs: Fs,
    dirName: DPath,
    includes: Array<FPath>,
    rootMap: RootMap,
    compilerOptions: TsCompilerOptions,
    parsedDefs: Array<Def>,
  ): FileDefs {
    state = mutable static{context, fs, dirName, rootMap, compilerOptions};
    state.includes.extend(includes);
    state.processDefs(parsedDefs)
  }

  private mutable fun resolveName(mname: Name): ?ModuleName {
    name = mname.value;
    resolved = if (name.startsWith("./") || name.startsWith("../")) {
      if (hasTsExtension(name)) {
        if (!this.compilerOptions.allowImportingTsExtensions) {
          suffix = Path.extname(name);
          this.fileErrors.push(
            NamingError(
              Array[
                (
                  mname.pos,
                  `An import path can only end with a '${suffix}' extension when 'allowImportingTsExtensions' is enabled.`,
                ),
              ],
            ),
          )
        }
      } else if (
        !hasJsLikeExtension(name) &&
        !this.compilerOptions.moduleResolution.isBundlerMode()
      ) {
        this.fileErrors.push(
          NamingError(
            Array[
              (
                mname.pos,
                "Relative imports require a '.js', '.mjs', or '.cjs' extension. " +
                  "Use 'moduleResolution: \"bundler\"' for extensionless imports.",
              ),
            ],
          ),
        )
      };
      resolveName(this.fs, this.dirName, this.rootMap, name)
    } else {
      // Try path alias resolution first
      resolvePathAlias(
        this.fs,
        this.rootMap.projectRoot,
        this.compilerOptions,
        name,
      ) match {
      | some @ Some(_) -> some
      | None() -> resolveStubs(this.fs, this.rootMap.importStubs, name)
      }
    };
    resolved match {
    | Some(fileName) -> Some(ModuleName{name, fileName})
    | None() ->
      this.fileErrors.push(
        NamingError(Array[(mname.pos, `Could not find module '${mname}'`)]),
      );
      None()
    }
  }

  private mutable fun processDefs(parsedDefs: Array<Def>): FileDefs {
    for (def in parsedDefs) {
      def.value match {
      | Expr _ -> void

      /* module was the old syntax for namespaces */
      | Module(name, defsOpt) ->
        this.newDef(false, Namespace(name, defsOpt.default(Array[])))

      | d @ Declarable _
      | Declare(d) ->
        this.newDef(false, d)

      | Export(d)
      | ExportDeclare(d) ->
        this.newDef(true, d)

      | ExportNames(_, names) -> this.exportNames(names)
      | ExportNamesFrom(isType, names, mname) ->
        this.resolveName(mname).each(modName -> {
          static::addImportsFrom(
            this.reexports,
            isType.isSome(),
            Array[names],
            modName,
          )
        })

      | ExportDefault(Expr(_, Var(n))) ->
        /* Treat
             export default x;
           as
             export { x as default };
         */
        this.exportNames(
          MCurly(Array[ModuleDefName(None(), n, Some(Name(n.pos, "default")))]),
        )

      | Import(isType, names, importName) ->
        this.resolveName(importName).each(modName -> {
          static::addImportsFrom(this.imports, isType.isSome(), names, modName)
        })

      | ExportAs _
      | ExportDefault _
      | ExportEq _
      | ImportExpr _
      | ExportImport _ ->
        this.fileErrors.push(
          NamingError(
            Array[(def.pos, "This export form is not yet supported by SKJS")],
            SKJSCode(9004),
          ),
        )
      }
    };
    this.toFileDefs()
  }

  private readonly fun toFileDefs(): FileDefs {
    FileDefs{
      imports => this.imports.map((_, x) -> x.toArray()),
      exported => this.exported.map((_, x) -> x.toArray()),
      reexports => this.reexports.map((_, x) -> x.toArray()),
      modules => this.modules.map((_, x) -> x.chill()),
      defs => this.defs.map((_, x) -> x.toArray()),
      includes => this.includes.toArray(),
      errors => this.fileErrors.toArray(),
    }
  }

  private mutable fun createSubFileDefs(defs: Array<Def>): FileDefs {
    state = mutable static{
      context => this.context,
      fs => this.fs,
      dirName => this.dirName,
      rootMap => this.rootMap,
      compilerOptions => this.compilerOptions,
    };
    state.processDefs(defs)
  }

  private mutable fun pushDef(name: Name, d: FileDef, isExport: Bool): void {
    if (isExport) mapPush(this.exported, name.value, name.value);
    this.defs.maybeGet(name.value) match {
    | None() -> this.defs![name.value] = mutable Vector[d]
    | Some(existingDefs) ->
      dSpaces = DeclSpaces::ofFileDef(d);
      existingDefs
        .find(existingDef ->
          DeclSpaces::ofFileDef(existingDef).overlaps(dSpaces)
        )
        .each(existingDef -> {
          msg1 = (name.pos, `${name} is already defined`);
          msgs = existingDef.getPos() match {
          | None() -> Array[msg1]
          | Some(existingPos) ->
            Array[msg1, (existingPos, "Previous definition was here")]
          };
          this.fileErrors.push(NamingError(msgs))
        });
      existingDefs.push(d)
    }
  }

  private mutable fun newDef(isExport: Bool, def: Declarable): void {
    def match {
    | d @ TypeDef{name} -> this.pushDef(name, d, isExport)
    | d @ Class{name} -> this.pushDef(name, d, isExport)
    | d @ Enum(_, name, _) -> this.pushDef(name, d, isExport)
    | Namespace(name, defs) ->
      d = FDNamespace(false, Some(name.pos), this.createSubFileDefs(defs));
      this.pushDef(name, d, isExport)
    | Module(name, Some(defs)) ->
      invariant(!isExport, "export module does not exist");
      mapPush(this.modules, name.value, this.createSubFileDefs(defs))
    | d @ TopLevelFunDef{name => FNNormal(fname)} ->
      this.pushDef(fname, d, isExport)

    | VarDefs(k, varDefs) ->
      for (varDef in varDefs) {
        varDef.pat.value match {
        | PVar(exportName) ->
          d = FDVar(k, exportName, varDef.type, varDef.value);
          this.pushDef(exportName, d, isExport)
        | _ ->
          this.fileErrors.push(
            NamingError(
              Array[
                (
                  varDef.pat.pos,
                  "Exporting a destructuring binding is not yet supported by SKJS",
                ),
              ],
              SKJSCode(9005),
            ),
          )
        }
      }
    | Global(defs) ->
      if (defs.size() > 0) {
        this.fileErrors.push(
          NamingError(
            Array[
              (
                defs[0].pos,
                "'declare global' blocks are not yet supported by SKJS",
              ),
            ],
            SKJSCode(9006),
          ),
        )
      } else {
        internal_error("TODO: global")
      }
    | Module(Name(pos, _), _defsOpt) ->
      this.fileErrors.push(
        NamingError(
          Array[
            (
              pos,
              "Namespace ('module') declarations are not yet supported by SKJS",
            ),
          ],
          SKJSCode(9007),
        ),
      )
    }
  }

  private mutable fun exportNames(names: MCurly): void {
    names match {
    | MCurly(moduleDefNames) ->
      for (moduleDefName in moduleDefNames) {
        exportName = moduleDefName.asName match {
        | None() -> moduleDefName.name.value
        | Some(asName) -> asName.value
        };
        mapPush(this.exported, exportName, moduleDefName.name.value)
      }
    }
  }

  private static fun addImportsFrom(
    imports: mutable Map<String, mutable Vector<Imported>>,
    typeOnly: Bool,
    namesList: Array<ModuleNames>,
    from: ModuleName,
  ): void {
    for (names in namesList) {
      names match {
      | MStar() ->
        mapPush(imports, "", Imported{typeOnly, origName => "", from})
      | MStarAs(asName) ->
        mapPush(imports, asName.value, Imported{typeOnly, origName => "", from})
      | MCurly(moduleDefNames) ->
        for (moduleDefName in moduleDefNames) {
          importName = moduleDefName.asName match {
          | None() -> moduleDefName.name.value
          | Some(asName) -> asName.value
          };
          eltTypeOnly = typeOnly || moduleDefName.isType.isSome();
          origName = moduleDefName.name.value;
          mapPush(
            imports,
            importName,
            Imported{typeOnly => eltTypeOnly, origName, from},
          )
        }
      | MName(asName) ->
        mapPush(
          imports,
          asName.value,
          Imported{typeOnly, origName => "default", from},
        )
      }
    }
  }
}

module end;
