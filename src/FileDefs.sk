/***************************************************************************/
// Logic that resolves exports/imports in a file.
//
// Note that a lot of that logic is poorly tested and probably
// wrong. We probably don't want to support most of the constructions
// in there anyway.
//
// The things that we should support properly:
// import { x, y, z } from ...;
// export { x, y, z } from ...
//
// The rest is too old. I am pushing the code as is, but this needs cleanup.
/***************************************************************************/

module alias S = SKStore;

module SKJS;

private base class LookupKind {
  children =
  | LookupType()
  | LookupTypeQuery()
  | LookupRuntime()
}

base class IDefMap {
  fun getType(mutable TCEnvBase, Name): TypeOnlyDef;
  fun getBuiltinValue(mutable TCEnvBase, String): ?FileDef;
  fun isBuiltinValue(mutable TCEnvBase, Name): Bool;
  fun getAll(
    mutable TCEnvBase,
    Name,
    typeOnly: Bool = false,
    typeQuery: Bool = false,
  ): Array<FileDefElt>;
  fun getNamingErrors(
    _context: mutable S.Context,
    _fileName: FPath,
  ): Array<NamingError>;
}

class DefMap(
  fileDefsDir: S.LHandle<FPath, FileDefs>,
  builtinsFileName: FPath,
) extends IDefMap {
  static fun create(
    context: mutable S.Context,
    fs: Fs,
    builtinsFileName: FPath,
    rootMap: RootMap,
    parsedFiles: S.EHandle<FPath, ParsedResultFile>,
  ): this {
    static(
      S.LHandle::create(
        FPath::keyType,
        FileDefs::type,
        context,
        S.DirName::create("/skjs/fileDefs/"),
        (context, _self, fileName) ~> {
          parsedFile = parsedFiles.maybeGet(context, fileName) match {
          | Some(parsedFile) -> parsedFile
          | None() ->
            print_error(
              `Cannot find file ${fileName}. Make sure it is included in the source files provided on the command line`,
            );
            throw Exit(2)
          };
          includes = if (fileName != builtinsFileName) {
            Array[builtinsFileName]
          } else {
            Array[]
          };
          parsedFile.value match {
          | PROk(defs) ->
            // The builtins (lib stubs) that every other file includes, so a
            // user declaration colliding with a stub definition can be
            // reported as a duplicate identifier (TS2300, issue #887).
            stubDefs = if (fileName != builtinsFileName) {
              _self.maybeGet(context, builtinsFileName)
            } else {
              None()
            };
            Array[
              FileDefsState::createFileDefs(
                context,
                fs,
                fileName.dirPath(),
                includes,
                rootMap,
                getConfig(context).compilerOptions,
                defs,
                stubDefs,
              ),
            ]
          | _ -> Array[]
          }
        },
      ),
      builtinsFileName,
    )
  }

  fun getBuiltinValue(tcenvb: mutable TCEnvBase, name: String): ?FileDef {
    this.getFileDefs(tcenvb, this.builtinsFileName)
      .defs.maybeGet(name)
      .flatMap(defs -> defs.find(def -> def.hasValue()))
  }

  fun isBuiltinValue(tcenvb: mutable TCEnvBase, name: Name): Bool {
    this.getAll(tcenvb, name)
      .find(def -> def.hasValue())
      .flatMap(def -> def.getPos())
      .map(pos -> pos.fileName == this.builtinsFileName)
      .default(false)
  }

  fun getNamingErrors(
    context: mutable S.Context,
    fileName: FPath,
  ): Array<NamingError> {
    this.fileDefsDir.maybeGet(context, fileName) match {
    | Some(fileDefs) -> fileDefs.errors
    | None() -> Array[]
    }
  }

  fun getType(tcenvb: mutable TCEnvBase, path: Name): TypeOnlyDef {
    for (def in this.getAll(tcenvb, path, true)) {
      def match {
      | d @ TypeOnlyDef _ -> return d
      | _ ->
        invariant_violation("Passing typeOnly should return only TypeOnlyDef")
      }
    };
    fatalError(Array[(path.pos, `Cannot find type '${path}'`)], TSCode(2304))
  }

  fun getAll(
    tcenvb: mutable TCEnvBase,
    path: Name,
    typeOnly: Bool = false,
    typeQuery: Bool = false,
  ): Array<FileDefElt> {
    tupleKind(path.value) match {
    | Some(kind) -> return Array[synthesizeTupleClass(path, kind)]
    | None() -> void
    };
    fileName = path.pos.fileName;
    lookup: LookupKind = if (typeOnly) LookupType() else {
      if (typeQuery) LookupTypeQuery() else LookupRuntime()
    };
    tmp = this.getPath(tcenvb, fileName, path.value, lookup, path.pos);
    hasValue = tmp.any(def -> def.hasValue());
    result = mutable Vector[];
    for (elt in tmp) {
      elt match {
      | e @ FileDefElt _ -> result.push(e)
      | FDTypeOnlyEdge(isExport) ->
        if (!hasValue) {
          wording = if (isExport) "exported using 'export type'" else {
            "imported using 'import type'"
          };
          fatalError(
            Array[
              (
                path.pos,
                `'${path}' cannot be used as a value because it was ${wording}.`,
              ),
            ],
            TSCode(if (isExport) 1362 else 1361),
          )
        }
      | FDNamespace _ ->
        tcenvb.error(
          Array[
            (
              path.pos,
              `Internal error: encountered a namespace while getting '${path}'`,
            ),
          ],
          SKJSCode(9999),
        )
      }
    };
    result.toArray()
  }

  private fun getPath(
    tcenvb: mutable TCEnvBase,
    fileName: FPath,
    path: String,
    lookup: LookupKind,
    // Span of the whole qualified reference, for diagnostics that must point
    // at the use site rather than at a resolved definition.
    refPos: PosRange,
  ): readonly Vector<FileDef> {
    defs: readonly Vector<FileDef> = Vector[
      FDNamespace(false, None(), this.getFileDefs(tcenvb, fileName)),
    ];
    pathElts = path.split(".");
    for (i => pathElt in pathElts) {
      dotTypeOnly = lookup is LookupType() && i >= pathElts.size() - 1;
      !defs = this.dot(tcenvb, defs, pathElt, dotTypeOnly, lookup, refPos)
    };
    defs
  }

  private fun dot(
    tcenvb: mutable TCEnvBase,
    defs: readonly Vector<FileDef>,
    name: String,
    typeOnly: Bool,
    lookup: LookupKind,
    refPos: PosRange,
  ): readonly Vector<FileDef> {
    result = mutable Vector<FileDef>[];
    for (d in defs) {
      d match {
      // A member of an enum, in type position (`E.A`): resolve it to an
      // EnumMemberDef. The member type itself is built by TEnv, which owns the
      // member folding; here we only need the enum and the member name. In
      // value position the enum value object handles the access, so this stays
      // an unsupported qualified access there.
      | en @ Enum _ if (typeOnly) ->
        result.push(EnumMemberDef(en, Name(refPos, name)))
      | TopLevelFunDef _
      | TypeDef _
      | Class _
      | Enum _
      | FDVar _
      | EnumMemberDef _ ->
        tcenvb.error(
          Array[
            (
              refPos,
              `Qualified name access ('${name}') is not yet supported by SKJS`,
            ),
          ],
          SKJSCode(9003),
        )
      | FDNamespace(nsTypeOnly, _posOpt, nsDefs) ->
        getTypeOnly = typeOnly || nsTypeOnly;
        this.getInDefs(tcenvb, nsDefs, name, getTypeOnly, result, lookup)
      | edge @ FDTypeOnlyEdge _ -> result.push(edge)
      }
    };
    result
  }

  private fun getInDefs(
    tcenvb: mutable TCEnvBase,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
    lookup: LookupKind,
  ): void {
    invariant(name != "", "getInDefs expects a non-empty name");
    local = mutable Vector[];
    this.getLocalDefs(tcenvb, fileDefs, name, typeOnly, lookup, local);
    if (
      fileDefs.imports.maybeGet(name).isSome() &&
      fileDefs.defs.maybeGet(name).isSome()
    ) {
      this.checkImportLocalConflict(tcenvb, fileDefs, name)
    };
    if (
      lookup is LookupType() ||
      !local.any(def -> def.hasValue() || def is FDTypeOnlyEdge _)
    ) {
      for (fileName in fileDefs.includes) {
        this.getInDefs(
          tcenvb,
          this.getFileDefs(tcenvb, fileName),
          name,
          typeOnly,
          result,
          lookup,
        )
      }
    };
    result.extend(local)
  }

  // tsc TS2440: an import binding whose name is also declared locally
  // conflicts when the two occupy the same declaration space (an imported
  // interface conflicts with a local interface or class, an imported
  // function or variable with a local value declaration, but not with a
  // purely type- or value-space local on the other side).
  private fun checkImportLocalConflict(
    tcenvb: mutable TCEnvBase,
    fileDefs: FileDefs,
    name: String,
  ): void {
    localDefs = fileDefs.defs.maybeGet(name).default(Array[]);
    for (import in fileDefs.imports.maybeGet(name).default(Array[])) {
      exported = mutable Vector<FileDef>[];
      this.getExported(
        tcenvb,
        import.from.fileName,
        import.origName,
        false,
        exported,
        LookupTypeQuery(),
      );
      for (exportedDef in exported) {
        for (localDef in localDefs) {
          if (
            DeclSpaces::ofFileDef(exportedDef).overlaps(
              DeclSpaces::ofFileDef(localDef),
            )
          ) {
            tcenvb.error(
              Array[
                (
                  import.pos,
                  `Import declaration conflicts with local declaration of '${name}'.`,
                ),
              ],
              TSCode(2440),
            )
          }
        }
      }
    }
  }

  private fun getLocalDefs(
    tcenvb: mutable TCEnvBase,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    lookup: LookupKind,
    result: mutable Vector<FileDef>,
  ): void {
    fileDefs.imports.maybeGet(name) match {
    | Some(imports) ->
      this.getFromImports(
        tcenvb,
        imports,
        "",
        typeOnly,
        fileDefs.modules,
        result,
        lookup,
        false,
      )
    | None() -> void
    };
    fileDefs.defs.maybeGet(name) match {
    | Some(defs) ->
      if (typeOnly) {
        for (d in defs) {
          d match {
          | tod @ TypeOnlyDef _ -> result.push(tod)
          | _ -> void
          }
        }
      } else {
        result.extend(defs)
      }
    | None() -> void
    };
  }

  private fun getExported(
    tcenvb: mutable TCEnvBase,
    fileName: FPath,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
    lookup: LookupKind,
  ): void {
    fileDefs = this.getFileDefs(tcenvb, fileName);
    if (name == "") {
      result.push(FDNamespace(typeOnly, None(), fileDefs))
    } else {
      this.getExportedInDefs(tcenvb, fileDefs, name, typeOnly, result, lookup)
    }
  }

  private fun getExportedInDefs(
    tcenvb: mutable TCEnvBase,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
    lookup: LookupKind,
  ): void {
    invariant(name != "", "getExportedInDefs expects a non-empty name");
    localExports = fileDefs.exported.maybeGet(name);
    namedReexports = fileDefs.reexports.maybeGet(name);
    // An explicit export owns the name even if the binding is type-only.
    if (localExports.isNone() && namedReexports.isNone()) {
      fileDefs.reexports.maybeGet("").each(wholeModuleReexports ->
        this.getFromImports(
          tcenvb,
          wholeModuleReexports,
          name,
          typeOnly,
          fileDefs.modules,
          result,
          lookup,
          true,
        )
      );
    };
    localExports match {
    | Some(origNames) ->
      for ((origName, exportTypeOnly) in origNames) {
        if (lookup is LookupRuntime() && exportTypeOnly) {
          declared = mutable Vector<FileDef>[];
          this.getLocalDefs(
            tcenvb,
            fileDefs,
            origName,
            false,
            LookupTypeQuery(),
            declared,
          );
          if (declared.any(def -> def.hasValue())) {
            result.push(FDTypeOnlyEdge(true))
          } else {
            result.extend(declared)
          }
        } else {
          this.getLocalDefs(
            tcenvb,
            fileDefs,
            origName,
            typeOnly,
            lookup,
            result,
          )
        }
      }
    | None() -> void
    };
    namedReexports match {
    | Some(reexports) ->
      this.getFromImports(
        tcenvb,
        reexports,
        "",
        typeOnly,
        fileDefs.modules,
        result,
        lookup,
        true,
      )
    | None() -> void
    }
  }

  private fun getFromImports(
    tcenvb: mutable TCEnvBase,
    imports: Array<Imported>,
    suffix: String,
    typeOnly: Bool,
    modules: Map<String, Vector<FileDefs>>,
    result: mutable Vector<FileDef>,
    lookup: LookupKind,
    isReexport: Bool,
  ): void {
    for (import in imports) {
      name = import.origName + suffix;
      getTypeOnly = typeOnly || (import.typeOnly && lookup is LookupType());
      if (lookup is LookupRuntime() && import.typeOnly) {
        // A type-only edge blocks a runtime read only if its target has a
        // value declaration. A pure type can coexist with an ambient value.
        exported = mutable Vector<FileDef>[];
        this.getExported(
          tcenvb,
          import.from.fileName,
          name,
          false,
          exported,
          LookupTypeQuery(),
        );
        if (exported.any(def -> def.hasValue())) {
          result.push(FDTypeOnlyEdge(isReexport))
        } else {
          result.extend(exported)
        };
        continue
      };
      this.getExported(
        tcenvb,
        import.from.fileName,
        name,
        getTypeOnly,
        result,
        lookup,
      );
      modules.maybeGet(import.from.name) match {
      | Some(augmentations) ->
        for (augmentation in augmentations) {
          this.getExportedInDefs(
            tcenvb,
            augmentation,
            name,
            getTypeOnly,
            result,
            lookup,
          )
        }
      | None() -> void
      }
    }
  }

  private fun getFileDefs(tcenvb: mutable TCEnvBase, fn: FPath): FileDefs {
    this.fileDefsDir.get(tcenvb.context, fn)
  }
}

class FileDefs{
  defs: Map<String, Array<FileDef>>,
  imports: Map<String, Array<Imported>>,
  exported: Map<String, Array<(String, Bool)>>,
  reexports: Map<String, Array<Imported>>,
  modules: Map<String, Vector/* Array makes skc fail */ <FileDefs>>,
  includes: Array<FPath>,
  errors: Array<NamingError> = Array[],
} extends S.File

base class FileDef {
  fun hasValue(): Bool {
    this match {
    | Class{kind => CKInterface()}
    | TypeDef _
    | EnumMemberDef _
    | FDTypeOnlyEdge _ ->
      false
    | FDNamespace(typeOnly, _, _) -> !typeOnly
    | Class _
    | TopLevelFunDef _
    | Enum _
    | FDVar _ ->
      true
    }
  }

  fun getPos(): ?PosRange {
    this match {
    | TopLevelFunDef{name => FNNormal(n)} -> Some(n.pos)
    | TypeDef{name => n} -> Some(n.pos)
    | Class{name => n} -> Some(n.pos)
    | Enum(_, n, _, _) -> Some(n.pos)
    | FDVar(_, n, _, _) -> Some(n.pos)
    | FDNamespace(_, posOpt, _) -> posOpt
    | FDTypeOnlyEdge _ -> None()
    | EnumMemberDef(_, member) -> Some(member.pos)
    }
  }
}
class FDTypeOnlyEdge(isExport: Bool) extends FileDef
base class FileDefElt extends FileDef
extension class TopLevelFunDef extends FileDefElt
extension class TypeDef extends FileDefElt
extension class Class extends FileDefElt
extension class Enum extends FileDefElt
class FDVar(
  kind: VarDefKind,
  name: Name,
  type: ?Type,
  value: ?Expr,
) extends FileDefElt
class FDNamespace(
  typeOnly: Bool,
  posOpt: ?PosRange,
  defs: FileDefs,
) extends FileDef

base class TypeOnlyDef extends FileDefElt
extension class TypeDef extends TypeOnlyDef
extension class Class extends TypeOnlyDef
extension class Enum extends TypeOnlyDef

// A qualified reference `E.A` to a member of an enum, synthesized by `dot`
// when resolving a dotted type name whose head is an enum (never stored in
// the defMap). The referenced member type is built by TEnv, which owns the
// member folding; here we only carry the enum and the member name.
class EnumMemberDef(en: Enum, member: Name) extends TypeOnlyDef uses XXHashable

value class Imported{
  typeOnly: Bool,
  origName: /* Empty string = whole module */ String,
  from: ModuleName,
  // Where the imported name is written, for diagnostics (TS2440).
  pos: PosRange,
}

value class ModuleName{name: String, fileName: FPath}

// Tracks which TypeScript declaration spaces a definition occupies.
// Some declarations occupy multiple spaces (e.g., class occupies both
// value and type).
value class DeclSpaces private {private val: Bool, private typ: Bool} {
  const value: this = DeclSpaces{val => true, typ => false};
  const type: this = DeclSpaces{val => false, typ => true};
  const valueAndType: this = DeclSpaces{val => true, typ => true};

  fun overlaps(other: this): Bool {
    (this.val && other.val) || (this.typ && other.typ)
  }

  static fun ofFileDef(def: FileDef): this {
    def match {
    | TopLevelFunDef _
    | FDVar _
    | FDNamespace _ ->
      static::value
    | FDTypeOnlyEdge _
    | TypeDef _
    | Class{kind => CKInterface()}
    | EnumMemberDef _ ->
      static::type
    | Class{kind => CKClass()}
    | Class{kind => CKAbstract()}
    | Enum _ ->
      static::valueAndType
    }
  }
}

fun mapPush<K: Hashable & Equality, V>(
  m: mutable Map<K, mutable Vector<V>>,
  k: K,
  x: V,
): void {
  m.maybeGet(k) match {
  | None() -> m![k] = mutable Vector<V>[x]
  | Some(v) -> v.push(x)
  }
}

// Whether `d` is an interface declaration (`interface Foo { ... }`).
private fun isInterfaceDef(d: FileDef): Bool {
  d match {
  | Class{kind => CKInterface()} -> true
  | _ -> false
  }
}

// Whether two same-name definitions collide in a declaration space. Two
// interface declarations do not: like tsc, SKJS merges their members
// (declaration merging, across files and against the import stubs), so only
// definitions that are not both interfaces count as duplicates. Two top-level
// function declarations do not either: they form one overload group (the
// group's shape — at most one implementation, and it last — is validated at
// check time in checkDef_).
private fun defsCollide(a: FileDef, b: FileDef): Bool {
  DeclSpaces::ofFileDef(a).overlaps(DeclSpaces::ofFileDef(b)) &&
    !(isInterfaceDef(a) && isInterfaceDef(b)) &&
    !(a is TopLevelFunDef _ && b is TopLevelFunDef _)
}

mutable class FileDefsState private {
  context: mutable S.Context,
  fs: Fs,
  dirName: DPath,
  rootMap: RootMap,
  compilerOptions: TsCompilerOptions,
  defs: mutable Map<String, mutable Vector<FileDef>> = mutable Map[],
  imports: mutable Map<String, mutable Vector<Imported>> = mutable Map[],
  exported: mutable Map<
    /* Empty string = whole module re-export */ String,
    mutable Vector<(String, Bool)>,
  > = mutable Map[],
  reexports: mutable Map<String, mutable Vector<Imported>> = mutable Map[],
  modules: mutable Map<String, mutable Vector<FileDefs>> = mutable Map[],
  includes: mutable Vector<FPath> = mutable Vector[],
  fileErrors: mutable Vector<NamingError> = mutable Vector[],
  // The builtins (lib stubs) this file includes, when it is not the builtins
  // file itself: a local declaration colliding with one of theirs is a
  // duplicate identifier (TS2300, issue #887).
  stubDefs: ?FileDefs = None(),
} {
  static fun createFileDefs(
    context: mutable S.Context,
    fs: Fs,
    dirName: DPath,
    includes: Array<FPath>,
    rootMap: RootMap,
    compilerOptions: TsCompilerOptions,
    parsedDefs: Array<Def>,
    stubDefs: ?FileDefs = None(),
  ): FileDefs {
    state = mutable static{
      context,
      fs,
      dirName,
      rootMap,
      compilerOptions,
      stubDefs,
    };
    state.includes.extend(includes);
    state.processDefs(parsedDefs)
  }

  private mutable fun resolveName(mname: Name): ?ModuleName {
    name = mname.value;
    resolved = if (name.startsWith("./") || name.startsWith("../")) {
      if (hasTsExtension(name)) {
        if (!this.compilerOptions.allowImportingTsExtensions) {
          suffix = Path.extname(name);
          this.fileErrors.push(
            NamingError(
              Array[
                (
                  mname.pos,
                  `An import path can only end with a '${suffix}' extension when 'allowImportingTsExtensions' is enabled.`,
                ),
              ],
              TSCode(5097),
            ),
          )
        }
      } else if (
        !hasJsLikeExtension(name) &&
        !this.compilerOptions.moduleResolution.isBundlerMode()
      ) {
        this.fileErrors.push(
          NamingError(
            Array[
              (
                mname.pos,
                "Relative imports require a '.js', '.mjs', or '.cjs' extension. " +
                  "Use 'moduleResolution: \"bundler\"' for extensionless imports.",
              ),
            ],
            SKJSCode(1011),
          ),
        )
      };
      resolveName(this.fs, this.dirName, this.rootMap, name)
    } else {
      // Try path alias resolution first
      resolvePathAlias(
        this.fs,
        this.rootMap.projectRoot,
        this.compilerOptions,
        name,
      ) match {
      | some @ Some(_) -> some
      | None() -> resolveStubs(this.fs, this.rootMap.importStubs, name)
      }
    };
    resolved match {
    | Some(fileName) -> Some(ModuleName{name, fileName})
    | None() ->
      this.fileErrors.push(
        NamingError(
          Array[
            (
              mname.pos,
              `Cannot find module '${mname}' or its corresponding type declarations`,
            ),
          ],
          TSCode(2307),
        ),
      );
      None()
    }
  }

  private mutable fun processDefs(parsedDefs: Array<Def>): FileDefs {
    for (def in parsedDefs) {
      def.value match {
      | Expr _ -> void

      /* module was the old syntax for namespaces */
      | Module(name, defsOpt) ->
        this.newDef(false, Namespace(name, defsOpt.default(Array[])))

      | d @ Declarable _
      | Declare(d) ->
        this.newDef(false, d)

      | Export(d)
      | ExportDeclare(d) ->
        this.newDef(true, d)

      | ExportNames(isType, names) -> this.exportNames(names, isType.isSome())
      | ExportNamesFrom(isType, names, mname) ->
        this.resolveName(mname).each(modName -> {
          static::addImportsFrom(
            this.reexports,
            isType.isSome(),
            Array[names],
            modName,
            def.pos,
          )
        })

      | ExportDefault(Expr(_, Var(n))) ->
        /* Treat
             export default x;
           as
             export { x as default };
         */
        this.exportNames(
          MCurly(Array[ModuleDefName(None(), n, Some(Name(n.pos, "default")))]),
        )

      | Import(isType, names, importName) ->
        this.resolveName(importName).each(modName -> {
          static::addImportsFrom(
            this.imports,
            isType.isSome(),
            names,
            modName,
            def.pos,
          )
        })

      | ExportAs _
      | ExportDefault _
      | ExportEq _
      | ImportExpr _
      | ExportImport _ ->
        this.fileErrors.push(
          NamingError(
            Array[(def.pos, "This export form is not yet supported by SKJS")],
            SKJSCode(9004),
          ),
        )
      }
    };
    this.toFileDefs()
  }

  private readonly fun toFileDefs(): FileDefs {
    FileDefs{
      imports => this.imports.map((_, x) -> x.toArray()),
      exported => this.exported.map((_, x) -> x.toArray()),
      reexports => this.reexports.map((_, x) -> x.toArray()),
      modules => this.modules.map((_, x) -> x.chill()),
      defs => this.defs.map((_, x) -> x.toArray()),
      includes => this.includes.toArray(),
      errors => this.fileErrors.toArray(),
    }
  }

  private mutable fun createSubFileDefs(defs: Array<Def>): FileDefs {
    state = mutable static{
      context => this.context,
      fs => this.fs,
      dirName => this.dirName,
      rootMap => this.rootMap,
      compilerOptions => this.compilerOptions,
      stubDefs => this.stubDefs,
    };
    state.processDefs(defs)
  }

  // Whether a lib/stub definition and a local one merge instead of colliding
  // (tsc declaration merging, issue #887): an interface merges with a
  // same-named interface or class — `declare interface Date {}` against the
  // lib's `declare class Date` augments it rather than duplicating it. Any
  // other overlapping pair (alias against anything, class against class,
  // value-space against value-space) is a duplicate identifier. This applies
  // only against stubs, where augmentation is the norm; two user
  // declarations in one file always collide (see pushDef).
  private static fun mergeableWithStub(stubDef: FileDef, d: FileDef): Bool {
    isInterface = (fd: FileDef) -> fd is Class{kind => CKInterface()};
    isClass = (fd: FileDef) ->
      fd is Class{kind => CKClass()} || fd is Class{kind => CKAbstract()};
    (isInterface(d) && (isInterface(stubDef) || isClass(stubDef))) ||
      (isClass(d) && isInterface(stubDef))
  }

  private mutable fun pushDef(name: Name, d: FileDef, isExport: Bool): void {
    if (isExport) mapPush(this.exported, name.value, (name.value, false));
    // A declaration colliding with a lib/stub definition (the builtins every
    // file includes) is a duplicate identifier as well (tsc TS2300, issue
    // #887): the stub's definition is the one name resolution reaches, so the
    // collision is reported at both declarations instead of surfacing only as
    // a confusing downstream error at a use.
    this.stubDefs.each(stubFileDefs ->
      stubFileDefs.defs.maybeGet(name.value).each(stubDefVec ->
        stubDefVec
          .find(stubDef ->
            DeclSpaces::ofFileDef(stubDef).overlaps(DeclSpaces::ofFileDef(d)) &&
              !static::mergeableWithStub(stubDef, d)
          )
          .each(stubDef -> {
            msg1 = (name.pos, `Duplicate identifier '${name}'`);
            msgs = stubDef.getPos() match {
            | None() -> Array[msg1]
            | Some(stubPos) ->
              Array[msg1, (stubPos, "Previous definition was here")]
            };
            this.fileErrors.push(NamingError(msgs, TSCode(2300)))
          })
      )
    );
    this.defs.maybeGet(name.value) match {
    | None() -> this.defs![name.value] = mutable Vector[d]
    | Some(existingDefs) ->
      existingDefs
        .find(existingDef -> defsCollide(existingDef, d))
        .each(existingDef -> {
          msg1 = (name.pos, `Duplicate identifier '${name}'`);
          msgs = existingDef.getPos() match {
          | None() -> Array[msg1]
          | Some(existingPos) ->
            Array[msg1, (existingPos, "Previous definition was here")]
          };
          this.fileErrors.push(NamingError(msgs, TSCode(2300)))
        });
      existingDefs.push(d)
    }
  }

  private mutable fun newDef(isExport: Bool, def: Declarable): void {
    def match {
    | d @ TypeDef{name} -> this.pushDef(name, d, isExport)
    | d @ Class{name} -> this.pushDef(name, d, isExport)
    | d @ Enum(_, name, _, _) -> this.pushDef(name, d, isExport)
    | Namespace(name, defs) ->
      d = FDNamespace(false, Some(name.pos), this.createSubFileDefs(defs));
      this.pushDef(name, d, isExport)
    | Module(name, Some(defs)) ->
      invariant(!isExport, "export module does not exist");
      mapPush(this.modules, name.value, this.createSubFileDefs(defs))
    | d @ TopLevelFunDef{name => FNNormal(fname)} ->
      this.pushDef(fname, d, isExport)

    | VarDefs(k, varDefs) ->
      for (varDef in varDefs) {
        varDef.pat.value match {
        | PVar(exportName) ->
          d = FDVar(k, exportName, varDef.type, varDef.value);
          this.pushDef(exportName, d, isExport)
        | _ ->
          this.fileErrors.push(
            NamingError(
              Array[
                (
                  varDef.pat.pos,
                  "Exporting a destructuring binding is not yet supported by SKJS",
                ),
              ],
              SKJSCode(9005),
            ),
          )
        }
      }
    | Global(defs) ->
      // A non-empty `declare global { ... }` is not supported yet; an empty
      // `declare global {}` declares nothing, so there is nothing to reject.
      if (defs.size() > 0) {
        this.fileErrors.push(
          NamingError(
            Array[
              (
                defs[0].pos,
                "'declare global' blocks are not yet supported by SKJS",
              ),
            ],
            SKJSCode(9006),
          ),
        )
      }
    | Module(Name(pos, _), _defsOpt) ->
      this.fileErrors.push(
        NamingError(
          Array[
            (
              pos,
              "Namespace ('module') declarations are not yet supported by SKJS",
            ),
          ],
          SKJSCode(9007),
        ),
      )
    }
  }

  private mutable fun exportNames(names: MCurly, typeOnly: Bool = false): void {
    names match {
    | MCurly(moduleDefNames) ->
      for (moduleDefName in moduleDefNames) {
        exportName = moduleDefName.asName match {
        | None() -> moduleDefName.name.value
        | Some(asName) -> asName.value
        };
        mapPush(
          this.exported,
          exportName,
          (moduleDefName.name.value, typeOnly || moduleDefName.isType.isSome()),
        )
      }
    }
  }

  private static fun addImportsFrom(
    imports: mutable Map<String, mutable Vector<Imported>>,
    typeOnly: Bool,
    namesList: Array<ModuleNames>,
    from: ModuleName,
    stmtPos: PosRange,
  ): void {
    for (names in namesList) {
      names match {
      | MStar() ->
        mapPush(
          imports,
          "",
          Imported{typeOnly, origName => "", from, pos => stmtPos},
        )
      | MStarAs(asName) ->
        mapPush(
          imports,
          asName.value,
          Imported{typeOnly, origName => "", from, pos => asName.pos},
        )
      | MCurly(moduleDefNames) ->
        for (moduleDefName in moduleDefNames) {
          importName = moduleDefName.asName match {
          | None() -> moduleDefName.name.value
          | Some(asName) -> asName.value
          };
          eltTypeOnly = typeOnly || moduleDefName.isType.isSome();
          origName = moduleDefName.name.value;
          mapPush(
            imports,
            importName,
            Imported{
              typeOnly => eltTypeOnly,
              origName,
              from,
              pos => moduleDefName.name.pos,
            },
          )
        }
      | MName(asName) ->
        mapPush(
          imports,
          asName.value,
          Imported{typeOnly, origName => "default", from, pos => asName.pos},
        )
      }
    }
  }
}

module end;
