/***************************************************************************/
// Logic that resolves exports/imports in a file.
//
// Note that a lot of that logic is poorly tested and probably
// wrong. We probably don't want to support most of the constructions
// in there anyway.
//
// The things that we should support properly:
// import { x, y, z } from ...;
// export { x, y, z } from ...
//
// The rest is too old. I am pushing the code as is, but this needs cleanup.
/***************************************************************************/

module alias S = SKStore;

module SKJS;

base class IDefMap {
  fun getType(mutable S.Context, Name): TypeOnlyDef;
  fun getAll(
    mutable S.Context,
    Name,
    typeOnly: Bool = false,
  ): Array<FileDefElt>;
}

class DefMap(fileDefsDir: S.LHandle<S.SID, FileDefs>) extends IDefMap {
  static fun create(
    context: mutable S.Context,
    index: FileNameIndex,
    rootOpt: ?DirName,
    builtinsFileName: FileName,
    importStubs: Array<DirName>,
    parsedFiles: S.EHandle<S.SID, ParsedResultFile>,
  ): this {
    static(
      S.LHandle::create(
        S.SID::keyType,
        FileDefs::type,
        context,
        S.DirName::create("/skjs/fileDefs/"),
        (context, _self, key) ~> {
          fileName = FileName::create(key.value);
          parsedFile = parsedFiles.get(context, key);
          includes = if (fileName != builtinsFileName) {
            Array[builtinsFileName]
          } else {
            Array[]
          };
          parsedFile.value match {
          | PROk(defs) ->
            Array[
              FileDefsState::createFileDefs(
                context,
                index,
                rootOpt,
                fileName.dirName,
                includes,
                importStubs,
                defs,
              ),
            ]
          | _ -> Array[]
          }
        },
      ),
    )
  }

  fun getType(context: mutable S.Context, path: Name): TypeOnlyDef {
    for (def in this.getAll(context, path, true)) {
      def match {
      | d @ TypeOnlyDef _ -> return d
      | _ ->
        invariant_violation("Passing typeOnly should return only TypeOnlyDef")
      }
    };
    typingError(Array[(path.pos, `Type ${path} not found`)])
  }

  fun getAll(
    context: mutable S.Context,
    path: Name,
    typeOnly: Bool = false,
  ): Array<FileDefElt> {
    fileName = FileName::create(path.pos.fileName);
    tmp = this.getPath(context, fileName, path.value, typeOnly);
    result = mutable Vector[];
    for (elt in tmp) {
      elt match {
      | e @ FileDefElt _ -> result.push(e)
      | FDNamespace _ -> internal_error("Encountering namespace")
      }
    };
    result.toArray()
  }

  private fun getPath(
    context: mutable S.Context,
    fileName: FileName,
    path: String,
    typeOnly: Bool,
  ): readonly Vector<FileDef> {
    defs: readonly Vector<FileDef> = Vector[
      FDNamespace(false, this.getFileDefs(context, fileName)),
    ];
    pathElts = path.split(".");
    for (i => pathElt in pathElts) {
      dotTypeOnly = typeOnly && i >= pathElts.size() - 1;
      !defs = this.dot(context, defs, pathElt, dotTypeOnly)
    };
    defs
  }

  private fun dot(
    context: mutable S.Context,
    defs: readonly Vector<FileDef>,
    name: String,
    typeOnly: Bool,
  ): readonly Vector<FileDef> {
    result = mutable Vector[];
    for (d in defs) {
      d match {
      | FunDef _
      | TypeDef _
      | Class _
      | Enum _
      | FDVar _ ->
        internal_error("TODO: DefMap#dot")
      | FDNamespace(nsTypeOnly, nsDefs) ->
        getTypeOnly = typeOnly || nsTypeOnly;
        this.getInDefs(context, nsDefs, name, getTypeOnly, result)
      }
    };
    result
  }

  private fun getInDefs(
    context: mutable S.Context,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    if (name == "") {
      result.push(FDNamespace(typeOnly, fileDefs))
    } else {
      this.getFromModElts(
        context,
        fileDefs.inside.epsilon.map(wmr -> wmr.withName(name)),
        typeOnly,
        fileDefs,
        result,
      );
      fileDefs.inside.namedElts.maybeGet(name) match {
      | Some(elts) ->
        this.getFromModElts(context, elts, typeOnly, fileDefs, result)
      | None() -> void
      }
    }
  }

  private fun getExported(
    context: mutable S.Context,
    fileName: FileName,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    fileDefs = this.getFileDefs(context, fileName);
    this.getExportedInDefs(context, fileDefs, name, typeOnly, result)
  }

  private fun getExportedInDefs(
    context: mutable S.Context,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    if (name == "") {
      result.push(FDNamespace(typeOnly, fileDefs))
    } else {
      this.getFromModElts(
        context,
        fileDefs.outside.epsilon.map(wmr -> wmr.withName(name)),
        typeOnly,
        fileDefs,
        result,
      );
      fileDefs.outside.namedElts.maybeGet(name) match {
      | Some(exports) ->
        this.getFromModElts(context, exports, typeOnly, fileDefs, result)
      | None() -> void
      }
    }
  }

  private fun getFromModElts(
    context: mutable S.Context,
    modElts: Vector<ModElt>,
    typeOnly: Bool,
    self: FileDefs,
    result: mutable Vector<FileDef>,
  ): void {
    for (modElt in modElts) {
      modElt match {
      | fd @ FileDef _ ->
        if (typeOnly && !(fd is TypeOnlyDef _)) continue;
        result.push(fd)
      | ModEltRef{typeOnly => refTypeOnly, origName, from, fromView} ->
        getTypeOnly = typeOnly || refTypeOnly;
        from match {
        | MRSelf() ->
          fromView match {
          | MVInside() ->
            this.getInDefs(context, self, origName, getTypeOnly, result)
          | MVOutside() ->
            this.getExportedInDefs(context, self, origName, getTypeOnly, result)
          }
        | NamedModule{name => moduleName, fileName} ->
          invariant(fromView == MVOutside());
          this.getExported(context, fileName, origName, getTypeOnly, result);
          self.modules.maybeGet(moduleName) match {
          | Some(augmentations) ->
            for (augmentation in augmentations) {
              this.getExportedInDefs(
                context,
                augmentation,
                origName,
                getTypeOnly,
                result,
              )
            }
          | None() -> void
          }
        }
      }
    }
  }

  private fun getFileDefs(context: mutable S.Context, fn: FileName): FileDefs {
    this.fileDefsDir.get(context, S.SID(fn.toString()))
  }
}

class FileDefs{
  inside: ModuleView,
  outside: ModuleView,
  modules: Map<String, Vector/* Array makes skc fail */ <FileDefs>>,
} extends S.File

mutable class ModuleView{
  namedElts: mutable Map<String, mutable Vector<ModElt>> = mutable Map[],
  epsilon: mutable Vector<EpsilonRef> = mutable Vector[],
} {
  readonly fun chill(): this {
    static{
      namedElts => this.namedElts.map((_, x) -> x.chill()),
      epsilon => this.epsilon.chill(),
    }
  }
}

base class ModElt

base class FileDef extends ModElt
base class FileDefElt extends FileDef
extension class FunDef extends FileDefElt
extension class TypeDef extends FileDefElt
extension class Class extends FileDefElt
extension class Enum extends FileDefElt
class FDVar(
  kind: VarDefKind,
  name: Name,
  type: ?Type,
  value: ?Expr,
) extends FileDefElt
class FDNamespace(typeOnly: Bool, defs: FileDefs) extends FileDef

base class TypeOnlyDef extends FileDefElt
extension class TypeDef extends TypeOnlyDef
extension class Class extends TypeOnlyDef
extension class Enum extends TypeOnlyDef

base class ModView uses Equality {
  children =
  | MVInside()
  | MVOutside()
}

base class ModRefBase{typeOnly: Bool, from: ModuleReference, fromView: ModView}

class EpsilonRef{} extends ModRefBase {
  fun withName(origName: String): ModEltRef {
    ModEltRef{
      typeOnly => this.typeOnly,
      from => this.from,
      fromView => this.fromView,
      origName,
    }
  }
}

class ModEltRef{
  origName: /* Empty string = whole module */ String,
} extends ModElt, ModRefBase

base class ModuleReference {
  children =
  | NamedModule{name: String, fileName: FileName}
  | MRSelf()
}

fun mapPush<K: Hashable & Equality, V>(
  m: mutable Map<K, mutable Vector<V>>,
  k: K,
  x: V,
): void {
  m.maybeGet(k) match {
  | None() -> m![k] = mutable Vector<V>[x]
  | Some(v) -> v.push(x)
  }
}

mutable class FileDefsState private {
  context: mutable S.Context,
  index: FileNameIndex,
  rootOpt: ?DirName,
  dirName: DirName,
  importStubs: Array<DirName>,
  inside: mutable ModuleView = mutable ModuleView{},
  outside: mutable ModuleView = mutable ModuleView{},
  modules: mutable Map<String, mutable Vector<FileDefs>> = mutable Map[],
} {
  static fun createFileDefs(
    context: mutable S.Context,
    index: FileNameIndex,
    rootOpt: ?DirName,
    dirName: DirName,
    includes: Array<FileName>,
    importStubs: Array<DirName>,
    parsedDefs: Array<Def>,
  ): FileDefs {
    state = mutable static{context, index, rootOpt, dirName, importStubs};
    state.inside.epsilon.extend(
      includes.map(fileName ->
        EpsilonRef{
          typeOnly => false,
          from => NamedModule{name => `!unnamed include ${fileName}`, fileName},
          fromView => MVInside(),
        }
      ),
    );
    state.processDefs(parsedDefs)
  }

  private mutable fun resolveName(mname: Name): NamedModule {
    name = mname.value;
    (if (name.startsWith("./") || name.startsWith("../")) {
      if (!name.endsWith(".js")) {
        typingError(
          Array[
            (mname.pos, "Invalid import: local imports must be from js files"),
          ],
        )
      };
      resolveName(this.context, this.index, this.rootOpt, this.dirName, name)
    } else {
      resolveStubs(this.importStubs, name)
    }) match {
    | Some(fileName) -> NamedModule{name, fileName}
    | None() ->
      typingError(Array[(mname.pos, `Could not find module '${mname}'`)])
    }
  }

  private mutable fun processDefs(parsedDefs: Array<Def>): FileDefs {
    for (def in parsedDefs) {
      def.value match {
      | Expr _ -> void

      /* module was the old syntax for namespaces */
      | Module(name, defsOpt) ->
        this.newDef(false, Namespace(name, defsOpt.default(Array[])))

      | d @ Declarable _
      | Declare(d) ->
        this.newDef(false, d)

      | Export(d)
      | ExportDeclare(d) ->
        this.newDef(true, d)

      | ExportNames(_, names) -> this.exportNames(names)
      | ExportNamesFrom(isType, names, mname) ->
        modName = this.resolveName(mname);
        static::addImportsFrom(
          this.outside.namedElts,
          isType.isSome(),
          Array[names],
          modName,
        )

      | ExportDefault(Expr(_, Var(n))) ->
        /* Treat
             export default x;
           as
             export { x as default };
         */
        this.exportNames(
          MCurly(Array[ModuleDefName(None(), n, Some(Name(n.pos, "default")))]),
        )

      | ExportDefault _
      | ExportEq _ ->
        internal_error("TODO: unsupported export")

      | Import(isType, names, importName) ->
        modName = this.resolveName(importName);
        static::addImportsFrom(
          this.inside.namedElts,
          isType.isSome(),
          names,
          modName,
        )

      | ImportExpr _ -> internal_error("TODO: import expr")
      | ExportAs _ -> internal_error("TODO export as")
      | ExportImport _ -> internal_error("TODO: exportImport")
      }
    };
    this.toFileDefs()
  }

  private readonly fun toFileDefs(): FileDefs {
    FileDefs{
      inside => this.inside.chill(),
      outside => this.outside.chill(),
      modules => this.modules.map((_, x) -> x.chill()),
    }
  }

  private mutable fun createSubFileDefs(defs: Array<Def>): FileDefs {
    state = mutable static{
      context => this.context,
      index => this.index,
      rootOpt => this.rootOpt,
      dirName => this.dirName,
      importStubs => this.importStubs,
    };
    state.processDefs(defs)
  }

  private mutable fun newDef(isExport: Bool, def: Declarable): void {
    def match {
    | d @ TypeDef{name} ->
      if (isExport) mapPush(this.outside.namedElts, name.value, d);
      mapPush(this.inside.namedElts, name.value, d)
    | d @ Class{name} ->
      if (isExport) mapPush(this.outside.namedElts, name.value, d);
      mapPush(this.inside.namedElts, name.value, d)
    | d @ Enum(_, name, _) ->
      if (isExport) mapPush(this.outside.namedElts, name.value, d);
      mapPush(this.inside.namedElts, name.value, d)
    | Namespace(name, defs) ->
      d = FDNamespace(false, this.createSubFileDefs(defs));
      if (isExport) mapPush(this.outside.namedElts, name.value, d);
      mapPush(this.inside.namedElts, name.value, d)
    | Module(name, Some(defs)) ->
      invariant(!isExport);
      mapPush(this.modules, name.value, this.createSubFileDefs(defs))
    | d @ FunDef{name, pos => funPos} ->
      fname = name.fromSome() match {
      | FNNormal(n) -> n.value
      | FNSymbol(n) ->
        typingError(
          Array[(funPos, `Invalid name for a toplevel function: symbol ${n}`)],
        )
      };
      if (isExport) mapPush(this.outside.namedElts, fname, d);
      mapPush(this.inside.namedElts, fname, d)

    | VarDefs(k, varDefs) ->
      for (varDef in varDefs) {
        exportName = varDefs[0].pat.value match {
        | PVar(x) -> x
        | _ -> internal_error("TODO: cannot have exports base on names")
        };
        d = FDVar(k, exportName, varDef.type, varDef.value);
        if (isExport) mapPush(this.outside.namedElts, exportName.value, d);
        mapPush(this.inside.namedElts, exportName.value, d)
      }
    | Global _ -> internal_error("TODO: global")
    | Module _ -> internal_error("TODO: module")
    }
  }

  private mutable fun exportNames(names: MCurly): void {
    from = MRSelf();
    fromView = MVInside();
    names match {
    | MCurly(moduleDefNames) ->
      for (moduleDefName in moduleDefNames) {
        origName = moduleDefName.asName match {
        | None() -> moduleDefName.name.value
        | Some(asName) -> asName.value
        };
        ref = ModEltRef{typeOnly => false, origName, from, fromView};
        mapPush(this.outside.namedElts, moduleDefName.name.value, ref)
      }
    }
  }

  private static fun addImportsFrom(
    imports: mutable Map<String, mutable Vector<ModElt>>,
    typeOnly: Bool,
    namesList: Array<ModuleNames>,
    from: ModuleReference,
  ): void {
    fromView = MVOutside();
    for (names in namesList) {
      names match {
      | MStar() ->
        mapPush(
          imports,
          "",
          ModEltRef{typeOnly, origName => "", from, fromView},
        )
      | MStarAs(asName) ->
        mapPush(
          imports,
          asName.value,
          ModEltRef{typeOnly, origName => "", from, fromView},
        )
      | MCurly(moduleDefNames) ->
        for (moduleDefName in moduleDefNames) {
          importName = moduleDefName.asName match {
          | None() -> moduleDefName.name.value
          | Some(asName) -> asName.value
          };
          eltTypeOnly = typeOnly || moduleDefName.isType.isSome();
          origName = moduleDefName.name.value;
          mapPush(
            imports,
            importName,
            ModEltRef{typeOnly => eltTypeOnly, origName, from, fromView},
          )
        }
      | MName(asName) ->
        mapPush(
          imports,
          asName.value,
          ModEltRef{typeOnly, origName => "default", from, fromView},
        )
      }
    }
  }
}

module end;
