/***************************************************************************/
// Logic that resolves exports/imports in a file.
//
// Note that a lot of that logic is poorly tested and probably
// wrong. We probably don't want to support most of the constructions
// in there anyway.
//
// The things that we should support properly:
// import { x, y, z } from ...;
// export { x, y, z } from ...
//
// The rest is too old. I am pushing the code as is, but this needs cleanup.
/***************************************************************************/

module alias S = SKStore;

module SKJS;

class FileDefsMap(fileDefsDir: S.LHandle<S.SID, FileDefs>) {
  static fun create(
    context: mutable S.Context,
    index: FileNameIndex,
    rootOpt: ?DirName,
    _builtinsFileName: FileName,
    importStubs: Array<DirName>,
    parsedFiles: S.EHandle<S.SID, ParsedResultFile>,
  ): this {
    static(
      S.LHandle::create(
        S.SID::keyType,
        FileDefs::type,
        context,
        S.DirName::create("/skjs/fileDefs/"),
        (context, _self, key) ~> {
          fileName = FileName::create(key.value);
          parsedFile = parsedFiles.get(context, key);
          parsedFile.value match {
          | PROk(defs) ->
            Array[
              FileDefsState::createFileDefs(
                context,
                index,
                rootOpt,
                fileName.dirName,
                importStubs,
                defs,
              ),
            ]
          | _ -> Array[]
          }
        },
      ),
    )
  }

  fun get(context: mutable S.Context, fileName: FileName): FileDefs {
    this.fileDefsDir.get(context, S.SID(fileName.toString()))
  }
}

class FileDefs{
  defs: Map<String, Array<FileDef>>,
  imports: Map<String, Array<Imported>>,
  exported: Map<String, Array<String>>,
  reexports: Map<String, Array<Imported>>,
  modules: Map<String, Vector/* Array makes skc fail */ <FileDefs>>,
  includes: Array<FileName>,
} extends S.File

base class FileDef
base class FileDefElt extends FileDef
extension class FunDef extends FileDefElt
extension class TypeDef extends FileDefElt
extension class Class extends FileDefElt
extension class Enum extends FileDefElt
class FDVar(
  kind: VarDefKind,
  name: Name,
  type: ?Type,
  value: ?Expr,
) extends FileDefElt
class FDNamespace(typeOnly: Bool, defs: FileDefs) extends FileDef

base class TypeOnlyDef extends FileDefElt
extension class TypeDef extends TypeOnlyDef
extension class Class extends TypeOnlyDef
extension class Enum extends TypeOnlyDef

value class Imported{
  typeOnly: Bool,
  origName: /* Empty string = whole module */ String,
  from: ModuleName,
}

value class ModuleName{name: String, fileName: FileName}

fun mapPush<K: Hashable & Equality, V>(
  m: mutable Map<K, mutable Vector<V>>,
  k: K,
  x: V,
): void {
  m.maybeGet(k) match {
  | None() -> m![k] = mutable Vector<V>[x]
  | Some(v) -> v.push(x)
  }
}

mutable class FileDefsState private {
  context: mutable S.Context,
  index: FileNameIndex,
  rootOpt: ?DirName,
  dirName: DirName,
  importStubs: Array<DirName>,
  defs: mutable Map<String, mutable Vector<FileDef>> = mutable Map[],
  imports: mutable Map<String, mutable Vector<Imported>> = mutable Map[],
  exported: mutable Map<
    /* Empty string = whole module re-export */ String,
    mutable Vector<String>,
  > = mutable Map[],
  reexports: mutable Map<String, mutable Vector<Imported>> = mutable Map[],
  modules: mutable Map<String, mutable Vector<FileDefs>> = mutable Map[],
  includes: mutable Vector<FileName> = mutable Vector[],
} {
  static fun createFileDefs(
    context: mutable S.Context,
    index: FileNameIndex,
    rootOpt: ?DirName,
    dirName: DirName,
    importStubs: Array<DirName>,
    parsedDefs: Array<Def>,
  ): FileDefs {
    state = mutable static{context, index, rootOpt, dirName, importStubs};
    state.processDefs(parsedDefs)
  }

  private mutable fun resolveName(mname: Name): ModuleName {
    name = mname.value;
    (if (name.startsWith("./") || name.startsWith("../")) {
      if (!name.endsWith(".js")) {
        typingError(
          Array[
            (mname.pos, "Invalid import: local imports must be from js files"),
          ],
        )
      };
      resolveName(this.context, this.index, this.rootOpt, this.dirName, name)
    } else {
      resolveStubs(this.importStubs, name)
    }) match {
    | Some(fileName) -> ModuleName{name, fileName}
    | None() ->
      typingError(Array[(mname.pos, `Could not find module '${mname}'`)])
    }
  }

  private mutable fun processDefs(parsedDefs: Array<Def>): FileDefs {
    for (def in parsedDefs) {
      def.value match {
      | Expr _ -> void

      /* module was the old syntax for namespaces */
      | Module(name, defsOpt) ->
        this.newDef(false, Namespace(name, defsOpt.default(Array[])))

      | d @ Declarable _
      | Declare(d) ->
        this.newDef(false, d)

      | Export(d)
      | ExportDeclare(d) ->
        this.newDef(true, d)

      | ExportNames(_, names) -> this.exportNames(names)
      | ExportNamesFrom(isType, names, mname) ->
        modName = this.resolveName(mname);
        static::addImportsFrom(
          this.reexports,
          isType.isSome(),
          Array[names],
          modName,
        )

      | ExportDefault(Expr(_, Var(n))) ->
        /* Treat
             export default x;
           as
             export { x as default };
         */
        this.exportNames(
          MCurly(Array[ModuleDefName(None(), n, Some(Name(n.pos, "default")))]),
        )

      | ExportDefault _
      | ExportEq _ ->
        internal_error("TODO: unsupported export")

      | Import(isType, names, importName) ->
        modName = this.resolveName(importName);
        static::addImportsFrom(this.imports, isType.isSome(), names, modName)

      | ImportExpr _ -> internal_error("TODO: import expr")
      | ExportAs _ -> internal_error("TODO export as")
      | ExportImport _ -> internal_error("TODO: exportImport")
      }
    };
    this.toFileDefs()
  }

  private readonly fun toFileDefs(): FileDefs {
    FileDefs{
      imports => this.imports.map((_, x) -> x.toArray()),
      exported => this.exported.map((_, x) -> x.toArray()),
      reexports => this.reexports.map((_, x) -> x.toArray()),
      modules => this.modules.map((_, x) -> x.chill()),
      defs => this.defs.map((_, x) -> x.toArray()),
      includes => this.includes.toArray(),
    }
  }

  private mutable fun createSubFileDefs(defs: Array<Def>): FileDefs {
    state = mutable static{
      context => this.context,
      index => this.index,
      rootOpt => this.rootOpt,
      dirName => this.dirName,
      importStubs => this.importStubs,
    };
    state.processDefs(defs)
  }

  private mutable fun newDef(isExport: Bool, def: Declarable): void {
    def match {
    | d @ TypeDef{name} ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, d)
    | d @ Class{name} ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, d)
    | d @ Enum(_, name, _) ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, d)
    | Namespace(name, defs) ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(
        this.defs,
        name.value,
        FDNamespace(false, this.createSubFileDefs(defs)),
      )
    | Module(name, Some(defs)) ->
      invariant(!isExport);
      mapPush(this.modules, name.value, this.createSubFileDefs(defs))
    | d @ FunDef{name, pos => funPos} ->
      fname = name.fromSome() match {
      | FNNormal(n) -> n.value
      | FNSymbol(n) ->
        typingError(
          Array[(funPos, `Invalid name for a toplevel function: symbol ${n}`)],
        )
      };
      if (isExport) mapPush(this.exported, fname, fname);
      mapPush(this.defs, fname, d)

    | VarDefs(k, varDefs) ->
      for (varDef in varDefs) {
        exportName = varDefs[0].pat.value match {
        | PVar(x) -> x
        | _ -> internal_error("TODO: cannot have exports base on names")
        };
        if (isExport) {
          mapPush(this.exported, exportName.value, exportName.value)
        };
        mapPush(
          this.defs,
          exportName.value,
          FDVar(k, exportName, varDef.type, varDef.value),
        )
      }
    | Global _ -> internal_error("TODO: global")
    | Module _ -> internal_error("TODO: module")
    }
  }

  private mutable fun exportNames(names: MCurly): void {
    names match {
    | MCurly(moduleDefNames) ->
      for (moduleDefName in moduleDefNames) {
        origName = moduleDefName.asName match {
        | None() -> moduleDefName.name.value
        | Some(asName) -> asName.value
        };
        mapPush(this.exported, moduleDefName.name.value, origName)
      }
    }
  }

  private static fun addImportsFrom(
    imports: mutable Map<String, mutable Vector<Imported>>,
    typeOnly: Bool,
    namesList: Array<ModuleNames>,
    from: ModuleName,
  ): void {
    for (names in namesList) {
      names match {
      | MStar() ->
        mapPush(imports, "", Imported{typeOnly, origName => "", from})
      | MStarAs(asName) ->
        mapPush(imports, asName.value, Imported{typeOnly, origName => "", from})
      | MCurly(moduleDefNames) ->
        for (moduleDefName in moduleDefNames) {
          importName = moduleDefName.asName match {
          | None() -> moduleDefName.name.value
          | Some(asName) -> asName.value
          };
          eltTypeOnly = typeOnly || moduleDefName.isType.isSome();
          origName = moduleDefName.name.value;
          mapPush(
            imports,
            importName,
            Imported{typeOnly => eltTypeOnly, origName, from},
          )
        }
      | MName(asName) ->
        mapPush(
          imports,
          asName.value,
          Imported{typeOnly, origName => "default", from},
        )
      }
    }
  }
}

base class IDefMap {
  fun getType(mutable S.Context, Name): TypeOnlyDef;
  fun getAll(
    mutable S.Context,
    Name,
    typeOnly: Bool = false,
  ): Array<FileDefElt>;
}

class DefMap{
  fileDefsMap: FileDefsMap,
  builtinsFileName: FileName,
} extends IDefMap {
  fun getType(context: mutable S.Context, name: Name): TypeOnlyDef {
    for (def in this.getAll(context, name, true)) {
      def match {
      | d @ TypeOnlyDef _ -> return d
      | _ ->
        invariant_violation("Passing typeOnly should return only TypeOnlyDef")
      }
    };
    typingError(Array[(name.pos, `Type ${name} not found`)])
  }

  fun getAll(
    context: mutable S.Context,
    name: Name,
    typeOnly: Bool = false,
  ): Array<FileDefElt> {
    fileName = FileName::create(name.pos.fileName);
    tmp = this.getPath(context, fileName, name.value, typeOnly);
    result = mutable Vector[];
    for (elt in tmp) {
      elt match {
      | e @ FileDefElt _ -> result.push(e)
      | FDNamespace _ -> internal_error("Encountering namespace")
      }
    };
    result.toArray()
  }

  private fun getPath(
    context: mutable S.Context,
    fileName: FileName,
    path: String,
    typeOnly: Bool,
  ): readonly Vector<FileDef> {
    root = mutable Vector[];
    if (fileName != this.builtinsFileName) {
      root.push(
        FDNamespace(
          false,
          this.fileDefsMap.get(context, this.builtinsFileName),
        ),
      )
    };
    root.push(FDNamespace(false, this.fileDefsMap.get(context, fileName)));
    defs: readonly Vector<FileDef> = root;
    pathElts = path.split(".");
    for (i => pathElt in pathElts) {
      dotTypeOnly = typeOnly && i >= pathElts.size() - 1;
      !defs = this.dot(context, defs, pathElt, dotTypeOnly)
    };
    defs
  }

  private fun dot(
    context: mutable S.Context,
    defs: readonly Vector<FileDef>,
    name: String,
    typeOnly: Bool,
  ): readonly Vector<FileDef> {
    result = mutable Vector[];
    for (d in defs) {
      d match {
      | FunDef _
      | TypeDef _
      | Class _
      | Enum _
      | FDVar _ ->
        internal_error("TODO: DefMap#dot")
      | FDNamespace(nsTypeOnly, nsDefs) ->
        getTypeOnly = typeOnly || nsTypeOnly;
        this.getInDefs(context, nsDefs, name, getTypeOnly, result)
      }
    };
    result
  }

  private fun getInDefs(
    context: mutable S.Context,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    invariant(name != "");
    for (fileName in fileDefs.includes) {
      this.getInDefs(
        context,
        this.fileDefsMap.get(context, fileName),
        name,
        typeOnly,
        result,
      )
    };
    fileDefs.imports.maybeGet(name) match {
    | Some(imports) ->
      this.getFromImports(
        context,
        imports,
        "",
        typeOnly,
        fileDefs.modules,
        result,
      )
    | None() -> void
    };
    fileDefs.defs.maybeGet(name) match {
    | Some(defs) ->
      if (typeOnly) {
        for (d in defs) {
          d match {
          | tod @ TypeOnlyDef _ -> result.push(tod)
          | _ -> void
          }
        }
      } else {
        result.extend(defs)
      }
    | None() -> void
    };
  }

  private fun getExported(
    context: mutable S.Context,
    fileName: FileName,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    fileDefs = this.fileDefsMap.get(context, fileName);
    if (name == "") {
      result.push(FDNamespace(typeOnly, fileDefs))
    } else {
      this.getExportedInDefs(context, fileDefs, name, typeOnly, result)
    }
  }

  private fun getExportedInDefs(
    context: mutable S.Context,
    fileDefs: FileDefs,
    name: String,
    typeOnly: Bool,
    result: mutable Vector<FileDef>,
  ): void {
    invariant(name != "");
    fileDefs.reexports.maybeGet("") match {
    | Some(wholeModuleReexports) ->
      this.getFromImports(
        context,
        wholeModuleReexports,
        name,
        typeOnly,
        fileDefs.modules,
        result,
      )
    | None() -> void
    };
    fileDefs.exported.maybeGet(name) match {
    | Some(origNames) ->
      // TODO: search in builtins as well
      for (origName in origNames) {
        this.getInDefs(context, fileDefs, origName, typeOnly, result)
      }
    | None() -> void
    };
    fileDefs.reexports.maybeGet(name) match {
    | Some(reexports) ->
      this.getFromImports(
        context,
        reexports,
        "",
        typeOnly,
        fileDefs.modules,
        result,
      )
    | None() -> void
    }
  }

  private fun getFromImports(
    context: mutable S.Context,
    imports: Array<Imported>,
    suffix: String,
    typeOnly: Bool,
    modules: Map<String, Vector<FileDefs>>,
    result: mutable Vector<FileDef>,
  ): void {
    for (import in imports) {
      name = import.origName + suffix;
      getTypeOnly = typeOnly || import.typeOnly;
      this.getExported(
        context,
        import.from.fileName,
        name,
        getTypeOnly,
        result,
      );
      modules.maybeGet(import.from.name) match {
      | Some(augmentations) ->
        for (augmentation in augmentations) {
          this.getExportedInDefs(
            context,
            augmentation,
            name,
            getTypeOnly,
            result,
          )
        }
      | None() -> void
      }
    }
  }
}

module end;
