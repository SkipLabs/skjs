/***************************************************************************/
// Logic that resolves exports/imports in a file.
//
// Note that a lot of that logic is poorly tested and probably
// wrong. We probably don't want to support most of the constructions
// in there anyway.
//
// The things that we should support properly:
// import { x, y, z } from ...;
// export { x, y, z } from ...
//
// The rest is too old. I am pushing the code as is, but this needs cleanup.
/***************************************************************************/

module alias S = SKStore;

module SKJS;

class FileDefsMap(fileDefsDir: S.LHandle<S.SID, FileDefs>) {
  static fun create(
    context: mutable S.Context,
    index: FileNameIndex,
    rootOpt: ?DirName,
    importStubs: Array<DirName>,
    parsedFiles: S.EHandle<S.SID, ParsedResultFile>,
  ): this {
    static(
      S.LHandle::create(
        S.SID::keyType,
        FileDefs::type,
        context,
        S.DirName::create("/skjs/fileDefs/"),
        (context, _self, key) ~> {
          fileName = FileName::create(key.value);
          parsedFile = parsedFiles.get(context, key);
          parsedFile.value match {
          | PROk(defs) ->
            Array[
              FileDefs::create(
                context,
                index,
                rootOpt,
                fileName.dirName,
                importStubs,
                defs,
              ),
            ]
          | _ -> Array[]
          }
        },
      ),
    )
  }

  fun get(context: mutable S.Context, fileName: FileName): FileDefs {
    this.fileDefsDir.get(context, S.SID(fileName.toString()))
  }
}

class FileDefs{
  importedFrom: Map<String, (String, FileName)>,
  importedModulesFrom: Map<String, FileName>,
  exported: Map<String, Array<String>>,
  exportedStar: Set<String>,
  exportedFrom: Map<String, (String, FileName)>,
  exportedModulesFrom: Map<String, FileName>,
  default: ?String,
  modules: Map<String, Vector/* Array makes skc fail */ <FileDefs>>,
  defs: Map<String, Array<FileDef>>,
} extends S.File {
  static fun create(
    context: mutable S.Context,
    index: FileNameIndex,
    rootOpt: ?DirName,
    dirName: DirName,
    importStubs: Array<DirName>,
    parsedDefs: Array<Def>,
  ): FileDefs {
    state = mutable FileDefsState{
      context,
      index,
      rootOpt,
      dirName,
      importStubs,
    };
    state.processDefs(parsedDefs)
  }
}

base class FileDef
extension class FunDef extends FileDef
extension class TypeDef extends FileDef
extension class Class extends FileDef
extension class Enum extends FileDef
class FDVar(
  kind: VarDefKind,
  name: Name,
  type: ?Type,
  value: ?Expr,
) extends FileDef
class FDNamespace(FileDefs) extends FileDef

base class TypeOnlyDef extends FileDef
extension class TypeDef extends TypeOnlyDef
extension class Class extends TypeOnlyDef

fun mapPush<K: Hashable & Equality, V>(
  m: mutable Map<K, mutable Vector<V>>,
  k: K,
  x: V,
): void {
  m.maybeGet(k) match {
  | None() -> m![k] = mutable Vector<V>[x]
  | Some(v) -> v.push(x)
  }
}

mutable class FileDefsState{
  context: mutable S.Context,
  index: FileNameIndex,
  rootOpt: ?DirName,
  dirName: DirName,
  importStubs: Array<DirName>,
  importedFrom: mutable Map<String, (String, FileName)> = mutable Map[],
  importedModulesFrom: mutable Map<String, FileName> = mutable Map[],
  exported: mutable Map<String, mutable Vector<String>> = mutable Map[],
  exportedStar: mutable Set<String> = mutable Set[],
  exportedFrom: mutable Map<String, (String, FileName)> = mutable Map[],
  exportedModulesFrom: mutable Map<String, FileName> = mutable Map[],
  mutable default: ?String = None(),
  modules: mutable Map<String, mutable Vector<FileDefs>> = mutable Map[],
  defs: mutable Map<String, mutable Vector<FileDef>> = mutable Map[],
} {
  mutable fun resolveName(mname: Name): FileName {
    (if (mname.value.startsWith("./") || mname.value.startsWith("../")) {
      if (!mname.value.endsWith(".js")) {
        typingError(
          Array[
            (mname.pos, "Invalid import: local imports must be from js files"),
          ],
        )
      };
      resolveName(
        this.context,
        this.index,
        this.rootOpt,
        this.dirName,
        mname.value,
      )
    } else {
      resolveStubs(this.importStubs, mname.value)
    }) match {
    | Some(x) -> x
    | None() ->
      typingError(Array[(mname.pos, `Could not find module '${mname}'`)])
    }
  }

  mutable fun processDefs(parsedDefs: Array<Def>): FileDefs {
    for (def in parsedDefs) {
      def.value match {
      | Expr _ -> void

      /* module was the old syntax for namespaces */
      | Module(name, defsOpt) ->
        this.newDef(false, Namespace(name, defsOpt.default(Array[])))

      | d @ Declarable _
      | Declare(d) ->
        this.newDef(false, d)

      | Export(d)
      | ExportDeclare(d) ->
        this.newDef(true, d)

      | ExportNames(_, names) -> this.exportNames(names)
      | ExportNamesFrom(_, names, mname) ->
        fn = this.resolveName(mname);
        this.exportNamesFrom(names, fn)

      | ExportDefault(Expr(_, Var(n)))
      | ExportEq(Expr(_, Var(n))) ->
        this.!default = Some(n.value)
      | ExportDefault _
      | ExportEq _ ->
        internal_error("TODO: unsupported export")

      | Import(isType, names, importName) ->
        fn = this.resolveName(importName);
        this.importNamesFrom(isType.isSome(), names, fn)

      | ImportExpr _ -> internal_error("TODO: import expr")
      | ExportAs _ -> internal_error("TODO export as")
      | ExportImport _ -> internal_error("TODO: exportImport")
      }
    };
    this.toFileDefs()
  }

  private readonly fun toFileDefs(): FileDefs {
    FileDefs{
      importedFrom => this.importedFrom.chill(),
      importedModulesFrom => this.importedModulesFrom.chill(),
      exported => this.exported.map((_, x) -> x.toArray()),
      exportedStar => this.exportedStar.chill(),
      exportedFrom => this.exportedFrom.chill(),
      exportedModulesFrom => this.exportedModulesFrom.chill(),
      default => this.default,
      modules => this.modules.map((_, x) -> x.chill()),
      defs => this.defs.map((_, x) -> x.toArray()),
    }
  }

  private mutable fun createFileDefs(defs: Array<Def>): FileDefs {
    state = mutable static{
      context => this.context,
      index => this.index,
      rootOpt => this.rootOpt,
      dirName => this.dirName,
      importStubs => this.importStubs,
    };
    state.processDefs(defs)
  }

  mutable fun newDef(isExport: Bool, def: Declarable): void {
    def match {
    | d @ TypeDef{name} ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, d)
    | d @ Class{name} ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, d)
    | d @ Enum(_, name, _) ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, d)
    | Namespace(name, defs) ->
      if (isExport) mapPush(this.exported, name.value, name.value);
      mapPush(this.defs, name.value, FDNamespace(this.createFileDefs(defs)))
    | Module(name, Some(defs)) ->
      invariant(!isExport);
      mapPush(this.modules, name.value, this.createFileDefs(defs))
    | d @ FunDef{name, pos => funPos} ->
      fname = name.fromSome() match {
      | FNNormal(n) -> n.value
      | FNSymbol(n) ->
        typingError(
          Array[(funPos, `Invalid name for a toplevel function: symbol ${n}`)],
        )
      };
      if (isExport) mapPush(this.exported, fname, fname);
      mapPush(this.defs, fname, d)

    | VarDefs(k, varDefs) ->
      for (varDef in varDefs) {
        exportName = varDefs[0].pat.value match {
        | PVar(x) -> x
        | _ -> internal_error("TODO: cannot have exports base on names")
        };
        if (isExport) {
          mapPush(this.exported, exportName.value, exportName.value)
        };
        mapPush(
          this.defs,
          exportName.value,
          FDVar(k, exportName, varDef.type, varDef.value),
        )
      }
    | Global _ -> internal_error("TODO: global")
    | Module _ -> internal_error("TODO: module")
    }
  }

  private mutable fun exportNames(names: MCurly): void {
    names match {
    | MCurly(moduleDefNames) ->
      for (moduleDefName in moduleDefNames) {
        origName = moduleDefName.asName match {
        | None() -> moduleDefName.name.value
        | Some(asName) -> asName.value
        };
        mapPush(this.exported, moduleDefName.name.value, origName)
      }
    }
  }

  private mutable fun exportNamesFrom(
    names: ExportFromModuleNames,
    fileName: FileName,
  ): void {
    names match {
    | MStarAs(moduleName) ->
      this.exportedModulesFrom![moduleName.value] = fileName
    | MStar() -> this.exportedStar.insert(fileName.toString())
    | MCurly(moduleDefNames) ->
      for (moduleDefName in moduleDefNames) {
        moduleDefName.asName match {
        | None() ->
          this.exportedFrom![moduleDefName.name.value] = (
            moduleDefName.name.value,
            fileName,
          )
        | Some(asName) ->
          this.exportedFrom![asName.value] = (
            moduleDefName.name.value,
            fileName,
          )
        }
      }
    }
  }

  private mutable fun importNamesFrom(
    _typeOnly: Bool,
    namesList: Array<ImportModuleNames>,
    fileName: FileName,
  ): void {
    for (names in namesList) {
      names match {
      | MStarAs(moduleName) ->
        this.importedModulesFrom![moduleName.value] = fileName
      | MCurly(moduleDefNames) ->
        for (moduleDefName in moduleDefNames) {
          importName = moduleDefName.asName match {
          | None() -> moduleDefName.name.value
          | Some(asName) -> asName.value
          };
          this.importedFrom![importName] = (moduleDefName.name.value, fileName)
        }
      | MName(moduleName) ->
        this.importedFrom!["default"] = (moduleName.value, fileName)
      }
    }
  }
}

base class IDefMap {
  fun getType(mutable S.Context, Name): TypeOnlyDef;
  fun getAll(mutable S.Context, Name): Array<FileDef>;
}

class DefMap{
  index: FileNameIndex,
  fileDefsMap: FileDefsMap,
  builtinsFileName: FileName,
} extends IDefMap {
  fun getType(context: mutable S.Context, name: Name): TypeOnlyDef {
    for (def in this.getAll(context, name)) {
      def match {
      | d @ TypeOnlyDef _ -> return d
      | _ -> void
      }
    };
    typingError(Array[(name.pos, `Type ${name} not found`)])
  }

  fun getAll(context: mutable S.Context, name: Name): Array<FileDef> {
    fileName = FileName::create(name.pos.fileName);
    result = mutable Vector[];
    this.get(context, fileName, name, result);
    result.toArray()
  }

  private fun get(
    context: mutable S.Context,
    fileName: FileName,
    defName: Name,
    result: mutable Vector<FileDef>,
  ): void {
    if (fileName != this.builtinsFileName) {
      biFileDefs = this.fileDefsMap.get(context, this.builtinsFileName);
      this.getInDefs(context, biFileDefs, defName, result)
    };
    fileDefs = this.fileDefsMap.get(context, fileName);
    this.getInDefs(context, fileDefs, defName, result)
  }

  private fun getInDefs(
    context: mutable S.Context,
    fileDefs: FileDefs,
    defName: Name,
    result: mutable Vector<FileDef>,
  ): void {
    if (defName.value.contains(".")) {
      arr = defName.value.split(".");
      moduleName = arr[0];
      newDefName = arr.slice(1, arr.size()).join(".");
      fileDefs.importedModulesFrom.maybeGet(moduleName) match {
      | Some(fileName) ->
        this.get(context, fileName, Name(defName.pos, newDefName), result)
      | None() -> void
      };
      fileDefs.exportedModulesFrom.maybeGet(moduleName) match {
      | Some(fileName) ->
        this.get(context, fileName, Name(defName.pos, newDefName), result)
      | None() -> void
      };
      fileDefs.importedFrom.maybeGet(moduleName) match {
      | Some((origName, newFileName)) ->
        this.get(
          context,
          newFileName,
          Name(defName.pos, origName + newDefName),
          result,
        )
      | None() -> void
      };
      fileDefs.exportedFrom.maybeGet(moduleName) match {
      | Some((origName, newFileName)) ->
        this.get(
          context,
          newFileName,
          Name(defName.pos, origName + newDefName),
          result,
        )
      | None() -> void
      };
      return void
    };
    fileDefs.importedFrom.maybeGet(defName.value) match {
    | Some((exportedDefName, importedFileName)) ->
      this.getExported(
        context,
        importedFileName,
        Name(defName.pos, exportedDefName),
        result,
      )
    | None() -> void
    };
    for (exportedFileName in fileDefs.exportedStar) {
      this.getExported(
        context,
        FileName::create(exportedFileName),
        defName,
        result,
      );
    };
    fileDefs.defs.maybeGet(defName.value) match {
    | Some(defs) -> result.extend(defs)
    | None() -> void
    };
  }

  private fun getExported(
    context: mutable S.Context,
    fileName: FileName,
    defName: Name,
    result: mutable Vector<FileDef>,
  ): void {
    fileDefs = this.fileDefsMap.get(context, fileName);
    this.getExportedInDefs(context, fileDefs, defName, result)
  }

  private fun getExportedInDefs(
    context: mutable S.Context,
    fileDefs: FileDefs,
    defName: Name,
    result: mutable Vector<FileDef>,
  ): void {
    if (defName.value.contains(".")) {
      arr = defName.value.split(".");
      moduleName = arr[0];
      newDefName = arr.slice(1, arr.size()).join(".");
      fileDefs.importedModulesFrom.maybeGet(moduleName) match {
      | Some(fileName) ->
        this.getExported(
          context,
          fileName,
          Name(defName.pos, newDefName),
          result,
        )
      | None() -> void
      };
      fileDefs.exportedModulesFrom.maybeGet(moduleName) match {
      | Some(fileName) ->
        this.getExported(
          context,
          fileName,
          Name(defName.pos, newDefName),
          result,
        )
      | None() -> void
      };
      return void
    };

    if (defName.value == "default" && fileDefs.default is Some _) {
      defaultName = fileDefs.default.fromSome();
      this.getInDefs(context, fileDefs, Name(defName.pos, defaultName), result)
    } else {
      fileDefs.exported.maybeGet(defName.value) match {
      | Some(asNames) ->
        for (asName in asNames) {
          this.getInDefs(context, fileDefs, Name(defName.pos, asName), result)
        }
      | None() -> void
      };
      fileDefs.exportedFrom.maybeGet(defName.value) match {
      | Some((newDefName, newFileName)) ->
        this.getExported(
          context,
          newFileName,
          Name(defName.pos, newDefName),
          result,
        )
      | None() -> void
      }
    };
    for (exportedFileName in fileDefs.exportedStar) {
      this.getExported(
        context,
        FileName::create(exportedFileName),
        defName,
        result,
      );
    };

    for (modulesDefs in fileDefs.modules) {
      for (moduleDefs in modulesDefs) {
        this.getInDefs(context, moduleDefs, defName, result)
      }
    }
  }
}

module end;
