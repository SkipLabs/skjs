module SKJS;

/***************************************************************************/
/* Statement termination classification */
/* A statement may terminate in 5 different ways: */
/* - it returns */
/* - it breaks */
/* - it throws */
/* - it loops forever */
/* - it goes through */
/***************************************************************************/

/*  A value of type StmtTermination must be interpreted as the union of the
    representation of each field.
    Field mayX means "the statement may X".
    If only one field is set, then the statement will always X.
    If no fields is set, then the statement is unreachable (should not happen).
*/
value class StmtTermination private {
  mayReturn: Bool = false,
  mayBreak: Bool = false,
  mayContinue: Bool = false,
  mayThrow: Bool = false,
  mayLoop: Bool = false,
  mayFallthrough: Bool = false,
} {
  const return_: this = StmtTermination{mayReturn => true};
  const break_: this = StmtTermination{mayBreak => true};
  const continue_: this = StmtTermination{mayContinue => true};
  const throw_: this = StmtTermination{mayThrow => true};
  const loop_: this = StmtTermination{mayLoop => true};
  const skip: this = StmtTermination{mayFallthrough => true};
  const throughOrThrow: this = StmtTermination{
    mayFallthrough => true,
    mayThrow => true,
  };
  const unknownCall: this = StmtTermination{
    mayThrow => true,
    mayLoop => true,
    mayFallthrough => true,
  };

  fun merge(that: this, mergeThrough: (Bool, Bool) ~> Bool): this {
    mayReturn = this.mayReturn || that.mayReturn;
    mayBreak = this.mayBreak || that.mayBreak;
    mayContinue = this.mayContinue || that.mayContinue;
    mayThrow = this.mayThrow || that.mayThrow;
    mayLoop = this.mayLoop || that.mayLoop;
    mayFallthrough = mergeThrough(this.mayFallthrough, that.mayFallthrough);
    static{mayReturn, mayBreak, mayContinue, mayThrow, mayLoop, mayFallthrough}
  }
  /* Or: taking either branch */
  fun /(that: this): this {
    this.merge(that, (t1, t2) ~> t1 || t2)
  }
  /* Maybe: taking either the branch or going through */
  fun maybe(): this {
    this / static::skip
  }
  /* Then: taking this followed by after */
  fun then(after: this): this {
    if (!this.mayFallthrough) this else this.merge(after, (_t1, t2) ~> t2)
  }
  /* Then: taking this followed by the continuation */
  fun thenk(kafter: () -> this): this {
    if (!this.mayFallthrough) this else this.merge(kafter(), (_t1, t2) ~> t2)
  }
  /* Finally: after supersedes any non-loop exit from this */
  fun finally(after: this): this {
    this.anyExitToFallthrough().thenk(() ~> after.then(this))
  }
  /* Converts breaks to fallThroughs. To be used on a block that may break */
  fun breakToFallthrough(): this {
    if (this.mayBreak) {
      this with {mayBreak => false, mayFallthrough => true}
    } else {
      this
    }
  }
  // The try side of a try/catch: whatever the try may throw is caught there,
  // so it stops counting as a way the whole construct throws.
  fun noThrow(): this {
    this with {mayThrow => false}
  }

  /* Converts continues to fallThroughs. To be used on a block that may continue */
  fun continueToFallthrough(): this {
    if (this.mayContinue) {
      this with {mayContinue => false, mayFallthrough => true}
    } else {
      this
    }
  }
  /* Converts any non-loop exit to fallthrough */
  fun anyExitToFallthrough(): this {
    mayFallthrough =
      this.mayReturn ||
      this.mayBreak ||
      this.mayContinue ||
      this.mayThrow ||
      this.mayFallthrough;
    static{mayLoop => this.mayLoop, mayFallthrough}
  }
  fun mayNonThrough(): ?String {
    if (this.mayReturn) return Some("return");
    if (this.mayBreak) return Some("break");
    if (this.mayContinue) return Some("continue");
    if (this.mayThrow) return Some("throw");
    if (this.mayLoop) return Some("loop forever");
    None()
  }
  fun isTerminal(): Bool {
    !this.mayFallthrough && (this.mayReturn || this.mayThrow)
  }

  static fun it<T>(it: mutable Iterator<T>, f: T -> this): this {
    it.next() match {
    | None() -> static::skip
    | Some(x) -> f(x).thenk(() -> static::it(it, f))
    }
  }
  static fun seq<T>(s: Sequence<T>, f: T -> this): this {
    static::it(s.iterator(), f)
  }
  static fun expr(expr: Expr): this {
    /* Operands, array literals, object literals are always evaluated from left to right.
       We assume that the existence of _name is checked in the typechecker.
       We assume operators do not call custom functions. */
    expr.value match {
    | Number(_)
    | BigInt(_)
    | Var(_name)
    | EString(_)
    | Closure(_tparams, _args, _retTy, _body)
    | Regexp(_) ->
      static::skip
    | TemplateLiteral(_parts, expressions) ->
      static::seq(expressions, static::expr)
    | TypeOf(e)
    | VoidOp(e)
    | Await(e)
    | As(e, _ty)
    | Satisfies(e, _ty)
    | AsConst(e) ->
      static::expr(e)
    | Spread(e) ->
      static::expr(e) /* We assume the typechecker checks it's an iterable */
    | New(e, _targs, args) ->
      static::expr(e).thenk(() ->
        static::seq(args, static::expr).then(static::unknownCall)
      )
    | Unop(_unop, e)
    | PostOp(_postop, e)
    | Dot(OptionalDot(), e, _fieldName) ->
      static::expr(e) /* do not throw */
    | Binop(LazyLogicalOperator(), e1, e2) ->
      static::expr(e1).thenk(() ~> static::expr(e2).maybe())
    | Get(e1, e2)
    | InstanceOf(e1, e2)
    | In(e1, e2) ->
      static::expr(e1).thenk(() ~>
        static::expr(e2).then(static::throughOrThrow)
      )
    | Dot(NormalDot(), e, _fieldName) ->
      static::expr(e).then(static::throughOrThrow)
    | Binop(_op, e1, e2) ->
      // We assume the typechecker checks we're not re-assigning a const
      static::expr(e1).thenk(() ~> static::expr(e2)) /* do not throw */
    | Call(e, _targs, args) ->
      // We assume the typechecker checks it's a function so calling does not throw
      static::expr(e).thenk(() ->
        static::seq(args, static::expr).then(static::unknownCall)
      )
    | Params(_) -> paramsError(expr.pos)
    | Object(fields) -> static::seq(fields, static::field)
    | EArray(exprs) -> static::seq(exprs, static::expr)
    | EIf(cond, e1, e2) ->
      static::cond(cond).if_(() ~> static::expr(e1), () ~> static::expr(e2))
    | Async(e) -> static::expr(e).maybe()
    }
  }

  static fun exprOpt(eo: ?Expr): this {
    eo.maybe(static::skip, static::expr)
  }

  static fun cond(cond: Expr): CondTermination {
    CondTermination::expr(cond)
  }

  static fun field(field: Field): this {
    field match {
    | FDNormal(_name, e)
    | FDSpread(e) ->
      static::expr(e)
    | FDComputed(keyExpr, valueExpr) ->
      static::expr(keyExpr).then(static::expr(valueExpr))
    | FDMethod _ -> static::skip
    }
  }

  static fun binding(binding: Binding): this {
    static::exprOpt(binding.value)
  }

  // The termination of a for-in/of loop's variable position: a fresh binding's
  // initializer expressions, or the target expression of an assignment form
  // (`for (o.a of arr)`). The statement walker used to answer this; the
  // checker owns statements now, and this position holds no statement beyond
  // these two shapes.
  static fun forInOfVar(stmt: Stmt): this {
    stmt.value match {
    | Bind(_kind, bindings) -> static::seq(bindings, static::binding)
    | StmtExpr(e) -> static::expr(e)
    | _ -> static::skip
    }
  }
}

value class CondTermination private (
  exprTermination: StmtTermination,
  tauto: TautologyCheck,
) {
  const any: CondTermination = CondTermination(StmtTermination::skip, TCTop());

  static fun expr(expr: Expr): this {
    static(StmtTermination::expr(expr), TautologyCheck::expr(expr))
  }

  fun if_(
    ktrue: () -> StmtTermination,
    kfalse: () -> StmtTermination,
  ): StmtTermination {
    this.exprTermination.thenk(() ->
      this.tauto match {
      | TCAlwaysTrue() -> ktrue()
      | TCAlwaysFalse() -> kfalse()
      | TCTop() -> ktrue() / kfalse()
      }
    )
  }

  fun loop_(kbody: () -> StmtTermination): StmtTermination {
    this.if_(
      () ->
        kbody()
          .continueToFallthrough()
          .then(StmtTermination::loop_)
          .breakToFallthrough(),
      () ~> StmtTermination::skip,
    )
  }
}

base class TautologyCheck private () {
  children =
  | TCAlwaysTrue()
  | TCAlwaysFalse()
  | TCTop()

  static fun expr(expr: Expr): TautologyCheck {
    expr.value match {
    | Var(Name(_pos, "true")) -> TCAlwaysTrue()
    | Var(Name(_pos, "false")) -> TCAlwaysFalse()
    | _ -> TCTop()
    }
  }
}

module end;
