module SKJS;

extension class TypeChecker {
  fun funDefSetup(
    subst: mutable Subst,
    thisTypeOpt: ?TType,
    fd: FunDef,
    callingContext: CGNode,
  ): (this, mutable TCEnv) {
    scope = Scope::mcreateToplevel(fd.pos.fileName) with {callingContext};
    env = mutable TCEnv(subst.context, subst, scope);
    thisTypeOpt match {
    | None() -> void
    | Some(thisType) ->
      !this.tenv.subst["this"] = (false, thisType);
      scope.bind(Name(fd.pos, "this"), thisType, true)
    };
    !this.tenv = this.tenv.addTParams(subst, fd.tparams);
    for (i => param in fd.params) {
      paramType = param.type match {
      | None() -> typingError(Array[(param.pos, "Missing type annotation")])
      | Some(ty) -> this.tenv.normalize(subst.context, ty)
      };
      param.optional match {
      | None() -> void
      | Some(optionalPos) ->
        !paramType = paramType.unionUndefined(subst, this.tenv, optionalPos)
      };
      param.default match {
      | None() -> void
      | Some(defaultExpr) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          typingError(
            Array[
              (
                optionalPos,
                "A parameter cannot both be optional and have a default value",
              ),
            ],
          )
        };
        paramScope = env.mcreateSubScope{isLoop => false};
        env.!scope = paramScope;
        this.checkSubType(
          env,
          defaultExpr.pos,
          "Default value doesn't have the expected type",
          this.expr(env, defaultExpr),
          paramType,
        );
        env.!scope = scope
      };
      paramName = param.name match {
      | PNName(n) -> n
      | PNDDD(name) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          typingError(Array[(optionalPos, "... cannot be optional")])
        };
        param.default match {
        | None() -> void
        | Some(defaultExpr) ->
          typingError(
            Array[(defaultExpr.pos, "... cannot have a default value")],
          )
        };
        if (i != fd.params.size() - 1) {
          typingError(Array[(name.pos, "... should be the last parameter")])
        };
        name
      | _ ->
        typingError(
          Array[
            (param.pos, "TODO: support for patterns in function parameters"),
          ],
        )
      };
      scope.bind(paramName, paramType, true)
    };
    !this.retType = fd.retType.i1.map(rty ->
      this.tenv.normalize(subst.context, rty)
    );
    (this, env)
  }

  fun funDef(
    subst: mutable Subst,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDef,
    cgNode: CGNode,
  ): void {
    for (modifier in fd.modifiers.modifiers) {
      modifier.value match {
      | "async" -> !fd.isAsync = Some(modifier.pos)
      | "static" -> !thisTypeOpt = None()
      | unsupported ->
        // TODO: protected, private, public, abstract, readonly
        typingError(
          Array[
            (
              modifier.pos,
              `TODO: support for method modifiers (encountered ${unsupported})`,
            ),
          ],
        )
      }
    };
    (!this, env) = this.funDefSetup(
      subst,
      thisTypeOpt.map(x -> x.i1),
      fd,
      cgNode,
    );
    if (this.retType is None()) {
      typingError(Array[(fd.retType.i0, "Missing return type")])
    };
    retType = this.retType.fromSome();
    fd.isAsync match {
    | None() -> !this.isAsync = false
    | Some(asyncPos) ->
      !this.isAsync = true;
      tvar = env.subst.gen(asyncPos);
      type = TType::var(tvar);
      this.checkSubType(
        env,
        asyncPos,
        "Async functions must return an object of type Promise<_>",
        retType,
        TType::single(TPromise(type, asyncPos)),
      )
    };
    fd.body match {
    | FDBNone(pos) ->
      if (thisTypeOpt is Some((CKClass(), _))) {
        typingError(Array[(pos, "Missing definition")])
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        typingError(Array[(fd.pos, "An interface cannot implement a method")])
      };
      _ = this.block(env, body);
      term = StmtTermination::block(body);
      if (term.mayFallthrough && !this.isVoid(env, this.isAsync, retType)) {
        typingError(
          Array[(fd.pos, "This function may not always return a value")],
        )
      }
    };
  }
}

module end;
