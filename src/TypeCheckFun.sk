module SKJS;

extension class TypeChecker {
  fun funDefSetup(
    subst: mutable Subst,
    thisTypeOpt: ?TType,
    fd: FunDef<SimpleFieldName>,
    callingContext: CGNode,
  ): (this, mutable TCEnv, Array<(Pattern, TType)>) {
    sig = this.getFunSig(subst.context, fd);
    static::checkTypeParams(subst, sig.tparams, OptionalTypeParamsForbidden());
    tcenv = TCEnv::mcreate(subst, callingContext);
    writes = mutable CaptureWrites{};
    writes.params(sig.params);
    this.getFunBody(subst.context, fd) match {
    | FDBSome(body) -> writes.stmts(body)
    | FDBNone() -> void
    };
    tcenv.scope.setCaptureWrites(writes.result(), writes.capturedNames());
    fdPos = fd.name.getPos();
    !this = this.addTParams(subst, sig.tparams);
    // An explicit `this: T` as the first parameter overrides the enclosing
    // class's implicit this type for the body.
    explicitThisOpt = if (
      sig.params.size() > 0 &&
      sig.params[0].isThisParam()
    ) {
      sig.params[0].type.map(ty -> this.normalize(tcenv.subst, ty))
    } else {
      None()
    };
    thisType = explicitThisOpt.default(
      thisTypeOpt.default(
        /* Disallow this in non-methods */ TType::single(
          TPrimUnit(TVoid(), fdPos),
        ),
      ),
    );
    // A function that explicitly declares `this: void` / `this: undefined` is
    // treated as receiver-less (a free function; see TEnv::isReceiverlessThis).
    // That is only sound if the body does not observe `this` — otherwise a
    // rebound receiver would contradict the declared type. Leave `this` unbound
    // so any use of it in the body is rejected.
    receiverlessThis = explicitThisOpt
      .map(t -> TEnv::isReceiverlessThis(subst, this, t))
      .default(false);
    if (!receiverlessThis) {
      !this.bindings["this"] = thisType;
      // `this` cannot be reassigned.
      tcenv.scope.bind(tcenv, Name(fdPos, "this"), thisType, true, true, false)
    };
    paramTypes = this.processParams(tcenv, sig.params, sig.tparams, true);
    typedParams = sig.params.mapWithIndex((i, param) ->
      (param.name, paramTypes[i])
    );
    !this.retType = sig.retType.i1.map(rty ->
      this.normalizeReturnType(subst, rty, sig.params)
    );
    (this, tcenv, typedParams)
  }

  // Reserve every binding without projecting types or evaluating pattern
  // defaults. Shared by parameters and local patterns. The placeholder type
  // is inaccessible while uninitialized;
  // bind installs the projected contract when each binding is initialized.
  fun reserveBindingNames(
    tcenv: mutable TCEnv,
    pattern: Pattern,
    placeholder: TType,
    isMutable: Bool = true,
  ): void {
    name = pattern.value match {
    | PVar(name) -> Some(name)
    | PArray(elements, rest) ->
      elements.each(element ->
        element.each(item ->
          this.reserveBindingNames(tcenv, item.i0, placeholder, isMutable)
        )
      );
      rest
    | PObject{fields, rest} ->
      fields.each(field ->
        this.reserveBindingNames(tcenv, field.i1, placeholder, isMutable)
      );
      rest
    };
    name.each(name -> {
      // A block prepass and the declaration itself reserve the same identity.
      if (!tcenv.pendingBindings.contains(name.pos)) {
        tcenv.scope.bind(
          tcenv,
          name,
          placeholder,
          true,
          false,
          isMutable,
          tcenv.pendingBindings,
        );
        tcenv.!pendingBindings = tcenv.pendingBindings.set(name.pos)
      }
    })
  }

  // Compute the effective types of a function parameters by applying the
  // isRest (arrayToReadonlyArray), optional (unionUndefined), and default
  // (checkSubType) modifiers in order. Reports an error if the parameter
  // is both optional and has a default.
  // expectedParamTypes supplies a contextual type per positional parameter
  // (from the expected function type at a call site — see call()). It is used
  // ONLY for a parameter that has no explicit annotation, in place of the
  // TS7006 "must have an explicit type annotation" error. An annotated
  // parameter always keeps its annotation. Positions with no contextual type
  // are represented by None (or a shorter/empty array).
  fun processParams(
    tcenv: mutable TCEnv,
    params: Array<Param>,
    tParams: Array<TypeParam>,
    allowThis: Bool,
    expectedParamTypes: Array<?TType> = Array[],
  ): Array<TType> {
    paramTypes = params.mapWithIndex((i, param) -> {
      param.name.value match {
      | PVar(n) if (allowThis && i == 0 && n.value == "this") ->
        param.isRest.each(restPos ->
          tcenv.error(
            Array[(restPos, "A 'this' parameter cannot be a rest parameter")],
            SKJSCode(2026),
          )
        );
        param.optional.each(optPos ->
          tcenv.error(
            Array[(optPos, "A 'this' parameter cannot be optional")],
            SKJSCode(2027),
          )
        );
        param.default.each(defaultExpr ->
          tcenv.error(
            Array[
              (
                defaultExpr.pos,
                "A 'this' parameter cannot have a default value",
              ),
            ],
            SKJSCode(2031),
          )
        )
      | _ -> checkPatternDoesNotContainThis(param.name)
      };
      param.isRest match {
      | Some(restPos) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          tcenv.error(
            Array[(optionalPos, "A rest parameter cannot be optional")],
            TSCode(1047),
          )
        };
        param.default match {
        | None() -> void
        | Some(defaultExpr) ->
          tcenv.error(
            Array[
              (defaultExpr.pos, "A rest parameter cannot have an initializer"),
            ],
            TSCode(1048),
          )
        };
        if (i != params.size() - 1) {
          tcenv.error(
            Array[
              (restPos, "A rest parameter must be last in a parameter list"),
            ],
            TSCode(1014),
          )
        };
        param.type.each(paramType ->
          VariadicTyping::checkRestParamReadonly(
            tcenv,
            this,
            restPos,
            paramType,
            tParams,
          )
        )
      | None() -> void
      };
      paramType = param.type match {
      | Some(ty) -> this.normalize(tcenv.subst, ty)
      | None() ->
        // No annotation: use the contextual type if the call site supplied
        // one for this position, otherwise raise TS7006 via requiredType().
        expectedParamTypes.maybeGet(i) match {
        | Some(Some(expectedTy)) -> expectedTy
        | _ -> this.normalize(tcenv.subst, param.requiredType())
        }
      };
      param.isRest.each(_ ->
        !paramType = TType::arrayToReadonlyArray(paramType)
      );
      if (i > 0 && !param.isOmittable() && params[i - 1].isOmittable()) {
        tcenv.error(
          Array[
            (
              param.pos,
              "A required parameter cannot follow an optional parameter",
            ),
            (
              params[i - 1].pos,
              "It appears after this parameter that is optional",
            ),
          ],
          TSCode(1016),
        )
      };
      param.optional match {
      | None() -> void
      | Some(optionalPos) ->
        !paramType = TType::unionUndefined(
          tcenv.subst,
          this,
          paramType,
          optionalPos,
        )
      };
      param.default match {
      | None() -> void
      | Some _ ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          tcenv.error(
            Array[
              (
                optionalPos,
                "A parameter cannot have both a question mark and an initializer",
              ),
            ],
            TSCode(1015),
          )
        }
      };
      for (modifier in param.modifiers.modifiers) {
        tcenv.error(
          Array[
            (
              modifier.pos,
              `Modifier '${modifier}' is not allowed on a function parameter`,
            ),
          ],
          SKJSCode(2067),
        )
      };

      paramType
    });
    savedPendingBindings = tcenv.pendingBindings;
    // Reserve the whole list, including names inside patterns, before any
    // initializer runs. Binding then proceeds in runtime initialization order.
    for (i => param in params) {
      if (!param.isThisParam()) {
        this.reserveBindingNames(tcenv, param.name, paramTypes[i])
      }
    };
    for (i => param in params) {
      initialType = param.default match {
      | None() -> paramTypes[i]
      | Some(defaultExpr) ->
        defaultType = this.bindingDefaultType(tcenv, defaultExpr, true, true);
        TType::isSub(tcenv.subst, this, defaultType, paramTypes[i]) match {
        | STOk() ->
          // A supplied non-undefined argument or the initializer's result.
          // The initializer may itself return undefined; retain that possibility.
          this.defaultedValueType(tcenv, paramTypes[i], defaultType)
        | err @ STErrorOnTType _ ->
          tcenv.subtypingError(
            tcenv.subst,
            this,
            Array[
              (
                defaultExpr.pos,
                "Type of default value is not assignable to the parameter's type",
              ),
            ],
            err,
            TSCode(2322),
          );
          // Recovery must not install a value that already failed the contract.
          paramTypes[i]
        }
      };
      if (!param.isThisParam()) {
        param.name.value match {
        | PVar(name) ->
          // The annotation remains the write/capture contract. Only this
          // invocation's initial flow type reflects the default's result.
          tcenv.scope.initializeReservedBinding(name, paramTypes[i]);
          tcenv.!pendingBindings = tcenv.pendingBindings.remove(name.pos);
          tcenv.scope.set(name, initialType, (_, _) -> void)
        | PArray _
        | PObject _ ->
          this.bind(
            tcenv,
            BKLet(),
            param.name,
            initialType,
            true,
            true,
            false,
            true,
          )
        }
      }
    };
    tcenv.!pendingBindings = savedPendingBindings;
    paramTypes
  }

  fun funDef(
    subst: mutable Subst,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDefWithModifiers<SimpleFieldName>,
    cgNode: CGNode,
  ): void {
    claimErrorsBefore = subst.results.errors.size();
    for (modifier in fd.modifiers.modifiers) {
      modifier match {
      | ModAsync(pos) -> !fd.isAsync = Some(pos)
      | ModStatic(_) -> !thisTypeOpt = None()
      | ModPublic _
      | ModPrivate _
      | ModProtected _ ->
        void /* private is recorded on the method's TField; protected is treated as public */
      | ModAbstract _
      | ModReadonly _ ->
        subst.error(
          Array[
            (
              modifier.pos,
              `Method modifier '${modifier}' is not yet supported by SKJS`,
            ),
          ],
          SKJSCode(9002),
        )
      }
    };
    (!this, tcenv, typedParams) = this.funDefSetup(
      subst,
      thisTypeOpt.map(x -> x.i1),
      fd,
      cgNode,
    );
    funSig = this.getFunSig(subst.context, fd);
    // Read the already-installed declaration bindings only when exporting.
    // Do not normalize again or consult a later inference state.
    claimRigidTypes = mutable Vector<(TParam, TType)>[];
    if (getConfig(tcenv.context).emitSkjsTypeClaims) {
      for (tp in funSig.tparams) {
        this.bindings.maybeGet(tp.name.value) match {
        | Some(ty) ->
          claimRigidTypes.push(
            (TParam(tp.name.value, tp.name.pos.fileName, tp.id), ty),
          )
        | None() -> void
        }
      }
    };
    if (this.retType is None()) {
      subst.error(
        Array[
          (
            funSig.retType.i0,
            `Function '${fd.name.getName()}' must have an explicit return type annotation`,
          ),
        ],
        TSCode(7010),
      )
    };
    fd.isAsync match {
    | None() -> !this.isAsync = false
    | Some(asyncPos) ->
      !this.isAsync = true;
      this.retType match {
      | None() -> void
      | Some(retType) ->
        // tsc's TS1064 requires the annotation to resolve to the global
        // Promise type itself; a merely well-shaped structural thenable is
        // rejected, so check the nominal identity before the subtype check.
        // FIXME: this is best-effort, not guaranteed: unexpandedType is a
        // printing hint that unions/intersections and some transformations
        // drop, and a user-defined type named "Promise" also satisfies it.
        isGlobalPromise = retType
          .getSTypes(tcenv.subst, this, Covariant())
          .flatMap(stypes ~> stypes.singleElt()) match {
        | Some(TObject(_, Some(TSInst(Name(_, "Promise"), _)), _)) -> true
        | _ -> false
        };
        if (!isGlobalPromise) {
          tcenv.error(
            Array[
              (
                asyncPos,
                "The return type of an async function must be the global Promise<T> type",
              ),
              (retType.pos, `This is ${this.ppType(tcenv, retType)}`),
            ],
            TSCode(1064),
          )
        } else {
          // tsc's TS1062: the declared payload must not reference itself
          // through its own then callback.
          retType.maybeAwaited(tcenv.subst, this, retType.pos) match {
          | Some _ -> void
          | None() -> this.errorSelfReferentialThenable(tcenv, retType.pos)
          };
          tvar = tcenv.subst.gen(asyncPos);
          tcenv.subst.setOrigin(tvar, FromAsyncReturn(asyncPos));
          type = TType::var(tvar);
          this.checkSubType(
            tcenv,
            asyncPos,
            "The return type of an async function must be the global Promise<T> type",
            retType,
            TType::promise(asyncPos, type),
            TSCode(1064),
          )
        }
      }
    };
    fdPos = fd.name.getPos();
    this.getFunBody(subst.context, fd) match {
    | FDBNone() ->
      if (thisTypeOpt is Some((CKClass(), _))) {
        subst.error(
          Array[(fdPos, "Method implementation is missing")],
          TSCode(2391),
        )
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        subst.error(
          Array[(fdPos, "An interface method cannot have an implementation")],
          TSCode(1183),
        )
      };
      this.rejectTypePredicateOnBodiedSignature(subst, funSig.retType.i1);
      this.retType match {
      | None() -> void
      | Some(retType) ->
        checkBody = () -> {
          (_, term) = this.block(tcenv, body);
          if (
            term.mayFallthrough &&
            !this.isVoid(tcenv, this.isAsync, retType)
          ) {
            subst.error(
              Array[
                (
                  fdPos,
                  "Not all code paths return a value, and the return type does not include 'undefined'",
                ),
              ],
              TSCode(2366),
            )
          };
          tcenv.validateHiddenEscapes();
          if (getConfig(tcenv.context).buildCfg) {
            cfg = CFGBuilder::build(
              cgNode.id.toString(),
              fdPos,
              typedParams,
              retType,
              body,
              tcenv.exprTypes,
              tcenv.stmtTerminations,
            );
            tcenv.results.!cfgs[cgNode] = cfg
          };
        };
        if (getConfig(tcenv.context).emitSkjsTypeClaims) {
          // Preserve the first-error snapshot, then rethrow: this is recording,
          // not recovery. Non-typing exceptions retain their ordinary behavior.
          // The operation frame is the body's closed judgments only; clones
          // of this substitution start empty and cannot write it.
          tcenv.subst.pushClaimedOpFrame();
          try {
            checkBody()
          } catch {
          | exn @ ErrorExn(_) ->
            tcenv.results.!typeClaims[cgNode] = buildFunTypeClaims(
              fd.name.getName(),
              fdPos,
              typedParams,
              retType,
              claimRigidTypes.toArray(),
              tcenv,
              true,
              claimErrorsBefore,
            );
            throw exn
          | exn -> throw exn
          }
        } else {
          checkBody()
        };
        if (getConfig(tcenv.context).emitSkjsTypeClaims) {
          tcenv.results.!typeClaims[cgNode] = buildFunTypeClaims(
            fd.name.getName(),
            fdPos,
            typedParams,
            retType,
            claimRigidTypes.toArray(),
            tcenv,
            false,
            claimErrorsBefore,
          )
        }
      }
    };
  }
}

module end;
