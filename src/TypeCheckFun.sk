module SKJS;

extension class TypeChecker {
  fun funDefSetup(
    subst: mutable Subst,
    thisTypeOpt: ?TType,
    fd: FunDef<SimpleFieldName>,
    callingContext: CGNode,
  ): (this, mutable TCEnv) {
    sig = this.getFunSig(subst.context, fd);
    static::checkTypeParams(subst, sig.tparams, OptionalTypeParamsForbidden());
    tcenv = TCEnv::mcreate(subst, callingContext);
    fdPos = fd.name.getPos();
    thisType = thisTypeOpt match {
    | None() ->
      /* Disallow this in non-methods */ TType::single(
        TPrimUnit(TVoid(), fdPos),
      )
    | Some(thisType) -> thisType
    };
    !this.bindings["this"] = thisType;
    tcenv.scope.bind(tcenv, Name(fdPos, "this"), thisType, true);
    !this = this.addTParams(subst, sig.tparams);
    paramTypes = this.processParams(tcenv, sig.params, sig.tparams, true);
    this.bindParams(tcenv, sig.params, paramTypes);
    !this.retType = sig.retType.i1.map(rty -> this.normalize(subst, rty));
    (this, tcenv)
  }

  fun bindParams(
    tcenv: mutable TCEnv,
    params: Array<Param>,
    paramTypes: Array<TType>,
  ): void {
    for (i => param in params) {
      this.bind(tcenv, BKLet(), param.name, paramTypes[i], true, false)
    }
  }

  // Compute the effective types of a function parameters by applying the
  // isRest (arrayToReadonlyArray), optional (unionUndefined), and default
  // (checkSubType) modifiers in order. Reports an error if the parameter
  // is both optional and has a default.
  fun processParams(
    tcenv: mutable TCEnv,
    params: Array<Param>,
    tParams: Array<TypeParam>,
    allowThis: Bool,
  ): Array<TType> {
    params.mapWithIndex((i, param) -> {
      param.name.value match {
      | PVar(n) if (allowThis && i == 0 && n.value == "this") ->
        fatalError(
          Array[(n.pos, "'this' parameters are not yet supported by SKJS")],
          SKJSCode(9001),
        )
      | _ -> checkPatternDoesNotContainThis(param.name)
      };
      param.isRest match {
      | Some(restPos) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          tcenv.error(
            Array[(optionalPos, "A rest parameter cannot be optional")],
            TSCode(1047),
          )
        };
        param.default match {
        | None() -> void
        | Some(defaultExpr) ->
          tcenv.error(
            Array[
              (defaultExpr.pos, "A rest parameter cannot have an initializer"),
            ],
            TSCode(1048),
          )
        };
        if (i != params.size() - 1) {
          tcenv.error(
            Array[
              (restPos, "A rest parameter must be last in a parameter list"),
            ],
            TSCode(1014),
          )
        };
        param.type.each(paramType ->
          VariadicTyping::checkRestParamReadonly(
            tcenv,
            this,
            restPos,
            paramType,
            tParams,
          )
        )
      | None() -> void
      };
      paramType = param.type match {
      | None() ->
        fatalError(
          Array[
            (param.pos, "A parameter must have an explicit type annotation"),
          ],
          TSCode(7006),
        )
      | Some(ty) -> this.normalize(tcenv.subst, ty)
      };
      param.isRest.each(_ ->
        !paramType = TType::arrayToReadonlyArray(paramType)
      );
      if (
        i > 0 &&
        !(param.optional.isSome() || param.default.isSome()) &&
        (params[i - 1].optional.isSome() || params[i - 1].default.isSome())
      ) {
        tcenv.error(
          Array[
            (
              param.pos,
              "A required parameter cannot follow an optional parameter",
            ),
            (
              params[i - 1].pos,
              "It appears after this parameter that is optional",
            ),
          ],
          TSCode(1016),
        )
      };
      param.optional match {
      | None() -> void
      | Some(optionalPos) ->
        !paramType = TType::unionUndefined(
          tcenv.subst,
          this,
          paramType,
          optionalPos,
        )
      };
      param.default match {
      | None() -> void
      | Some(defaultExpr) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          tcenv.error(
            Array[
              (
                optionalPos,
                "A parameter cannot have both a question mark and an initializer",
              ),
            ],
            TSCode(1015),
          )
        };
        savedScope = tcenv.scope;
        paramScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = paramScope;
        this.checkSubType(
          tcenv,
          defaultExpr.pos,
          "Type of default value is not assignable to the parameter's type",
          this.expr(tcenv, defaultExpr, true),
          paramType,
          TSCode(2322),
        );
        tcenv.!scope = savedScope
      };
      for (modifier in param.modifiers.modifiers) {
        tcenv.error(
          Array[
            (
              modifier.pos,
              `Modifier '${modifier}' is not allowed on a function parameter`,
            ),
          ],
          SKJSCode(2067),
        )
      };
      paramType
    })
  }

  fun funDef(
    subst: mutable Subst,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDefWithModifiers<SimpleFieldName>,
    cgNode: CGNode,
  ): void {
    for (modifier in fd.modifiers.modifiers) {
      modifier match {
      | ModAsync(pos) -> !fd.isAsync = Some(pos)
      | ModStatic(_) -> !thisTypeOpt = None()
      | ModPublic _
      | ModPrivate _
      | ModProtected _ ->
        void /* private is recorded on the method's TField; protected is treated as public */
      | ModAbstract _
      | ModReadonly _ ->
        subst.error(
          Array[
            (
              modifier.pos,
              `Method modifier '${modifier}' is not yet supported by SKJS`,
            ),
          ],
          SKJSCode(9002),
        )
      }
    };
    (!this, tcenv) = this.funDefSetup(
      subst,
      thisTypeOpt.map(x -> x.i1),
      fd,
      cgNode,
    );
    if (this.retType is None()) {
      funSig = this.getFunSig(subst.context, fd);
      subst.error(
        Array[
          (
            funSig.retType.i0,
            `Function '${fd.name.getName()}' must have an explicit return type annotation`,
          ),
        ],
        TSCode(7010),
      )
    };
    fd.isAsync match {
    | None() -> !this.isAsync = false
    | Some(asyncPos) ->
      !this.isAsync = true;
      this.retType match {
      | None() -> void
      | Some(retType) ->
        // tsc's TS1064 requires the annotation to resolve to the global
        // Promise type itself; a merely well-shaped structural thenable is
        // rejected, so check the nominal identity before the subtype check.
        // FIXME: this is best-effort, not guaranteed: unexpandedType is a
        // printing hint that unions/intersections and some transformations
        // drop, and a user-defined type named "Promise" also satisfies it.
        isGlobalPromise = retType
          .getSTypes(tcenv.subst, this, Covariant())
          .flatMap(stypes ~> stypes.singleElt()) match {
        | Some(TObject(_, Some(TSInst(Name(_, "Promise"), _)), _)) -> true
        | _ -> false
        };
        if (!isGlobalPromise) {
          tcenv.error(
            Array[
              (
                asyncPos,
                "The return type of an async function must be the global Promise<T> type",
              ),
              (retType.pos, `This is ${this.ppType(tcenv, retType)}`),
            ],
            TSCode(1064),
          )
        } else {
          // tsc's TS1062: the declared payload must not reference itself
          // through its own then callback.
          retType.maybeAwaited(tcenv.subst, this, retType.pos) match {
          | Some _ -> void
          | None() -> this.errorSelfReferentialThenable(tcenv, retType.pos)
          };
          tvar = tcenv.subst.gen(asyncPos);
          tcenv.subst.setOrigin(tvar, FromAsyncReturn(asyncPos));
          type = TType::var(tvar);
          this.checkSubType(
            tcenv,
            asyncPos,
            "The return type of an async function must be the global Promise<T> type",
            retType,
            TType::promise(asyncPos, type),
            TSCode(1064),
          )
        }
      }
    };
    fdPos = fd.name.getPos();
    this.getFunBody(subst.context, fd) match {
    | FDBNone() ->
      if (thisTypeOpt is Some((CKClass(), _))) {
        subst.error(
          Array[(fdPos, "Method implementation is missing")],
          TSCode(2391),
        )
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        subst.error(
          Array[(fdPos, "An interface method cannot have an implementation")],
          TSCode(1183),
        )
      };
      this.retType match {
      | None() -> void
      | Some(retType) ->
        _ = this.block(tcenv, body);
        term = StmtTermination::block(tcenv, body);
        if (term.mayFallthrough && !this.isVoid(tcenv, this.isAsync, retType)) {
          subst.error(
            Array[
              (
                fdPos,
                "Not all code paths return a value, and the return type does not include 'undefined'",
              ),
            ],
            TSCode(2366),
          )
        };
        cfg = CFGBuilder::build(
          cgNode.id.toString(),
          fdPos,
          Array[], // TODO: populate typed params
          retType,
          body,
          tcenv.exprTypes,
          tcenv.stmtTerminations,
        );
        tcenv.results.!cfgs[cgNode] = cfg
      }
    };
  }
}

module end;
