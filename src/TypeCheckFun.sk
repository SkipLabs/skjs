module SKJS;

extension class TypeChecker {
  fun funDefSetup(
    subst: mutable Subst,
    thisTypeOpt: ?TType,
    fd: FunDef<SimpleFieldName>,
    callingContext: CGNode,
  ): (this, mutable TCEnv, Array<(Pattern, TType)>) {
    sig = this.getFunSig(subst.context, fd);
    static::checkTypeParams(subst, sig.tparams, OptionalTypeParamsForbidden());
    // The fresh scope holds this function's parameters, so it is created as
    // a param scope: in JS the parameter list and the body's top-level block
    // share one lexical scope (SkipLabs/skjs#1090).
    tcenv = TCEnv::mcreate(subst, callingContext, true);
    writes = mutable CaptureWrites{};
    writes.params(sig.params);
    this.getFunBody(subst.context, fd) match {
    | FDBSome(body) -> writes.stmts(body)
    | FDBNone() -> void
    };
    tcenv.scope.setCaptureWrites(writes.result(), writes.capturedNames());
    fdPos = fd.name.getPos();
    !this = this.addTParams(subst, sig.tparams);
    // An explicit `this: T` as the first parameter overrides the enclosing
    // class's implicit this type for the body.
    explicitThisOpt = if (
      sig.params.size() > 0 &&
      sig.params[0].isThisParam()
    ) {
      sig.params[0].type.map(ty -> this.normalize(tcenv.subst, ty))
    } else {
      None()
    };
    thisType = explicitThisOpt.default(
      thisTypeOpt.default(
        /* Disallow this in non-methods */ TType::single(
          TPrimUnit(TVoid(), fdPos),
        ),
      ),
    );
    // A function that explicitly declares `this: void` / `this: undefined` is
    // treated as receiver-less (a free function; see TEnv::isReceiverlessThis).
    // That is only sound if the body does not observe `this` — otherwise a
    // rebound receiver would contradict the declared type. Leave `this` unbound
    // so any use of it in the body is rejected.
    receiverlessThis = explicitThisOpt
      .map(t -> TEnv::isReceiverlessThis(subst, this, t))
      .default(false);
    if (!receiverlessThis) {
      !this.bindings["this"] = thisType;
      // `this` cannot be reassigned.
      tcenv.scope.bind(tcenv, Name(fdPos, "this"), thisType, true, true, false)
    };
    paramTypes = this.processParams(tcenv, sig.params, sig.tparams, true);
    typedParams = sig.params.mapWithIndex((i, param) ->
      (param.name, paramTypes[i])
    );
    sig.retType.i1 match {
    | None() -> !this.retType = None()
    | Some(rty) ->
      (retType, _, typePredOpt) = this.normalizeReturnType(
        subst,
        rty,
        sig.params,
      );
      !this.retType = Some(retType);
      typePredOpt.each(pred -> {
        hasBody = this.getFunBody(subst.context, fd) is FDBSome _;
        if (hasBody) {
          pred.subject match {
          | TPSThis() ->
            // A receiverless `this: void` / `this: undefined` leaves `this`
            // unbound in scope; record `fdPos` as the binding pos so
            // `maybeGetRefForBinding("this", fdPos)` returns None and the
            // return-site check rejects it.
            !this.activeTypePred = Some(
              ActiveTypePred("this", fdPos, pred, rty.pos),
            )
          | TPSParam(paramIdx) ->
            // Map the non-`this` positional index back to the AST param.
            idx = 0;
            for (i => p in sig.params) {
              if (i == 0 && p.isThisParam()) {
                continue
              };
              if (idx == paramIdx) {
                // Default initializers substitute a local value when the
                // caller passes `undefined`, without changing the caller's
                // binding — unsound for a type predicate.
                p.default.each(defaultExpr ->
                  tcenv.error(
                    Array[
                      (
                        defaultExpr.pos,
                        "A type predicate parameter cannot have a default initializer",
                      ),
                    ],
                    SKJSCode(2086),
                  )
                );
                p.name.value match {
                | PVar(name) ->
                  // Reassigning the predicate parameter locally does not
                  // update the caller's variable; keep it immutable.
                  tcenv.scope.setImmutable(name);
                  !this.activeTypePred = Some(
                    ActiveTypePred(name.value, name.pos, pred, rty.pos),
                  )
                | _ -> void
                };
                break void
              };
              !idx = idx + 1
            }
          }
        }
      })
    };
    (this, tcenv, typedParams)
  }

  // Verify a `return expr;` statement inside a bodied type predicate function
  // or method (`x is T` / `this is T`). Because call sites narrow BOTH the
  // true branch (intersection with `target`) AND the false branch (subtracting
  // `target`), every reachable `return` must soundly establish BOTH directions:
  //
  // 1. True-branch soundness (unless `expr` is statically `false` or the true
  //    branch is unreachable): under `evalCond(expr, true)`, the subject's
  //    (stable) type must be a subtype of `target`.
  // 2. False-branch soundness (unless `expr` is statically `true` or the false
  //    branch is unreachable): assuming the subject inhabits `target` (i.e.
  //    intersected with `target`), evaluating `evalCond(expr, false)` and
  //    applying the subject's accumulated `excludedTypes` must reduce the
  //    subject to `never` — proving no value of `target` can produce `false`.
  fun checkActiveTypePred(
    tcenv: mutable TCEnv,
    eOpt: ?Expr,
    etype: TType,
    returnPos: PosRange,
  ): void {
    this.activeTypePred match {
    | None() -> void
    | Some(active) ->
      // Unreachable return (e.g. `return unreachableNever()`).
      expandedRet = etype.expand(tcenv.subst, this, Some(Covariant()));
      if (expandedRet.isBottom()) {
        return void
      };
      // Static boolean literal detection so `return true` skips the false
      // check and `return false` skips the true check.
      staticBool: ?Bool = expandedRet.getSingleConstant() match {
      | Some(TPrimValue(TBool(), Some(lits), _)) ->
        if (lits.contains("true")) Some(true) else Some(false)
      | _ -> None()
      };
      // Look up the exact original subject binding (shadow-safe).
      baseRefOpt = tcenv.scope.maybeGetRefForBinding(
        active.subjectName,
        active.subjectBindingPos,
      );
      baseRef = baseRefOpt match {
      | None() ->
        // E.g. receiverless `this: void` in a `this is T` function.
        tcenv.error(
          Array[
            (
              returnPos,
              `Cannot prove type predicate on '${
                active.subjectName
              }' for type ${this.ppType(tcenv, active.pred.target)} because '${
                active.subjectName
              }' is not in scope`,
            ),
            (active.retPos, "The type predicate is declared here"),
          ],
          SKJSCode(2085),
        );
        return void
      | Some(r) -> r
      };
      // If this return unwinds through an enclosing `finally` with calls or
      // field writes, transient mutable-field refinements on the subject do
      // not survive the `finally` block.
      hasPendingFinally = tcenv.pendingFinallyEffectDepth > 0;
      target = active.pred.target.expand(tcenv.subst, this, Some(Covariant()));
      // Helper: project a LocalRef's type to its stable contents if a pending
      // side-effecting `finally` will run before control returns to the caller.
      projectRefType = (ref: LocalRef) ->
        if (hasPendingFinally) {
          ref.stableContentsType(tcenv.subst, this, true)
        } else {
          ref.type
        };
      // --- 1. True-branch soundness ---
      if (staticBool != Some(false)) {
        savedScope = tcenv.scope;
        trueScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = trueScope;
        eOpt.each(e -> this.evalCond(tcenv, e, true));
        trueUnreachable = trueScope.hasBottomNarrowing(tcenv.subst, this);
        trueRef = trueScope
          .maybeGetRefForBinding(active.subjectName, active.subjectBindingPos)
          .default(baseRef);
        tcenv.!scope = savedScope;
        if (!trueUnreachable) {
          subjectTrueTy = projectRefType(trueRef);
          // Even if `evalCond` narrowed a mutable field inside `return expr`,
          // a pending side-effecting `finally` invalidates it; `evalCond` on
          // `this.value !== null` sets `hasFieldRefinement` on `trueRef`, so
          // `projectRefType(trueRef)` projects it back to the declared contract.
          if (
            !(TType::isSub(tcenv.subst, this, subjectTrueTy, target) is STOk())
          ) {
            tcenv.error(
              Array[
                (
                  returnPos,
                  `Cannot prove '${active.subjectName}' is ${this.ppType(
                    tcenv,
                    active.pred.target,
                  )} when returning 'true': '${
                    active.subjectName
                  }' has type ${this.ppType(tcenv, subjectTrueTy)}`,
                ),
                (active.retPos, "The type predicate is declared here"),
              ],
              SKJSCode(2085),
            );
            return void
          }
        }
      };
      // --- 2. False-branch soundness ---
      // Prove that no runtime value of `subject` inhabiting `target` can reach
      // this `return` and evaluate `expr` to `false`.
      // We test this by running `evalCond(expr, false)` in a fresh sub-scope,
      // intersecting the resulting subject type with `target` (dropping object
      // branches with disjoint required fields, such as `Square & Circle`),
      // subtracting accumulated `excludedTypes`, and finally re-running
      // `evalCond(expr, false)` under the assumption `subject: residual` when
      // `residual` is still non-bottom.
      if (staticBool != Some(true)) {
        savedScope = tcenv.scope;
        falseScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = falseScope;
        eOpt.each(e -> this.evalCond(tcenv, e, false));
        falseUnreachable = falseScope.hasBottomNarrowing(tcenv.subst, this);
        falseRef = falseScope
          .maybeGetRefForBinding(active.subjectName, active.subjectBindingPos)
          .default(baseRef);
        tcenv.!scope = savedScope;
        if (!falseUnreachable) {
          subjectFalseTy = projectRefType(falseRef).expand(
            tcenv.subst,
            this,
            Some(Covariant()),
          );
          // First compute the residual overlap between the false-branch
          // subject type and `target`, pruning object branches whose required
          // fields are statically disjoint (e.g. `Square & Circle` where
          // `kind: "square" & "circle"` is `never`).
          residual = this.intersectWithExpandedFields(
            tcenv,
            returnPos,
            subjectFalseTy,
            target,
          );
          // Second, subtract every negative fact proven on the subject along
          // this path (`excludedTypes`). If a pending side-effecting `finally`
          // runs, drop non-field-free exclusions since field writes can
          // invalidate them.
          effectiveExcluded = if (hasPendingFinally) {
            falseRef.excludedTypes.filter(t -> t.isFieldFree())
          } else {
            falseRef.excludedTypes
          };
          for (ex in effectiveExcluded) {
            if (!residual.isBottom()) {
              expandedEx = ex.expand(tcenv.subst, this, Some(Covariant()));
              !residual = this.materializeReadContext<TType>(
                tcenv,
                returnPos,
                context -> context.excludeType(residual, expandedEx),
                (scratch, readEnv) ->
                  TType::excludeTypeWith(
                    residual.pos,
                    residual.expand(scratch, readEnv, Some(Covariant())),
                    expandedEx.expand(scratch, readEnv, Some(Covariant())),
                    (left, right) ->
                      TType::isSub(scratch, readEnv, left, right) is STOk()
                    ,
                  )
                ,
              )
            }
          };
          // Third, if `residual` is still non-bottom AND `eOpt` is present,
          // re-evaluate `evalCond(e, false)` with the subject assumed to have
          // type `residual` (this handles expressions like `typeof x === "string"`
          // on `unknown` where intersecting with `target` first exposes
          // concrete branches for `evalCond`).
          if (!residual.isBottom()) {
            eOpt.each(e -> {
              savedScope2 = tcenv.scope;
              assumedScope = tcenv.mcreateSubScope{isLoop => false};
              tcenv.!scope = assumedScope;
              // Seed the subject binding directly (shadow-safe: only seed if
              // the name at the return site resolves to the subject binding).
              if (
                assumedScope.bindingPosOf(active.subjectName) ==
                Some(active.subjectBindingPos)
              ) {
                assumedScope.set(
                  Name(returnPos, active.subjectName),
                  residual,
                  (_, _) -> void,
                );
                this.evalCond(tcenv, e, false);
                if (assumedScope.hasBottomNarrowing(tcenv.subst, this)) {
                  !residual = TType::bottom(returnPos)
                } else {
                  assumedRef = assumedScope
                    .maybeGetRefForBinding(
                      active.subjectName,
                      active.subjectBindingPos,
                    )
                    .default(falseRef);
                  !residual = projectRefType(assumedRef).expand(
                    tcenv.subst,
                    this,
                    Some(Covariant()),
                  )
                }
              };
              tcenv.!scope = savedScope2
            })
          };
          if (!residual.isBottom()) {
            tcenv.error(
              Array[
                (
                  returnPos,
                  `Cannot prove '${active.subjectName}' is not ${this.ppType(
                    tcenv,
                    active.pred.target,
                  )} when returning 'false': a value of type ${this.ppType(
                    tcenv,
                    residual,
                  )} may still reach this return`,
                ),
                (active.retPos, "The type predicate is declared here"),
              ],
              SKJSCode(2085),
            )
          }
        }
      }
    }
  }

  // Intersect `left` and `right` (in narrowing mode) and prune any resulting
  // object branch that has a required field whose intersected read type is
  // `never` (e.g., `Square & Circle` where `kind: "square" & "circle"`).
  // `TFields::inter` intentionally keeps `TUnexpandedInter` on fields and
  // does not collapse branches whose required fields meet to `never`, so we
  // check each intersected object branch explicitly here.
  private fun intersectWithExpandedFields(
    tcenv: mutable TCEnv,
    pos: PosRange,
    left: TType,
    right: TType,
  ): TType {
    interTy = this.materializeReadContext<TType>(
      tcenv,
      pos,
      context -> context.intersection(left, right, true),
      (scratch, readEnv) -> TType::inter(scratch, readEnv, left, right),
    );
    expanded = interTy.expand(tcenv.subst, this, Some(Covariant()));
    expanded.mapSTypes(tcenv.subst, this, Some(Covariant()), stypesOpt ->
      stypesOpt.map(stypes ->
        stypes.filterMap(stype ->
          stype match {
          | obj @ TObject _ ->
            obj.mapOpt(fields -> {
              uninhabited = fields.fields.any(field ->
                !field.isOptional &&
                  field.get
                    .expand(tcenv.subst, this, Some(Covariant()))
                    .isBottom()
              );
              if (uninhabited) None() else Some(fields)
            })
          | other -> Some(other)
          }
        )
      )
    )
  }

  // Reserve every binding without projecting types or evaluating pattern
  // defaults. Shared by parameters and local patterns. The placeholder type
  // is inaccessible while uninitialized;
  // bind installs the projected contract when each binding is initialized.
  fun reserveBindingNames(
    tcenv: mutable TCEnv,
    pattern: Pattern,
    placeholder: TType,
    isMutable: Bool = true,
  ): void {
    name = pattern.value match {
    | PVar(name) -> Some(name)
    | PArray(elements, rest) ->
      elements.each(element ->
        element.each(item ->
          this.reserveBindingNames(tcenv, item.i0, placeholder, isMutable)
        )
      );
      rest
    | PObject{fields, rest} ->
      fields.each(field ->
        this.reserveBindingNames(tcenv, field.i1, placeholder, isMutable)
      );
      rest
    };
    name.each(name -> {
      // A block prepass and the declaration itself reserve the same identity.
      if (!tcenv.pendingBindings.contains(name.pos)) {
        tcenv.scope.bind(
          tcenv,
          name,
          placeholder,
          true,
          false,
          isMutable,
          tcenv.pendingBindings,
        );
        tcenv.!pendingBindings = tcenv.pendingBindings.set(name.pos)
      }
    })
  }

  // Compute the effective types of a function parameters by applying the
  // isRest (arrayToReadonlyArray), optional (unionUndefined), and default
  // (checkSubType) modifiers in order. Reports an error if the parameter
  // is both optional and has a default.
  // expectedParamTypes supplies a contextual type per positional parameter
  // (from the expected function type at a call site — see call()). It is used
  // ONLY for a parameter that has no explicit annotation, in place of the
  // TS7006 "must have an explicit type annotation" error. An annotated
  // parameter always keeps its annotation. Positions with no contextual type
  // are represented by None (or a shorter/empty array).
  fun processParams(
    tcenv: mutable TCEnv,
    params: Array<Param>,
    tParams: Array<TypeParam>,
    allowThis: Bool,
    expectedParamTypes: Array<?TType> = Array[],
  ): Array<TType> {
    // The parameters live in this scope, which the caller created as a param
    // scope (funDefSetup / the lambda path): in JS the function body's
    // top-level block shares that scope, so a body-level declaration reusing
    // a parameter name is a redeclaration (SkipLabs/skjs#1090), while a
    // declaration in a deeper block legally shadows it.
    paramTypes = params.mapWithIndex((i, param) -> {
      param.name.value match {
      | PVar(n) if (allowThis && i == 0 && n.value == "this") ->
        param.isRest.each(restPos ->
          tcenv.error(
            Array[(restPos, "A 'this' parameter cannot be a rest parameter")],
            SKJSCode(2026),
          )
        );
        param.optional.each(optPos ->
          tcenv.error(
            Array[(optPos, "A 'this' parameter cannot be optional")],
            SKJSCode(2027),
          )
        );
        param.default.each(defaultExpr ->
          tcenv.error(
            Array[
              (
                defaultExpr.pos,
                "A 'this' parameter cannot have a default value",
              ),
            ],
            SKJSCode(2031),
          )
        )
      | _ -> checkPatternDoesNotContainThis(param.name)
      };
      param.isRest match {
      | Some(restPos) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          tcenv.error(
            Array[(optionalPos, "A rest parameter cannot be optional")],
            TSCode(1047),
          )
        };
        param.default match {
        | None() -> void
        | Some(defaultExpr) ->
          tcenv.error(
            Array[
              (defaultExpr.pos, "A rest parameter cannot have an initializer"),
            ],
            TSCode(1048),
          )
        };
        if (i != params.size() - 1) {
          tcenv.error(
            Array[
              (restPos, "A rest parameter must be last in a parameter list"),
            ],
            TSCode(1014),
          )
        };
        param.type.each(paramType ->
          VariadicTyping::checkRestParamReadonly(
            tcenv,
            this,
            restPos,
            paramType,
            tParams,
          )
        )
      | None() -> void
      };
      paramType = param.type match {
      | Some(ty) -> this.normalize(tcenv.subst, ty)
      | None() ->
        // No annotation: use the contextual type if the call site supplied
        // one for this position, otherwise raise TS7006 via requiredType().
        expectedParamTypes.maybeGet(i) match {
        | Some(Some(expectedTy)) -> expectedTy
        | _ -> this.normalize(tcenv.subst, param.requiredType())
        }
      };
      param.isRest.each(_ ->
        !paramType = TType::arrayToReadonlyArray(paramType)
      );
      if (i > 0 && !param.isOmittable() && params[i - 1].isOmittable()) {
        tcenv.error(
          Array[
            (
              param.pos,
              "A required parameter cannot follow an optional parameter",
            ),
            (
              params[i - 1].pos,
              "It appears after this parameter that is optional",
            ),
          ],
          TSCode(1016),
        )
      };
      param.optional match {
      | None() -> void
      | Some(optionalPos) ->
        !paramType = TType::unionUndefined(
          tcenv.subst,
          this,
          paramType,
          optionalPos,
        )
      };
      param.default match {
      | None() -> void
      | Some _ ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          tcenv.error(
            Array[
              (
                optionalPos,
                "A parameter cannot have both a question mark and an initializer",
              ),
            ],
            TSCode(1015),
          )
        }
      };
      for (modifier in param.modifiers.modifiers) {
        tcenv.error(
          Array[
            (
              modifier.pos,
              `Modifier '${modifier}' is not allowed on a function parameter`,
            ),
          ],
          SKJSCode(2067),
        )
      };

      paramType
    });
    savedPendingBindings = tcenv.pendingBindings;
    // Reserve the whole list, including names inside patterns, before any
    // initializer runs. Binding then proceeds in runtime initialization order.
    for (i => param in params) {
      if (!param.isThisParam()) {
        this.reserveBindingNames(tcenv, param.name, paramTypes[i])
      }
    };
    for (i => param in params) {
      initialType = param.default match {
      | None() -> paramTypes[i]
      | Some(defaultExpr) ->
        defaultType = this.bindingDefaultType(tcenv, defaultExpr, true, true);
        TType::isSub(tcenv.subst, this, defaultType, paramTypes[i]) match {
        | STOk() ->
          // A supplied non-undefined argument or the initializer's result.
          // The initializer may itself return undefined; retain that possibility.
          this.defaultedValueType(tcenv, paramTypes[i], defaultType)
        | err @ STErrorOnTType _ ->
          tcenv.subtypingError(
            tcenv.subst,
            this,
            Array[
              (
                defaultExpr.pos,
                "Type of default value is not assignable to the parameter's type",
              ),
            ],
            err,
            TSCode(2322),
          );
          // Recovery must not install a value that already failed the contract.
          paramTypes[i]
        }
      };
      if (!param.isThisParam()) {
        param.name.value match {
        | PVar(name) ->
          // The annotation remains the write/capture contract. Only this
          // invocation's initial flow type reflects the default's result.
          tcenv.scope.initializeReservedBinding(name, paramTypes[i]);
          tcenv.!pendingBindings = tcenv.pendingBindings.remove(name.pos);
          tcenv.scope.set(name, initialType, (_, _) -> void)
        | PArray _
        | PObject _ ->
          this.bind(
            tcenv,
            BKLet(),
            param.name,
            initialType,
            true,
            true,
            false,
            true,
          )
        }
      }
    };
    tcenv.!pendingBindings = savedPendingBindings;
    paramTypes
  }

  fun funDef(
    subst: mutable Subst,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDefWithModifiers<SimpleFieldName>,
    cgNode: CGNode,
    inOverloadTrial: Bool = false,
  ): void {
    for (modifier in fd.modifiers.modifiers) {
      modifier match {
      | ModAsync(pos) -> !fd.isAsync = Some(pos)
      | ModStatic(_) -> !thisTypeOpt = None()
      | ModPublic _
      | ModPrivate _
      | ModProtected _ ->
        void /* private is recorded on the method's TField; protected is treated as public */
      | ModAbstract _
      | ModReadonly _ ->
        subst.error(
          Array[
            (
              modifier.pos,
              `Method modifier '${modifier}' is not yet supported by SKJS`,
            ),
          ],
          SKJSCode(9002),
        )
      }
    };
    (!this, tcenv, typedParams) = this.funDefSetup(
      subst,
      thisTypeOpt.map(x -> x.i1),
      fd,
      cgNode,
    );
    tcenv.!inOverloadTrial = inOverloadTrial;
    funSig = this.getFunSig(subst.context, fd);
    if (this.retType is None()) {
      subst.error(
        Array[
          (
            funSig.retType.i0,
            `Function '${fd.name.getName()}' must have an explicit return type annotation`,
          ),
        ],
        TSCode(7010),
      )
    };
    fd.isAsync match {
    | None() -> !this.isAsync = false
    | Some(asyncPos) ->
      !this.isAsync = true;
      this.retType match {
      | None() -> void
      | Some(retType) ->
        // tsc's TS1064 requires the annotation to resolve to the global
        // Promise type itself; a merely well-shaped structural thenable is
        // rejected, so check the nominal identity before the subtype check.
        // FIXME: this is best-effort, not guaranteed: unexpandedType is a
        // printing hint that unions/intersections and some transformations
        // drop, and a user-defined type named "Promise" also satisfies it.
        isGlobalPromise = retType
          .getSTypes(tcenv.subst, this, Covariant())
          .flatMap(stypes ~> stypes.singleElt()) match {
        | Some(TObject(_, Some(TSInst(Name(_, "Promise"), _)), _)) -> true
        | _ -> false
        };
        if (!isGlobalPromise) {
          tcenv.error(
            Array[
              (
                asyncPos,
                "The return type of an async function must be the global Promise<T> type",
              ),
              (retType.pos, `This is ${this.ppType(tcenv, retType)}`),
            ],
            TSCode(1064),
          )
        } else {
          // tsc's TS1062: the declared payload must not reference itself
          // through its own then callback.
          retType.maybeAwaited(tcenv.subst, this, retType.pos) match {
          | Some _ -> void
          | None() -> this.errorSelfReferentialThenable(tcenv, retType.pos)
          };
          tvar = tcenv.subst.gen(asyncPos);
          tcenv.subst.setOrigin(tvar, FromAsyncReturn(asyncPos));
          type = TType::var(tvar);
          this.checkSubType(
            tcenv,
            asyncPos,
            "The return type of an async function must be the global Promise<T> type",
            retType,
            TType::promise(asyncPos, type),
            TSCode(1064),
          )
        }
      }
    };
    fdPos = fd.name.getPos();
    this.getFunBody(subst.context, fd) match {
    | FDBNone() ->
      // tsc TS2371: a parameter initializer is only allowed in a function or
      // constructor implementation, never in a body-less (overload or
      // ambient) signature.
      for (param in funSig.params) {
        param.default.each(dflt ->
          subst.error(
            Array[
              (
                dflt.pos,
                "A parameter initializer is only allowed in a function or constructor implementation",
              ),
            ],
            TSCode(2371),
          )
        )
      };
      if (thisTypeOpt is Some((CKClass(), _))) {
        subst.error(
          Array[(fdPos, "Method implementation is missing")],
          TSCode(2391),
        )
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        subst.error(
          Array[(fdPos, "An interface method cannot have an implementation")],
          TSCode(1183),
        )
      };
      this.rejectTypePredicateOnBodiedSignature(subst, funSig.retType.i1);
      this.retType match {
      | None() -> void
      | Some(retType) ->
        checkBody = () -> {
          (_, term) = this.block(tcenv, body);
          if (term.mayFallthrough) {
            if (retType.expand(tcenv.subst, this, None()).isBottom()) {
              // tsc's TS2355: a `never`-annotated body that can complete
              // normally would return `undefined` at runtime while every use
              // of the call is typed `never` — unsound, so reject it.
              subst.error(
                Array[
                  (
                    fdPos,
                    "A function returning 'never' cannot have a reachable end point",
                  ),
                ],
                TSCode(2355),
              )
            } else if (!this.isVoid(tcenv, this.isAsync, retType)) {
              subst.error(
                Array[
                  (
                    fdPos,
                    "Not all code paths return a value, and the return type does not include 'undefined'",
                  ),
                ],
                TSCode(2366),
              )
            }
          };
          tcenv.validateHiddenEscapes();
          if (getConfig(tcenv.context).buildCfg) {
            cfg = CFGBuilder::build(
              cgNode.id.toString(),
              fdPos,
              typedParams,
              retType,
              body,
              tcenv.exprTypes,
              tcenv.stmtTerminations,
            );
            tcenv.results.!cfgs[cgNode] = cfg
          };
        };
        checkBody()
      }
    };
  }
}

module end;
