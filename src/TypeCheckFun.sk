module SKJS;

extension class TypeChecker {
  fun funDefSetup(
    subst: mutable Subst,
    thisTypeOpt: ?TType,
    fd: FunDef<SimpleFieldName>,
    callingContext: CGNode,
  ): (this, mutable TCEnv) {
    static::checkTypeParams(subst, fd.tparams, OptionalTypeParamsForbidden());
    tcenv = TCEnv::mcreate(subst, callingContext);
    thisType = thisTypeOpt match {
    | None() ->
      /* Disallow this in non-methods */ TType::single(
        TPrimUnit(TVoid(), fd.pos),
      )
    | Some(thisType) -> thisType
    };
    !this.tenv.subst["this"] = (false, thisType);
    tcenv.scope.bind(tcenv, Name(fd.pos, "this"), thisType, true);
    !this.tenv = this.tenv.addTParams(subst, fd.tparams);
    for (i => param in fd.params) {
      param.isRest match {
      | Some(restPos) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          subst.error(Array[(optionalPos, "... cannot be optional")])
        };
        param.default match {
        | None() -> void
        | Some(defaultExpr) ->
          subst.error(
            Array[(defaultExpr.pos, "... cannot have a default value")],
          )
        };
        if (i != fd.params.size() - 1) {
          subst.error(Array[(restPos, "... must be the last parameter")])
        }
      | None() -> void
      };
      for (modifier in param.modifiers.modifiers) {
        subst.error(
          Array[(modifier.pos, `Forbidden modifier for a function parameter`)],
        )
      };
      paramType = param.type match {
      | None() -> typingError(Array[(param.pos, "Missing type annotation")])
      | Some(ty) -> this.tenv.normalize(subst, ty)
      };
      param.optional match {
      | None() -> void
      | Some(optionalPos) ->
        !paramType = TType::unionUndefined(
          subst,
          this.tenv,
          paramType,
          optionalPos,
        )
      };
      param.default match {
      | None() -> void
      | Some(defaultExpr) ->
        param.optional match {
        | None() -> void
        | Some(optionalPos) ->
          subst.error(
            Array[
              (
                optionalPos,
                "A parameter cannot both be optional and have a default value",
              ),
            ],
          )
        };
        savedScope = tcenv.scope;
        paramScope = tcenv.mcreateSubScope{isLoop => false};
        tcenv.!scope = paramScope;
        this.checkSubType(
          tcenv,
          defaultExpr.pos,
          "Default value doesn't have the expected type",
          this.expr(tcenv, defaultExpr, true),
          paramType,
        );
        tcenv.!scope = savedScope
      };
      paramName = param.name.value match {
      | PVar(n) -> n
      | _ ->
        typingError(
          Array[
            (param.pos, "TODO: support for patterns in function parameters"),
          ],
        )
      };
      if (paramName.value == "this") {
        typingError(Array[(paramName.pos, "TODO: support this parameter")])
      };
      tcenv.scope.bind(tcenv, paramName, paramType, true)
    };
    !this.retType = fd.retType.i1.map(rty -> this.tenv.normalize(subst, rty));
    (this, tcenv)
  }

  fun funDef(
    subst: mutable Subst,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDefWithModifiers<SimpleFieldName>,
    cgNode: CGNode,
  ): void {
    for (modifier in fd.modifiers.modifiers) {
      modifier match {
      | ModAsync(pos) -> !fd.isAsync = Some(pos)
      | ModStatic(_) -> !thisTypeOpt = None()
      | unsupported ->
        // TODO: protected, private, public, abstract, readonly
        subst.error(
          Array[
            (
              modifier.pos,
              `TODO: support for method modifiers (encountered ${unsupported})`,
            ),
          ],
        )
      }
    };
    (!this, tcenv) = this.funDefSetup(
      subst,
      thisTypeOpt.map(x -> x.i1),
      fd,
      cgNode,
    );
    if (this.retType is None()) {
      subst.error(Array[(fd.retType.i0, "Missing return type")])
    };
    fd.isAsync match {
    | None() -> !this.isAsync = false
    | Some(asyncPos) ->
      !this.isAsync = true;
      this.retType match {
      | None() -> void
      | Some(retType) ->
        tvar = tcenv.subst.gen(asyncPos);
        type = TType::var(tvar);
        this.checkSubType(
          tcenv,
          asyncPos,
          "Async functions must return an object of type Promise<_>",
          retType,
          TType::single(TPromise(type, asyncPos)),
        )
      }
    };
    fd.body match {
    | FDBNone(pos) ->
      if (thisTypeOpt is Some((CKClass(), _))) {
        subst.error(Array[(pos, "Missing definition")])
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        subst.error(Array[(fd.pos, "An interface cannot implement a method")])
      };
      this.retType match {
      | None() -> void
      | Some(retType) ->
        _ = this.block(tcenv, body);
        term = StmtTermination::block(tcenv, body);
        if (term.mayFallthrough && !this.isVoid(tcenv, this.isAsync, retType)) {
          subst.error(
            Array[(fd.pos, "This function may not always return a value")],
          )
        }
      }
    };
  }
}

module end;
