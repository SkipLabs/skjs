/*****************************************************************************/
/* Reachability Analysis for SKJS */
/*****************************************************************************/

module SKJS;

base class CGNode_ uses XXHashable, Show {
  children =
  | TopLevelFunction(name: SimpleFieldName, fileName: FAbsolute)
  | Method(name: FunDefName, class_: Name, fileName: FAbsolute, static_: Bool)
  | Constructor(class_: Name, fileName: FAbsolute)
  | Toplevel(fileName: FAbsolute)
  | ArrowTypeAnnot(fileName: FAbsolute)

  fun getFileName(): FAbsolute {
    this match {
    | TopLevelFunction(_, fileName)
    | Method(_, _, fileName, _)
    | Constructor(_, fileName)
    | Toplevel(fileName)
    | ArrowTypeAnnot(fileName) ->
      fileName
    | AnonymousLambda(pos, _)
    | AnonymousFunDef(FunDef{pos}) ->
      pos.fileName
    }
  }

  fun toString(): String {
    this match {
    | TopLevelFunction(name, file) -> `toplevel: ${name.getName()} (${file})`
    | Method(name, class_, file, static_) ->
      strStatic = if (static_) "static " else "";
      `${strStatic}${class_}.${name.getName()} (${file})`
    | Constructor(class_, file) -> `${class_}.constructor (${file})`
    | Toplevel(file) -> `top-level expr (${file})`
    | ArrowTypeAnnot(file) -> `arrow-type annotation (${file})`
    | AnonymousLambda(pos, _closure) ->
      `lambda (${pos.fileName}:${pos.relStart.value})`
    | AnonymousFunDef(fd) ->
      `function ${fd.name.getName()} (${fd.pos.fileName}:${
        fd.pos.relStart.value
      })`
    }
  }
}
class AnonymousLambda(
  pos: PosRange,
  closure: Closure,
) extends CGNode_ uses XXHashable {
  fun xxhash(): XXHash {
    XXHash(
      XXHash64.xxHash64(
        // hash the *fields* of pos, not pos itself, to be more conservative
        (
          this.pos.fileName,
          this.pos.relStart.value,
          this.pos.relEnd.value,
        ).xxhash().value,
        this.closure.xxhash().value,
      ),
    )
  }
}
class AnonymousFunDef(funDef: FunDef<FunDefName>) extends CGNode_ {
  fun xxhash(): XXHash {
    XXHash(
      XXHash64.xxHash64(
        // hash the *fields* of pos, not pos itself, to be more conservative
        (
          this.funDef.pos.fileName,
          this.funDef.pos.relStart.value,
          this.funDef.pos.relEnd.value,
        ).xxhash().value,
        this.funDef.xxhash().value,
      ),
    )
  }
}

class CGNode private (
  id: CGNode_,
  precomputed_hash: XXHash,
) extends SKStore.Key, SKStore.File uses Hashable, XXHashable {
  static fun create(id: CGNode_): this {
    static(id, id.xxhash())
  }

  static fun toplevel(fileName: FAbsolute): this {
    static::create(Toplevel(fileName))
  }

  fun xxhash(): XXHash {
    this.precomputed_hash
  }
  fun hash(): Int {
    this.xxhash().value
  }
  fun toString(): String {
    `CGNode[${this.id}]`
  }
  fun compare(other: SKStore.Key): Order {
    other match {
    | CGNode(_otherId, otherHash) -> this.precomputed_hash.compare(otherHash)
    | _ -> invariant_violation("CGNode comparison to non-CGNode Key")
    }
  }
}

class CGNodes(nodes: SortedSet<CGNode>) uses XXHashable, Orderable {
  fun toString(): String {
    nodes = this.nodes.collect(Vector).map((n) -> n.id).join(", ");
    `CGNodes[${nodes}]`
  }

  static fun singleton(node: CGNode): this {
    static(SortedSet::create().add(node))
  }
  fun union(that: CGNodes): this {
    static(this.nodes.union(that.nodes))
  }
  fun compare(other: CGNodes): Order {
    this.nodes.inner.compare(other.nodes.inner)
  }

  fun xxhash(): XXHash {
    XXHash(
      this.nodes.iterator().foldl(
        (seed, node) -> XXHash64.xxHash64(seed, node.xxhash().value),
        -1,
      ),
    )
  }
}

const callGraphDirName: SKStore.DirName = SKStore.DirName::create(
  "/call-graph/",
);
const depGraphDirName: SKStore.DirName = SKStore.DirName::create(
  "/dependency-graph/",
);

class CallGraph private (
  callgraph: SKStore.EHandle<CGNode, CGNode>,
  depgraph: SKStore.EHandle<CGNode, CGNode>,
) {
  static fun build(
    context: mutable SKStore.Context,
    checked: SKStore.EHandle<FAbsolute, CheckResult>,
  ): this {
    callgraph = checked.map(
      CGNode::keyType,
      CGNode::type,
      context,
      callGraphDirName,
      (_context, writer, _fileName, res) ~> {
        res.first.callgraph.each((k, v) -> writer.setArray(k, v))
      },
    );
    depgraph = callgraph.map(
      CGNode::keyType,
      CGNode::type,
      context,
      depGraphDirName,
      (_context, writer, caller, callees) ~> {
        for (callee in callees) {
          writer.append(callee, caller)
        }
      },
    );
    static(callgraph, depgraph)
  }

  static fun create(context: readonly SKStore.Context): ?this {
    context.unsafeMaybeGetEagerDir(callGraphDirName).map(_ ->
      static(
        SKStore.EHandle(CGNode::keyType, CGNode::type, callGraphDirName),
        SKStore.EHandle(CGNode::keyType, CGNode::type, depGraphDirName),
      )
    )
  }

  private fun transitiveClosure(
    context: mutable SKStore.Context,
    roots: readonly Sequence<CGNode>,
  ): readonly Set<CGNode> {
    frontier: mutable Vector<CGNode> = Vector::mcreateFromItems(roots);
    closure: mutable Set<CGNode> = Set::mcreateFromItems(roots);
    while (frontier.size() > 0) {
      curr = frontier.pop();
      for (succ in this.depgraph.getIter(context, curr)) {
        if (!closure.contains(succ)) {
          closure.insert(succ);
          frontier.push(succ);
        }
      }
    };
    closure
  }

  fun affectedFiles(
    context: mutable SKStore.Context,
    changedDefs: Array<Def>,
    debug: Bool = false,
  ): SortedSet<FAbsolute> {
    affectedCGNodes: mutable Set<CGNode> = mutable Set[];
    affectedClasses: mutable Set<(String, FAbsolute)> = mutable Set[]; // (className, fileName) pairs
    for (def in changedDefs) {
      checkDef(def, affectedCGNodes, affectedClasses)
    };
    for (item in this.depgraph.items(context)) {
      node = item.i0;
      node.id match {
      | Method(_, class_, fileName, _)
      | Constructor(class_, fileName) ->
        classIdent = (class_.value, fileName);
        if (affectedClasses.contains(classIdent)) {
          affectedCGNodes.insert(node)
        }
      | TopLevelFunction _
      | Toplevel _
      | ArrowTypeAnnot _
      | AnonymousLambda _
      | AnonymousFunDef _ ->
        void
      }
    };
    closure = this.transitiveClosure(context, affectedCGNodes);

    if (debug) {
      print_error("[debug] Directly-affected CG nodes:");
      for (node in affectedCGNodes) {
        print_error(`[debug]   ${node}`)
      };
      print_error("[debug] Transitively-affected CG nodes:");
      for (node in closure) {
        print_error(`[debug]   ${node}`)
      }
    };

    closure
      .iterator()
      .foldl(
        (affectedFiles, cgNode) -> {
          affectedFiles.set(cgNode.id.getFileName())
        },
        SortedSet<FAbsolute>[],
      )
  }
}

// lifted helper outside of `affectedFiles` for recursion
private fun checkDef(
  def: Def,
  nodes: mutable Set<CGNode>,
  classes: mutable Set<(String, FAbsolute)>,
): void {
  def.value match {
  // Syntactic forms which can't be called or don't define callable entities
  | ExportImport _
  | Global _
  | ExportAs _
  | ExportEq _
  | Module _
  | Namespace _
  | Enum _
  | ImportExpr _
  | TypeDef _
  | ExportNames _
  | ExportNamesFrom _
  | Import _
  | VarDefs _ ->
    void
  // Wrappers: unwrap and recurse
  | Declare(d)
  | ExportDeclare(d)
  | Export(d) ->
    checkDef(Def(def.pos, d), nodes, classes)
  | ExportDefault(d) -> checkDef(Def(def.pos, d), nodes, classes)
  | Expr _ -> nodes.insert(CGNode::toplevel(def.pos.fileName))
  | fd @ TopLevelFunDef _ -> nodes.insert(fd.cgNode.fromSome())
  | c @ Class _ -> classes.insert((c.name.value, def.pos.fileName))
  }
}

module end;
