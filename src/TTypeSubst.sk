/***************************************************************************/
/* Class that maintains the environment for type variables. */
/***************************************************************************/

module SKJS;

base class SubstValue {
  children =
  | SVOpen(TType)
  | SVClosed(TType)
}

class SavedSubst{version: Int, values: SortedMap<Int, SubstValue>}

mutable class Subst private {
  mutable seenSub: SortedSet<(TType, TType)> = SortedSet[],
  mutable seenInter: SortedMap<(TType, TType), TType> = SortedMap[],
  mutable seenUnion: SortedMap<(TType, TType), TType> = SortedMap[],
  mutable version: Int = 0,
  private mutable values: SortedMap<Int, SubstValue> = SortedMap[],
} extends TCEnvBase {
  /* To ensure consistency in type variable identifiers, use mcreate only
     in functions that take no argument containing type variables and whose
     return value does not contain type variables. */
  static fun mcreate(tcenvb: mutable TCEnvBase): mutable Subst {
    mutable Subst{context => tcenvb.context, results => tcenvb.results}
  }

  /* Use Subst#clone to create a temporary subst when there is already
     one that shouldn't be polluted.
     One would typically do this to check subtyping relations that are
     non-mandatory. */
  mutable fun clone(): mutable this {
    mutable Subst{
      context => this.context,
      results => this.results,
      seenSub => this.seenSub,
      seenInter => this.seenInter,
      seenUnion => this.seenUnion,
      version => this.version,
      values => this.values,
    }
  }

  readonly fun save(): SavedSubst {
    SavedSubst{version => this.version, values => this.values}
  }

  mutable fun restore(saved: SavedSubst): void {
    this.!version = saved.version;
    this.!values = saved.values;
  }

  mutable fun grow(
    tenv: TEnv,
    tvar: TVar,
    ty: TType,
    variance: Variance,
  ): void {
    newTy = this.values.maybeGet(tvar.id) match {
    | None() -> ty
    | Some(SVClosed(_)) -> return void
    | Some(SVOpen(ty2)) ->
      newTy = TType::union(this, tenv, ty2, ty);
      if (newTy == ty2) return void;
      newTy
    };
    this.!version = this.version + 1;
    this.!values[tvar.id] = variance match {
    | Contravariant() -> SVOpen(newTy)
    | Covariant() -> SVClosed(newTy)
    }
  }

  mutable fun get(tenv: TEnv, tvar: TVar, variance: Variance): TType {
    result = variance match {
    | Covariant() ->
      this.values.maybeGet(tvar.id) match {
      | None() -> SVOpen(TType::top(tvar.pos))
      | Some(sv) -> sv
      } match {
      | SVOpen(ty) ->
        this.!version = this.version + 1;
        this.!values[tvar.id] = SVClosed(ty);
        ty
      | SVClosed(ty) -> ty
      }
    | Contravariant() ->
      this.values.maybeGet(tvar.id) match {
      | None() -> TType::bottom(tvar.pos)
      | Some(SVOpen(ty))
      | Some(SVClosed(ty)) ->
        ty
      }
    };
    for (cstr in tvar.constraints) {
      !result = TType::inter(this, tenv, result, cstr);
    };
    result
  }

  mutable fun peek(tenv: TEnv, tvar: TVar): ?TType {
    this.values.maybeGet(tvar.id) match {
    | None() -> None()
    | Some(SVOpen(ty))
    | Some(SVClosed(ty)) ->
      result = ty;
      for (cstr in tvar.constraints) {
        !result = TType::inter(this, tenv, result, cstr)
      };
      Some(result)
    }
  }

  mutable fun gen(pos: PosRange): TVar {
    id = this.version;
    this.!version = this.version + 1;
    TVar::create(pos, id)
  }

  readonly fun isOpen(tvar: TVar): Bool {
    this.values.maybeGet(tvar.id) match {
    | Some(SVOpen _) -> true
    | _ -> false
    }
  }
}

module end;
