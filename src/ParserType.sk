module SKJS;

extension class Parser {
  /***************************************************************************/
  // <type_> ::=
  //   | " <string> "
  //   | ' <string> '
  //   | ` <string> `
  //   | true | false
  //   | <number>
  //   | <bigint>
  //   | <prim-kind>
  //   | typeof <type>
  //   | <type> []
  //   | { <field-type>* }
  //   | <name> < <type>* >
  //   | <type> | <type>
  //   | <type> & <type>
  //   | [ <tuple-elt-type>* ]
  //   | function ( <ta-fun-param>* ) : <type>
  //   | <type> [ <type> ]
  //   | <type> extends <type> ? <type> : <type>
  //   | <type> extends <type>
  //   | readonly <type>
  //   | import ( <expr> , <name>? , <type>* )
  //   | infer <name>
  //   | []
  //   | keyof <type>
  //   | new <type>
  //   | abstract <type>
  //   | <type> is <type>
  //   | asserts <name>
  //   | <name> asserts <type>
  //   | unique symbol
  /***************************************************************************/

  mutable fun type(prec: Int): Type {
    inTypeCopy = this.lex.inType;
    this.lex.!inType = true;
    (pos, type) = this.withPos(
      () -> {
        if (
          this.lex.peekKind() is Some(TKBitwiseOr()) ||
          this.lex.peekKind() is Some(TKBitwiseAnd())
        ) {
          _ = this.lex.next();
        };
        this.type_(prec)
      },
      UnterminatedType(),
    );
    this.lex.!inType = inTypeCopy;
    Type(pos, type)
  }

  mutable fun type_(prec: Int): Type_ {
    tok = this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedType())
    | Some(x) -> x
    };
    left = tok.kind match {
    | TKQuote()
    | TKDoubleQuote() ->
      TAStringLiteral(this.unquoteString(tok))
    | TKBackTick() ->
      TATemplate(
        /* TODO: parse type template */ this.lex.getTokenRawStringContent(tok),
      )
    | TKBigInt() -> TABigIntLiteral(this.getBigInt(tok))
    | TKNumber() -> TANumLiteral(this.getNumber(tok))
    | TKLessThan() ->
      tParams = this.typeParams();
      this.expect(TKOpenParen());
      this.typeFun{tParams}
    | TKOpenSquare() ->
      if (this.lex.peekKind() is Some(TKCloseSquare())) {
        _ = this.lex.next();
        TAEmptyArray()
      } else {
        result = mutable Vector<TupleEltType>[];
        loop {
          if (this.lex.peekKind() is Some(TKDotDotDot())) {
            _ = this.lex.next();
            ty = this.type(0);
            if (this.lex.peekKind() is Some(TKColon())) {
              colonTok = this.lex.next().fromSome();
              ty.value match {
              | TAInst(n, targs) if (targs.size() == 0) ->
                result.push(TESpread(Some(n), this.type(0)))
              | _ -> this.error(this.lex.posStart(colonTok), UnexpectedToken())
              }
            } else {
              result.push(TESpread(None(), ty))
            };
          } else if ( // Named elements in a tuple
            this.lex.lookAhead(() -> {
              this.lex.peekKind() is Some(TKVar()) &&
                {
                  _ = this.lex.next();
                  this.lex.peekKind() is Some(TKColon()) ||
                    this.lex.peekKind() is Some(TKQuestionMark()) &&
                      {
                        _ = this.lex.next();
                        this.lex.peekKind() is Some(TKColon())
                      }
                }
            })
          ) {
            name = this.getName();
            optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
              Some(this.lex.posRange(this.lex.next().fromSome()))
            } else {
              None()
            };
            this.expect(TKColon());
            type = this.type(0);
            result.push(TEType(Some(name), optional, type));
          } else {
            type = this.type(0);
            optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
              Some(this.lex.posRange(this.lex.next().fromSome()))
            } else {
              None()
            };
            result.push(TEType(None(), optional, type));
          };
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedType())
          | Some(x) -> x
          };
          commaTok.kind match {
          | TKCloseSquare() -> break void
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKCloseSquare())) {
              _ = this.lex.next();
              break void
            }
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedTokens(Array[TKCloseSquare(), TKComma()]),
            )
          }
        };
        TATuple(result.toArray())
      }
    | TKOpenParen() ->
      if (this.isTypeFunParams()) {
        this.typeFun{tParams => Array[]}
      } else {
        res = this.type(0).value;
        this.expect(TKCloseParen());
        res
      }
    | TKOpenCurly() -> TAObject(this.objectTypeFields())
    | TKVar() ->
      this.getVar(tok) match {
      | "typeof" -> TATypeOf(this.expr(prefixPrec))
      | "import" ->
        this.expect(TKOpenParen());
        e = this.expr(0);
        this.expect(TKCloseParen());
        if (this.lex.peekKind() is Some(TKDot())) {
          this.expect(TKDot());
          name = this.getName();
          loop {
            if (this.lex.peekKind() != Some(TKDot())) break void;
            _ = this.lex.next();
            dotName = this.getName();
            !name = Name(
              name.pos.extend(dotName.pos),
              name.value + "." + dotName.value,
            );
          };
          targs = if (this.lex.peekKind() is Some(TKLessThan())) {
            _ = this.lex.next();
            this.typeList()
          } else {
            Array[]
          };
          TAImport(e, Some(name), Some(targs))
        } else {
          TAImport(e, None(), None())
        }
      | "asserts" ->
        name = this.getName();
        if (this.lex.isEq("is")) {
          _ = this.lex.next();
          TAAssertIs(name, this.type(0))
        } else {
          TAAsserts(name)
        }
      | "unique" ->
        this.expectStr("symbol");
        TAUniqueSymbol()
      | "null" -> TAPrim(TPKNull())
      | "number" -> TAPrim(TPKNum())
      | "boolean" -> TAPrim(TPKBool())
      | "string" -> TAPrim(TPKString())
      | "bigint" -> TAPrim(TPKBigInt())
      | "symbol" -> TAPrim(TPKSymbol())
      | "readonly" -> TAReadonly(this.type(prefixPrec))
      | "infer" -> TAInfer(this.getName())
      | "keyof" -> TAKeyOf(this.type(prefixPrec))
      | "abstract" -> TANew(this.type(prefixPrec))
      | "new" -> TANew(this.type(prefixPrec))
      | className ->
        name = Name(this.lex.posRange(tok), className);
        loop {
          if (this.lex.peekKind() != Some(TKDot())) break void;
          _ = this.lex.next();
          dotName = this.getName();
          !name = Name(
            name.pos.extend(dotName.pos),
            name.value + "." + dotName.value,
          );
        };
        targs = if (this.lex.peekKind() is Some(TKLessThan())) {
          _ = this.lex.next();
          this.typeList()
        } else {
          Array[]
        };
        TAInst(name, targs)
      }
    | TKSubtraction() ->
      numTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      numTok.kind match {
      | TKNumber() -> TANumLiteral("-" + this.getNumber(numTok))
      | TKBigInt() -> TABigIntLiteral("-" + this.getBigInt(numTok))
      | _ ->
        this.error(
          this.lex.posStart(numTok),
          ExpectedTokens(Array[TKNumber(), TKBigInt()]),
        )
      }
    | _ ->
      this.error(
        this.lex.posStart(tok),
        ExpectedTokens(
          Array[
            TKQuote(),
            TKDoubleQuote(),
            TKBackTick(),
            TKLessThan(),
            TKOpenSquare(),
            TKOpenParen(),
            TKOpenCurly(),
            TKSubtraction(),
            TKNumber(),
            TKBigInt(),
            TKVar(),
          ],
        ),
      )
    };

    loop {
      if (
        this.lex.lookAhead(() -> {
          pos = this.lex.pos;
          this.lex.peekKind() is Some(TKOpenSquare()) &&
            {
              _ = this.lex.next();
              if (this.lex.peekKind() is Some(TKCloseSquare())) return false;
              for (i in Range(pos, this.lex.pos)) {
                if (this.lex.contents[i] == '\n') return true;
              };
              false
            }
        })
      ) {
        break void;
      };
      if (this.lex.peekKind() is Some(TKOpenSquare())) {
        _ = this.lex.next();
        if (this.lex.peekKind() is Some(TKCloseSquare())) {
          _ = this.lex.next();
          leftRange = this.lex.posRangeFrom(tok);
          !left = TAArray(Type(leftRange, left));
          continue;
        };
        ty = this.type(0);
        leftRange = this.lex.posRangeFrom(tok);
        this.expect(TKCloseSquare());
        !left = TAGet(Type(leftRange, left), ty);
      } else {
        break void
      }
    };

    loop {
      this.lex.peekKind() match {
      | Some(TKVar()) if (this.lex.isEq("is")) ->
        _ = this.lex.next();
        leftRange = this.lex.posRangeFrom(tok);
        !left = TAIs(Type(leftRange, left), this.type(0))
      | Some(TKVar()) if (this.lex.isEq("extends")) ->
        (_assoc, assignPrec, _binop) = binaryOperators[TKAssignment()];
        ternaryCondPrec = assignPrec + 1;
        if (prec >= ternaryCondPrec) return left;
        _ = this.lex.next();
        ty1 = this.type(ternaryCondPrec);
        if (this.lex.peekKind() is Some(TKQuestionMark())) {
          this.expect(TKQuestionMark());
          ty2 = this.type(0);
          this.expect(TKColon());
          ty3 = this.type(assignPrec);
          leftRange = this.lex.posRangeFrom(tok);
          !left = TAExtendsQuestion(Type(leftRange, left), ty1, ty2, ty3);
        } else {
          leftRange = this.lex.posRangeFrom(tok);
          !left = TAExtends(Type(leftRange, left), ty1);
        };
        continue
      | Some(bop @ TKBitwiseOr())
      | Some(bop @ TKBitwiseAnd()) ->
        (assoc, bopPrec, _binop) = binaryOperators[bop];
        if (!(assoc is ALeft())) internal_error("assoc should be ALeft");
        rightPrec = if (bopPrec == prec) {
          prec + 1
        } else if (bopPrec > prec) {
          bopPrec
        } else {
          return left
        };
        leftRange = this.lex.posRangeFrom(tok);
        _ = this.lex.next();
        right = this.type(rightPrec);
        !left = bop match {
        | TKBitwiseOr() -> TAUnion(Type(leftRange, left), right)
        | TKBitwiseAnd() -> TAInter(Type(leftRange, left), right)
        | _ -> internal_error("Internal error")
        };
        continue
      | _ -> return left
      }
    }
  }

  // Parse closure type after (
  mutable fun typeFun{tParams: Array<TypeParam>}: TAFun {
    params = this.typeFunParams();
    this.expect(TKClosure());
    retType = this.type(0);
    TAFun(
      false,
      tParams,
      params,
      retType,
      CGNode::create(ArrowTypeAnnot(this.lex.fileName)),
    )
  }

  mutable fun isTypeFunParams(): Bool {
    this.lex.lookAhead(() -> {
      countParen = 1;
      loop {
        this.lex.next().map(x -> x.kind) match {
        | None() -> return false
        | Some(TKOpenParen()) -> !countParen = countParen + 1
        | Some(TKCloseParen()) ->
          !countParen = countParen - 1;
          if (countParen == 0) {
            return this.lex.peekKind() is Some(TKClosure())
          }
        | Some _ -> continue
        }
      }
    })
  }

  mutable fun typeFunParams(): Array<TAFunParam> {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return Array[];
    };
    result = mutable Vector[];
    loop {
      isRest = if (this.lex.peekKind() is Some(TKDotDotDot())) {
        Some(this.lex.posRange(this.lex.next().fromSome()))
      } else {
        None()
      };
      name = this.pattern();
      qm = if (this.lex.peekKind() is Some(TKQuestionMark())) {
        Some(this.lex.posRange(this.lex.next().fromSome()))
      } else {
        None()
      };
      this.expect(TKColon());
      type = this.type(0);
      result.push(TAFunParam(isRest, name, qm, type));
      tokComma = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      tokComma.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          return result.toArray()
        }
      | TKCloseParen() -> return result.toArray()
      | _ ->
        this.error(
          this.lex.posStart(tokComma),
          ExpectedTokens(Array[TKCloseParen(), TKComma()]),
        )
      }
    }
  }

  mutable fun typeList(): Array<Type> {
    result = mutable Vector[];
    loop {
      result.push(this.type(0));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKGreaterThan() -> return result.toArray()
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKGreaterThan())) {
          _ = this.lex.next();
          return result.toArray()
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokens(Array[TKGreaterThan(), TKComma()]),
        )
      }
    }
  }

  mutable fun objectTypeFieldModifiers(): ?ObjectFieldReadonly {
    ro = this.lex.peekKind() match {
    | Some(TKSubtraction()) -> OFRemoveReadonly
    | Some(TKAddition()) -> OFReadonly
    | Some(TKVar()) ->
      if (this.lex.isEq("readonly")) {
        pos = this.lex.posRange(this.lex.next().fromSome());
        return Some(OFReadonly(pos))
      };
      return None()
    | _ -> return None()
    };
    this.withPos(
      () ->
        this.lex.tryAhead(() -> {
          _ = this.lex.next();
          if (this.lex.isEq("readonly")) {
            _ = this.lex.next();
            Some(void)
          } else {
            None()
          }
        }),
      UnterminatedExpr(),
    ) match {
    | (pos, Some(_void)) -> Some(ro(pos))
    | (_, None()) -> None()
    }
  }

  // Parse object type fields
  mutable fun objectTypeFields(): Array<ObjectField> {
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Array[];
    };
    fields = mutable Vector<ObjectField>[];
    loop {
      if (
        this.lex.peekKind() is Some(TKOpenParen()) ||
        this.lex.peekKind() is Some(TKLessThan())
      ) {
        emptyPos = this.lex.posRange(this.lex.peek().fromSome());
        method = this.methodDef(
          {tparams, params, retType, body} ->
            ObjectFieldMethod{
              pos => emptyPos,
              isGetSet => None(),
              name => FNEmpty(emptyPos),
              optional => None(),
              sig => FSInline(tparams, params, retType),
              body => FBInline(body),
              cgNode => None(),
            },
          FNEmpty(emptyPos),
          false,
        );
        fields.push(method);
      } else {
        readonly_ = this.objectTypeFieldModifiers();
        fieldGetSet = this.isGetSet();
        fieldPosStart = this.lex.peek() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x.posStart
        };
        fieldName = this.getFieldName();
        isOptional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
          Some(this.lex.posRange(this.lex.next().fromSome()));
        } else {
          None()
        };
        field = fieldName match {
        | methodName @ SimpleFieldName _ if (
          this.lex.peekKind() is Some(TKOpenParen()) ||
          this.lex.peekKind() is Some(TKLessThan())
        ) ->
          readonly_ match {
          | Some(ro) ->
            this.error(
              this.lex.posStart(this.lex.peek().fromSome()),
              UnexpectedObjectTypeMethodReadonly(ro),
            )
          | None() -> void
          };
          this.methodDef(
            {tparams, params, retType, body} ->
              ObjectFieldMethod{
                pos => methodName.getPos(),
                isGetSet => fieldGetSet,
                name => methodName,
                optional => isOptional,
                sig => FSInline(tparams, params, retType),
                body => FBInline(body),
                cgNode => None(),
              },
            methodName,
            true,
          )
        | _ ->
          if (fieldGetSet.isSome()) {
            this.error(
              this.lex.posStart(this.lex.peek().fromSome()),
              ExpectedAccessorDefinition(),
            );
          };
          type = if (this.lex.peekKind() is Some(TKColon())) {
            _ = this.lex.next();
            Some(this.type(0))
          } else {
            None()
          };
          ObjectFieldValue{
            pos => PosRange::create(
              this.lex,
              fieldPosStart,
              this.lex.getLastPos(),
            ),
            readonly_,
            name => fieldName,
            optional => isOptional,
            type,
          }
        };
        fields.push(field)
      };
      semiTok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      semiTok.kind match {
      | TKCloseCurly() ->
        _ = this.lex.next();
        break void
      | TKComma()
      | TKSemi() ->
        _ = this.lex.next();
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ -> void
      }
    };
    fields.toArray()
  }
}

module end;
