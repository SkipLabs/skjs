/***************************************************************************/
/* Enum declarations (issue #762).
 *
 * An enum declares both a type and a value:
 *  - the type `E` is the union of its member types, and each member type
 *    `E.A` is the member's number/string literal type (semantic value-set
 *    reading: at runtime `E.A` IS its literal value);
 *  - the value `E` is a frozen object with a readonly field per member and,
 *    when every member value is statically known, readonly reverse-mapping
 *    fields (numeric value -> member name) matching the runtime object.
 *
 * Members whose value cannot be known statically (computed initializers,
 * ambient uninitialized members) get the full `number` type, a sound
 * over-approximation that also reproduces tsc's opaque computed members.
 */
/***************************************************************************/

module SKJS;

// The statically-known value of an enum member.
base class EnumMemberValue {
  children =
  // A single number or string literal.
  | EMVLiteral(TPrim)
  // A statically-unknown number.
  | EMVNumber(EnumNumberReason)
}

// Why an enum member's value is a statically-unknown number.
base class EnumNumberReason {
  children =
  // The initializer is not a constant expression. The declaration check
  // types it and requires `number` (tsc TS18033/TS2474).
  | ENRComputed()
  // A non-ambient member without initializer whose predecessor has no known
  // numeric value (tsc TS1061); recovered as `number`.
  | ENRMissingInitializer()
  // An ambient (`declare enum`, non-const) member without initializer: tsc
  // treats these as opaque/computed, and the declaration's implied values are
  // not trusted.
  | ENRAmbient()
  // Auto-increment from a non-integer or out-of-double-range predecessor;
  // sound over-approximation (tsc folds e.g. 1.5 + 1 = 2.5 precisely).
  | ENRImprecise()
  // A constant expression whose numeric value is not tracked precisely
  // (references to unknown-valued members, fractional or out-of-range
  // arithmetic). Certainly a number at runtime; no diagnostics.
  | ENRConstUnknown()
  // A member reference that reads a not-yet-initialized member (`A = E.B`
  // with B later, `A = E.A`, a member of a same-file enum declared after
  // this one, or a cyclic cross-enum chain): at runtime the read yields
  // undefined while the initializer runs, so it must be rejected (tsc
  // TS2651). Typing it as an expression would unsoundly see the completed
  // enum object.
  | ENRSelfForwardReference()
}

class EnumMember(name: Name, value: EnumMemberValue, initializer: ?Expr)

// Result of constant-folding an enum member initializer expression.
base class EnumFold {
  children =
  // A number with this double value.
  | EFNum(Float)
  // A string with this literal value.
  | EFStr(String)
  // Certainly a number, value not tracked precisely.
  | EFNumUnknown()
  // Reads a not-yet-initialized enum member (see ENRSelfForwardReference).
  | EFForwardRef()
  // Not a constant expression.
  | EFNotConst()
}

// JS ToInt32 of an integer already exact in a double.
private fun enumToInt32(x: Int): Int {
  u = enumToUint32(x);
  if (u >= 2147483648) u - 4294967296 else u
}

// JS ToUint32 of an integer already exact in a double.
private fun enumToUint32(x: Int): Int {
  m = x % 4294967296;
  if (m < 0) m + 4294967296 else m
}

// Floor division (JS `>>` sign-extends, i.e. floors).
private fun enumFloorDiv(a: Int, b: Int): Int {
  q = a / b;
  if (a % b != 0 && (a < 0) != (b < 0)) q - 1 else q
}

// The single canonical value string of a known numeric member, if any.
private fun enumNumLiteralVal(v: EnumMemberValue): ?String {
  v match {
  | EMVLiteral(TPrimValue(TNum(), Some(lits), _)) ->
    lits.singleElt().map(lit -> lit.val)
  | _ -> None()
  }
}

private fun enumFoldOfMemberValue(v: EnumMemberValue): EnumFold {
  v match {
  | EMVLiteral(TPrimValue(TNum(), Some(lits), _)) ->
    lits.singleElt() match {
    | Some(lit) ->
      jsNumberLiteralDouble(lit.val) match {
      | Some(f) -> EFNum(f)
      | None() -> EFNumUnknown()
      }
    | None() -> EFNumUnknown()
    }
  | EMVLiteral(TPrimString(Some(lits), _)) ->
    lits.singleElt() match {
    | Some(lit) -> EFStr(lit.val)
    | None() -> EFNumUnknown()
    }
  | EMVLiteral _ -> EFNotConst()
  | EMVNumber _ -> EFNumUnknown()
  }
}

// A folded double. NaN has no literal type, so it is an untracked number.
private fun enumFoldDouble(f: Float): EnumFold {
  if (f.isNaN()) EFNumUnknown() else EFNum(f)
}

private fun enumIsFinite(f: Float): Bool {
  !f.isNaN() && f != Float::inf && f != -Float::inf
}

// An Int congruent modulo 2^32 to the truncated integer part of a double (0
// for NaN and the infinities): enumToInt32 / enumToUint32 of it are JS
// ToInt32 / ToUint32 of the double. The stdlib Math.fmod is exact and
// correctly rounded, and truncating its result gives the integer part for
// every finite double, at any magnitude.
private fun enumDoubleInt32Base(f: Float): Int {
  if (!enumIsFinite(f)) 0 else Math.fmod(f, 4294967296.0).toInt()
}

// JS shift counts: ToUint32 of the shift amount, mod 32.
private fun enumShiftCount(b: Float): Int {
  enumToUint32(enumDoubleInt32Base(b)).and(31)
}

// The Int value of a double that is an integer within the double-safe
// range, where Int arithmetic is exact.
private fun enumSafeInt(f: Float): ?Int {
  if (f > -9007199254740993.0 && f < 9007199254740993.0) {
    n = f.toInt();
    if (n.toFloat() == f) return Some(n)
  };
  None()
}

// JS `**`, folded only when exact: an integer base and a non-negative
// integer exponent whose power stays double-safe, and any base to the
// power 0 (which is 1). Other powers go through libm in JS engines, whose
// last-bit rounding is not specified, so they stay an untracked number.
private fun enumFoldPow(a: Float, b: Float): EnumFold {
  if (b == 0.0) return EFNum(1.0);
  (enumSafeInt(a), enumSafeInt(b)) match {
  | (Some(x), Some(y)) if (y > 0 && y <= 60) ->
    r = 1;
    for (_step in Range(0, y)) {
      if (
        x != 0 &&
        (if (r < 0) -r else r) > maxSafeJSInt / (if (x < 0) -x else x)
      ) {
        return EFNumUnknown()
      };
      !r = r * x
    };
    EFNum(r.toFloat())
  | _ -> EFNumUnknown()
  }
}

// Fold a numeric binary operator over two doubles with JS semantics, as tsc
// does. A NaN result, and a power or a quotient whose value is not
// determined by the operands (see below) stay an untracked (sound) number.
private fun enumFoldNumericBinop(
  op: AssignableBinaryOperator,
  a: Float,
  b: Float,
): EnumFold {
  op match {
  | BOAddition() -> enumFoldDouble(a + b)
  | BOSubtraction() -> enumFoldDouble(a - b)
  | BOMultiplication() -> enumFoldDouble(a * b)
  | BODivision() ->
    // The sign of a zero divisor decides the sign of the infinite quotient,
    // but -0 is not distinguished from +0 in a double: not determined.
    if (b == 0.0) EFNumUnknown() else enumFoldDouble(a / b)
  | BORemainder() ->
    // JS `%` on doubles is the truncated remainder with the dividend's sign,
    // which is exactly C fmod (NaN for an infinite dividend or a zero
    // divisor, the dividend for an infinite divisor): the stdlib's
    // Math.fmod.
    enumFoldDouble(Math.fmod(a, b))
  | BOExponentiation() -> enumFoldPow(a, b)
  | BOLeftShift() ->
    c = enumShiftCount(b);
    EFNum(enumToInt32(enumToInt32(enumDoubleInt32Base(a)).shl(c)).toFloat())
  | BOSignedRightShift() ->
    c = enumShiftCount(b);
    one = 1;
    EFNum(
      enumFloorDiv(enumToInt32(enumDoubleInt32Base(a)), one.shl(c)).toFloat(),
    )
  | BOZeroFilledRightShift() ->
    c = enumShiftCount(b);
    one = 1;
    EFNum((enumToUint32(enumDoubleInt32Base(a)) / one.shl(c)).toFloat())
  | BOBitwiseAnd() ->
    EFNum(
      enumToInt32(enumDoubleInt32Base(a))
        .and(enumToInt32(enumDoubleInt32Base(b)))
        .toFloat(),
    )
  | BOBitwiseOr() ->
    EFNum(
      enumToInt32(enumDoubleInt32Base(a))
        .or(enumToInt32(enumDoubleInt32Base(b)))
        .toFloat(),
    )
  | BOBitwiseXor() ->
    EFNum(
      enumToInt32(enumDoubleInt32Base(a))
        .xor(enumToInt32(enumDoubleInt32Base(b)))
        .toFloat(),
    )
  | BONullishCoalescing()
  | LazyLogicalOperator _ ->
    EFNotConst()
  }
}

extension base class TEnv {
  // Elaborate the members of an enum declaration. Pure: diagnostics for the
  // ENRComputed/ENRMissingInitializer cases are emitted once, by checkEnum.
  // `visiting` carries the declaration positions of the enums currently
  // being elaborated, to break cyclic cross-enum member references.
  fun enumMembers(
    tcenvb: mutable TCEnvBase,
    en: Enum,
    visiting: SortedSet<PosRange> = SortedSet[],
  ): Array<EnumMember> {
    // In a (non-const) ambient enum, a member without initializer is opaque
    // ("considered computed" per tsc); `declare const enum` members are
    // constant like in a regular enum.
    ambientOpaque = en.isAmbient && en.isConst is None();
    byName = mutable Map<String, EnumMemberValue>[];
    members = mutable Vector<EnumMember>[];
    prev: ?EnumMemberValue = None();
    for (field in en.fields) {
      (name, init) = field;
      value = init match {
      | Some(e) -> this.enumInitializerValue(tcenvb, en, byName, visiting, e)
      | None() if (ambientOpaque) -> EMVNumber(ENRAmbient())
      | None() ->
        prev match {
        | None() -> EMVLiteral(TPrimValue::single(TNum(), "0", name.pos))
        | Some(prevValue) -> static::enumAutoIncrement(prevValue, name.pos)
        }
      };
      // Runtime last-write-wins: a reference to a duplicated name reads the
      // latest preceding definition. Duplicates are reported by checkEnum.
      byName![name.value] = value;
      members.push(EnumMember(name, value, init));
      !prev = Some(value)
    };
    members.toArray()
  }

  // The value of a member initializer expression, by constant folding.
  private fun enumInitializerValue(
    tcenvb: mutable TCEnvBase,
    en: Enum,
    byName: readonly Map<String, EnumMemberValue>,
    visiting: SortedSet<PosRange>,
    e: Expr,
  ): EnumMemberValue {
    // A plain numeric literal keeps its user-written spelling for
    // diagnostics when it is a representable double; everything else
    // (including unrepresentable literals that fold to EFNumUnknown) goes
    // through enumFold.
    e.value match {
    | Number(n) if (jsNumberLiteralDouble(n.val).isSome()) ->
      EMVLiteral(TPrimValue::single(TNum(), n.val, e.pos, n.userVal))
    | _ ->
      this.enumFold(tcenvb, en, byName, visiting, e) match {
      | EFNum(f) ->
        EMVLiteral(TPrimValue::single(TNum(), jsNumberToString(f), e.pos))
      | EFStr(s) -> EMVLiteral(TPrimString::single(s, e.pos))
      | EFNumUnknown() -> EMVNumber(ENRConstUnknown())
      | EFForwardRef() -> EMVNumber(ENRSelfForwardReference())
      | EFNotConst() -> EMVNumber(ENRComputed())
      }
    }
  }

  // Constant-fold an enum member initializer expression: literals, unary
  // +/-/~, binary arithmetic/bitwise operators and string concatenation
  // over constants, and references to already-initialized enum members
  // (bare `A`, qualified `E.A`, element access `E["A"]`, and members of
  // other enums that are provably initialized first: same-file enums
  // declared earlier, or imported ones). Arithmetic folds with JS double
  // semantics over the operand doubles (see enumFoldNumericBinop for the
  // cases that stay a plain `number`); the result is named by its String()
  // form when the member value is materialized.
  private fun enumFold(
    tcenvb: mutable TCEnvBase,
    en: Enum,
    byName: readonly Map<String, EnumMemberValue>,
    visiting: SortedSet<PosRange>,
    e: Expr,
  ): EnumFold {
    e.value match {
    | Number(n) ->
      jsNumberLiteralDouble(n.val) match {
      | Some(f) -> EFNum(f)
      | None() -> EFNumUnknown()
      }
    | EString(s) -> EFStr(s)
    | Unop(uop @ NumericUnaryOperator _, sub) ->
      this.enumFold(tcenvb, en, byName, visiting, sub) match {
      | EFNum(f) ->
        uop match {
        | UOPlus() -> EFNum(f)
        // -0.0 is named "0" by jsNumberToString, as String(-0) is "0".
        | UOMinus() -> EFNum(-f)
        | UOTild() ->
          n = enumToInt32(enumDoubleInt32Base(f));
          EFNum(enumToInt32(-(n + 1)).toFloat())
        }
      | EFNumUnknown() -> EFNumUnknown()
      | fwd @ EFForwardRef() -> fwd
      | EFStr _
      | EFNotConst() ->
        EFNotConst()
      }
    | Binop(op @ AssignableBinaryOperator _, e1, e2) ->
      this.enumFoldBinop(
        op,
        this.enumFold(tcenvb, en, byName, visiting, e1),
        this.enumFold(tcenvb, en, byName, visiting, e2),
      )
    | Var(n) ->
      byName.maybeGet(n.value) match {
      | Some(v) -> enumFoldOfMemberValue(v)
      | None() ->
        // The enum's member scope shadows the outer scope (like tsc), so a
        // bare name matching any sibling — including one declared later, or
        // this member itself — is a member reference that reads an
        // uninitialized value at runtime. Only a name that is not a member
        // falls through to the outer-scope resolution done by the computed
        // path.
        if (en.fields.any(f -> f.i0.value == n.value)) {
          EFForwardRef()
        } else {
          EFNotConst()
        }
      }
    | Dot(NormalDot(), Expr(_, Var(base)), fieldName) ->
      this.enumFoldMemberRef(
        tcenvb,
        en,
        byName,
        visiting,
        base,
        fieldName.value,
      )
    | Get(Expr(_, Var(base)), keyExpr) ->
      keyExpr.value match {
      | EString(key) ->
        this.enumFoldMemberRef(tcenvb, en, byName, visiting, base, key)
      | _ -> EFNotConst()
      }
    | _ -> EFNotConst()
    }
  }

  // A reference `<base>.<member>` (or `<base>["member"]`) to an enum member
  // in initializer position.
  private fun enumFoldMemberRef(
    tcenvb: mutable TCEnvBase,
    en: Enum,
    byName: readonly Map<String, EnumMemberValue>,
    visiting: SortedSet<PosRange>,
    base: Name,
    memberName: String,
  ): EnumFold {
    if (base.value == en.name.value) {
      return byName.maybeGet(memberName) match {
      | Some(v) -> enumFoldOfMemberValue(v)
      | None() -> EFForwardRef()
      }
    };
    // Resolve the base speculatively, to decide whether this reference is a
    // cross-enum member reference at all. A throwaway `probe` accumulator is
    // used rather than `tcenvb` for two reasons:
    //  - We must not attach diagnostics here. A base that does not resolve, or
    //    resolves to a non-enum, is not our concern: the reference then falls
    //    to the computed path, whose expression check (checkEnum's ENRComputed
    //    arm) emits the authoritative diagnostic. Reporting through `tcenvb`
    //    would duplicate or mis-attribute it.
    //  - errorHandling must be keep-going: this fold runs from contexts that
    //    must not abort (e.g. type normalization), and in default mode a
    //    resolution error inside getAll would throw a fatal ErrorExn. Keep-
    //    going collects any such error into the discarded accumulator instead.
    probe = mutable TCEnvLight{
      context => tcenvb.context,
      results => TCResultsAcc::mcreate{errorHandling => EHKeepGoing()},
    };
    this.defMap.getAll(probe, base, true).find(d -> d is Enum _) match {
    | Some(other @ Enum _) ->
      otherPos = other.name.pos;
      enPos = en.name.pos;
      if (visiting.contains(otherPos)) {
        // A cyclic cross-enum reference, reached only on a back edge while
        // folding an ancestor enum's members to read one value. The member
        // that is syntactically forward (references a later-declared enum) is
        // rejected by the position check below when its own enum is checked;
        // on the back edge we cannot tell whether THIS reference is that
        // offending one, and tsc accepts a back-edge reference to an
        // already-declared enum, so we treat it as an untracked number rather
        // than assert a forward reference. (This value is only ever consumed
        // through enumFoldOfMemberValue, which collapses it to the same
        // unknown number regardless.)
        return EFNumUnknown()
      };
      if (otherPos.fileName == enPos.fileName) {
        if (otherPos.symbol != enPos.symbol) {
          // Nested declaration contexts cannot be ordered by position;
          // fall back to the computed path.
          return EFNotConst()
        };
        if (otherPos.relStart.value > enPos.relStart.value) {
          // Declared after this enum in the same file: its members are
          // not initialized yet when this initializer runs.
          return EFForwardRef()
        }
      };
      // Same-file earlier declaration, or another module (evaluated before
      // its importer).
      otherMembers = this.enumMembers(tcenvb, other, visiting.set(enPos));
      found: ?EnumMember = None();
      for (m in otherMembers) {
        if (m.name.value == memberName) {
          !found = Some(m)
        }
      };
      found match {
      | Some(m) -> enumFoldOfMemberValue(m.value)
      | None() -> EFNotConst()
      }
    | _ -> EFNotConst()
    }
  }

  private fun enumFoldBinop(
    op: AssignableBinaryOperator,
    lhs: EnumFold,
    rhs: EnumFold,
  ): EnumFold {
    (lhs, rhs) match {
    | (fwd @ EFForwardRef(), _)
    | (_, fwd @ EFForwardRef()) ->
      fwd
    | (EFNotConst(), _)
    | (_, EFNotConst()) ->
      EFNotConst()
    | (EFStr(a), EFStr(b)) ->
      op match {
      | BOAddition() -> EFStr(a + b)
      | _ -> EFNotConst()
      }
    // JS string concatenation with a number renders its String() form.
    | (EFStr(a), EFNum(b)) ->
      op match {
      | BOAddition() -> EFStr(a + jsNumberToString(b))
      | _ -> EFNotConst()
      }
    | (EFNum(a), EFStr(b)) ->
      op match {
      | BOAddition() -> EFStr(jsNumberToString(a) + b)
      | _ -> EFNotConst()
      }
    | (EFStr _, EFNumUnknown())
    | (EFNumUnknown(), EFStr _) ->
      EFNotConst()
    | (EFNumUnknown(), EFNum _)
    | (EFNum _, EFNumUnknown())
    | (EFNumUnknown(), EFNumUnknown()) ->
      EFNumUnknown()
    | (EFNum(a), EFNum(b)) -> enumFoldNumericBinop(op, a, b)
    }
  }

  // The value of an uninitialized member: its predecessor's value + 1,
  // folded with JS double semantics, as tsc folds it (1.5 + 1 = 2.5).
  static fun enumAutoIncrement(
    prevValue: EnumMemberValue,
    pos: PosRange,
  ): EnumMemberValue {
    enumNumLiteralVal(prevValue) match {
    | Some(v) ->
      jsNumberLiteralDouble(v) match {
      | Some(f) ->
        enumFoldNumericBinop(BOAddition(), f, 1.0) match {
        | EFNum(next) ->
          EMVLiteral(TPrimValue::single(TNum(), jsNumberToString(next), pos))
        | _ -> EMVNumber(ENRImprecise())
        }
      | None() -> EMVNumber(ENRImprecise())
      }
    | None() ->
      prevValue match {
      | EMVNumber(ENRAmbient()) -> EMVNumber(ENRAmbient())
      // The predecessor is certainly a number, just untracked
      // (fractional/out-of-range/constant-reference): the increment is
      // a number too, and tsc accepts it (it folds these precisely).
      | EMVNumber(ENRImprecise())
      | EMVNumber(ENRConstUnknown()) ->
        EMVNumber(ENRImprecise())
      | _ -> EMVNumber(ENRMissingInitializer())
      }
    }
  }

  // The primitive value type of one member: its number/string literal, or a
  // full `number` for a member whose value is not statically tracked.
  static fun enumMemberPrim(m: EnumMember): TPrim {
    m.value match {
    | EMVLiteral(st) -> st
    | EMVNumber _ -> TPrimValue::full(TNum(), m.name.pos)
    }
  }

  // The type of one member (`E.A` in type position, and the member field's
  // type on the enum object).
  static fun enumMemberValueType(m: EnumMember): TType {
    TType::single(static::enumMemberPrim(m))
  }

  // The type named by the enum (annotation `E`): the union of its member
  // types. An empty enum has no values. Members are only numbers or strings,
  // so the union is built directly from the numeric literal set (`None` once
  // any member is a full/untracked number, collapsing the numeric part to
  // `number`) and the string literal set, rather than going through the
  // general TType::union machinery.
  fun enumUnionType(tcenvb: mutable TCEnvBase, en: Enum): TType {
    pos = en.name.pos;
    numberFull = false;
    nums: ?PrimLiterals = None();
    strings = SortedSet<String>[];
    for (m in this.enumMembers(tcenvb, en)) {
      static::enumMemberPrim(m) match {
      | TPrimValue(TNum(), Some(lits), _) ->
        // Union the PrimLiterals directly so member spellings survive.
        !nums = Some(
          nums match {
          | Some(n) -> n.union(lits)
          | None() -> lits
          },
        )
      | TPrimValue(TNum(), None(), _) -> !numberFull = true
      | TPrimString(Some(lits), _) ->
        for (lit in lits.values()) {
          !strings = strings.set(lit.val)
        }
      | _ -> void
      }
    };
    stypes = mutable Vector<SType>[];
    if (numberFull) {
      stypes.push(TPrimValue::full(TNum(), pos))
    } else {
      nums.each(lits -> stypes.push(TPrimValue(TNum(), Some(lits), pos)))
    };
    PrimLiterals::ofSet(strings, pos).each(lits ->
      stypes.push(TPrimString(Some(lits), pos))
    );
    if (stypes.isEmpty()) {
      return TType::bottom(pos)
    };
    result = TType::single(stypes[0]);
    // Only a heterogeneous enum (numeric and string members) reaches the body
    // of this loop, joining the two parts with a single union.
    for (i in Range(1, stypes.size())) {
      !result = TType::unionStructural(result, TType::single(stypes[i]))
    };
    result
  }

  // The member type for a qualified type reference `E.<member>`, or None if
  // there is no such member.
  fun enumMemberType(
    tcenvb: mutable TCEnvBase,
    en: Enum,
    memberName: String,
  ): ?TType {
    // Runtime last-write-wins for duplicated names (reported separately).
    found: ?EnumMember = None();
    for (m in this.enumMembers(tcenvb, en)) {
      if (m.name.value == memberName) {
        !found = Some(m)
      }
    };
    found.map(m -> static::enumMemberValueType(m))
  }

  // The type of the enum VALUE (`E` in expression position, `typeof E`): a
  // frozen object with a readonly field per member and, when every member
  // value is statically known, readonly reverse-mapping fields for the
  // numeric members (later members overwrite earlier equal values, like the
  // runtime object). If any member value is unknown, reverse fields are
  // omitted entirely: an unknown value could collide with a known one at
  // runtime, so no individual reverse entry is trustworthy.
  fun enumStatic(tcenvb: mutable TCEnvBase, en: Enum): TType {
    members = this.enumMembers(tcenvb, en);
    fields = mutable Map<FieldNameString, TField>[];
    for (m in members) {
      fields![FieldNameString(m.name.value)] = TField::create{
        pos => m.name.pos,
        name => m.name.value,
        isOptional => false,
        isReadonly => Some(m.name.pos),
        type => static::enumMemberValueType(m),
        access => FAPublic(),
      }
    };
    // Reverse fields also need every numeric value to be named as its runtime
    // key String(Number(x)): normalization names beyond-precision and
    // overflowing values that way (rule 30, e.g. Infinity), but a spelling it
    // kept could collide with another member's key, so no individual entry
    // would be trustworthy then.
    reverseTrustworthy =
      members.all(m -> m.value is EMVLiteral _) &&
      members.all(m ->
        enumNumLiteralVal(m.value) match {
        | Some(v) -> isExactJSNumberName(v)
        | None() -> true
        }
      );
    if (reverseTrustworthy) {
      for (m in members) {
        enumNumLiteralVal(m.value).each(val -> {
          fields![FieldNameString(val)] = TField::create{
            pos => m.name.pos,
            name => val,
            isOptional => false,
            isReadonly => Some(m.name.pos),
            type => TType::single(
              TPrimString::single(m.name.value, m.name.pos),
            ),
            access => FAPublic(),
          }
        })
      }
    };
    TType::single(
      TObject::createSingleBranch(
        TFields::create{
          fields,
          // The runtime enum object is a plain object: never callable or
          // primitive.
          call => CAbsent(),
          new => CAbsent(),
          isArray => Some(false),
          isNonPrimitive => true,
        },
        None(),
        en.name.pos,
      ),
    )
  }
}

extension class TypeChecker {
  // #787: warn when reading an enum reverse mapping whose statically-known
  // literal key names more than one member (`Same[0]` with `A = 0, B = 0`): at
  // runtime the reverse mapping keeps only the last-declared member, so the
  // earlier ones are unreachable through it. Only a literal key is checked —
  // a computed key is not statically known to be ambiguous.
  fun warnAmbiguousEnumReverseAccess(
    tcenv: mutable TCEnv,
    arr: Expr,
    idx: Expr,
  ): void {
    arr.value match {
    | Var(name) ->
      keyOpt = this.directLiteralSType(idx).flatMap(stype ->
        stype match {
        | TPrimValue(TNum(), Some(lits), _) ->
          lits.singleElt().map(lit -> lit.val)
        | _ -> None()
        }
      );
      keyOpt.each(key -> {
        for (def in this.defMap.getAll(tcenv, name, false, false)) {
          def match {
          | en @ Enum _ ->
            matching = mutable Vector[];
            for (m in this.enumMembers(tcenv, en)) {
              if (
                enumNumLiteralVal(m.value).map(v -> v == key).default(false)
              ) {
                matching.push(m)
              }
            };
            if (matching.size() > 1) {
              matched = matching.toArray();
              tcenv.warning(
                Array[
                  (
                    idx.pos,
                    `Ambiguous enum reverse mapping for value ${key}: it resolves to the last-declared member '${
                      matched[matched.size() - 1].name.value
                    }'`,
                  ),
                  (matched[0].name.pos, "The value is first assigned here"),
                ],
                ESLintCode("@typescript-eslint/no-duplicate-enum-values"),
              )
            }
          | _ -> void
          }
        }
      })
    | _ -> void
    }
  }

  // Check an enum declaration: duplicate member names, members that need an
  // initializer, and computed initializers (typed, and required to be
  // numbers; constant expressions required in const enums).
  fun checkEnum(tcenvl: mutable TCEnvLight, en: Enum): void {
    seen: SortedSet<String> = SortedSet[];
    for (field in en.fields) {
      (name, _) = field;
      if (seen.contains(name.value)) {
        tcenvl.error(
          Array[(name.pos, `Duplicate identifier '${name.value}'`)],
          TSCode(2300),
        )
      };
      !seen = seen.set(name.value)
    };
    members = this.enumMembers(tcenvl, en);
    // Warn on a member whose direct-literal value duplicates an earlier
    // member's numeric value: the runtime reverse mapping (`E[value]`) then
    // resolves to the later member, shadowing the earlier one — usually a
    // copy-paste mistake. A member-reference initializer (`B = A`) is an
    // intentional alias and is not flagged (matching no-duplicate-enum-values).
    seenValues = mutable Map<String, PosRange>[];
    for (m in members) {
      enumNumLiteralVal(m.value).each(val -> {
        seenValues.maybeGet(val) match {
        | Some(earlierPos) ->
          isLiteralInit = m.initializer.flatMap(e ->
            this.directLiteralSType(e)
          ) is Some _;
          if (isLiteralInit) {
            tcenvl.warning(
              Array[
                (m.name.pos, `Duplicate enum member value ${val}`),
                (earlierPos, "The value is first assigned here"),
              ],
              ESLintCode("@typescript-eslint/no-duplicate-enum-values"),
            )
          }
        | None() -> seenValues![val] = m.name.pos
        }
      })
    };
    for (m in members) {
      m.value match {
      | EMVLiteral _
      | EMVNumber(ENRAmbient())
      | EMVNumber(ENRImprecise())
      | EMVNumber(ENRConstUnknown()) ->
        void
      | EMVNumber(ENRSelfForwardReference()) ->
        tcenvl.error(
          Array[
            (
              m.name.pos,
              "A member initializer in a enum declaration cannot reference members declared after it, including members defined in other enums",
            ),
          ],
          TSCode(2651),
        )
      | EMVNumber(ENRMissingInitializer()) ->
        tcenvl.error(
          Array[(m.name.pos, "Enum member must have initializer")],
          TSCode(1061),
        )
      | EMVNumber(ENRComputed()) ->
        if (en.isConst is Some _) {
          tcenvl.error(
            Array[
              (
                m.name.pos,
                "const enum member initializers must be constant expressions",
              ),
            ],
            TSCode(2474),
          )
        } else if (en.isAmbient) {
          tcenvl.error(
            Array[
              (
                m.name.pos,
                "In ambient enum declarations member initializer must be constant expression",
              ),
            ],
            TSCode(1066),
          )
        } else {
          m.initializer.each(e ->
            tcenvl.collectErrors(() -> {
              subst = Subst::createCheckingOwner(tcenvl);
              tcenv = TCEnv::mcreate(
                subst,
                CGNode::toplevel(m.name.pos.fileName),
              );
              ety = this.expr(tcenv, e, true);
              this.checkSubType(
                tcenv,
                e.pos,
                "Computed enum member values must be numbers",
                ety,
                TType::single(TPrimValue::full(TNum(), e.pos)),
                TSCode(18033),
              );
              tcenv.validateHiddenEscapes()
            })
          )
        }
      }
    }
  }
}

module end;
