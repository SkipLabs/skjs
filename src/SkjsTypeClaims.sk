/***************************************************************************/
/* SKJS type claims (verification/DESIGN.md).
 *
 * Records expression types and statement environments and prints them as JSON.
 * The Lean verifier checks these claims against an independent source AST.
 * A claim is not trusted: verifier acceptance establishes program typing, not
 * that this exporter faithfully recorded every internal SKJS decision.
 *
 * Emission is gated on the --emit-skjs-type-claims flag and adds no work to a
 * normal run.
 */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* The claims. */
/***************************************************************************/

// `isMutable` and `declaredType` come straight from the scope's own `LocalRef`
// (src/TypeCheckScope.sk): `declaredType` is `None` when it equals the
// narrowed `type`, since it then carries nothing beyond what `type` already
// says.
class TypeClaimVar(
  name: String,
  type: TType,
  isMutable: Bool,
  declaredType: ?TType,
)

// The environment SKJS held on entry to the statement at `pos`.
class TypeClaimEnv(pos: PosRange, vars: Array<TypeClaimVar>)

// The type SKJS assigned to the expression node at `pos`.
class TypeClaimExpr(pos: PosRange, type: TType)

class TypeClaimParam(name: String, type: TType)

class FunTypeClaims(
  name: String,
  // The function name's own span: the key the checker binds these claims to
  // in the trusted AST.
  namePos: PosRange,
  params: Array<TypeClaimParam>,
  retType: TType,
  envs: Array<TypeClaimEnv>,
  exprs: Array<TypeClaimExpr>,
  // The write side of `exprs`: the type SKJS assigned to the same span read
  // as an assignment target or a binding pattern (`exprTypes`'s `isLValue`
  // key), rather than as a value.
  lvalues: Array<TypeClaimExpr>,
  // Snapshot at successful completion or a body error that aborts checking.
  // Export reads existing bounds; it cannot solve, seal or grow inference variables.
  substValues: SortedMap<TVarID, SubstValue>,
  aborted: Bool,
  recovered: Bool,
  mode: String,
  visitedExpressions: Array<PosRange>,
)

// Collects the claims at completion or abort without resuming type checking.
// Reads only what the checker already computed.
fun buildFunTypeClaims(
  name: String,
  namePos: PosRange,
  typedParams: Array<(Pattern, TType)>,
  retType: TType,
  tcenv: mutable TCEnv,
  aborted: Bool,
  errorsBefore: Int,
): FunTypeClaims {
  params = typedParams.map(p ->
    TypeClaimParam(
      p.i0.value match {
      | PVar(local) -> local.value
      | _ -> "?"
      },
      p.i1,
    )
  );
  // One type per source span. A node checked in both modes keeps the
  // most-precise one, which is the type `lookupExprType` reads.
  byPos = SortedMap<PosRange, TType>[];
  for (kv in tcenv.exprTypes.items()) {
    if (!kv.i0.i2 && !kv.i0.i1) {
      !byPos = byPos.set(kv.i0.i0, kv.i1)
    }
  };
  for (kv in tcenv.exprTypes.items()) {
    if (!kv.i0.i2 && kv.i0.i1) {
      !byPos = byPos.set(kv.i0.i0, kv.i1)
    }
  };
  exprs = mutable Vector<TypeClaimExpr>[];
  for (kv in byPos.items()) {
    exprs.push(TypeClaimExpr(kv.i0, kv.i1))
  };
  // The same most-precise-wins merge, for the `isLValue` entries.
  byPosL = SortedMap<PosRange, TType>[];
  for (kv in tcenv.exprTypes.items()) {
    if (kv.i0.i2 && !kv.i0.i1) {
      !byPosL = byPosL.set(kv.i0.i0, kv.i1)
    }
  };
  for (kv in tcenv.exprTypes.items()) {
    if (kv.i0.i2 && kv.i0.i1) {
      !byPosL = byPosL.set(kv.i0.i0, kv.i1)
    }
  };
  lvalues = mutable Vector<TypeClaimExpr>[];
  for (kv in byPosL.items()) {
    lvalues.push(TypeClaimExpr(kv.i0, kv.i1))
  };
  visits = SortedMap<PosRange, Bool>[];
  for (pos in tcenv.claimedExprVisits) {
    !visits[pos] = true
  };
  visited = mutable Vector<PosRange>[];
  for (pos in visits.keys()) {
    visited.push(pos)
  };
  mode = tcenv.results.errorHandling match {
  | EHDefault() -> "normal"
  | EHKeepGoing() -> "keep-going"
  | EHBacktrace() -> "backtrace"
  };
  FunTypeClaims(
    name,
    namePos,
    params,
    retType,
    tcenv.claimedEnvs.toArray(),
    exprs.toArray(),
    lvalues.toArray(),
    tcenv.subst.values,
    aborted,
    tcenv.results.errors.size() > errorsBefore,
    mode,
    visited.toArray(),
  )
}

/***************************************************************************/
/* Type serialization.
 *
 * A type is rendered as {"top": bool, "atoms": [...]}: `top` is `unknown`,
 * an empty atom list is `never`, and otherwise the type is the union of its
 * atoms. Anything outside the supported fragment renders as {"unsupported": true},
 * which the checker treats as a rejection rather than as a type.
 */
/***************************************************************************/

// Reasons are diagnostics, serialized beside claims, never inside a type.
class ClaimExport(json: String, reason: String)
fun claimUnavailable(reason: String): ClaimExport {
  ClaimExport(claimUnsupported, reason)
}

const claimUnsupported: String = "{\"unsupported\": true}";

fun claimKindName(kind: TPrimValueKind): ?String {
  kind match {
  | TNum() -> Some("number")
  | TString() -> Some("string")
  | TBool() -> Some("boolean")
  | TBigInt() -> None()
  | TSymbol() -> None()
  }
}

// Pushes the atoms of `sty` onto `acc`. Returns a refusal reason, or the empty string on success.
fun claimPushAtoms(
  sty: SType,
  acc: mutable Vector<String>,
  records: Bool,
  values: SortedMap<TVarID, SubstValue>,
  fuel: Int,
): String {
  sty match {
  | TPrimUnit(TNull(), _) ->
    acc.push(jsonObj(Array[("a", jsonStr("null"))]));
    ""
  | TPrimUnit(TUndefined(), _) ->
    acc.push(jsonObj(Array[("a", jsonStr("undefined"))]));
    ""
  | TPrimUnit(TVoid(), _) -> "void-type"
  | TPrimValue(kind, litsOpt, _) ->
    claimKindName(kind) match {
    | None() -> "unsupported-primitive"
    | Some(tag) ->
      litsOpt match {
      | None() ->
        acc.push(jsonObj(Array[("a", jsonStr(tag))]));
        ""
      | Some(lits) ->
        for (lit in lits) {
          acc.push(
            jsonObj(
              Array[("a", jsonStr(tag + "lit")), ("v", jsonStr(lit.val))],
            ),
          )
        };
        ""
      }
    }
  | obj @ TObject _ ->
    if (records) {
      // Branches are alternatives, preserved as separate union atoms. Never
      // emit a partial union when any branch cannot be represented. A branch
      // that fails both readings reports the reason of the reading its shape
      // asks for: a callable branch is a function, anything else a cell.
      // A class instance's branches export like any other object's: the
      // class it names in `unexpandedType` is display information, and its
      // shape is already expanded here. Whether an instance may be read as a
      // plain cell is the source gate's decision.
      branches = obj.getBranches();
      reason = if (branches.isEmpty()) "no-object-branch" else "";
      for (fields in branches) {
        claimCellBranchJson(fields, values, fuel) match {
        | Success(atom) -> acc.push(atom)
        | Failure(cellReason) ->
          claimFunctionBranchJson(fields, values, fuel) match {
          | Success(atom) -> acc.push(atom)
          | Failure(functionReason) ->
            if (reason == "") {
              !reason = fields.call match {
              | CPresent _ -> functionReason
              | _ -> cellReason
              }
            }
          }
        }
      };
      reason
    } else {
      // Objects are exported at the top of a claim only; as a field, parameter
      // or result type they are outside the fragment.
      "nested-object-type"
    }
  }
}

fun claimTypeJsonBounded(
  ty: TType,
  records: Bool,
  values: SortedMap<TVarID, SubstValue>,
  fuel: Int,
): ClaimExport {
  if (fuel <= 0) {
    claimUnavailable("fuel-exhausted")
  } else if (!ty.insts.isEmpty()) {
    // Only an isolated, bound, unconstrained inference variable can be read
    // from the snapshot. Do not approximate constraints or expand named types.
    // Everything else is refused under the name of what it is.
    ty.getSingleVar() match {
    | Some(tv) ->
      if (!tv.constraints.isEmpty()) {
        claimUnavailable("constrained-inference-variable")
      } else {
        values.maybeGet(tv.id) match {
        | Some(SVOpen(bound))
        | Some(SVClosed(bound)) ->
          claimTypeJsonBounded(bound, records, values, fuel - 1)
        | None() -> claimUnavailable("unbound-inference-variable")
        }
      }
    | None() ->
      if (ty.insts.size() > 1) {
        claimUnavailable("several-unexpanded-types")
      } else if (ty.getSingleInst().isSome()) {
        claimUnavailable("unexpanded-named-type")
      } else if (ty.getSingleInter().isSome()) {
        // A conjunction of two object types is merged by TObject::inter
        // (src/TTypeInter.sk) before it can reach export, and an unexpanded
        // TInter survives only around an unbound inference variable, which
        // the surface never leaves open. So no export carries a conjunction
        // to write as `and`, and this refusal is what remains.
        claimUnavailable("unexpanded-intersection")
      } else {
        claimUnavailable("unexpanded-type")
      }
    }
  } else if (ty.clauses.isTop()) {
    ClaimExport("{\"top\": true, \"atoms\": []}", "")
  } else {
    atoms = mutable Vector<String>[];
    reason = "";
    nClauses = 0;
    for (clause in ty.clauses) {
      !nClauses = nClauses + 1;
      if (clause.vars.size() != 0) {
        // A universally quantified type parameter: outside the fragment.
        !reason = "type-parameter"
      };
      clause.stypes match {
      | None() -> !reason = "unsupported-type"
      | Some(stypes) ->
        for (sty in stypes) {
          refusal = claimPushAtoms(sty, atoms, records, values, fuel - 1);
          if (reason == "" && refusal != "") {
            !reason = refusal
          }
        }
      }
    };
    // `never` is zero clauses; more than one clause is a DNF outside the fragment.
    if (nClauses > 1) {
      !reason = "union-of-clauses"
    };
    if (reason == "") {
      ClaimExport(`{"top": false, "atoms": ${jsonArr(atoms)}}`, "")
    } else {
      claimUnavailable(reason)
    }
  }
}

// A deliberately bounded record branch: one public `value` field, no real index,
// symbol, array, call or construct requirements. Preserve read and write types
// separately; the verifier decides whether they justify an invariant cell.
// Primitive-only recursive calls bound serialization even for recursive types.
fun claimCellBranchJson(
  fields: TFields,
  values: SortedMap<TVarID, SubstValue>,
  fuel: Int,
): Result<String, String> {
  callMode = fields.call match {
  | CUnknown() -> Some("unknown")
  | CAbsent() -> Some("absent")
  | _ ->
    None() // Positive callability is outside the plain-cell fragment.
  };
  newMode = fields.new match {
  | CUnknown() -> Some("unknown")
  | CAbsent() -> Some("absent")
  | _ ->
    None() // Positive constructibility is outside the plain-cell fragment.
  };
  if (fields.isArray == Some(true)) return Failure("cell-is-array");
  if (!fields.symbolFields.isEmpty()) return Failure("cell-symbol-field");
  if (fields.hasNonSyntheticIndex()) return Failure("cell-index-signature");
  if (callMode.isNone()) return Failure("cell-callable");
  if (newMode.isNone()) return Failure("cell-constructible");
  entries = mutable Vector<String>[];
  for (field in fields.fields) {
    if (field.name.value != "value") return Failure("cell-field-name");
    if (!(field.access is FAPublic())) return Failure("cell-field-access");
    // A field type that cannot be exported names its own reason.
    read = claimTypeJsonBounded(field.get, false, values, fuel);
    if (read.reason != "") return Failure(read.reason);
    write = claimTypeJsonBounded(field.set, false, values, fuel);
    if (write.reason != "") return Failure(write.reason);
    entries.push(
      jsonObj(
        Array[
          ("name", jsonStr(field.name.value)),
          ("optional", if (field.isOptional) "true" else "false"),
          ("read", read.json),
          ("write", write.json),
        ],
      ),
    )
  };
  if (entries.size() != 1) return Failure("cell-field-count");
  Success(
    jsonObj(
      Array[
        ("a", jsonStr("record")),
        ("fields", jsonArr(entries)),
        // Synthetic indexes are inference bookkeeping, excluded from
        // runtime field lookup. Record their presence, not their TVars.
        (
          "indexes",
          jsonObj(
            Array[
              (
                "string",
                jsonStr(
                  if (fields.stringIndex.isSome()) "synthetic" else {
                    "absent"
                  },
                ),
              ),
              (
                "number",
                jsonStr(
                  if (fields.numberIndex.isSome()) "synthetic" else {
                    "absent"
                  },
                ),
              ),
              (
                "symbol",
                jsonStr(
                  if (fields.symbolIndex.isSome()) "synthetic" else {
                    "absent"
                  },
                ),
              ),
            ],
          ),
        ),
        (
          "call",
          jsonStr(
            callMode match {
            | Some(mode) -> mode
            | None() -> "unknown"
            },
          ),
        ),
        (
          "construct",
          jsonStr(
            newMode match {
            | Some(mode) -> mode
            | None() -> "unknown"
            },
          ),
        ),
        (
          "array",
          jsonStr(if (fields.isArray == Some(false)) "absent" else "unknown"),
        ),
      ],
    ),
  )
}

// One free unary call signature with primitive operands. No methods, generics,
// optional/rest parameters, object fields or construct requirements are erased.
fun claimFunctionBranchJson(
  fields: TFields,
  values: SortedMap<TVarID, SubstValue>,
  fuel: Int,
): Result<String, String> {
  if (!fields.fields.isEmpty() || !fields.symbolFields.isEmpty()) {
    return Failure("function-has-fields")
  };
  if (
    fields.stringIndex.isSome() ||
    fields.numberIndex.isSome() ||
    fields.symbolIndex.isSome()
  ) {
    return Failure("function-index-signature")
  };
  if (fields.isArray == Some(true)) return Failure("function-is-array");
  if (!(fields.new is CAbsent() || fields.new is CUnknown())) {
    return Failure("function-constructible")
  };
  fields.call match {
  | CPresent(TFuns(f, _)) ->
    if (!f.tparams.isEmpty()) return Failure("function-generic");
    if (!(f.thisParam is NoThis())) return Failure("function-this-parameter");
    if (!f.optionalParams.isEmpty()) {
      return Failure("function-optional-parameter")
    };
    if (f.spreadParam.isSome()) return Failure("function-rest-parameter");
    if (f.params.size() != 1) return Failure("function-arity");
    arg = claimTypeJsonBounded(f.params[0], false, values, fuel);
    if (arg.reason != "") return Failure(arg.reason);
    ret = claimTypeJsonBounded(f.retType, false, values, fuel);
    if (ret.reason != "") return Failure(ret.reason);
    Success(
      jsonObj(
        Array[
          ("a", jsonStr("function")),
          ("params", jsonArr(Array[arg.json])),
          ("result", ret.json),
          (
            "construct",
            jsonStr(if (fields.new is CAbsent()) "absent" else "unknown"),
          ),
          (
            "array",
            jsonStr(
              if (fields.isArray == Some(false)) "absent" else {
                "unknown"
              },
            ),
          ),
        ],
      ),
    )
  | CFunction() -> Failure("function-without-signature")
  | _ -> Failure("not-callable")
  }
}

/***************************************************************************/
/* Type-claim serialization. */
/***************************************************************************/

fun claimPosJson(pos: PosRange, symbols: Map<SymbolicPos, Int>): String {
  `[${pos.getStart(symbols).value}, ${pos.getEnd(symbols).value}]`
}

// Addresses are scoped to this function's name/namePos. Only failed exports
// contribute metadata; successful function fallback must never carry a refusal.
fun claimTypeAtJson(
  ty: TType,
  values: SortedMap<TVarID, SubstValue>,
  address: Array<(String, String)>,
  unavailable: mutable Vector<String>,
): String {
  result = claimTypeJsonBounded(ty, true, values, 64);
  if (result.reason != "") {
    unavailable.push(
      jsonObj(address.concat(Array[("reason", jsonStr(result.reason))])),
    )
  };
  result.json
}

fun funTypeClaimsJson(
  fc: FunTypeClaims,
  symbols: Map<SymbolicPos, Int>,
): String {
  unavailable = mutable Vector<String>[];
  fields = Array[
    ("name", jsonStr(fc.name)),
    ("namePos", claimPosJson(fc.namePos, symbols)),
    (
      "collection",
      jsonObj(
        Array[
          (
            "completion",
            jsonStr(
              if (fc.aborted) {
                "aborted"
              } else {
                "complete"
              },
            ),
          ),
          (
            "quality",
            jsonStr(
              if (fc.recovered) {
                "recovery"
              } else {
                "unverified"
              },
            ),
          ),
          ("mode", jsonStr(fc.mode)),
          (
            "visitedExpressions",
            jsonArr(fc.visitedExpressions.map(p -> claimPosJson(p, symbols))),
          ),
        ],
      ),
    ),
    (
      "params",
      jsonArr(
        fc.params.map(p ->
          jsonObj(
            Array[
              ("name", jsonStr(p.name)),
              (
                "type",
                claimTypeAtJson(
                  p.type,
                  fc.substValues,
                  Array[
                    ("kind", jsonStr("parameter")),
                    ("binding", jsonStr(p.name)),
                  ],
                  unavailable,
                ),
              ),
            ],
          )
        ),
      ),
    ),
    (
      "retType",
      claimTypeAtJson(
        fc.retType,
        fc.substValues,
        Array[("kind", jsonStr("result"))],
        unavailable,
      ),
    ),
    (
      "envs",
      jsonArr(
        fc.envs.map(e ->
          jsonObj(
            Array[
              ("pos", claimPosJson(e.pos, symbols)),
              (
                "vars",
                jsonArr(
                  e.vars.map(v -> {
                    base = Array[
                      ("name", jsonStr(v.name)),
                      ("mutable", if (v.isMutable) "true" else "false"),
                      (
                        "type",
                        claimTypeAtJson(
                          v.type,
                          fc.substValues,
                          Array[
                            ("kind", jsonStr("entry")),
                            ("pos", claimPosJson(e.pos, symbols)),
                            ("binding", jsonStr(v.name)),
                          ],
                          unavailable,
                        ),
                      ),
                    ];
                    declared = v.declaredType match {
                    | Some(d) ->
                      Array[
                        (
                          "declared",
                          claimTypeAtJson(
                            d,
                            fc.substValues,
                            Array[
                              ("kind", jsonStr("declared")),
                              ("pos", claimPosJson(e.pos, symbols)),
                              ("binding", jsonStr(v.name)),
                            ],
                            unavailable,
                          ),
                        ),
                      ]
                    | None() -> Array[]
                    };
                    jsonObj(base.concat(declared))
                  }),
                ),
              ),
            ],
          )
        ),
      ),
    ),
    (
      "exprs",
      jsonArr(
        fc.exprs.map(x ->
          jsonObj(
            Array[
              ("pos", claimPosJson(x.pos, symbols)),
              (
                "type",
                claimTypeAtJson(
                  x.type,
                  fc.substValues,
                  Array[
                    ("kind", jsonStr("expression")),
                    ("pos", claimPosJson(x.pos, symbols)),
                  ],
                  unavailable,
                ),
              ),
            ],
          )
        ),
      ),
    ),
    (
      "lvalues",
      jsonArr(
        fc.lvalues.map(x ->
          jsonObj(
            Array[
              ("pos", claimPosJson(x.pos, symbols)),
              (
                "type",
                claimTypeAtJson(
                  x.type,
                  fc.substValues,
                  Array[
                    ("kind", jsonStr("lvalue")),
                    ("pos", claimPosJson(x.pos, symbols)),
                  ],
                  unavailable,
                ),
              ),
            ],
          )
        ),
      ),
    ),
  ];
  jsonObj(
    fields.concat(Array[("unavailableTypes", jsonArr(unavailable.toArray()))]),
  )
}

fun fileTypeClaimsJson(
  fileName: String,
  typeClaims: SortedMap<CGNode, FunTypeClaims>,
  symbols: Map<SymbolicPos, Int>,
): String {
  funs = mutable Vector<String>[];
  for (kv in typeClaims.items()) {
    funs.push(funTypeClaimsJson(kv.i1, symbols))
  };
  jsonObj(
    Array[("file", jsonStr(fileName)), ("functions", jsonArr(funs.toArray()))],
  )
}

module end;
