/*****************************************************************************/
/* Parser. */
/*****************************************************************************/

module SKJS;

mutable class Parser(lex: mutable Lexer, mutable id: Int = 1) {
  /***************************************************************************/
  // Helpers
  /***************************************************************************/

  readonly fun error<T>(pos: ErrorPos, kind: ParsingKind): T {
    error(ParsingError(pos, kind))
  }

  mutable fun expect(kind: TokenKind): void {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(kind))
    | Some(tok) if (tok.kind == kind) -> void
    | Some(tok) -> this.error(this.lex.posStart(tok), ExpectedTokenNot(kind))
    }
  }

  mutable fun expectStr(str: String): void {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedStrNot(str))
    | Some(tok) ->
      if (this.lex.isEqTok(tok, str)) void else {
        this.error(this.lex.posStart(tok), ExpectedStrNot(str))
      }
    }
  }

  mutable fun expectStringValue(): void {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedString())
    | Some(tok) ->
      tok.kind match {
      | TKQuote()
      | TKDoubleQuote()
      | TKBackTick() ->
        void
      | _ ->
        this.error(
          this.lex.posStart(tok),
          ExpectedStringNot(this.lex.getStrTok(tok)),
        )
      }
    }
  }

  /***************************************************************************/
  // <name> ::= <string>
  /***************************************************************************/

  mutable fun getName(): Name {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))
    | Some(tok) ->
      tok.kind match {
      | TKVar() -> Name(tok.posRange, this.lex.getStrTok(tok))
      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))
      }
    }
  }

  /***************************************************************************/
  // <string> | "<string>" | '<string>'
  /***************************************************************************/

  mutable fun getNameOrString(): Name {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))
    | Some(tok) ->
      tok.kind match {
      | TKQuote() ->
        Name(
          tok.posRange,
          this.lex.getStrTok(tok).stripPrefix("'").stripSuffix("'"),
        )
      | TKDoubleQuote() ->
        Name(
          tok.posRange,
          this.lex.getStrTok(tok).stripPrefix("\"").stripSuffix("\""),
        )
      | TKVar() -> Name(tok.posRange, this.lex.getStrTok(tok))
      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))
      }
    }
  }

  /***************************************************************************/
  // "<string>" | '<string>'
  /***************************************************************************/

  mutable fun getString(): Name {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))
    | Some(tok) ->
      tok.kind match {
      | TKQuote() ->
        Name(
          tok.posRange,
          this.lex.getStrTok(tok).stripPrefix("'").stripSuffix("'"),
        )
      | TKDoubleQuote() ->
        Name(
          tok.posRange,
          this.lex.getStrTok(tok).stripPrefix("\"").stripSuffix("\""),
        )
      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))
      }
    }
  }

  /***************************************************************************/
  // "<string>" | '<string>' | <int>
  /***************************************************************************/

  mutable fun getNameOrStringOrInt(): Name {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))
    | Some(tok) ->
      tok.kind match {
      | TKQuote() ->
        Name(
          tok.posRange,
          this.lex.getStrTok(tok).stripPrefix("'").stripSuffix("'"),
        )
      | TKDoubleQuote() ->
        Name(
          tok.posRange,
          this.lex.getStrTok(tok).stripPrefix("\"").stripSuffix("\""),
        )
      | TKSubtraction() ->
        start = tok.posRange.start;
        nbr = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
        | Some(x) -> x
        };
        Name(
          PosRange(this.lex.fileName, start, nbr.posRange.end),
          "-" + this.lex.getStrTok(nbr),
        )
      | TKNumber()
      | TKVar() ->
        Name(tok.posRange, this.lex.getStrTok(tok))
      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))
      }
    }
  }

  /***************************************************************************/
  // <symbol> ::=
  //   | <name>
  //   | <name>
  //   | <name> in <type> (? <type>)? (<fn-op>)?
  //   | <name> : <type>
  /***************************************************************************/

  mutable fun getSymbol(): Symbol {
    if (this.lex.peekKind() is Some(TKOpenSquare())) {
      _ = this.lex.next();
      if (
        this.lex.peekKind() is Some(TKQuote()) ||
        this.lex.peekKind() is Some(TKDoubleQuote()) ||
        this.lex.peekKind() is Some(TKSubtraction()) ||
        this.lex.peekKind() is Some(TKAddition())
      ) {
        name = this.getNameOrStringOrInt();
        this.expect(TKCloseSquare());
        FNNormal(name);
      } else {
        fname = this.getName();
        if (this.lex.isEq("in")) {
          _ = this.lex.next();
          ty = this.type(0);
          asOpt = if (this.lex.isEq("as")) {
            _ = this.lex.next();
            Some(this.type(0))
          } else {
            None()
          };
          this.expect(TKCloseSquare());
          op = if (this.lex.peekKind() is Some(TKRemoveQM())) {
            Some(FNRemove(this.lex.next().fromSome().posRange));
          } else if (this.lex.peekKind() is Some(TKAddQM())) {
            Some(FNAdd(this.lex.next().fromSome().posRange));
          } else if (this.lex.peekKind() is Some(TKQuestionMark())) {
            Some(FNQuestion(this.lex.next().fromSome().posRange))
          } else {
            None()
          };
          FNIn(fname, ty, asOpt, op)
        } else if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          ty = this.type(0);
          this.expect(TKCloseSquare());
          FNColon(fname, ty)
        } else {
          this.expect(TKCloseSquare());
          FNSymbol(fname);
        }
      }
    } else {
      FNNormal(this.getNameOrStringOrInt())
    }
  }

  /***************************************************************************/
  // <type_> ::=
  //   | " <string> "
  //   | ' <string> '
  //   | ` <string> `
  //   | true | false
  //   | <number>
  //   | <bigint>
  //   | <prim-kind>
  //   | typeof <expr>
  //   | <type> []
  //   | { <field-type>* }
  //   | <name> < <type>* >
  //   | <type> | <type>
  //   | <type> & <type>
  //   | [ <tuple-elt-type>* ]
  //   | function ( <ta-fun-param>* ) : <type>
  //   | <type> [ <type> ]
  //   | <type> extends <type> ? <type> : <type>
  //   | <type> extends <type>
  //   | readonly <type>
  //   | import ( <expr> , <name>? , <type>* )
  //   | infer <name>
  //   | []
  //   | keyof <type>
  //   | new <type>
  //   | abstract <type>
  //   | <type> is <type>
  //   | asserts <name>
  //   | <name> asserts <type>
  //   | unique symbol
  /***************************************************************************/

  mutable fun type(prec: Int): Type {
    inTypeCopy = this.lex.inType;
    this.lex.!inType = true;
    start = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedType())
    | Some(tok) -> tok.posRange.start
    };
    if (
      this.lex.peekKind() is Some(TKBitwiseOr()) ||
      this.lex.peekKind() is Some(TKBitwiseAnd())
    ) {
      _ = this.lex.next();
    };
    type = this.type_(prec);
    end = this.lex.lastTok.fromSome().posRange.end;
    this.lex.!inType = inTypeCopy;
    Type(PosRange(this.lex.fileName, start, end), type)
  }

  mutable fun type_(prec: Int): Type_ {
    tok = this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedType())
    | Some(x) -> x
    };
    left = tok.kind match {
    | TKQuote() -> TAStringLiteral(this.lex.getStrTok(tok))
    | TKDoubleQuote() -> TAStringLiteral(this.lex.getStrTok(tok))
    | TKBackTick() -> TATemplate(this.lex.getStrTok(tok))
    | TKBigInt() -> TABigIntLiteral(this.lex.getStrTok(tok))
    | TKNumber() -> TANumLiteral(this.lex.getStrTok(tok))
    | TKLessThan() ->
      tparams = this.typeParams();
      this.type(0) match {
      | Type(_, TAFun(isMethod, emptyTParams, params, retType)) ->
        if (emptyTParams.size() != 0) {
          invariant_violation("emptyTParams should be empty")
        };
        TAFun(isMethod, tparams, params, retType)
      | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())
      }
    | TKOpenSquare() ->
      if (this.lex.peekKind() is Some(TKCloseSquare())) {
        _ = this.lex.next();
        TAEmptyArray()
      } else {
        result = mutable Vector<TupleEltType>[];
        loop {
          if (this.lex.peekKind() is Some(TKDotDotDot())) {
            _ = this.lex.next();
            ty = this.type(0);
            if (this.lex.peekKind() is Some(TKColon())) {
              colonTok = this.lex.next().fromSome();
              ty.value match {
              | TAInst(n, targs) if (targs.size() == 0) ->
                result.push(TESpread(Some(n), this.type(0)))
              | _ -> this.error(this.lex.posStart(colonTok), UnexpectedToken())
              }
            } else {
              result.push(TESpread(None(), ty))
            };
          } else if ( // Named elements in a tuple
            this.lex.lookAhead(() -> {
              this.lex.peekKind() is Some(TKVar()) &&
                {
                  _ = this.lex.next();
                  this.lex.peekKind() is Some(TKColon()) ||
                    this.lex.peekKind() is Some(TKQuestionMark()) &&
                      {
                        _ = this.lex.next();
                        this.lex.peekKind() is Some(TKColon())
                      }
                }
            })
          ) {
            name = this.getName();
            optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
              Some(this.lex.next().fromSome().posRange)
            } else {
              None()
            };
            this.expect(TKColon());
            type = this.type(0);
            result.push(TEType(Some(name), optional, type));
          } else {
            type = this.type(0);
            optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
              Some(this.lex.next().fromSome().posRange)
            } else {
              None()
            };
            result.push(TEType(None(), optional, type));
          };
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedType())
          | Some(x) -> x
          };
          commaTok.kind match {
          | TKCloseSquare() -> break void
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKCloseSquare())) {
              _ = this.lex.next();
              break void
            }
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedTokenNot(TKCloseSquare()),
            )
          }
        };
        TATuple(result.toArray())
      }
    | TKOpenParen() ->
      if (this.isTypeFunParams()) {
        params = this.typeFunParams();
        this.expect(TKClosure());
        retType = this.type(0);
        TAFun(false, Array[], params, retType)
      } else {
        res = this.type(0).value;
        this.expect(TKCloseParen());
        res
      }
    | TKOpenCurly() -> TAObject(this.objectFields())
    | TKVar() ->
      this.lex.getStrTok(tok) match {
      | "typeof" -> TATypeOf(this.expr(typeOfPrec))
      | "import" ->
        this.expect(TKOpenParen());
        e = this.expr(0);
        this.expect(TKCloseParen());
        if (this.lex.peekKind() is Some(TKDot())) {
          this.expect(TKDot());
          name = this.getName();
          loop {
            if (this.lex.peekKind() != Some(TKDot())) break void;
            _ = this.lex.next();
            dotName = this.getName();
            !name = Name(
              PosRange(
                this.lex.fileName,
                name.posRange.start,
                dotName.posRange.end,
              ),
              name.value + "." + dotName.value,
            );
          };
          targs = if (this.lex.peekKind() is Some(TKLessThan())) {
            _ = this.lex.next();
            this.typeList()
          } else {
            Array[]
          };
          TAImport(e, Some(name), Some(targs))
        } else {
          TAImport(e, None(), None())
        }
      | "asserts" ->
        name = this.getName();
        if (this.lex.peekStr() is Some("is")) {
          _ = this.lex.next();
          TAAssertIs(name, this.type(0))
        } else {
          TAAsserts(name)
        }
      | "unique" ->
        this.expectStr("symbol");
        TAUniqueSymbol()
      | "null" -> TAPrim(TPKNull())
      | "number" -> TAPrim(TPKNum())
      | "boolean" -> TAPrim(TPKBool())
      | "string" -> TAPrim(TPKString())
      | "readonly" -> TAReadonly(this.type(prec))
      | "infer" -> TAInfer(this.getName())
      | "keyof" -> TAKeyOf(this.type(prec))
      | "abstract" -> TANew(this.type(prec))
      | "new" -> TANew(this.type(prec))
      | className ->
        name = Name(tok.posRange, className);
        loop {
          if (this.lex.peekKind() != Some(TKDot())) break void;
          _ = this.lex.next();
          dotName = this.getName();
          !name = Name(
            PosRange(
              this.lex.fileName,
              name.posRange.start,
              dotName.posRange.end,
            ),
            name.value + "." + dotName.value,
          );
        };
        targs = if (this.lex.peekKind() is Some(TKLessThan())) {
          _ = this.lex.next();
          this.typeList()
        } else {
          Array[]
        };
        TAInst(name, targs)
      }
    | TKSubtraction() ->
      numTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      numTok.kind match {
      | TKNumber() -> TANumLiteral("-" + this.lex.getStrTok(numTok))
      | _ -> this.error(this.lex.posStart(numTok), ExpectedTokenNot(TKNumber()))
      }
    | TKAddition() ->
      numTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      numTok.kind match {
      | TKNumber() -> TANumLiteral(this.lex.getStrTok(numTok))
      | _ -> this.error(this.lex.posStart(numTok), ExpectedTokenNot(TKNumber()))
      }
    | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())
    };

    loop {
      if (
        this.lex.lookAhead(() -> {
          pos = this.lex.pos;
          this.lex.peekKind() is Some(TKOpenSquare()) &&
            {
              _ = this.lex.next();
              if (this.lex.peekKind() is Some(TKCloseSquare())) return false;
              for (i in Range(pos, this.lex.pos)) {
                if (this.lex.contents[i] == '\n') return true;
              };
              false
            }
        })
      ) {
        break void;
      };
      if (this.lex.peekKind() is Some(TKOpenSquare())) {
        _ = this.lex.next();
        if (this.lex.peekKind() is Some(TKCloseSquare())) {
          _ = this.lex.next();
          leftRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          !left = TAArray(Type(leftRange, left));
          continue;
        };
        ty = this.type(0);
        leftRange = PosRange(
          this.lex.fileName,
          tok.posRange.start,
          this.lex.getLastPos(),
        );
        this.expect(TKCloseSquare());
        !left = TAGet(Type(leftRange, left), ty);
      } else {
        break void
      }
    };

    loop {
      this.lex.peekKind() match {
      | Some(TKVar()) if (this.lex.peekStr() == Some("is")) ->
        _ = this.lex.next();
        leftRange = PosRange(
          this.lex.fileName,
          tok.posRange.start,
          this.lex.getLastPos(),
        );
        !left = TAIs(Type(leftRange, left), this.type(0))
      | Some(TKVar()) if (this.lex.peekStr() is Some("extends")) ->
        (_assoc, assignPrec) = precedence[TKAssignment()];
        ternaryCondPrec = assignPrec + 1;
        if (prec >= ternaryCondPrec) return left;
        _ = this.lex.next();
        ty1 = this.type(ternaryCondPrec);
        if (this.lex.peekKind() is Some(TKQuestionMark())) {
          this.expect(TKQuestionMark());
          ty2 = this.type(0);
          this.expect(TKColon());
          ty3 = this.type(assignPrec);
          leftRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          !left = TAExtendsQuestion(Type(leftRange, left), ty1, ty2, ty3);
        } else {
          leftRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          !left = TAExtends(Type(leftRange, left), ty1);
        };
        continue
      | Some(bop @ TKBitwiseOr())
      | Some(bop @ TKBitwiseAnd()) ->
        isType = bop match {
        | TKBitwiseOr() -> true
        | TKBitwiseAnd() -> false
        | _ -> invariant_violation("Internal error")
        };
        (assoc, bopPrec) = precedence[bop];
        if (!(assoc is ALeft())) invariant_violation("assoc should be ALeft");
        if (bopPrec == prec) {
          leftRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          right = this.type(prec + 1);
          !left = isType match {
          | true -> TAUnion(Type(leftRange, left), right)
          | false -> TAInter(Type(leftRange, left), right)
          };
          continue;
        };
        if (bopPrec > prec) {
          leftRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          right = this.type(bopPrec);
          !left = isType match {
          | true -> TAUnion(Type(leftRange, left), right)
          | false -> TAInter(Type(leftRange, left), right)
          };
          continue;
        };
        if (bopPrec >= prec) {
          invariant_violation("bopPrec should be less than prec")
        };
        return left
      | _ -> return left
      }
    }
  }

  mutable fun isTypeFunParams(): Bool {
    this.lex.lookAhead(() -> {
      countParen = 1;
      loop {
        this.lex.next().map(x -> x.kind) match {
        | None() -> return false
        | Some(TKOpenParen()) -> !countParen = countParen + 1
        | Some(TKCloseParen()) ->
          !countParen = countParen - 1;
          if (countParen == 0) {
            return this.lex.peekKind() is Some(TKClosure())
          }
        | Some _ -> continue
        }
      }
    })
  }

  mutable fun typeFunParams(): Array<TAFunParam> {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return Array[];
    };
    result = mutable Vector[];
    loop {
      tok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      tok.kind match {
      | TKDotDotDot() ->
        _ = this.lex.next();
        !tok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedType())
        | Some(x) -> x
        };
        if (this.lex.peekKind() is Some(TKQuestionMark())) {
          qm = this.lex.next().fromSome();
          this.expect(TKColon());
          type = this.type(0);
          result.push(
            TAFunParam(
              Some(TAParamSpread(Name(tok.posRange, this.lex.getStrTok(tok)))),
              Some(qm.posRange),
              type,
            ),
          );
        } else if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          type = this.type(0);
          result.push(
            TAFunParam(
              Some(TAParamSpread(Name(tok.posRange, this.lex.getStrTok(tok)))),
              None(),
              type,
            ),
          );
        } else {
          this.error(this.lex.posStart(tok), UnexpectedToken())
        }
      | TKOpenCurly() ->
        _ = this.lex.next();
        curlyNames = mutable Vector[];
        spread: ?Name = None();
        loop {
          if (this.lex.peekKind() is Some(TKDotDotDot())) {
            _ = this.lex.next();
            !spread = Some(this.getName());
            if (this.lex.peekKind() is Some(TKComma())) {
              _ = this.lex.next();
            };
            this.expect(TKCloseCurly());
            break void;
          };
          name = this.getName();
          if (this.lex.peekKind() is Some(TKColon())) {
            _ = this.lex.next();
            type = this.type(0);
            curlyNames.push(CurlyName(name, Some(type)))
          } else {
            curlyNames.push(CurlyName(name, None()))
          };
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedType())
          | Some(x) -> x
          };
          commaTok.kind match {
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKCloseCurly())) {
              _ = this.lex.next();
              break void
            }
          | TKCloseCurly() -> break void
          | _ -> this.error(this.lex.posStart(commaTok), UnexpectedToken())
          }
        };
        qm = if (this.lex.peekKind() is Some(TKQuestionMark())) {
          Some(this.lex.next().fromSome().posRange)
        } else {
          None()
        };
        this.expect(TKColon());
        type = this.type(0);
        result.push(
          TAFunParam(
            Some(TACurlyNames(curlyNames.toArray(), spread)),
            qm,
            type,
          ),
        )
      | _ ->
        if (
          this.lex.lookAhead(() -> {
            _ = this.lex.next();
            this.lex.peekKind() is Some(TKQuestionMark()) ||
              this.lex.peekKind() is Some(TKColon())
          })
        ) {
          paramName = this.getName();
          if (this.lex.peekKind() is Some(TKQuestionMark())) {
            qm = this.lex.next().fromSome();
            this.expect(TKColon());
            type = this.type(0);
            result.push(
              TAFunParam(Some(TAParamName(paramName)), Some(qm.posRange), type),
            );
          } else {
            if (!(this.lex.peekKind() is Some(TKColon()))) {
              invariant_violation("expected TKColon")
            };
            _ = this.lex.next();
            type = this.type(0);
            result.push(TAFunParam(Some(TAParamName(paramName)), None(), type));
          }
        } else {
          type = this.type(0);
          result.push(TAFunParam(None(), None(), type))
        }
      };
      tokComma = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      tokComma.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          return result.toArray()
        }
      | TKCloseParen() -> return result.toArray()
      | _ ->
        this.error(
          this.lex.posStart(tokComma),
          ExpectedTokenNot(TKCloseParen()),
        )
      }
    }
  }

  mutable fun typeList(): Array<Type> {
    result = mutable Vector[];
    loop {
      result.push(this.type(0));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKGreaterThan() -> return result.toArray()
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKGreaterThan())) {
          _ = this.lex.next();
          return result.toArray()
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKGreaterThan()),
        )
      }
    }
  }

  /***************************************************************************/
  // <modifier> =
  //   | protected
  //   | private
  //   | public
  //   | static
  //   | abstract
  //   | readonly
  /***************************************************************************/

  mutable fun modifiers(isRemove: ?PosRange): Modifiers {
    modifiers = mutable Vector[];
    loop {
      if (
        isRemove is None() &&
        this.lex.lookAhead(() -> {
          _ = this.lex.next();
          !(this.lex.peekKind() is Some(TKVar()))
        })
      ) break void;
      this.lex.peekStr() match {
      | Some(x @ "protected")
      | Some(x @ "private")
      | Some(x @ "public")
      | Some(x @ "static")
      | Some(x @ "abstract")
      | Some(x @ "readonly") ->
        nameTok = this.lex.next().fromSome();
        modifiers.push(Name(nameTok.posRange, x))
      | _ -> break void
      }
    };
    map = mutable Map[];
    for (modifier in modifiers) {
      map![modifier.value] = modifier;
    };
    Modifiers(isRemove, map.chill())
  }

  /***************************************************************************/
  // Recognizes get/set modifiers. In JS, it is legal to write something like:
  // obj = {
  //    get myfield() { ... some code ... }
  // };
  //
  // When you do that, it means that the method "myfield" will be
  // called every time the field "myfield" is accessed. So concretely,
  // if you write obj.myfield, instead of accessing a field, you are
  // really executing a method.
  /***************************************************************************/

  mutable fun isGetSet(): ?FieldGetSet {
    if (
      this.lex.peekStr() is Some("get") ||
      this.lex.peekStr() is Some("set")
    ) {
      kind = if (this.lex.peekStr() is Some("get")) FGet() else FSet();
      isGetterOrSetter = this.lex.lookAhead(() -> {
        _ = this.lex.next();
        this.lex.next().map(x -> x.kind) is Some(TKVar());
      });
      if (isGetterOrSetter) {
        Some(FieldGetSet(kind, this.lex.next().fromSome().posRange))
      } else {
        None()
      }
    } else {
      None()
    }
  }

  /***************************************************************************/
  // Parses fields that are not methods.
  // <field> ::= <name> : <expr> | ... <expr>
  /***************************************************************************/

  mutable fun getNormalFieldType(
    fieldPos: PosRange,
    modifiers: Modifiers,
    fieldGetSet: ?FieldGetSet,
    fieldName: Symbol,
    isOptional: ?PosRange,
  ): FieldType {
    fieldValue = if (this.lex.peekKind() is Some(TKAssignment())) {
      _ = this.lex.next();
      Some(this.expr(0))
    } else {
      None()
    };
    fieldType = if (this.lex.peekKind() is Some(TKColon())) {
      this.expect(TKColon());
      Some(this.type(0))
    } else {
      None()
    };
    if (this.lex.peekKind() is Some(TKAssignment())) {
      eqTok = this.lex.next().fromSome();
      if (fieldValue is Some _) {
        this.error(this.lex.posStart(eqTok), UnexpectedToken())
      };
      !fieldValue = Some(this.expr(0));
    };
    FieldTypeValue{
      pos => fieldPos,
      setGet => fieldGetSet,
      modifiers,
      name => fieldName,
      optional => isOptional,
      type => fieldType,
      value => fieldValue,
    }
  }

  mutable fun getFieldType(modifiers: Modifiers): FieldType {
    fieldGetSet = this.isGetSet();
    fieldName = this.getSymbol();
    fieldPos = PosRange(
      this.lex.fileName,
      this.lex.getLastPos(),
      this.lex.getLastPos(),
    );
    isOptional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
      tok = this.lex.next().fromSome();
      Some(tok.posRange);
    } else {
      None()
    };
    if (
      this.lex.peekKind() is Some(TKOpenParen()) ||
      this.lex.peekKind() is Some(TKLessThan())
    ) {
      this.methodDef(
        None(),
        modifiers,
        fieldGetSet,
        fieldName,
        true,
        isOptional,
      )
    } else {
      this.getNormalFieldType(
        fieldPos,
        modifiers,
        fieldGetSet,
        fieldName,
        isOptional,
      )
    }
  }

  mutable fun objectFields(): Array<FieldType> {
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Array[];
    };
    fields = mutable Vector<FieldType>[];
    loop {
      removeModifiers = if (this.lex.peekKind() is Some(TKSubtraction())) {
        Some(this.lex.next().fromSome().posRange)
      } else {
        None()
      };
      modifiers = this.modifiers(removeModifiers);
      if (
        this.lex.peekKind() is Some(TKOpenParen()) ||
        this.lex.peekKind() is Some(TKLessThan())
      ) {
        method = this.anonMethodDef(
          None(),
          modifiers,
          None(),
          None(),
          false,
          None(),
        );
        fields.push(method);
      } else {
        field = this.getFieldType(modifiers);
        fields.push(field)
      };
      semiTok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      semiTok.kind match {
      | TKCloseCurly() ->
        _ = this.lex.next();
        break void
      | TKComma()
      | TKSemi() ->
        _ = this.lex.next();
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ -> void
      }
    };
    fields.toArray()
  }

  /***************************************************************************/
  // <def> ::=
  //   | <expr>
  //   | type <name> [ <type-param>* ] <type>
  //   | class
  //   | enum <name> { (<name> = <expr>?)* }
  //   | namespace <name> { <def>* }
  //   | module <name> { <def>* }
  //   | export (type? <module-names> from <expr>?)
  //   | export (type? default?) <def>
  //   | export default (type?) <expr>
  //   | export = <expr>
  //   | export as <name>
  //   | export import <name> = <expr>
  //   | global { <def>* }
  //   | import (type?) <module-names> <import-name> (from <import-kind>)
  //   | import <name>
  //   | declare <def>
  //   | <var-def-kind> { <var-def>* }
  /***************************************************************************/

  mutable fun def(): Def {
    while (this.lex.peekKind() is Some(TKSemi())) {
      _ = this.lex.next();
    };
    this.defHelper()
  }

  mutable fun toplevelDefs(): Array<Def> {
    defs = mutable Vector[];
    loop {
      this.maybeDef() match {
      | None() -> return defs.toArray()
      | Some(def) -> defs.push(def)
      }
    }
  }

  mutable fun defs(): Array<Def> {
    this.expect(TKOpenCurly());
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Array[]
    };
    defs = mutable Vector[];
    loop {
      def = this.def();
      defs.push(def);
      loop {
        if (this.lex.peekKind() is Some(TKSemi())) {
          _ = this.lex.next();
          continue;
        };
        break void;
      };
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        break defs.toArray()
      }
    }
  }

  mutable fun maybeDef(): ?Def {
    while (this.lex.peekKind() is Some(TKSemi())) {
      _ = this.lex.next();
    };
    if (this.lex.peekKind() is None()) return None();
    Some(this.def())
  }

  mutable fun defHelper(): Def {
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
    | Some(x) -> x
    };
    start = tok.posRange.start;
    def_ = this.defHelper_();
    end = this.lex.lastTok.fromSome().posRange.end;
    Def(PosRange(this.lex.fileName, start, end), def_)
  }

  mutable fun defHelper_(): Def_ {
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
    | Some(x) -> x
    };
    this.lex.getStrTok(tok) match {
    | "declare" ->
      _ = this.lex.next();
      def = this.def();
      Declare(def)
    | "global" ->
      _ = this.lex.next();
      Global(this.defs())
    | "namespace" ->
      _ = this.lex.next();
      name = this.getName();
      defs = this.defs();
      Namespace(name, defs)
    | "import" ->
      _ = this.lex.next();
      isType = if (this.lex.peekStr() == Some("type")) {
        Some(this.lex.next().fromSome().posRange)
      } else {
        None()
      };
      if (
        this.lex.peekKind() is Some(TKDoubleQuote()) ||
        this.lex.peekKind() is Some(TKQuote())
      ) {
        nameTok = this.lex.next().fromSome();
        ImportExpr(Name(nameTok.posRange, this.lex.getStrTok(nameTok)));
      } else {
        importNames = this.moduleNames();
        if (this.lex.isEq("from")) {
          _ = this.lex.next();
          importFrom = this.getString();
          Import(IKFrom(), isType, importNames, INPath(importFrom))
        } else {
          this.expect(TKAssignment());
          if (this.lex.peekStr() is Some("require")) {
            this.expectStr("require");
            this.expect(TKOpenParen());
            name = this.getString();
            this.expect(TKCloseParen());
            Import(IKEq(), isType, importNames, INPath(name))
          } else {
            dotName = this.getName();
            Import(IKEq(), isType, importNames, INName(dotName))
          }
        }
      }
    | "export" ->
      _ = this.lex.next();
      if (this.lex.isEq("import")) {
        _ = this.lex.next();
        name = this.getName();
        this.expect(TKAssignment());
        e = this.expr(0);
        return ExportImport(name, e);
      };
      if (this.lex.isEq("as")) {
        _ = this.lex.next();
        this.expectStr("namespace");
        return ExportAs(this.getName());
      };
      if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        return ExportEq(this.expr(0));
      };
      isType = if (this.lex.peekStr() is Some("type")) {
        if (
          this.lex.lookAhead(() -> {
            _ = this.lex.next();
            this.lex.next().map(x -> x.kind) is Some(TKVar()) &&
              (this.lex.peekKind() is Some(TKAssignment()) ||
                this.lex.peekKind() is Some(TKLessThan()))
          })
        ) {
          None()
        } else {
          Some(this.lex.next().fromSome().posRange)
        }
      } else {
        None()
      };
      if (
        this.lex.peekKind() is Some(TKOpenCurly()) ||
        this.lex.peekKind() is Some(TKMultiplication())
      ) {
        names = this.moduleNames();
        maybeFrom = if (this.lex.isEq("from")) {
          _ = this.lex.next();
          Some(this.expr(0))
        } else {
          None()
        };
        ExportNames(isType, names, maybeFrom)
      } else {
        default = if (this.lex.peekStr() is Some("default")) {
          Some(this.lex.next().fromSome().posRange)
        } else {
          None()
        };
        this.lex.peekStr() match {
        | Some("function") ->
          if (
            this.lex.lookAhead(() -> {
              _ = this.lex.next();
              this.lex.peekKind() is Some(TKOpenParen()) ||
                this.lex.peekKind() is Some(TKLessThan())
            })
          ) {
            _ = this.lex.next();
            Export(
              isType,
              default,
              this.anonMethodDef(
                None(),
                Modifiers::empty(),
                None(),
                None(),
                true,
                None(),
              ),
            )
          } else {
            Export(isType, default, this.def().value)
          }
        | Some("async")
        | Some("namespace")
        | Some("declare")
        | Some("module")
        | Some("enum")
        | Some("class")
        | Some("const")
        | Some("interface")
        | Some("let")
        | Some("var")
        | Some("abstract")
        | Some("type") ->
          def = this.def();
          Export(isType, default, def.value)
        | _ ->
          if (default is None()) {
            this.error(this.lex.posStart(tok), UnexpectedToken())
          };
          e = this.expr(0);
          ExportDefault(isType, e)
        }
      }
    | "async" ->
      asyncTok = this.lex.next().fromSome();
      this.expectStr("function");
      this.funDef(Some(asyncTok.posRange), true)
    | "function" ->
      _ = this.lex.next();
      this.funDef(None(), true)
    | "type" ->
      _ = this.lex.next();
      this.typeDef()
    | "var" ->
      _ = this.lex.next();
      this.varDef(VDKVar())
    | "const" ->
      _ = this.lex.next();
      if (this.lex.peekStr() is Some("enum")) {
        posRange = this.lex.next().fromSome().posRange;
        this.enum(Some(posRange))
      } else {
        this.varDef(VDKConst())
      }
    | "module" ->
      _ = this.lex.next();
      name = this.getNameOrString();
      defs = if (this.lex.peekKind() is Some(TKOpenCurly())) {
        Some(this.defs())
      } else {
        None()
      };
      Module(name, defs)
    | "abstract" ->
      _ = this.lex.next();
      this.expectStr("class");
      this.class_(CKAbstract())
    | "enum" ->
      _ = this.lex.next();
      this.enum(None())
    | "interface" ->
      _ = this.lex.next();
      this.class_(CKInterface())
    | "class" ->
      _ = this.lex.next();
      this.class_(CKClass())
    | "let" ->
      _ = this.lex.next();
      this.varDef(VDKLet())
    | _ -> ToplevelExpr(this.expr(0))
    }
  }

  mutable fun moduleNames(): ModuleNames {
    if (this.lex.peekKind() is Some(TKMultiplication())) {
      _ = this.lex.next();
      asName = if (this.lex.peekStr() is Some("as")) {
        _ = this.lex.next();
        Some(this.getName())
      } else {
        None()
      };
      MStar(asName)
    } else if (this.lex.peekKind() is Some(TKOpenCurly())) {
      _ = this.lex.next();
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        MCurly(Array[]);
      } else {
        names = this.curlyNames();
        MCurly(names)
      }
    } else {
      name = this.getName();
      curlyNames = if (this.lex.peekKind() is Some(TKComma())) {
        _ = this.lex.next();
        this.expect(TKOpenCurly());
        this.curlyNames();
      } else {
        Array[]
      };
      MName(name, curlyNames);
    }
  }

  mutable fun curlyNames(): Array<ModuleDefName> {
    names = mutable Vector[];
    loop {
      isType = if (
        this.lex.lookAhead(() -> {
          this.lex.peekStr() is Some("type") &&
            {
              _ = this.lex.next();
              this.lex.peekKind() is Some(TKVar())
            }
        })
      ) {
        Some(this.lex.next().fromSome().posRange)
      } else {
        None()
      };
      name = this.getName();
      asName = if (this.lex.isEq("as")) {
        _ = this.lex.next();
        Some(this.getName())
      } else {
        None()
      };
      names.push(ModuleDefName(isType, name, asName));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedImport())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseCurly() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKCloseCurly()),
        )
      }
    };
    names.toArray()
  }

  /***************************************************************************/
  // <pattern> ::=
  //   | <name>
  //   | <pattern> ::= [ <pattern>* ]
  //   | <pattern> ::= { (<name> : <pattern>)* }
  /***************************************************************************/

  mutable fun pattern(): Pattern {
    start = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
    | Some(x) -> x
    };
    pat_ = this.pattern_();
    Pattern(
      PosRange(
        this.lex.fileName,
        start.posRange.start,
        this.lex.lastTok.fromSome().posRange.end,
      ),
      pat_,
    )
  }

  mutable fun pattern_(): Pattern_ {
    this.lex.peekKind() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
    | Some(TKOpenSquare()) ->
      _ = this.lex.next();
      if (this.lex.peekKind() is Some(TKCloseSquare())) {
        _ = this.lex.next();
        return PArray(Array[])
      };
      pats = mutable Vector[];
      loop {
        pats.push(this.pattern());
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseSquare())) {
            _ = this.lex.next();
            break void;
          }
        | TKCloseSquare() -> break void
        | _ -> this.error(this.lex.posStart(commaTok), UnexpectedToken())
        }
      };
      PArray(pats.toArray())
    | Some(TKOpenCurly()) ->
      _ = this.lex.next();
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        return PObject(Array[])
      };
      fields = mutable Vector[];
      loop {
        fieldName = this.getName();
        fieldPat = if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          Some(this.pattern());
        } else {
          None()
        };
        fields.push(
          (
            fieldName,
            fieldPat match {
            | None() -> Pattern(fieldName.posRange, PVar(fieldName))
            | Some(x) -> x
            },
          ),
        );
        commaTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseCurly())) {
            _ = this.lex.next();
            break void;
          }
        | TKCloseCurly() -> break void
        | _ -> this.error(this.lex.posStart(commaTok), UnexpectedToken())
        }
      };
      PObject(fields.toArray().sortedBy(x ~> x.i0.value))
    | _ -> PVar(this.getName())
    }
  }

  /***************************************************************************/
  // <var-def> ::= <pattern> (: <type>)? (= <expr>)?
  /***************************************************************************/

  mutable fun varDef(kind: VarDefKind): VarDefs {
    defs = mutable Vector[];
    loop {
      pat = this.pattern();
      type = if (this.lex.peekKind() is Some(TKColon())) {
        this.expect(TKColon());
        Some(this.type(0));
      } else {
        None()
      };
      value = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        Some(this.expr(0));
      } else {
        None()
      };
      defs.push(VarDef(pat, type, value));
      commaTok = this.lex.peek() match {
      | None() -> break void
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKSemi() ->
        _ = this.lex.next();
        break void
      | TKComma() ->
        _ = this.lex.next();
        continue
      | _ -> break void
      }
    };
    VarDefs(kind, defs.toArray())
  }

  mutable fun typeDef(): TypeDef {
    name = this.getName();
    tdefParams = if (this.lex.peekKind() is Some(TKLessThan())) {
      _ = this.lex.next();
      this.typeDefsParams();
    } else {
      Array[]
    };
    this.expect(TKAssignment());
    body = this.type(0);
    if (this.lex.peekKind() is Some(TKSemi())) {
      _ = this.lex.next();
    };
    TypeDef{name, body, tdefParams}
  }

  mutable fun enum(isConst: ?PosRange): Enum {
    name = this.getName();
    this.expect(TKOpenCurly());
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Enum(isConst, name, Array[]);
    };
    fields = mutable Vector<(Name, ?Expr)>[];
    loop {
      fieldName = this.getNameOrString();
      fieldValue = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        Some(this.expr(0));
      } else {
        None()
      };
      fields.push((fieldName, fieldValue));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseCurly() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKCloseCurly()),
        )
      }
    };
    Enum(isConst, name, fields.toArray())
  }

  mutable fun class_(kind: ClassKind): Class {
    name = this.getName();
    tparams = if (this.lex.peekKind() is Some(TKLessThan())) {
      _ = this.lex.next();
      this.typeDefsParams();
    } else {
      Array[]
    };
    extends_ = if (this.lex.isEq("extends")) {
      _ = this.lex.next();
      extends_ = mutable Vector[];
      loop {
        ty = this.type(0);
        extends_.push(ty);
        if (this.lex.peekKind() is Some(TKComma())) {
          _ = this.lex.next();
        } else {
          break extends_.toArray()
        }
      }
    } else {
      Array[]
    };
    implements = if (this.lex.peekStr() is Some("implements")) {
      _ = this.lex.next();
      implements = mutable Vector[];
      loop {
        ty = this.type(0);
        implements.push(ty);
        if (this.lex.peekKind() is Some(TKComma())) {
          _ = this.lex.next();
        } else {
          break implements.toArray()
        }
      }
    } else {
      Array[]
    };
    this.expect(TKOpenCurly());
    fields = this.objectFields();
    Class{kind, name, extends_, implements, tparams, fields}
  }

  mutable fun typeDefsParams(): Array<TypeParam> {
    tdparams = mutable Vector[];
    loop {
      tok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      constr = this.lex.peekStr() match {
      | Some("extends") ->
        _ = this.lex.next();
        Some(this.type(0))
      | _ -> None()
      };
      default = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        ty = this.type(0);
        Some(ty)
      } else {
        None()
      };
      this.!id = this.id + 1;
      tdparams.push(
        TypeParam(
          this.id,
          Name(tok.posRange, this.lex.getStrTok(tok)),
          constr,
          default,
        ),
      );
      tokComma = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      tokComma.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKGreaterThan())) {
          _ = this.lex.next();
          return tdparams.toArray()
        }
      | TKGreaterThan() -> return tdparams.toArray()
      | _ ->
        this.error(
          this.lex.posStart(tokComma),
          ExpectedTokenNot(TKGreaterThan()),
        )
      }
    }
  }

  mutable fun typeParams(): Array<TypeParam> {
    result = mutable Vector[];
    loop {
      tparamName = this.getName();
      tparamType = if (this.lex.isEq("extends")) {
        _ = this.lex.next();
        ty = this.type(0);
        Some(ty)
      } else {
        None()
      };
      default = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        Some(this.type(0))
      } else {
        None()
      };
      this.!id = this.id + 1;
      result.push(TypeParam(this.id, tparamName, tparamType, default));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKGreaterThan())) {
          _ = this.lex.next();
          return result.toArray()
        }
      | TKGreaterThan() -> return result.toArray()
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKGreaterThan()),
        )
      }
    }
  }

  /***************************************************************************/
  // <fun-def> ::=
  //   (async?) <modifiers>? (get | set?)
  //     <symbol>? [ < <type-param>* > ]? ( <param>* )
  //       (: <type>?)
  //     <fun-def-body>
  /***************************************************************************/

  mutable fun funDef(isAsync: ?PosRange, parseBlock: Bool): FunDef {
    funName = this.getName();
    this.methodDef(
      isAsync,
      Modifiers::empty(),
      None(),
      FNNormal(funName),
      parseBlock,
      None(),
    )
  }

  mutable fun methodDef(
    isAsync: ?PosRange,
    modifiers: Modifiers,
    fieldGetSet: ?FieldGetSet,
    funName: Symbol,
    parseBlock: Bool,
    optional: ?PosRange,
  ): FunDef {
    this.anonMethodDef(
      isAsync,
      modifiers,
      fieldGetSet,
      Some(funName),
      parseBlock,
      optional,
    )
  }

  mutable fun anonMethodDef(
    isAsync: ?PosRange,
    methodModifiers: Modifiers,
    isGetSet: ?FieldGetSet,
    funName: ?Symbol,
    parseBlock: Bool,
    isOptional: ?PosRange,
  ): FunDef {
    funStart = this.lex.lastTok.fromSome().posRange.end;
    tparams = if (this.lex.peekKind() is Some(TKLessThan())) {
      _ = this.lex.next();
      this.typeParams();
    } else {
      Array[]
    };
    params = mutable Vector[];
    this.expect(TKOpenParen());
    this.lex.peekKind() match {
    | Some(TKCloseParen()) ->
      _ = this.lex.next();
      void
    | _ ->
      loop {
        modifiers = this.modifiers(None());
        start = this.lex.peek() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
        | Some(tok) -> tok.posRange.start
        };
        paramName = this.paramNames();
        end = this.lex.lastTok.fromSome().posRange.end;
        pos = PosRange(this.lex.fileName, start, end);
        optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
          Some(this.lex.next().fromSome().posRange)
        } else {
          None()
        };
        paramType = if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          Some(this.type(0))
        } else {
          None()
        };
        paramValue = if (this.lex.peekKind() is Some(TKAssignment())) {
          _ = this.lex.next();
          Some(this.expr(0))
        } else {
          None()
        };
        params.push(
          Param(pos, modifiers, paramName, optional, paramType, paramValue),
        );
        nextTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
        | Some(x) -> x
        };
        nextTok.kind match {
        | TKCloseParen() -> break void
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseParen())) {
            _ = this.lex.next();
            break void;
          }
        | _ ->
          this.error(
            this.lex.posStart(nextTok),
            ExpectedTokenNot(TKCloseParen()),
          )
        }
      }
    };
    retType = if (this.lex.peekKind() is Some(TKColon())) {
      this.expect(TKColon());
      retTypeTok = this.lex.peek();
      retType = this.type(0);
      retPos = PosRange(
        this.lex.fileName,
        retTypeTok.fromSome().posRange.start,
        this.lex.lastTok.fromSome().posRange.end,
      );
      (retPos, Some(retType))
    } else {
      start = this.lex.lastTok.fromSome().posRange.end;
      end = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
      | Some(x) -> x.posRange.start
      };
      (PosRange(this.lex.fileName, start, end), None())
    };
    body = if (parseBlock) {
      bodyTok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
      | Some(x) -> x
      };
      bodyTok.kind match {
      | TKOpenCurly() -> FDBSome(this.block())
      | _ -> FDBNone(bodyTok.posRange)
      }
    } else {
      FDBNone(this.lex.lastTok.fromSome().posRange)
    };
    funEnd = this.lex.lastTok.fromSome().posRange.end;
    FunDef{
      pos => PosRange(this.lex.fileName, funStart, funEnd),
      isAsync,
      modifiers => methodModifiers,
      tparams => tparams,
      isGetSet,
      name => funName,
      optional => isOptional,
      params => params.toArray(),
      retType,
      body,
    }
  }

  mutable fun paramNames(): ParamNames {
    if (this.lex.peekKind() is Some(TKOpenSquare())) {
      _ = this.lex.next();
      PNSquare(this.squareParamNames());
    } else if (this.lex.peekKind() is Some(TKOpenCurly())) {
      _ = this.lex.next();
      PNCurly(this.curlyParamNames())
    } else if (this.lex.peekKind() is Some(TKDotDotDot())) {
      _ = this.lex.next();
      PNDDD(this.getName())
    } else {
      name = this.getName();
      type = if (this.lex.peekKind() is Some(TKColon())) {
        _ = this.lex.next();
        Some(this.type(0))
      } else {
        None()
      };
      PNName(name, type)
    }
  }

  mutable fun squareParamNames(): Array<ParamNames> {
    if (this.lex.peekKind() is Some(TKCloseSquare())) return Array[];
    names = mutable Vector[];
    loop {
      names.push(this.paramNames());
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseSquare())) {
          _ = this.lex.next();
          break void;
        }
      | TKCloseSquare() -> break void
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKCloseSquare()),
        )
      }
    };
    names.toArray()
  }

  mutable fun curlyParamNames(): Array<ParamNames> {
    if (this.lex.peekKind() is Some(TKCloseCurly())) return Array[];
    names = mutable Vector[];
    loop {
      names.push(this.paramNames());
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void;
        }
      | TKCloseCurly() -> break void
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKCloseSquare()),
        )
      }
    };
    names.toArray()
  }

  mutable fun block(): Array<Stmt> {
    (this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedBlock())
    | Some(x) -> x
    }).kind match {
    | TKOpenCurly() ->
      _ = this.lex.next();
      stmts = mutable Vector[];
      loop {
        this.stmt() match {
        | None() ->
          this.expect(TKCloseCurly());
          return stmts.toArray()
        | Some(st) -> stmts.push(st)
        }
      }
    | _ ->
      this.stmt() match {
      | None() -> Array[]
      | Some(x) -> Array[x]
      }
    }
  }

  /***************************************************************************/
  // <stmt_> ::=
  //   | ;
  //   | <expr>
  //   | return <expr>?
  //   | throw <expr>
  //   | if ( <expr> ) <stmt>* (else <stmt>*)?
  //   | for ( <stmt> in <expr> ) <stmt>*
  //   | for ( <stmt> of <expr> ) <stmt>*
  //   | for ( <stmt> ; <expr> ; <expr> ) <stmt>*
  //   | while ( <expr> ) <stmt>*
  //   | let <binding>*
  //   | var <binding>*
  //   | const <binding>*
  //   | switch ( <expr> ) { <switch-branch>* }
  //   | { <stmt>* }
  /***************************************************************************/

  mutable fun stmt(): ?Stmt {
    start = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
    | Some(tok) -> tok.posRange.start
    };
    result = this.stmt_();
    end = this.lex.lastTok.fromSome().posRange.end;
    result match {
    | None() -> None()
    | Some(x) -> Some(Stmt(PosRange(this.lex.fileName, start, end), x))
    }
  }

  mutable fun stmt_(): ?Stmt_ {
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
    | Some(x) -> x
    };
    tok.kind match {
    | TKCloseCurly() -> None()
    | TKSemi() ->
      _ = this.lex.next();
      Some(StmtEmpty())
    | TKOpenCurly() ->
      _ = this.lex.next();
      stmts = mutable Vector[];
      loop {
        this.stmt() match {
        | None() -> break void
        | Some(st) -> stmts.push(st)
        }
      };
      this.expect(TKCloseCurly());
      Some(Block(stmts.toArray()))
    | TKVar() ->
      keyword = this.lex.getStrTok(tok);
      keyword match {
      | "break" ->
        _ = this.lex.next();
        Some(Break())
      | "switch" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        e = this.expr(0);
        this.expect(TKCloseParen());
        this.expect(TKOpenCurly());
        cases = mutable Vector<SwitchBranch>[];
        loop {
          caseTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
          | Some(x) -> x
          };
          this.lex.getStrTok(caseTok) match {
          | "case" ->
            value = this.expr(0);
            this.expect(TKColon());
            stmts = mutable Vector[];
            loop {
              this.stmt() match {
              | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
              | Some(st) -> stmts.push(st)
              };
              this.lex.peekStr() match {
              | Some("case")
              | Some("default")
              | Some("}") ->
                break void
              | _ -> void
              }
            };
            cases.push(Case(value, stmts.toArray()))
          | "default" ->
            this.expect(TKColon());
            stmts = mutable Vector[];
            loop {
              this.stmt() match {
              | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
              | Some(st) -> stmts.push(st)
              };
              this.lex.peekStr() match {
              | Some("case")
              | Some("default")
              | Some("}") ->
                break void
              | _ -> void
              }
            };
            cases.push(Default(stmts.toArray()))
          | "}" -> break void
          | _ -> this.error(this.lex.posStart(caseTok), UnexpectedToken())
          }
        };
        Some(Switch(e, cases.toArray()))
      | "if" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        e = this.expr(0);
        this.expect(TKCloseParen());
        ifBlock = this.block();
        elseBlock = this.lex.peekStr() match {
        | Some("else") ->
          _ = this.lex.next();
          Some(this.block())
        | _ -> None()
        };
        Some(If(e, ifBlock, elseBlock))
      | "return" ->
        retTok = this.lex.next().fromSome();
        if (
          this.lex.peekKind() is Some(TKSemi()) ||
          this.lex.peekKind() is Some(TKCloseCurly())
        ) {
          return Some(Return(retTok.posRange, None()));
        };
        Some(Return(retTok.posRange, Some(this.expr(0))))
      | "throw" ->
        _ = this.lex.next();
        Some(Throw(this.expr(0)))
      | "while" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        cond = this.expr(0);
        this.expect(TKCloseParen());
        if (this.lex.peekKind() is Some(TKOpenCurly())) {
          _ = this.lex.next();
          stmts = mutable Vector[];
          loop {
            this.stmt() match {
            | None() -> break void
            | Some(st) -> stmts.push(st)
            };
          };
          this.expect(TKCloseCurly());
          return Some(While(cond, stmts.toArray()));
        };
        this.stmt() match {
        | None() -> this.error(this.lex.posEnd(), ExpectedStmt())
        | Some(st) -> Some(While(cond, Array[st]))
        }
      | "for" ->
        _ = this.lex.next();
        this.expect(TKOpenParen());
        st = this.stmt() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
        | Some(x) -> x
        };
        inTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())
        | Some(x) -> x
        };
        inTok.kind match {
        | TKVar() if (this.lex.getStrTok(inTok) == "in") ->
          e = this.expr(0);
          this.expect(TKCloseParen());
          block = this.blockOrStmt();
          Some(ForIn(st, e, block))
        | TKVar() if (this.lex.getStrTok(inTok) == "of") ->
          e = this.expr(0);
          this.expect(TKCloseParen());
          block = this.blockOrStmt();
          Some(ForOf(st, e, block))
        | TKSemi() ->
          cond = this.expr(0);
          this.expect(TKSemi());
          incr = this.expr(0);
          this.expect(TKCloseParen());
          block = this.blockOrStmt();
          Some(For(st, cond, incr, block))
        | _ -> this.error(this.lex.posStart(inTok), ExpectedTokenNot(TKSemi()))
        }
      | bk @ "let"
      | bk @ "const"
      | bk @ "var" ->
        _ = this.lex.next();
        bkind = bk match {
        | "let" -> BKLet()
        | "const" -> BKConst()
        | "var" -> BKVar()
        | _ -> invariant_violation("Internal error")
        };
        bindings = mutable Vector[];
        loop {
          pat = this.pattern();
          type = if (this.lex.peekKind() is Some(TKColon())) {
            _ = this.lex.next();
            Some(this.type(0));
          } else {
            None()
          };
          e = if (this.lex.peekKind() is Some(TKAssignment())) {
            this.expect(TKAssignment());
            value = this.expr(0);
            Some(value)
          } else {
            None()
          };
          bindings.push(Binding(pat, type, e));
          if (this.lex.peekKind() is Some(TKComma())) {
            _ = this.lex.next();
          } else {
            break void
          }
        };
        Some(Bind(bkind, bindings.toArray()))

      | _ ->
        e = this.expr(0);
        Some(StmtExpr(e))
      }
    | _ -> Some(StmtExpr(this.expr(0)))
    }
  }

  mutable fun blockOrStmt(): Array<Stmt> {
    this.lex.peekKind() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKOpenCurly()))
    | Some(TKOpenCurly()) -> this.block()
    | _ ->
      this.stmt() match {
      | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKOpenCurly()))
      | Some(x) -> Array[x]
      }
    }
  }

  /***************************************************************************/
  // <expr> ::=
  //   | <string-number>
  //   | <name>
  //   | ... <name>
  //   | <string-kind> <string>
  //   | typeof <expr>
  //   | keyof <type>
  //   | await <expr>
  //   | <expr> [ <expr> ]
  //   | new <name> ( <type>* ) ( <expr>* )
  //   | <unop> <expr>
  //   | <expr> <post-op>
  //   | <expr> <binop> <expr>
  //   | <expr> ( <type>* ) ( <expr>* )
  //   | ( (<name> (: <type>)?)* )
  //   | { <field>* }
  //   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>
  //   | [ <expr>* ]
  //   | <expr> ? <expr> : <expr>
  //   | <expr> instanceof <expr>
  //   | <expr> as <type>
  //   | < <type> > <expr>
  //   | /<regexp>/
  //   | async <expr>
  /***************************************************************************/

  mutable fun expr(prec: Int): Expr {
    inTypeCopy = this.lex.inType;
    this.lex.!inType = false;
    start = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(tok) -> tok.posRange.start
    };
    e_ = this.expr_(prec);
    end = this.lex.lastTok.fromSome().posRange.end;
    this.lex.!inType = inTypeCopy;
    Expr(PosRange(this.lex.fileName, start, end), e_)
  }

  mutable fun expr_(prec: Int): Expr_ {
    tok = this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    left: Expr_ = tok.kind match {
    | TKNumber() -> Number(this.lex.getStrTok(tok))
    | TKTild() ->
      (_assoc, tildPrec) = precedence[TKTild()];
      Unop(UOTild(), this.expr(tildPrec))
    | TKDotDotDot() -> Spread(this.getName())
    | TKVar() ->
      str = this.lex.getStrTok(tok);
      str match {
      | "function" -> this.error(this.lex.posStart(tok), FunctionInExpr())
      | "new" ->
        name = this.getName();
        targs = if (this.lex.peekKind() is Some(TKLessThan())) {
          _ = this.lex.next();
          this.typeList()
        } else {
          Array[]
        };
        this.expect(TKOpenParen());
        args = this.arguments();
        New(name, targs, args)
      | "async" -> Async(this.expr(0))
      | "await" -> Await(this.expr(0))
      | "typeof" -> TypeOf(this.expr(typeOfPrec))
      | "keyof" -> KeyOf(this.type(prec))
      | _ -> Var(Name(tok.posRange, str))
      }
    | TKQuote() -> EString(SKQuote(), this.lex.getStrTok(tok))
    | TKDoubleQuote() -> EString(SKDoubleQuote(), this.lex.getStrTok(tok))
    | TKBackTick() -> EString(SKBackTick(), this.lex.getStrTok(tok))
    | TKOpenParen() ->
      if (this.lex.peekKind() is Some(TKCloseParen())) {
        _ = this.lex.next();
        Params(Array[])
      } else {
        first = this.expr_(0);
        firstTypeOpt = if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          Some(this.type(0))
        } else {
          None()
        };
        commaTok = this.lex.peek() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
        | Some(x) -> x
        };
        commaTok.kind match {
        | TKCloseParen() ->
          _ = this.lex.next();
          firstTypeOpt match {
          | None() -> first
          | Some _ ->
            firstName = first match {
            | Var(x) -> x
            | _ -> this.error(this.lex.posStart(commaTok), ExpectedVarName())
            };
            Params(Array[(firstName, firstTypeOpt)])
          }
        | TKComma() ->
          _ = this.lex.next();
          firstName = first match {
          | Var(x) -> x
          | _ -> this.error(this.lex.posStart(commaTok), ExpectedVarName())
          };
          params = mutable Vector[(firstName, firstTypeOpt)];
          loop {
            e = this.expr(0) match {
            | Expr(_, Var(x)) -> x
            | Expr(posRange, _) ->
              this.error(
                EPChar(this.lex.fileName, posRange.start),
                ExpectedVarName(),
              )
            };
            tyOpt = if (this.lex.peekKind() is Some(TKColon())) {
              _ = this.lex.next();
              Some(this.type(0))
            } else {
              None()
            };
            params.push((e, tyOpt));
            closeTok = this.lex.next() match {
            | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
            | Some(x) -> x
            };
            closeTok.kind match {
            | TKCloseParen() -> break void
            | TKComma() ->
              if (this.lex.peekKind() is Some(TKCloseParen())) {
                _ = this.lex.next();
                break void;
              }
            | _ ->
              this.error(
                this.lex.posStart(closeTok),
                ExpectedTokenNot(TKCloseParen()),
              )
            }
          };
          Params(params.toArray())
        | _ ->
          this.error(
            this.lex.posStart(commaTok),
            ExpectedTokenNot(TKCloseParen()),
          )
        }
      }
    | TKOpenCurly() ->
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        Object(Array[])
      } else {
        fields = mutable Vector[];
        fields.push(this.field());
        loop {
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
          | Some(x) -> x
          };
          commaTok.kind match {
          | TKCloseCurly() -> break Object(fields.toArray())
          | TKSemi()
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKCloseCurly())) {
              _ = this.lex.next();
              break Object(fields.toArray())
            } else {
              fields.push(this.field());
            }
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedTokenNot(TKCloseCurly()),
            )
          }
        }
      }
    | TKOpenSquare() ->
      if (this.lex.peekKind() is Some(TKCloseSquare())) {
        _ = this.lex.next();
        EArray(Array[])
      } else {
        values = mutable Vector[];
        loop {
          values.push(this.expr(0));
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
          | Some(x) -> x
          };
          commaTok.kind match {
          | TKCloseSquare() -> break EArray(values.toArray())
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKCloseSquare())) {
              _ = this.lex.next();
              break EArray(values.toArray())
            }
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedTokenNot(TKCloseSquare()),
            )
          }
        }
      }
    | subTok @ TKAddition()
    | subTok @ TKSubtraction() ->
      (_assoc, bopPrec) = precedence[subTok];
      this.expr_(bopPrec)
    | subTok @ TKExclamationMark() ->
      (_, unopPrec) = precedence[subTok];
      Unop(UOExclamationMark(), this.expr(unopPrec))
    | TKDivision() ->
      _ = this.lex.next();
      pos = this.lex.pos;
      loop {
        if (pos >= this.lex.contents.size()) {
          this.error(this.lex.posEnd(), UnterminatedExpr())
        };
        c = this.lex.contents[pos];
        if (c == '\\') {
          !pos = pos + 2;
          continue;
        };
        !pos = pos + 1;
        if (c == '/') break void;
      };
      loop {
        if (pos >= this.lex.contents.size()) {
          this.error(this.lex.posEnd(), UnterminatedExpr())
        };
        c = this.lex.contents[pos];
        if (
          c == 'g' ||
          c == 'u' ||
          c == 'm' ||
          c == 's' ||
          c == 'u' ||
          c == 'y'
        ) {
          continue;
        };
        break void
      };
      regexp = String::fromChars(this.lex.contents.slice(this.lex.pos, pos));
      this.lex.!pos = pos;
      Regexp(regexp)
    | TKLessThan() ->
      ty = this.type(0);
      this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(Token(TKGreaterThan(), _)) -> void
      | Some(unexpectedTok) ->
        this.error(
          this.lex.posStart(unexpectedTok),
          ExpectedTokenNot(TKGreaterThan()),
        )
      };
      e = this.expr(prec);
      return As(e, ty)
    | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())
    };

    loop {
      binopTok = this.lex.peek() match {
      | None() -> return left
      | Some(x) -> x
      };
      if (this.lex.isEqTok(binopTok, "instanceof")) {
        (_assoc, opPrec) = instanceofPrec;
        if (prec <= opPrec) {
          leftPosRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          !left = InstanceOf(Expr(leftPosRange, left), this.expr(opPrec));
          continue;
        };
        return left;
      };
      if (binopTok.kind is TKIncr()) {
        (_assoc, opPrec) = precedence[binopTok.kind];
        if (prec <= opPrec) {
          leftPosRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          !left = PostOp(POIncr(), Expr(leftPosRange, left));
        };
        return left;
      };
      if (binopTok.kind is TKDecr()) {
        (_assoc, opPrec) = precedence[binopTok.kind];
        if (prec <= opPrec) {
          leftPosRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          !left = PostOp(PODecr(), Expr(leftPosRange, left));
        };
        return left;
      };
      if (binopTok.kind is TKExclamationMark()) {
        (_assoc, opPrec) = precedence[TKIncr()];
        if (prec <= opPrec) {
          leftPosRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          !left = PostOp(POExcl(), Expr(leftPosRange, left));
        };
        return left;
      };
      if (binopTok.kind is TKQuestionMark()) {
        (_assoc, opPrec) = precedence[binopTok.kind];
        if (prec <= opPrec) {
          leftPosRange = PosRange(
            this.lex.fileName,
            tok.posRange.start,
            this.lex.getLastPos(),
          );
          _ = this.lex.next();
          e2 = this.expr(0);
          this.expect(TKColon());
          e3 = this.expr(opPrec);
          !left = EIf(Expr(leftPosRange, left), e2, e3);
        };
        return left;
      };
      if (
        binopTok.kind is TKColon() &&
        this.lex.lookAhead(() -> {
          try {
            _ = this.lex.next();
            _ = this.type(0);
            this.lex.peekKind() is Some(TKClosure())
          } catch {
          | ErrorExn _ -> false
          | exn -> throw exn
          }
        })
      ) {
        _ = this.lex.next();
        rty = this.type(0);
        this.expect(TKClosure());
        !left = {
          params = left match {
          | Params(params) -> params
          | Var(varName) -> Array[(varName, None())]
          | _ -> this.error(this.lex.posStart(tok), ExpectedParams())
          };
          closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
            CBBlock(this.blockOrStmt())
          } else {
            CBExpr(this.expr(0))
          };
          Closure(params, Some(rty), closureBody)
        }
      };
      if (binopTok.kind is TKClosure()) {
        _ = this.lex.next();
        !left = {
          params = left match {
          | Params(params) -> params
          | Var(varName) -> Array[(varName, None())]
          | _ -> this.error(this.lex.posStart(tok), ExpectedParams())
          };
          closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {
            CBBlock(this.blockOrStmt())
          } else {
            CBExpr(this.expr(0))
          };
          Closure(params, None(), closureBody)
        }
      };
      if (binopTok.kind is TKOpenSquare()) {
        if (prec >= callPrec) return left;
        _ = this.lex.next();
        !left = Get(
          Expr(
            PosRange(
              this.lex.fileName,
              tok.posRange.start,
              this.lex.getLastPos(),
            ),
            left,
          ),
          this.expr(0),
        );
        this.expect(TKCloseSquare());
        continue;
      };
      hasTArgs = this.hasTArgs();
      if (binopTok.kind is TKOpenParen() || hasTArgs) {
        if (prec >= callPrec) return left;
        _ = this.lex.next();
        targs = mutable Vector[];
        if (hasTArgs) {
          loop {
            targs.push(this.type(0));
            commaTok = this.lex.next() match {
            | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
            | Some(tk) -> tk
            };
            commaTok.kind match {
            | TKComma() ->
              if (this.lex.peekKind() is Some(TKGreaterThan())) {
                _ = this.lex.next();
                break void
              }
            | TKGreaterThan() -> break void
            | _ ->
              this.error(
                this.lex.posStart(commaTok),
                ExpectedToken(TKGreaterThan()),
              )
            }
          };
          this.expect(TKOpenParen())
        };
        args = this.arguments();
        !left = Call(
          Expr(
            PosRange(
              this.lex.fileName,
              tok.posRange.start,
              this.lex.getLastPos(),
            ),
            left,
          ),
          targs.toArray(),
          args,
        );
        continue;
      };
      if (binopTok.kind is TKEquality()) {
        this.error(this.lex.posStart(binopTok), DontUseEquality())
      };
      if (binopTok.kind is TKInequality()) {
        this.error(this.lex.posStart(binopTok), DontUseInequality())
      };
      if (this.lex.isEqTok(binopTok, "as")) {
        leftPosRange = PosRange(
          this.lex.fileName,
          tok.posRange.start,
          this.lex.getLastPos(),
        );
        _ = this.lex.next();
        ty = this.type(0);
        result = As(Expr(leftPosRange, left), ty);
        loop {
          if (this.lex.isEq("as")) {
            _ = this.lex.next();
            type = this.type(0);
            !result = As(
              Expr(
                PosRange(
                  this.lex.fileName,
                  tok.posRange.start,
                  this.lex.getLastPos(),
                ),
                result,
              ),
              type,
            );
          };
          break void;
        };
        return result;
      };
      (assoc, bopPrec) = precedence.maybeGet(binopTok.kind) match {
      | None() -> return left
      | Some(x) -> x
      };
      binop = binopTok.kind.toBinop() match {
      | None() -> return left
      | Some(x) -> x
      };
      if (bopPrec == prec) {
        leftPosRange = PosRange(
          this.lex.fileName,
          tok.posRange.start,
          this.lex.getLastPos(),
        );
        _ = this.lex.next();
        assoc match {
        | ALeft() ->
          right = this.expr(prec + 1);
          !left = Binop(binop, Expr(leftPosRange, left), right)
        | ARight() ->
          !left = Binop(binop, Expr(leftPosRange, left), this.expr(prec))
        | ANonAssoc() ->
          this.error(
            this.lex.posStart(binopTok),
            NonAssociative(this.lex.getStrTok(binopTok)),
          )
        };
        continue;
      };
      if (bopPrec > prec) {
        leftPosRange = PosRange(
          this.lex.fileName,
          tok.posRange.start,
          this.lex.getLastPos(),
        );
        _ = this.lex.next();
        !left = Binop(binop, Expr(leftPosRange, left), this.expr(bopPrec + 1));
        continue;
      };
      if (bopPrec >= prec) {
        invariant_violation("bopPrec should be less than prec")
      };
      return left
    }
  }

  mutable fun hasTArgs(): Bool {
    this.lex.lookAhead(() -> {
      binopTok = this.lex.peek() match {
      | None() -> return false
      | Some(x) -> x
      };
      if (!(binopTok.kind is TKLessThan())) return false;
      try {
        _ = this.lex.next();
        loop {
          _ = this.type(0);
          commaTok = this.lex.next() match {
          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
          | Some(tk) -> tk
          };
          commaTok.kind match {
          | TKComma() ->
            if (this.lex.peekKind() is Some(TKGreaterThan())) {
              _ = this.lex.next();
              break void
            }
          | TKGreaterThan() -> break void
          | _ ->
            this.error(
              this.lex.posStart(commaTok),
              ExpectedToken(TKGreaterThan()),
            )
          }
        };
        this.expect(TKOpenParen());
        true
      } catch {
      | ErrorExn _ -> false
      | exn -> throw exn
      }
    })
  }

  mutable fun arguments(): Array<Expr> {
    if (this.lex.peekKind() is Some(TKCloseParen())) {
      _ = this.lex.next();
      return Array[]
    };
    args = mutable Vector[];
    loop {
      args.push(this.expr(0));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseParen() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseParen())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokenNot(TKCloseParen()),
        )
      }
    };
    args.toArray()
  }

  mutable fun field(): Field {
    if (this.lex.peekKind() is Some(TKDotDotDot())) {
      _ = this.lex.next();
      e = this.expr(0);
      return FDSpread(e);
    };
    modifiers = this.modifiers(None());
    fieldGetSet = this.isGetSet();
    fieldName = this.getName();
    if (
      this.lex.peekKind() is Some(TKOpenParen()) ||
      this.lex.peekKind() is Some(TKLessThan())
    ) {
      return this.anonMethodDef(
        None(),
        modifiers,
        fieldGetSet,
        Some(FNNormal(fieldName)),
        true,
        None(),
      )
    };
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x
    };
    tok.kind match {
    | TKColon() ->
      _ = this.lex.next();
      FDNormal(fieldName, this.expr(0))
    | TKComma()
    | TKCloseCurly() ->
      FDNormal(fieldName, Expr(fieldName.posRange, Var(fieldName)))
    | _ -> this.error(this.lex.posStart(tok), ExpectedTokenNot(TKCloseCurly()))
    }
  }
}

module end;
