/***************************************************************************/
/* Main Parser class for TypeScript parsing. */
/***************************************************************************/

module SKJS;

mutable class Parser(lex: mutable Lexer, mutable id: Int = 1) {
  // Set symbol context in the lexer
  mutable fun setSymbolContext(symbol: SymbolicPos, pos: Int): void {
    this.lex.!currentSymbol = symbol;
    this.lex.!currentSymbolPos = pos;
  }

  // Get current symbol context from the lexer
  readonly fun getCurrentSymbol(): SymbolicPos {
    this.lex.currentSymbol
  }
}

module end;
