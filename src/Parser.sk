/***************************************************************************/
/* Main Parser class for TypeScript parsing. */
/***************************************************************************/

module SKJS;

mutable class Parser(
  lex: mutable Lexer,
  mutable id: Int = 1,
  nameCounts: mutable Map<String, Int> = mutable Map[],
  // Per-name count of top-level function declarations seen during parsing,
  // used to give each same-name declaration (overload group member) its OWN
  // symbolic anchor, so a length-changing edit to one declaration does not
  // shift the relative positions (and thus the hashes) of the others.
  funSymbolCounts: mutable Map<String, Int> = mutable Map[],
  // Per-(class, method) count of method declarations seen during parsing,
  // used to give each same-name method declaration (overload group member)
  // its OWN symbolic anchor, mirroring funSymbolCounts for functions.
  methodSymbolCounts: mutable Map<String, Int> = mutable Map[],
  funDefSigs: mutable Vector<(FunDefRef, FunDefSigData)> = mutable Vector[],
  funDefBodies: mutable Vector<(FunDefRef, FunDefBodyData)> = mutable Vector[],
  classBodies: mutable Vector<(ClassBodyRef, ClassBodyData)> = mutable Vector[],
  classFieldEntries: mutable Vector<
    (ClassFieldRef, ClassFieldData),
  > = mutable Vector[],
  typeDefBodies: mutable Vector<
    (TypeDefBodyRef, TypeDefBodyData),
  > = mutable Vector[],
  methodBodyEntries: mutable Vector<
    (MethodBodyRef, MethodBodyData),
  > = mutable Vector[],
  // Non-fatal diagnostics recorded while parsing (e.g. surprising number
  // literals); reported as warnings, they never abort parsing.
  warnings: mutable Vector<NamingError> = mutable Vector[],
) {
  // Record a non-fatal diagnostic (warning) at pos; never aborts parsing.
  mutable fun warn(pos: PosRange, msg: String, code: ErrorCode): void {
    this.warnings.push(NamingError(Array[(pos, msg)], code))
  }

  // Set symbol context in the lexer
  mutable fun setSymbolContext(symbolAndPos: (SymbolicPos, Int)): void {
    this.lex.!currentSymbol = symbolAndPos.i0;
    this.lex.!currentSymbolPos = symbolAndPos.i1;
  }

  // Record a symbol definition (only call this when a symbol is actually defined)
  // and set the symbol context in the lexer
  mutable fun recordSymbolDefinitionAndSetSymbolContext(
    symbol: SymbolicPos,
    pos: Int,
  ): void {
    !pos = this.lex.recordSymbolLocation(symbol, pos);
    this.setSymbolContext((symbol, pos))
  }

  // Get current symbol context from the lexer
  readonly fun getCurrentSymbol(): SymbolicPos {
    this.lex.currentSymbol
  }

  // Get current symbol position from the lexer
  readonly fun getCurrentSymbolPos(): Int {
    this.lex.currentSymbolPos
  }

  // Get current symbol context (both symbol and position)
  readonly fun getCurrentSymbolContext(): (SymbolicPos, Int) {
    (this.lex.currentSymbol, this.lex.currentSymbolPos)
  }

  // Get all recorded symbol locations
  readonly fun getAllSymbolLocations(): Map<SymbolicPos, Int> {
    this.lex.getAllSymbolLocations()
  }

  // Get location for a specific symbol
  readonly fun getSymbolLocation(symbol: SymbolicPos): ?Int {
    this.lex.getSymbolLocation(symbol)
  }

  // Check if a symbol is already defined
  readonly fun isSymbolDefined(symbol: SymbolicPos): Bool {
    this.lex.isSymbolDefined(symbol)
  }
}

module end;
