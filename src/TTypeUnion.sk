/***************************************************************************/
// Union operations for types.
/***************************************************************************/

module SKJS;

/* Unexpanded union */
//
// Interpretation:
// 〚 union 〛 = 〚 union.ty1 〛 \/ 〚 union.ty2 〛
class TUnion private (ty1: TType, ty2: TType) extends TInst {
  static fun create(ty1: TType, ty2: TType): TUnion {
    if (ty1.isBottom() || ty2.isBottom() || ty1.isTop() || ty2.isTop()) {
      internal_error(`Unexpected Bottom or Top in TUnion: ${ty1} union ${ty2}`)
    };
    TUnion(ty1, ty2)
  }
}

extension class TType {
  // Unexpanded union.
  static private fun unexpandedUnion(t1: TType, t2: TType): TType {
    u = TUnion::create(t1, t2);
    TType::create(t1.pos, TInsts::single(u), Clauses::empty())
  }

  static fun unionUndefined(
    subst: mutable Subst,
    tenv: TEnv,
    typ: TType,
    pos: PosRange,
  ): TType {
    undef = TType::single(TPrimUnit(TUndefined(), pos));
    TType::union(subst, tenv, typ, undef)
  }

  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    if (ty1 == ty2) return ty1;
    subst.seenUnion.maybeGet((ty1, ty2)) match {
    | None() ->
      result = TType::union_(subst, tenv, ty1, ty2);
      subst.!seenUnion[(ty1, ty2)] = result;
      result
    | Some(ty) -> ty
    }
  }

  private static fun union_(
    subst: mutable Subst,
    tenv: TEnv,
    ty1: TType,
    ty2: TType,
  ): TType {
    if (ty1.isTop() || ty2.isBottom()) return ty1;
    if (ty2.isTop() || ty1.isBottom()) return ty2;
    if (tenv.seenUnion.contains((ty1, ty2))) {
      return TType::unexpandedUnion(ty1, ty2);
    };
    !tenv.seenUnion = tenv.seenUnion.set((ty1, ty2));

    types = TInsts::union(ty1.insts, ty2.insts);
    clauses = Clauses::union(subst, tenv, ty1.clauses, ty2.clauses);
    TType::create(ty1.pos, types, clauses)
  }
}

extension class TAlgebraic {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    a1: TAlgebraic,
    a2: TAlgebraic,
  ): TAlgebraic {
    TAlgebraic(
      a1.branches.mapUnion(a2.branches, (x, y) ->
        TConstr::union(subst, tenv, x, y)
      ),
      a1.pos,
    )
  }
}

extension class TConstr {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    x: TConstr,
    y: TConstr,
  ): TConstr {
    invariant(x.tag == y.tag, "TConstr::union expects identical tags");
    TConstr(x.tag, x.tagPos, TFields::union(subst, tenv, x.fields, y.fields))
  }
}

extension class TFuns {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    f1: TFuns,
    f2: TFuns,
  ): TFuns {
    f = TFun::union(subst, tenv, f1.fun_, f2.fun_);
    TFuns(f, f1.pos)
  }
}

extension class TField {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    x: TField,
    y: TField,
  ): TField {
    if (x.name != y.name) internal_error("field names must match");
    TField{
      pos => x.pos,
      name => x.name,
      isOptional => x.isOptional || y.isOptional,
      type => TType::union(subst, tenv, x.type, y.type),
    }
  }
}

extension class TIndexField {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    x: TIndexField,
    y: TIndexField,
  ): TIndexField {
    /* Currently over-approximating by a union of value types */
    valueType = TType::union(subst, tenv, x.valueType, y.valueType);
    TIndexField{
      pos => x.pos,
      keyName => x.keyName,
      keyKinds => x.keyKinds,
      valueType,
    }
  }
}

extension class STypes {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    stypes1: STypes,
    stypes2: STypes,
  ): STypes {
    STypes(
      stypes1.stypes.mapUnion(stypes2.stypes, (sty1, sty2) -> {
        invariant(
          sty1.tag() == sty2.tag(),
          "mapUnion ensures iteration with identical tags",
        );
        (sty1, sty2) match {
        | (TPrimUnit _, TPrimUnit _) -> sty1

        | (p1 @ TPrimValue _, p2 @ TPrimValue _) -> TPrimValue::union(p1, p2)

        | (TPromise(ty1, pos), TPromise(ty2, _)) ->
          TPromise(TType::union(subst, tenv, ty1, ty2), pos)
        | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->
          TTuple::union(subst, tenv, tuple1, tuple2)
        | (obj1 @ TObject _, obj2 @ TObject _) ->
          TObject::union(subst, tenv, obj1, obj2)
        | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->
          TAlgebraic::union(subst, tenv, a1, a2)
        | _ -> internal_error("Internal error")
        }
      }),
    )
  }
}

extension class TInsts {
  static fun union(insts1: TInsts, insts2: TInsts): TInsts {
    TInsts(insts1.insts.union(insts2.insts))
  }

  static fun unionN(insts: readonly Vector<TInst>): TInsts {
    TInsts(ArraySet::createFromVector(insts))
  }
}

extension class Clause {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    clause1: Clause,
    clause2: Clause,
  ): Clause {
    if (clause1.vars != clause2.vars) {
      internal_error("clause vars must be equal for union")
    };
    stypesOpt = (clause1.stypes, clause2.stypes) match {
    | (None(), _)
    | (_, None()) ->
      None()
    | (Some(x), Some(y)) -> Some(STypes::union(subst, tenv, x, y))
    };
    Clause(clause1.vars, stypesOpt)
  }
}

extension class Clauses {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    clauses1: Clauses,
    clauses2: Clauses,
  ): Clauses {
    Clauses::create(
      clauses1.clauses.mapUnion(clauses2.clauses, (x, y) ->
        Clause::union(subst, tenv, x, y)
      ),
    )
  }

  static fun unionN(
    subst: mutable Subst,
    tenv: TEnv,
    clauses: readonly Vector<Clause>,
  ): Clauses {
    result = Clauses::empty();
    for (clause in clauses) {
      !result = Clauses::union(
        subst,
        tenv,
        result,
        Clauses::singleClause(clause),
      )
    };
    result
  }
}

extension class TPrimValue {
  static fun union(t1: TPrimValue, t2: TPrimValue): TPrimValue {
    if (t1.kind != t2.kind) {
      invariant_violation(
        "Union must be called on primitive value types of same kind",
      )
    };
    (t1.literals, t2.literals) match {
    | (None(), _) -> t1
    | (Some _, None()) -> t2
    | (Some(lits1), Some(lits2)) ->
      litsUnion = lits1.union(lits2);
      lits = if (t1.kind == TBool() && litsUnion.size() >= 2) None() else {
        Some(litsUnion)
      };
      TPrimValue(t1.kind, lits, t1.pos)
    }
  }
}

extension class TFields {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    fields1: TFields,
    fields2: TFields,
  ): TFields {
    fields = fields1.fields.merge(fields2.fields, ior ->
      ior match {
      | Left(z) ->
        otherIdx = fields2.stringIndex match {
        | some @ Some _ -> some
        | None() ->
          if (z.name.toIntOption().isSome()) fields2.numberIndex else None()
        };
        otherIdx match {
        | Some(index) ->
          newType = TType::union(subst, tenv, z.type, index.valueType);
          Some(z.withOptional().mapType(_ -> newType))
        | None() -> Some(z.withOptional())
        }
      | Right(z) ->
        otherIdx = fields1.stringIndex match {
        | some @ Some _ -> some
        | None() ->
          if (z.name.toIntOption().isSome()) fields1.numberIndex else None()
        };
        otherIdx match {
        | Some(index) ->
          newType = TType::union(subst, tenv, z.type, index.valueType);
          Some(z.withOptional().mapType(_ -> newType))
        | None() -> Some(z.withOptional())
        }
      | Both(x, y) -> Some(TField::union(subst, tenv, x, y))
      }
    );
    symbolFields = fields1.symbolFields.merge(fields2.symbolFields, ior ->
      ior match {
      | Left(z) ->
        fields2.symbolIndex match {
        | Some(index) ->
          newType = TType::union(subst, tenv, z.type, index.valueType);
          Some(z.withOptional().mapType(_ -> newType))
        | None() -> Some(z.withOptional())
        }
      | Right(z) ->
        fields1.symbolIndex match {
        | Some(index) ->
          newType = TType::union(subst, tenv, z.type, index.valueType);
          Some(z.withOptional().mapType(_ -> newType))
        | None() -> Some(z.withOptional())
        }
      | Both(x, y) -> Some(TField::union(subst, tenv, x, y))
      }
    );
    stringIndex = TFields::unionOptIndex(
      subst,
      tenv,
      fields1.stringIndex,
      fields2.stringIndex,
    );
    numberIndex = TFields::unionOptIndex(
      subst,
      tenv,
      fields1.numberIndex,
      fields2.numberIndex,
    );
    symbolIndex = TFields::unionOptIndex(
      subst,
      tenv,
      fields1.symbolIndex,
      fields2.symbolIndex,
    );
    call = TFields::unionOptTFuns(subst, tenv, fields1.call, fields2.call);
    new = TFields::unionOptTFuns(subst, tenv, fields1.new, fields2.new);
    TFields{
      fields,
      symbolFields,
      stringIndex,
      numberIndex,
      symbolIndex,
      call,
      new,
    }
  }

  static fun unionOptIndex(
    subst: mutable Subst,
    tenv: TEnv,
    i1: ?TIndexField,
    i2: ?TIndexField,
  ): ?TIndexField {
    (i1, i2) match {
    | (None(), None()) -> None()
    | (Some(index), None())
    | (None(), Some(index)) ->
      Some(index)
    | (Some(index1), Some(index2)) ->
      Some(TIndexField::union(subst, tenv, index1, index2))
    }
  }

  static fun unionOptTFuns(
    subst: mutable Subst,
    tenv: TEnv,
    f1opt: ?(Bool, TFuns),
    f2opt: ?(Bool, TFuns),
  ): ?(Bool, TFuns) {
    (f1opt, f2opt) match {
    | (None(), Some((_, f)))
    | (Some((_, f)), None()) ->
      Some((true, f))
    | (Some((opt1, f1)), Some((opt2, f2))) ->
      Some((opt1 || opt2, TFuns::union(subst, tenv, f1, f2)))
    | (None(), None()) -> None()
    }
  }
}

extension class TObject {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    obj1: TObject,
    obj2: TObject,
  ): TObject {
    TObject(TFields::union(subst, tenv, obj1.fields, obj2.fields), obj1.pos)
  }
}

extension class TFun {
  static fun union(subst: mutable Subst, tenv: TEnv, f1: TFun, f2: TFun): TFun {
    if (f1.tparams.size() != f2.tparams.size()) {
      internal_error("function clause sizes must match")
    };

    tsubst = SortedMap[];
    clauses = mutable Vector[];
    for (i in Range(0, f1.tparams.size())) {
      tparam1 = f1.tparams[i];
      tparam2 = f2.tparams[i];
      !tsubst[tparam2.id] = tparam1;
      cstr = (tparam1.cstr, tparam2.cstr) match {
      | (None(), None()) -> None()
      | (None(), Some(x)) -> Some(x)
      | (Some(x), None()) -> Some(x)
      | (Some(x), Some(y)) -> Some(TType::inter(subst, tenv, x, y))
      };
      clauses.push(tparam1 with {cstr});
    };
    !f2 = (mutable RenameClauses()).fun_(tsubst, f2);

    thisParam = (f1.thisParam, f2.thisParam) match {
    | (None(), _)
    | (_, None()) ->
      None()
    | (Some(this1), Some(this2)) ->
      Some(TType::inter(subst, tenv, this1, this2))
    };

    spread1elt = f1.spreadParam match {
    | None() -> None()
    | Some(spread1) -> Some(spread1.getEltType(subst, tenv, Contravariant()))
    };
    spread2elt = f2.spreadParam match {
    | None() -> None()
    | Some(spread2) -> Some(spread2.getEltType(subst, tenv, Contravariant()))
    };
    params = mutable Vector[];
    for (i in Range(0, max(f1.params.size(), f2.params.size()))) {
      p1opt = if (i < f1.params.size()) Some(f1.params[i]) else {
        io1 = i - f1.params.size();
        if (io1 < f1.optionalParams.size()) Some(f1.optionalParams[io1]) else {
          spread1elt
        }
      };
      p2opt = if (i < f2.params.size()) Some(f2.params[i]) else {
        io2 = i - f2.params.size();
        if (io2 < f2.optionalParams.size()) Some(f2.optionalParams[io2]) else {
          spread2elt
        }
      };
      p = (p1opt, p2opt) match {
      | (Some(p1), Some(p2)) -> TType::inter(subst, tenv, p1, p2)
      | (Some(p), None())
      | (None(), Some(p)) ->
        p
      | (None(), None()) ->
        internal_error("TFun::union: iteration over required params")
      };
      params.push(p)
    };
    optionalParams = mutable Vector[];
    for (i in Range(
      params.size(),
      max(
        f1.params.size() + f1.optionalParams.size(),
        f2.params.size() + f2.optionalParams.size(),
      ),
    )) {
      io1 = i - f1.params.size();
      invariant(io1 >= 0, "TFun::union: io1 >= 0");
      p1opt = if (io1 < f1.optionalParams.size()) {
        Some(f1.optionalParams[io1])
      } else {
        spread1elt
      };
      io2 = i - f2.params.size();
      invariant(io2 >= 0, "TFun::union: io2 >= 0");
      p2opt = if (io2 < f2.optionalParams.size()) {
        Some(f2.optionalParams[io2])
      } else {
        spread2elt
      };
      p = (p1opt, p2opt) match {
      | (Some(p1), Some(p2)) -> TType::inter(subst, tenv, p1, p2)
      | (Some(p), None())
      | (None(), Some(p)) ->
        p
      | (None(), None()) ->
        internal_error("TFun::union: iteration over required params")
      };
      optionalParams.push(p)
    };
    spreadParam = (f1.spreadParam, f2.spreadParam) match {
    | (Some(ty1), Some(ty2)) -> Some(ArrayType::inter(subst, tenv, ty1, ty2))
    | (spread @ Some _, None())
    | (None(), spread) ->
      spread
    };
    retType = TType::union(subst, tenv, f1.retType, f2.retType);
    cgNodes = f1.cgNodes.union(f2.cgNodes);
    TFun(
      clauses.toArray(),
      thisParam,
      params.toArray(),
      optionalParams.toArray(),
      spreadParam,
      retType,
      cgNodes,
    )
  }
}

extension base class ArrayType {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    arr1: ArrayType,
    arr2: ArrayType,
  ): ArrayType {
    (
      arr1.maybeGetEltType(subst, tenv, Contravariant()),
      arr2.maybeGetEltType(subst, tenv, Contravariant()),
    ) match {
    | (Some(elt1), Some(elt2)) ->
      ArrayType::createFromElt(
        TType::union(subst, tenv, elt1, elt2),
        arr1.getPos(),
      )
    | _ ->
      ArrayType::createFromFull(
        TType::union(subst, tenv, arr1.full(), arr2.full()),
      )
    }
  }
}

extension class TTuple {
  static fun union(
    subst: mutable Subst,
    tenv: TEnv,
    tuple1: TTuple,
    tuple2: TTuple,
  ): TTuple {
    result = mutable Vector[];
    for (i in Range(0, min(tuple1.tuple.size(), tuple2.tuple.size()))) {
      result.push(TType::union(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]));
    };
    if (tuple1.tuple.size() < tuple2.tuple.size()) {
      for (i in Range(tuple1.tuple.size(), tuple2.tuple.size())) {
        posEnd = tuple1.pos.atEnd();
        result.push(
          TType::union(
            subst,
            tenv,
            TType::single(TPrimUnit(TUndefined(), posEnd)),
            tuple2.tuple[i],
          ),
        );
      }
    } else if (tuple2.tuple.size() < tuple1.tuple.size()) {
      for (i in Range(tuple2.tuple.size(), tuple1.tuple.size())) {
        posEnd = tuple2.pos.atEnd();
        result.push(
          TType::union(
            subst,
            tenv,
            tuple1.tuple[i],
            TType::single(TPrimUnit(TUndefined(), posEnd)),
          ),
        );
      }
    };
    TTuple(result.toArray(), tuple1.pos)
  }
}

module end;
