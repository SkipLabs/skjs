/***************************************************************************/
/* Module handling all the errors. */
/***************************************************************************/

/***************************************************************************/
/* The function that is called whenever there is an internal error. */
/***************************************************************************/

@cpp_extern("SKIP_print_backtrace")
native fun printBacktrace(): void;

fun internal_error<T>(msg: String): T {
  printBacktrace();
  invariant_violation("Internal error: " + msg);
}

module SKJS;

/***************************************************************************/
/* The function that is called whenever there is a user-visible error. */
/***************************************************************************/

fun error<T>(err: Error): T {
  throw ErrorExn(err)
}

/***************************************************************************/
/* The exception that is thrown whenever there is an error. */
/***************************************************************************/

class ErrorExn(error: Error) extends Exception

/***************************************************************************/
/* The class for all the errors. */
/***************************************************************************/

base class Error uses Equality {
  fun toString(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): String;
}

/***************************************************************************/
/* Errors with a single position. */
/***************************************************************************/

base class SinglePosError<K: ErrorKind>(
  pos: ErrorPos,
  errorKind: K,
) extends Error {
  fun toString(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): String {
    fileName = this.pos.fileName();
    newLines = newLinesMap.get(context, fileName);
    symbols = symbolsMap.get(context, fileName);
    resolver = PositionResolver{fileName, newLines, symbols};
    this.pos.toString(resolver) + "\n" + this.errorKind.toString()
  }
}

class ParsingError extends SinglePosError<ParsingKind>
class LexingError extends SinglePosError<LexingKind>

/***************************************************************************/
/* Symbol definition errors */
/***************************************************************************/

class DuplicateSymbolError(
  symbol: SymbolicPos,
  existingPos: PosRange,
  newPos: PosRange,
) extends Error {
  fun toString(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): String {
    fileName = this.newPos.fileName;
    newLines = newLinesMap.get(context, fileName);
    symbols = symbolsMap.get(context, fileName);
    resolver = PositionResolver{fileName, newLines, symbols};
    symbolName = this.symbol match {
    | SPTopLevel() -> "top-level"
    | SPClass(name) -> `class '${name}'`
    | SPFunction(name) -> `function '${name}'`
    | SPMethod(className, methodName) -> `method '${className}.${methodName}'`
    | SPConstant(name) -> `constant '${name}'`
    };
    resolver.relPosRange(this.newPos).toString() +
      "\n" +
      `Error: ${symbolName} is already defined\n` +
      resolver.relPosRange(this.existingPos).toString() +
      "\n" +
      `Note: ${symbolName} was first defined here`
  }
}

/***************************************************************************/
/* There are two types of positions:
 * - PosRanges: when an error has a beginning and an end
 * - Pos: when an error points at somewhere in the code (for example a lexing
 *   error)
 */
/***************************************************************************/

base class ErrorPos uses Equality {
  children =
  | EPRange(PosRange)
  | EPChar(String, Pos)

  fun fileName(): String
  | EPRange(p) -> p.fileName
  | EPChar(fileName, _) -> fileName

  fun toString(resolver: PositionResolver): String
  | EPRange(p) -> resolver.relPosRange(p).toString()
  | EPChar(_, p) -> resolver.relPos(p).toString()
}

/***************************************************************************/
/* Error kinds (description of the error) */
/***************************************************************************/

base class ErrorKind uses Equality {
  fun toString(): String;
}
base class ParsingKind extends ErrorKind
base class LexingKind extends ErrorKind

/***************************************************************************/
/* Lexing errors */
/***************************************************************************/

class UnknownCharacter(char: Char) extends LexingKind {
  fun toString(): String {
    `Unknown character: ${this.char} (${this.char.code()})`
  }
}
class UnknownOperator(str: String) extends LexingKind {
  fun toString(): String {
    `Unknown operator: ${this.str}`
  }
}
class UnterminatedString() extends LexingKind {
  fun toString(): String {
    `Unterminated string`
  }
}
class NewLineInString() extends LexingKind {
  fun toString(): String {
    `New line in string`
  }
}
class UnterminatedComment() extends LexingKind {
  fun toString(): String {
    `Unterminated comment`
  }
}

/***************************************************************************/
/* Parsing errors */
/***************************************************************************/

class UnterminatedFunDef() extends ParsingKind {
  fun toString(): String {
    `Unterminated function definition`
  }
}
class UnterminatedStmt() extends ParsingKind {
  fun toString(): String {
    `Unterminated statement`
  }
}
class UnterminatedDef() extends ParsingKind {
  fun toString(): String {
    `Unterminated definition`
  }
}
class UnexpectedToken() extends ParsingKind {
  fun toString(): String {
    `Unexpected token`
  }
}
class InvalidImport() extends ParsingKind {
  fun toString(): String {
    `Invalid import, all imports are expected to be of the form:
import ... from './file_name.js';`
  }
}
class UnterminatedImport() extends ParsingKind {
  fun toString(): String {
    `Unterminated import`
  }
}
class UnterminatedBlock() extends ParsingKind {
  fun toString(): String {
    `Unterminated block`
  }
}
class UnterminatedExpr() extends ParsingKind {
  fun toString(): String {
    `Unterminated expr`
  }
}
class UnterminatedNamespace() extends ParsingKind {
  fun toString(): String {
    `Unterminated namespace`
  }
}
class UnterminatedExportList() extends ParsingKind {
  fun toString(): String {
    `Unterminated export`
  }
}
class ExpectedDefinition() extends ParsingKind {
  fun toString(): String {
    `Expected a definition`
  }
}
class UnterminatedType() extends ParsingKind {
  fun toString(): String {
    `Unterminated type`
  }
}
class ExpectedToken(tokenKind: TokenKind) extends ParsingKind {
  fun toString(): String {
    `Expected token ${this.tokenKind}`
  }
}

class ExpectedString() extends ParsingKind {
  fun toString(): String {
    `Expected a string`
  }
}
class ExpectedDeclaration() extends ParsingKind {
  fun toString(): String {
    `Expected a string`
  }
}
class ExpectedStringNot(str: String) extends ParsingKind {
  fun toString(): String {
    `Expected a string, not '${this.str}`
  }
}
class ExpectedTokenNot(tokenKind: TokenKind) extends ParsingKind {
  fun toString(): String {
    `Expected ${this.tokenKind}`
  }
}
class ExpectedStrNot(str: String) extends ParsingKind {
  fun toString(): String {
    `Expected ${this.str}`
  }
}
class ExpectedVarName() extends ParsingKind {
  fun toString(): String {
    `Expected a variable name`
  }
}
class InvalidClosure() extends ParsingKind {
  fun toString(): String {
    `Invalid closure`
  }
}
class ExpectedParams() extends ParsingKind {
  fun toString(): String {
    `Expected params`
  }
}
class DuplicateFieldNames(pos2: RelPos) extends ParsingKind {
  fun toString(): String {
    `Duplicate field name\n${this.pos2.toString()}\nPrevious one found here`
  }
}
class TooManyTags(pos2: RelPos) extends ParsingKind {
  fun toString(): String {
    `Duplicate tags\n${this.pos2.toString()}\nPrevious one found here`
  }
}

class DontUseEquality() extends ParsingKind {
  fun toString(): String {
    "Don't use ==, use === instead"
  }
}

class DontUseInequality() extends ParsingKind {
  fun toString(): String {
    "Don't use !=, use !== instead"
  }
}

class NonAssociative(op: String) extends ParsingKind {
  fun toString(): String {
    `The operator ${this.op} is not associative`
  }
}

class FunctionInExpr() extends ParsingKind {
  fun toString(): String {
    "Function inside expressions are not supported, use closures instead"
  }
}

class ExpectedStmt() extends ParsingKind {
  fun toString(): String {
    "Expected a statement"
  }
}

class MissingReturnType() extends ParsingKind {
  fun toString(): String {
    "Missing return type"
  }
}

class MissingParameterName() extends ParsingKind {
  fun toString(): String {
    "Function parameter must have a name"
  }
}

class NonDefaultAnonymousFunctionExport() extends ParsingKind {
  fun toString(): String {
    "An anonymous function can be exported only if it is the default export"
  }
}

/***************************************************************************/
/* Name resolution error */
/***************************************************************************/

class NotFound(name: String) extends ParsingKind {
  fun toString(): String {
    `Type ${this.name} not found`
  }
}

module end;
