/***************************************************************************/
/* Module handling all the errors. */
/***************************************************************************/

/***************************************************************************/
/* The function that is called whenever there is an internal error. */
/***************************************************************************/

@cpp_extern("SKIP_print_backtrace")
native fun printBacktrace(): void;

fun internal_error<T>(msg: String): T {
  printBacktrace();
  invariant_violation("Internal error: " + msg);
}

module SKJS;

/***************************************************************************/
/* The exception that is thrown whenever there is an error. */
/***************************************************************************/

class ErrorExn(error: Error) extends Exception

fun catchError(f: () -> void): ?Error {
  try {
    f();
    None()
  } catch {
  | ErrorExn(err) -> Some(err)
  | exn -> throw exn
  }
}

/***************************************************************************/
/* Error output format. */
/***************************************************************************/

base class ErrorFormat {
  children =
  | EFJson()

  const default: String = "default";
  const all: String = "default, indent, json";

  static fun ofString(str: String): Result<ErrorFormat, String> {
    str match {
    | "default" -> Success(EFDefault())
    | "indent" -> Success(EFIndent())
    | "json" -> Success(EFJson())
    | _ -> Failure(str)
    }
  }
}

base class TextErrorFormat extends ErrorFormat {
  children =
  | EFDefault()
  | EFIndent()
}

/***************************************************************************/
/* The class for all the errors. */
/***************************************************************************/

base class Error {
  fun toErrorMessage(
    context: mutable SKStore.Context,
    rootMap: RootMap,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
    errorDetailConfig: ErrorDetailConfig = ErrorDetailConfig::default(),
  ): ErrorMessage;

  static fun resolver(
    fileName: FPath,
    context: mutable SKStore.Context,
    rootMap: RootMap,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): PositionResolver {
    newLines = newLinesMap.get(context, fileName);
    symbols = symbolsMap.get(context, fileName);
    absFileName = fileName.toAbsolute(rootMap);
    PositionResolver{absFileName, newLines, symbols}
  }
}

/***************************************************************************/
/* Errors with a single position. */
/***************************************************************************/

base class SinglePosError<K: ErrorKind>(
  pos: ErrorPos,
  errorKind: K,
) extends Error {
  fun toErrorMessage(
    context: mutable SKStore.Context,
    rootMap: RootMap,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
    _errorDetailConfig: ErrorDetailConfig = ErrorDetailConfig::default(),
  ): ErrorMessage {
    fileName = this.pos.fileName();
    resolver = static::resolver(
      fileName,
      context,
      rootMap,
      newLinesMap,
      symbolsMap,
    );
    Array[(resolver.errMsgErrPos(this.pos), this.errorKind.toString())]
  }
}

base class LexingOrParsingError extends Error

class ParsingError extends SinglePosError<ParsingKind>, LexingOrParsingError
class LexingError extends SinglePosError<LexingKind>, LexingOrParsingError

/***************************************************************************/
/* There are two types of positions:
 * - PosRanges: when an error has a beginning and an end
 * - Pos: when an error points at somewhere in the code (for example a lexing
 *   error)
 */
/***************************************************************************/

base class ErrorPos uses Equality {
  children =
  | EPRange(PosRange)
  | EPChar(FPath, Pos)

  fun fileName(): FPath
  | EPRange(p) -> p.fileName
  | EPChar(fileName, _) -> fileName

  fun toString(resolver: PositionResolver): String {
    resolver.errMsgErrPos(this).toString()
  }
}

/***************************************************************************/
/* Error kinds (description of the error) */
/***************************************************************************/

base class ErrorKind uses Equality {
  fun toString(): String;
}
base class ParsingKind extends ErrorKind
base class LexingKind extends ErrorKind

/***************************************************************************/
/* Lexing errors */
/***************************************************************************/

class UnknownCharacter(char: Char) extends LexingKind {
  fun toString(): String {
    `Unknown character: ${this.char} (${this.char.code()})`
  }
}
class UnknownOperator(str: String) extends LexingKind {
  fun toString(): String {
    `Unknown operator: ${this.str}`
  }
}
class UnterminatedString() extends LexingKind {
  fun toString(): String {
    `Unterminated string`
  }
}
class NewLineInString() extends LexingKind {
  fun toString(): String {
    `New line in string`
  }
}
class UnterminatedComment() extends LexingKind {
  fun toString(): String {
    `Unterminated comment`
  }
}

/***************************************************************************/
/* Parsing errors */
/***************************************************************************/

class UnexpectedObjectTypeMethodReadonly(
  ro: ObjectFieldReadonly,
) extends ParsingKind {
  fun toString(): String {
    `Unexpected modifier on object literal method: ${this.ro}`
  }
}
class UnterminatedFunDef() extends ParsingKind {
  fun toString(): String {
    `Unterminated function definition`
  }
}
class UnterminatedStmt() extends ParsingKind {
  fun toString(): String {
    `Unterminated statement`
  }
}
class UnterminatedDef() extends ParsingKind {
  fun toString(): String {
    `Unterminated definition`
  }
}
class UnexpectedToken() extends ParsingKind {
  fun toString(): String {
    `Unexpected token`
  }
}
class UnterminatedImport() extends ParsingKind {
  fun toString(): String {
    `Unterminated import`
  }
}
class UnterminatedBlock() extends ParsingKind {
  fun toString(): String {
    `Unterminated block`
  }
}
class UnterminatedExpr() extends ParsingKind {
  fun toString(): String {
    `Unterminated expr`
  }
}
class UnterminatedType() extends ParsingKind {
  fun toString(): String {
    `Unterminated type`
  }
}
class ExpectedAccessorDefinition() extends ParsingKind {
  fun toString(): String {
    `Expected accessor definition`
  }
}
class ComputedMethodNameNotSupported() extends ParsingKind {
  fun toString(): String {
    `Computed method names not yet supported`
  }
}
class ExpectedToken(tokenKind: TokenKind) extends ParsingKind {
  fun toString(): String {
    `Expected token ${this.tokenKind}`
  }
}
class ExpectedTokens(kinds: Array<TokenKind>) extends ParsingKind {
  fun toString(): String {
    `Expected token ${this.kinds.join(" or ")}`
  }
}
class ExpectedStr(str: String) extends ParsingKind {
  fun toString(): String {
    `Expected ${this.str}`
  }
}
class ExpectedStrings(strs: Array<String>) extends ParsingKind {
  fun toString(): String {
    `Expected ${this.strs.join(" or ")}`
  }
}
class ExpectedVarName() extends ParsingKind {
  fun toString(): String {
    `Expected a variable name`
  }
}
class ExpectedParams() extends ParsingKind {
  fun toString(): String {
    `Expected params`
  }
}

class DontUseEquality() extends ParsingKind {
  fun toString(): String {
    "Don't use ==, use === instead"
  }
}
class DontUseInequality() extends ParsingKind {
  fun toString(): String {
    "Don't use !=, use !== instead"
  }
}

class FunctionInExpr() extends ParsingKind {
  fun toString(): String {
    "Function inside expressions are not supported, use closures instead"
  }
}

class ExpectedStmt() extends ParsingKind {
  fun toString(): String {
    "Expected a statement"
  }
}

class ExpectedCatchOrFinally() extends ParsingKind {
  fun toString(): String {
    "Expected catch or finally clause"
  }
}

class MissingParameterName() extends ParsingKind {
  fun toString(): String {
    "Function parameter must have a name"
  }
}

class EmptyIfStmt() extends ParsingKind {
  fun toString(): String {
    "The body of an 'if' statement cannot be the empty statement"
  }
}

module end;
