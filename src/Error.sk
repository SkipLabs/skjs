/***************************************************************************/
/* Module handling all the errors. */
/***************************************************************************/

/***************************************************************************/
/* The function that is called whenever there is an internal error. */
/***************************************************************************/

@cpp_extern("SKIP_print_backtrace")
native fun printBacktrace(): void;

fun internal_error<T>(msg: String): T {
  printBacktrace();
  invariant_violation("Internal error: " + msg);
}

module SKJS;

/***************************************************************************/
/* The exception that is thrown whenever there is an error. */
/***************************************************************************/

class ErrorExn(error: Error) extends Exception

fun catchError(f: () -> void): ?Error {
  try {
    f();
    None()
  } catch {
  | ErrorExn(err) -> Some(err)
  | exn -> throw exn
  }
}

/***************************************************************************/
/* Error output format. */
/***************************************************************************/

base class ErrorFormat {
  children =
  | EFJson()

  const default: String = "default";
  const all: String = "default, indent, json";

  static fun ofString(str: String): Result<ErrorFormat, String> {
    str match {
    | "default" -> Success(EFDefault())
    | "indent" -> Success(EFIndent())
    | "json" -> Success(EFJson())
    | _ -> Failure(str)
    }
  }
}

base class TextErrorFormat extends ErrorFormat {
  children =
  | EFDefault()
  | EFIndent()
}

/***************************************************************************/
/* The class for all the errors. */
/***************************************************************************/

base class Error {
  fun toErrorMessage(
    context: mutable SKStore.Context,
    rootMap: RootMap,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
    errorDetailConfig: ErrorDetailConfig = ErrorDetailConfig::default(),
  ): ErrorMessage;

  static fun resolver(
    fileName: FPath,
    context: mutable SKStore.Context,
    rootMap: RootMap,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
  ): PositionResolver {
    newLines = newLinesMap.get(context, fileName);
    symbols = symbolsMap.get(context, fileName);
    absFileName = fileName.toAbsolute(rootMap);
    PositionResolver{absFileName, newLines, symbols}
  }
}

/***************************************************************************/
/* Errors with a single position. */
/***************************************************************************/

base class SinglePosError<K: ErrorKind>(
  pos: ErrorPos,
  errorKind: K,
) extends Error {
  fun toErrorMessage(
    context: mutable SKStore.Context,
    rootMap: RootMap,
    newLinesMap: NewLinesMap,
    symbolsMap: SymbolsMap,
    _errorDetailConfig: ErrorDetailConfig = ErrorDetailConfig::default(),
  ): ErrorMessage {
    fileName = this.pos.fileName();
    resolver = static::resolver(
      fileName,
      context,
      rootMap,
      newLinesMap,
      symbolsMap,
    );
    Array[(resolver.errMsgErrPos(this.pos), this.errorKind.toString())]
  }
}

base class LexingOrParsingError extends Error

class ParsingError extends SinglePosError<ParsingKind>, LexingOrParsingError
class LexingError extends SinglePosError<LexingKind>, LexingOrParsingError

/***************************************************************************/
/* There are two types of positions:
 * - PosRanges: when an error has a beginning and an end
 * - Pos: when an error points at somewhere in the code (for example a lexing
 *   error)
 */
/***************************************************************************/

base class ErrorPos uses Equality {
  children =
  | EPRange(PosRange)
  | EPChar(FPath, Pos)

  fun fileName(): FPath
  | EPRange(p) -> p.fileName
  | EPChar(fileName, _) -> fileName

  fun toString(resolver: PositionResolver): String {
    resolver.errMsgErrPos(this).toString()
  }
}

/***************************************************************************/
/* Error codes.
 *
 * Every diagnostic carries a code. `TSCode` reuses the matching TypeScript
 * compiler code; `SKJSCode` is an SKJS-specific code following TypeScript's
 * numbering convention (1xxx syntax, 2xxx semantic/type, 5xxx options; the
 * 9xxx band is reserved for "not yet supported").
 *
 * How the code is surfaced in error output is decided separately; for now it
 * is stored on the error and not rendered.
 */
/***************************************************************************/

base class ErrorCode uses Equality {
  children =
  | TSCode(Int)
  | SKJSCode(Int)

  fun toString(): String
  | TSCode(n) -> `TS${n}`
  | SKJSCode(n) -> `SKJS${n}`
}

/***************************************************************************/
/* Error kinds (description of the error) */
/***************************************************************************/

base class ErrorKind uses Equality {
  fun toString(): String;
  fun code(): ErrorCode;
}
base class ParsingKind extends ErrorKind
base class LexingKind extends ErrorKind

/***************************************************************************/
/* Lexing errors */
/***************************************************************************/

class UnknownCharacter(char: Char) extends LexingKind {
  fun toString(): String {
    `Invalid character '${this.char}' (char code ${this.char.code()})`
  }
  fun code(): ErrorCode {
    TSCode(1127)
  }
}
class UnknownOperator(str: String) extends LexingKind {
  fun toString(): String {
    `Unknown operator '${this.str}'`
  }
  fun code(): ErrorCode {
    SKJSCode(1001)
  }
}
class UnterminatedString() extends LexingKind {
  fun toString(): String {
    `Unterminated string literal`
  }
  fun code(): ErrorCode {
    TSCode(1002)
  }
}
class NewLineInString() extends LexingKind {
  fun toString(): String {
    `Unterminated string literal: string literals cannot span multiple lines`
  }
  fun code(): ErrorCode {
    TSCode(1002)
  }
}
class UnterminatedComment() extends LexingKind {
  fun toString(): String {
    `Unterminated comment ('*/' expected)`
  }
  fun code(): ErrorCode {
    TSCode(1010)
  }
}

/***************************************************************************/
/* Parsing errors */
/***************************************************************************/

class UnexpectedObjectTypeMethodReadonly(
  ro: ObjectFieldReadonly,
) extends ParsingKind {
  fun toString(): String {
    `Unexpected modifier '${this.ro}' on an object literal method`
  }
  fun code(): ErrorCode {
    SKJSCode(1002)
  }
}
class UnterminatedFunDef() extends ParsingKind {
  fun toString(): String {
    `Unterminated function definition ('}' expected)`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class UnterminatedStmt() extends ParsingKind {
  fun toString(): String {
    `Unterminated statement (';' expected)`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class UnterminatedDef() extends ParsingKind {
  fun toString(): String {
    `Unterminated definition`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class UnexpectedToken() extends ParsingKind {
  fun toString(): String {
    `Unexpected token`
  }
  fun code(): ErrorCode {
    TSCode(1128)
  }
}
class UnterminatedImport() extends ParsingKind {
  fun toString(): String {
    `Unterminated import statement`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class UnterminatedBlock() extends ParsingKind {
  fun toString(): String {
    `Unterminated block ('}' expected)`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class UnterminatedExpr() extends ParsingKind {
  fun toString(): String {
    `Unterminated expression`
  }
  fun code(): ErrorCode {
    TSCode(1109)
  }
}
class UnterminatedType() extends ParsingKind {
  fun toString(): String {
    `Unterminated type annotation`
  }
  fun code(): ErrorCode {
    TSCode(1110)
  }
}
class ExpectedAccessorDefinition() extends ParsingKind {
  fun toString(): String {
    `Expected a getter or setter definition`
  }
  fun code(): ErrorCode {
    SKJSCode(1003)
  }
}
class ComputedMethodNameNotSupported() extends ParsingKind {
  fun toString(): String {
    `Computed method names are not yet supported by SKJS`
  }
  fun code(): ErrorCode {
    SKJSCode(9026)
  }
}
class ExpectedToken(tokenKind: TokenKind) extends ParsingKind {
  fun toString(): String {
    `'${this.tokenKind}' expected`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class ExpectedTokens(kinds: Array<TokenKind>) extends ParsingKind {
  fun toString(): String {
    `'${this.kinds.join("' or '")}' expected`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class ExpectedStr(str: String) extends ParsingKind {
  fun toString(): String {
    `${this.str} expected`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class ExpectedStrings(strs: Array<String>) extends ParsingKind {
  fun toString(): String {
    `${this.strs.join(" or ")} expected`
  }
  fun code(): ErrorCode {
    TSCode(1005)
  }
}
class ExpectedVarName() extends ParsingKind {
  fun toString(): String {
    `A variable name was expected`
  }
  fun code(): ErrorCode {
    TSCode(1003)
  }
}
class ExpectedParams() extends ParsingKind {
  fun toString(): String {
    `A parameter list was expected`
  }
  fun code(): ErrorCode {
    SKJSCode(1004)
  }
}

class DontUseEquality() extends ParsingKind {
  fun toString(): String {
    "Unexpected '=='; use '===' instead (SKJS forbids loose equality)"
  }
  fun code(): ErrorCode {
    SKJSCode(1005)
  }
}
class DontUseInequality() extends ParsingKind {
  fun toString(): String {
    "Unexpected '!='; use '!==' instead (SKJS forbids loose inequality)"
  }
  fun code(): ErrorCode {
    SKJSCode(1006)
  }
}

class FunctionInExpr() extends ParsingKind {
  fun toString(): String {
    "Function expressions are not supported; use an arrow function (closure) instead"
  }
  fun code(): ErrorCode {
    SKJSCode(1007)
  }
}

class ExpectedStmt() extends ParsingKind {
  fun toString(): String {
    "A statement was expected"
  }
  fun code(): ErrorCode {
    TSCode(1129)
  }
}

class ExpectedCatchOrFinally() extends ParsingKind {
  fun toString(): String {
    "'catch' or 'finally' expected"
  }
  fun code(): ErrorCode {
    TSCode(1472)
  }
}

class MissingParameterName() extends ParsingKind {
  fun toString(): String {
    "A function parameter must have a name"
  }
  fun code(): ErrorCode {
    TSCode(1003)
  }
}

class EmptyIfStmt() extends ParsingKind {
  fun toString(): String {
    "The body of an 'if' statement cannot be the empty statement"
  }
  fun code(): ErrorCode {
    TSCode(1313)
  }
}

module end;
