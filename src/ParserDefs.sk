/***************************************************************************/
/* Definition parsing methods for the TypeScript parser. */
/***************************************************************************/

module SKJS;

extension class Parser {
  /***************************************************************************/
  // Basic parsing methods for names and symbols
  /***************************************************************************/

  // <name> ::= <string>
  mutable fun getName(): Name {
    this.lex.next() match {
    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))
    | Some(tok) -> Name(this.lex.posRange(tok), this.getVar(tok))
    }
  }

  // <string> | "<string>" | '<string>'
  mutable fun getNameOrString(): Name {
    this.lex.next() match {
    | Some(tok @ Token(TKVar(), _, _)) ->
      Name(this.lex.posRange(tok), this.getVar(tok))
    | Some(tok @ Token(TKQuote(), _, _))
    | Some(tok @ Token(TKDoubleQuote(), _, _)) ->
      Name(this.lex.posRange(tok), this.unquoteString(tok))
    | _ ->
      this.error(
        this.lex.posEnd(),
        ExpectedTokens(Array[TKVar(), TKQuote(), TKDoubleQuote()]),
      )
    }
  }

  // "<string>" | '<string>'
  mutable fun getString(): Name {
    this.lex.next() match {
    | None() ->
      this.error(
        this.lex.posEnd(),
        ExpectedTokens(Array[TKQuote(), TKDoubleQuote()]),
      )
    | Some(tok) -> Name(this.lex.posRange(tok), this.unquoteString(tok))
    }
  }

  // "<string>" | '<string>' | <number>
  mutable fun getNameOrStringOrNumber(): Name {
    this.lex.next() match {
    | Some(tok @ Token(TKVar(), _, _)) ->
      Name(this.lex.posRange(tok), this.getVar(tok))
    | Some(tok @ Token(TKQuote(), _, _))
    | Some(tok @ Token(TKDoubleQuote(), _, _)) ->
      Name(this.lex.posRange(tok), this.unquoteString(tok))
    | Some(tok @ Token(TKNumber(), _, _)) ->
      Name(this.lex.posRange(tok), this.getNumber(tok))
    | Some(tokSub @ Token(TKSubtraction(), _, _)) ->
      nbrTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
      | Some(x) -> x
      };
      Name(this.lex.posRange2(tokSub, nbrTok), "-" + this.getNumber(nbrTok))
    | _ ->
      this.error(
        this.lex.posEnd(),
        ExpectedTokens(
          Array[
            TKVar(),
            TKNumber(),
            TKSubtraction(),
            TKQuote(),
            TKDoubleQuote(),
          ],
        ),
      )
    }
  }

  /***************************************************************************/
  // Symbol parsing
  //
  // <symbol> ::=
  //   | <name>
  //   | [ <name> ]
  //   | [ <name> in <type> (? <type>)? (<fn-op>)? ]
  //   | [ <name> : <type> ]
  /***************************************************************************/

  // Parse a symbol (used in function names and computed property names)
  mutable fun getSymbol(): Symbol {
    if (this.lex.peekKind() is Some(TKOpenSquare())) {
      _ = this.lex.next();
      if (
        this.lex.peekKind() is Some(TKQuote()) ||
        this.lex.peekKind() is Some(TKDoubleQuote()) ||
        this.lex.peekKind() is Some(TKSubtraction()) ||
        this.lex.peekKind() is Some(TKAddition())
      ) {
        name = this.getNameOrStringOrNumber();
        this.expect(TKCloseSquare());
        FNNormal(name);
      } else {
        fname = this.getName();
        if (this.lex.isEq("in")) {
          _ = this.lex.next();
          ty = this.type(0);
          asOpt = if (this.lex.isEq("as")) {
            _ = this.lex.next();
            Some(this.type(0))
          } else {
            None()
          };
          this.expect(TKCloseSquare());
          op = if (this.lex.peekKind() is Some(TKRemoveQM())) {
            Some(FNRemove(this.lex.posRange(this.lex.next().fromSome())))
          } else if (this.lex.peekKind() is Some(TKAddQM())) {
            Some(FNAdd(this.lex.posRange(this.lex.next().fromSome())))
          } else if (this.lex.peekKind() is Some(TKQuestionMark())) {
            Some(FNQuestion(this.lex.posRange(this.lex.next().fromSome())))
          } else {
            None()
          };
          FNIn(fname, ty, asOpt, op)
        } else if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          indexType = this.type(0);
          this.expect(TKCloseSquare());
          FNColon(fname, indexType)
        } else {
          this.expect(TKCloseSquare());
          FNSymbol(fname);
        }
      }
    } else {
      FNNormal(this.getNameOrStringOrNumber())
    }
  }

  /***************************************************************************/
  // Modifier parsing
  //
  // <modifier> =
  //   | abstract
  //   | async
  //   | private
  //   | protected
  //   | public
  //   | readonly
  //   | -readonly
  //   | +readonly
  //   | static
  /***************************************************************************/

  // Parse modifiers for class members and variables
  mutable fun modifiers{allowRemove: Bool}: Modifiers {
    modifiers = mutable Vector[];
    loop {
      if (allowRemove) {
        this.lex.peekKind() match {
        | Some(TKSubtraction()) -> Some(ModRemoveReadonly)
        | Some(TKAddition()) -> Some(ModReadonly)
        | _ -> None()
        } match {
        | Some(mod) ->
          (pos, _void) = this.withPos(
            () -> {
              _ = this.lex.next();
              this.expectStr("readonly")
            },
            ExpectedStr("readonly"),
          );
          modifiers.push(mod(pos));
          continue
        | None() -> void
        }
      };
      mod = this.lex.peekRawStr() match {
      | Some("abstract") -> ModAbstract
      | Some("async") -> ModAsync
      | Some("private") -> ModPrivate
      | Some("protected") -> ModProtected
      | Some("public") -> ModPublic
      | Some("readonly") -> ModReadonly
      | Some("static") -> ModStatic
      | _ -> break void
      };
      modifiers.push(mod(this.lex.posRange(this.lex.next().fromSome())))
    };
    Modifiers(modifiers.toArray())
  }

  /***************************************************************************/
  // Get/Set modifier recognition
  //
  // Recognizes get/set modifiers. In JS, it is legal to write something like:
  // obj = {
  //    get myfield() { ... some code ... }
  // };
  //
  // When you do that, it means that the method "myfield" will be
  // called every time the field "myfield" is accessed. So concretely,
  // if you write obj.myfield, instead of accessing a field, you are
  // really executing a method.
  /***************************************************************************/

  // Check if current token is a getter or setter
  mutable fun isGetSet(): ?FieldGetSet {
    isGet = this.lex.isEq("get");
    if (
      (isGet || this.lex.isEq("set")) &&
      this.lex.lookAhead(() -> {
        _ = this.lex.next();
        this.lex.peekKind() is Some(TKVar()) ||
          this.lex.peekKind() is Some(TKOpenSquare())
      })
    ) {
      kind = if (isGet) FGet() else FSet();
      Some(FieldGetSet(kind, this.lex.posRange(this.lex.next().fromSome())))
    } else {
      None()
    }
  }

  /***************************************************************************/
  // Field parsing
  //
  // Parses fields that are not methods.
  // <field> ::= <name> : <expr> | ... <expr>
  /***************************************************************************/

  // Parse a normal field type (not a method)
  mutable fun getNormalFieldType(
    fieldPosStart: Pos,
    modifiers: Modifiers,
    fieldGetSet: ?FieldGetSet,
    fieldName: Symbol,
    isOptional: ?PosRange,
  ): FieldTypeValue {
    type = if (this.lex.peekKind() is Some(TKColon())) {
      _ = this.lex.next();
      Some(this.type(0))
    } else {
      None()
    };
    fieldValue = if (this.lex.peekKind() is Some(TKAssignment())) {
      _ = this.lex.next();
      Some(this.expr(0))
    } else {
      None()
    };
    FieldTypeValue{
      pos => PosRange::create(this.lex, fieldPosStart, this.lex.getLastPos()),
      setGet => fieldGetSet,
      modifiers,
      name => fieldName,
      optional => isOptional,
      type,
      value => fieldValue,
    }
  }

  // Parse a field type (method or normal field)
  mutable fun getFieldType(modifiers: Modifiers): FieldType {
    fieldGetSet = this.isGetSet();
    fieldPosStart = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())
    | Some(x) -> x.posStart
    };
    fieldName = this.getSymbol();
    isOptional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
      Some(this.lex.posRange(this.lex.next().fromSome()));
    } else {
      None()
    };
    fieldName match {
    | methodName @ SimpleSymbol _ if (
      this.lex.peekKind() is Some(TKOpenParen()) ||
      this.lex.peekKind() is Some(TKLessThan())
    ) ->
      this.methodDef(
        {pos, tparams, params, retType, body} ->
          FieldTypeMethod{
            pos,
            isAsync => None(),
            modifiers,
            isGetSet => fieldGetSet,
            name => Some(methodName),
            optional => isOptional,
            tparams,
            params,
            retType,
            body,
            cgNode => None(),
          },
        Some(methodName),
        true,
      )
    | _ ->
      if (fieldGetSet.isSome()) {
        this.error(
          this.lex.posStart(this.lex.peek().fromSome()),
          ExpectedAccessorDefinition(),
        );
      };
      this.getNormalFieldType(
        fieldPosStart,
        modifiers,
        fieldGetSet,
        fieldName,
        isOptional,
      )
    }
  }

  // Parse object fields (used in object types and classes)
  mutable fun objectFields(): Array<FieldType> {
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Array[];
    };
    fields = mutable Vector<FieldType>[];
    loop {
      modifiers = this.modifiers{allowRemove => true};
      if (
        this.lex.peekKind() is Some(TKOpenParen()) ||
        this.lex.peekKind() is Some(TKLessThan())
      ) {
        method = this.methodDef(
          {pos, tparams, params, retType, body} ->
            FieldTypeMethod{
              pos,
              isAsync => None(),
              modifiers,
              isGetSet => None(),
              name => None(),
              optional => None(),
              tparams,
              params,
              retType,
              body,
              cgNode => None(),
            },
          None(),
          false,
        );
        fields.push(method);
      } else {
        field = this.getFieldType(modifiers);
        fields.push(field)
      };
      semiTok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      semiTok.kind match {
      | TKCloseCurly() ->
        _ = this.lex.next();
        break void
      | TKComma()
      | TKSemi() ->
        _ = this.lex.next();
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ -> void
      }
    };
    fields.toArray()
  }

  /***************************************************************************/
  // Definition parsing
  //
  // <def> ::=
  //   | <expr>
  //   | type <name> [ <type-param>* ] <type>
  //   | class
  //   | enum <name> { (<name> = <expr>?)* }
  //   | namespace <name> { <def>* }
  //   | module <name> { <def>* }
  //   | export (type? <module-names> from <expr>?)
  //   | export (type? default?) <def>
  //   | export default (type?) <expr>
  //   | export = <expr>
  //   | export as <name>
  //   | export import <name> = <expr>
  //   | global { <def>* }
  //   | import (type?) <module-names> <import-name> (from <import-kind>)
  //   | import <name>
  //   | declare <def>
  //   | <var-def-kind> { <var-def>* }
  /***************************************************************************/

  // Parse a definition
  mutable fun def(): Def {
    while (this.lex.peekKind() is Some(TKSemi())) {
      _ = this.lex.next();
    };
    this.defHelper()
  }

  // Parse top-level definitions
  mutable fun toplevelDefs(): Array<Def> {
    defs = mutable Vector[];
    loop {
      this.maybeDef() match {
      | None() -> return defs.toArray()
      | Some(def) -> defs.push(def)
      }
    }
  }

  // Parse a block of definitions
  mutable fun defs(): Array<Def> {
    this.expect(TKOpenCurly());
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Array[]
    };
    defs = mutable Vector[];
    loop {
      def = this.def();
      defs.push(def);
      loop {
        if (this.lex.peekKind() is Some(TKSemi())) {
          _ = this.lex.next();
          continue;
        };
        break void;
      };
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        break defs.toArray()
      }
    }
  }

  // Try to parse a definition, returning None if at end of input
  mutable fun maybeDef(): ?Def {
    while (this.lex.peekKind() is Some(TKSemi())) {
      _ = this.lex.next();
    };
    if (this.lex.peekKind() is None()) return None();
    Some(this.def())
  }

  // Helper for parsing definitions with position tracking
  mutable fun defHelper(): Def {
    (pos, def_) = this.withPos(this.defHelper_, UnterminatedDef());
    Def(pos, def_)
  }

  // Internal definition parsing implementation
  mutable fun defHelper_(): Def_ {
    tok = this.lex.peek() match {
    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
    | Some(x) -> x
    };
    this.getVar(tok) match {
    | "declare" ->
      _ = this.lex.next();
      this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
      | Some(nextTok) ->
        this.defHelper_() match {
        | def @ Declarable _ -> Declare(def)
        | _ ->
          this.error(
            this.lex.posStart(nextTok),
            ExpectedStrings(
              Array[
                "abstract",
                "async",
                "class",
                "const",
                "enum",
                "function",
                "global",
                "interface",
                "let",
                "module",
                "namespace",
                "type",
              ],
            ),
          )
        }
      }
    | "global" ->
      _ = this.lex.next();
      Global(this.defs())
    | "namespace" ->
      _ = this.lex.next();
      name = this.getName();
      defs = this.defs();
      Namespace(name, defs)
    | "import" ->
      _ = this.lex.next();
      isType = if (this.lex.isEq("type")) {
        Some(this.lex.posRange(this.lex.next().fromSome()))
      } else {
        None()
      };
      importNamesList = mutable Vector[];
      loop {
        importNames = this.moduleNames() match {
        | MStar() -> this.error(this.lex.posEnd(), ExpectedStr("as"))
        | importNames @ ImportModuleNames _ -> importNames
        };
        importNamesList.push(importNames);
        if (this.lex.peekKind() is Some(TKComma())) {
          _ = this.lex.next();
        } else {
          break void
        }
      };
      this.expectStr("from");
      importFrom = this.getString();
      Import(isType, importNamesList.toArray(), importFrom)
    | "export" ->
      _ = this.lex.next();
      if (this.lex.isEq("import")) {
        _ = this.lex.next();
        name = this.getName();
        this.expect(TKAssignment());
        e = this.expr(0);
        return ExportImport(name, e);
      };
      if (this.lex.isEq("as")) {
        _ = this.lex.next();
        this.expectStr("namespace");
        return ExportAs(this.getName());
      };
      if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        return ExportEq(this.expr(0));
      };
      if (this.lex.isEq("default")) {
        _ = this.lex.next();
        d = if (
          (this.lex.isEq("function") || this.lex.isEq("class")) &&
          this.lex.lookAhead(() -> {
            _ = this.lex.next();
            this.lex.peekKind() is Some(TKVar())
          })
        ) {
          // Named function or class: parse as def
          this.defHelper_() match {
          | d @ ExportDefaultable _ -> d
          | _ ->
            internal_error(
              "function and class should produce ExportDefaultable defs",
            )
          }
        } else {
          // otherwise parse as expr
          this.expr(0)
        };
        return ExportDefault(d)
      };
      isType = if (
        this.lex.isEq("type") &&
        this.lex.lookAhead(() -> {
          _ = this.lex.next();
          this.lex.peekKind() is Some(TKOpenCurly()) ||
            this.lex.peekKind() is Some(TKMultiplication())
        })
      ) {
        Some(this.lex.posRange(this.lex.next().fromSome()))
      } else {
        None()
      };
      if (
        this.lex.peekKind() is Some(TKOpenCurly()) ||
        this.lex.peekKind() is Some(TKMultiplication())
      ) {
        names = this.moduleNames();
        fromFollows = this.lex.isEq("from");
        (names, fromFollows) match {
        | (n @ MCurly _, false) -> ExportNames(isType, n)
        | (_, false)
        | (MName _, _) ->
          this.error(this.lex.posEnd(), UnexpectedToken())
        | (n @ ExportFromModuleNames _, true) ->
          _ = this.lex.next();
          from = this.getString();
          ExportNamesFrom(isType, n, from)
        }
      } else {
        invariant(isType is None(), "Unexpected form of export type");
        this.lex.peek() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())
        | Some(nextTok) ->
          this.defHelper_() match {
          | Declare(def @ Exportable _) -> ExportDeclare(def)
          | def @ Exportable _ -> Export(def)
          | _ ->
            this.error(
              this.lex.posStart(nextTok),
              ExpectedStrings(
                Array[
                  "abstract",
                  "async",
                  "class",
                  "const",
                  "declare",
                  "enum",
                  "function",
                  "interface",
                  "let",
                  "namespace",
                  "type",
                ],
              ),
            )
          }
        }
      }
    | "async" ->
      asyncPos = this.lex.posRange(this.lex.next().fromSome());
      this.expectStr("function");
      this.topLevelFunDef(Some(asyncPos), true)
    | "function" ->
      _ = this.lex.next();
      this.topLevelFunDef(None(), true)
    | "type" ->
      _ = this.lex.next();
      this.typeDef()
    | "var" ->
      _ = this.lex.next();
      this.varDef(VDKVar())
    | "const" ->
      _ = this.lex.next();
      if (this.lex.isEq("enum")) {
        this.enum(Some(this.lex.posRange(this.lex.next().fromSome())))
      } else {
        this.varDef(VDKConst())
      }
    | "module" ->
      _ = this.lex.next();
      name = this.getNameOrString();
      defs = if (this.lex.peekKind() is Some(TKOpenCurly())) {
        Some(this.defs())
      } else {
        None()
      };
      Module(name, defs)
    | "abstract" ->
      _ = this.lex.next();
      this.expectStr("class");
      this.class_(CKAbstract())
    | "enum" ->
      _ = this.lex.next();
      this.enum(None())
    | "interface" ->
      _ = this.lex.next();
      this.class_(CKInterface())
    | "class" ->
      _ = this.lex.next();
      this.class_(CKClass())
    | "let" ->
      _ = this.lex.next();
      this.varDef(VDKLet())
    | _ -> this.expr(0)
    }
  }

  /***************************************************************************/
  // Module name parsing
  /***************************************************************************/

  // Parse module names in import/export statements
  mutable fun moduleNames(): ModuleNames {
    if (this.lex.peekKind() is Some(TKMultiplication())) {
      _ = this.lex.next();
      if (this.lex.isEq("as")) {
        _ = this.lex.next();
        MStarAs(this.getName())
      } else {
        MStar()
      };
    } else if (this.lex.peekKind() is Some(TKOpenCurly())) {
      _ = this.lex.next();
      if (this.lex.peekKind() is Some(TKCloseCurly())) {
        _ = this.lex.next();
        MCurly(Array[]);
      } else {
        names = this.curlyNames();
        MCurly(names)
      }
    } else {
      MName(this.getName());
    }
  }

  // Parse curly-braced names in imports
  mutable fun curlyNames(): Array<ModuleDefName> {
    names = mutable Vector[];
    loop {
      isType = if (
        this.lex.isEq("type") &&
        this.lex.lookAhead(() -> {
          _ = this.lex.next();
          this.lex.peekKind() is Some(TKVar())
        })
      ) {
        Some(this.lex.posRange(this.lex.next().fromSome()))
      } else {
        None()
      };
      name = this.getName();
      asName = if (this.lex.isEq("as")) {
        _ = this.lex.next();
        Some(this.getName())
      } else {
        None()
      };
      names.push(ModuleDefName(isType, name, asName));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedImport())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseCurly() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokens(Array[TKCloseCurly(), TKComma()]),
        )
      }
    };
    names.toArray()
  }

  /***************************************************************************/
  // Variable definition parsing
  //
  // <var-def> ::= <pattern> (: <type>)? (= <expr>)?
  /***************************************************************************/

  // Parse variable definitions
  mutable fun varDef(kind: VarDefKind): VarDefs {
    // Track symbol context for the entire variable definition block
    contextInfo = if (
      kind is VDKConst() &&
      this.getCurrentSymbol() is SPTopLevel()
    ) {
      (prevSymbol, prevPos) = this.getCurrentSymbolContext();
      Some((prevSymbol, prevPos))
    } else {
      None()
    };

    defs = mutable Vector[];
    loop {
      pat = this.pattern();

      // Track top-level constants as symbols
      if (kind is VDKConst() && this.getCurrentSymbol() is SPTopLevel()) {
        pat.value match {
        | PVar(name) ->
          constSymbol = SPConstant(name.value);
          symbolContextPos = name.pos.relStart.value;
          // Use the relative position since we're at top level (SPTopLevel)
          this.recordSymbolDefinition(constSymbol, symbolContextPos);
          this.setSymbolContext(constSymbol, symbolContextPos)
        | _ ->
          void // Only track simple variable patterns
        }
      };

      type = if (this.lex.peekKind() is Some(TKColon())) {
        this.expect(TKColon());
        Some(this.type(0));
      } else {
        None()
      };
      value = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        Some(this.expr(0));
      } else {
        None()
      };
      defs.push(VarDef(pat, type, value));

      commaTok = this.lex.peek() match {
      | None() -> break void
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKSemi() ->
        _ = this.lex.next();
        break void
      | TKComma() ->
        _ = this.lex.next();
        continue
      | _ -> break void
      }
    };

    // Restore previous symbol context if we were parsing constants
    contextInfo match {
    | Some((prevSymbol, prevPos)) -> this.setSymbolContext(prevSymbol, prevPos)
    | None() -> void
    };

    VarDefs(kind, defs.toArray())
  }

  /***************************************************************************/
  // Type definition parsing
  /***************************************************************************/

  // Parse type definitions
  mutable fun typeDef(): TypeDef {
    name = this.getName();
    tdefParams = if (this.lex.peekKind() is Some(TKLessThan())) {
      _ = this.lex.next();
      this.typeDefsParams();
    } else {
      Array[]
    };
    this.expect(TKAssignment());
    body = this.type(0);
    if (this.lex.peekKind() is Some(TKSemi())) {
      _ = this.lex.next();
    };
    TypeDef{name, body, tdefParams}
  }

  // Parse enum definitions
  mutable fun enum(isConst: ?PosRange): Enum {
    name = this.getName();
    this.expect(TKOpenCurly());
    if (this.lex.peekKind() is Some(TKCloseCurly())) {
      _ = this.lex.next();
      return Enum(isConst, name, Array[]);
    };
    fields = mutable Vector<(Name, ?Expr)>[];
    loop {
      fieldName = this.getName();
      fieldValue = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        Some(this.expr(0));
      } else {
        None()
      };
      fields.push((fieldName, fieldValue));
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKCloseCurly() -> break void
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKCloseCurly())) {
          _ = this.lex.next();
          break void
        }
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokens(Array[TKCloseCurly(), TKComma()]),
        )
      }
    };
    Enum(isConst, name, fields.toArray())
  }

  // Parse class definitions
  mutable fun class_(kind: ClassKind): Class {
    name = this.getName();
    // Record the class definition and set context
    classSymbol = SPClass(name.value);
    symbolContextPos = this.lex.pos;
    this.recordSymbolDefinition(classSymbol, symbolContextPos);
    (prevSymbol, prevPos) = this.getCurrentSymbolContext();
    this.setSymbolContext(classSymbol, symbolContextPos);

    tparams = if (this.lex.peekKind() is Some(TKLessThan())) {
      _ = this.lex.next();
      this.typeDefsParams();
    } else {
      Array[]
    };
    extends_ = if (this.lex.isEq("extends")) {
      extends_ = mutable Vector[];
      loop {
        _ = this.lex.next();
        ty = this.type(0);
        extends_.push(ty);
        if (!(this.lex.peekKind() is Some(TKComma()))) {
          break extends_.toArray()
        }
      }
    } else {
      Array[]
    };
    implements = if (this.lex.isEq("implements")) {
      implements = mutable Vector[];
      loop {
        _ = this.lex.next();
        ty = this.type(0);
        implements.push(ty);
        if (!(this.lex.peekKind() is Some(TKComma()))) {
          break implements.toArray()
        }
      }
    } else {
      Array[]
    };
    this.expect(TKOpenCurly());
    fields = this.objectFields();

    // Restore previous context
    this.setSymbolContext(prevSymbol, prevPos);

    /* Desugar parameter properties */

    parameterProperties = mutable Vector[];
    !fields = fields.map(field ->
      field match {
      | fd @ FieldTypeMethod{name => Some(FNNormal(Name(_, "constructor")))} ->
        initializationStatements = mutable Vector[];
        !fd.params = fd.params.map(param -> {
          param match {
          | Param(
            _pos,
            modifiers,
            /* isRest */ None(),
            Pattern(pos, PVar(pName)),
            /* optional */ None(),
            type,
            default,
          ) ->
            isParameterProperty = false;
            !param.modifiers.modifiers = modifiers.modifiers.filter(modifier ->
              modifier match {
              | ModPrivate _
              | ModProtected _
              | ModPublic _
              | ModReadonly _ ->
                !isParameterProperty = true;
                false
              | _ -> true
              }
            );
            if (isParameterProperty) {
              parameterProperties.push(
                FieldTypeValue{
                  pos,
                  setGet => None(),
                  name => FNNormal(pName),
                  optional => None(),
                  type,
                  value => default,
                  modifiers,
                },
              );
              eThis = Expr(pos, Var(Name(pos, "this")));
              eName = Expr(pos, Var(pName));
              eThisDotName = Expr(pos, Dot(NormalDot(), eThis, pName));
              eAssign = Expr(pos, Binop(BOAssignment(), eThisDotName, eName));
              initializationStatements.push(Stmt(pos, StmtExpr(eAssign)))
            }
          | _ -> void
          };
          param
        });
        fd.body match {
        | FDBNone _ -> void
        | FDBSome(stmts) ->
          !stmts = initializationStatements.toArray().concat(stmts);
          !fd.body = FDBSome(stmts)
        };
        fd
      | _ -> field
      }
    );
    !fields = fields.concat(parameterProperties.toArray());

    Class{kind, name, extends_, implements, tparams, fields}
  }

  /***************************************************************************/
  // Type parameter parsing
  /***************************************************************************/

  // Parse type definition parameters
  mutable fun typeDefsParams(): Array<TypeParam> {
    tdparams = mutable Vector[];
    loop {
      name = this.getName();
      constr = if (this.lex.isEq("extends")) {
        _ = this.lex.next();
        Some(this.type(0))
      } else {
        None()
      };
      default = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        ty = this.type(0);
        Some(ty)
      } else {
        None()
      };
      this.!id = this.id + 1;
      tdparams.push(
        TypeParam(
          Id::create(name.value, this.id, this.lex),
          name,
          constr,
          default,
        ),
      );
      tokComma = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedType())
      | Some(x) -> x
      };
      tokComma.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKGreaterThan())) {
          _ = this.lex.next();
          return tdparams.toArray()
        }
      | TKGreaterThan() -> return tdparams.toArray()
      | _ ->
        this.error(
          this.lex.posStart(tokComma),
          ExpectedTokens(Array[TKGreaterThan(), TKComma()]),
        )
      }
    }
  }

  // Parse type parameters for functions and classes
  mutable fun typeParams(): Array<TypeParam> {
    result = mutable Vector[];
    loop {
      tparamName = this.getName();
      tparamType = if (this.lex.isEq("extends")) {
        _ = this.lex.next();
        ty = this.type(0);
        Some(ty)
      } else {
        None()
      };
      default = if (this.lex.peekKind() is Some(TKAssignment())) {
        _ = this.lex.next();
        Some(this.type(0))
      } else {
        None()
      };
      this.!id = this.id + 1;
      result.push(
        TypeParam(
          Id::create(tparamName.value, this.id, this.lex),
          tparamName,
          tparamType,
          default,
        ),
      );
      commaTok = this.lex.next() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
      | Some(x) -> x
      };
      commaTok.kind match {
      | TKComma() ->
        if (this.lex.peekKind() is Some(TKGreaterThan())) {
          _ = this.lex.next();
          return result.toArray()
        }
      | TKGreaterThan() -> return result.toArray()
      | _ ->
        this.error(
          this.lex.posStart(commaTok),
          ExpectedTokens(Array[TKGreaterThan(), TKComma()]),
        )
      }
    }
  }

  /***************************************************************************/
  // Function definition parsing
  //
  // <fun-def> ::=
  //   (async?) <modifiers>? (get | set?)
  //     <symbol>? [ < <type-param>* > ]? ( <param>* )
  //       (: <type>?)
  //     <fun-def-body>
  /***************************************************************************/

  // Parse function definitions
  mutable fun topLevelFunDef(
    isAsync: ?PosRange,
    parseBlock: Bool,
  ): TopLevelFunDef {
    funName = this.getName();
    // Record the function definition and set context
    funcSymbol = SPFunction(funName.value);
    symbolContextPos = this.lex.pos;
    this.recordSymbolDefinition(funcSymbol, symbolContextPos);
    (prevSymbol, prevPos) = this.getCurrentSymbolContext();
    this.setSymbolContext(funcSymbol, symbolContextPos);

    cgNode = None(); // TODO: Add call graph support back

    result = this.methodDef(
      {pos, tparams, params, retType, body} ->
        TopLevelFunDef{
          pos,
          isAsync,
          modifiers => Modifiers::empty(),
          isGetSet => None(),
          name => Some(FNNormal(funName)),
          optional => None(),
          tparams,
          params,
          retType,
          body,
          cgNode,
        },
      Some(FNNormal(funName)),
      parseBlock,
    );

    // Restore previous context
    this.setSymbolContext(prevSymbol, prevPos);
    result
  }

  // Parse method definitions
  mutable fun methodDef<T>(
    mk: {
      pos: PosRange,
      tparams: Array<TypeParam>,
      params: Array<Param>,
      retType: (PosRange, ?Type),
      body: FunDefBody,
    } -> T,
    funName: ?SimpleSymbol,
    parseBlock: Bool,
  ): T {
    // Record method/function definition and set context
    (prevSymbol, prevPos) = this.getCurrentSymbolContext();
    (funName, this.getCurrentSymbol()) match {
    | (Some(FNNormal(name)), SPClass(className)) ->
      methodSymbol = SPMethod(className, name.value);
      symbolContextPos = this.lex.pos;
      this.recordSymbolDefinition(methodSymbol, symbolContextPos);
      this.setSymbolContext(methodSymbol, symbolContextPos)
    | (Some(FNNormal(name)), _) ->
      funcSymbol = SPFunction(name.value);
      symbolContextPos = this.lex.pos;
      this.recordSymbolDefinition(funcSymbol, symbolContextPos);
      this.setSymbolContext(funcSymbol, symbolContextPos)
    | _ ->
      void // Keep current context for anonymous methods
    };

    funStart = this.lex.getLastPos();
    tparams = if (this.lex.peekKind() is Some(TKLessThan())) {
      _ = this.lex.next();
      this.typeParams();
    } else {
      Array[]
    };
    params = mutable Vector[];
    this.expect(TKOpenParen());
    this.lex.peekKind() match {
    | Some(TKCloseParen()) ->
      _ = this.lex.next();
      void
    | _ ->
      loop {
        modifiers = this.modifiers{allowRemove => false};
        isRest = if (this.lex.peekKind() is Some(TKDotDotDot())) {
          Some(this.lex.posRange(this.lex.next().fromSome()))
        } else {
          None()
        };
        paramName = this.pattern();
        optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {
          Some(this.lex.posRange(this.lex.next().fromSome()))
        } else {
          None()
        };
        paramType = if (this.lex.peekKind() is Some(TKColon())) {
          _ = this.lex.next();
          Some(this.type(0))
        } else {
          None()
        };
        paramValue = if (this.lex.peekKind() is Some(TKAssignment())) {
          _ = this.lex.next();
          Some(this.expr(0))
        } else {
          None()
        };
        params.push(
          Param(
            paramName.pos,
            modifiers,
            isRest,
            paramName,
            optional,
            paramType,
            paramValue,
          ),
        );
        nextTok = this.lex.next() match {
        | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
        | Some(x) -> x
        };
        nextTok.kind match {
        | TKCloseParen() -> break void
        | TKComma() ->
          if (this.lex.peekKind() is Some(TKCloseParen())) {
            _ = this.lex.next();
            break void;
          }
        | _ ->
          this.error(
            this.lex.posStart(nextTok),
            ExpectedTokens(Array[TKCloseParen(), TKComma()]),
          )
        }
      }
    };
    retType = if (this.lex.peekKind() is Some(TKColon())) {
      this.expect(TKColon());
      (retPos, retType) = this.withPos(() -> this.type(0), UnterminatedType());
      (retPos, Some(retType))
    } else {
      start = this.lex.getLastPos();
      end = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
      | Some(x) -> x.posStart
      };
      (PosRange::create(this.lex, start, end), None())
    };
    body = if (parseBlock) {
      bodyTok = this.lex.peek() match {
      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())
      | Some(x) -> x
      };
      bodyTok.kind match {
      | TKOpenCurly() -> FDBSome(this.blockOrStmt())
      | _ -> FDBNone(this.lex.posRange(bodyTok))
      }
    } else {
      FDBNone(this.lex.posRange(this.lex.lastTok.fromSome()))
    };
    funEnd = this.lex.getLastPos();

    // Restore previous context
    this.setSymbolContext(prevSymbol, prevPos);
    mk{
      pos => PosRange::create(this.lex, funStart, funEnd),
      tparams => tparams,
      params => params.toArray(),
      retType,
      body,
    }
  }
}

module end;
