/*****************************************************************************/
/* Type-checker for SKJS */
/*****************************************************************************/

module SKJS;

/*****************************************************************************/
/* The local environment. */
/*****************************************************************************/

value class LocalRef(type: TType, isInitialized: Bool)

mutable class Scope{
  id: Int,
  isLoop: Bool,
  up: ?readonly Scope = None(),
  mutable locals: SortedMap<String, Name> = SortedMap[],
  mutable refs: SortedMap<String, LocalRef> = SortedMap[],
} {
  readonly fun clone(): Scope {
    Scope{
      id => this.id,
      isLoop => this.isLoop,
      up => this.up.map(x -> x.clone()),
      locals => this.locals,
      refs => this.refs,
    }
  }

  static fun fromSaved(saved: Scope): mutable Scope {
    mutable Scope{
      id => saved.id,
      isLoop => saved.isLoop,
      up => saved.up.map(x -> static::fromSaved(x)),
      locals => saved.locals,
      refs => saved.refs,
    }
  }

  readonly private fun maybeGetLocal(name: Name): ?Name {
    this.locals.maybeGet(name.value) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetLocal(name)
      }
    | Some(x) -> Some(x)
    }
  }

  readonly private fun getLocal(name: Name): Name {
    this.maybeGetLocal(name) match {
    | None() -> typingError(Array[(name.posRange, "Unbound name")])
    | Some(x) -> x
    }
  }

  readonly private fun maybeGetRefHelper(
    throughLoop: Bool,
    name: String,
  ): ?(Bool, LocalRef) {
    !throughLoop = this.isLoop || throughLoop;
    this.refs.maybeGet(name) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetRefHelper(throughLoop, name)
      }
    | Some(x) -> Some((throughLoop, x))
    }
  }

  readonly private fun maybeGetRef(name: String): ?(Bool, LocalRef) {
    this.maybeGetRefHelper(false, name)
  }

  mutable fun bind(name: Name, ty: TType, isInitialized: Bool): void {
    this.maybeGetLocal(name) match {
    | None() ->
      this.!locals[name.value] = name;
      this.!refs[name.value] = LocalRef(ty, isInitialized)
    | Some(otherDef) ->
      typingError(
        Array[
          (name.posRange, name.value + " is already defined"),
          (otherDef.posRange, "Previous definition was here"),
        ],
      )
    }
  }

  readonly fun isThroughLoop(name: Name): Bool {
    this.maybeGetRef(name.value) match {
    | None() -> false
    | Some((isThroughLoop, _)) -> isThroughLoop
    }
  }

  readonly fun maybeGet(name: Name): ?TType {
    this.maybeGetRef(name.value) match {
    | None() -> None()
    | Some((_, ref)) ->
      if (!ref.isInitialized) {
        typingError(
          Array[(name.posRange, "This local is not fully initialized")],
        )
      } else {
        Some(ref.type)
      }
    }
  }

  readonly fun get(name: Name): TType {
    this.maybeGet(name) match {
    | None() -> typingError(Array[(name.posRange, "Unbound name")])
    | Some(x) -> x
    }
  }

  mutable fun set(
    name: Name,
    ty: TType,
    isSubType: (TType, TType) -> void,
  ): void {
    (throughLoop, upRef) = this.maybeGetRef(name.value) match {
    | None() ->
      typingError(Array[(name.posRange, "Unbound name: " + name.value)])
    | Some(x) -> x
    };
    if (throughLoop) {
      isSubType(ty, upRef.type);
      this.!refs[name.value] = LocalRef(ty, true);
    } else {
      this.!refs[name.value] = LocalRef(ty, true)
    }
  }

  readonly fun escapingRefs(): mutable Iterator<(String, LocalRef)> {
    this.refs.items().filter(x -> !this.locals.containsKey(x.i0))
  }

  mutable fun merge(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    invariant(scope1.up.map(x -> x.id) == Some(this.id));
    invariant(scope2.up.map(x -> x.id) == Some(this.id));
    _ = mapUnion(
      scope1.escapingRefs(),
      scope2.escapingRefs(),
      x ~> x.i0,
      (nameRef) -> {
        (name, ref) = nameRef;
        (_, upRef) = this.maybeGetRef(name).fromSome();
        this.!refs[name] = LocalRef(
          unionTType(subst, tenv, upRef.type, ref.type),
          upRef.isInitialized,
        );
        nameRef
      },
      (nameRef1, nameRef2) -> {
        (name1, ref1) = nameRef1;
        (name2, ref2) = nameRef2;
        invariant(name1 == name2);
        this.!refs[name1] = LocalRef(
          unionTType(subst, tenv, ref1.type, ref2.type),
          ref1.isInitialized && ref2.isInitialized,
        );
        nameRef1
      },
    );
  }
}

/*****************************************************************************/
/* The mutable environment used by the type-checker. */
/*****************************************************************************/

mutable class TCEnv(
  context: mutable SKStore.Context,
  subst: mutable Subst,
  mutable scope: mutable Scope,
  mutable localObjects: mutable Map<String, ?TType> = mutable Map[],
  mutable usedObjects: mutable Map<String, PosRange> = mutable Map[],
  mutable counter: Int = 0,
) {
  mutable fun next(): Int {
    this.!counter = this.counter + 1;
    this.counter
  }

  mutable fun mergeScope(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    this.scope.merge(subst, tenv, scope1, scope2);
  }

  mutable fun popScope(
    subst: mutable Subst,
    tenv: TEnv,
    scope: readonly Scope,
  ): void {
    invariant(scope.up.fromSome().id == this.scope.id);
    this.scope.merge(
      subst,
      tenv,
      scope,
      mutable Scope{id => this.next(), isLoop => false, up => Some(this.scope)},
    );
  }

  mutable fun popScopeReplace(scope: readonly Scope): void {
    invariant(scope.up.fromSome().id == this.scope.id);
    for (nameRef in scope.escapingRefs()) {
      (name, ref) = nameRef;
      this.scope.!refs[name] = ref;
    }
  }
}

/*****************************************************************************/
/* Type-checker */
/*****************************************************************************/

class TypeChecker{
  builtins: Set<String>,
  builtinsFileName: FileName,
  backtrace: Bool,
  defMap: DefMap,
  tenv: TEnv,
  super: ?TType = None(),
  isAsync: Bool = false,
  retType: ?TType = None(),
} {
  fun check(context: mutable SKStore.Context, defs: Array<Def>): Array<Error> {
    errors = mutable Vector[];
    for (def in defs) {
      if (this.backtrace) this.checkDef(context, def) else {
        try {
          this.checkDef(context, def)
        } catch {
        | ErrorExn(err) -> errors.push(err)
        | exn -> throw exn
        }
      }
    };
    errors.toArray()
  }

  fun checkDef(context: mutable SKStore.Context, def: Def): void {
    def.value match {
    | ExportImport _ -> notSupported(def.pos)
    | ImportExpr _ -> void
    | Global _ -> notSupported(def.pos)
    | ExportAs _ -> notSupported(def.pos)
    | ExportEq _ -> notSupported(def.pos)
    | Module _ -> notSupported(def.pos)
    | ToplevelExpr(e) ->
      subst = mutable Subst{context};
      scope = mutable Scope{id => 0, isLoop => false};
      env = mutable TCEnv(context, subst, scope);
      ty = this.expr(env, e);
      this.checkIsVoid(env, e.posRange, ty)
    | fd @ FunDef _ -> this.funDef(context, None(), fd)
    | Declare _ -> void
    | Namespace _ -> notSupported(def.pos)
    | Export(_, _, d) -> this.checkDef(context, Def(def.pos, d))
    | ExportDefault _ -> notSupported(def.pos)
    | ExportNames _ -> void
    | Import _ -> void
    | c @ Class _ -> this.class_(context, c)
    | Enum _ -> notSupported(def.pos)
    | VarDefs(kind, varDefs) -> this.varDefs(context, kind, varDefs)
    | TypeDef _ -> void
    }
  }

  fun varDefs(
    context: mutable SKStore.Context,
    kind: VarDefKind,
    varDefs: Array<VarDef>,
  ): void {
    for (varDef in varDefs) {
      kind match {
      | VDKConst() -> void
      | VDKLet() -> notSupported(varDef.pat.pos, "toplevel let")
      | VDKVar() -> notSupported(varDef.pat.pos, "toplevel var")
      };
      literalType = varDef.value match {
      | None() -> None()
      | Some(x) -> this.makeLiteralType(x)
      };
      type = varDef.type match {
      | None() ->
        literalType match {
        | Some(ty) -> ty
        | _ -> typingError(Array[(varDef.pat.pos, "Missing type annotation")])
        }
      | Some(x) -> this.tenv.normalize(context, x)
      };
      varDef.pat.value match {
      | PVar _ -> void
      | PArray _ /* (Array<Pattern>) */
      | PObject _ /* (Array<(Name, Pattern)>) */ ->
        invariant_violation("TODO pattern varDef")
      };
      e = varDef.value match {
      | None() -> typingError(Array[(varDef.pat.pos, "Missing definition")])
      | Some(x) -> x
      };
      subst = mutable Subst{context};
      scope = mutable Scope{id => 0, isLoop => false};
      env = mutable TCEnv(context, subst, scope);
      this.checkSubType(
        env,
        varDef.pat.pos,
        "Invalid definition",
        literalType match {
        | None() -> this.expr(env, e)
        | Some(litType) -> litType
        },
        type,
      )
    }
  }

  fun class_(context: mutable SKStore.Context, c: Class): void {
    targs = TArgs(
      c.tparams.map(tparam -> {
        ttypeParam = TParam(
          tparam.name.value,
          tparam.name.posRange.fileName,
          tparam.id,
          tparam.constraint.map(c -> this.tenv.normalize(context, c)),
        );
        TType::fromTParams(
          tparam.name.posRange,
          TTypeParams(Array[Array[ttypeParam]]),
        )
      }),
    );
    !this.tenv = this.tenv.addTParams(context, c.tparams);
    subst = mutable Subst{context};
    cstr = TType::inst(c.name, targs);
    thisType = TType::fromTParams(
      c.name.posRange,
      TTypeParams(
        Array[Array[TParam("this", c.name.posRange.fileName, -1, Some(cstr))]],
      ),
    );
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        typingError(
          Array[(c.name.posRange, "Cannot extend more than one class")],
        )
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentName, parentTArgs) ->
          super = this.tenv.new(
            context,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
          );
          if (!isInterface) {
            !this.super = Some(super);
          };
          scope = mutable Scope{id => 0, isLoop => false};
          env = mutable TCEnv(context, subst, scope);
          this.checkSubType(
            env,
            parentName.posRange,
            "Invalid extends",
            thisType,
            super,
          )
        | _ -> typingError(Array[(c.name.posRange, "Invalid extend")])
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        super = this.tenv.new(
          context,
          parentName,
          parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
        );
        scope = mutable Scope{id => 0, isLoop => false};
        env = mutable TCEnv(context, subst, scope);
        this.checkSubType(
          env,
          parentName.posRange,
          "Invalid implements",
          thisType,
          super,
        )
      | _ -> typingError(Array[(c.name.posRange, "Invalid implements")])
      }
    };
    hasConstructor = false;
    for (fieldType in c.fields) {
      fieldType match {
      | field @ FieldTypeValue _ ->
        field.setGet match {
        | None() -> void
        | Some(FieldGetSet(_, pos)) -> notSupported(pos)
        };
        for (modifier in field.modifiers.modifiers) {
          typingError(Array[(modifier.posRange, "TODO: field modifier")])
        };
        type = field.type match {
        | None() -> typingError(Array[(field.pos, "Missing type annotation")])
        | Some(ty) -> this.tenv.normalize(context, ty)
        };
        field.value match {
        | None() -> void
        | Some(e) ->
          scope = mutable Scope{id => 0, isLoop => false};
          env = mutable TCEnv(context, subst, scope);
          this.checkSubType(
            env,
            e.posRange,
            "Invalid assignment",
            type,
            this.expr(env, e),
          )
        }
      | fd @ FunDef _ ->
        if (fd.name is Some(FNNormal(Name(_, "constructor")))) {
          !hasConstructor = true;
          partialThisType = this.tenv.new(
            context,
            c.name,
            targs.targs,
            fieldType ~> (fieldType is FieldTypeValue{value => Some _}),
          );
          _ = this.constructor(context, thisType, partialThisType, fd)
        } else {
          _ = this.funDef(context, Some((c.kind, thisType)), fd)
        }
      }
    };
    if (c.kind is CKInterface() || c.kind is CKAbstract()) return void;
    if (!hasConstructor) {
      for (fieldType in c.fields) {
        fieldType match {
        | field @ FieldTypeValue _ ->
          field.value match {
          | None() ->
            if (field.optional is None()) {
              typingError(Array[(field.pos, "Uninitialized field")])
            }
          | Some(_) -> void
          }
        | FunDef _ -> void
        }
      }
    }
  }

  static fun uninitializedThisType(pos: PosRange): TType {
    TType::single(pos, TObject(TFields::create(Array[]), pos));
  }

  fun funDefSetup(
    context: mutable SKStore.Context,
    thisTypeOpt: ?TType,
    fd: FunDef,
  ): (this, mutable TCEnv) {
    subst = mutable Subst{context};
    scope = mutable Scope{id => 0, isLoop => false};
    env = mutable TCEnv(context, subst, scope);
    thisTypeOpt match {
    | None() -> void
    | Some(thisType) ->
      !this.tenv.subst["this"] = (false, thisType);
      scope.bind(Name(fd.pos, "this"), thisType, true)
    };
    !this.tenv = this.tenv.addTParams(context, fd.tparams);
    for (i => param in fd.params) {
      (paramName, tyOpt) = param.name match {
      | PNName(n, ty) -> (n, ty)
      | PNDDD(name) ->
        if (i != fd.params.size() - 1) {
          typingError(
            Array[(name.posRange, "... should be the last parameter")],
          )
        };
        (name, None())
      | _ ->
        typingError(
          Array[
            (param.pos, "TODO: support for patterns in function parameters"),
          ],
        )
      };
      paramType = tyOpt match {
      | None() ->
        param.type match {
        | None() -> typingError(Array[(param.pos, "Missing type annotation")])
        | Some(ty) -> ty
        }
      | Some(x) -> x
      };
      scope.bind(paramName, this.tenv.normalize(context, paramType), true)
    };
    !this.retType = fd.retType.i1.map(rty -> this.tenv.normalize(context, rty));
    (this, env)
  }

  fun funDef(
    context: mutable SKStore.Context,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDef,
  ): void {
    modifiersMap = fd.modifiers.modifiers;
    if (
      modifiersMap.containsKey("protected") ||
      modifiersMap.containsKey("private") ||
      modifiersMap.containsKey("public") ||
      modifiersMap.containsKey("abstract") ||
      modifiersMap.containsKey("readonly")
    ) {
      typingError(
        Array[
          (
            fd.modifiers.modifiers.firstItem().i1.posRange,
            "TODO: support for method modifiers",
          ),
        ],
      );
    };
    if (modifiersMap.containsKey("static")) {
      !thisTypeOpt = None();
    };
    (!this, env) = this.funDefSetup(context, thisTypeOpt.map(x -> x.i1), fd);
    if (this.retType is None()) {
      typingError(Array[(fd.retType.i0, "Missing return type")])
    };
    retType = this.retType.fromSome();
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      !this.isAsync = true;
      tvar = env.subst.gen(asyncPos);
      type = TType::fromTInst(asyncPos, tvar);
      this.checkSubType(
        env,
        asyncPos,
        "Async functions must return an object of type Promise<_>",
        retType,
        TType::single(asyncPos, TPromise(type, asyncPos)),
      )
    };
    fd.body match {
    | FDBNone(pos) ->
      if (thisTypeOpt is Some((CKClass(), _))) {
        typingError(Array[(pos, "Missing definition")])
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        typingError(Array[(fd.pos, "An interface cannot implement a method")])
      };
      _ = this.block(env, body);
      if (isTerminalBlock(false, body)) return void;
      if (this.isVoid(env, retType)) return void;
      typingError(
        Array[(fd.pos, "This function does not always return a value")],
      )
    };
  }

  fun isVoid(env: mutable TCEnv, ty: TType): Bool {
    ty.expand(env.subst, this.tenv) match {
    | None() -> false
    | Some((stypes, tparams)) ->
      tparams.tparams.size() == 0 &&
        stypes.stypes.size() == 1 &&
        stypes.stypes[0] match {
        | TPrimVoid(TVoid(), _) -> true
        | _ -> false
        }
    }
  }

  fun constructor(
    context: mutable SKStore.Context,
    thisType: TType,
    partialThisType: TType,
    fd: FunDef,
  ): void {
    if (fd.retType.i1 is Some _) {
      typingError(
        Array[(fd.retType.i0, "Constructors don't have return types")],
      );
    };
    if (!fd.modifiers.modifiers.isEmpty()) {
      typingError(
        Array[
          (
            fd.modifiers.modifiers.firstItem().i1.posRange,
            "Constructors cannot have modifiers",
          ),
        ],
      );
    };
    (!this, env) = this.funDefSetup(context, Some(partialThisType), fd);
    env.localObjects!["this"] = Some(thisType);
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      typingError(Array[(asyncPos, "Constructors cannot be async")])
    };
    fd.body match {
    | FDBNone(pos) -> typingError(Array[(pos, "Missing definition")])
    | FDBSome(body) ->
      blockScope = this.block(env, body);
      objType = filterMethods(
        env.subst,
        this.tenv,
        blockScope.get(Name(fd.pos, "this")),
      );
      fullType = filterMethods(env.subst, this.tenv, thisType);
      this.checkSubType(
        env,
        fd.pos,
        "Invalid initialization",
        objType,
        fullType,
      )
    };
  }

  fun block(
    env: mutable TCEnv,
    stmts: Array<Stmt>,
    cond: ?(Expr, Bool) = None(),
  ): mutable Scope {
    scopeCopy = env.scope;
    scope = mutable Scope{
      id => env.next(),
      isLoop => false,
      up => Some(env.scope),
    };
    env.!scope = scope;
    cond match {
    | None() -> void
    | Some((c, target)) -> this.evalCond(env, c, target)
    };
    for (st in stmts) {
      this.stmt(env, st)
    };
    env.!scope = scopeCopy;
    scope
  }

  fun checkSubType(
    env: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
  ): void {
    isSubTType(env.subst, this.tenv, ty1, ty2) match {
    | STOk() -> void
    | STError(SRec(reason, pos1, subTy2)) ->
      typingError(
        Array[
          (pos, msg),
          (
            pos1,
            reason.toString(
              env.subst,
              this.tenv,
              expandTVars(env.subst, this.tenv, ty1),
            ),
          ),
          (
            subTy2.pos,
            "It is incompatible with: " +
              expandTVars(env.subst, this.tenv, subTy2).toString(),
          ),
        ],
      )
    | status ->
      typingError(Array[(pos, status.toString(env.subst, this.tenv, ty1))])
    }
  }

  fun bind(
    env: mutable TCEnv,
    kind: BindKind,
    pat: Pattern,
    type: TType,
    isInitialized: Bool,
    isLocalObject: Bool,
  ): void {
    pos = pat.pos;
    pat.value match {
    | PVar(local) ->
      if (
        isLocalObject &&
        !env.scope.isThroughLoop(local) &&
        !env.localObjects.containsKey(local.value)
      ) {
        env.localObjects![local.value] = None()
      };
      env.scope.bind(local, type, isInitialized)
    | PArray(arrPat) ->
      stypes = type.getSTypes(env.subst, this.tenv);
      for (stype in stypes.stypes) {
        stype match {
        | TTuple(tyl, _) ->
          if (arrPat.size() != tyl.size()) {
            typingError(
              Array[
                (
                  pos,
                  "Invalid tuple pattern size, it is of size " + arrPat.size(),
                ),
                (
                  type.pos,
                  "It is incompatible with a tuple of size " + tyl.size(),
                ),
              ],
            )
          };
          for (i in Range(0, arrPat.size())) {
            this.bind(env, kind, arrPat[i], tyl[i], isInitialized, false)
          }
        | _ ->
          typingError(
            Array[
              (pos, "Invalid tuple pattern"),
              (type.pos, "This is not a tuple, it is " + type.toString()),
            ],
          )
        }
      }

    | PObject(objectFields) ->
      stypes = type.getSTypes(env.subst, this.tenv);
      for (stype in stypes.stypes) {
        branches = stype match {
        | TObject(fields, _) -> Array[fields]
        | a @ TAlgebraic _ -> a.branches.map(x -> x.fields)
        | _ ->
          typingError(
            Array[
              (pos, "Invalid object pattern"),
              (type.pos, "This is " + type.toString()),
            ],
          )
        };
        for (field in objectFields) {
          (fieldName, fieldPat) = field;
          for (fields in branches) {
            fields.maybeGet(fieldName.value) match {
            | None() ->
              typingError(
                Array[
                  (
                    fieldName.posRange,
                    "The field " + fieldName.value + " is missing",
                  ),
                  (type.pos, "Out of " + type.toString()),
                ],
              )
            | Some(tfield) ->
              this.bind(env, kind, fieldPat, tfield.type, isInitialized, false)
            }
          }
        }
      }
    }
  }

  fun bindType(
    posRange: PosRange,
    env: mutable TCEnv,
    kind: BindKind,
    type: ?Type,
    value: ?Expr,
  ): (TType, Bool) {
    value match {
    | None() ->
      if (kind is BKConst()) {
        typingError(Array[(posRange, "Const must be bound to a value")]);
      };
      type match {
      | None() ->
        typingError(Array[(posRange, "Was expecting a type or a value")])
      | Some(annotAst) ->
        ty = this.tenv.normalize(env.context, annotAst);
        (ty, false)
      }
    | Some(e) ->
      ty = this.expr(env, e);
      type match {
      | None() -> (ty, true)
      | Some(annotAst) ->
        annot = this.tenv.normalize(env.context, annotAst);
        this.checkSubType(
          env,
          annotAst.posRange,
          "Invalid annotation",
          ty,
          annot,
        );
        (annot, true)
      }
    }
  }

  fun checkIsVoid(env: mutable TCEnv, pos: PosRange, ty: TType): void {
    this.checkSubType(
      env,
      pos,
      "This expression was expected to be of type void",
      ty,
      TType::single(ty.pos, TPrimVoid(TVoid(), ty.pos)),
    );
  }

  fun stmt(env: mutable TCEnv, st: Stmt): void {
    st.value match {
    | Break() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(env, e);
      if (!e.isAssign()) {
        this.checkIsVoid(env, e.posRange, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(st.pos, TPrimVoid(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(pos, TPrimVoid(TVoid(), pos)))
      | Some(e) -> (e.posRange, this.expr(env, e))
      };
      rtype = if (this.isAsync) {
        TType::single(epos, TPromise(etype, epos))
      } else {
        etype
      };
      this.checkSubType(env, epos, "Invalid return type", rtype, retType)

    | Bind(BKVar(), vars) ->
      invariant(vars.size() != 0);
      typingError(
        Array[(vars[0].pat.pos, "Don't use var, use let or const instead")],
      )

    | Bind(bkind, bindings) ->
      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          env,
          bkind,
          binding.type,
          binding.value,
        );
        this.bind(
          env,
          bkind,
          binding.pat,
          ty,
          isInitialized,
          binding.value is Some(Expr(_, Object _)),
        )
      }

    | If(e, block1, block2) ->
      this.checkBool(env, e);
      scope1 = this.block(env, block1, Some((e, true)));
      scope2 = block2 match {
      | None() ->
        mutable Scope{id => env.next(), isLoop => false, up => Some(env.scope)}
      | Some(b) -> this.block(env, b, Some((e, false)))
      };
      env.mergeScope(env.subst, this.tenv, scope1, scope2);
      if (isTerminalBlock(false, block1)) {
        this.evalCond(env, e, false);
      }

    | For(initStmt, cond, incr, block) ->
      scopeCopy = env.scope;
      initScope = mutable Scope{
        id => env.next(),
        isLoop => false,
        up => Some(scopeCopy),
      };
      env.!scope = initScope;
      this.stmt(env, initStmt);
      loopScope = mutable Scope{
        id => env.next(),
        isLoop => true,
        up => Some(initScope),
      };
      env.!scope = loopScope;
      this.checkBool(env, cond);
      loopBody = this.block(env, block);
      env.popScopeReplace(loopBody);
      _ = this.expr(env, incr);
      env.!scope = initScope;
      env.popScope(env.subst, this.tenv, loopScope);
      env.!scope = scopeCopy;
      env.popScopeReplace(initScope)
    | Block(stmts) ->
      for (stmt in stmts) {
        this.stmt(env, stmt)
      }
    | ForIn _ ->
      typingError(
        Array[
          (
            st.pos,
            "TODO: for ... in not implemented, you can use a normal for (for now)",
          ),
        ],
      )
    | ForOf _ ->
      typingError(
        Array[
          (
            st.pos,
            "TODO: for ... of not implemented, you can use a normal for (for now)",
          ),
        ],
      )
    | Throw(e) -> _ = this.expr(env, e)
    | While(cond, block) ->
      scopeCopy = env.scope;
      loopScope = mutable Scope{
        id => env.next(),
        isLoop => true,
        up => Some(scopeCopy),
      };
      env.!scope = loopScope;
      this.checkBool(env, cond);
      loopBody = this.block(env, block, Some((cond, true)));
      env.popScopeReplace(loopBody);
      env.!scope = scopeCopy;
      env.popScope(env.subst, this.tenv, loopScope)
    | Switch(e, branches) ->
      this.switchCheckExhaustiveness(env, e, branches);
      this.switch(env, e, branches)
    }
  }

  fun switch(env: mutable TCEnv, e: Expr, branches: Array<SwitchBranch>): void {
    if (branches.size() == 0) {
      typingError(Array[(e.posRange, "Missing branch")])
    };
    checkBreak = block -> {
      if (isTerminalBlock(false, block)) return void;
      for (st in block) {
        if (st.value is Break _) return void;
      };
      invariant(block.size() != 0);
      last = block[block.size() - 1];
      typingError(Array[(last.pos, "Missing break")]);
    };
    scope = branches[0] match {
    | Case(v, block) ->
      checkBreak(block);
      cond = Expr(e.posRange, (Binop(BOStrictEquality(), e, v)));
      this.block(env, block, Some((cond, true)))
    | Default(_) -> typingError(Array[(e.posRange, "Missing branch")])
    };
    for (i in Range(1, branches.size())) {
      env.mergeScope(
        env.subst,
        this.tenv,
        scope,
        branches[i] match {
        | Case(v, block) ->
          checkBreak(block);
          cond = Expr(e.posRange, (Binop(BOStrictEquality(), e, v)));
          this.block(env, block, Some((cond, true)))
        | Default(stmts) -> this.block(env, stmts)
        },
      )
    }
  }

  fun switchCheckExhaustiveness(
    env: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    condType = this.expr(env, e);
    stypes = condType.getSTypes(env.subst, this.tenv);
    if (stypes.stypes.size() != 1) return void;
    cases = stypes.stypes[0] match {
    | TPrimValue(_, Some(values), _) ->
      Set::mcreateFromItems(values.values.map(x -> x.i1))
    | _ -> return void
    };
    for (branch in branches) {
      branch match {
      | Case(v, _) ->
        this.expr(env, v).getSTypes(env.subst, this.tenv).staticValue() match {
        | Some(staticValue) ->
          if (!cases.contains(staticValue)) {
            typingError(Array[(v.posRange, "Unused branch")])
          };
          cases.remove(staticValue)
        | _ -> void
        }

      | Default(stmts) ->
        if (cases.isEmpty()) {
          if (stmts.isEmpty()) {
            invariant_violation("Internal error: empty default");
          };
          typingError(Array[(stmts[0].pos, "Unused branch")])
        };
        cases.clear()
      }
    };
    if (!cases.isEmpty()) {
      typingError(
        Array[(e.posRange, "Missing branches:\n" + cases.join("\n"))],
      );
    }
  }

  fun checkBool(env: mutable TCEnv, e: Expr): void {
    this.checkSubType(
      env,
      e.posRange,
      "A condition is expected to be of type boolean, not: ",
      this.expr(env, e),
      TType::single(e.posRange, TPrimValue(TBool(), None(), e.posRange)),
    );
  }

  fun dot(
    env: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    fieldName: Name,
    isContra: Bool,
    checkConstructor: Bool = true,
  ): TType {
    if (checkConstructor && fieldName.value == "constructor") {
      typingError(
        Array[(fieldName.posRange, "Cannot access field 'constructor'")],
      );
    };
    stypes = objType.getSTypes(env.subst, this.tenv, isContra);
    if (stypes.stypes.isEmpty()) {
      typingError(
        Array[
          (pos, "Invalid '.' for type: " + prettyPrintType(false, objType)),
        ],
      )
    };
    result = TType::bottom(pos);
    for (stype in stypes.stypes) {
      stype match {
      | TObject(fields, _) ->
        if (stypes.stypes.size() == 1) return fields.getType(fieldName);
        !result = unionTType(
          env.subst,
          this.tenv,
          result,
          fields.getType(fieldName),
        )
      | TAlgebraic(branches, _) ->
        for (branch in branches) {
          if (stypes.stypes.size() == 1 && branches.size() == 1) {
            return branch.fields.getType(fieldName)
          };
          !result = unionTType(
            env.subst,
            this.tenv,
            result,
            branch.fields.getType(fieldName),
          )
        }
      | TArray(eltType, stringPos) ->
        obj = this.tenv.newObject(
          env.context,
          Name(stringPos, "Array"),
          Array[eltType],
        );
        return obj.fields.getType(fieldName)
      | TPrimValue(primKind, _, stringPos) ->
        objName = primKind.toString();
        obj = this.tenv.newObject(
          env.context,
          Name(stringPos, objName),
          Array[],
        );
        return obj.fields.getType(fieldName)
      | _ ->
        typingError(
          Array[
            (pos, "Invalid '.'"),
            (
              stype.pos,
              "For type: " +
                prettyPrintType(false, TType::single(stype.pos, stype)),
            ),
          ],
        )
      }
    };
    result
  }

  fun expr(env: mutable TCEnv, e: Expr): TType {
    pos = e.posRange;
    e.value match {
    | Number(_) -> TType::single(pos, TPrimValue(TNum(), None(), pos))
    | EString(SKQuote(), x) ->
      TType::single(
        pos,
        TPrimValue(TString(), Some(ArrayValues[(pos, x)]), pos),
      )
    | EString(SKDoubleQuote(), _) ->
      TType::single(pos, TPrimValue(TString(), None(), pos))
    | EString(SKBackTick(), _) ->
      typingError(Array[(pos, "TODO: support for backtick strings")])
    | Var(Name(_, "true"))
    | Var(Name(_, "false")) ->
      TType::single(pos, TPrimValue(TBool(), None(), pos))
    | Var(Name(_, "null")) ->
      this.makeBoundTVar(env, TType::single(pos, TPrimVoid(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      this.makeBoundTVar(env, TType::single(pos, TPrimVoid(TUndefined(), pos)))
    | Var(local) ->
      if (env.localObjects.containsKey(local.value)) {
        env.usedObjects![local.value] = local.posRange
      };
      env.scope.maybeGet(local) match {
      | None() ->
        defs = if (this.builtins.contains(local.value)) {
          this.defMap.get(env.context, this.builtinsFileName, local)
        } else {
          this.defMap.get(
            env.context,
            FileName::create(local.posRange.fileName),
            local,
          )
        };
        for (def in defs) {
          def.value match {
          | fd @ FunDef _ -> break this.tenv.funDecl(env.context, false, fd).i1
          | c @ Class _ -> break this.tenv.newStatic(env.context, c.name)
          | VarDefs(kind, varDefArr) ->
            invariant(varDefArr.size() == 1);
            varDef = varDefArr[0];
            invariant(kind is VDKConst _);
            // TODO: support constants defined using a pattern
            invariant(varDef.pat is Pattern(_, PVar _));
            break varDef.type match {
            | None() ->
              varDef.value match {
              | None() -> None()
              | Some(x) -> this.makeLiteralType(x)
              } match {
              | None() -> this.newTVar(env, pos)
              | Some(ty) -> ty
              }
            | Some(ty) -> this.tenv.normalize(env.context, ty)
            }
          | _ -> void
          }
        } else {
          typingError(Array[(pos, "Unbound name")])
        }
      | Some(localDef) -> localDef
      }
    | Object(efields) ->
      fields = mutable Vector[];
      for (efield in efields) {
        (name, ty) = efield match {
        | FDNormal(x, y) -> (x, this.expr(env, y))
        | FDSpread _ -> invariant_violation("TODO spread")
        | fd @ FunDef _ -> this.tenv.funDecl(env.context, true, fd)
        };
        fields.push(TField(name.posRange, name.value, false, ty))
      };
      obj = createObject(pos, TFields::create(fields.toArray()));
      for (efield in efields) {
        efield match {
        | fd @ FunDef _ ->
          if (fd.name is Some(FNNormal(Name(_, "constructor")))) {
            this.constructor(
              env.context,
              obj,
              static::uninitializedThisType(pos),
              fd,
            )
          } else {
            this.funDef(env.context, Some((CKClass(), obj)), fd)
          }
        | _ -> void
        }
      };
      obj
    | Call(Expr(_, Var(Name(superPos, "super"))), targs, args) ->
      this.super match {
      | None() -> typingError(Array[(superPos, "'super' is not defined")])
      | Some(super) ->
        if (targs.size() != 0) {
          typingError(
            Array[(pos, "super cannot be called with type arguments")],
          );
        };
        this.callConstructor(env, pos, super, args.map(x -> this.expr(env, x)));
        thisName = Name(pos, "this");
        thisType = interTType(
          env.subst,
          this.tenv,
          env.scope.get(thisName),
          super,
        );
        env.scope.set(thisName, thisType, (x, y) -> {
          this.checkSubType(env, pos, "Invalid super call", x, y)
        })
      };
      TType::single(pos, TPrimVoid(TVoid(), pos))

    | Call(Expr(_, Var(Name(_, "show"))), _, args) ->
      exprTy = this.expr(env, args[0]);
      ty = exprTy.expand(env.subst, this.tenv) match {
      | None() -> TType::top(exprTy.pos)
      | Some((stypes, tparams)) ->
        TType::create(exprTy.pos, stypes, TInsts::empty(), tparams)
      };
      print_error(prettyPrintType(false, ty));
      TType::single(pos, TPrimVoid(TVoid(), pos))
    | Call(f, targs, args) ->
      rty = this.call(
        env,
        pos,
        this.expr(env, f),
        targs.map(ty -> this.tenv.normalize(env.context, ty)),
        args.map(x -> this.expr(env, x)),
      );
      f.value match {
      | Binop(
        BODot(),
        Expr(_, Var(Name(_, "console"))),
        Expr(_, Var(Name(_, "assert"))),
      ) if (args.size() >= 1) ->
        this.evalCond(env, args[0], true)
      | _ -> void
      };
      rty
    | New(className, targsAst, argsAst) ->
      targs = if (targsAst.size() == 0) {
        this.tenv.makeTArgs(env.context, env.subst, className)
      } else {
        targsAst.map(targ -> this.tenv.normalize(env.context, targ))
      };
      obj = this.tenv.new(env.context, className, targs);
      this.callConstructor(env, pos, obj, argsAst.map(e -> this.expr(env, e)));
      obj
    | Get(arr, idx) ->
      stypes = this.expr(env, arr).getSTypes(env.subst, this.tenv);
      idxType = this.expr(env, idx);
      result = TType::bottom(pos);
      for (stype in stypes.stypes) {
        ty = stype match {
        | TArray(eltType, _) ->
          this.checkSubType(
            env,
            pos,
            "Invalid index",
            idxType,
            TType::single(
              idx.posRange,
              TPrimValue(TNum(), None(), idx.posRange),
            ),
          );
          eltType
        | TTuple(tyArr, tuplePos) ->
          n = idx.value match {
          | Number(str) -> str.toIntOption()
          | _ -> None()
          } match {
          | None() ->
            typingError(
              Array[
                (idx.posRange, "Invalid index"),
                (tuplePos, "A tuple expects a static index"),
              ],
            )
          | Some(x) -> x
          };
          tyArr[n]
        | TObject(fields, objectPos) if (fields.fields.isEmpty()) ->
          TType::top(objectPos)
        | TPrimValue(primKind, _, primPos) ->
          idxSTypes = idxType.getSTypes(env.subst, this.tenv);
          ty = TType::bottom(pos);
          for (idxSType in idxSTypes) {
            idxSType match {
            | TPrimValue(
              TString(),
              Some(stringValues),
              _,
            ) if (!stringValues.values.isEmpty()) ->
              objName = primKind.toString();
              obj = this.tenv.newObject(
                env.context,
                Name(primPos, objName),
                Array[],
              );
              for (stringValue in stringValues.values) {
                t = obj.fields.getType(Name(stringValue.i0, stringValue.i1));
                !ty = unionTType(env.subst, this.tenv, ty, t);
              }
            | _ ->
              typingError(
                Array[
                  (pos, "Invalid index"),
                  (primPos, "A primitive type expects a static string index"),
                ],
              )
            }
          };
          ty
        | _ ->
          typingError(
            Array[
              (pos, "Expected an array"),
              (
                pos,
                "Not: " +
                  prettyPrintType(false, TType::single(stype.pos, stype)),
              ),
            ],
          )
        };
        !result = unionTType(env.subst, this.tenv, result, ty);
      };
      result
    | EArray(arr) ->
      TType::single(pos, TTuple(arr.map(x -> this.expr(env, x)), pos))

    | Unop(uop, subExpr) ->
      uop match {
      | UOExclamationMark() ->
        bool = TType::single(pos, TPrimValue(TBool(), None(), pos));
        this.checkSubType(env, pos, "Invalid !", this.expr(env, subExpr), bool);
        bool
      | _ -> typingError(Array[(pos, "TODO: unary operator")])
      }

    | Binop(op, e1, e2) ->
      op match {
      | BOAddition() ->
        stypes1 = this.expr(env, e1).getSTypes(env.subst, this.tenv);
        ty1 = TType::fromSTypes(e1.posRange, stypes1);
        if (stypes1.stypes.size() != 1) {
          typingError(
            Array[
              (pos, "Invalid + operation"),
              (pos, `For an object of type: ${ty1}`),
            ],
          )
        };
        stypes1.stypes[0] match {
        | TPrimValue(k @ TNum(), _, primPos)
        | TPrimValue(k @ TString(), _, primPos) ->
          ty2 = this.expr(env, e2);
          this.checkSubType(env, e2.posRange, "Invalid + operand", ty2, ty1);
          TType::single(pos, TPrimValue(k, None(), primPos))
        | sty ->
          typingError(
            Array[
              (pos, "Invalid + operation"),
              (sty.pos, `For an object of type ${ty1}`),
            ],
          )
        }
      | BOAssignment() -> this.assign(env, pos, e1, e2)
      | BOStrictInequality()
      | BOStrictEquality() ->
        ty1 = this.expr(env, e1);
        ty2 = this.expr(env, e2);
        if (ty1.tparams.tparams.isEmpty() && ty2.tparams.tparams.isEmpty()) {
          isSubTType(env.subst, this.tenv, ty1, ty2) match {
          | STOk() -> void
          | _ ->
            isSubTType(env.subst, this.tenv, ty2, ty1) match {
            | STOk() -> void
            | _ ->
              alwaysResult = op match {
              | BOStrictEquality() -> "false"
              | BOStrictInequality() -> "true"
              | _ -> invariant_violation("Internal error: unexpected operator")
              };
              typingError(
                Array[(pos, "This is equality is always " + alwaysResult)],
              )
            }
          }
        };
        TType::single(pos, TPrimValue(TBool(), None(), pos))

      | BOLogicalAnd() ->
        ty1 = this.expr(env, e1);
        this.checkSubType(
          env,
          pos,
          "Invalid &&",
          ty1,
          TType::single(e1.posRange, TPrimValue(TBool(), None(), e1.posRange)),
        );
        this.evalCond(env, e1, true);
        ty2 = this.expr(env, e2);
        this.checkSubType(
          env,
          pos,
          "Invalid &&",
          ty2,
          TType::single(e2.posRange, TPrimValue(TBool(), None(), e2.posRange)),
        );
        TType::single(pos, TPrimValue(TBool(), None(), pos))
      | BOLogicalOr() ->
        ty1 = this.expr(env, e1);
        this.checkSubType(
          env,
          pos,
          "Invalid ||",
          ty1,
          TType::single(e1.posRange, TPrimValue(TBool(), None(), e1.posRange)),
        );
        this.evalCond(env, e1, false);
        ty2 = this.expr(env, e2);
        this.checkSubType(
          env,
          pos,
          "Invalid ||",
          ty2,
          TType::single(e2.posRange, TPrimValue(TBool(), None(), e2.posRange)),
        );
        TType::single(pos, TPrimValue(TBool(), None(), pos))

      | BODot() ->
        e2.value match {
        | Var(fieldName) ->
          this.dot(env, e1.posRange, this.expr(env, e1), fieldName, false)
        | _ -> typingError(Array[(e2.posRange, "Invalid '.'")])
        }

      | BOLessThan()
      | BOLessThanOrEqual()
      | BOGreaterThan()
      | BOGreaterThanOrEqual() ->
        ty1 = this.expr(env, e1);
        ty2 = this.expr(env, e2);
        stypes1 = ty1.getSTypes(env.subst, this.tenv);
        stypes2 = ty2.getSTypes(env.subst, this.tenv);
        error = () -> {
          typeStr = prettyPrintSTypes(stypes1);
          msg = "You can only compare strings and numbers not: " + typeStr;
          typingError(Array[(e1.posRange, msg)]);
        };
        if (stypes1.stypes.size() != 1) {
          error()
        };
        if (!stypes1.isStringOrNumOrBool()) {
          typingError(
            Array[
              (pos, "Invalid comparison"),
              (ty1.pos, "This is neither a string nor a number"),
            ],
          );
        };
        if (!stypes2.isStringOrNumOrBool()) {
          typingError(
            Array[
              (pos, "Invalid comparison"),
              (ty2.pos, "This is neither a string nor a number"),
            ],
          );
        };
        TType::single(pos, TPrimValue(TBool(), None(), pos))

      | BOMultiplicationAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(
              BOAssignment(),
              e1,
              Expr(pos, Binop(BOMultiplication(), e1, e2)),
            ),
          ),
        )
      | BODivisionAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BODivision(), e1, e2))),
          ),
        )
      | BORemainderAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BORemainder(), e1, e2))),
          ),
        )
      | BOAdditionAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOAddition(), e1, e2))),
          ),
        )
      | BOSubtractionAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(
              BOAssignment(),
              e1,
              Expr(pos, Binop(BOSubtraction(), e1, e2)),
            ),
          ),
        )
      | BOLeftShiftAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOLeftShift(), e1, e2))),
          ),
        )
      | BOSignedRightShiftAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(
              BOAssignment(),
              e1,
              Expr(pos, Binop(BOSignedRightShift(), e1, e2)),
            ),
          ),
        )
      | BOZeroFilledRightShiftAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(
              BOAssignment(),
              e1,
              Expr(pos, Binop(BOZeroFilledRightShift(), e1, e2)),
            ),
          ),
        )
      | BOBitwiseAndAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOBitwiseAnd(), e1, e2))),
          ),
        )
      | BOBitwiseXorAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOBitwiseXor(), e1, e2))),
          ),
        )
      | BOBitwiseOrAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOBitwiseOr(), e1, e2))),
          ),
        )
      | BOLogicalAndAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOLogicalAnd(), e1, e2))),
          ),
        )
      | BOLogicalOrAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(BOAssignment(), e1, Expr(pos, Binop(BOLogicalOr(), e1, e2))),
          ),
        )
      | BONullishCoalescingAssignment() ->
        this.expr(
          env,
          Expr(
            pos,
            Binop(
              BOAssignment(),
              e1,
              Expr(pos, Binop(BONullishCoalescing(), e1, e2)),
            ),
          ),
        )

      | SKJS.BOAs() -> notSupported(pos)
      | BOMultiplication()
      | BODivision()
      | BORemainder()
      | BOSubtraction()
      | SKJS.BOBitwiseAnd()
      | SKJS.BOBitwiseOr()
      | SKJS.BOBitwiseXor()
      | BOLeftShift()
      | BOSignedRightShift()
      | BOZeroFilledRightShift() ->
        ty1 = this.expr(env, e1);
        stypes = ty1.getSTypes(env.subst, this.tenv);
        for (stype in stypes) {
          stype match {
          | TPrimValue(TNum(), _, _) ->
            ty2 = this.expr(env, e2);
            this.checkSubType(env, pos, "Invalid operation", ty1, ty2)
          | _ ->
            typingError(
              Array[
                (pos, "Invalid operation"),
                (stype.pos, "This is not a number"),
              ],
            )
          }
        };
        ty1

      | BONullishCoalescing() ->
        ty1 = this.expr(env, e1);
        ty2 = this.expr(env, e2);
        stypes = ty1.getSTypes(env.subst, this.tenv);
        hasNullOrUndefined = stypes.stypes.any(stype ~>
          stype match {
          | TPrimVoid(TNull(), _)
          | TPrimVoid(TUndefined(), _) ->
            true
          | _ -> false
          }
        );
        if (!hasNullOrUndefined) {
          typingError(
            Array[
              (pos, "This operator is useless"),
              (e1.posRange, "This construction is never null or undefined"),
            ],
          );
        };
        unionTType(env.subst, this.tenv, ty1, ty2)
      }

    | InstanceOf(e1, Expr(_, Var(className))) ->
      _ = this.expr(env, e1);
      _ = this.tenv.getClass(env.context, className);
      TType::single(pos, TPrimValue(TBool(), None(), pos))
    | InstanceOf(_, e2) ->
      typingError(Array[(e2.posRange, "Unexpected instanceof")])
    | TypeOf(subExpr) ->
      _ = this.expr(env, subExpr);
      TType::single(pos, TPrimValue(TString(), None(), pos))

    | PostOp(pop, subExpr) ->
      pop match {
      | PODecr()
      | POIncr() ->
        num = TType::single(pos, TPrimValue(TNum(), None(), pos));
        ty = this.expr(env, subExpr);
        this.checkSubType(env, pos, "Expected integer", ty, num);
        TType::single(pos, TPrimVoid(TVoid(), pos))
      | POExcl() -> notSupported(pos)
      }

    | Closure(params, retTypeAstOpt, body) ->
      paramTypes = mutable Vector[];
      noAnnot: ?PosRange = None();
      for (param in params) {
        paramType = param.i1 match {
        | None() ->
          if (noAnnot is None()) {
            !noAnnot = Some(param.i0.posRange)
          };
          this.newTVar(env, param.i0.posRange)
        | Some(ty) -> this.tenv.normalize(env.context, ty)
        };
        paramTypes.push((param.i0, paramType));
      };
      retType = retTypeAstOpt match {
      | None() -> this.newTVar(env, pos)
      | Some(retTypeAst) -> this.tenv.normalize(env.context, retTypeAst)
      };
      savedScope = env.scope.clone();
      lambdas = if (noAnnot is None()) {
        this.closure(
          env.subst,
          savedScope,
          paramTypes.toArray(),
          retType,
          body,
        );
        Array[]
      } else {
        Array[
          Lambda(pos, (subst, argsTypes, retType) ~> {
            args = params.mapWithIndex((i, p) ~> (p.i0, argsTypes[i]));
            this.closure(subst, savedScope, args, retType, body)
          }),
        ]
      };
      TType::single(
        pos,
        TFuns(
          Array[
            TFun(
              Array[],
              paramTypes.map(x -> x.i1).toArray(),
              Array[],
              None(),
              pos,
              lambdas,
              retType,
            ),
          ],
          Array[],
          pos,
        ),
      )

    | SKJS.As _ -> notSupported(pos)
    | SKJS.Async _ -> typingError(Array[(pos, "TODO: async closures")])
    | SKJS.Await(ae) ->
      aeType = this.expr(env, ae);
      stypes = aeType.getSTypes(env.subst, this.tenv);
      result: ?TType = None();
      for (stype in stypes.stypes) {
        stype match {
        | TPromise(ty, _) -> !result = Some(ty)
        | _ ->
          typingError(
            Array[(pos, "Invalid await"), (stype.pos, "This is not a promise")],
          )
        }
      };
      result match {
      | None() ->
        typingError(
          Array[(pos, "Invalid await"), (aeType.pos, "This is not a promise")],
        )
      | Some(ty) -> ty
      }
    | SKJS.EIf(e1, e2, e3) ->
      cond = this.expr(env, e1);
      left = this.expr(env, e2);
      right = this.expr(env, e3);
      this.checkSubType(
        env,
        e1.posRange,
        "Invalid ? condition",
        cond,
        TType::single(e1.posRange, TPrimValue(TBool(), None(), e1.posRange)),
      );
      unionTType(env.subst, this.tenv, left, right)
    | SKJS.KeyOf _ -> notSupported(pos)
    | SKJS.Params _ ->
      invariant_violation("Internal error: Params should not be an expression")
    | SKJS.Regexp _ -> typingError(Array[(pos, "TODO: regexp")])
    | SKJS.Spread _ -> typingError(Array[(pos, "TODO: ...")])
    }
  }

  fun makeLiteralType(e: Expr): ?TType {
    e match {
    | Expr(valuePos, Var(Name(_, "null"))) ->
      Some(TType::single(valuePos, TPrimVoid(TNull(), valuePos)))
    | Expr(valuePos, Var(Name(_, "undefined"))) ->
      Some(TType::single(valuePos, TPrimVoid(TUndefined(), valuePos)))
    | Expr(valuePos, Number(n)) ->
      Some(
        TType::single(
          valuePos,
          TPrimValue(TNum(), Some(ArrayValues[(valuePos, n)]), valuePos),
        ),
      )
    | Expr(valuePos, Var(Name(_, "true"))) ->
      Some(
        TType::single(
          valuePos,
          TPrimValue(TBool(), Some(ArrayValues[(valuePos, "true")]), valuePos),
        ),
      )
    | Expr(valuePos, Var(Name(_, "false"))) ->
      Some(
        TType::single(
          valuePos,
          TPrimValue(TBool(), Some(ArrayValues[(valuePos, "false")]), valuePos),
        ),
      )
    | Expr(valuePos, EString(_, n)) ->
      Some(
        TType::single(
          valuePos,
          TPrimValue(TString(), Some(ArrayValues[(valuePos, n)]), valuePos),
        ),
      )
    | _ -> None()
    }
  }

  fun closure(
    subst: mutable Subst,
    scope: Scope,
    params: Array<(Name, TType)>,
    retType: TType,
    body: ClosureBody,
  ): void {
    env = mutable TCEnv(subst.context, subst, Scope::fromSaved(scope));
    for (param in params) {
      env.scope.bind(param.i0, param.i1, true)
    };
    body match {
    | CBExpr(e) ->
      this.checkSubType(
        env,
        e.posRange,
        "Invalid callback return",
        this.expr(env, e),
        retType,
      )
    | CBBlock(bl) ->
      !this.retType = Some(retType);
      _ = this.block(env, bl)
    }
  }

  fun callConstructor(
    env: mutable TCEnv,
    pos: PosRange,
    obj: TType,
    args: Array<TType>,
  ): void {
    for (stype in obj.stypes.stypes) {
      stype match {
      | TObject(fields, _) ->
        fields.maybeGet("constructor") match {
        | None() ->
          if (args.size() == 0) return void;
          typingError(
            Array[(pos, "Invalid new: constructor expects no arguments")],
          )
        | Some(cstr) -> _ = this.call(env, pos, cstr.type, Array[], args)
        }
      | _ -> invariant_violation("Internal error: unexpected constructor call")
      }
    }
  }

  fun assign(env: mutable TCEnv, pos: PosRange, e1: Expr, e2: Expr): TType {
    this.checkLValue(e1);
    e1.value match {
    | Var(n) ->
      ty2 = this.expr(env, e2);
      env.scope.set(n, ty2, (x, y) ->
        this.checkSubType(env, pos, "Invalid assignment", x, y)
      );
      ty2
    | Binop(
      BODot(),
      Expr(_, Var(local)),
      Expr(_, Var(fieldName)),
    ) if (env.localObjects.containsKey(local.value)) ->
      fieldType = this.expr(env, e2);
      env.localObjects[local.value] match {
      | None() -> void
      | Some(objectType) ->
        this.checkSubType(
          env,
          e2.posRange,
          "Invalid assignment",
          fieldType,
          this.dot(env, e1.posRange, objectType, fieldName, false),
        )
      };
      this.assignLocalObject(env, pos, local, fieldName, fieldType)
    | _ ->
      ty1 = this.expr(env, e1);
      ty2 = this.expr(env, e2);
      this.checkSubType(env, e2.posRange, "Invalid assignment", ty2, ty1);
      ty1
    }
  }

  fun assignLocalObject(
    env: mutable TCEnv,
    pos: PosRange,
    local: Name,
    fieldName: Name,
    fieldType: TType,
  ): TType {
    stypes = env.scope.get(local).getSTypes(env.subst, this.tenv);
    invariant(stypes.stypes.size() == 1);
    invariant(stypes.stypes[0] is TObject _);
    for (stype in stypes.stypes) {
      objField = stype match {
      | TObject(fields, objPos) ->
        fields.maybeGet(fieldName.value) match {
        | None() ->
          env.usedObjects.maybeGet(local.value) match {
          | None() -> void
          | Some(usedPos) ->
            typingError(
              Array[
                (pos, "You are trying to add a field to this object"),
                (
                  usedPos,
                  "But this object has been already been used for something else",
                ),
              ],
            )
          };
          if (env.scope.isThroughLoop(local)) {
            typingError(
              Array[
                (
                  local.posRange,
                  "You cannot add a field to an object in a loop",
                ),
              ],
            )
          };
          env.scope.set(
            local,
            TType::single(
              objPos,
              TObject(
                interTFields(
                  env.subst,
                  this.tenv,
                  fields,
                  TFields::create(
                    Array[
                      TField(fieldType.pos, fieldName.value, false, fieldType),
                    ],
                  ),
                ),
                objPos,
              ),
            ),
            (x, y) -> {
              this.checkSubType(env, fieldType.pos, "Invalid assignment", x, y)
            },
          );
          fieldType
        | Some(fd) -> fd.type
        }
      | _ ->
        invariant_violation("Internal error: local object is not an object")
      };
      this.checkSubType(
        env,
        fieldType.pos,
        "Invalid assignment",
        fieldType,
        objField,
      )
    };
    fieldType
  }

  fun call(
    env: mutable TCEnv,
    pos: PosRange,
    fty: TType,
    targs: Array<TType>,
    args: Array<TType>,
  ): TType {
    stypes = fty.getSTypes(env.subst, this.tenv);
    result: ?TType = None();
    for (sty in stypes) {
      sty match {
      | TFuns(funs, methods, _) ->
        for (tfun in funs.concat(methods)) {
          if (targs.size() != 0 && targs.size() != tfun.tparams.size()) {
            typingError(
              Array[
                (
                  pos,
                  "Incompatible number of type arguments: " +
                    targs.size() +
                    " passed",
                ),
                (fty.pos, "Expected: " + tfun.tparams.size()),
              ],
            )
          };
          map = mutable Map[];
          for (i => tparamDecl in tfun.tparams) {
            map![(tparamDecl.fileName, tparamDecl.id)] = if (targs.isEmpty()) {
              this.newTVar(env, pos)
            } else {
              targs[i]
            };
          };
          !tfun = Instantiate().fun_(
            (env.subst, this.tenv, map.chill()),
            tfun with {tparams => Array[]},
          );
          version = env.subst.version;
          loop {
            for (i in Range(0, tfun.params.size())) {
              if (i >= args.size()) {
                typingError(
                  Array[
                    (pos, "Invalid call"),
                    (
                      fty.pos,
                      "This function has " + tfun.params.size() + " parameters",
                    ),
                  ],
                )
              };
              this.checkSubType(
                env,
                pos,
                "Invalid call",
                args[i],
                tfun.params[i],
              )
            };
            for (j in Range(0, tfun.optionalParams.size())) {
              i = tfun.params.size() + j;
              if (i >= args.size()) break void;
              this.checkSubType(
                env,
                pos,
                "Invalid call",
                args[i],
                tfun.optionalParams[j],
              )
            };
            if (env.subst.version == version) break void;
            !version = env.subst.version;
          };
          totalSize = tfun.params.size() + tfun.optionalParams.size();
          if (totalSize < args.size()) {
            tfun.spreadParam match {
            | None() ->
              typingError(
                Array[
                  (pos, "Too many arguments"),
                  (tfun.minSizeWitness, "For this function"),
                ],
              )
            | Some(spreadType) ->
              msg = Array[
                (pos, "Invalid call"),
                (spreadType.pos, "Unexpected type for ..."),
              ];
              if (spreadType.stypes.stypes.size() != 1) {
                typingError(msg);
              };
              spreadType.stypes.stypes[0] match {
              | TArray(eltType, _) ->
                for (i in Range(totalSize, args.size())) {
                  this.checkSubType(
                    env,
                    pos,
                    "Invalid argument",
                    args[i],
                    eltType,
                  );
                }
              | _ -> typingError(msg)
              }
            }
          };
          for (lambda in tfun.lambdas) {
            invariant(tfun.optionalParams.size() == 0);
            lambda.compute(env.subst, args, tfun.retType)
          };
          !result = result match {
          | None() -> Some(tfun.retType)
          | Some(r) -> Some(unionTType(env.subst, this.tenv, r, tfun.retType))
          };
        }
      | _ ->
        typingError(
          Array[
            (pos, "Invalid call"),
            (fty.pos, `Type ${prettyPrintSType(sty, true)} is not a function`),
          ],
        )
      }
    };
    result match {
    | None() ->
      typingError(
        Array[
          (pos, "Invalid call"),
          (
            fty.pos,
            `Type ${prettyPrintSTypes(stypes, true)} is not a function`,
          ),
        ],
      )
    | Some(x) -> x
    }
  }

  fun makeBoundTVar(env: mutable TCEnv, ty: TType): TType {
    tvar = env.subst.gen(ty.pos);
    env.subst.grow(this.tenv, tvar, ty, true);
    TType::fromTInst(ty.pos, tvar)
  }

  fun newTVar(env: mutable TCEnv, pos: PosRange): TType {
    tvar = env.subst.gen(pos);
    TType::fromTInst(pos, tvar)
  }

  fun checkLValue(e: Expr): void {
    e.value match {
    | Var(Name(_, "super")) ->
      typingError(Array[(e.posRange, "Invalid lvalue")])
    | Var _ -> void
    | Get _ -> void
    | EArray _ -> void
    | Binop(BODot(), e1, Expr(_, Var(_))) -> this.checkLValue(e1)
    | _ -> typingError(Array[(e.posRange, "Invalid lvalue")])
    }
  }

  fun evalCond(env: mutable TCEnv, e: Expr, target: Bool): void {
    e.value match {
    | Binop(
      BOStrictEquality(),
      Expr(_, EString(SKQuote(), tag)),
      Expr(
        _,
        Binop(BODot(), Expr(_, Var(local)), Expr(_, Var(Name(_, "kind")))),
      ),
    )
    | Binop(
      BOStrictEquality(),
      Expr(
        _,
        Binop(BODot(), Expr(_, Var(local)), Expr(_, Var(Name(_, "kind")))),
      ),
      Expr(_, EString(SKQuote(), tag)),
    ) ->
      if (target) {
        this.setLocal(
          env,
          local,
          None(),
          _ ~> true,
          stype ~>
            stype match {
            | TAlgebraic(branches, aPos) ->
              TAlgebraic(
                branches.filter(branch -> branch.fields.getKind() == tag),
                aPos,
              )
            | x -> x
            }
          ,
        )
      }

    | Binop(
      BOStrictEquality(),
      Expr(_, TypeOf(Expr(_, Var(local)))),
      Expr(typePos, EString(_, typeStr)),
    )
    | Binop(
      BOStrictEquality(),
      Expr(typePos, EString(_, typeStr)),
      Expr(_, TypeOf(Expr(_, Var(local)))),
    ) ->
      (filter, default) = typeStr match {
      | "string" ->
        (
          (x ~> (x is TPrimValue(TString(), _, _))),
          Some(TPrimValue(TString(), None(), typePos)),
        )
      | "number" ->
        (
          x ~> x is TPrimValue(TNum(), _, _),
          Some(TPrimValue(TNum(), None(), typePos)),
        )
      | "bigint" -> typingError(Array[(typePos, "TODO: support for bigint")])
      | "boolean" ->
        (
          x ~> x is TPrimValue(TBool(), _, _),
          Some(TPrimValue(TBool(), None(), typePos)),
        )

      | "symbol" -> return void
      | "undefined" -> (x ~> x is TPrimVoid(TUndefined(), _), None())
      | "object" ->
        (
          (x ~>
            x is TObject _ || x is TAlgebraic _ || x is TPrimVoid(TNull(), _)),
          Some(TObject(TFields::empty(), typePos)),
        )
      | "function" -> (x ~> x is TFuns _, None())
      | _ -> return void
      };
      this.setLocal(
        env,
        local,
        if (target) default else None(),
        if (target) filter else x ~> !filter(x),
      )

    | Binop(
      BOStrictInequality(),
      Expr(_, TypeOf(Expr(_, Var(local)))),
      Expr(typePos, EString(_, typeStr)),
    )
    | Binop(
      BOStrictInequality(),
      Expr(typePos, EString(_, typeStr)),
      Expr(_, TypeOf(Expr(_, Var(local)))),
    ) ->
      (filter, default) = typeStr match {
      | "string" ->
        (
          (x ~> (x is TPrimValue(TString(), _, _))),
          Some(TPrimValue(TString(), None(), typePos)),
        )
      | "number" ->
        (
          x ~> x is TPrimValue(TNum(), _, _),
          Some(TPrimValue(TNum(), None(), typePos)),
        )
      | "bigint" -> typingError(Array[(typePos, "TODO: support for bigint")])
      | "boolean" ->
        (
          x ~> x is TPrimValue(TBool(), _, _),
          Some(TPrimValue(TBool(), None(), typePos)),
        )

      | "symbol" -> return void
      | "undefined" -> (x ~> x is TPrimVoid(TUndefined(), _), None())
      | "object" ->
        (
          (x ~>
            x is TObject _ || x is TAlgebraic _ || x is TPrimVoid(TNull(), _)),
          Some(TObject(TFields::empty(), typePos)),
        )
      | "function" -> (x ~> x is TFuns _, None())
      | _ -> return void
      };
      this.setLocal(
        env,
        local,
        if (target) None() else default,
        if (target) x ~> !filter(x) else filter,
      )

    | InstanceOf(
      Expr(_, Var(local)),
      Expr(_, Var(Name(posArray, "Array"))),
    ) if (target) ->
      env.scope.set(
        local,
        TType::single(posArray, TArray(TType::top(posArray), posArray)),
        (_, _) -> void,
      )

    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->
      env.scope.set(
        local,
        this.tenv.new(
          env.context,
          className,
          this.tenv.makeTArgs(env.context, env.subst, className),
        ),
        (x, y) ->
          this.checkSubType(env, e.posRange, "Invalid instanceof", x, y)
        ,
      )
    | Binop(
      BOStrictEquality(),
      Expr(_, Var(local)),
      Expr(_, Var(Name(_, "null"))),
    )
    | Binop(
      BOStrictEquality(),
      Expr(_, Var(Name(_, "null"))),
      Expr(_, Var(local)),
    ) ->
      if (!target) {
        this.setLocal(env, local, None(), x ~> !(x is TPrimVoid(TNull(), _)))
      }

    | Binop(
      BOStrictInequality(),
      Expr(_, Var(local)),
      Expr(_, Var(Name(_, "null"))),
    )
    | Binop(
      BOStrictInequality(),
      Expr(_, Var(Name(_, "null"))),
      Expr(_, Var(local)),
    ) ->
      if (target) {
        this.setLocal(env, local, None(), x ~> !(x is TPrimVoid(TNull(), _)))
      }

    | Binop(
      BOStrictEquality(),
      Expr(_, Var(local)),
      Expr(_, Var(Name(_, "undefined"))),
    )
    | Binop(
      BOStrictEquality(),
      Expr(_, Var(Name(_, "undefined"))),
      Expr(_, Var(local)),
    ) ->
      if (!target) {
        this.setLocal(env, local, None(), x ~>
          !(x is TPrimVoid(TUndefined _, _))
        )
      }

    | Binop(
      BOStrictInequality(),
      Expr(_, Var(local)),
      Expr(_, Var(Name(_, "undefined"))),
    )
    | Binop(
      BOStrictInequality(),
      Expr(_, Var(Name(_, "undefined"))),
      Expr(_, Var(local)),
    ) ->
      if (target) {
        this.setLocal(env, local, None(), x ~>
          !(x is TPrimVoid(TUndefined _, _))
        )
      }

    | Binop(BOLogicalAnd(), e1, e2) if (target) ->
      this.evalCond(env, e1, true);
      this.evalCond(env, e2, true)

    | Binop(BOLogicalOr(), e1, e2) if (!target) ->
      this.evalCond(env, e1, false);
      this.evalCond(env, e2, false)

    | _ -> void
    }
  }

  fun setLocal(
    env: mutable TCEnv,
    local: Name,
    default: ?SType,
    filter: SType ~> Bool,
    map: SType ~> SType = x ~> x,
  ): void {
    ty = env.scope.get(local);
    (!ty, isTopOrEmpty) = ty.expand(env.subst, this.tenv) match {
    | None() -> (TType::top(ty.pos), true)
    | Some((stypes, tparams)) ->
      t = TType::create(ty.pos, stypes, TInsts::empty(), tparams);
      !t = FilterType().type((filter, map), t);
      isEmpty = t.getSTypes(env.subst, this.tenv).stypes.isEmpty();
      (t, isEmpty)
    };
    localType = default match {
    | Some(d) if (isTopOrEmpty) -> TType::single(d.pos, d)
    | _ -> ty
    };
    env.scope.set(local, localType, (_, _) -> void)
  }
}

/*****************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/*****************************************************************************/

fun isTerminal(inTry: Bool, st: Stmt): Bool {
  st.value match {
  | Break _
  | ForOf _
  | For _
  | While _
  | Bind _
  | StmtEmpty _
  | ForIn _
  | StmtExpr _ ->
    false
  | Return _ -> true
  | Throw _ -> !inTry
  | If(_, bl1, Some(bl2)) ->
    isTerminalBlock(inTry, bl1) && isTerminalBlock(inTry, bl2)
  | If(_, _, _) -> false
  | Block(bl) -> isTerminalBlock(inTry, bl)
  | Switch(_, branches) ->
    switchIsExhaustive = branches.any(branch ~> branch is Default _); // Unless exhaustiveness is proven differently?
    switchIsExhaustive &&
      branches.all(branch ~>
        branch match {
        | Case(_, bl)
        | Default(bl) ->
          isTerminalBlock(inTry, bl)
        }
      )
  }
}

fun isTerminalBlock(inTry: Bool, bl: Array<Stmt>): Bool {
  bl.any(st ~> isTerminal(inTry, st))
}

module end;
