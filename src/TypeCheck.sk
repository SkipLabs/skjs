/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

mutable class TypeChecker{
  builtins: Set<String>,
  builtinsFileName: FileName,
  backtrace: Bool,
  defMap: DefMap,
  mutable tenv: TEnv,
  mutable super: ?(CstrType, TType) = None(),
  mutable isAsync: Bool = false,
  mutable retType: ?TType = None(),
  mutable callgraph: SortedMap<CGNode, Array<CGNode>> = SortedMap[],
  mutable classHierarchy: SortedMap<CHNode, SortedSet<CHNode>> = SortedMap[],
} {
  mutable fun recordCalls(caller: CGNode, newCallees: CGNodes): void {
    oldCallees = this.callgraph.maybeGet(caller).default(Array[]);
    callees = oldCallees.foldl(
      (nodes, node) -> nodes.set(node),
      newCallees.nodes,
    );
    this.!callgraph = this.callgraph.set(caller, callees.toArray())
  }

  mutable fun recordClassHierarchy(child: Class, parent: Class): void {
    childNode = CHNode(
      child.name.value,
      child.kind,
      child.name.pos.fileName,
      child.name.pos.symbol,
    );
    parentNode = CHNode(
      parent.name.value,
      parent.kind,
      parent.name.pos.fileName,
      parent.name.pos.symbol,
    );
    current = this.classHierarchy.maybeGet(childNode).default(SortedSet[]);
    new = current.set(parentNode);
    this.!classHierarchy = this.classHierarchy.set(childNode, new)
  }

  readonly fun mclone(): mutable TypeChecker {
    mutable TypeChecker{
      builtins => this.builtins,
      builtinsFileName => this.builtinsFileName,
      backtrace => this.backtrace,
      defMap => this.defMap,
      tenv => this.tenv,
      super => this.super,
      isAsync => this.isAsync,
      retType => this.retType,
      callgraph => this.callgraph,
      classHierarchy => this.classHierarchy,
    }
  }
}

/***************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/***************************************************************************/

fun isTerminalBlock(inTry: Bool, bl: Array<Stmt>): Bool {
  term = StmtTermination::block(bl);
  !term.mayFallthrough && (term.mayReturn || (!inTry && term.mayThrow))
}

module end;
