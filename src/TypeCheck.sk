/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

mutable class TypeChecker{
  builtins: Set<String>,
  builtinsFileName: FileName,
  backtrace: Bool,
  defMap: DefMap,
  mutable tenv: TEnv,
  mutable super: ?(CstrType, TType) = None(),
  mutable isAsync: Bool = false,
  mutable retType: ?TType = None(),
} {
  readonly fun mclone(): mutable TypeChecker {
    mutable TypeChecker{
      builtins => this.builtins,
      builtinsFileName => this.builtinsFileName,
      backtrace => this.backtrace,
      defMap => this.defMap,
      tenv => this.tenv,
      super => this.super,
      isAsync => this.isAsync,
      retType => this.retType,
    }
  }
}

/***************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/***************************************************************************/

fun isTerminalBlock(inTry: Bool, bl: Array<Stmt>): Bool {
  term = StmtTermination::block(bl);
  !term.mayFallthrough && (term.mayReturn || (!inTry && term.mayThrow))
}

module end;
