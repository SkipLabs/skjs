/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

class TypeChecker{
  errorHandling: ErrorHandling,
  super: ?(CstrType, TType) = None(),
  isAsync: Bool = false,
  retType: ?TType = None(),
  // The class whose body is currently being type-checked, identified by
  // its declaration Name (whose pos also identifies the declaring file).
  // Set once at the top of class_ and inherited through funDefSetup into
  // method bodies and constructors. Used at field-access sites to enforce
  // private visibility. None() outside of any class body.
  enclosingClass: ?Name = None(),
  // The truthiness mode (CLI `--truthiness` / tsconfig `truthiness`). Decides
  // which condition diagnostics are emitted; checking always continues with
  // JavaScript value semantics. Read in checkCondition (TypeCheckUtils.sk),
  // the `&&`/`||`/`!`/ternary sites (TypeCheckExpr.sk), and narrowing
  // (TypeCheckRefine.sk). See issue #654.
  truthiness: Truthiness = Truthiness::default,
  // Whether a switch clause that falls into another is an error (TS7029,
  // tsconfig `noFallthroughCasesInSwitch`). Read in `switch` (TypeCheckStmt.sk);
  // the narrowing of the clause fallen into does not depend on it.
  noFallthroughCasesInSwitch: Bool = true,
  // Conformance mode (CLI `--conformance` / tsconfig `conformance`): relax
  // SKJS-specific restrictions so TypeScript files check verbatim — `var`
  // (read in `Bind`, TypeCheckStmt.sk, and in top-level `Var` resolution,
  // TypeCheckExpr.sk) and top-level `let`/`var` (TypeCheckDef.sk). See
  // TsCompilerOptions.conformance; SkipLabs/skjs#841 tracks real `var`
  // semantics.
  conformance: Bool = false,
  // Exempt narrowed-discriminant re-checks against hoisted literal-initialized
  // constants and enum members from SKJS2074 (CLI `--exempt-constant-rechecks`
  // / tsconfig `exemptConstantRechecks`). Off by default.
  exemptConstantRechecks: Bool = false,
  // Positions of top-level let/var initializers currently being resolved in
  // conformance mode (toplevelVarInitType, TypeCheckExpr.sk); guards circular
  // initializers (`var a = b; var b = a;`) — re-entry yields top instead of
  // looping forever.
  resolvingToplevelVarInits: SortedSet<PosRange> = SortedSet[],
} extends TEnv {
  // Apply the run's tracked config (see Config.sk). Persisted-dir closures
  // capture a TypeChecker from init time; they must call this with a fresh
  // getConfig read so config changes reach --data runs.
  fun withConfig(config: CheckerConfig): this {
    this with {
      errorHandling => config.errorHandling,
      truthiness => config.compilerOptions.truthiness,
      noFallthroughCasesInSwitch => config.compilerOptions.noFallthroughCasesInSwitch,
      conformance => config.compilerOptions.conformance,
      exemptConstantRechecks => config.compilerOptions.exemptConstantRechecks,
      verbose => config.verbose,
    }
  }
}

module end;
