/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* The local environment. */
/***************************************************************************/

value class LocalRef(type: TType, isInitialized: Bool)

mutable class Scope{
  id: Int,
  private isLoop: Bool,
  callingContext: CGNode,
  up: ?readonly Scope = None(),
  private mutable locals: SortedMap<String, Name> = SortedMap[],
  private mutable refs: SortedMap<String, LocalRef> = SortedMap[],
} {
  static fun mcreateToplevel(fileName: String): mutable this {
    mutable static{
      id => 0,
      isLoop => false,
      callingContext => CGNode::create(Toplevel(fileName)),
    }
  }

  readonly fun clone(): Scope {
    Scope{
      id => this.id,
      isLoop => this.isLoop,
      callingContext => this.callingContext,
      up => this.up.map(x -> x.clone()),
      locals => this.locals,
      refs => this.refs,
    }
  }

  static fun fromSaved(saved: Scope): mutable Scope {
    mutable Scope{
      id => saved.id,
      isLoop => saved.isLoop,
      callingContext => saved.callingContext,
      up => saved.up.map(x -> static::fromSaved(x)),
      locals => saved.locals,
      refs => saved.refs,
    }
  }

  readonly private fun maybeGetLocal(name: Name): ?Name {
    this.locals.maybeGet(name.value) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetLocal(name)
      }
    | Some(x) -> Some(x)
    }
  }

  readonly private fun getLocal(name: Name): Name {
    this.maybeGetLocal(name) match {
    | None() -> typingError(Array[(name.pos, "Unbound name")])
    | Some(x) -> x
    }
  }

  readonly private fun maybeGetRefHelper(
    throughLoop: Bool,
    name: String,
  ): ?(Bool, LocalRef) {
    !throughLoop = this.isLoop || throughLoop;
    this.refs.maybeGet(name) match {
    | None() ->
      this.up match {
      | None() -> None()
      | Some(up) -> up.maybeGetRefHelper(throughLoop, name)
      }
    | Some(x) -> Some((throughLoop, x))
    }
  }

  readonly private fun maybeGetRef(name: String): ?(Bool, LocalRef) {
    this.maybeGetRefHelper(false, name)
  }

  mutable fun bind(name: Name, ty: TType, isInitialized: Bool): void {
    this.maybeGetLocal(name) match {
    | None() ->
      this.!locals[name.value] = name;
      this.!refs[name.value] = LocalRef(ty, isInitialized)
    | Some(otherDef) ->
      typingError(
        Array[
          (name.pos, name.value + " is already defined"),
          (otherDef.pos, "Previous definition was here"),
        ],
      )
    }
  }

  readonly fun isThroughLoop(name: Name): Bool {
    this.maybeGetRef(name.value) match {
    | None() -> false
    | Some((isThroughLoop, _)) -> isThroughLoop
    }
  }

  readonly fun maybeGet(name: Name): ?TType {
    this.maybeGetRef(name.value) match {
    | None() -> None()
    | Some((_, ref)) ->
      if (!ref.isInitialized) {
        typingError(Array[(name.pos, "This local is not fully initialized")])
      } else {
        Some(ref.type)
      }
    }
  }

  readonly fun get(name: Name): TType {
    this.maybeGet(name) match {
    | None() -> typingError(Array[(name.pos, "Unbound name")])
    | Some(x) -> x
    }
  }

  mutable fun set(
    name: Name,
    ty: TType,
    isSubType: (TType, TType) -> void,
  ): void {
    (throughLoop, upRef) = this.maybeGetRef(name.value) match {
    | None() -> typingError(Array[(name.pos, "Unbound name: " + name.value)])
    | Some(x) -> x
    };
    if (throughLoop) {
      isSubType(ty, upRef.type);
    };
    this.!refs[name.value] = LocalRef(ty, true);
  }

  readonly fun escapingRefs(): mutable Iterator<(String, LocalRef)> {
    this.refs.items().filter(x -> !this.locals.containsKey(x.i0))
  }

  mutable fun merge(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    if (scope1.up.map(x -> x.id) != Some(this.id)) {
      internal_error("scope1 up id mismatch")
    };
    if (scope2.up.map(x -> x.id) != Some(this.id)) {
      internal_error("scope2 up id mismatch")
    };
    if (scope1.callingContext != this.callingContext) {
      internal_error("scope1 calling context mismatch");
    };
    if (scope2.callingContext != this.callingContext) {
      internal_error("scope2 calling context mismatch");
    };
    _ = mapUnion(
      scope1.escapingRefs(),
      scope2.escapingRefs(),
      x ~> x.i0,
      (nameRef) -> {
        (name, ref) = nameRef;
        (_, upRef) = this.maybeGetRef(name).fromSome();
        this.!refs[name] = LocalRef(
          TType::union(subst, tenv, upRef.type, ref.type),
          upRef.isInitialized,
        );
        nameRef
      },
      (nameRef1, nameRef2) -> {
        (name1, ref1) = nameRef1;
        (name2, ref2) = nameRef2;
        if (name1 != name2) {
          internal_error("name refs must have same name")
        };
        this.!refs[name1] = LocalRef(
          TType::union(subst, tenv, ref1.type, ref2.type),
          ref1.isInitialized && ref2.isInitialized,
        );
        nameRef1
      },
    );
  }

  mutable fun popReplace(scope: readonly Scope): void {
    if (scope.up.fromSome().id != this.id) {
      internal_error("scope up id mismatch")
    };
    for (nameRef in scope.escapingRefs()) {
      (name, ref) = nameRef;
      this.!refs[name] = ref;
    }
  }
}

/***************************************************************************/
/* The mutable environment used by the type-checker. */
/***************************************************************************/

mutable class TCEnv(
  context: mutable SKStore.Context,
  subst: mutable Subst,
  mutable scope: mutable Scope,
  localObjects: mutable Map<String, ?TType> = mutable Map[],
  usedObjects: mutable Map<String, PosRange> = mutable Map[],
  private mutable counter: Int = 0,
) {
  private mutable fun next(): Int {
    this.!counter = this.counter + 1;
    this.counter
  }

  mutable fun mergeScope(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    this.scope.merge(subst, tenv, scope1, scope2);
  }

  mutable fun popScope(
    subst: mutable Subst,
    tenv: TEnv,
    scope: readonly Scope,
  ): void {
    if (scope.up.fromSome().id != this.scope.id) {
      internal_error("scope up id mismatch")
    };
    this.scope.merge(subst, tenv, scope, this.mcreateSubScope{isLoop => false});
  }

  mutable fun popScopeReplace(scope: readonly Scope): void {
    this.scope.popReplace(scope);
  }

  mutable fun mcreateSubScope{isLoop: Bool}: mutable Scope {
    mutable Scope{
      id => this.next(),
      isLoop,
      up => Some(this.scope),
      callingContext => this.scope.callingContext,
    }
  }
}

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

class TypeChecker{
  builtins: Set<String>,
  builtinsFileName: FileName,
  backtrace: Bool,
  defMap: DefMap,
  tenv: TEnv,
  callgraph: CallGraph,
  super: ?(CstrType, TType) = None(),
  isAsync: Bool = false,
  retType: ?TType = None(),
} {
  fun check(context: mutable SKStore.Context, defs: Array<Def>): Array<Error> {
    errors = mutable Vector[];
    for (def in defs) {
      if (this.backtrace) this.checkDef(context, def) else {
        try {
          this.checkDef(context, def)
        } catch {
        | ErrorExn(err) -> errors.push(err)
        | exn -> throw exn
        }
      }
    };
    errors.toArray()
  }

  fun checkDef(context: mutable SKStore.Context, def: Def): void {
    def.value match {
    | ExportImport _ -> notSupported(def.pos)
    | ImportExpr _ -> void
    | Global _ -> notSupported(def.pos)
    | ExportAs _ -> notSupported(def.pos)
    | ExportEq _ -> notSupported(def.pos)
    | Module _ -> notSupported(def.pos)
    | ToplevelExpr(e) ->
      subst = Subst::mcreate{context};
      scope = Scope::mcreateToplevel(def.pos.fileName);
      env = mutable TCEnv(context, subst, scope);
      ty = this.expr(env, e);
      this.checkIsVoid(env, e.pos, ty)
    | fd @ FunDef _ ->
      cgNode = fd.name match {
      | Some(name) -> CGNode::create(TopLevelFunDef(name, fd.pos.fileName))
      | None() -> CGNode::create(AnonymousFunDef(fd))
      };
      this.funDef(context, None(), fd, cgNode)
    | Declare _ -> void
    | Namespace _ -> notSupported(def.pos)
    | Export(_, _, d) -> this.checkDef(context, Def(def.pos, d))
    | ExportDefault _ -> notSupported(def.pos)
    | ExportNames _ -> void
    | Import _ -> void
    | c @ Class _ -> this.class_(context, c)
    | Enum _ -> notSupported(def.pos)
    | VarDefs(kind, varDefs) -> this.varDefs(context, kind, varDefs)
    | TypeDef _ -> void
    }
  }

  fun varDefs(
    context: mutable SKStore.Context,
    kind: VarDefKind,
    varDefs: Array<VarDef>,
  ): void {
    for (varDef in varDefs) {
      kind match {
      | VDKConst() -> void
      | VDKLet() -> notSupported(varDef.pat.pos, "toplevel let")
      | VDKVar() -> notSupported(varDef.pat.pos, "toplevel var")
      };
      literalType = varDef.value match {
      | None() -> None()
      | Some(x) -> this.asConstExpr(x)
      };
      type = varDef.type match {
      | None() ->
        literalType match {
        | Some(ty) -> ty
        | _ -> typingError(Array[(varDef.pat.pos, "Missing type annotation")])
        }
      | Some(x) -> this.tenv.normalize(context, x)
      };
      subst = Subst::mcreate{context};
      if (!type.isPrimitiveType(subst, this.tenv)) {
        typingError(
          Array[
            (
              varDef.pat.pos,
              "Invalid type for constant, " +
                "only primitive types (not objects) are allowed",
            ),
          ],
        );
      };
      varDef.pat.value match {
      | PVar _ -> void
      | PArray _ /* (Array<Pattern>) */
      | PObject _ /* (Array<(Name, Pattern)>) */ ->
        internal_error("TODO pattern varDef")
      };
      e = varDef.value match {
      | None() -> typingError(Array[(varDef.pat.pos, "Missing definition")])
      | Some(x) -> x
      };
      scope = Scope::mcreateToplevel(varDef.pat.pos.fileName);
      env = mutable TCEnv(context, subst, scope);
      this.checkSubType(
        env,
        varDef.pat.pos,
        "Invalid definition",
        literalType match {
        | None() ->
          ty = this.expr(env, e);
          ty
        | Some(litType) -> litType
        },
        type,
      )
    }
  }

  fun class_(context: mutable SKStore.Context, c: Class): void {
    targs = TArgs(
      c.tparams.map(tparam -> {
        ttypeParam = TParamWithConstraint(
          tparam.name.value,
          tparam.name.pos.fileName,
          tparam.id,
          tparam.constraint.map(c -> this.tenv.normalize(context, c)),
        );
        TType::fromTParamWithConstraint(
          context,
          this.tenv,
          tparam.name.pos,
          ttypeParam,
          None(),
        )
      }),
    );
    !this.tenv = this.tenv.addTParams(context, c.tparams);
    fileName = c.name.pos.fileName;
    subst = Subst::mcreate{context};
    cstr = TType::inst(c.name, targs);
    thisType = TType::fromTParamWithConstraint(
      context,
      this.tenv,
      c.name.pos,
      TParamWithConstraint("this", fileName, Id::createThis(), None()),
      cstr.getSTypes(subst, this.tenv, Covariant()),
    );
    if (c.extends_.size() != 0) {
      isInterface = c.kind is CKInterface();
      if (c.extends_.size() > 1 && !isInterface) {
        typingError(Array[(c.name.pos, "Cannot extend more than one class")])
      };
      for (ext in c.extends_) {
        ext.value match {
        | TAInst(parentName, parentTArgs) ->
          superCstr = this.tenv.newConstructor(
            context,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
          );
          super = this.tenv.new(
            context,
            parentName,
            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
          );
          if (!isInterface) {
            !this.super = Some((superCstr, super));
          };
          scope = Scope::mcreateToplevel(fileName);
          env = mutable TCEnv(context, subst, scope);
          this.checkSubType(
            env,
            parentName.pos,
            "Invalid extends",
            thisType,
            super,
          )
        | _ -> typingError(Array[(c.name.pos, "Invalid extend")])
        }
      }
    };
    for (interface in c.implements) {
      interface.value match {
      | TAInst(parentName, parentTArgs) ->
        super = this.tenv.new(
          context,
          parentName,
          parentTArgs.map(ty -> this.tenv.normalize(context, ty)),
        );
        scope = Scope::mcreateToplevel(fileName);
        env = mutable TCEnv(context, subst, scope);
        this.checkSubType(
          env,
          parentName.pos,
          "Invalid implements",
          thisType,
          super,
        )
      | _ -> typingError(Array[(c.name.pos, "Invalid implements")])
      }
    };
    hasConstructor = false;
    for (fieldType in c.fields) {
      fieldType match {
      | field @ FieldTypeValue _ ->
        field.setGet match {
        | None() -> void
        | Some(FieldGetSet(_, pos)) -> notSupported(pos)
        };
        for (modifier in field.modifiers.modifiers) {
          typingError(Array[(modifier.pos, "TODO: field modifier")])
        };
        type = this.tenv.normalize(context, field.type);
        field.value match {
        | None() -> void
        | Some(e) ->
          scope = Scope::mcreateToplevel(fileName);
          env = mutable TCEnv(context, subst, scope);
          this.checkSubType(
            env,
            e.pos,
            "Invalid assignment",
            this.expr(env, e, true),
            type,
          )
        }
      | fd @ FunDef _ ->
        if (fd.name is Some(FNNormal(Name(_, "constructor")))) {
          !hasConstructor = true;
          partialThisType = this.tenv.new(
            context,
            c.name,
            targs.targs,
            fieldType ~> (fieldType is FieldTypeValue{value => Some _}),
          );
          _ = this.constructor(
            context,
            thisType,
            partialThisType,
            fd,
            Some(c.name),
          )
        } else {
          cgNode = CGNode::create(
            Method(fd.name, c.name, fd.pos.fileName, fd.isStatic()),
          );
          _ = this.funDef(context, Some((c.kind, thisType)), fd, cgNode)
        }
      }
    };
    if (c.kind is CKInterface() || c.kind is CKAbstract()) return void;
    if (!hasConstructor) {
      for (fieldType in c.fields) {
        fieldType match {
        | field @ FieldTypeValue _ ->
          field.value match {
          | None() ->
            if (field.optional is None()) {
              typingError(Array[(field.pos, "Uninitialized field")])
            }
          | Some(_) -> void
          }
        | FunDef _ -> void
        }
      }
    }
  }

  static fun uninitializedThisType(pos: PosRange): TType {
    TType::single(TObject(TFields::create(Array[]), pos));
  }

  fun funDefSetup(
    context: mutable SKStore.Context,
    thisTypeOpt: ?TType,
    fd: FunDef,
    callingContext: CGNode,
  ): (this, mutable TCEnv) {
    subst = Subst::mcreate{context};
    scope = Scope::mcreateToplevel(fd.pos.fileName) with {callingContext};
    env = mutable TCEnv(context, subst, scope);
    thisTypeOpt match {
    | None() -> void
    | Some(thisType) ->
      !this.tenv.subst["this"] = (false, thisType);
      scope.bind(Name(fd.pos, "this"), thisType, true)
    };
    !this.tenv = this.tenv.addTParams(context, fd.tparams);
    for (i => param in fd.params) {
      (paramName, tyOpt) = param.name match {
      | PNName(n, ty) -> (n, ty)
      | PNDDD(name) ->
        if (i != fd.params.size() - 1) {
          typingError(Array[(name.pos, "... should be the last parameter")])
        };
        (name, None())
      | _ ->
        typingError(
          Array[
            (param.pos, "TODO: support for patterns in function parameters"),
          ],
        )
      };
      paramType = tyOpt match {
      | None() ->
        param.type match {
        | None() -> typingError(Array[(param.pos, "Missing type annotation")])
        | Some(ty) -> ty
        }
      | Some(x) -> x
      };
      scope.bind(paramName, this.tenv.normalize(context, paramType), true)
    };
    !this.retType = fd.retType.i1.map(rty -> this.tenv.normalize(context, rty));
    (this, env)
  }

  fun funDef(
    context: mutable SKStore.Context,
    thisTypeOpt: ?(ClassKind, TType),
    fd: FunDef,
    cgNode: CGNode,
  ): void {
    for (modifier in fd.modifiers.modifiers) {
      modifier.value match {
      | "static" -> !thisTypeOpt = None()
      | unsupported ->
        // TODO: protected, private, public, abstract, readonly
        typingError(
          Array[
            (
              modifier.pos,
              `TODO: support for method modifiers (encountered ${unsupported})`,
            ),
          ],
        )
      }
    };
    (!this, env) = this.funDefSetup(
      context,
      thisTypeOpt.map(x -> x.i1),
      fd,
      cgNode,
    );
    if (this.retType is None()) {
      typingError(Array[(fd.retType.i0, "Missing return type")])
    };
    retType = this.retType.fromSome();
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      !this.isAsync = true;
      tvar = env.subst.gen(asyncPos);
      type = TType::var(tvar);
      this.checkSubType(
        env,
        asyncPos,
        "Async functions must return an object of type Promise<_>",
        retType,
        TType::single(TPromise(type, asyncPos)),
      )
    };
    fd.body match {
    | FDBNone(pos) ->
      if (thisTypeOpt is Some((CKClass(), _))) {
        typingError(Array[(pos, "Missing definition")])
      }
    | FDBSome(body) ->
      if (thisTypeOpt is Some((CKInterface(), _))) {
        typingError(Array[(fd.pos, "An interface cannot implement a method")])
      };
      _ = this.block(env, body);
      term = StmtTermination::block(body);
      if (term.mayFallthrough && !this.isVoid(env, retType)) {
        typingError(
          Array[(fd.pos, "This function may not always return a value")],
        )
      }
    };
  }

  fun isVoid(env: mutable TCEnv, ty: TType): Bool {
    clauses = ty.expand(env.subst, this.tenv, Covariant());
    for (clause in clauses.clauses) {
      clause.stypes match {
      | None() -> return false
      | Some(stypes) ->
        stypes.singleElt() match {
        | Some(TPrimVoid(TVoid(), _)) -> void
        | _ -> return false
        }
      }
    };
    true
  }

  // Returns true if the type is not Top but contains void
  fun nonTopContainsVoid(env: mutable TCEnv, ty: TType): Bool {
    clauses = ty.expand(env.subst, this.tenv, Covariant());
    for (clause in clauses.clauses) {
      clause.stypes match {
      | Some(stypes) if (stypes.any(stype ~> stype is TPrimVoid(TVoid(), _))) ->
        return true
      | _ -> void
      }
    };
    false
  }

  static private fun filterMethods(
    ty: TType,
    subst: mutable Subst,
    env: TEnv,
  ): TType {
    ty.getSTypes(subst, env, Covariant()).flatMap(stypes ~> {
      stypes.singleElt()
    }) match {
    | Some(TObject(fields, pos)) ->
      TType::single(
        TObject(
          fields.filterMap(field -> {
            fieldType = field.type;
            fieldSTypesOpt = fieldType.getSTypes(subst, env, Covariant());
            fieldSTypes = fieldSTypesOpt match {
            | None() -> return None()
            | Some(x) -> x
            };
            !fieldSTypes = fieldSTypes.filterMap(fieldSType ~> {
              fieldSType match {
              | TFuns(funs, _methods, _pos) if (funs.isEmpty()) -> None()
              | TFuns(_funs, methods, _pos) if (!methods.isEmpty()) ->
                internal_error(
                  "TODO: encountered both non-empty funs and methods in filterMethod",
                )
              //Some(tfuns with {methods => Array[]})
              | _ -> Some(fieldSType)
              }
            });
            !fieldType = TType::fromSTypes(fieldType.pos, fieldSTypes);
            if (fieldType.isBottom()) None() else {
              Some(field.mapType(_existingType -> fieldType))
            }
          }),
          pos,
        ),
      )
    | _ -> internal_error("Internal error: new should produce an object")
    }
  }

  fun constructor(
    context: mutable SKStore.Context,
    thisType: TType,
    partialThisType: TType,
    fd: FunDef,
    className: ?Name,
  ): void {
    if (fd.retType.i1 is Some _) {
      typingError(
        Array[(fd.retType.i0, "Constructors don't have return types")],
      );
    };
    if (!fd.modifiers.modifiers.isEmpty()) {
      typingError(
        Array[
          (
            fd.modifiers.modifiers.firstItem().i1.pos,
            "Constructors cannot have modifiers",
          ),
        ],
      );
    };
    cgNode = CGNode::create(
      className match {
      | Some(cname) -> Constructor(cname, fd.pos.fileName)
      | None() -> AnonymousFunDef(fd)
      },
    );
    (!this, env) = this.funDefSetup(context, Some(partialThisType), fd, cgNode);
    env.localObjects!["this"] = Some(thisType);
    fd.isAsync match {
    | None() -> void
    | Some(asyncPos) ->
      typingError(Array[(asyncPos, "Constructors cannot be async")])
    };
    fd.body match {
    | FDBNone(pos) -> typingError(Array[(pos, "Missing definition")])
    | FDBSome(body) ->
      blockScope = this.block(env, body);
      blockThisType = blockScope.get(Name(fd.pos, "this"));
      objType = static::filterMethods(blockThisType, env.subst, this.tenv);
      fullType = static::filterMethods(thisType, env.subst, this.tenv);
      this.checkSubType(
        env,
        fd.pos,
        "Invalid initialization",
        objType,
        fullType,
      )
    };
  }

  fun block(
    env: mutable TCEnv,
    stmts: Array<Stmt>,
    cond: ?(Expr, Bool) = None(),
  ): readonly Scope {
    scopeCopy = env.scope;
    scope = env.mcreateSubScope{isLoop => false};
    env.!scope = scope;
    cond match {
    | None() -> void
    | Some((c, target)) -> this.evalCond(env, c, target)
    };
    for (st in stmts) {
      this.stmt(env, st)
    };
    env.!scope = scopeCopy;
    scope
  }

  fun checkSubType(
    env: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty1: TType,
    ty2: TType,
  ): void {
    isSubTType(env.subst, this.tenv, ty1, ty2) match {
    | STOk() -> void
    | STRec(reason, pos1, subTy2) ->
      typingError(
        Array[
          (pos, msg),
          (
            pos1,
            reason.toString(
              env.subst,
              this.tenv,
              expandTVars(env.subst, this.tenv, ty1),
            ),
          ),
          (
            subTy2.pos,
            "It is incompatible with: " +
              expandTVars(env.subst, this.tenv, subTy2).toString(),
          ),
        ],
      )
    | status ->
      typingError(Array[(pos, status.toString(env.subst, this.tenv, ty1))])
    }
  }

  fun bind(
    env: mutable TCEnv,
    kind: BindKind,
    pat: Pattern,
    type: TType,
    isInitialized: Bool,
    isLocalObject: Bool,
  ): void {
    pos = pat.pos;
    pat.value match {
    | PVar(local) ->
      if (
        isLocalObject &&
        !env.scope.isThroughLoop(local) &&
        !env.localObjects.containsKey(local.value)
      ) {
        env.localObjects![local.value] = None()
      };
      env.scope.bind(local, type, isInitialized)
    | PArray(arrPat) ->
      type.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TTuple(tyl, _)) ->
        if (arrPat.size() != tyl.size()) {
          typingError(
            Array[
              (
                pos,
                "Invalid tuple pattern size, it is of size " + arrPat.size(),
              ),
              (
                type.pos,
                "It is incompatible with a tuple of size " + tyl.size(),
              ),
            ],
          )
        };
        for (i in Range(0, arrPat.size())) {
          this.bind(env, kind, arrPat[i], tyl[i], isInitialized, false)
        }
      | _ ->
        typingError(
          Array[
            (pos, "Invalid tuple pattern"),
            (type.pos, "This is not a tuple, it is " + type.toString()),
          ],
        )
      }

    | PObject(objectFields) ->
      type.getSTypes(env.subst, this.tenv, Covariant()) match {
      | None() ->
        typingError(
          Array[
            (pos, "Invalid object pattern"),
            (type.pos, "This is " + type.toString()),
          ],
        )
      | Some(stypes) ->
        for (stype in stypes) {
          branches = stype match {
          | TObject(fields, _) -> Array[fields]
          | a @ TAlgebraic _ -> a.branches.toArray().map(x -> x.fields)
          | _ ->
            typingError(
              Array[
                (pos, "Invalid object pattern"),
                (type.pos, "This is " + type.toString()),
              ],
            )
          };
          for (field in objectFields) {
            (fieldName, fieldPat) = field;
            for (fields in branches) {
              fields.maybeGet(fieldName.value) match {
              | None() ->
                typingError(
                  Array[
                    (
                      fieldName.pos,
                      "The field " + fieldName.value + " is missing",
                    ),
                    (type.pos, "Out of " + type.toString()),
                  ],
                )
              | Some(tfield) ->
                this.bind(
                  env,
                  kind,
                  fieldPat,
                  tfield.type,
                  isInitialized,
                  false,
                )
              }
            }
          }
        }
      }
    }
  }

  fun bindType(
    pos: PosRange,
    env: mutable TCEnv,
    kind: BindKind,
    type: ?Type,
    value: ?Expr,
  ): (TType, Bool) {
    value match {
    | None() ->
      if (kind is BKConst()) {
        typingError(Array[(pos, "Const must be bound to a value")]);
      };
      type match {
      | None() -> typingError(Array[(pos, "Was expecting a type or a value")])
      | Some(annotAst) ->
        ty = this.tenv.normalize(env.context, annotAst);
        (ty, false)
      }
    | Some(e) ->
      ty = this.expr(env, e, kind is BKConst());
      type match {
      | None() -> (ty, true)
      | Some(annotAst) ->
        annot = this.tenv.normalize(env.context, annotAst);
        this.checkSubType(env, annotAst.pos, "Invalid annotation", ty, annot);
        (annot, true)
      }
    }
  }

  fun checkIsVoid(env: mutable TCEnv, pos: PosRange, ty: TType): void {
    this.checkSubType(
      env,
      pos,
      "This expression was expected to be of type void",
      ty,
      TType::single(TPrimVoid(TVoid(), ty.pos)),
    );
  }

  static fun isPossiblyNonVoidExpressionAllowedAsStatement(e: Expr): Bool {
    e.value match {
    | Binop(BOAssignment(), _, _)
    | Binop(BOOpAssignment(_), _, _)
    | PostOp(PODecr(), _)
    | PostOp(POIncr(), _) ->
      true
    | _ -> false
    }
  }

  fun stmt(env: mutable TCEnv, st: Stmt): void {
    st.value match {
    | Break() -> void
    | Continue() -> void
    | StmtEmpty() -> void
    | StmtExpr(e) ->
      ty = this.expr(env, e);
      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {
        this.checkIsVoid(env, e.pos, ty)
      }
    | Return(pos, eOpt) ->
      retType = this.retType match {
      | None() ->
        TType::single(TPrimVoid(TVoid(), st.pos)) // constructor
      | Some(x) -> x
      };
      (epos, etype) = eOpt match {
      | None() -> (pos, TType::single(TPrimVoid(TVoid(), pos)))
      | Some(e) -> (e.pos, this.expr(env, e, true))
      };
      rtype = if (this.isAsync) {
        TType::single(TPromise(etype, epos))
      } else {
        etype
      };
      this.checkSubType(env, epos, "Invalid return type", rtype, retType)

    | Bind(BKVar(), vars) ->
      if (vars.size() == 0) internal_error("vars size should not be 0");
      typingError(
        Array[(vars[0].pat.pos, "Don't use var, use let or const instead")],
      )

    | Bind(bkind, bindings) ->
      for (binding in bindings) {
        (ty, isInitialized) = this.bindType(
          binding.pat.pos,
          env,
          bkind,
          binding.type,
          binding.value,
        );
        this.bind(
          env,
          bkind,
          binding.pat,
          ty,
          isInitialized,
          binding.value is Some(Expr(_, Object _)),
        )
      }

    | If(e, block1, block2) ->
      this.checkBool(env, e);
      scope1 = this.block(env, block1, Some((e, true)));
      scope2 = block2 match {
      | None() -> env.mcreateSubScope{isLoop => false}
      | Some(b) -> this.block(env, b, Some((e, false)))
      };
      env.mergeScope(env.subst, this.tenv, scope1, scope2);
      if (isTerminalBlock(false, block1)) {
        this.evalCond(env, e, false);
      }

    | For(initStmt, cond, incr, block) ->
      scopeCopy = env.scope;
      initScope = env.mcreateSubScope{isLoop => false};
      env.!scope = initScope;
      this.stmt(env, initStmt);
      loopScope = env.mcreateSubScope{isLoop => true};
      env.!scope = loopScope;
      this.checkBool(env, cond);
      loopBody = this.block(env, block);
      env.popScopeReplace(loopBody);
      _ = this.expr(env, incr);
      env.!scope = initScope;
      env.popScope(env.subst, this.tenv, loopScope);
      env.!scope = scopeCopy;
      env.popScopeReplace(initScope)
    | Block(stmts) ->
      for (stmt in stmts) {
        this.stmt(env, stmt)
      }
    | ForIn _ ->
      typingError(
        Array[
          (
            st.pos,
            "TODO: for ... in not implemented, you can use a normal for (for now)",
          ),
        ],
      )
    | ForOf _ ->
      typingError(
        Array[
          (
            st.pos,
            "TODO: for ... of not implemented, you can use a normal for (for now)",
          ),
        ],
      )
    | Throw(e) -> _ = this.expr(env, e)
    | While(cond, block) ->
      scopeCopy = env.scope;
      loopScope = env.mcreateSubScope{isLoop => true};
      env.!scope = loopScope;
      this.checkBool(env, cond);
      loopBody = this.block(env, block, Some((cond, true)));
      env.popScopeReplace(loopBody);
      env.!scope = scopeCopy;
      env.popScope(env.subst, this.tenv, loopScope)
    | Switch(e, branches) ->
      this.switchCheckExhaustiveness(env, e, branches);
      this.switch(env, e, branches)
    }
  }

  fun switch(env: mutable TCEnv, e: Expr, branches: Array<SwitchBranch>): void {
    if (branches.size() == 0) {
      typingError(Array[(e.pos, "Missing branch")])
    };
    checkBreak = block -> {
      term = StmtTermination::block(block);
      if (term.mayFallthrough) {
        if (block.size() == 0) {
          internal_error("block size should not be 0")
        };
        last = block[block.size() - 1];
        typingError(Array[(last.pos, "Missing break")])
      }
    };
    scope = branches[0] match {
    | Case(v, block) ->
      checkBreak(block);
      cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
      this.block(env, block, Some((cond, true)))
    | Default(_) -> typingError(Array[(e.pos, "Missing branch")])
    };
    for (i in Range(1, branches.size())) {
      env.mergeScope(
        env.subst,
        this.tenv,
        scope,
        branches[i] match {
        | Case(v, block) ->
          checkBreak(block);
          cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));
          this.block(env, block, Some((cond, true)))
        | Default(stmts) -> this.block(env, stmts)
        },
      )
    }
  }

  fun switchCheckExhaustiveness(
    env: mutable TCEnv,
    e: Expr,
    branches: Array<SwitchBranch>,
  ): void {
    condType = this.expr(env, e, true);
    cases = condType
      .getSTypes(env.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TPrimValue(_, Some(values), _)) ->
      Set::mcreateFromItems(values.values.map(x -> x.i1))
    | _ -> return void
    };
    for (branch in branches) {
      branch match {
      | Case(v, _) ->
        this.expr(env, v, true)
          .getSTypes(env.subst, this.tenv, Covariant())
          .flatMap(stypes ~> stypes.staticValue()) match {
        | Some(staticValue) ->
          if (!cases.contains(staticValue)) {
            typingError(Array[(v.pos, "Unused branch")])
          };
          cases.remove(staticValue)
        | None() -> void
        }

      | Default(stmts) ->
        if (cases.isEmpty()) {
          if (stmts.isEmpty()) {
            internal_error("Internal error: empty default");
          };
          typingError(Array[(stmts[0].pos, "Unused branch")])
        };
        cases.clear()
      }
    };
    if (!cases.isEmpty()) {
      typingError(Array[(e.pos, "Missing branches:\n" + cases.join("\n"))]);
    }
  }

  fun checkBool(env: mutable TCEnv, e: Expr): void {
    this.checkSubType(
      env,
      e.pos,
      "A condition is expected to be of type boolean, not: ",
      this.expr(env, e),
      TType::single(TPrimValue(TBool(), None(), e.pos)),
    );
  }

  fun checkStringifiable(env: mutable TCEnv, pos: PosRange, ty: TType): void {
    // Check if the type is a primitive type that can be converted to string
    // Allowed types: string, number, bigint, boolean, null, undefined
    isStringifiable = ty.getSTypes(env.subst, this.tenv, Covariant()) match {
    | None() -> false
    | Some(stypes) ->
      stypes.singleElt() match {
      | Some(TPrimValue(TString(), _, _)) -> true
      | Some(TPrimValue(TNum(), _, _)) -> true
      | Some(TPrimValue(TBigInt(), _, _)) -> true
      | Some(TPrimValue(TBool(), _, _)) -> true
      | Some(TPrimVoid(TNull(), _)) -> true
      | Some(TPrimVoid(TUndefined(), _)) -> true
      | Some(TPrimVoid(TVoid(), _)) -> true
      | _ -> false
      }
    };

    if (!isStringifiable) {
      typingError(
        Array[
          (
            pos,
            "Template literal expressions must be string, number, bigint, boolean, null, or undefined",
          ),
        ],
      );
    }
  }

  /* Typechecks expression  obj.fieldName
             or expression  obj?.fieldName  if optionalChaining is true
       where obj has type objType */
  fun dot(
    env: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    fieldName: Name,
    optionalChaining: Bool = false,
  ): TType {
    if (fieldName.value == "constructor") {
      typingError(Array[(fieldName.pos, "Cannot access field 'constructor'")]);
    };
    stypes = objType.getSTypes(env.subst, this.tenv, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) -> stypes
    | _ ->
      typingError(
        Array[
          (pos, "Invalid '.' for type: " + prettyPrintType(false, objType)),
        ],
      )
    };
    result = TType::bottom(pos);
    optionalChainingIsUseless = optionalChaining;
    optionalChainingIsAlwaysUndefined = optionalChaining;
    for (stype in stypes) {
      optionalChainingIsAlwaysUndefinedForThisSType = false;
      stype match {
      | TObject(fields, _) ->
        fieldType = fields.maybeGetType(env.subst, this.tenv, fieldName) match {
        | Some(ty) -> ty
        | None() ->
          fields.maybeGetType(env.subst, this.tenv, Name(pos, "[]")) match {
          | None() -> fields.getTypeTypingError(fieldName)
          | Some(indexType) ->
            fieldNameType = TType::single(
              TPrimValue(
                TString(),
                Some(ArrayValues::single((fieldName.pos, fieldName.value))),
                fieldName.pos,
              ),
            );
            this.call(
              env,
              pos,
              indexType,
              Array[],
              Array[fieldNameType],
            ).withPos(pos)
          }
        };
        !result = TType::union(env.subst, this.tenv, result, fieldType)

      | TAlgebraic(branches, _) ->
        for (branch in branches) {
          !result = TType::union(
            env.subst,
            this.tenv,
            result,
            branch.getType(env.subst, this.tenv, fieldName),
          )
        }
      | TPrimValue(primKind, _, stringPos) ->
        objName = primKind.toString();
        obj = this.tenv.newObject(
          env.context,
          Name(stringPos, objName),
          Array[],
        );
        !result = TType::union(
          env.subst,
          this.tenv,
          result,
          obj.fields.getType(env.subst, this.tenv, fieldName),
        )
      | TPrimVoid(TUndefined(), undefPos)
      | TPrimVoid(
        TNull(),
        undefPos,
      ) if (optionalChaining) ->
        !result = result.unionUndefined(env.subst, this.tenv, undefPos);
        !optionalChainingIsUseless = false;
        !optionalChainingIsAlwaysUndefinedForThisSType = true
      | _ ->
        typingError(
          Array[
            (pos, "Invalid '.'"),
            (
              stype.pos,
              "For type: " + prettyPrintType(false, TType::single(stype)),
            ),
          ],
        )
      };
      !optionalChainingIsAlwaysUndefined =
        optionalChainingIsAlwaysUndefined &&
        optionalChainingIsAlwaysUndefinedForThisSType;
    };
    if (optionalChainingIsUseless) {
      typingError(
        Array[
          (pos, "Useless '?.'. Use '.' instead"),
          (objType.pos, `${objType} is never null nor undefined`),
        ],
      )
    };
    if (optionalChainingIsAlwaysUndefined) {
      typingError(
        Array[
          (pos, "Result of optional chaining is always undefined"),
          (objType.pos, `${objType} is always null or undefined`),
        ],
      )
    };
    result
  }

  /* Typechecks expression  obj[idx]
             or expression  obj.idx
             or expression  obj?.idx  if optionalChaining is true
     where obj has type objType */
  fun get(
    env: mutable TCEnv,
    pos: PosRange,
    objType: TType,
    idx: Expr,
    optionalChaining: Bool = false,
  ): TType {
    idx.value match {
    | EString("constructor") ->
      typingError(Array[(idx.pos, "Cannot access field 'constructor'")])
    | _ -> void
    };
    stypes = objType.getSTypes(env.subst, this.tenv, Covariant()) match {
    | Some(stypes) if (!stypes.isEmpty()) ->
      Vector::mcreateFromIterator(stypes.values())
    | _ ->
      typingError(
        Array[
          (pos, `Invalid access for type ${prettyPrintType(false, objType)}`),
        ],
      )
    };
    idxType = this.expr(env, idx, true);
    idxSType = idxType
      .getSTypes(env.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(ty @ TPrimValue(TString(), _, _))
    | Some(ty @ TPrimValue(TNum(), _, _)) ->
      ty
    | _ -> typingError(Array[(idx.pos, "Invalid index type")])
    };
    result = TType::bottom(pos);
    optionalChainingIsUseless = optionalChaining;
    optionalChainingIsAlwaysUndefined = optionalChaining;
    while (!stypes.isEmpty()) {
      stype = stypes.pop();

      optionalChainingIsAlwaysUndefinedForThisSType = false;
      stype match {
      | TTuple(tyArr, tuplePos) ->
        n = idxSType match {
        | TPrimValue(TNum(), Some(numbers), _) ->
          numbers.singleElt().flatMap(s -> s.i1.toIntOption())
        | _ -> None()
        } match {
        | None() ->
          typingError(
            Array[
              (idx.pos, "Invalid index"),
              (tuplePos, "A tuple expects a static index"),
            ],
          )
        | Some(x) -> x
        };
        !result = TType::union(env.subst, this.tenv, result, tyArr[n])

      | TObject(fields, objectPos) if (fields.fields.isEmpty()) ->
        !result = TType::top(objectPos)

      | TObject(fields, objectPos) ->
        idxSType.values match {
        | None() -> Some(idxSType)
        | Some(values) ->
          values
            .filter(posAndFieldName ->
              fields.maybeGetType(
                env.subst,
                this.tenv,
                Name(posAndFieldName.i0, posAndFieldName.i1),
              ) match {
              | Some(ty) ->
                !result = TType::union(env.subst, this.tenv, result, ty);
                false
              | None() -> true
              }
            )
            .map(remainingValues ->
              idxSType with {values => Some(remainingValues)}
            )
        } match {
        | None() -> void
        | Some(idxSTypeToPassToIdxMethod) ->
          fields.maybeGetType(env.subst, this.tenv, Name(pos, "[]")) match {
          | None() ->
            idxSType.values match {
            | None() ->
              typingError(
                Array[
                  (pos, "Invalid access"),
                  (idx.pos, `Index has non-literal type ${idxSType.kind}`),
                  (objectPos, "But object has no index field"),
                ],
              )
            | Some(values) ->
              fields.getTypeTypingError(Name(pos, values.toStringList()))
            }
          | Some(idxMethodType) ->
            ty = this.call(
              env,
              pos,
              idxMethodType,
              Array[],
              Array[TType::single(idxSTypeToPassToIdxMethod)],
            ).withPos(pos);
            !result = TType::union(env.subst, this.tenv, result, ty)
          }
        }

      | TAlgebraic(branches, _) ->
        idxSType match {
        | TPrimValue(TString(), Some(values), _) ->
          values.singleElt().map(v -> Name(v.i0, v.i1))
        | _ -> None()
        } match {
        | None() ->
          typingError(
            Array[
              (idx.pos, "Invalid index"),
              (pos, "An algebraic expects a static index"),
            ],
          )
        | Some(fieldName) ->
          for (branch in branches) {
            !result = TType::union(
              env.subst,
              this.tenv,
              result,
              branch.getType(env.subst, this.tenv, fieldName),
            )
          }
        }

      | TPrimValue(primKind, _, primPos) ->
        objName = primKind.toString();
        obj = this.tenv.newObject(env.context, Name(primPos, objName), Array[]);
        stypes.push(obj)

      | TPrimVoid(TUndefined(), undefPos)
      | TPrimVoid(
        TNull(),
        undefPos,
      ) if (optionalChaining) ->
        !optionalChainingIsUseless = false;
        !optionalChainingIsAlwaysUndefinedForThisSType = true;
        !result = result.unionUndefined(env.subst, this.tenv, undefPos)

      | _ ->
        typingError(
          Array[
            (pos, "Type cannot be accessed"),
            (
              idxType.pos,
              "This is a " + prettyPrintType(false, TType::single(stype)),
            ),
          ],
        )
      };
      !optionalChainingIsAlwaysUndefined =
        optionalChainingIsAlwaysUndefined &&
        optionalChainingIsAlwaysUndefinedForThisSType;
    };
    if (optionalChainingIsUseless) {
      typingError(
        Array[
          (pos, "Useless '?.'. Use '.' instead"),
          (objType.pos, `${objType} is never null nor undefined`),
        ],
      )
    };
    if (optionalChainingIsAlwaysUndefined) {
      typingError(
        Array[
          (pos, "Result of optional chaining is always undefined"),
          (objType.pos, `${objType} is always null or undefined`),
        ],
      )
    };
    result
  }

  fun nonVoidExpr(pos: PosRange, env: mutable TCEnv, e: Expr): TType {
    ty = this.expr(env, e);
    if (this.nonTopContainsVoid(env, ty)) {
      typingError(
        Array[
          (pos, "Invalid operation on type void"),
          (e.pos, `This expression has type ${ty}`),
        ],
      )
    };
    ty
  }

  /* Typechecks expression e
     If mostPrecise, use the most precise type. */
  fun expr(env: mutable TCEnv, e: Expr, mostPrecise: Bool = false): TType {
    if (mostPrecise) {
      this.asConstExpr(e) match {
      | Some(ty) -> return ty
      | None() -> void
      }
    };

    pos = e.pos;
    e.value match {
    | Number(_) -> TType::single(TPrimValue(TNum(), None(), pos))
    | BigInt(_) -> TType::single(TPrimValue(TBigInt(), None(), pos))
    | EString(_) -> TType::single(TPrimValue(TString(), None(), pos))
    | TemplateLiteral(_parts, exprs) ->
      // Type check all embedded expressions - allow primitive types that can be converted to strings
      strType = TType::single(TPrimValue(TString(), None(), pos));
      for (expr in exprs) {
        ety = this.expr(env, expr);
        this.checkStringifiable(env, expr.pos, ety);
      };
      strType

    | Var(Name(_, "true"))
    | Var(Name(_, "false")) ->
      TType::single(TPrimValue(TBool(), None(), pos))
    | Var(Name(_, "null")) ->
      this.makeBoundTVar(env, TType::single(TPrimVoid(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      this.makeBoundTVar(env, TType::single(TPrimVoid(TUndefined(), pos)))
    | Var(local) ->
      if (env.localObjects.containsKey(local.value)) {
        env.usedObjects![local.value] = local.pos
      };
      env.scope.maybeGet(local) match {
      | None() ->
        defs = if (this.builtins.contains(local.value)) {
          this.defMap.get(env.context, this.builtinsFileName, local)
        } else {
          this.defMap.get(
            env.context,
            FileName::create(local.pos.fileName),
            local,
          )
        };
        for (def in defs) {
          def.value match {
          | fd @ FunDef _ ->
            break this.tenv.funDecl(
              env.context,
              false,
              fd,
              fd.cgNode match {
              | Some(n) -> n
              | None() -> CGNode::create(AnonymousFunDef(fd))
              },
            ).i1
          | c @ Class _ -> break this.tenv.newStatic(env.context, c.name)
          | VarDefs(kind, varDefArr) ->
            if (varDefArr.size() != 1) {
              internal_error("varDefArr size should be 1")
            };
            varDef = varDefArr[0];
            if (!(kind is VDKConst _)) {
              typingError(
                Array[(varDef.pat.pos, "Construction not supported")],
              );
            };
            if (!(varDef.pat is Pattern(_, PVar _))) {
              typingError(
                Array[(varDef.pat.pos, "Construction not supported")],
              );
            };
            break varDef.type match {
            | None() ->
              varDef.value match {
              | None() -> None()
              | Some(x) -> this.asConstExpr(x)
              } match {
              | None() -> this.newTVar(env, pos)
              | Some(ty) -> ty
              }
            | Some(ty) -> this.tenv.normalize(env.context, ty)
            }
          | _ -> void
          }
        } else {
          typingError(Array[(pos, "Unbound name")])
        }
      | Some(localDef) -> localDef
      }
    | Object(efields) ->
      algebraicBranchField: ?(PosRange, TType) = None();
      fields = mutable Vector[];
      for (efield in efields) {
        (name, ty) = efield match {
        | FDNormal(x, y) ->
          (x, this.expr(env, y, x.value == kAlgebraicBranchFieldName))

        | FDSpread _ -> internal_error("TODO spread")
        | fd @ FunDef _ ->
          cgNode = CGNode::create(AnonymousFunDef(fd));
          this.tenv.funDecl(env.context, true, fd, cgNode)
        };
        TField::create(name.pos, name.value, false, ty) match {
        | None() ->
          algebraicBranchField match {
          | Some((existingPos, _existingType)) ->
            typingError(
              Array[
                (name.pos, `Duplicate field ${name.value}`),
                (existingPos, "Previously declared here"),
              ],
            )
          | None() -> void
          };
          !algebraicBranchField = Some((name.pos, ty))
        | Some(field) -> fields.push(field)
        }
      };
      obj = createObject(
        pos,
        algebraicBranchField,
        TFields::create(fields.toArray()),
      );
      for (efield in efields) {
        efield match {
        | fd @ FunDef _ ->
          if (fd.name is Some(FNNormal(Name(_, "constructor")))) {
            this.constructor(
              env.context,
              obj,
              static::uninitializedThisType(pos),
              fd,
              None(),
            )
          } else {
            cgNode = CGNode::create(AnonymousFunDef(fd));
            this.funDef(env.context, Some((CKClass(), obj)), fd, cgNode)
          }
        | _ -> void
        }
      };
      obj
    | Call(Expr(_, Var(Name(superPos, "super"))), targs, args) ->
      this.super match {
      | None() -> typingError(Array[(superPos, "'super' is not defined")])
      | Some((superCstr, super)) ->
        if (targs.size() != 0) {
          typingError(
            Array[(pos, "super cannot be called with type arguments")],
          );
        };
        this.callConstructor(
          env,
          pos,
          superCstr,
          args.map(x -> this.expr(env, x)),
        );
        thisName = Name(pos, "this");
        thisType = TType::inter(
          env.subst,
          this.tenv,
          env.scope.get(thisName),
          super,
        );
        env.scope.set(thisName, thisType, (x, y) -> {
          this.checkSubType(env, pos, "Invalid super call", x, y)
        })
      };
      TType::single(TPrimVoid(TVoid(), pos))

    | Call(Expr(_, Var(Name(_, "__SKJS_show"))), _, args) ->
      exprTy = this.expr(env, args[0]);
      clauses = exprTy.expand(env.subst, this.tenv, Covariant());
      ty = TType::fromClauses(exprTy.pos, clauses);
      print_error(prettyPrintType(false, ty));
      TType::single(TPrimVoid(TVoid(), pos))
    | Call(f, targs, args) ->
      rty = this.call(
        env,
        pos,
        this.expr(env, f),
        targs.map(ty -> this.tenv.normalize(env.context, ty)),
        args.map(x -> this.expr(env, x)),
      );
      f.value match {
      | Binop(
        BODot(),
        Expr(_, Var(Name(_, "console"))),
        Expr(_, Var(Name(_, "assert"))),
      ) if (args.size() >= 1) ->
        this.evalCond(env, args[0], true)
      | _ -> void
      };
      rty
    | New(className, targsAst, argsAst) ->
      targs = if (targsAst.size() == 0) {
        this.tenv.makeTArgs(env.context, env.subst, className)
      } else {
        targsAst.map(targ -> this.tenv.normalize(env.context, targ))
      };
      cstr = this.tenv.newConstructor(env.context, className, targs);
      this.callConstructor(env, pos, cstr, argsAst.map(e -> this.expr(env, e)));
      this.tenv.new(env.context, className, targs)

    | Get(arr, idx) -> this.get(env, pos, this.expr(env, arr), idx)

    | EArray(arr) -> TType::single(TTuple(arr.map(x -> this.expr(env, x)), pos))

    | Unop(uop, subExpr) ->
      uop match {
      | UOExclamationMark() ->
        bool = TType::single(TPrimValue(TBool(), None(), pos));
        this.checkSubType(env, pos, "Invalid !", this.expr(env, subExpr), bool);
        bool
      | _ -> typingError(Array[(pos, "TODO: unary operator")])
      }

    | Binop(op, e1, e2) ->
      op match {
      | BOAddition() ->
        ty1 = this.expr(env, e1);
        ty1.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
          stypes.singleElt()
        ) match {
        | Some(TPrimValue(k @ TNum(), _, primPos))
        | Some(TPrimValue(k @ TString(), _, primPos))
        | Some(TPrimValue(k @ TBigInt(), _, primPos)) ->
          ty2 = this.expr(env, e2);
          res = TType::single(TPrimValue(k, None(), primPos));
          this.checkSubType(env, e2.pos, "Invalid + operand", ty2, res);
          res
        | _ ->
          typingError(
            Array[
              (pos, "Invalid + operation"),
              (e1.pos, `For an object of type: ${ty1}`),
            ],
          )
        }
      | BOAssignment() -> this.assign(env, pos, e1, e2)
      | BOStrictInequality()
      | BOStrictEquality() ->
        ty1 = this.nonVoidExpr(pos, env, e1);
        ty2 = this.nonVoidExpr(pos, env, e2);
        if (ty1.clauses.clauses.isEmpty() && ty2.clauses.clauses.isEmpty()) {
          isSubTType(env.subst, this.tenv, ty1, ty2) match {
          | STOk() -> void
          | _ ->
            isSubTType(env.subst, this.tenv, ty2, ty1) match {
            | STOk() -> void
            | _ ->
              alwaysResult = op match {
              | BOStrictEquality() -> "false"
              | BOStrictInequality() -> "true"
              | _ -> internal_error("Internal error: unexpected operator")
              };
              typingError(
                Array[(pos, "This is equality is always " + alwaysResult)],
              )
            }
          }
        };
        TType::single(TPrimValue(TBool(), None(), pos))

      | BOLogicalAnd() ->
        ty1 = this.expr(env, e1);
        this.checkSubType(
          env,
          pos,
          "Invalid &&",
          ty1,
          TType::single(TPrimValue(TBool(), None(), e1.pos)),
        );
        this.evalCond(env, e1, true);
        ty2 = this.expr(env, e2);
        this.checkSubType(
          env,
          pos,
          "Invalid &&",
          ty2,
          TType::single(TPrimValue(TBool(), None(), e2.pos)),
        );
        TType::single(TPrimValue(TBool(), None(), pos))
      | BOLogicalOr() ->
        ty1 = this.expr(env, e1);
        this.checkSubType(
          env,
          pos,
          "Invalid ||",
          ty1,
          TType::single(TPrimValue(TBool(), None(), e1.pos)),
        );
        this.evalCond(env, e1, false);
        ty2 = this.expr(env, e2);
        this.checkSubType(
          env,
          pos,
          "Invalid ||",
          ty2,
          TType::single(TPrimValue(TBool(), None(), e2.pos)),
        );
        TType::single(TPrimValue(TBool(), None(), pos))

      | BODot() ->
        e2.value match {
        | Var(fieldName) -> this.dot(env, e1.pos, this.expr(env, e1), fieldName)
        | _ -> typingError(Array[(e2.pos, "Invalid '.'")])
        }

      | BOOptionalDot() ->
        e2.value match {
        | Var(fieldName) ->
          this.dot(
            env,
            e1.pos,
            this.expr(env, e1),
            fieldName,
            true/* optionalChaining */ ,
          )
        | _ -> typingError(Array[(e2.pos, "Invalid '?.'")])
        }

      | BOLessThan()
      | BOLessThanOrEqual()
      | BOGreaterThan()
      | BOGreaterThanOrEqual() ->
        getExprPrimKind = (e) -> {
          ty = this.expr(env, e);
          ty.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
            stypes.singleElt()
          ) match {
          | Some(TPrimValue(k, _, _)) -> k
          | _ ->
            typingError(
              Array[
                (
                  pos,
                  "Invalid comparison. You can only compare strings, numbers, bigints, and booleans.",
                ),
                (e1.pos, `This is a ${ty}`),
              ],
            )
          }
        };
        kind1 = getExprPrimKind(e1);
        kind2 = getExprPrimKind(e2);
        if (kind1 != kind2) {
          typingError(
            Array[
              (
                pos,
                "Invalid comparison. Both operands must have the same type.",
              ),
              (e1.pos, `This is a ${kind1}`),
              (e2.pos, `This is a ${kind2}`),
            ],
          )
        };
        TType::single(TPrimValue(TBool(), None(), pos))

      | BOOpAssignment(assOp) ->
        this.expr(
          env,
          Expr(pos, Binop(BOAssignment(), e1, Expr(pos, Binop(assOp, e1, e2)))),
        )

      | BOAs() -> notSupported(pos)
      | BOMultiplication()
      | BODivision()
      | BORemainder()
      | BOSubtraction()
      | BOBitwiseAnd()
      | BOBitwiseOr()
      | BOBitwiseXor()
      | BOLeftShift()
      | BOSignedRightShift()
      | BOZeroFilledRightShift() ->
        ty1 = this.expr(env, e1);
        kind1 = this.checkIsNumeric(env, e1.pos, "Invalid operation", ty1);
        ty2 = this.expr(env, e2);
        kind2 = this.checkIsNumeric(env, e2.pos, "Invalid operation", ty2);
        if (kind1 != kind2) {
          typingError(
            Array[
              (
                pos,
                "Arithmetic operations require both operands to be the same numeric type",
              ),
              (e1.pos, `Left operand is ${kind1}`),
              (e2.pos, `Right operand is ${kind2}`),
            ],
          )
        };
        TType::single(TPrimValue(kind1, None(), pos))

      | BONullishCoalescing() ->
        ty1 = this.nonVoidExpr(pos, env, e1);
        ty2 = this.expr(env, e2);
        ty1.getSTypes(env.subst, this.tenv, Covariant()) match {
        | None() -> void
        | Some(stypes) ->
          hasNullOrUndefined = stypes.any(stype ~> stype is TPrimVoid _);
          if (!hasNullOrUndefined) {
            typingError(
              Array[
                (pos, "This operator is useless"),
                (e1.pos, "This construction is never null or undefined"),
              ],
            );
          }
        };
        TType::union(env.subst, this.tenv, ty1, ty2)
      }

    | InstanceOf(e1, Expr(_, Var(className))) ->
      _ = this.expr(env, e1);
      _ = this.tenv.getClass(env.context, className);
      TType::single(TPrimValue(TBool(), None(), pos))
    | InstanceOf(_, e2) -> typingError(Array[(e2.pos, "Unexpected instanceof")])
    | TypeOf(subExpr) ->
      _ = this.nonVoidExpr(pos, env, subExpr);
      TType::single(TPrimValue(TString(), None(), pos))

    | PostOp(pop, subExpr) ->
      pop match {
      | PODecr()
      | POIncr() ->
        num = TType::single(TPrimValue(TNum(), None(), pos));
        ty = this.expr(env, subExpr);
        this.checkSubType(env, pos, "Expected integer", ty, num);
        num
      | POExcl() -> notSupported(pos)
      }

    | c @ Closure(params, retTypeAstOpt, body) ->
      paramTypes = mutable Vector[];
      noAnnot: ?PosRange = None();
      for (param in params) {
        paramType = param.i1 match {
        | None() ->
          if (noAnnot is None()) {
            !noAnnot = Some(param.i0.pos)
          };
          this.newTVar(env, param.i0.pos)
        | Some(ty) -> this.tenv.normalize(env.context, ty)
        };
        paramTypes.push((param.i0, paramType));
      };
      retType = retTypeAstOpt match {
      | None() -> this.newTVar(env, pos)
      | Some(retTypeAst) -> this.tenv.normalize(env.context, retTypeAst)
      };
      callingContext = CGNode::create(AnonymousLambda(pos, c));
      // Register a dependency from parent context on this lambda
      this.callgraph.recordCalls(
        env.context,
        env.scope.callingContext,
        CGNodes::singleton(callingContext),
      );
      savedScope = env.scope.clone() with {callingContext};

      lambdas = if (noAnnot is None()) {
        this.closure(
          env.subst,
          savedScope,
          paramTypes.toArray(),
          retType,
          body,
        );
        Array[]
      } else {
        Array[
          Lambda(pos, (subst, argsTypes, retType) ~> {
            args = params.mapWithIndex((i, p) ~> (p.i0, argsTypes[i]));
            this.closure(subst, savedScope, args, retType, body)
          }),
        ]
      };
      TType::single(
        TFuns::singleFun(
          TFun(
            Array[],
            paramTypes.map(x -> x.i1).toArray(),
            Array[],
            None(),
            pos,
            lambdas,
            retType,
            CGNodes::singleton(callingContext),
          ),
          pos,
        ),
      )

    | As _ -> notSupported(pos)
    | Async _ -> typingError(Array[(pos, "TODO: async closures")])
    | Await(ae) ->
      aeType = this.expr(env, ae);
      aeType.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
        stypes.singleElt()
      ) match {
      | Some(TPromise(ty, _)) -> ty
      | _ ->
        typingError(
          Array[(pos, "Invalid await"), (aeType.pos, "This is not a promise")],
        )
      }
    | EIf(e1, e2, e3) ->
      cond = this.expr(env, e1);
      left = this.expr(env, e2);
      right = this.expr(env, e3);
      this.checkSubType(
        env,
        e1.pos,
        "Invalid ? condition",
        cond,
        TType::single(TPrimValue(TBool(), None(), e1.pos)),
      );
      TType::union(env.subst, this.tenv, left, right)
    | AsConst(subExpr) ->
      this.asConstExpr(subExpr) match {
      | Some(ty) -> ty
      | None() ->
        typingError(
          Array[(pos, "'as const' can only be used with string literals")],
        )
      }
    | KeyOf _ -> notSupported(pos)
    | Params _ ->
      internal_error("Internal error: Params should not be an expression")
    | Regexp _ -> typingError(Array[(pos, "TODO: regexp")])
    | Spread _ -> typingError(Array[(pos, "TODO: ...")])
    }
  }

  fun checkIsNumber(
    env: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): void {
    ty.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(TNum(), _, _)) -> void
    | _ -> typingError(Array[(pos, msg), (ty.pos, "This is not a number")])
    };
  }

  fun checkIsNumeric(
    env: mutable TCEnv,
    pos: PosRange,
    msg: String,
    ty: TType,
  ): TPrimValueKind {
    ty.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TPrimValue(kind @ TNum(), _, _))
    | Some(TPrimValue(kind @ TBigInt(), _, _)) ->
      kind
    | _ ->
      typingError(
        Array[
          (pos, msg),
          (ty.pos, "This is not a numeric type (number or bigint)"),
        ],
      )
    };
  }

  /* Typechecks expression e as const */
  fun asConstExpr(e: Expr): ?TType {
    pos = e.pos;
    e.value match {
    | AsConst(subExpr) ->
      typingError(Array[(subExpr.pos, "Unnecessary 'as const'")])
    | Var(Name(_, "null")) -> Some(TType::single(TPrimVoid(TNull(), pos)))
    | Var(Name(_, "undefined")) ->
      Some(TType::single(TPrimVoid(TUndefined(), pos)))
    | Number(n) ->
      Some(
        TType::single(
          TPrimValue(TNum(), Some(ArrayValues::single((pos, n))), pos),
        ),
      )
    | BigInt(n) ->
      Some(
        TType::single(
          TPrimValue(TBigInt(), Some(ArrayValues::single((pos, n))), pos),
        ),
      )
    | Var(Name(_, "true")) ->
      Some(
        TType::single(
          TPrimValue(TBool(), Some(ArrayValues::single((pos, "true"))), pos),
        ),
      )
    | Var(Name(_, "false")) ->
      Some(
        TType::single(
          TPrimValue(TBool(), Some(ArrayValues::single((pos, "false"))), pos),
        ),
      )
    | EString(n) ->
      Some(
        TType::single(
          TPrimValue(TString(), Some(ArrayValues::single((pos, n))), pos),
        ),
      )
    | _ -> None()
    }
  }

  fun closure(
    subst: mutable Subst,
    scope: Scope,
    params: Array<(Name, TType)>,
    retType: TType,
    body: ClosureBody,
  ): void {
    env = mutable TCEnv(subst.context, subst, Scope::fromSaved(scope));
    for (param in params) {
      env.scope.bind(param.i0, param.i1, true)
    };
    body match {
    | CBExpr(e) ->
      this.checkSubType(
        env,
        e.pos,
        "Invalid callback return",
        this.expr(env, e),
        retType,
      )
    | CBBlock(bl) ->
      !this.retType = Some(retType);
      _ = this.block(env, bl)
    }
  }

  fun callConstructor(
    env: mutable TCEnv,
    pos: PosRange,
    cstrType: CstrType,
    args: Array<TType>,
  ): void {
    cstrType.cstr match {
    | None() ->
      if (args.size() == 0) return void;
      typingError(Array[(pos, "Invalid new: constructor expects no arguments")])
    | Some(cstr) -> _ = this.call(env, pos, cstr, Array[], args)
    }
  }

  fun assign(env: mutable TCEnv, pos: PosRange, e1: Expr, e2: Expr): TType {
    this.checkLValue(e1);
    e1.value match {
    | Var(n) ->
      ty2 = this.expr(env, e2);
      env.scope.set(n, ty2, (x, y) ->
        this.checkSubType(env, pos, "Invalid assignment", x, y)
      );
      ty2
    | Binop(
      BODot(),
      Expr(_, Var(local)),
      Expr(_, Var(fieldName)),
    ) if (env.localObjects.containsKey(local.value)) ->
      fieldType = this.expr(env, e2);
      env.localObjects[local.value] match {
      | None() -> void
      | Some(objectType) ->
        this.checkSubType(
          env,
          e2.pos,
          "Invalid assignment",
          fieldType,
          this.dot(env, e1.pos, objectType, fieldName),
        )
      };
      this.assignLocalObject(env, pos, local, fieldName, fieldType)
    | _ ->
      ty1 = this.expr(env, e1);
      ty2 = this.expr(env, e2);
      this.checkSubType(env, e2.pos, "Invalid assignment", ty2, ty1);
      ty1
    }
  }

  fun assignLocalObject(
    env: mutable TCEnv,
    pos: PosRange,
    local: Name,
    fieldName: Name,
    fieldType: TType,
  ): TType {
    objField = env.scope
      .get(local)
      .getSTypes(env.subst, this.tenv, Covariant())
      .flatMap(stypes ~> stypes.singleElt()) match {
    | Some(TObject(fields, objPos)) ->
      fields.maybeGet(fieldName.value) match {
      | None() ->
        env.usedObjects.maybeGet(local.value) match {
        | None() -> void
        | Some(usedPos) ->
          typingError(
            Array[
              (pos, "You are trying to add a field to this object"),
              (
                usedPos,
                "But this object has been already been used for something else",
              ),
            ],
          )
        };
        if (env.scope.isThroughLoop(local)) {
          typingError(
            Array[(local.pos, "You cannot add a field to an object in a loop")],
          )
        };
        field = TField::create(
          fieldType.pos,
          fieldName.value,
          false,
          fieldType,
        ) match {
        | None() -> internal_error("TODO: converting an object to an algebraic")
        | Some(f) -> f
        };
        env.scope.set(
          local,
          TType::single(
            TObject(
              interTFields(
                env.subst,
                this.tenv,
                fields,
                TFields::create(Array[field]),
              ),
              objPos,
            ),
          ),
          (x, y) -> {
            this.checkSubType(env, fieldType.pos, "Invalid assignment", x, y)
          },
        );
        fieldType
      | Some(fd) -> fd.type
      }
    | _ -> internal_error("Internal error: local object is not an object")
    };
    this.checkSubType(
      env,
      fieldType.pos,
      "Invalid assignment",
      fieldType,
      objField,
    );
    fieldType
  }

  fun getArrayEltType(env: mutable TCEnv, object: TObject): TType {
    object.fields.maybeGet("pop") match {
    | None() -> typingError(Array[(object.pos, "Expected an Array type")])
    | Some(popMethod) ->
      popF = popMethod.type
        .getSTypes(env.subst, this.tenv, Covariant())
        .flatMap(stypes ~> stypes.singleElt())
        .fromSome() match {
      | TFuns(_, methods, _) ->
        for (met in methods) {
          break met
        } else {
          internal_error("Unexpected type for Array::pop")
        }
      | _ -> internal_error("Unexpected pop method type for")
      };
      popF.retType
    };
  }

  fun call(
    env: mutable TCEnv,
    pos: PosRange,
    fty: TType,
    targs: Array<TType>,
    args: Array<TType>,
  ): TType {
    result: ?TType = None();
    fty.getSTypes(env.subst, this.tenv, Covariant()).flatMap(stypes ~>
      stypes.singleElt()
    ) match {
    | Some(TFuns(funs, methods, _)) ->
      for (tfun in funs.values().concat(methods.values())) {
        this.callgraph.recordCalls(
          env.context,
          env.scope.callingContext,
          tfun.cgNodes,
        );
        if (targs.size() != 0 && targs.size() != tfun.clauses.size()) {
          typingError(
            Array[
              (
                pos,
                "Incompatible number of type arguments: " +
                  targs.size() +
                  " passed",
              ),
              (fty.pos, "Expected: " + tfun.clauses.size()),
            ],
          )
        };
        map = SortedMap[];
        for (i => tparamDecl in tfun.clauses) {
          !map[tparamDecl.id] = if (targs.isEmpty()) {
            this.newTVar(env, pos)
          } else {
            targs[i]
          };
        };
        !tfun = (mutable Instantiate()).fun_(
          (env.subst, this.tenv, map.chill()),
          tfun with {clauses => Array[]},
        );
        version = env.subst.version;
        loop {
          for (i in Range(0, tfun.params.size())) {
            if (i >= args.size()) {
              typingError(
                Array[
                  (pos, "Invalid call"),
                  (
                    fty.pos,
                    "This function has " + tfun.params.size() + " parameters",
                  ),
                ],
              )
            };
            this.checkSubType(env, pos, "Invalid call", args[i], tfun.params[i])
          };
          for (j in Range(0, tfun.optionalParams.size())) {
            i = tfun.params.size() + j;
            if (i >= args.size()) break void;
            this.checkSubType(
              env,
              pos,
              "Invalid call",
              args[i],
              tfun.optionalParams[j],
            )
          };
          if (env.subst.version == version) break void;
          !version = env.subst.version;
        };
        totalSize = tfun.params.size() + tfun.optionalParams.size();
        if (totalSize < args.size()) {
          tfun.spreadParam match {
          | None() ->
            typingError(
              Array[
                (pos, "Too many arguments"),
                (tfun.minSizeWitness, "For this function"),
              ],
            )
          | Some(spreadType) ->
            spreadType
              .getSTypes(env.subst, this.tenv, Contravariant())
              .flatMap(stypes ~> stypes.singleElt()) match {
            | Some(object @ TObject _) ->
              eltType = this.getArrayEltType(env, object);
              for (i in Range(totalSize, args.size())) {
                this.checkSubType(
                  env,
                  pos,
                  "Invalid argument",
                  args[i],
                  eltType,
                );
              }
            | _ ->
              typingError(
                Array[
                  (pos, "Invalid call. Unexpected type for ..."),
                  (spreadType.pos, `${spreadType} is not an array`),
                ],
              )
            }
          }
        };
        for (lambda in tfun.lambdas) {
          if (tfun.optionalParams.size() != 0) {
            internal_error("tfun.optionalParams should be empty")
          };
          lambda.compute(env.subst, args, tfun.retType)
        };
        !result = result match {
        | None() -> Some(tfun.retType)
        | Some(r) -> Some(TType::union(env.subst, this.tenv, r, tfun.retType))
        };
      }
    | _ -> void
    };
    result match {
    | None() ->
      typingError(
        Array[
          (pos, "Invalid call"),
          (fty.pos, `Type ${fty} is not a function`),
        ],
      )
    | Some(x) -> x
    }
  }

  fun makeBoundTVar(env: mutable TCEnv, ty: TType): TType {
    tvar = env.subst.gen(ty.pos);
    env.subst.grow(this.tenv, tvar, ty, true);
    TType::var(tvar)
  }

  fun newTVar(env: mutable TCEnv, pos: PosRange): TType {
    tvar = env.subst.gen(pos);
    TType::var(tvar)
  }

  fun checkLValue(e: Expr): void {
    e.value match {
    | Var(Name(_, "super")) -> typingError(Array[(e.pos, "Invalid lvalue")])
    | Var _ -> void
    | Get _ -> void
    | EArray _ -> void
    | Binop(BODot(), e1, Expr(_, Var(_))) -> this.checkLValue(e1)
    | _ -> typingError(Array[(e.pos, "Invalid lvalue")])
    }
  }

  fun evalEquality(env: mutable TCEnv, e1: Expr, e2: Expr, target: Bool): void {
    (e1, e2) match {
    | (
      Expr(_, EString(tag)),
      Expr(
        _,
        Binop(BODot(), Expr(_, Var(local)), Expr(_, Var(Name(_, fieldName)))),
      ),
    )
    | (
      Expr(
        _,
        Binop(BODot(), Expr(_, Var(local)), Expr(_, Var(Name(_, fieldName)))),
      ),
      Expr(_, EString(tag)),
    ) if (fieldName == kAlgebraicBranchFieldName) ->
      this.evalAlgebraicBranchEquality(env, local, tag, target)

    | (Expr(_, TypeOf(Expr(_, Var(local)))), Expr(typePos, EString(typeStr)))
    | (Expr(typePos, EString(typeStr)), Expr(_, TypeOf(Expr(_, Var(local))))) ->
      this.evalTypeofEquality(env, local, typeStr, typePos, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "null"))))
    | (Expr(_, Var(Name(_, "null"))), Expr(_, Var(local))) ->
      this.evalNullEquality(env, local, target)

    | (Expr(_, Var(local)), Expr(_, Var(Name(_, "undefined"))))
    | (Expr(_, Var(Name(_, "undefined"))), Expr(_, Var(local))) ->
      this.evalUndefinedEquality(env, local, target)

    | (Expr(pos, _), Expr(_, Var(Name(_, "null"))))
    | (Expr(_, Var(Name(_, "null"))), Expr(pos, _))
    | (Expr(pos, _), Expr(_, Var(Name(_, "undefined"))))
    | (Expr(_, Var(Name(_, "undefined"))), Expr(pos, _)) ->
      typingError(
        Array[(pos, "Only locals can be compared to null/undefined.")],
      )

    | _ -> void
    }
  }

  fun evalAlgebraicBranchEquality(
    env: mutable TCEnv,
    local: Name,
    tag: String,
    target: Bool,
  ): void {
    if (target) {
      // Positive branch: narrow to only the matching tag
      this.setLocal(
        env,
        local,
        None(),
        _ ~> true,
        stype ~>
          stype match {
          | TAlgebraic(branches, aPos) ->
            TAlgebraic(branches.filter(branch -> branch.tag == tag), aPos)
          | x -> x
          }
        ,
      )
    } else {
      // Negative branch: eliminate the matching tag (refinement by elimination)
      this.setLocal(
        env,
        local,
        None(),
        _ ~> true,
        stype ~>
          stype match {
          | TAlgebraic(branches, aPos) ->
            TAlgebraic(branches.filter(branch -> branch.tag != tag), aPos)
          | x -> x
          }
        ,
      )
    }
  }

  fun evalTypeofEquality(
    env: mutable TCEnv,
    local: Name,
    typeStr: String,
    typePos: PosRange,
    target: Bool,
  ): void {
    typeStr match {
    | "symbol" -> void
    | "string" ->
      (filter, default) = (
        x ~> (x is TPrimValue(TString(), _, _)),
        Some(TPrimValue(TString(), None(), typePos)),
      );
      this.setLocal(
        env,
        local,
        if (target) default else None(),
        if (target) filter else x ~> !filter(x),
      )
    | "number" ->
      (filter, default) = (
        x ~> x is TPrimValue(TNum(), _, _),
        Some(TPrimValue(TNum(), None(), typePos)),
      );
      this.setLocal(
        env,
        local,
        if (target) default else None(),
        if (target) filter else x ~> !filter(x),
      )
    | "bigint" ->
      (filter, default) = (
        x ~> x is TPrimValue(TBigInt(), _, _),
        Some(TPrimValue(TBigInt(), None(), typePos)),
      );
      this.setLocal(
        env,
        local,
        if (target) default else None(),
        if (target) filter else x ~> !filter(x),
      )
    | "boolean" ->
      (filter, default) = (
        x ~> x is TPrimValue(TBool(), _, _),
        Some(TPrimValue(TBool(), None(), typePos)),
      );
      this.setLocal(
        env,
        local,
        if (target) default else None(),
        if (target) filter else x ~> !filter(x),
      )
    | "undefined" ->
      filter = x ~>
        x is TPrimVoid(TUndefined(), _) || x is TPrimVoid(TVoid(), _);
      this.setLocal(
        env,
        local,
        if (target) None() else None(),
        if (target) filter else x ~> !filter(x),
      )
    | "object" ->
      (filter, default) = (
        x ~> x is TObject _ || x is TAlgebraic _ || x is TPrimVoid(TNull(), _),
        Some(TObject(TFields::empty(), typePos)),
      );
      this.setLocal(
        env,
        local,
        if (target) default else None(),
        if (target) filter else x ~> !filter(x),
      )
    | "function" ->
      filter = x ~> x is TFuns _;
      this.setLocal(
        env,
        local,
        if (target) None() else None(),
        if (target) filter else x ~> !filter(x),
      )
    | _ -> void
    }
  }

  fun evalNullEquality(env: mutable TCEnv, local: Name, target: Bool): void {
    if (!target) {
      this.setLocal(env, local, None(), x ~> !(x is TPrimVoid(TNull(), _)))
    }
  }

  fun evalUndefinedEquality(
    env: mutable TCEnv,
    local: Name,
    target: Bool,
  ): void {
    if (!target) {
      this.setLocal(env, local, None(), x ~>
        !(x is TPrimVoid(TUndefined(), _) || x is TPrimVoid(TVoid(), _))
      )
    }
  }

  fun evalCond(env: mutable TCEnv, e: Expr, target: Bool): void {
    e.value match {
    | Binop(BOStrictEquality(), e1, e2) ->
      this.evalEquality(env, e1, e2, target)

    | Binop(BOStrictInequality(), e1, e2) ->
      this.evalEquality(env, e1, e2, !target)

    | InstanceOf(
      Expr(_, Var(local)),
      Expr(_, Var(Name(posArray, "Array"))),
    ) if (target) ->
      env.scope.set(
        local,
        TType::inst(
          Name(posArray, "Array"),
          TArgs(Array[TType::top(posArray)]),
        ),
        (_, _) -> void,
      )

    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->
      env.scope.set(
        local,
        this.tenv.new(
          env.context,
          className,
          this.tenv.makeTArgs(env.context, env.subst, className),
        ),
        (x, y) -> this.checkSubType(env, e.pos, "Invalid instanceof", x, y),
      )

    | Binop(BOLogicalAnd(), e1, e2) if (target) ->
      this.evalCond(env, e1, true);
      this.evalCond(env, e2, true)

    | Binop(BOLogicalOr(), e1, e2) if (!target) ->
      this.evalCond(env, e1, false);
      this.evalCond(env, e2, false)

    | _ -> void
    }
  }

  fun setLocal(
    env: mutable TCEnv,
    local: Name,
    default: ?SType,
    filter: SType ~> Bool,
    map: SType ~> SType = x ~> x,
  ): void {
    ty = env.scope.get(local);
    clauses = ty.expand(env.subst, this.tenv, Covariant());
    !ty = TType::fromClauses(ty.pos, clauses);
    !ty = (mutable FilterType()).type((filter, map), ty);
    isTopOrEmpty = ty.getSTypes(env.subst, this.tenv, Covariant()) match {
    | None() -> true
    | Some(stypes) -> stypes.isEmpty()
    };
    localType = default match {
    | Some(d) if (isTopOrEmpty) -> TType::single(d)
    | _ -> ty
    };
    env.scope.set(local, localType, (_, _) -> void)
  }
}

/***************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/***************************************************************************/

fun isTerminalBlock(inTry: Bool, bl: Array<Stmt>): Bool {
  term = StmtTermination::block(bl);
  !term.mayFallthrough && (term.mayReturn || (!inTry && term.mayThrow))
}

module end;
