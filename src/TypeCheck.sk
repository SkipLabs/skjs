/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

class TypeChecker{
  errorHandling: ErrorHandling,
  super: ?(CstrType, TType) = None(),
  isAsync: Bool = false,
  retType: ?TType = None(),
  // The class whose body is currently being type-checked, identified by
  // its declaration Name (whose pos also identifies the declaring file).
  // Set once at the top of class_ and inherited through funDefSetup into
  // method bodies and constructors. Used at field-access sites to enforce
  // private visibility. None() outside of any class body.
  enclosingClass: ?Name = None(),
  // The truthiness mode (CLI `--truthiness` / tsconfig `truthiness`). Decides
  // which condition diagnostics are emitted; checking always continues with
  // JavaScript value semantics. Read in checkCondition (TypeCheckUtils.sk),
  // the `&&`/`||`/`!`/ternary sites (TypeCheckExpr.sk), and narrowing
  // (TypeCheckRefine.sk). See issue #654.
  truthiness: Truthiness = Truthiness::default,
} extends TEnv {
  // Apply the run's tracked config (see Config.sk). Persisted-dir closures
  // capture a TypeChecker from init time; they must call this with a fresh
  // getConfig read so config changes reach --data runs.
  fun withConfig(config: CheckerConfig): this {
    this with {
      errorHandling => config.errorHandling,
      truthiness => config.compilerOptions.truthiness,
      verbose => config.verbose,
      emitCfg => config.emitCfg,
    }
  }
}

/***************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/***************************************************************************/

fun isTerminalBlock(tcenvb: mutable TCEnvBase, bl: Array<Stmt>): Bool {
  StmtTermination::block(tcenvb, bl).isTerminal()
}

module end;
