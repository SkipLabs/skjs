/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

class TypeChecker{
  builtins: Set<String>,
  builtinsFileName: FileName,
  backtrace: Bool,
  defMap: DefMap,
  tenv: TEnv,
  callgraph: CallGraph,
  super: ?(CstrType, TType) = None(),
  isAsync: Bool = false,
  retType: ?TType = None(),
} {}

/***************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/***************************************************************************/

fun isTerminalBlock(bl: Array<Stmt>): Bool {
  term = StmtTermination::block(bl);
  !term.mayFallthrough && (term.mayReturn || term.mayThrow)
}

module end;
