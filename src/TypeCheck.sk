/***************************************************************************/
/* Type-checker for SKJS */
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Type-checker */
/***************************************************************************/

class TypeChecker{
  backtrace: Bool,
  defMap: DefMap,
  tenv: TEnv,
  super: ?(CstrType, TType) = None(),
  isAsync: Bool = false,
  retType: ?TType = None(),
  keepGoing: Bool,
} {}

/***************************************************************************/
/* Returns true if a statement always is "terminal", meaning if
/* evaluating this statements terminates the function. */
/***************************************************************************/

fun isTerminalBlock(bl: Array<Stmt>): Bool {
  StmtTermination::block(bl).isTerminal()
}

module end;
