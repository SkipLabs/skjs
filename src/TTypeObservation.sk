/***************************************************************************/
/* Candidate reads used to materialize a type's shape. */
/***************************************************************************/

module SKJS;

// A snapshot is data, not evidence that a type judgment is valid. In particular,
// this view is for diagnostics and read-only traversals; acceptance-relevant
// shape inspection must use a committed read boundary instead.
class SubstSnapshot private (bindings: SortedMap<TVarID, SubstValue>) {
  static fun create(bindings: SortedMap<TVarID, SubstValue>): SubstSnapshot {
    SubstSnapshot(bindings)
  }

  fun peekRaw(tv: TVar): ?TType {
    this.bindings.maybeGet(tv.identity()) match {
    | None() -> None()
    | Some(SVOpen(ty))
    | Some(SVClosed(ty)) ->
      Some(ty)
    }
  }

  fun isClosed(tv: TVar): Bool {
    this.bindings.maybeGet(tv.identity()) is Some(SVClosed _)
  }
}

// This is an internal inability to establish a stable read, not a source type
// error. Only the observation boundary catches it; other exceptions propagate.
class SubstObservationBlocked() extends Exception

// Not finding an optional shape and failing to justify inspecting it are
// different outcomes. In particular, Blocked must not silently choose a more
// permissive array-rest fallback at the caller.
base class TypeReadResult<T> {
  children =
  | TRReady(T)
  | TRUnavailable()
  | TRBlocked()
}

// Holds a read's payload so the observation boundary can catch Blocked around
// a void-typed try. The payload never crosses the exception handler.
mutable class SubstReadCell<T>{mutable value: ?T} {
  static fun mcreate(): mutable SubstReadCell<T> {
    mutable SubstReadCell{value => None()}
  }
}

// One frame is shared by an observation and every scratch descendant. It is
// deliberately NOT part of SavedSubst: catching an exception or restoring a
// speculative alternative cannot erase a dependency already inspected.
mutable class SubstReadObservation private {
  snapshot: SubstSnapshot,
  private mutable reads: SortedMap<TVarID, TType> = SortedMap[],
  private mutable blocked: Bool = false,
} {
  static fun mcreate(snapshot: SubstSnapshot): mutable SubstReadObservation {
    mutable SubstReadObservation{snapshot}
  }

  mutable fun markBlocked(): void {
    this.!blocked = true
  }

  mutable fun block(): void {
    this.markBlocked();
    throw SubstObservationBlocked()
  }

  mutable fun record(tv: TVar, value: ?SubstValue): void {
    if (this.blocked) {
      throw SubstObservationBlocked()
    } else {
      value match {
      // Absence cannot license a materialized shape: neither an inference
      // lower bound of never nor an array literal's default is a fixed choice.
      | None() -> this.block()
      | Some(SVOpen(ty))
      | Some(SVClosed(ty)) ->
        if (this.snapshot.peekRaw(tv) != Some(ty)) {
          this.block()
        } else {
          this.!reads[tv.identity()] = ty
        }
      }
    }
  }

  readonly fun isBlocked(): Bool {
    this.blocked
  }

  readonly fun bindings(): SortedMap<TVarID, TType> {
    this.reads
  }
}

// Shared by record copies of a capability. Copying a context must not copy
// the expiration flag into an independently live handle.
mutable class TypeReadLifetime private {private mutable active: Bool = true} {
  static fun mcreate(): mutable TypeReadLifetime {
    mutable TypeReadLifetime{}
  }

  mutable fun expire(): void {
    this.!active = false
  }

  readonly fun checkActive(): void {
    invariant(this.active, "A type-read context cannot outlive its callback")
  }
}

// Declaration evaluation can look up syntax and report diagnostics, but has no
// candidate owner. Nested normalization borrows the same observation and read
// frame. Compatibility checks return no inference result.
mutable class TypeReadDeclaration private {
  private reader: mutable TypeReadContext,
} extends TCEnvBase {
  mutable fun readIn<T>(tenv: TEnv, read: (mutable TypeReadContext) -> T): T {
    this.reader.readIn(tenv, read)
  }

  mutable fun checkCompatibility(
    tenv: TEnv,
    pos: PosRange,
    argument: TType,
    constraint: TType,
    constraintPos: PosRange,
  ): void {
    this.reader.checkDeclarationCompatibility(
      tenv,
      pos,
      argument,
      constraint,
      constraintPos,
    )
  }

  mutable fun describe(tenv: TEnv, type: TType): String {
    this.reader.describeDeclaration(tenv, type)
  }

  static fun mcreate(
    context: mutable SKStore.Context,
    results: mutable TCResultsAcc,
    reader: mutable TypeReadContext,
  ): mutable TypeReadDeclaration {
    mutable TypeReadDeclaration{context, results, reader}
  }
}

// Restricted validation capability. Consumers cannot allocate, grow, seal,
// select a representation, clone solver state, or obtain a mutable owner.
// Head traversal, type algebra and declaration normalization use fixed reads.
mutable class TypeReadContext private {
  private scratch: mutable Subst,
  private tenv: TEnv,
  private lifetime: mutable TypeReadLifetime,
} {
  // Only the observation transaction may supply scratch. Always expire the
  // capability, including on exceptions: retaining a handle cannot extend the
  // transaction's read set after its commitments have already been published.
  static fun runObserved<T>(
    scratch: mutable Subst,
    tenv: TEnv,
    read: (mutable TypeReadContext) -> T,
  ): T {
    invariant(scratch.isObservingTypeReads());
    lifetime = TypeReadLifetime::mcreate();
    context = mutable TypeReadContext{scratch, tenv, lifetime};
    result = SubstReadCell::mcreate();
    try {
      result.!value = Some(read(context))
    } catch {
    | exn ->
      lifetime.expire();
      throw exn
    };
    lifetime.expire();
    result.value.fromSome()
  }

  // Preserve lifetime, snapshot, query state and recursive premises while
  // declaration syntax changes the lexical bindings in the environment.
  mutable fun readIn<T>(tenv: TEnv, read: (mutable TypeReadContext) -> T): T {
    this.lifetime.checkActive();
    read(this with {tenv})
  }

  private mutable fun declaration(): mutable TypeReadDeclaration {
    this.lifetime.checkActive();
    TypeReadDeclaration::mcreate(
      this.scratch.context,
      this.scratch.results,
      this,
    )
  }

  mutable fun checkDeclarationCompatibility(
    tenv: TEnv,
    pos: PosRange,
    argument: TType,
    constraint: TType,
    constraintPos: PosRange,
  ): void {
    this.lifetime.checkActive();
    this.scratch.withTypeArgumentProbe(probe ->
      TypeArgumentCheck::checkConstraint(
        probe,
        this.scratch,
        tenv,
        pos,
        argument,
        constraint,
        constraintPos,
      )
    )
  }

  mutable fun describeDeclaration(tenv: TEnv, type: TType): String {
    this.lifetime.checkActive();
    prettyPrintType(false, type, this.scratch.cloneForTypeDiagnostics(), tenv)
  }

  mutable fun instantiate(name: Name, targs: TArgs): TType {
    this.tenv.instantiateDeclaration(this.declaration(), name, targs)
  }

  mutable fun classStatics(name: Name): TType {
    this.tenv.newStatic(this.declaration(), name)
  }

  private mutable fun expandNamed(name: Name, targs: TArgs): TType {
    declaration = this.declaration();
    identity = this.tenv.typeDefinitionIdentity(declaration, name);
    if (this.tenv.seenInstantiate.contains(identity)) {
      TType::inst(name, targs)
    } else {
      key = ExpansionKey(identity, targs);
      this.scratch.seenExpansion.maybeGet(key) match {
      | Some(expanded) -> expanded
      | None() ->
        expanded = this.tenv.instantiateDeclaration(declaration, name, targs);
        if (expanded != TType::inst(name, targs)) {
          this.scratch.!seenExpansion[key] = expanded
        };
        expanded
      }
    }
  }

  mutable fun peekRaw(tv: TVar): ?TType {
    this.lifetime.checkActive();
    this.scratch.peekRaw(tv)
  }

  mutable fun expand(type: TType, variance: ?Variance): TType {
    this.lifetime.checkActive();
    type.expandWith(inst -> this.expandInstance(inst, variance))
  }

  // Candidate expansion is a tracked fixed-payload read, independent of
  // variance. It cannot invoke inference's covariant sealing/default rules.
  // Occurrence constraints use the same fixed-read intersection backend.
  private mutable fun expandInstance(inst: TInst, variance: ?Variance): ?TType {
    inst match {
    | TSInst(name, targs) -> Some(this.expandNamed(name, targs))
    | TInter(tys) ->
      context = this with {tenv => this.tenv with {expandInter => true}};
      types = tys.values();
      first = types.next().fromSome();
      Some(
        types.reduce((left, right) -> context.intersection(left, right), first),
      )
    | tv @ TVar _ ->
      variance.map(_ -> {
        value = this.peekRaw(tv).fromSome();
        for (constraint in tv.constraints) {
          !value = this.intersection(value, constraint)
        };
        value
      })
    | arrLit @ TArrayLit _ -> Some(arrLit.selector.read(this))
    }
  }

  private mutable fun expandClauses(type: TType, variance: Variance): Clauses {
    type.expandGraph(inst -> this.expandInstance(inst, Some(variance))) match {
    | None() -> Clauses::top()
    | Some((_, clauses)) -> Clauses::unionN(clauses)
    }
  }

  mutable fun concreteTypes(type: TType, variance: Variance): ?STypes {
    this.lifetime.checkActive();
    this.expandClauses(type, variance).getSTypes()
  }

  mutable fun expandVectors(
    type: TType,
    variance: ?Variance,
  ): ?(mutable Vector<TInst>, mutable Vector<Clause>) {
    this.lifetime.checkActive();
    type.expandGraph(inst -> this.expandInstance(inst, variance))
  }

  mutable fun removeConstant(type: TType, constant: TPrim): TType {
    TType::removeConstantFromExpanded(
      type.pos,
      this.expand(type, None()),
      constant,
    )
  }

  mutable fun truthinessPart(type: TType, target: Bool): TType {
    this.lifetime.checkActive();
    type.mapSTypesWith(
      inst -> this.expandInstance(inst, Some(Covariant())),
      stypes ->
        stypes.map(types ->
          types.filterMap(stype -> stype.truthinessResidue(target))
        )
      ,
    )
  }

  mutable fun constrainedParameter(
    pos: PosRange,
    parameter: TParamWithConstraint,
  ): TType {
    this.lifetime.checkActive();
    TType::fromTParamWithConstraintWith(pos, parameter, (left, right) ->
      this.retainedIntersection(left, right)
    )
  }

  mutable fun mergeIndexKind(indexes: readonly Vector<TField>): ?TField {
    this.lifetime.checkActive();
    TypeReadContext::runObserved(this.scratch.clone(), this.tenv, context ->
      TIndexes::mergeKindWith(indexes, (left, right) ->
        TField::interContracts(
          left,
          right,
          context.retainedIntersection(left.get, right.get),
          TType::unionStructural(left.set, right.set),
        )
      )
    )
  }

  // Projection assembly is structural; primitive boxing borrows this same
  // declaration observation instead of creating an inference environment.
  mutable fun keyOf(type: TType, pos: PosRange): TType {
    this.lifetime.checkActive();
    this.tenv.keyOfFromClauses(
      this.expandClauses(type, Covariant()),
      pos,
      name -> this.tenv.newObject(this.declaration(), name, Array[]),
    )
  }

  mutable fun numberIndexed(type: TType, pos: PosRange): TType {
    this.lifetime.checkActive();
    this.tenv.numberIndexedFromClauses(
      this.expandClauses(type, Covariant()),
      pos,
      name -> this.tenv.newObject(this.declaration(), name, Array[]),
    )
  }

  mutable fun closedObject(pos: PosRange, type: TType): TType {
    this.lifetime.checkActive();
    this.tenv.closedObjectFrom(
      pos,
      type,
      this.expand(type, Some(Covariant())),
      (messages, code) -> this.scratch.error(messages, code),
    )
  }

  mutable fun typeOfProperty(base: TType, name: Name, pos: PosRange): TType {
    this.lifetime.checkActive();
    TEnv::typeOfPropertyWith(
      name,
      this.concreteTypes(base, Covariant()),
      obj ->
        this.readMember(obj, pos, fields -> fields.maybeGet(name.value)) match {
        | Some(type) -> type
        | None() -> obj.getTypeTypingError(name.value, pos)
        },
      type ->
        TEnv::extractedMethodTypeWith(type, map ->
          type.mapSTypesWith(inst -> this.expandInstance(inst, None()), map)
        ),
      () ->
        quoteRenderedType(
          prettyPrintType(
            false,
            base,
            this.scratch.cloneForTypeDiagnostics(),
            this.tenv,
          ),
        )
      ,
    )
  }

  // Resolve the declaration's carrier, then use fixed-read property and type
  // projection. Carrier declaration evaluation borrows this observation.
  private mutable fun symbolId(pos: PosRange, property: String): ?String {
    carrier = this.tenv.typeOfExpr(
      this.declaration(),
      Expr(pos, Var(Name(pos, "Symbol"))),
    );
    symbolType = this.typeOfProperty(carrier, Name(pos, property), pos);
    this.concreteTypes(symbolType, Covariant()).flatMap(types ~>
      types.singleElt()
    ) match {
    | Some(TPrimValue(TSymbol(), Some(literals), _)) ->
      literals.singleElt().map(literal -> literal.val)
    | _ -> None()
    }
  }

  // The relation uses fixed payloads and structural rules. It never proposes a
  // solution, selects a literal representation or records inference edges.
  mutable fun isSubtype(source: TType, target: TType): Bool {
    this.subtype(source, target) is STOk()
  }

  private mutable fun subtype(u1: TType, u2: TType): STResult<TType> {
    this.lifetime.checkActive();
    if (u1 == u2) return STOk();
    pair = (u1, u2);
    if (this.scratch.seenSub.contains(pair)) return STOk();
    if (u2.isTop()) {
      this.scratch.!seenSub = this.scratch.seenSub.set(pair);
      return STOk()
    };
    this.scratch.withTypeQuery(() -> {
      stamp = this.scratch.typeQueryReadStamp();
      result = this.subtype_(u1, u2);
      if (result is STOk() && this.scratch.canCacheTypeQuerySince(stamp)) {
        this.scratch.!seenSub = this.scratch.seenSub.set(pair)
      };
      (result, result is STOk())
    })
  }

  private mutable fun subtype_(u1: TType, u2: TType): STResult<TType> {
    tenv = this.tenv;
    if (tenv.seenSub.contains((this.scratch.inferenceVersion(), u1, u2))) {
      this.scratch.recordRecursiveTypeQuery(
        TQSubtype(this.scratch.inferenceVersion(), u1, u2),
      );
      return STOk()
    };
    // Two recursive aliases whose type arguments grow at each level never
    // repeat a `seenSub` entry, so their descent is bounded by how many times
    // it revisits the same pair of constructors (issue #997). Past the bound
    // the recursion is refused as excessively deep, rather than assumed related,
    // which would let an unsound program through. A finite nesting reaches any
    // given pair only a few times, so it is untouched.
    (u1.getSingleInst(), u2.getSingleInst()) match {
    | (Some(inst1), Some(inst2)) ->
      namedPair = (
        this.scratch.inferenceVersion(),
        tenv.expansionCacheKey(this.scratch, inst1.name, inst1.targs),
        tenv.expansionCacheKey(this.scratch, inst2.name, inst2.targs),
      );
      if (tenv.seenNamedSub.contains(namedPair)) {
        this.scratch.recordRecursiveTypeQuery(
          TQNamedSubtype(namedPair.i0, namedPair.i1, namedPair.i2),
        );
        return STOk()
      };
      !tenv.seenNamedSub = tenv.seenNamedSub.set(namedPair);
      this.scratch.introduceTypeQueryAssumption(
        TQNamedSubtype(namedPair.i0, namedPair.i1, namedPair.i2),
      );
      key = (inst1.name.value, inst2.name.value);
      count = tenv.subtypingHeadDepth.maybeGet(key).default(0);
      if (count >= kMaxSubtypingHeadDepth) {
        fatalError(
          Array[
            (
              u1.pos,
              "Type instantiation is excessively deep and possibly infinite",
            ),
          ],
          TSCode(2589),
        )
      };
      !tenv.subtypingHeadDepth = tenv.subtypingHeadDepth.set(key, count + 1)
    | _ -> void
    };
    !tenv.seenSub = tenv.seenSub.set((this.scratch.inferenceVersion(), u1, u2));
    this.scratch.introduceTypeQueryAssumption(
      TQSubtype(this.scratch.inferenceVersion(), u1, u2),
    );

    // Shortcut: TInter(tys) <: u2 if u2 is one of the tys
    u1.getSingleInter() match {
    | Some(TInter(tys)) if (tys.containsElt(u2)) -> return STOk()
    | _ -> void
    };

    context = this with {tenv};
    left = context.expandClauses(u1, Covariant());
    right = context.expandClauses(u2, Contravariant());
    Clauses::isSubWith(left, right, (a, b) ->
      STypes::isSubWith(a, b, (x, y) ->
        TObject::isSubWith(x, y, (f, g) -> context.fieldsSubtype(f, g))
      )
    ) match {
    | STOk() -> STOk()
    | err @ STErrorOnClauses _ -> STRecType(err, u1, u2)
    }
  }

  private mutable fun fieldsSubtype(
    left: TFields,
    right: TFields,
  ): STResult<TFields> {
    TFields::isSubWith(
      left,
      right,
      (a, b) -> this.subtype(a, b),
      (a, b) ->
        this.functionSubtype(a.fun_, b.fun_) match {
        | STOk() -> STOk()
        | err @ STErrorOnTFun _ -> STRecTFuns(err, a, b)
        },
      (pos, name) -> this.symbolId(pos, name),
    )
  }

  private mutable fun functionSubtype(left: TFun, right: TFun): STResult<TFun> {
    TFun::isSubWith(
      left,
      right,
      (a, b) -> this.subtype(a, b),
      spread -> spread.flatMap(type -> this.spreadTuple(type)),
      (type, variance) -> this.restElement(type, variance),
    )
  }

  mutable fun intersection(left: TType, right: TType): TType {
    this.lifetime.checkActive();
    if (left == right) return left;
    pair = (left, right);
    hasVar = left.getSingleVar().isSome() || right.getSingleVar().isSome();
    if (!hasVar) {
      this.scratch.seenInter.maybeGet(pair) match {
      | Some(result) -> return result
      | None() -> void
      }
    };
    this.scratch.withTypeQuery(() -> {
      stamp = this.scratch.typeQueryReadStamp();
      result = this.intersection_(left, right);
      if (!hasVar && this.scratch.canCacheTypeQuerySince(stamp)) {
        this.scratch.seenInter.maybeGet(pair) match {
        | Some(cached) -> !result = cached
        | None() -> this.scratch.!seenInter[pair] = result
        }
      };
      (result, true)
    })
  }

  private mutable fun intersection_(left: TType, right: TType): TType {
    if (right.isTop() || left.isBottom()) return left;
    if (left.isTop() || right.isBottom()) return right;
    // Inspect bare candidates just as the legacy intersection did. Unknown
    // payloads block; field candidates retain their symbolic occurrence rule.
    for ((candidate, other) in Array[
      (left.getSingleVar(), right),
      (right.getSingleVar(), left),
    ]) {
      candidate match {
      | Some(tv) ->
        _ = this.peekRaw(tv);
        if (this.scratch.isOpen(tv) && tv.isForField()) {
          return TType::var(tv.setConstraint(other))
        }
      | None() -> void
      }
    };
    pair = (left, right);
    if (this.tenv.seenInter.contains(pair)) {
      this.scratch.recordRecursiveTypeQuery(TQIntersection(left, right));
      return TType::unexpandedInter(left, right)
    };
    tenv = this.tenv with {seenInter => this.tenv.seenInter.set(pair)};
    this.scratch.introduceTypeQueryAssumption(TQIntersection(left, right));
    context = this with {tenv};
    a = context.expandClauses(left, Covariant());
    b = context.expandClauses(right, Covariant());
    (a.primKind(), b.getObject()) match {
    | (Some(name), Some(obj)) ->
      if (
        context.isSubtype(TType::inst(name, TArgs(Array[])), TType::single(obj))
      ) return left
    | _ -> void
    };
    (b.primKind(), a.getObject()) match {
    | (Some(name), Some(obj)) ->
      if (
        context.isSubtype(TType::inst(name, TArgs(Array[])), TType::single(obj))
      ) return right
    | _ -> void
    };
    TType::ofClauses(
      left.pos,
      Clauses::interWith(a, b, (f, g) -> context.intersectFields(f, g)),
    )
  }

  private mutable fun retainedIntersection(left: TType, right: TType): TType {
    stamp = this.scratch.typeQueryReadStamp();
    result = this.intersection(left, right);
    if (this.scratch.canCacheTypeQuerySince(stamp)) result else {
      TType::unexpandedInter(left, right)
    }
  }

  private mutable fun intersectFields(left: TFields, right: TFields): ?TFields {
    TFields::interWith(
      left,
      right,
      (a, b) -> {
        get = if (this.tenv.expandInter) {
          this.retainedIntersection(a.get, b.get)
        } else {
          TType::unexpandedInter(a.get, b.get)
        };
        TField::interContracts(a, b, get, TType::unionStructural(a.set, b.set))
      },
      (a, b) ->
        TField::interContracts(
          a,
          b,
          this.retainedIntersection(a.get, b.get),
          TType::unionStructural(a.set, b.set),
        ),
      (a, b) ->
        TFun::interWith(a.fun_, b.fun_, (f, g) ->
          this.functionSubtype(f, g) is STOk()
        ).map(f -> TFuns::singleFun(f, a.pos))
      ,
    )
  }

  mutable fun restElement(type: TType, variance: Variance): ?TType {
    this.lifetime.checkActive();
    this.objectHead(type, variance).flatMap(obj ->
      this.iteratorElement(obj, obj.pos)
    )
  }

  private mutable fun objectHead(type: TType, variance: Variance): ?TObject {
    this.expandClauses(type, variance)
      .getSTypes()
      .flatMap(stypes -> stypes.singleElt())
      .flatMap(stype ->
        stype match {
        | obj @ TObject _ -> Some(obj)
        | TPrim _ -> None()
        }
      )
  }

  private mutable fun readMember(
    obj: TObject,
    pos: PosRange,
    lookup: (TFields) -> ?TField,
  ): ?TType {
    obj.projectBranches(
      pos,
      fields ->
        lookup(fields).map(field ->
          TFields::resolveFieldReadWith(field, pos, (type, position) ->
            TType::unionStructural(
              type,
              TType::single(TPrimUnit(TUndefined(), position)),
            )
          )
        ),
      (position, types) -> TType::unionStructuralN(position, types),
    )
  }

  private mutable fun iteratorElement(obj: TObject, pos: PosRange): ?TType {
    TType::iteratorElementWith(
      this.symbolId(pos, "iterator").flatMap(id ->
        this.readMember(obj, pos, fields -> fields.maybeGetSymbol(id))
      ),
      type -> this.objectHead(type, Covariant()),
      callable ->
        callable.projectBranches(
          callable.pos,
          fields -> fields.callReturnType(),
          (position, types) -> TType::unionStructuralN(position, types),
        ),
      (object, name) ->
        this.readMember(object, pos, fields -> fields.maybeGet(name))
      ,
    )
  }

  // Isolate normalization caches as before, but expose neither the scratch
  // clone nor its solver operations to the shape consumer. Descendants share
  // the observation frame, so every nested read contributes to publication.
  mutable fun singleTypes(type: TType): ?STypes {
    this.lifetime.checkActive();
    TypeReadContext::runObserved(this.scratch.clone(), this.tenv, probe ->
      probe.expandClauses(type, Covariant()).getSTypes()
    )
  }

  // Disjointness uses fixed-read normalization with isolated caches. Descendants
  // retain the observation frame, including reads made by failed comparisons.
  mutable fun disjoint(left: TType, right: TType): Bool {
    this.lifetime.checkActive();
    TypeReadContext::runObserved(this.scratch.clone(), this.tenv, context ->
      context.intersection(left, right).isBottom()
    )
  }

  private mutable fun tupleElements(clauses: Clauses): ?Array<TType> {
    clauses.getSingleTupleWith((pos, elements) ->
      TType::unionStructuralIterator(pos, elements)
    )
  }

  // A constrained type subtypes its raw binding. The fallback therefore may
  // supply a supertype tuple shape; reading it still records the dependency.
  mutable fun spreadTuple(type: TType): ?Array<TType> {
    this.lifetime.checkActive();
    clauses = this.expandClauses(type, Covariant());
    this.tupleElements(clauses) match {
    | Some(elements) -> Some(elements)
    | None() ->
      type.getSingleVar().flatMap(tv ->
        this.peekRaw(tv).flatMap(bound ->
          this.tupleElements(this.expandClauses(bound, Covariant()))
        )
      )
    }
  }
}

extension base class TEnv {
  // An observed operation must not inherit subtype/intersection assumptions
  // made while checking its caller. Its own recursive calls rebuild these
  // guards under the fixed observation snapshot. Lexical bindings, declaration
  // identities, bounds, and normalization modes are preserved.
  fun forTypeReadObservation(): this {
    this with {
      seenSub => SortedSet[],
      seenNamedSub => SortedSet[],
      seenInter => SortedSet[],
      subtypingHeadDepth => SortedMap[],
    }
  }
}

module end;
