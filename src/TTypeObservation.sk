/***************************************************************************/
/* Candidate reads used to materialize a type's shape. */
/***************************************************************************/

module SKJS;

// A snapshot is data, not evidence that a type judgment is valid. In particular,
// this view is for diagnostics and read-only traversals; acceptance-relevant
// shape inspection must use a committed read boundary instead.
class SubstSnapshot private (bindings: SortedMap<TVarID, SubstValue>) {
  static fun create(bindings: SortedMap<TVarID, SubstValue>): SubstSnapshot {
    SubstSnapshot(bindings)
  }

  fun peekRaw(tv: TVar): ?TType {
    this.bindings.maybeGet(tv.identity()) match {
    | None() -> None()
    | Some(SVOpen(ty))
    | Some(SVClosed(ty)) ->
      Some(ty)
    }
  }

  fun isClosed(tv: TVar): Bool {
    this.bindings.maybeGet(tv.identity()) is Some(SVClosed _)
  }
}

// This is an internal inability to establish a stable read, not a source type
// error. Only the observation boundary catches it; other exceptions propagate.
class SubstObservationBlocked() extends Exception

// Not finding an optional shape and failing to justify inspecting it are
// different outcomes. In particular, Blocked must not silently choose a more
// permissive array-rest fallback at the caller.
base class TypeReadResult<T> {
  children =
  | TRReady(T)
  | TRUnavailable()
  | TRBlocked()
}

// Holds a read's payload so the observation boundary can catch Blocked around
// a void-typed try. The payload never crosses the exception handler.
mutable class SubstReadCell<T>{mutable value: ?T} {
  static fun mcreate(): mutable SubstReadCell<T> {
    mutable SubstReadCell{value => None()}
  }
}

// One frame is shared by an observation and every scratch descendant. It is
// deliberately NOT part of SavedSubst: catching an exception or restoring a
// speculative alternative cannot erase a dependency already inspected.
mutable class SubstReadObservation private {
  snapshot: SubstSnapshot,
  private mutable reads: SortedMap<TVarID, TType> = SortedMap[],
  private mutable blocked: Bool = false,
} {
  static fun mcreate(snapshot: SubstSnapshot): mutable SubstReadObservation {
    mutable SubstReadObservation{snapshot}
  }

  mutable fun markBlocked(): void {
    this.!blocked = true
  }

  mutable fun block(): void {
    this.markBlocked();
    throw SubstObservationBlocked()
  }

  mutable fun record(tv: TVar, value: ?SubstValue): void {
    if (this.blocked) {
      throw SubstObservationBlocked()
    } else {
      value match {
      // Absence cannot license a materialized shape: neither an inference
      // lower bound of never nor an array literal's default is a fixed choice.
      | None() -> this.block()
      | Some(SVOpen(ty))
      | Some(SVClosed(ty)) ->
        if (this.snapshot.peekRaw(tv) != Some(ty)) {
          this.block()
        } else {
          this.!reads[tv.identity()] = ty
        }
      }
    }
  }

  readonly fun isBlocked(): Bool {
    this.blocked
  }

  readonly fun bindings(): SortedMap<TVarID, TType> {
    this.reads
  }
}

// Shared by record copies of a capability. Copying a context must not copy
// the expiration flag into an independently live handle.
mutable class TypeReadLifetime private {private mutable active: Bool = true} {
  static fun mcreate(): mutable TypeReadLifetime {
    mutable TypeReadLifetime{}
  }

  mutable fun expire(): void {
    this.!active = false
  }

  readonly fun checkActive(): void {
    invariant(this.active, "A type-read context cannot outlive its callback")
  }
}

// Restricted validation capability. Consumers cannot allocate, grow, seal,
// select a representation, clone solver state, or obtain a mutable owner.
// Head traversal uses fixed candidate reads. Normalization/projection behind
// those reads still uses the observed legacy kernel with dynamic guards.
mutable class TypeReadContext private {
  private scratch: mutable Subst,
  private tenv: TEnv,
  private lifetime: mutable TypeReadLifetime,
} {
  // Only the observation transaction may supply scratch. Always expire the
  // capability, including on exceptions: retaining a handle cannot extend the
  // transaction's read set after its commitments have already been published.
  static fun runObserved<T>(
    scratch: mutable Subst,
    tenv: TEnv,
    read: (mutable TypeReadContext) -> T,
  ): T {
    invariant(scratch.isObservingTypeReads());
    lifetime = TypeReadLifetime::mcreate();
    context = mutable TypeReadContext{scratch, tenv, lifetime};
    result = SubstReadCell::mcreate();
    try {
      result.!value = Some(read(context))
    } catch {
    | exn ->
      lifetime.expire();
      throw exn
    };
    lifetime.expire();
    result.value.fromSome()
  }

  mutable fun peekRaw(tv: TVar): ?TType {
    this.lifetime.checkActive();
    this.scratch.peekRaw(tv)
  }

  mutable fun expand(type: TType, variance: ?Variance): TType {
    this.lifetime.checkActive();
    type.expandWith(
      inst -> this.expandInstance(inst, variance),
      clauses -> Clauses::unionN(this.scratch, this.tenv, clauses),
    )
  }

  // Candidate expansion is a tracked fixed-payload read, independent of
  // variance. It cannot invoke inference's covariant sealing/default rules.
  // Constraint and named-type normalization still use the guarded backend.
  private mutable fun expandInstance(inst: TInst, variance: ?Variance): ?TType {
    inst match {
    | TSInst(name, targs) ->
      Some(this.tenv.expandNamed(this.scratch, name, targs))
    | tInter @ TInter _ -> Some(tInter.expand(this.scratch, this.tenv))
    | tv @ TVar _ ->
      variance.map(_ -> {
        value = this.peekRaw(tv).fromSome();
        for (constraint in tv.constraints) {
          !value = TType::inter(this.scratch, this.tenv, value, constraint)
        };
        value
      })
    | arrLit @ TArrayLit _ -> Some(arrLit.selector.read(this))
    }
  }

  private mutable fun expandClauses(type: TType, variance: Variance): Clauses {
    type.expandGraph(inst -> this.expandInstance(inst, Some(variance))) match {
    | None() -> Clauses::top()
    | Some((_, clauses)) -> Clauses::unionN(this.scratch, this.tenv, clauses)
    }
  }

  mutable fun restElement(type: TType, variance: Variance): ?TType {
    this.lifetime.checkActive();
    this.expandClauses(type, variance).restElement(this.scratch, this.tenv)
  }

  private mutable fun tupleElements(clauses: Clauses): ?Array<TType> {
    clauses.getSingleTupleWith((pos, elements) ->
      TType::unionN_it(this.scratch, this.tenv, pos, elements)
    )
  }

  // A constrained type subtypes its raw binding. The fallback therefore may
  // supply a supertype tuple shape; reading it still records the dependency.
  mutable fun spreadTuple(type: TType): ?Array<TType> {
    this.lifetime.checkActive();
    clauses = this.expandClauses(type, Covariant());
    this.tupleElements(clauses) match {
    | Some(elements) -> Some(elements)
    | None() ->
      type.getSingleVar().flatMap(tv ->
        this.peekRaw(tv).flatMap(bound ->
          this.tupleElements(this.expandClauses(bound, Covariant()))
        )
      )
    }
  }
}

extension base class TEnv {
  // An observed operation must not inherit subtype/intersection assumptions
  // made while checking its caller. Its own recursive calls rebuild these
  // guards under the fixed observation snapshot. Lexical bindings, declaration
  // identities, bounds, and normalization modes are preserved.
  fun forTypeReadObservation(): this {
    this with {
      seenSub => SortedSet[],
      seenNamedSub => SortedSet[],
      seenInter => SortedSet[],
      subtypingHeadDepth => SortedMap[],
    }
  }
}

module end;
