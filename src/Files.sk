/***************************************************************************/
/* Module loading all the files we need in memory. */
/***************************************************************************/

module alias S = SKStore;

module SKJS;

base class ParsedResult {
  children =
  | PROk(Array<Def>)
  | PRError(LexingOrParsingError)
}

class ParsedResultAndSymbolsFile(
  value: ParsedResult,
  symbols: Map<SymbolicPos, Int>,
  funDefSigs: Map<FunDefRef, FunDefSigData> = Map[],
  funDefBodies: Map<FunDefRef, FunDefBodyData> = Map[],
  classBodies: Map<ClassBodyRef, ClassBodyData> = Map[],
  classFieldEntries: Map<ClassFieldRef, ClassFieldData> = Map[],
  typeDefBodies: Map<TypeDefBodyRef, TypeDefBodyData> = Map[],
  methodBodyEntries: Map<MethodBodyRef, MethodBodyData> = Map[],
) extends SKStore.File

class ParsedResultFile(value: ParsedResult) extends SKStore.File

base class ResolvedDef uses XXHashable {
  children =
  | RDFunDef(TopLevelFunDef)
  | RDClass(Class, Array<ClassField>)
  | RDTypeDef(TypeDef, TypeDefBodyData)
  | RDOther(Def)

  fun toDef(): Def
  | RDFunDef(d)
  | RDClass(d, _)
  | RDTypeDef(d, _) ->
    Def::create(d.defStableName().fromSome().pos, d)
  | RDOther(d) -> d
}

class ResolvedDefKey(value: String) extends SKStore.Key
class ResolvedDefFile(value: ResolvedDef) extends SKStore.File

const parseErrorKey: FAbsolute = FAbsolute::nil;

const filesDirName: SKStore.DirName = SKStore.DirName::create("/skjs/files/");
const parsesDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/parsed_with_errors/",
);
const oldParsesDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/changed_file_old_parse_results/",
);
const resolvedDefsDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/resolvedDefs/",
);
class Files(
  isInit: Bool,
  root: DAbsolute,
  builtinsFileName: FAbsolute,
  filesContent: SKStore.EHandle<FAbsolute, SKStore.StringFile>,
  importStubs: Array<DAbsolute>,
  changedFileOldParsedResults: ?SortedMap<FAbsolute, ParsedResult>,
) {
  static fun create(
    context: mutable SKStore.Context,
    root: String,
    builtinsFileNameStr: String,
    srcFileSeq: Sequence<String>,
    trackChangedFiles: Bool = false,
    importStubs: Array<String> = Array[],
  ): Result<Files, String> {
    builtinsFileName = FAbsolute::create(builtinsFileNameStr);
    if (srcFileSeq.isEmpty()) {
      !srcFileSeq = Array[root]
    };
    srcFiles = mutable Set[];
    for (f in srcFileSeq) {
      !f = Path.resolve(f);
      if (!FileSystem.exists(f)) {
        return Failure(`Source file ${f} does not exist`)
      };
      if (FileSystem.isDirectory(f)) {
        srcFiles.extend(FileSystem.readFilesRecursive(f, isTsFile))
      } else {
        srcFiles.insert(f)
      }
    };
    if (srcFiles.isEmpty()) {
      return Failure("No source files!");
    };
    if (!builtinsFileName.exists()) {
      return Failure(`Builtins not found: ${builtinsFileName}`);
    };
    srcFiles.insert(builtinsFileName.toString());
    !importStubs = importStubs.map(dir -> Path.resolve(dir));
    importStubs.each(dir ->
      srcFiles.extend(FileSystem.readFilesRecursive(dir, isTsFile))
    );

    isInit = context.unsafeMaybeGetEagerDir(filesDirName) is None();
    fileHdl = createOrReuseEagerDir(
      context,
      FAbsolute::keyType,
      SKStore.StringFile::type,
      filesDirName,
    );
    fileDir = context.unsafeGetEagerDir(filesDirName);
    oldParses: SortedMap<FAbsolute, ParsedResult> = SortedMap::create();

    for (fileName in srcFiles) {
      key = FAbsolute::create(fileName);
      content = FileSystem.readTextFile(fileName);
      if (!isInit && trackChangedFiles) {
        oldFile = fileDir.getArrayRaw(key);
        if (
          oldFile.size() == 1 &&
          SKStore.StringFile::type(oldFile[0]).value != content
        ) {
          // stash defs from previous run to compare against new versions
          oldParsedResult = context
            .unsafeGetEagerDir(parsesDirName)
            .getArrayRaw(key)
            .map(ParsedResultAndSymbolsFile::type)[0].value;
          !oldParses = oldParses.set(key, oldParsedResult);
        }
      };
      fileHdl.writeArray(context, key, Array[SKStore.StringFile(content)]);
    };
    for ((fileName, _) in fileHdl.items(context)) {
      if (!srcFiles.contains(fileName.toString())) {
        fileHdl.writeArray(context, fileName, Array[]);
      };
    };
    changedFileOldParsedResults = if (trackChangedFiles) Some(oldParses) else {
      None()
    };
    Success(
      Files(
        isInit,
        DAbsolute::create(root),
        builtinsFileName,
        fileHdl,
        importStubs.map(DAbsolute::create),
        changedFileOldParsedResults,
      ),
    )
  }

  fun parse(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    errorHandling: ErrorHandling,
  ): (
    SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>,
    SymbolsMap,
    FunDefSigMap,
    FunDefBodyMap,
    ClassBodyMap,
    ClassFieldMap,
    TypeDefBodyMap,
    MethodBodyMap,
  ) {
    parsedFiles = this.filesContent.map(
      FAbsolute::keyType,
      ParsedResultAndSymbolsFile::type,
      context,
      parsesDirName,
      (_context, writer, fileName, contentIter) ~> {
        content = contentIter.first.value;
        lexer = Lexer::mcreate(fileName, content, this.root);
        parser = mutable Parser(lexer);
        parsingResult = errorHandling match {
        | EHBacktrace() -> PROk(parser.toplevelDefs())
        | EHKeepGoing() ->
          try {
            PROk(parser.toplevelDefs())
          } catch {
          | ErrorExn(err @ LexingOrParsingError _) -> PRError(err)
          | exn -> throw exn
          }
        | EHDefault() ->
          try {
            PROk(parser.toplevelDefs())
          } catch {
          | ErrorExn(err @ LexingOrParsingError _) ->
            symbols = lexer.getAllSymbolLocations();
            res = PRError(err);
            // Store the error under parseErrorKey for immediate error reporting
            writer.setArray(
              parseErrorKey,
              Array[ParsedResultAndSymbolsFile(res, symbols)],
            );
            res
          | exn -> throw exn
          }
        };
        funDefSigs = {
          m = mutable Map[];
          for ((ref, data) in parser.funDefSigs) m.set(ref, data);
          m.chill()
        };
        funDefBodies = {
          m = mutable Map[];
          for ((ref, data) in parser.funDefBodies) m.set(ref, data);
          m.chill()
        };
        classBodies = {
          m = mutable Map[];
          for ((ref, data) in parser.classBodies) m.set(ref, data);
          m.chill()
        };
        classFieldEntries = {
          m = mutable Map[];
          for ((ref, data) in parser.classFieldEntries) m.set(ref, data);
          m.chill()
        };
        typeDefBodies = {
          m = mutable Map[];
          for ((ref, data) in parser.typeDefBodies) m.set(ref, data);
          m.chill()
        };
        methodBodyEntries = {
          m = mutable Map[];
          for ((ref, data) in parser.methodBodyEntries) m.set(ref, data);
          m.chill()
        };
        writer.setArray(
          fileName,
          Array[
            ParsedResultAndSymbolsFile(
              parsingResult,
              lexer.getAllSymbolLocations(),
              funDefSigs,
              funDefBodies,
              classBodies,
              classFieldEntries,
              typeDefBodies,
              methodBodyEntries,
            ),
          ],
        )
      },
    );
    symbolsMap = SymbolsMap::create(context, parsedFiles);
    funDefSigMap = FunDefSigMap::create(context, parsedFiles);
    funDefBodyMap = FunDefBodyMap::create(context, parsedFiles);
    classBodyMap = ClassBodyMap::create(context, parsedFiles);
    classFieldMap = ClassFieldMap::create(context, parsedFiles);
    typeDefBodyMap = TypeDefBodyMap::create(context, parsedFiles);
    methodBodyMap = MethodBodyMap::create(context, parsedFiles);
    _ = makeResolvedDefs(context, parsedFiles);
    errors = parsedFiles.unsafeGetArray(context, parseErrorKey);
    if (errors.size() != 0) {
      invariant(
        !(errorHandling is EHKeepGoing()),
        "No errors expected when using --keep-going",
      );
      for (error in errors) {
        error.value match {
        | PRError(err) ->
          print_error(err.toString(context, newLinesMap, symbolsMap))
        | PROk _ -> internal_error("Unexpected parsing result")
        }
      };
      throw Exit(2);
    };
    (
      parsedFiles,
      symbolsMap,
      funDefSigMap,
      funDefBodyMap,
      classBodyMap,
      classFieldMap,
      typeDefBodyMap,
      methodBodyMap,
    )
  }

  // (added-defs, removed-defs) since last run
  fun getChangedDefs(
    context: mutable SKStore.Context,
  ): (Array<Def>, Array<Def>) {
    added: mutable Vector<Def> = mutable Vector[];
    removed: mutable Vector<Def> = mutable Vector[];

    oldParses = this.changedFileOldParsedResults match {
    | Some(oldParses) -> oldParses
    | None() ->
      invariant_violation(
        "getChangedDefs called without any old parsed results",
      )
    };
    currentParses = context.unsafeMaybeGetEagerDir(parsesDirName) match {
    | Some _ ->
      SKStore.EHandle(
        FAbsolute::keyType,
        ParsedResultAndSymbolsFile::type,
        parsesDirName,
      )
    | None() ->
      invariant_violation(
        "getChangedDefs called without any current parsed results ",
      )
    };
    for ((fileName, previousParsedResult) in oldParses.items()) {
      currentParsedResult = currentParses.get(context, fileName).value;
      (previousParsedResult, currentParsedResult) match {
      | (PRError(_), PRError(_)) -> continue
      | (PROk(prevDefs), PRError(_)) -> removed.extend(prevDefs)
      | (PRError(_), PROk(currDefs)) -> added.extend(currDefs)
      | (PROk(prevDefs), PROk(currDefs)) ->
        prevDefsByHash = SortedMap::createFromIterator(
          prevDefs.values().map((def) -> (def.xxhash(), def)),
        );
        currDefsByHash = SortedMap::createFromIterator(
          currDefs.values().map((def) -> (def.xxhash(), def)),
        );
        for ((hash, def) in prevDefsByHash.items()) {
          if (!currDefsByHash.containsKey(hash)) removed.push(def)
        };
        for ((hash, def) in currDefsByHash.items()) {
          if (!prevDefsByHash.containsKey(hash)) added.push(def)
        }
      }
    };
    (added.toArray(), removed.toArray())
  }
}

fun removeSymbols(
  context: mutable SKStore.Context,
  parsedResultAndSymbols: SKStore.EHandle<
    FAbsolute,
    ParsedResultAndSymbolsFile,
  >,
): SKStore.EHandle<FAbsolute, ParsedResultFile> {
  parsedResultAndSymbols.map(
    FAbsolute::keyType,
    ParsedResultFile::type,
    context,
    SKStore.DirName::create("/parsed/nosymbols/"),
    (_context, writer, key, values) ~> {
      writer.set(key, ParsedResultFile(values.first.value))
    },
  )
}

fun resolveDef(file: ParsedResultAndSymbolsFile, def: Def): ResolvedDef {
  exportable: ?Exportable = def.value match {
  | Export(e) -> Some(e)
  | ExportDeclare(e) -> Some(e)
  | e @ TopLevelFunDef _ -> Some(e)
  | e @ Class _ -> Some(e)
  | e @ TypeDef _ -> Some(e)
  | _ -> None()
  };
  exportable match {
  | Some(fd @ TopLevelFunDef _) -> resolveFunDef(file, fd)
  | Some(cls @ Class{bodyRef => Some(ref)}) -> resolveClass(file, cls, ref)
  | Some(td @ TypeDef{bodyRef => Some(ref)}) -> resolveTypeDef(file, td, ref)
  | _ -> RDOther(def)
  }
}

fun resolveFunDef(
  file: ParsedResultAndSymbolsFile,
  fd: TopLevelFunDef,
): ResolvedDef {
  resolvedSig = fd.sig match {
  | FSRef(ref) ->
    sigData = file.funDefSigs.maybeGet(ref).fromSome();
    FSInline(sigData.tparams, sigData.params, sigData.retType)
  | s @ FSInline _ -> s
  };
  resolvedBody = fd.body match {
  | FBRef(BRFunDef(ref)) ->
    FBInline(file.funDefBodies.maybeGet(ref).fromSome().body)
  | b -> b
  };
  RDFunDef(fd with {sig => resolvedSig, body => resolvedBody})
}

fun resolveClass(
  file: ParsedResultAndSymbolsFile,
  cls: Class,
  bodyRef: ClassBodyRef,
): ResolvedDef {
  bodyData = file.classBodies.maybeGet(bodyRef).fromSome();
  fields = bodyData.fieldRefs.map(fieldRef -> {
    fieldData = file.classFieldEntries.maybeGet(fieldRef).fromSome();
    resolveClassField(file, fieldData.field)
  });
  RDClass(cls, fields)
}

fun resolveClassField(
  file: ParsedResultAndSymbolsFile,
  field: ClassField,
): ClassField {
  field match {
  | method @ ClassFieldMethod{body => FBRef(BRMethod(ref))} ->
    method with {
      body => FBInline(file.methodBodyEntries.maybeGet(ref).fromSome().body),
    }
  | _ -> field
  }
}

fun resolveTypeDef(
  file: ParsedResultAndSymbolsFile,
  td: TypeDef,
  ref: TypeDefBodyRef,
): ResolvedDef {
  RDTypeDef(td, file.typeDefBodies.maybeGet(ref).fromSome())
}

fun makeResolvedDefs(
  context: mutable SKStore.Context,
  parsedFiles: SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>,
): SKStore.EHandle<ResolvedDefKey, ResolvedDefFile> {
  parsedFiles.map(
    ResolvedDefKey::keyType,
    ResolvedDefFile::type,
    context,
    resolvedDefsDirName,
    (_context, writer, _fileName, values) ~> {
      file = values.first;
      file.value match {
      | PROk(defs) ->
        for (def in defs) {
          resolved = resolveDef(file, def);
          resolved match {
          | RDOther _ -> void
          | _ ->
            def.value.defStableName() match {
            | Some(name) ->
              writer.set(ResolvedDefKey(name.value), ResolvedDefFile(resolved))
            | None() -> void
            }
          }
        }
      | PRError _ -> void
      }
    },
  )
}

module end;
