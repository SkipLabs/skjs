/*****************************************************************************/
/* Module loading all the files we need in memory. */
/*****************************************************************************/

module alias S = SKStore;

module SKJS;

class DefFile(defs: Array<Def>) extends SKStore.File

base class ParsedResult {
  children =
  | PROk(Array<Def>)
  | PRError(String)
}

class ParsedResultFile(value: ParsedResult) extends SKStore.File
const parseErrorKey: SKStore.SID = SKStore.SID("");

class Files(
  isInit: Bool,
  nodeModuleFiles: Array<String>,
  srcFiles: UnorderedSet<String>,
  filesContent: SKStore.EHandle<SKStore.SID, SKStore.StringFile>,
) {
  static fun create(
    context: mutable SKStore.Context,
    srcFiles: Sequence<String>,
  ): Files {
    filesDirName = SKStore.DirName::create("/skjs/files/");
    isInit = context.unsafeMaybeGetEagerDir(filesDirName) is None();
    fileDir = context.mkdir(
      SKStore.SID::keyType,
      SKStore.StringFile::type,
      filesDirName,
    );

    // This adds the nearest node_modules/ dir for each source file
    // Similar to FileSystem.findNearestFile but with a cache
    searchedDirsForNodeModule = mutable UnorderedSet[];
    nodeModuleDirs = mutable Vector[];
    for (fileName in srcFiles) {
      dirName = Path.dirname(fileName);
      while (!searchedDirsForNodeModule.contains(dirName)) {
        possibleNodeModuleDir = Path.join(dirName, "node_modules");
        searchedDirsForNodeModule.add(dirName);
        if (FileSystem.exists(possibleNodeModuleDir)) {
          nodeModuleDirs.push(possibleNodeModuleDir);
          break void;
        };
        if (Path.isRoot(dirName)) break void;
        !dirName = Path.parentname(dirName);
      }
    };
    nodeModuleFiles = nodeModuleDirs
      .flatMap(nodeModuleDir ->
        FileSystem.readFilesRecursive(nodeModuleDir, fileName ~>
          fileName.endsWith(".ts")
        )
      )
      .toArray();
    for (fileName in nodeModuleFiles) {
      fileDir.writeArray(
        context,
        SKStore.SID(fileName),
        Array[SKStore.StringFile(FileSystem.readTextFile(fileName))],
      );
    };
    for (fileName in srcFiles) {
      fileDir.writeArray(
        context,
        SKStore.SID(fileName),
        Array[SKStore.StringFile(FileSystem.readTextFile(fileName))],
      );
    };
    Files(isInit, nodeModuleFiles, srcFiles.collect(UnorderedSet), fileDir)
  }

  fun parse(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
  ): SKStore.EHandle<SKStore.SID, ParsedResultFile> {
    parsedFiles = this.filesContent.map(
      SKStore.SID::keyType,
      ParsedResultFile::type,
      context,
      SKStore.DirName::create("/skjs/parsed_with_errors/"),
      (context, writer, key, contentIter) ~> {
        fileName = key.value;
        if (!this.srcFiles.contains(fileName) && !fileName.endsWith(".d.ts")) {
          return void;
        };
        content = contentIter.first.value;
        lexer = Lexer::mcreate(fileName, content);
        parser = mutable Parser(lexer);
        try {
          writer.setArray(
            key,
            Array[ParsedResultFile(PROk(parser.toplevelDefs()))],
          )
        } catch {
        | ErrorExn(err) ->
          writer.setArray(
            SKStore.SID(""),
            Array[
              ParsedResultFile(PRError(err.toString(context, newLinesMap))),
            ],
          )
        | exn -> throw exn
        }
      },
    );
    errors = parsedFiles.unsafeGetArray(context, SKStore.SID(""));
    if (errors.size() != 0) {
      for (error in errors) {
        error.value match {
        | PRError(err) -> print_error(err)
        | _ -> invariant_violation("Unexpected parsing result")
        }
      };
      throw Exit(2);
    };
    parsedFiles
  }
}

module end;
