/***************************************************************************/
/* Module loading all the files we need in memory. */
/***************************************************************************/

module alias S = SKStore;

module SKJS;

base class ParsedResult {
  children =
  | PROk(Array<Def>)
  | PRError(LexingOrParsingError)
}

class ParsedResultAndSymbolsFile(
  value: ParsedResult,
  symbols: Map<SymbolicPos, Int>,
) extends SKStore.File

class ParsedResultFile(value: ParsedResult) extends SKStore.File

const parseErrorKey: FAbsolute = FAbsolute::nil;

const filesDirName: SKStore.DirName = SKStore.DirName::create("/skjs/files/");
const parsesDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/parsed_with_errors/",
);
const oldParsesDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/changed_file_old_parse_results/",
);
class Files(
  isInit: Bool,
  root: DAbsolute,
  builtinsFileName: FAbsolute,
  filesContent: SKStore.EHandle<FAbsolute, SKStore.StringFile>,
  importStubs: Array<DAbsolute>,
  changedFileOldParsedResults: ?SortedMap<FAbsolute, ParsedResult>,
) {
  static fun create(
    context: mutable SKStore.Context,
    root: String,
    builtinsFileNameStr: String,
    srcFileSeq: Sequence<String>,
    trackChangedFiles: Bool = false,
    importStubs: Array<String> = Array[],
  ): Result<Files, String> {
    builtinsFileName = FAbsolute::create(builtinsFileNameStr);
    if (srcFileSeq.isEmpty()) {
      !srcFileSeq = Array[root]
    };
    srcFiles = mutable Set[];
    for (f in srcFileSeq) {
      !f = Path.resolve(f);
      if (!FileSystem.exists(f)) {
        return Failure(`Source file ${f} does not exist`)
      };
      if (FileSystem.isDirectory(f)) {
        srcFiles.extend(
          FileSystem.readFilesRecursive(f, fileName ->
            fileName.endsWith(".ts")
          ),
        )
      } else {
        srcFiles.insert(f)
      }
    };
    if (srcFiles.isEmpty()) {
      return Failure("No source files!");
    };
    if (!builtinsFileName.exists()) {
      return Failure(`Builtins not found: ${builtinsFileName}`);
    };
    srcFiles.insert(builtinsFileName.toString());
    !importStubs = importStubs.map(dir -> Path.resolve(dir));
    importStubs.each(dir ->
      srcFiles.extend(
        FileSystem.readFilesRecursive(dir, fileName ->
          fileName.endsWith(".ts")
        ),
      )
    );

    isInit = context.unsafeMaybeGetEagerDir(filesDirName) is None();
    fileHdl = createOrReuseEagerDir(
      context,
      FAbsolute::keyType,
      SKStore.StringFile::type,
      filesDirName,
    );
    fileDir = context.unsafeGetEagerDir(filesDirName);
    oldParses: SortedMap<FAbsolute, ParsedResult> = SortedMap::create();

    for (fileName in srcFiles) {
      key = FAbsolute::create(fileName);
      content = FileSystem.readTextFile(fileName);
      if (!isInit && trackChangedFiles) {
        oldFile = fileDir.getArrayRaw(key);
        if (
          oldFile.size() == 1 &&
          SKStore.StringFile::type(oldFile[0]).value != content
        ) {
          // stash defs from previous run to compare against new versions
          oldParsedResult = context
            .unsafeGetEagerDir(parsesDirName)
            .getArrayRaw(key)
            .map(ParsedResultAndSymbolsFile::type)[0].value;
          !oldParses = oldParses.set(key, oldParsedResult);
        }
      };
      fileHdl.writeArray(context, key, Array[SKStore.StringFile(content)]);
    };
    for ((fileName, _) in fileHdl.items(context)) {
      if (!srcFiles.contains(fileName.toString())) {
        fileHdl.writeArray(context, fileName, Array[]);
      };
    };
    changedFileOldParsedResults = if (trackChangedFiles) Some(oldParses) else {
      None()
    };
    Success(
      Files(
        isInit,
        DAbsolute::create(root),
        builtinsFileName,
        fileHdl,
        importStubs.map(DAbsolute::create),
        changedFileOldParsedResults,
      ),
    )
  }

  fun parse(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
    _keepGoing: Bool,
  ): (SKStore.EHandle<FAbsolute, ParsedResultAndSymbolsFile>, SymbolsMap) {
    parsedFiles = this.filesContent.map(
      FAbsolute::keyType,
      ParsedResultAndSymbolsFile::type,
      context,
      parsesDirName,
      (_context, writer, fileName, contentIter) ~> {
        content = contentIter.first.value;
        lexer = Lexer::mcreate(fileName, content, this.root);
        parser = mutable Parser(lexer);
        try {
          writer.setArray(
            fileName,
            Array[
              ParsedResultAndSymbolsFile(
                PROk(parser.toplevelDefs()),
                lexer.getAllSymbolLocations(),
              ),
            ],
          )
        } catch {
        | ErrorExn(err @ LexingOrParsingError _) ->
          symbols = lexer.getAllSymbolLocations();
          // Store the error under parseErrorKey for error reporting
          writer.setArray(
            parseErrorKey,
            Array[ParsedResultAndSymbolsFile(PRError(err), symbols)],
          );
          // Also store the symbols under the actual filename for symbol resolution
          writer.setArray(
            fileName,
            Array[ParsedResultAndSymbolsFile(PRError(err), symbols)],
          )
        | exn -> throw exn
        }
      },
    );
    errors = parsedFiles.unsafeGetArray(context, parseErrorKey);
    symbolsMap = SymbolsMap::create(context, parsedFiles);
    if (errors.size() != 0) {
      for (error in errors) {
        error.value match {
        | PRError(err) ->
          print_error(err.toString(context, newLinesMap, symbolsMap))
        | PROk _ -> internal_error("Unexpected parsing result")
        }
      };
      throw Exit(2);
    };
    (parsedFiles, symbolsMap)
  }

  // (added-defs, removed-defs) since last run
  fun getChangedDefs(
    context: mutable SKStore.Context,
  ): (Array<Def>, Array<Def>) {
    added: mutable Vector<Def> = mutable Vector[];
    removed: mutable Vector<Def> = mutable Vector[];

    oldParses = this.changedFileOldParsedResults match {
    | Some(oldParses) -> oldParses
    | None() ->
      invariant_violation(
        "getChangedDefs called without any old parsed results",
      )
    };
    currentParses = context.unsafeMaybeGetEagerDir(parsesDirName) match {
    | Some _ ->
      SKStore.EHandle(
        FAbsolute::keyType,
        ParsedResultAndSymbolsFile::type,
        parsesDirName,
      )
    | None() ->
      invariant_violation(
        "getChangedDefs called without any current parsed results ",
      )
    };
    for ((fileName, previousParsedResult) in oldParses.items()) {
      currentParsedResult = currentParses.get(context, fileName).value;
      (previousParsedResult, currentParsedResult) match {
      | (PRError(_), PRError(_)) -> continue
      | (PROk(prevDefs), PRError(_)) -> removed.extend(prevDefs)
      | (PRError(_), PROk(currDefs)) -> added.extend(currDefs)
      | (PROk(prevDefs), PROk(currDefs)) ->
        prevDefsByHash = SortedMap::createFromIterator(
          prevDefs.values().map((def) -> (def.xxhash(true), def)),
        );
        currDefsByHash = SortedMap::createFromIterator(
          currDefs.values().map((def) -> (def.xxhash(true), def)),
        );
        for ((hash, def) in prevDefsByHash.items()) {
          if (!currDefsByHash.containsKey(hash)) removed.push(def)
        };
        for ((hash, def) in currDefsByHash.items()) {
          if (!prevDefsByHash.containsKey(hash)) added.push(def)
        }
      }
    };
    (added.toArray(), removed.toArray())
  }
}

fun removeSymbols(
  context: mutable SKStore.Context,
  parsedResultAndSymbols: SKStore.EHandle<
    FAbsolute,
    ParsedResultAndSymbolsFile,
  >,
): SKStore.EHandle<FAbsolute, ParsedResultFile> {
  parsedResultAndSymbols.map(
    FAbsolute::keyType,
    ParsedResultFile::type,
    context,
    SKStore.DirName::create("/parsed/nosymbols/"),
    (_context, writer, key, values) ~> {
      writer.set(key, ParsedResultFile(values.first.value))
    },
  )
}

module end;
