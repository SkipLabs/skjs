/***************************************************************************/
/* Module loading all the files we need in memory. */
/***************************************************************************/

module alias S = SKStore;

module SKJS;

base class ParsedResult {
  children =
  | PROk(Array<Def>)
  | PRError(String)
}

class ParsedResultFile(
  value: ParsedResult,
  symbols: Map<SymbolicPos, Int>,
) extends SKStore.File
const parseErrorKey: SKStore.SID = SKStore.SID("");

const filesDirName: SKStore.DirName = SKStore.DirName::create("/skjs/files/");
const parsesDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/parsed_with_errors/",
);
const oldParsesDirName: SKStore.DirName = SKStore.DirName::create(
  "/skjs/changed_file_old_parse_results/",
);
class Files(
  isInit: Bool,
  rootOpt: ?DirName,
  builtinsFileName: FileName,
  filesContent: SKStore.EHandle<SKStore.SID, SKStore.StringFile>,
  changedFileOldParsedResults: ?SortedMap<String, ParsedResult>,
) {
  static fun create(
    context: mutable SKStore.Context,
    baseUrlOpt: ?String,
    builtinsFileNameStr: String,
    srcFileSeq: Sequence<String>,
    trackChangedFiles: Bool = false,
  ): Result<Files, String> {
    builtinsFileName = FileName::create(Path.resolve(builtinsFileNameStr));
    rootOpt = baseUrlOpt.map(baseUrl -> DirName::create(Path.resolve(baseUrl)));
    if (srcFileSeq.isEmpty()) {
      root = rootOpt match {
      | Some(root) -> root
      | None() -> DirName::create(FileSystem.realpath("."))
      };
      !rootOpt = Some(root);
      srcDir = `${root}src/`;
      if (!FileSystem.exists(srcDir)) {
        return Failure(`Could not find src/ dir in: ${root}`);
      };
      !srcFileSeq = FileSystem.readFilesRecursive(srcDir, fileName ->
        fileName.endsWith(".ts")
      );
    } else {
      !srcFileSeq = srcFileSeq.map(f -> Path.resolve(f));
    };
    if (srcFileSeq.isEmpty()) {
      return Failure("No source files!");
    };
    if (!builtinsFileName.exists()) {
      return Failure(`Builtins not found: ${builtinsFileName}`);
    };
    srcFiles = Array[
      srcFileSeq,
      Array[builtinsFileName.toString()],
    ].flatten().collect(SortedSet);

    isInit = context.unsafeMaybeGetEagerDir(filesDirName) is None();
    fileDir = if (isInit) {
      context.mkdir(
        SKStore.SID::keyType,
        SKStore.StringFile::type,
        filesDirName,
      );
    } else {
      SKStore.EHandle(
        SKStore.SID::keyType,
        SKStore.StringFile::type,
        filesDirName,
      )
    };
    fileEagerDir = context.unsafeGetEagerDir(filesDirName);
    oldParses: SortedMap<String, ParsedResult> = SortedMap::create();

    for (fileName in srcFiles) {
      key = SKStore.SID(fileName);
      content = FileSystem.readTextFile(fileName);
      if (!isInit && trackChangedFiles) {
        oldFile = fileEagerDir.getArrayRaw(key);
        if (
          oldFile.size() == 1 &&
          SKStore.StringFile::type(oldFile[0]).value != content
        ) {
          // stash defs from previous run to compare against new versions
          oldParsedResult = context
            .unsafeGetEagerDir(parsesDirName)
            .getArrayRaw(key)
            .map(ParsedResultFile::type)[0].value;
          !oldParses = oldParses.set(fileName, oldParsedResult);
        }
      };
      fileDir.writeArray(context, key, Array[SKStore.StringFile(content)]);
    };
    for (kv in fileDir.items(context)) {
      fileName = kv.i0.value;
      if (!srcFiles.contains(fileName)) {
        fileDir.writeArray(context, kv.i0, Array[]);
      };
    };
    changedFileOldParsedResults = if (trackChangedFiles) Some(oldParses) else {
      None()
    };
    Success(
      Files(
        isInit,
        rootOpt,
        builtinsFileName,
        fileDir,
        changedFileOldParsedResults,
      ),
    )
  }

  const parsesDirName: SKStore.DirName = SKStore.DirName::create(
    "/skjs/parsed_with_errors/",
  );
  fun parse(
    context: mutable SKStore.Context,
    newLinesMap: NewLinesMap,
  ): SKStore.EHandle<SKStore.SID, ParsedResultFile> {
    parsedFiles = this.filesContent.map(
      SKStore.SID::keyType,
      ParsedResultFile::type,
      context,
      parsesDirName,
      (context, writer, key, contentIter) ~> {
        fileName = key.value;
        //        if (!this.srcFiles.contains(fileName) && !fileName.endsWith(".d.ts")) {
        //          return void;
        //        };
        content = contentIter.first.value;
        lexer = Lexer::mcreate(fileName, content, this.rootOpt);
        parser = mutable Parser(lexer);
        try {
          writer.setArray(
            key,
            Array[
              ParsedResultFile(
                PROk(parser.toplevelDefs()),
                lexer.getAllSymbolLocations(),
              ),
            ],
          )
        } catch {
        | ErrorExn(err) ->
          writer.setArray(
            SKStore.SID(""),
            Array[
              ParsedResultFile(
                PRError(err.toString(context, newLinesMap)),
                lexer.getAllSymbolLocations(),
              ),
            ],
          )
        | exn -> throw exn
        }
      },
    );
    errors = parsedFiles.unsafeGetArray(context, SKStore.SID(""));
    if (errors.size() != 0) {
      for (error in errors) {
        error.value match {
        | PRError(err) -> print_error(err)
        | _ -> internal_error("Unexpected parsing result")
        }
      };
      throw Exit(2);
    };
    parsedFiles
  }

  // (added-defs, removed-defs) since last run
  fun getChangedDefs(
    context: mutable SKStore.Context,
  ): (Array<Def>, Array<Def>) {
    added: mutable Vector<Def> = mutable Vector[];
    removed: mutable Vector<Def> = mutable Vector[];

    oldParses = this.changedFileOldParsedResults match {
    | Some(oldParses) -> oldParses
    | None() ->
      invariant_violation(
        "getChangedDefs called without any old parsed results",
      )
    };
    currentParses = context.unsafeMaybeGetEagerDir(parsesDirName) match {
    | Some _ ->
      SKStore.EHandle(
        SKStore.SID::keyType,
        ParsedResultFile::type,
        parsesDirName,
      )
    | None() ->
      invariant_violation(
        "getChangedDefs called without any current parsed results ",
      )
    };
    for ((fileName, previousParsedResult) in oldParses.items()) {
      currentParsedResult = currentParses.get(
        context,
        SKStore.SID(fileName),
      ).value;
      (previousParsedResult, currentParsedResult) match {
      | (PRError(_), PRError(_)) -> continue
      | (PROk(prevDefs), PRError(_)) -> removed.extend(prevDefs)
      | (PRError(_), PROk(currDefs)) -> added.extend(currDefs)
      | (PROk(prevDefs), PROk(currDefs)) ->
        prevDefsByHash = SortedMap::createFromIterator(
          prevDefs.values().map((def) -> (def.xxhash(true), def)),
        );
        currDefsByHash = SortedMap::createFromIterator(
          currDefs.values().map((def) -> (def.xxhash(true), def)),
        );
        for ((hash, def) in prevDefsByHash.items()) {
          if (!currDefsByHash.containsKey(hash)) removed.push(def)
        };
        for ((hash, def) in currDefsByHash.items()) {
          if (!prevDefsByHash.containsKey(hash)) added.push(def)
        }
      }
    };
    (added.toArray(), removed.toArray())
  }
}

module end;
