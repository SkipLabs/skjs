/***************************************************************************/
// Module resolving NewLines.
/***************************************************************************/

module SKJS;

/***************************************************************************/
/* Newlines directory. */
/***************************************************************************/

class NewLinesFile(newLines: Array<Int>) extends SKStore.File

// The index of the character each line ends on, followed by the length of the
// content. A position's line is found by binary searching this, and its column
// by subtracting the previous entry (see PositionResolver::lineCol), so an entry
// is the index of a line terminator's LAST character.
fun computeNewLines(content: String): Array<Int> {
  newLines = mutable Vector[];
  i = 0;
  for (c in content) {
    if (c == '\n') newLines.push(i);
    !i = i + 1;
  };
  newLines.push(i);
  newLines.toArray()
}

fun makeNewLinesDir(
  context: mutable SKStore.Context,
  files: SKStore.EHandle<FPath, SKStore.StringFile>,
): SKStore.LHandle<FPath, NewLinesFile> {
  SKStore.LHandle::create(
    FPath::keyType,
    NewLinesFile::type,
    context,
    SKStore.DirName::create("/skjs/newlines/"),
    (context, _self, key) ~> {
      content = files.get(context, key).value;
      Array[NewLinesFile(computeNewLines(content))]
    },
  )
}

/***************************************************************************/
/* Newlines map (associates Newlines to a filename) */
/***************************************************************************/

class NewLinesMap{dir: SKStore.LHandle<FPath, NewLinesFile>} {
  static fun create(context: mutable SKStore.Context, files: Files): this {
    static{dir => makeNewLinesDir(context, files.filesContent)}
  }
  fun get(context: mutable SKStore.Context, fileName: FPath): Array<Int> {
    this.dir.get(context, fileName).newLines
  }
}

module end;
