/***************************************************************************/
/* The mutable environment used by the type-checker. */
/***************************************************************************/

module SKJS;

base class LocalObjectState {
  children =
  | LOCanGrow(bound: ?TType)
  | LOUsed(PosRange)
}

mutable class TCEnv(
  context: mutable SKStore.Context,
  subst: mutable Subst,
  mutable scope: mutable Scope,
  localObjects: mutable Map<String, LocalObjectState> = mutable Map[]/*
  Tracks local objects, i.e. object literals bounded to variables.
  Those are allowed to grow if they haven't been used.
  Growth is limited by the provided type, if any.
  */ ,
  private mutable counter: Int = 0,
) {
  private mutable fun next(): Int {
    this.!counter = this.counter + 1;
    this.counter
  }

  mutable fun mergeScope(
    subst: mutable Subst,
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    this.scope.merge(subst, tenv, scope1, scope2);
  }

  mutable fun popScope(
    subst: mutable Subst,
    tenv: TEnv,
    scope: readonly Scope,
  ): void {
    this.scope.merge(subst, tenv, scope, this.mcreateSubScope{isLoop => false});
  }

  mutable fun popScopeReplace(scope: readonly Scope): void {
    this.scope.popReplace(scope);
  }

  mutable fun mcreateSubScope{isLoop: Bool}: mutable Scope {
    mutable Scope{
      id => this.next(),
      isLoop,
      up => Some(this.scope),
      callingContext => this.scope.callingContext,
    }
  }
}

mutable class ConditionalTCEnv private (
  private tcenv: mutable TCEnv,
  scopeTrue: mutable Scope,
  scopeFalse: mutable Scope,
) {
  static fun create(tcenv: mutable TCEnv): mutable this {
    scopeTrue = tcenv.mcreateSubScope{isLoop => false};
    scopeFalse = tcenv.mcreateSubScope{isLoop => false};
    mutable static(tcenv, scopeTrue, scopeFalse)
  }

  mutable fun withTCEnv(branch: Bool, f: (mutable TCEnv) -> void): void {
    savedScope = this.tcenv.scope;
    branchScope = if (branch) this.scopeTrue else this.scopeFalse;
    this.tcenv.!scope = branchScope;
    branchScopeId = branchScope.id;
    f(this.tcenv);
    if (this.tcenv.scope.id != branchScopeId) {
      internal_error("withTCEnv scope id mismatch")
    };
    this.tcenv.!scope = savedScope
  }
}

module end;
