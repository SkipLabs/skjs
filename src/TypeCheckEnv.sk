/***************************************************************************/
/* The mutable environment used by the type-checker. */
/***************************************************************************/

module SKJS;

base class LocalObjectState {
  children =
  | LOCanGrow(bound: ?TType)
  | LOUsed(PosRange)
}

mutable class TCEnv(
  context: mutable SKStore.Context,
  subst: mutable Subst,
  private mutable scope: mutable Scope,
  mutable callingContext: CGNode,
  localObjects: mutable Map<String, LocalObjectState> = mutable Map[]/*
  Tracks local objects, i.e. object literals bounded to variables.
  Those are allowed to grow if they haven't been used.
  Growth is limited by the provided type, if any.
  */ ,
  private mutable counter: Int = 0,
) {
  static fun mcreate(
    context: mutable SKStore.Context,
    subst: mutable Subst,
    callingContext: CGNode,
  ): mutable this {
    scope = Scope::mcreateToplevel();
    mutable static(context, subst, scope, callingContext)
  }

  private mutable fun next(): Int {
    this.!counter = this.counter + 1;
    this.counter
  }

  mutable fun mergeScope(
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    this.scope.popMerge2(this.subst, tenv, scope1, scope2);
  }

  mutable fun popScopeReplace(scope: readonly Scope): void {
    this.scope.popReplace(scope);
  }

  private mutable fun mcreateSubScope{isLoop: Bool}: mutable Scope {
    mutable Scope{id => this.next(), isLoop, up => Some(this.scope)}
  }

  mutable fun withSubScope<T>{isLoop: Bool, f: () -> T}: (T, readonly Scope) {
    savedScope = this.scope;
    subScope = this.mcreateSubScope{isLoop};
    this.!scope = subScope;
    res = f();
    this.!scope = savedScope;
    (res, subScope)
  }

  mutable fun withSubScopeThrowAway(f: () -> void): void {
    (_void, _scope) = this.withSubScope<void>{isLoop => false, f}
  }

  mutable fun withSubScopeMerge{isLoop: Bool, tenv: TEnv, f: () -> void}: void {
    (_void, subScope) = this.withSubScope<void>{isLoop, f};
    this.scope.popMerge(this.subst, tenv, subScope)
  }

  mutable fun withinLoop(f: () -> void): void {
    (_void, subScope) = this.withSubScope<void>{isLoop => true, f};
    this.popScopeReplace(subScope)
  }

  mutable fun withSubScopeReplace(f: () -> void): void {
    (_void, subScope) = this.withSubScope<void>{isLoop => false, f};
    this.popScopeReplace(subScope)
  }

  mutable fun withForkedSubScopes<T>(
    tenv: TEnv,
    f1: () -> T,
    f2: () -> T,
  ): (T, T) {
    (res1, sub1) = this.withSubScope{isLoop => false, f => f1};
    (res2, sub2) = this.withSubScope{isLoop => false, f => f2};
    this.scope.popMerge2(this.subst, tenv, sub1, sub2);
    (res1, res2)
  }

  mutable fun bindingLocalObject(local: Name): void {
    if (
      !this.scope.isThroughLoop(local) &&
      !this.localObjects.containsKey(local.value)
    ) {
      this.localObjects![local.value] = LOCanGrow(None())
    }
  }

  readonly fun growingLocalObject(local: Name): void {
    if (this.scope.isThroughLoop(local)) {
      typingError(
        Array[(local.pos, "You cannot add a field to an object in a loop")],
      )
    }
  }

  mutable fun bind(local: Name, type: TType, isInitialized: Bool): void {
    this.scope.bind(local, type, isInitialized)
  }

  readonly fun maybeGet(local: Name): ?TType {
    this.scope.maybeGet(local)
  }

  readonly fun get(name: Name): TType {
    this.maybeGet(name) match {
    | None() -> typingError(Array[(name.pos, "Unbound name")])
    | Some(x) -> x
    }
  }

  mutable fun set(
    name: Name,
    ty: TType,
    isSubType: (TType, TType) -> void,
  ): void {
    this.scope.set(name, ty, isSubType)
  }
}

module end;
