/***************************************************************************/
/* The mutable environment used by the type-checker. */
/***************************************************************************/

module SKJS;

mutable base class TCEnvBase private {
  context: mutable SKStore.Context,
  results: mutable TCResultsAcc,
  // Switches whose cases cover every value the scrutinee can take, keyed by the
  // scrutinee's position. Only the type-checker can tell — it is the one that
  // knows the scrutinee's type — but the termination pass needs the answer, so
  // it is left here on the way past. A switch is absent until its clauses have
  // been checked, so asking early gets `false`, which is the conservative
  // answer: the switch is assumed to be escapable.
} {
  mutable fun recordClassHierarchy{child: Class, parent: Class}: void {
    this.results.recordClassHierarchy{child, parent}
  }

  mutable fun error(
    messages: Array<(PosRange, String)>,
    code: ErrorCode,
  ): void {
    this.results.error(messages, code)
  }

  // A non-fatal diagnostic: always recorded, never aborts (regardless of mode).
  mutable fun warning(
    messages: Array<(PosRange, String)>,
    code: ErrorCode,
  ): void {
    this.results.warning(messages, code)
  }

  mutable fun subtypingError(
    subst: readonly Subst,
    tenv: TEnv,
    messages: Array<(PosRange, String)>,
    stErr: STErrorOnTType,
    code: ErrorCode,
  ): void {
    this.results.subtypingError(subst, tenv, messages, stErr, code)
  }

  mutable fun notSupported(pos: PosRange, what: String): void {
    this.results.notSupported(pos, what)
  }

  mutable fun collectErrors(f: () -> void): void {
    this.results.collectErrors(f)
  }
}

mutable class TCEnvLight{} extends TCEnvBase {}

// For-in loop context: tracks whether v[k]! is safe inside a for-in loop.
// Only created when the loop variable is a simple binding and the iterable
// is a dotted path (e.g. `for (k in v)` or `for (k in a.b)`).
private class ForInContext{
  keyVar: String, // "k" in for(k in v)
  iterableKey: List<String>, // path segments for iterable (e.g. List["a", "b", "c"])
  impureCall: ?PosRange = None(), // position of first call/new that broke purity
  outer: ?ForInContext = None(), // enclosing for-in context (stack)
} {
  // Convert an expression to a path key for iterable matching.
  // Supports simple variables and dotted paths (e.g. `v`, `a.b.c`).
  static fun exprToKey(e: Expr, suffix: List<String> = List[]): ?List<String> {
    e.value match {
    | Var(name) -> Some(List.Cons(name.value, suffix))
    | Dot(NormalDot(), inner, field) ->
      static::exprToKey(inner, List.Cons(field.value, suffix))
    | _ -> None()
    }
  }
}

/*
 * State tracking for local objects (object literals bound to variables).
 *
 * Local objects enable progressive typing: building objects field-by-field
 * starting from an empty literal `{}`, which is common in JavaScript:
 *
 *   let obj = {};
 *   obj.field1 = value1;
 *   obj.field2 = value2;
 *   return obj;  // Type inferred from added fields
 *
 * State transitions:
 *   LOCanGrow -> LOUsed   (on first read/use of the object)
 *
 * Once LOUsed, the object's type is frozen and no more fields can be added.
 * This ensures type soundness: if code observes an object with certain fields,
 * we can't later add more fields that weren't visible at observation time.
 */
base class LocalObjectState {
  children =
  // Object can still have fields added (before first use).
  // `bound` is the optional type annotation that constrains growth.
  | LOCanGrow(bound: ?TType)
  // Object has been used (read/passed), type is now frozen.
  // Position records where it was first used (for error messages).
  | LOUsed(PosRange)
}

// A `break` or `continue` leaves a loop or switch mid-block, carrying the state
// at the jump to where control re-joins — after a switch, or a loop's exit or
// header. That state is invisible to the ordinary end-of-block scope merges, so
// each loop and switch registers a `JumpCatcher` around its body: every jump
// records a snapshot of the escaping bindings against the catcher's baseline
// scope, and the catcher unions them into its own exit (see SkipLabs/skjs#910).
// `catchesContinue` is true for loops (which catch both `break` and `continue`)
// and false for a switch (which catches only `break`; a `continue` inside it
// belongs to the enclosing loop).
mutable class JumpCatcher{
  catchesContinue: Bool,
  baselineScopeId: Int,
  breaks: mutable Vector<mutable Map<String, LocalRef>> = mutable Vector[],
  continues: mutable Vector<mutable Map<String, LocalRef>> = mutable Vector[],
}

mutable class TCEnv private {
  subst: mutable Subst,
  mutable scope: mutable Scope,
  mutable callingContext: CGNode,
  // exprTypes cache is keyed on (pos, mostPrecise, isLValue) triples.
  // i.e. the args of TypeChecker.expr, so that it can be used both for CFG
  // construction and as a generic cache for expression typechecking
  mutable exprTypes: SortedMap<(PosRange, Bool, Bool), TType> = SortedMap[],
  mutable stmtTerminations: SortedMap<PosRange, StmtTermination> = SortedMap[],
  /*
   * Tracks local objects: object literals bound to variables that can grow.
   *
   * Problem: JavaScript developers commonly build objects incrementally:
   *   let obj = {};
   *   obj.x = 5;
   *   obj.y = 10;
   *   return obj;
   *
   * TypeScript handles this with `any` and structural typing. SKJS is stricter
   * and requires explicit types, but we still want to support this pattern.
   *
   * Solution: Track object literals bound to variables, allow adding fields
   * before first use, then infer/check the final type.
   *
   * Growth is limited by:
   *   - Type annotation (if provided): new fields must match
   *   - First use: once read/passed, no more fields
   *   - Loops: can't grow in loops (final type unpredictable)
   *
   * Special handling:
   *   - Index signatures: field addition checks if field name matches index key
   *     type. If it matches, use index value type. If not, add explicit field.
   *     Example: `let obj: { [key: string]: number } = {}; obj.x = 5;`
   *     Here "x" is a subtype of string, so uses index signature.
   *
   * See examples/src/tree.ts:Node() for real usage.
   */
  // Keyed by the binding's DECLARATION position (Scope::bindingPos), not by
  // name: a name can be reused by distinct bindings in sibling/sequential (and,
  // later, shadowing) scopes, which must not share growth state.
  localObjects: mutable Map<PosRange, LocalObjectState> = mutable Map[],
  mutable forInContext: ?ForInContext = None(),
  // Stack of enclosing loops/switches, innermost last; see `JumpCatcher`.
  mutable jumpCatchers: mutable Vector<mutable JumpCatcher> = mutable Vector[],
  // One write-log per `try` being checked, innermost last: the running union
  // of every value written to each binding while the try runs. An exception
  // can leave the try after any prefix, so its catch and finally are entered
  // with each logged binding at any of these values — their entry states
  // union the log in (SkipLabs/skjs#963). A write feeds every level: it is
  // "during" each enclosing try.
  mutable tryWriteLogs: mutable Vector<
    mutable Map<String, TType>,
  > = mutable Vector[],
  // Type-claim recording (--emit-skjs-type-claims): the environment held on
  // entry to each statement, in check order. Empty unless emitSkjsTypeClaims is set.
  claimedEnvs: mutable Vector<TypeClaimEnv> = mutable Vector[],
  // Visits survive an aborted expression whose result was never cached.
  claimedExprVisits: mutable Vector<PosRange> = mutable Vector[],
  private mutable counter: Int = 0,
} extends TCEnvBase {
  static fun mcreate(
    subst: mutable Subst,
    callingContext: CGNode,
  ): mutable this {
    context = subst.context;
    results = subst.results;
    scope = Scope::mcreateToplevel();
    mutable static{context, subst, scope, callingContext, results}
  }

  private mutable fun next(): Int {
    this.!counter = this.counter + 1;
    this.counter
  }

  mutable fun mergeScope(
    tenv: TEnv,
    scope1: readonly Scope,
    scope2: readonly Scope,
  ): void {
    this.scope.merge(this.subst, tenv, scope1, scope2);
  }

  // Merge any number of sibling subscopes at once. `untouchedPath` adds a path
  // that leaves every binding alone (a `switch` with no `default` may match no
  // clause). See `Scope::mergeN`.
  mutable fun mergeScopes(
    tenv: TEnv,
    scopes: Sequence<readonly Scope>,
    untouchedPath: Bool,
  ): void {
    this.scope.mergeN(this.subst, tenv, scopes, untouchedPath);
  }

  mutable fun popScope(tenv: TEnv, scope: readonly Scope): void {
    this.scope.popMerge(this.subst, tenv, scope);
  }

  mutable fun popScopeReplace(scope: readonly Scope): void {
    this.scope.popReplace(scope);
  }

  mutable fun mcreateSubScope{
    isLoop: Bool,
    isFunction: Bool = false,
  }: mutable Scope {
    mutable Scope{id => this.next(), isLoop, isFunction, up => Some(this.scope)}
  }

  // localObjects is keyed by declaration position (Scope::bindingPos); these
  // accessors hide that keying. Growth state of the in-scope binding of
  // `local`, or None if it is not a tracked growable local object.
  readonly fun localObjectState(local: Name): ?LocalObjectState {
    this.scope.bindingPos(local).flatMap(p -> this.localObjects.maybeGet(p))
  }

  // Freeze the in-scope growable local object `local` (no-op if it is not one),
  // recording the use position for diagnostics.
  mutable fun markLocalObjectUsed(local: Name): void {
    this.scope.bindingPos(local) match {
    | Some(p) if (this.localObjects.containsKey(p)) ->
      this.localObjects![p] = LOUsed(local.pos)
    | _ -> void
    }
  }

  /* Jump-edge catchers for `break` / `continue`; see `JumpCatcher`. */

  // Run `f` with a catcher registered, and return its result along with the
  // catcher and the edges it caught. Registering and unregistering live in the
  // same function, so a caller cannot leave a catcher on the stack.
  mutable fun withJumpCatcher<T>(
    catchesContinue: Bool,
    f: () -> T,
  ): (T, readonly JumpCatcher) {
    this.jumpCatchers.push(
      mutable JumpCatcher{catchesContinue, baselineScopeId => this.scope.id},
    );
    res = f();
    (res, this.jumpCatchers.pop())
  }

  // Run `f` with a fresh write-log open, and return its result along with the
  // writes `f` logged. Opening and closing live in the same function, so a
  // caller cannot leave a log on the stack; a closed log is only ever read.
  mutable fun withTryWriteLog<T>(f: () -> T): (T, readonly Map<String, TType>) {
    this.tryWriteLogs.push(mutable Map[]);
    res = f();
    (res, this.tryWriteLogs.pop())
  }

  // A runtime write to the in-scope binding of `name`: record the value for
  // any enclosing try's log, then narrow the binding through `Scope::set`.
  // Narrowings are not writes — they must not widen a catch's view of a value
  // the runtime never changed — so the refinement and constructor-`super`
  // sets go to `Scope::set` directly, and only the assignment forms come
  // here.
  mutable fun writeVar(
    tenv: TEnv,
    name: Name,
    ty: TType,
    isSubType: (TType, TType) -> void,
  ): void {
    this.recordTryWrite(tenv, name, ty);
    this.scope.set(name, ty, isSubType)
  }

  // Record a write for the innermost block being logged. The log is keyed
  // by bare name, which relies on SKJS rejecting nested shadowing (TS2451):
  // if shadowing is ever allowed, distinct bindings would share entries and
  // this needs a binding identity instead (as Scope::snapshotTo does too). Outer trys receive
  // an inner construct's writes when it is popped, gated on whether an
  // exception can actually escape it carrying them (see the Try arm): an inner
  // try whose catch absorbs everything keeps its intermediate states to
  // itself.
  private mutable fun recordTryWrite(tenv: TEnv, name: Name, ty: TType): void {
    if (!this.tryWriteLogs.isEmpty()) {
      log = this.tryWriteLogs[this.tryWriteLogs.size() - 1];
      log![name.value] = log.maybeGet(name.value) match {
      | None() -> ty
      | Some(prev) -> TType::union(this.subst, tenv, prev, ty)
      }
    }
  }

  // Union a popped log's entries into the innermost log still open, if any —
  // the escape channel from an inner construct to the trys around it.
  mutable fun propagateTryWrites(
    tenv: TEnv,
    log: readonly Map<String, TType>,
  ): void {
    if (!this.tryWriteLogs.isEmpty()) {
      outer = this.tryWriteLogs[this.tryWriteLogs.size() - 1];
      for (kv in log.items()) {
        outer![kv.i0] = outer.maybeGet(kv.i0) match {
        | None() -> kv.i1
        | Some(prev) -> TType::union(this.subst, tenv, prev, kv.i1)
        }
      }
    }
  }

  // Union a scope's escaping bindings, by type, into the innermost log still
  // open — the unwind channel of a catch that cannot complete normally: its
  // return (or jump) passes through every enclosing finally carrying the
  // catch's state, seeds included.
  mutable fun propagateScopeToTryLog(tenv: TEnv, scope: readonly Scope): void {
    if (!this.tryWriteLogs.isEmpty()) {
      outer = this.tryWriteLogs[this.tryWriteLogs.size() - 1];
      for (nameRef in scope.escapingRefs()) {
        outer![nameRef.name] = outer.maybeGet(nameRef.name) match {
        | None() -> nameRef.ref.type
        | Some(prev) -> TType::union(this.subst, tenv, prev, nameRef.ref.type)
        }
      }
    }
  }

  // A logged value that outlived its construct normally is in flight in any
  // enclosing try: union its post-construct view into the log still open. A
  // name that no longer resolves was local to the construct.
  mutable fun propagateSurvivorsToTryLog(
    tenv: TEnv,
    log: readonly Map<String, TType>,
  ): void {
    if (!this.tryWriteLogs.isEmpty()) {
      outer = this.tryWriteLogs[this.tryWriteLogs.size() - 1];
      for (kv in log.items()) {
        this.scope.lookupRefType(kv.i0).each(ty ->
          outer![kv.i0] = outer.maybeGet(kv.i0) match {
          | None() -> ty
          | Some(prev) -> TType::union(this.subst, tenv, prev, ty)
          }
        )
      }
    }
  }

  // The number of edges each catcher holds, innermost last — taken before a
  // `try`, so the edges recorded while checking it can be found again once its
  // `finally` is known.
  readonly fun jumpEdgeMarks(): Array<(Int, Int)> {
    marks = mutable Vector[];
    for (catcher in this.jumpCatchers) {
      marks.push((catcher.breaks.size(), catcher.continues.size()))
    };
    marks.toArray()
  }

  // Fold a finally's writes into every jump edge recorded since `marks`: those
  // jumps leave the `try` through the finally, so what they carry to their
  // target must include its effects. Edges recorded before the try — and
  // catchers entered and left inside it, whose edges were consumed within the
  // try — are not touched. See `Scope::foldFinallyIntoSnapshot`.
  mutable fun foldFinallyIntoJumpEdges(
    tenv: TEnv,
    marks: Array<(Int, Int)>,
    finallyScope: readonly Scope,
  ): void {
    for (i in Range(0, min(marks.size(), this.jumpCatchers.size()))) {
      catcher = this.jumpCatchers[i];
      (breaksMark, continuesMark) = marks[i];
      for (j in Range(breaksMark, catcher.breaks.size())) {
        this.scope.foldFinallyIntoSnapshot(
          this.subst,
          tenv,
          catcher.breaks[j],
          finallyScope,
        )
      };
      for (j in Range(continuesMark, catcher.continues.size())) {
        this.scope.foldFinallyIntoSnapshot(
          this.subst,
          tenv,
          catcher.continues[j],
          finallyScope,
        )
      }
    }
  }

  // Record the current state at a `break`, against the innermost catcher (the
  // nearest loop or switch). A break with no catcher has no target in this
  // function: a JavaScript SyntaxError at load time, and a lambda cannot take
  // an enclosing function's loop as a target (the stack is cleared at function
  // boundaries), so it is reported rather than routed.
  mutable fun recordBreak(pos: PosRange): void {
    if (this.jumpCatchers.isEmpty()) {
      this.error(
        Array[(pos, "Jump target cannot cross function boundary")],
        TSCode(1107),
      )
    } else {
      catcher = this.jumpCatchers[this.jumpCatchers.size() - 1];
      catcher.breaks.push(this.scope.snapshotTo(catcher.baselineScopeId))
    }
  }

  // Record the current state at a `continue`, against the innermost catcher
  // that catches it — the nearest loop, skipping any switch in between. With
  // no such loop the continue has no target, and is reported as a break with
  // none is.
  mutable fun recordContinue(pos: PosRange): void {
    i = this.jumpCatchers.size() - 1;
    while (i >= 0 && !this.jumpCatchers[i].catchesContinue) {
      !i = i - 1
    };
    if (i < 0) {
      this.error(
        Array[(pos, "Jump target cannot cross function boundary")],
        TSCode(1107),
      )
    } else {
      catcher = this.jumpCatchers[i];
      catcher.continues.push(this.scope.snapshotTo(catcher.baselineScopeId))
    }
  }

  // Turn a recorded snapshot into a direct subscope of the current scope, so it
  // can join the sibling scopes a catcher merges at its exit.
  mutable fun snapshotScope(
    snap: readonly Map<String, LocalRef>,
  ): readonly Scope {
    s = this.mcreateSubScope{isLoop => false};
    s.seedRefs(snap);
    s
  }

  /* For-in context for safe v[k]! detection */

  readonly fun getForInContext(): ?ForInContext {
    this.forInContext
  }

  mutable fun enterForIn(keyVar: String, iterableKey: List<String>): void {
    this.!forInContext = Some(
      ForInContext{keyVar, iterableKey, outer => this.forInContext},
    )
  }

  mutable fun exitForIn(): void {
    this.forInContext match {
    | None() -> internal_error("Exiting empty for-in context")
    | Some(
      ForInContext{
        outer => Some(outer @ ForInContext{impureCall => None()}),
        impureCall => impureCall @ Some _,
      },
    ) ->
      this.!forInContext = Some(outer with {impureCall})
    | Some(ForInContext{outer}) -> this.!forInContext = outer
    }
  }

  mutable fun markForInImpure(pos: PosRange): void {
    this.forInContext.each(ctx -> {
      if (ctx.impureCall is None()) {
        this.!forInContext = Some(ctx with {impureCall => Some(pos)})
      }
    })
  }

  /* On results */
  mutable fun recordCalls(newCallees: CGNodes): void {
    caller = this.callingContext;
    this.results.recordCalls(caller, newCallees)
  }
}

class TCResults private {
  errors: Array<Error>,
  warnings: Array<Error>,
  callgraph: SortedMap<CGNode, Array<CGNode>>,
  classHierarchy: SortedMap<CHNode, SortedSet<CHNode>>,
  subtypingEdges: SortedSet<(CGNode, CGNode)>,
  cfgs: SortedMap<CGNode, CFG>,
  typeClaims: SortedMap<CGNode, FunTypeClaims>,
} {
  static fun ofAccs(accs: readonly Vector<readonly TCResultsAcc>): TCResults {
    callgraph = mutable Map[];
    classHierarchy = SortedMap<CHNode, SortedSet<CHNode>>[];
    subtypingEdges = SortedSet[];
    cfgs = SortedMap<CGNode, CFG>[];
    typeClaims = SortedMap<CGNode, FunTypeClaims>[];
    errors = mutable Vector<Error>[];
    warnings = mutable Vector<Error>[];
    for (acc in accs) {
      errors.extend(acc.errors);
      warnings.extend(acc.warnings);
      for (kv in acc.callgraph) {
        (caller, calleesToAdd) = kv;
        callees = callgraph.getOrAdd(caller, () -> mutable Set[]);
        calleesToAdd.nodes.each(callees.insert)
      };
      for (kv in acc.classHierarchy) {
        (child, parent) = kv;
        childNode = CHNode::ofClass(child);
        parentNode = CHNode::ofClass(parent);
        !classHierarchy[childNode] = classHierarchy
          .maybeGet(childNode)
          .default(SortedSet[])
          .set(parentNode)
      };
      for (edge in acc.subtypingEdges) {
        !subtypingEdges = subtypingEdges.set(edge)
      };
      for (kv in acc.cfgs.items()) {
        (cgNode, cfg) = kv;
        !cfgs = cfgs.set(cgNode, cfg)
      };
      for (kv in acc.typeClaims.items()) {
        (cgNode, funTypeClaims) = kv;
        !typeClaims = typeClaims.set(cgNode, funTypeClaims)
      }
    };
    TCResults{
      errors => errors.toArray(),
      warnings => warnings.toArray(),
      callgraph => SortedMap::createFromIterator(
        callgraph.items().map(kv -> (kv.i0, Array::createFromItems(kv.i1))),
      ),
      classHierarchy,
      subtypingEdges,
      cfgs,
      typeClaims,
    }
  }
}

mutable class TCResultsAcc private {
  errorHandling: ErrorHandling,
  errors: mutable Vector<Error> = mutable Vector[],
  warnings: mutable Vector<Error> = mutable Vector[],
  callgraph: mutable Vector<(CGNode, CGNodes)> = mutable Vector[],
  classHierarchy: mutable Vector<(Class, Class)> = mutable Vector[],
  mutable subtypingEdges: SortedSet<(CGNode, CGNode)> = SortedSet[],
  mutable cfgs: SortedMap<CGNode, CFG> = SortedMap[],
  mutable typeClaims: SortedMap<CGNode, FunTypeClaims> = SortedMap[],
} {
  static fun mcreate{errorHandling: ErrorHandling}: mutable this {
    mutable static{errorHandling}
  }

  readonly fun chill(): this {
    static{
      errorHandling => this.errorHandling,
      errors => this.errors.chill(),
      warnings => this.warnings.chill(),
      callgraph => this.callgraph.chill(),
      classHierarchy => this.classHierarchy.chill(),
      subtypingEdges => this.subtypingEdges,
      cfgs => this.cfgs,
      typeClaims => this.typeClaims,
    }
  }

  fun mclone(): mutable this {
    mutable static{
      errorHandling => this.errorHandling,
      errors => Vector::mcreateFromItems(this.errors),
      warnings => Vector::mcreateFromItems(this.warnings),
      callgraph => Vector::mcreateFromItems(this.callgraph),
      classHierarchy => Vector::mcreateFromItems(this.classHierarchy),
      subtypingEdges => this.subtypingEdges,
      cfgs => this.cfgs,
      typeClaims => this.typeClaims,
    }
  }

  mutable fun error(
    messages: Array<(PosRange, String)>,
    code: ErrorCode,
  ): void {
    this.errorHandling match {
    | EHKeepGoing() -> this.errors.push(NamingError(messages, code))
    | EHBacktrace()
    | EHDefault() ->
      fatalError(messages, code)
    }
  }

  // A non-fatal diagnostic. Unlike `error`, this does not branch on the
  // error-handling mode and never throws: warnings are always collected and
  // never abort the current definition. Kept in a separate `warnings` list so
  // they can be reported without failing the build.
  mutable fun warning(
    messages: Array<(PosRange, String)>,
    code: ErrorCode,
  ): void {
    this.warnings.push(NamingError(messages, code))
  }

  mutable fun subtypingError(
    subst: readonly Subst,
    tenv: TEnv,
    messages: Array<(PosRange, String)>,
    stErr: STErrorOnTType,
    code: ErrorCode,
  ): void {
    this.errorHandling match {
    | EHKeepGoing() ->
      this.errors.push(
        SubtypingError(subst.saveAll(), tenv, messages, stErr, code),
      )
    | EHBacktrace()
    | EHDefault() ->
      subtypingError(subst, tenv, messages, stErr, code)
    }
  }

  mutable fun notSupported(pos: PosRange, what: String): void {
    this.error(
      Array[(pos, `${what} is not supported by SKJS (ignored)`)],
      SKJSCode(9050),
    )
  }

  mutable fun collectErrors(f: () -> void): void {
    this.errorHandling match {
    | EHKeepGoing() -> catchError(f).each(this.errors.push)
    | EHBacktrace()
    | EHDefault() ->
      f()
    }
  }

  mutable fun recordCalls(caller: CGNode, newCallees: CGNodes): void {
    this.callgraph.push((caller, newCallees));
  }

  mutable fun recordClassHierarchy{child: Class, parent: Class}: void {
    this.classHierarchy.push((child, parent))
  }

  mutable fun recordSubtypingEdge(sub: CGNode, sup: CGNode): void {
    this.!subtypingEdges = this.subtypingEdges.set((sub, sup))
  }
}

module end;
