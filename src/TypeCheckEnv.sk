/***************************************************************************/
/* The mutable environment used by the type-checker. */
/***************************************************************************/

module SKJS;

mutable class TCEnv private (
  context: mutable SKStore.Context,
  subst: mutable Subst,
  mutable callingContext: CGNode,
  localObjects: mutable Map<String, ?TType> = mutable Map[],
  usedObjects: mutable Map<String, PosRange> = mutable Map[],
  private mutable counter: Int = 0,
) {
  static fun mcreate(
    context: mutable SKStore.Context,
    subst: mutable Subst,
    callingContext: CGNode,
  ): mutable this {
    mutable static(context, subst, callingContext)
  }

  private mutable fun next(): Int {
    this.!counter = this.counter + 1;
    this.counter
  }

  mutable fun mcreateSubScope{
    scope: mutable Scope,
    isLoop: Bool,
  }: mutable Scope {
    scope.sub{id => this.next(), isLoop}
  }
}

module end;
