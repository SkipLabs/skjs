/**
 * Variadic constructor pattern support: infer tuple rest params from call-site arguments.
 *
 * Motivating example:
 *
 *   type DepSafe = string | number | object;
 *   interface Collection {
 *     map<Params extends readonly DepSafe[]>(
 *       mapper: new (...params: Params) => { process(): void },
 *       ...params: Params
 *     ): void;
 *   }
 *
 *   class Two { constructor(_p1: string, _p2: number) {} process(): void {} }
 *
 *   declare const coll: Collection;
 *   coll.map(Two, "hello", 42);
 *
 * Here `Params` is a generic rest type variable constrained by `readonly DepSafe[]`.
 * At the call site `coll.map(Two, "hello", 42)`, we infer `Params = [string, number]`
 * from the trailing arguments.
 */

module SKJS;

class VariadicTyping() {
  // Finds the most specific fixed-length tuple type that spreadParam is a
  // subtype of. Returns the element types, or None.
  //
  // Precondition: spreadParam is normalized — all unions and
  // intersections (TInter) have been eagerly computed during normalize().
  // This guarantees at most one clause with a tuple after expansion.
  //
  // Two paths:
  //   1. Expand to clauses (resolves type aliases and tvar bindings) and
  //      look for a tuple in the single clause.
  //   2. Fallback for bound tvars: expandToClauses intersects the binding
  //      with constraints, which can hide the tuple (e.g. [string, number]
  //      & readonly DepSafe[] loses the tuple shape). Peek the raw binding
  //      (without constraint intersection) and retry.
  // INVARIANT: when this function returns None, subst is unchanged.
  static fun resolveSpreadToTuple(
    subst: mutable Subst,
    tenv: TEnv,
    spreadParam: ?ArrayType,
  ): ?Array<TType> {
    fullType = spreadParam match {
    | Some(ATFullType(ft)) -> ft
    | _ -> return None()
    };
    saved = subst.save();
    // Expand (resolves type aliases, applies tvar bindings + constraints)
    clauses = fullType.expandToClauses(subst, tenv, Contravariant());
    clauses.getSingleTuple() match {
    | Some(TTuple(tupleElts, _)) -> return Some(tupleElts)
    | None() -> void
    };
    // Fallback: for a bound tvar, expandToClauses intersects the binding
    // with constraints, which can hide the tuple. Peek the raw binding
    // (without constraint intersection) and try again.
    tvar = fullType.getSingleVar() match {
    | Some(tv) -> tv
    | None() ->
      subst.restore(saved);
      return None()
    };
    boundType = subst.peekRaw(tvar) match {
    | Some(bt) -> bt
    | None() ->
      subst.restore(saved);
      return None()
    };
    boundType
      .expandToClauses(subst, tenv, Contravariant())
      .getSingleTuple() match {
    | Some(TTuple(tupleElts, _)) -> Some(tupleElts)
    | None() ->
      subst.restore(saved);
      None()
    }
  }

  // Infers and binds an unbound generic rest type variable from call-site arguments.
  //
  // For `coll.map(Two, "hello", 42)` with `...params: Params` where
  // `Params extends readonly DepSafe[]`:
  //   - totalSize = 1 (the `mapper` param), args = [Two, "hello", 42]
  //   - Trailing args after totalSize: ["hello", 42]
  //   - Infers Params = [string, number] (a tuple)
  //   - Checks constraint: [string, number] <: readonly DepSafe[] (succeeds)
  //   - Binds Params to [string, number] in the substitution
  //
  // When call-site includes an unknown-length spread (moreArgs is Some),
  // infers ReadonlyArray<U> instead of a tuple since exact shape is unknown.
  //
  // Returns true if inference fails constraints (call is invalid).
  static fun inferRestTypeVar(
    tcenv: mutable TCEnv,
    tenv: TEnv,
    pos: PosRange,
    spreadParam: ?ArrayType,
    totalSize: Int,
    args: readonly Vector<TType>,
    moreArgs: ?TType,
  ): Bool {
    subst = tcenv.subst;
    spreadParam match {
    | Some(ATFullType(fullType)) ->
      fullType.getSingleVar() match {
      | Some(tvar) if (subst.isUnbound(tvar)) ->
        inferred = moreArgs match {
        | Some(tailElt0) ->
          // Unknown-length tail: infer ReadonlyArray<U> where U = union of all rest args.
          tailElt = tailElt0;
          for (i in Range(totalSize, args.size())) {
            !tailElt = TType::union(subst, tenv, tailElt, args[i])
          };
          TType::inst(Name(pos, "ReadonlyArray"), TArgs(Array[tailElt]))
        | None() ->
          // No tail: infer an exact tuple (including empty tuple for zero rest args).
          restArgTypes = args.slice(totalSize);
          TType::tuple(pos, restArgTypes.toArray(), true)
        };
        saved = subst.save();
        subst.grow(tenv, tvar, inferred, Contravariant());
        for (cstr in tvar.constraints) {
          TType::isSub(subst, tenv, inferred, cstr) match {
          | STOk() -> void
          | stErr @ STErrorOnTType _ ->
            subst.restore(saved);
            tcenv.error(
              Array[
                (
                  pos,
                  `Invalid call. Inferred rest arguments ${inferred} do not satisfy the constraint`,
                ),
                (cstr.pos, `Constraint ${cstr}`),
              ],
              Some(stErr),
            );
            return true
          }
        };
        false
      | _ -> false
      }
    | _ -> false
    }
  }

  // Validates rest arguments against the expected rest shape after param checking.
  //
  // For `coll.map(Two, "hello", 42)` with `...params: Params` bound to `[string, number]`:
  //   - totalSize = 1 (the `mapper` param), args = [Two, "hello", 42]
  //   - knownRest = ["hello": string, 42: number] (args after fixed params)
  //   - Resolves spread to tuple [string, number], checks element-wise:
  //     "hello" <: string (ok), 42 <: number (ok)
  //
  // For tuple-rest, enforces exact arity and rejects unknown-length tails:
  //   - `coll.map(Two, "hello")` => error: expects 2 rest args, got 1
  //   - `coll.map(Two, ...arr)` where arr is unknown-length => error
  //
  // For array-rest (non-tuple), checks each rest arg against the element type.
  static fun checkRestArgs(
    tcenv: mutable TCEnv,
    tenv: TEnv,
    pos: PosRange,
    spreadParam: ?ArrayType,
    totalSize: Int,
    args: readonly Vector<TType>,
    moreArgs: ?TType,
  ): void {
    spreadParam match {
    | None() ->
      // No rest param: allow extra ignored arguments.
      void
    | Some(spreadType) ->
      knownRest = args.slice(totalSize);

      static::resolveSpreadToTuple(tcenv.subst, tenv, Some(spreadType)) match {
      | Some(tupleElts) ->
        // Exact tuple-rest: reject unknown-length tail, enforce exact arity,
        // then element-wise subtype check.
        if (moreArgs is Some(_)) {
          tcenv.error(
            Array[
              (
                pos,
                "Invalid call. Tuple rest parameters require exact arguments",
              ),
              (
                spreadType.getPos(),
                "This call includes an unknown-length spread argument",
              ),
            ],
          )
        } else if (knownRest.size() < tupleElts.size()) {
          tcenv.error(
            Array[
              (pos, "Invalid call"),
              (
                spreadType.getPos(),
                `This function has ${totalSize + tupleElts.size()} parameters`,
              ),
            ],
          )
        } else {
          for (i in Range(0, tupleElts.size())) {
            TType::isSub(tcenv.subst, tenv, knownRest[i], tupleElts[i]) match {
            | STOk() -> void
            | err @ STErrorOnTType _ ->
              tcenv.error(Array[(pos, "Invalid argument")], Some(err))
            }
          }
        }
      | None() ->
        // Array-rest (or array-like) validation: check each rest arg against the
        // element type.
        spreadType.maybeGetEltType(tcenv.subst, tenv, Contravariant()) match {
        | Some(eltType) ->
          for (restArg in knownRest) {
            TType::isSub(tcenv.subst, tenv, restArg, eltType) match {
            | STOk() -> void
            | err @ STErrorOnTType _ ->
              tcenv.error(Array[(pos, "Invalid argument")], Some(err))
            }
          };
          moreArgs.each(ma -> {
            TType::isSub(tcenv.subst, tenv, ma, eltType) match {
            | STOk() -> void
            | err @ STErrorOnTType _ ->
              tcenv.error(Array[(pos, "Invalid argument")], Some(err))
            }
          })
        | None() ->
          tcenv.error(
            Array[
              (pos, "Invalid call. Unexpected type for ..."),
              (spreadType.getPos(), `${spreadType} is not an array`),
            ],
          )
        }
      }
    }
  }

  // Handles tuple-to-array subtyping: [T1, T2] <: ReadonlyArray<U>.
  //
  // For `[string, number] <: readonly DepSafe[]`:
  //   - Checks rhs is array-like (has a "length" field)
  //   - Builds U = string | number
  //   - Checks ReadonlyArray<string | number> <: readonly DepSafe[] (succeeds)
  //
  // ReadonlyArray is covariant, so this correctly allows:
  //   [Dog, Dog] <: readonly Animal[]  (covariant element type)
  // And correctly rejects:
  //   [Dog, Dog] <: Animal[]  (ReadonlyArray is not a subtype of mutable Array)
  //
  // Returns Some(result) if this is a tuple-to-array case, None() otherwise.
  static fun tupleToArraySubtyping(
    subst: mutable Subst,
    tenv: TEnv,
    clauses1: Clauses,
    rhs: TType,
  ): ?STResult<TType> {
    // Check if lhs is a single tuple
    tuple = clauses1.getSingleTuple() match {
    | None() -> return None()
    | Some(tuple) -> tuple
    };
    // Cheap array-like trigger: check if rhs has a "length" field.
    // This is just a gate — correctness comes from ReadonlyArray<U> <: rhs below.
    rhsClauses = rhs.expandToClauses(subst, tenv, Contravariant());
    hasLength = rhsClauses.getSTypes(subst, tenv) match {
    | Some(stypes) ->
      stypes.singleElt() match {
      | Some(obj @ TObject(_, _, _)) ->
        obj.getAllFields().any(fields -> fields.maybeGet("length") is Some _)
      | _ -> false
      }
    | _ -> false
    };
    if (!hasLength) return None();

    // Build U = union of tuple element types, then check ReadonlyArray<U> <: rhs.
    pos = tuple.pos;
    u = TType::unionN(subst, tenv, pos, tuple.tuple);
    readonlyArray = TType::inst(Name(pos, "ReadonlyArray"), TArgs(Array[u]));
    Some(TType::isSub(subst, tenv, readonlyArray, rhs))
  }

  // Checks that a rest parameter's type variable constraint uses ReadonlyArray.
  // Rest parameters are inherently readonly, so mutable Array constraints are
  // unsound and must be rejected at the declaration site.
  static fun checkRestParamReadonly(
    tcenvb: mutable TCEnvBase,
    tenv: TEnv,
    restPos: PosRange,
    paramType: Type,
    tparams: Array<TypeParam>,
  ): void {
    paramType.value match {
    | TAInst(tparamName, targs) if (targs.isEmpty()) ->
      tparams
        .find(tp -> tp.name.value == tparamName.value)
        .each(tp -> {
          tp.constraint.each(cstr -> {
            isDirectMutableArray = cstr.value match {
            | TAArray _ -> true
            | TAInst(Name(_, "Array"), _) -> true
            | _ -> false
            };
            subst = Subst::mcreate(tcenvb);
            normalizedCstr = tenv.normalize(tcenvb, cstr);
            resolvedCstr = normalizedCstr.insts.getUnique() match {
            | Some(TSInst(name, cstrTArgs)) ->
              tenv.instantiate(subst, name, cstrTArgs)
            | _ -> normalizedCstr
            };
            isExpandedMutableArray = resolvedCstr.insts.getUnique() match {
            | Some(TSInst(Name(_, "Array"), _)) -> true
            | _ -> false
            };
            isMutableArray = isDirectMutableArray || isExpandedMutableArray;
            if (isMutableArray) {
              tcenvb.error(
                Array[
                  (
                    restPos,
                    "Rest parameter constraint must use ReadonlyArray (or 'readonly T[]'), since rest parameters are readonly",
                  ),
                  (cstr.pos, "This constraint uses a mutable Array type"),
                ],
              )
            }
          })
        })
    | _ -> void
    }
  }
}

module end;
