/**
 * Variadic constructor pattern support: infer tuple rest params from call-site arguments.
 *
 * Motivating example:
 *
 *   type DepSafe = string | number | object;
 *   interface Collection {
 *     map<Params extends readonly DepSafe[]>(
 *       mapper: new (...params: Params) => { process(): void },
 *       ...params: Params
 *     ): void;
 *   }
 *
 *   class Two { constructor(_p1: string, _p2: number) {} process(): void {} }
 *
 *   declare const coll: Collection;
 *   coll.map(Two, "hello", 42);
 *
 * Here `Params` is a generic rest type variable constrained by `readonly DepSafe[]`.
 * At the call site `coll.map(Two, "hello", 42)`, we infer `Params = [string, number]`
 * from the trailing arguments.
 */

module SKJS;

// A call consumes either an exact tuple contract or a homogeneous rest element
// contract. The types may stay symbolic. resolveCallRestShape establishes its
// inspected dependencies before returning; this datatype alone is not evidence.
base class RestCallShape {
  children =
  | RCSFixed(Array<TType>)
  | RCSArray(TType)
}

class VariadicTyping() {
  // Resolve a fixed rest shape only after establishing every candidate payload
  // inspected to obtain it. The callback receives only restricted read operations;
  // successful reads are pinned in the owner by withCommittedReadContext before
  // tuple elements escape. Symbolic element candidates remain available for
  // ordinary argument inference unless the shape computation inspected them.
  // This is an optional tuple query. A consumer that RETAINS the decision not
  // to flatten must use resolveSubtypeRestTuple instead. Call checking uses
  // the combined tuple/array boundary below.
  // None leaves the owning substitution unchanged; it does not mean that the
  // type is disjoint from every tuple, only that this operation established none.
  static fun resolveSpreadToTuple(
    subst: mutable Subst,
    tenv: TEnv,
    spreadParam: ?TType,
  ): ?Array<TType> {
    spreadParam match {
    | None() -> None()
    | Some(fullType) ->
      subst.withCommittedReadContext(tenv, context ->
        context.spreadTuple(fullType)
      ) match {
      | TRReady(tupleElts) -> Some(tupleElts)
      | TRUnavailable() -> None()
      // Unknown is not evidence for the array-rest fallback: that fallback
      // forgets exact arity. Refuse rather than silently weaken the contract.
      | TRBlocked() -> static::blockedRestShape(fullType.pos)
      }
    }
  }

  // Function subtyping first decides which rests to flatten, then checks
  // positional parameters, then projects the remaining target rest element.
  // The "no fixed tuple" decision must survive those intervening checks.
  // Returning None from an OPTIONAL observation would discard its read set.
  // Here None is instead the value of a successful decision, so its inspected
  // outer bindings are established too. This does not claim disjointness from
  // all tuples or prove that the remaining type is an array.
  static fun resolveSubtypeRestTuple(
    subst: mutable Subst,
    tenv: TEnv,
    spreadParam: ?TType,
  ): ?Array<TType> {
    spreadParam match {
    | None() -> None()
    | Some(fullType) ->
      subst.withCommittedReadDecision<?Array<TType>>(tenv, context ->
        context.spreadTuple(fullType)
      ) match {
      | TRReady(tupleElts) -> tupleElts
      // The callback produces a decision even when no tuple was found.
      | TRUnavailable() ->
        invariant_violation("A rest-layout decision cannot be unavailable")
      | TRBlocked() -> static::blockedRestShape(fullType.pos)
      }
    }
  }

  // Use at the actual element-consumption point, not while choosing the tuple
  // layout. In function subtyping, positional checks can infer a symbolic
  // element before the target-side projection. Preserve that ordering while
  // establishing every payload the eventual projection does inspect.
  static fun resolveRestElementType(
    subst: mutable Subst,
    tenv: TEnv,
    fullType: TType,
    variance: Variance,
  ): ?TType {
    subst.withCommittedReadContext<TType>(tenv, context ->
      context.restElement(fullType, variance)
    ) match {
    | TRReady(element) -> Some(element)
    | TRUnavailable() -> None()
    | TRBlocked() -> static::blockedRestShape(fullType.pos)
    }
  }

  static private fun blockedRestShape<T>(pos: PosRange): T {
    fatalError(
      Array[
        (
          pos,
          "A fixed rest-parameter shape could not be established without changing inference; add an explicit tuple or rest-parameter type annotation",
        ),
      ],
      SKJSCode(9036),
    )
  }

  // The call-side array fallback also materializes a type. Observing only the
  // tuple attempt is insufficient: TRUnavailable intentionally commits nothing,
  // so a subsequent unobserved element projection would lose its own read set.
  // Select the representation and project its members in ONE transaction. A
  // tuple result never falls through to the homogeneous-array interpretation.
  static fun resolveCallRestShape(
    subst: mutable Subst,
    tenv: TEnv,
    fullType: TType,
  ): ?RestCallShape {
    subst.withCommittedReadContext<RestCallShape>(tenv, context -> {
      context.spreadTuple(fullType) match {
      | Some(tupleElts) -> Some(RCSFixed(tupleElts))
      | None() ->
        // Preserve the original call-side variance. During observation candidate
        // get reads fixed payloads without growth/sealing in either direction.
        // Returning an element candidate does not itself inspect its payload.
        context.restElement(fullType, Contravariant()).map(element ->
          RCSArray(element)
        )
      }
    }) match {
    | TRReady(shape) -> Some(shape)
    | TRUnavailable() -> None()
    | TRBlocked() -> static::blockedRestShape(fullType.pos)
    }
  }

  // Infers and binds an unbound generic rest type variable from call-site arguments.
  //
  // For `coll.map(Two, "hello", 42)` with `...params: Params` where
  // `Params extends readonly DepSafe[]`:
  //   - totalSize = 1 (the `mapper` param), args = [Two, "hello", 42]
  //   - Trailing args after totalSize: ["hello", 42]
  //   - Infers Params = [string, number] (a tuple)
  //   - Checks constraint: [string, number] <: readonly DepSafe[] (succeeds)
  //   - Binds Params to [string, number] in the substitution
  //
  // When call-site includes an unknown-length spread (moreArgs is Some),
  // infers ReadonlyArray<U> instead of a tuple since exact shape is unknown.
  //
  // Returns true if inference fails constraints (call is invalid).
  static fun inferRestTypeVar(
    tcenv: mutable TCEnv,
    tenv: TEnv,
    pos: PosRange,
    spreadParam: ?TType,
    totalSize: Int,
    args: readonly Vector<TType>,
    moreArgs: ?TType,
  ): Bool {
    subst = tcenv.subst;
    spreadParam match {
    | Some(fullType) ->
      fullType.getSingleVar() match {
      | Some(tvar) ->
        // A tracing read cannot run in a match guard.
        if (!subst.isUnbound(tvar)) return false;
        inferred = moreArgs match {
        | Some(tailElt0) ->
          // Unknown-length tail: infer ReadonlyArray<U> where U = union of all rest args.
          tailElt = tailElt0;
          for (i in Range(totalSize, args.size())) {
            !tailElt = TType::union(subst, tenv, tailElt, args[i])
          };
          TType::inst(Name(pos, "ReadonlyArray"), TArgs(Array[tailElt]))
        | None() ->
          // No tail: infer an exact tuple (including empty tuple for zero rest args).
          restArgTypes = args.slice(totalSize);
          TType::tuple(pos, restArgTypes.toArray(), true)
        };
        saved = subst.save();
        subst.grow(tenv, tvar, inferred, Contravariant());
        for (cstr in tvar.constraints) {
          TType::isSub(subst, tenv, inferred, cstr) match {
          | STOk() -> void
          | stErr @ STErrorOnTType _ ->
            subst.restore(saved);
            tcenv.subtypingError(
              subst,
              tenv,
              Array[
                (
                  pos,
                  `The inferred rest arguments ${tenv.ppType(
                    tcenv,
                    inferred,
                  )} do not satisfy the rest parameter's constraint`,
                ),
                (cstr.pos, `Constraint ${tenv.ppType(tcenv, cstr)}`),
              ],
              stErr,
              TSCode(2344),
            );
            return true
          }
        };
        false
      | None() -> false
      }
    | None() -> false
    }
  }

  // Validates rest arguments against the expected rest shape after param checking.
  //
  // For `coll.map(Two, "hello", 42)` with `...params: Params` bound to `[string, number]`:
  //   - totalSize = 1 (the `mapper` param), args = [Two, "hello", 42]
  //   - knownRest = ["hello": string, 42: number] (args after fixed params)
  //   - Resolves spread to tuple [string, number], checks element-wise:
  //     "hello" <: string (ok), 42 <: number (ok)
  //
  // For tuple-rest, enforces exact arity and rejects unknown-length tails:
  //   - `coll.map(Two, "hello")` => error: expects 2 rest args, got 1
  //   - `coll.map(Two, ...arr)` where arr is unknown-length => error
  //
  // For array-rest (non-tuple), checks each rest arg against the element type.
  static fun checkRestArgs(
    tcenv: mutable TCEnv,
    tenv: TEnv,
    pos: PosRange,
    spreadParam: ?TType,
    totalSize: Int,
    args: readonly Vector<TType>,
    moreArgs: ?TType,
  ): void {
    spreadParam match {
    | None() ->
      // No rest param: allow extra ignored arguments.
      void
    | Some(spreadType) ->
      knownRest = args.slice(totalSize);

      static::resolveCallRestShape(tcenv.subst, tenv, spreadType) match {
      | Some(RCSFixed(tupleElts)) ->
        // Exact tuple-rest: reject unknown-length tail, enforce exact arity,
        // then element-wise subtype check.
        if (moreArgs is Some(_)) {
          tcenv.error(
            Array[
              (
                pos,
                "A tuple rest parameter requires an exact number of arguments",
              ),
              (
                spreadType.pos,
                "This call includes an unknown-length spread argument",
              ),
            ],
            SKJSCode(2047),
          )
        } else if (knownRest.size() < tupleElts.size()) {
          tcenv.error(
            Array[
              (pos, "Too many arguments for this call"),
              (
                spreadType.pos,
                `This function has ${totalSize + tupleElts.size()} parameters`,
              ),
            ],
            TSCode(2554),
          )
        } else {
          for (i in Range(0, tupleElts.size())) {
            TType::isSub(tcenv.subst, tenv, knownRest[i], tupleElts[i]) match {
            | STOk() -> void
            | err @ STErrorOnTType _ ->
              tcenv.subtypingError(
                tcenv.subst,
                tenv,
                Array[
                  (pos, "Argument is not assignable to the parameter's type"),
                ],
                err,
                TSCode(2345),
              )
            }
          }
        }
      | Some(RCSArray(eltType)) ->
        // Projection is already committed. Argument subtyping still runs in
        // the live owner so uninspected symbolic elements can be inferred.
        for (restArg in knownRest) {
          TType::isSub(tcenv.subst, tenv, restArg, eltType) match {
          | STOk() -> void
          | err @ STErrorOnTType _ ->
            tcenv.subtypingError(
              tcenv.subst,
              tenv,
              Array[
                (pos, "Argument is not assignable to the parameter's type"),
              ],
              err,
              TSCode(2345),
            )
          }
        };
        moreArgs.each(ma -> {
          TType::isSub(tcenv.subst, tenv, ma, eltType) match {
          | STOk() -> void
          | err @ STErrorOnTType _ ->
            tcenv.subtypingError(
              tcenv.subst,
              tenv,
              Array[
                (pos, "Argument is not assignable to the parameter's type"),
              ],
              err,
              TSCode(2345),
            )
          }
        })
      | None() ->
        tcenv.error(
          Array[
            (pos, "A spread argument ('...') must be of an array type"),
            (
              spreadType.pos,
              `${tenv.ppType(tcenv, spreadType)} is not an array`,
            ),
          ],
          SKJSCode(2045),
        )
      }
    }
  }

  // Checks that a rest parameter's type variable constraint uses ReadonlyArray.
  // Rest parameters are inherently readonly, so mutable Array constraints are
  // unsound and must be rejected at the declaration site.
  static fun checkRestParamReadonly(
    tcenvb: mutable TCEnvBase,
    tenv: TEnv,
    restPos: PosRange,
    paramType: Type,
    tparams: Array<TypeParam>,
  ): void {
    paramType.value match {
    | TAInst(tparamName, targs) if (targs.isEmpty()) ->
      tparams
        .find(tp -> tp.name.value == tparamName.value)
        .each(tp -> {
          tp.constraint.each(cstr -> {
            isDirectMutableArray = cstr.value match {
            | TAArray _ -> true
            | TAInst(Name(_, "Array"), _) -> true
            | _ -> false
            };
            subst = Subst::mcreate(tcenvb);
            normalizedCstr = tenv.normalize(tcenvb, cstr);
            resolvedCstr = normalizedCstr.insts.getUnique() match {
            | Some(TSInst(name, cstrTArgs)) ->
              tenv.instantiate(subst, subst, name, cstrTArgs)
            | _ -> normalizedCstr
            };
            isExpandedMutableArray = resolvedCstr.insts.getUnique() match {
            | Some(TSInst(Name(_, "Array"), _)) -> true
            | _ -> false
            };
            isMutableArray = isDirectMutableArray || isExpandedMutableArray;
            if (isMutableArray) {
              tcenvb.error(
                Array[
                  (
                    restPos,
                    "A rest parameter's constraint must use ReadonlyArray (or 'readonly T[]'), since rest parameters are readonly",
                  ),
                  (cstr.pos, "This constraint uses a mutable Array type"),
                ],
                SKJSCode(2048),
              )
            }
          })
        })
    | _ -> void
    }
  }
}

module end;
