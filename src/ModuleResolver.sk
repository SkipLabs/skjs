/***************************************************************************/
/* Module performing the module name resolution for SKJS. */
/***************************************************************************/

module alias S = SKStore;

module SKJS;

/***************************************************************************/
// Primitives used to manipulate file names, directory names etc ...
/***************************************************************************/

fun splitPath(dirNameStr: String): Array<String> {
  dirNameStr.splitIterator("/").filter(x -> x != "" && x != ".").collect(Array)
}

trait DirName(path: Array<String>) extends Show

value class DRelative uses DirName, Hashable, XXHashable, Orderable {
  static fun create(dirNameStr: String): DRelative {
    invariant(
      Path.isRelative(dirNameStr),
      "Trying to create a relative directory from an absolute path",
    );
    DRelative(splitPath(dirNameStr))
  }

  fun toString(): String {
    if (this.path.isEmpty()) return "";
    this.path.join("/") + "/"
  }
}

class DAbsolute extends S.File uses DirName, Orderable, Hashable, XXHashable {
  static fun create(dirNameStr: String): DAbsolute {
    DAbsolute(splitPath(Path.resolve(dirNameStr)))
  }

  fun toString(): String {
    if (this.path.size() == 0) return "/";
    "/" + this.path.join("/") + "/"
  }

  fun isRoot(): Bool {
    this.path.size() <= 0
  }

  fun basename(): String {
    if (this.path.size() <= 0) {
      ""
    } else {
      this.path[this.path.size() - 1]
    }
  }

  fun parent(): this {
    path = this.path.slice(0, -1);
    static(path)
  }

  fun +(other: FRelative): FAbsolute {
    FAbsolute(this / other.dirName, other.baseName)
  }

  fun /(other: DRelative): this {
    result = Vector::mcreateFromItems(this.path);
    for (elt in other.path) {
      if (elt == "..") {
        result.maybePop() match {
        | None() ->
          internal_error(
            `Invalid path: ${static(this.path.concat(other.path))}`,
          )
        | Some(_) -> continue
        }
      };
      result.push(elt)
    };
    static(result.toArray())
  }
}

trait FileNameBase<D: DirName>(dirName: D, baseName: String) {
  fun toString(): String {
    `${this.dirName}${this.baseName}`
  }
}

class FAbsolute
  extends S.Key
  uses FileNameBase<DAbsolute>, Hashable, XXHashable {
  const nil: FAbsolute = FAbsolute(DAbsolute(Array[]), "");

  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    vec = splitPath(Path.resolve(fileName));
    path = vec.slice(0, vec.size() - 1);
    dirName = DAbsolute(path);
    baseName = vec[vec.size() - 1];
    FAbsolute(dirName, baseName)
  }

  fun toString from FileNameBase;
}

value class FRelative uses
  FileNameBase<DRelative>,
  Hashable,
  XXHashable,
  Orderable,
{
  const nil: FRelative = FRelative(DRelative(Array[]), "");

  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    invariant(
      Path.isRelative(fileName),
      "Trying to create a relative file from an absolute path",
    );
    vec = splitPath(fileName);
    path = vec.slice(0, vec.size() - 1);
    dirName = DRelative(path);
    baseName = vec[vec.size() - 1];
    FRelative(dirName, baseName)
  }
}

/***************************************************************************/
// RootId identifies which root a relative path is measured from.
// Encoded as: 0 = project root, N>0 = import-stubs[N-1].
/***************************************************************************/
class RootId private (value: Int) extends S.Key uses Hashable, XXHashable {
  const project: RootId = RootId(0);

  static fun stub(index: Int): this {
    static(index + 1)
  }

  fun isProject(): Bool {
    this.value == 0
  }

  fun xxhash(): XXHash {
    this.value.xxhash()
  }

  fun hash(): Int {
    this.value.hash()
  }

  fun compare(other: S.Key): Order {
    other match {
    | o @ RootId _ -> this.value.compare(o.value)
    | _ -> invariant_violation("RootId comparison to non-RootId Key")
    }
  }
}

/***************************************************************************/
// RootMap: maps RootId -> DAbsolute.
// Created once during initialization, read everywhere paths need resolving.
/***************************************************************************/
class RootMap(
  projectRoot: DAbsolute,
  importStubs: Array<DAbsolute>,
  importStubCount: Int = -1,
) {
  fun get(rootId: RootId): DAbsolute {
    if (rootId.isProject()) {
      this.projectRoot
    } else {
      this.importStubs[rootId.value - 1]
    }
  }

  // Stub roots that should participate in bare-import resolution (excludes
  // extra roots registered solely for tsconfig `typeRoots`).
  fun moduleStubs(): Array<DAbsolute> {
    if (this.importStubCount < 0) {
      this.importStubs
    } else {
      this.importStubs.slice(0, this.importStubCount)
    }
  }
}

/***************************************************************************/
// FPath: a file path relative to a known root.
// This is the primary internal file identifier, replacing FAbsolute
// for all internal storage, SKStore keys, and AST positions.
/***************************************************************************/

class FPath(
  rootId: RootId,
  relative: FRelative,
) extends S.Key uses Hashable, XXHashable {
  const nil: FPath = FPath(RootId::project, FRelative::nil);

  static fun create(rootId: RootId, relPath: String): this {
    FPath(rootId, FRelative::create(relPath))
  }

  fun xxhash(): XXHash {
    (this.rootId.value, this.relative).xxhash()
  }

  fun hash(): Int {
    (this.rootId.value, this.relative).hash()
  }

  fun compare(other: S.Key): Order {
    other match {
    | o @ FPath _ ->
      this.rootId.value.compare(o.rootId.value) match {
      | EQ() -> this.relative.compare(o.relative)
      | x -> x
      }
    | _ -> invariant_violation("FPath comparison to non-FPath Key")
    }
  }

  fun toString(): String {
    this.relative.toString()
  }

  fun toAbsolute(rootMap: RootMap): FAbsolute {
    rootMap.get(this.rootId) + this.relative
  }

  fun dirPath(): DPath {
    DPath(this.rootId, this.relative.dirName)
  }
}

// A directory path relative to a known root.
// Analogous to FPath for files — avoids storing absolute directory paths.
value class DPath(rootId: RootId, relative: DRelative) {
  fun toAbsolute(rootMap: RootMap): DAbsolute {
    rootMap.get(this.rootId) / this.relative
  }

  // Resolve a relative module path (e.g. "./foo" or "../bar.ts") to an FPath.
  fun resolveFile(relModName: String): FPath {
    rel = FRelative::create(relModName);
    segs = Vector::mcreateFromItems(this.relative.path);
    for (seg in rel.dirName.path) {
      if (seg == ".." && !segs.isEmpty() && segs[segs.size() - 1] != "..") {
        _ = segs.pop()
      } else {
        segs.push(seg)
      }
    };
    FPath(this.rootId, FRelative(DRelative(segs.toArray()), rel.baseName))
  }
}

/***************************************************************************/
// Resolve a relative import path ("./" or "../"):
//   1. If the path has a JS-like extension (.js, .mjs, .cjs), replace it
//      with the corresponding TS extension (.ts/.tsx/.d.ts, .mts/.d.mts,
//      .cts/.d.cts) and check if the file exists.
//   2. Otherwise, try appending .ts, .tsx, .d.ts to the path.
//   3. If still not found, try treating the path as a directory and look
//      for index.ts, index.tsx, or index.d.ts.
/***************************************************************************/

fun hasJsLikeExtension(name: String): Bool {
  name.endsWith(".js") || name.endsWith(".mjs") || name.endsWith(".cjs")
}

fun isTsFile(fileName: String): Bool {
  fileName.endsWith(".ts") || fileName.endsWith(".tsx")
}

fun hasTsExtension(name: String): Bool {
  name.endsWith(".ts") || name.endsWith(".tsx")
}

fun resolveName(
  fs: Fs,
  cwd: DPath,
  rootMap: RootMap,
  moduleName: String,
): ?FPath {
  if (moduleName == "." || moduleName == "./") {
    print_error("Could not resolve module '.'");
    return None();
  };
  absCwd = cwd.toAbsolute(rootMap);
  absName = absCwd + FRelative::create(moduleName);
  suffix = Path.extname(moduleName);
  // Try a candidate: check absolute path for exists(), return relative FPath.
  tryCandidate = (candidate: String) ~> {
    fpath = cwd.resolveFile(candidate);
    if (fs.exists(fpath.toAbsolute(rootMap).toString())) Some(fpath) else None()
  };
  suffix match {
  | ".ts" | ".tsx" if (fs.exists(absName.toString())) ->
    return Some(cwd.resolveFile(moduleName))
  | ".js" ->
    stripped = moduleName.stripSuffix(suffix);
    for (ext in Array[".ts", ".tsx", ".d.ts"]) {
      tryCandidate(stripped + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  | ".mjs" ->
    stripped = moduleName.stripSuffix(suffix);
    for (ext in Array[".mts", ".d.mts", ".ts", ".d.ts"]) {
      tryCandidate(stripped + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  | ".cjs" ->
    stripped = moduleName.stripSuffix(suffix);
    for (ext in Array[".cts", ".d.cts", ".ts", ".d.ts"]) {
      tryCandidate(stripped + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  | _ ->
    for (ext in Array[
      ".ts",
      ".tsx",
      ".d.ts",
      "/index.ts",
      "/index.tsx",
      "/index.d.ts",
    ]) {
      tryCandidate(moduleName + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  };
  print_error(`Could not find module: ${moduleName}`);
  print_error(`From: ${absCwd}`);
  None()
}

// Match a module name against a tsconfig paths pattern.
// Patterns may contain at most one '*' wildcard.
// Returns the captured wildcard portion, or "" for exact matches.
// Returns None() if no match.
fun matchPathPattern(moduleName: String, pattern: String): ?String {
  if (!pattern.contains("*")) {
    // Exact match
    if (moduleName == pattern) Some("") else None()
  } else {
    parts = pattern.split("*");
    prefix = parts[0];
    suffix = parts[1];
    if (
      moduleName.length() >= prefix.length() + suffix.length() &&
      moduleName.startsWith(prefix) &&
      moduleName.endsWith(suffix)
    ) {
      captured = moduleName.sub(
        moduleName.getIter().forward(prefix.length()),
        moduleName.length() - prefix.length() - suffix.length(),
      );
      Some(captured)
    } else {
      None()
    }
  }
}

// Resolve a module name using tsconfig paths aliases.
// root is the resolved baseUrl directory.
// Returns the first matching file path, or None().
fun resolvePathAlias(
  fs: Fs,
  root: DAbsolute,
  compilerOptions: TsCompilerOptions,
  moduleName: String,
): ?FPath {
  if (compilerOptions.paths.isEmpty()) return None();
  for (pattern => substitutions in compilerOptions.paths) {
    matchPathPattern(moduleName, pattern) match {
    | None() -> void
    | Some(captured) ->
      for (sub in substitutions) {
        resolved = if (sub.contains("*")) {
          sub.replace("*", captured)
        } else {
          sub
        };
        for (ext in Array[
          "",
          ".ts",
          ".tsx",
          ".d.ts",
          "/index.ts",
          "/index.tsx",
          "/index.d.ts",
        ]) {
          relPath = resolved + ext;
          fullPath = Path.resolve(Path.join(root.toString(), relPath));
          if (fs.exists(fullPath)) {
            return Some(FPath::create(RootId::project, relPath))
          }
        }
      }
    }
  };
  None()
}

base class StubResolveResult uses Equality, Show {
  children =
  | StubFound(path: FPath)
  | StubNotFound()
  | StubError(message: String)

  fun toString(): String {
    this match {
    | StubFound(p) -> `StubFound(${p})`
    | StubNotFound() -> "StubNotFound()"
    | StubError(msg) -> `StubError(${msg})`
    }
  }
}

// Check if `relTarget` (relative to `pkgDir`) resolves to a file (not a
// directory) that stays within `boundaryDir` (e.g. the stub or `node_modules`
// directory), trying exact path first and then TS/index extensions (matching
// TypeScript's package.json `types` target resolution). The returned `FPath`
// is measured relative to `rootDir` under `rootId`.
private fun tryPackageTarget(
  fs: Fs,
  rootId: RootId,
  rootDir: DAbsolute,
  boundaryDir: DAbsolute,
  pkgDir: DAbsolute,
  relTarget: String,
): ?FPath {
  boundaryStr = boundaryDir.toString();
  rootStr = rootDir.toString();
  for (ext in Array[
    "",
    ".d.ts",
    ".ts",
    ".tsx",
    "/index.d.ts",
    "/index.ts",
    "/index.tsx",
  ]) {
    candidate = relTarget + ext;
    if (candidate == "" || candidate.endsWith("/")) continue;
    absPath = Path.resolve(Path.join(pkgDir.toString(), candidate));
    // Reject paths escaping the stub / node_modules directory (e.g. "../../outside.d.ts").
    if (!absPath.startsWith(boundaryStr)) continue;
    if (fs.exists(absPath) && !fs.isDirectory(absPath)) {
      relToRoot = Path.relativeTo{path => absPath, base => rootStr};
      return Some(FPath::create(rootId, relToRoot))
    }
  };
  // If target ends with a JS extension (e.g. "./lib/foo.js" in exports `default`),
  // map it to its sibling TS declaration/source file (matches TS behavior).
  if (hasJsLikeExtension(relTarget)) {
    suffix = Path.extname(relTarget);
    stripped = relTarget.stripSuffix(suffix);
    exts = suffix match {
    | ".mjs" -> Array[".d.mts", ".mts", ".d.ts", ".ts"]
    | ".cjs" -> Array[".d.cts", ".cts", ".d.ts", ".ts"]
    | _ -> Array[".d.ts", ".ts", ".tsx"]
    };
    for (ext in exts) {
      candidate = stripped + ext;
      absPath = Path.resolve(Path.join(pkgDir.toString(), candidate));
      if (!absPath.startsWith(rootStr)) continue;
      if (fs.exists(absPath) && !fs.isDirectory(absPath)) {
        relToRoot = Path.relativeTo{path => absPath, base => rootStr};
        return Some(FPath::create(rootId, relToRoot))
      }
    }
  };
  None()
}

// Split a bare module specifier into `(packageName, subpathKey)`:
//   - "foo"             -> ("foo", ".")
//   - "foo/bar/baz"     -> ("foo", "./bar/baz")
//   - "@scope/pkg"      -> ("@scope/pkg", ".")
//   - "@scope/pkg/sub"  -> ("@scope/pkg", "./sub")
fun splitBarePackageSpecifier(moduleName: String): ?(String, String) {
  parts = moduleName.split("/");
  if (parts.isEmpty() || parts[0] == "") return None();
  if (parts[0].startsWith("@")) {
    if (parts.size() < 2 || parts[1] == "") return None();
    pkgName = `${parts[0]}/${parts[1]}`;
    subpath = if (parts.size() == 2) {
      "."
    } else {
      "./" + parts.slice(2, parts.size()).join("/")
    };
    Some((pkgName, subpath))
  } else {
    pkgName = parts[0];
    subpath = if (parts.size() == 1) {
      "."
    } else {
      "./" + parts.slice(1, parts.size()).join("/")
    };
    Some((pkgName, subpath))
  }
}

// Extract a string target from a package.json `exports` target value.
// Follows condition objects by checking `"types"` first, then `"default"`,
// recursing into nested condition objects (e.g. `{ "import": { "types": ... } }`
// is intentionally out of scope per #611, only `types` and `default`).
private fun resolveExportTarget(val: JSON.Value): ?String {
  val match {
  | JSON.String(s) -> Some(s)
  | JSON.Null() -> None()
  | JSON.Array(arr) ->
    for (item in arr) {
      resolveExportTarget(item) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    };
    None()
  | obj @ JSON.Object _ ->
    for (cond in Array["types", "default"]) {
      obj.maybeGet(cond) match {
      | Some(v) ->
        resolveExportTarget(v) match {
        | some @ Some(_) -> return some
        | None() -> void
        }
      | None() -> void
      }
    };
    None()
  | _ -> None()
  }
}

// Look up `subpathKey` (e.g. ".", "./utils", "./sub/helper") in a package.json
// `exports` value. Returns:
//   - Some(targetString) if matched and a `types`/`default` target was found
//   - None() if the subpath is not exported (or maps to null / no matching target)
private fun lookupExportsEntry(
  exportsVal: JSON.Value,
  subpathKey: String,
): ?String {
  exportsVal match {
  | JSON.String(_)
  | JSON.Array(_) ->
    if (subpathKey == ".") resolveExportTarget(exportsVal) else None()
  | obj @ JSON.Object _ ->
    // Distinguish a subpath map (keys starting with ".") from a shorthand
    // condition object for "." (e.g. { "types": "./index.d.ts" }).
    isSubpathMap = obj.value.keys().any(k -> k.startsWith("."));
    if (!isSubpathMap) {
      if (subpathKey == ".") resolveExportTarget(obj) else None()
    } else {
      // 1. Exact subpath match.
      obj.maybeGet(subpathKey) match {
      | Some(entry) -> return resolveExportTarget(entry)
      | None() -> void
      };
      // 2. Pattern match (keys containing a single '*'), preferring longest
      //    matching prefix (matches Node/TS exports pattern specificity).
      bestPrefixLen = -1;
      bestTarget: ?String = None();
      for (pattern => entry in obj.value) {
        if (!pattern.contains("*")) continue;
        matchPathPattern(subpathKey, pattern) match {
        | Some(captured) ->
          prefixLen = pattern.split("*")[0].length();
          if (prefixLen > bestPrefixLen) {
            resolveExportTarget(entry) match {
            | Some(rawTarget) ->
              !bestPrefixLen = prefixLen;
              !bestTarget = Some(
                if (rawTarget.contains("*")) {
                  rawTarget.replace("*", captured)
                } else {
                  rawTarget
                },
              )
            | None() -> void
            }
          }
        | None() -> void
        }
      };
      bestTarget
    }
  | _ -> None()
  }
}

// Resolve a bare package `moduleName` (which may include a subpath such as
// `"pkg/utils"` or `"@scope/pkg/sub"`) inside `searchDir` (a stub root or a
// `<ancestor>/node_modules` directory). Resolved files are returned as `FPath`s
// relative to `rootDir` under `rootId` (`rootDir` equals `searchDir` for
// `--import-stubs` roots, and `projectRoot` when walking nested `node_modules/`
// under the project).
// Order:
//   1. If `<pkg>/package.json` exists:
//      a. If `exports` is present, it is authoritative (allowlist): resolve
//         the subpath through `exports` (`types` then `default`), and if not
//         defined return `StubError("Package subpath '...' is not defined by 'exports'...")`
//         without falling back to `types` or `index.*`.
//      b. Otherwise, for root imports (subpath `.`), read `types` then `typings`.
//   2. For root imports without `exports`: `<pkg>/index.d.ts`, `<pkg>/index.ts`,
//      `<pkg>/index.tsx`.
//   3. For subpath imports without `exports`: `<pkg>/<subpath>` via `tryPackageTarget`.
fun resolvePackageInDir(
  fs: Fs,
  rootId: RootId,
  rootDir: DAbsolute,
  searchDir: DAbsolute,
  moduleName: String,
): StubResolveResult {
  (pkgName, subpathKey) = splitBarePackageSpecifier(moduleName) match {
  | Some(pair) -> pair
  | None() -> return StubNotFound()
  };
  pkgRel = DRelative::create(pkgName);
  pkgDir = searchDir / pkgRel;
  pkgJsonPath = FAbsolute(pkgDir, "package.json").toString();

  if (fs.exists(pkgJsonPath) && !fs.isDirectory(pkgJsonPath)) {
    raw = fs.readTextFile(pkgJsonPath);
    pkgObjRes: Result<JSON.Object, String> = try {
      Success(JSON.decode(raw).expectObject())
    } catch {
    | e @ JSON.JSONError _ ->
      Failure(`Invalid package.json for module '${pkgName}': ${e.getMessage()}`)
    | e @ JSON.InvalidJSONError _ ->
      Failure(`Invalid package.json for module '${pkgName}': ${e.getMessage()}`)
    | e -> throw e
    };
    pkgObj = pkgObjRes match {
    | Success(obj) -> obj
    | Failure(msg) -> return StubError(msg)
    };
    pkgObj.maybeGet("exports") match {
    | Some(exportsVal) ->
      lookupExportsEntry(exportsVal, subpathKey) match {
      | Some(target) if (target != "") ->
        tryPackageTarget(fs, rootId, rootDir, searchDir, pkgDir, target) match {
        | Some(fpath) -> return StubFound(fpath)
        | None() ->
          return StubError(
            `Package subpath '${subpathKey}' in '${pkgName}' resolved to missing target '${target}'`,
          )
        }
      | _ ->
        return StubError(
          `Package subpath '${subpathKey}' is not defined by 'exports' in '${pkgName}/package.json'`,
        )
      }
    | None() -> void
    };
    if (subpathKey == ".") {
      typesField = pkgObj.maybeGet("types") match {
      | Some(JSON.String(s)) -> Some(s)
      | _ ->
        pkgObj.maybeGet("typings") match {
        | Some(JSON.String(s)) -> Some(s)
        | _ -> None()
        }
      };
      typesField match {
      | Some(target) if (target != "") ->
        tryPackageTarget(fs, rootId, rootDir, searchDir, pkgDir, target) match {
        | Some(fpath) -> return StubFound(fpath)
        | None() -> void
        }
      | _ -> void
      }
    }
  };

  rootStr = rootDir.toString();
  if (subpathKey == ".") {
    for (entry in Array["index.d.ts", "index.ts", "index.tsx"]) {
      path = FAbsolute(pkgDir, entry);
      pathStr = path.toString();
      if (fs.exists(pathStr) && !fs.isDirectory(pathStr)) {
        relToRoot = Path.relativeTo{path => pathStr, base => rootStr};
        return StubFound(FPath::create(rootId, relToRoot))
      }
    };
    StubNotFound()
  } else {
    tryPackageTarget(fs, rootId, rootDir, searchDir, pkgDir, subpathKey) match {
    | Some(fpath) -> StubFound(fpath)
    | None() -> StubNotFound()
    }
  }
}

// Map a bare package name to its DefinitelyTyped `@types/` package name:
//   - "foo"        -> Some("@types/foo")
//   - "@scope/pkg" -> Some("@types/scope__pkg")
//   - "@types/..." -> None() (already a @types package)
fun atTypesPackageName(moduleName: String): ?String {
  if (moduleName.startsWith("@types/")) return None();
  if (moduleName.startsWith("@")) {
    rest = moduleName.stripPrefix("@");
    parts = rest.split("/");
    if (parts.size() == 2 && parts[0] != "" && parts[1] != "") {
      Some(`@types/${parts[0]}__${parts[1]}`)
    } else {
      None()
    }
  } else if (moduleName != "" && !moduleName.contains("/")) {
    Some(`@types/${moduleName}`)
  } else {
    None()
  }
}

// Whether `dir` is equal to `ancestor` or a subdirectory of it.
fun isDirWithin(dir: DAbsolute, ancestor: DAbsolute): Bool {
  dir.toString().startsWith(ancestor.toString())
}

// Whether `fpath` points inside a `node_modules/` directory (any path segment
// named `"node_modules"`). Used to treat project-local `node_modules/` files
// as import-target dependencies rather than user source files to typecheck.
fun isInNodeModules(fpath: FPath): Bool {
  fpath.relative.dirName.path.any(seg -> seg == "node_modules")
}

// Walk ancestor directories starting from `fromDir` up to `rootMap.projectRoot`
// (inclusive), checking `<ancestor>/node_modules/<moduleName>` at each level
// and short-circuiting on the first `StubFound` or `StubError`.
//
// Bound: the walk stops at `rootMap.projectRoot` (rather than the filesystem
// root) for predictability and because SKStore only loads files under the
// project root and explicit `--import-stubs` roots. When an ancestor's
// `node_modules` directory matches an entry in `rootMap.importStubs` (e.g.
// `<projectRoot>/node_modules`), resolution uses that `RootId::stub(i)` so the
// returned `FPath` matches the loaded stub key. Otherwise it uses
// `RootId::project` relative to `projectRoot`.
fun resolveNodeModulesWalk(
  fs: Fs,
  fromDir: DPath,
  rootMap: RootMap,
  moduleName: String,
): StubResolveResult {
  projectRoot = rootMap.projectRoot;
  absDir = fromDir.toAbsolute(rootMap);
  if (!isDirWithin(absDir, projectRoot)) {
    return StubNotFound()
  };

  nodeModulesRel = DRelative::create("node_modules");
  cur = absDir;
  loop {
    nmDir = cur / nodeModulesRel;
    if (fs.isDirectory(nmDir.toString())) {
      // If this node_modules dir is also an explicit import-stubs root,
      // resolve under that stub RootId so the FPath matches its loaded key.
      (rootId, rootDir) = {
        matched: ?(RootId, DAbsolute) = None();
        for (i => stubDir in rootMap.importStubs) {
          if (stubDir == nmDir) {
            !matched = Some((RootId::stub(i), stubDir));
            break void
          }
        };
        matched.default((RootId::project, projectRoot))
      };
      resolvePackageInDir(fs, rootId, rootDir, nmDir, moduleName) match {
      | found @ StubFound _ -> return found
      | err @ StubError _ -> return err
      | StubNotFound() -> void
      }
    };
    if (cur == projectRoot || cur.isRoot()) {
      break void
    };
    !cur = cur.parent()
  };
  StubNotFound()
}

private fun resolveStubsDirect(
  fs: Fs,
  importStubs: Array<DAbsolute>,
  moduleName: String,
): StubResolveResult {
  res: ?FPath = None();
  firstErr: ?String = None();
  for (i => importStub in importStubs) {
    resolvePackageInDir(
      fs,
      RootId::stub(i),
      importStub,
      importStub,
      moduleName,
    ) match {
    | StubFound(fpath) ->
      res match {
      | Some(existing) ->
        print_error(
          `Found more than one import stub for module '${moduleName}': ${existing} and ${fpath}`,
        );
        throw Exit(2)
      | None() -> !res = Some(fpath)
      }
    | StubError(msg) ->
      if (firstErr.isNone()) {
        !firstErr = Some(msg)
      }
    | StubNotFound() -> void
    }
  };
  res match {
  | Some(fpath) -> StubFound(fpath)
  | None() ->
    firstErr match {
    | Some(msg) -> StubError(msg)
    | None() -> StubNotFound()
    }
  }
}

fun resolveStubs(
  fs: Fs,
  importStubs: Array<DAbsolute>,
  moduleName: String,
): StubResolveResult {
  resolveStubsDirect(fs, importStubs, moduleName) match {
  | StubNotFound() ->
    atTypesPackageName(moduleName) match {
    | Some(dtPkg) -> resolveStubsDirect(fs, importStubs, dtPkg)
    | None() -> StubNotFound()
    }
  | other -> other
  }
}

// Resolve a bare module specifier:
//   1. Walk `<ancestor>/node_modules/<moduleName>` from `fromDir` up to
//      `rootMap.projectRoot` (first match wins).
//   2. Fall back to flat `--import-stubs` lookup so non-`node_modules` stub
//      directories continue to work unchanged. Only actual import-stub roots
//      participate (rootMap.moduleStubs()), not extra roots registered solely
//      for tsconfig `typeRoots` — those are ambient-only.
fun resolveBareModule(
  fs: Fs,
  fromDir: DPath,
  rootMap: RootMap,
  moduleName: String,
): StubResolveResult {
  resolveNodeModulesWalk(fs, fromDir, rootMap, moduleName) match {
  | found @ StubFound _ -> found
  | err @ StubError _ -> err
  | StubNotFound() -> resolveStubs(fs, rootMap.moduleStubs(), moduleName)
  }
}

module end;
