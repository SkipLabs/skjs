/***************************************************************************/
/* Module performing the module name resolution for SKJS. */
/***************************************************************************/

module alias S = SKStore;

module SKJS;

/***************************************************************************/
// Primitives used to manipulate file names, directory names etc ...
/***************************************************************************/

fun splitPath(dirNameStr: String): Array<String> {
  dirNameStr.splitIterator("/").filter(x -> x != "" && x != ".").collect(Array)
}

fun removeDotDot(path: Array<String>): Array<String> {
  result = mutable Vector<String>[];
  for (elt in path) {
    if (elt == "..") {
      result.maybePop() match {
      | None() -> internal_error("Invalid path: " + path)
      | Some(_) -> continue
      }
    };
    result.push(elt)
  };
  result.toArray();
}

base class DirName final (path: Array<String>) uses Show {
  children =
  | DRelative
  | DAbsolute

  fun +(other: FRelative): FileName {
    FileName(this / other.dirName, other.baseName)
  }

  fun /(other: DRelative): this {
    this match {
    | DRelative(d1) -> static(d1.concat(other.path))
    | DAbsolute(d1) -> static(removeDotDot(d1.concat(other.path)))
    }
  }

  fun toString(): String {
    if (this.path.size() == 0) return "/";
    "/" + this.path.join("/") + "/"
  }

  fun endsWith(str: String): Bool {
    if (str == "") internal_error("str should not be empty");
    this.path.size() > 0 && this.path[this.path.size() - 1] == str
  }

  fun exists(): Bool {
    FileSystem.exists(this.toString())
  }

  fun resolve(): DAbsolute {
    this match {
    | d @ DAbsolute _ -> d
    | d @ DRelative _ ->
      DAbsolute::create(d.toString()) // TODO: optimize
    }
  }

  fun basename(): String {
    if (this.path.size() <= 0) {
      ""
    } else {
      this.path[this.path.size() - 1]
    }
  }

  fun parent(): this {
    path = this.path.slice(0, -1);
    static(path)
  }
}

extension class DRelative {
  static fun create(dirNameStr: String): DRelative {
    invariant(Path.isRelative(dirNameStr));
    DRelative(splitPath(dirNameStr))
  }

  const node_modules: this = DRelative::create("node_modules");
}

extension class DAbsolute extends S.Key {
  static fun create(dirNameStr: String): DAbsolute {
    DAbsolute(splitPath(Path.resolve(dirNameStr)))
  }

  fun isRoot(): Bool {
    this.path.size() <= 0
  }

  fun allAncestors(): mutable Iterator<DAbsolute> {
    while (!this.isRoot()) {
      !this = this.parent();
      yield this
    }
  }

  fun toString from DirName;
}

base class FileNameBase<D: DirName>(dirName: D, baseName: String) {
  fun toString(): String {
    `${this.dirName}${this.baseName}`
  }

  fun exists(): Bool {
    FileSystem.exists(this.toString())
  }
}

class FileName extends FileNameBase<DirName> {
  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    vec = splitPath(fileName);
    path = vec.slice(0, vec.size() - 1);
    dirName = if (fileName.startsWith("/")) {
      DAbsolute(path)
    } else {
      DRelative(path)
    };
    baseName = vec[vec.size() - 1];
    FileName(dirName, baseName)
  }

  fun resolve(): FAbsolute {
    FAbsolute(this.dirName.resolve(), this.baseName)
  }
}

class FAbsolute extends FileNameBase<DAbsolute>, S.Key {
  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    vec = splitPath(Path.resolve(fileName));
    path = vec.slice(0, vec.size() - 1);
    dirName = DAbsolute(path);
    baseName = vec[vec.size() - 1];
    FAbsolute(dirName, baseName)
  }

  fun toString from FileNameBase;
}

class FRelative extends FileNameBase<DRelative> {
  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    invariant(Path.isRelative(fileName));
    vec = splitPath(fileName);
    path = vec.slice(0, vec.size() - 1);
    dirName = DRelative(path);
    baseName = vec[vec.size() - 1];
    FRelative(dirName, baseName)
  }
}

/***************************************************************************/
/* Class to help lookup file names quickly. */
/***************************************************************************/

class FileNameEntry(
  invertedName: String,
  name: String,
) extends S.File uses Orderable {
  static fun create(fileName: String): this {
    inv = mutable Vector[];
    chars = fileName.chars();
    for (i in Range(0, chars.size())) {
      inv.push(chars[chars.size() - i - 1]);
    };
    static(String::fromChars(inv.toArray()), fileName)
  }

  fun compare(other: FileNameEntry): Order {
    this.invertedName.compare(other.invertedName)
  }
}

class NodeModuleDir(entries: Array<FileNameEntry>) extends S.File {
  fun lookup(fileName: FileName): ?FileName {
    fileNameStr = fileName.toString();
    if (fileNameStr.contains("..")) {
      internal_error(
        `File name '${fileNameStr}' is not expected to contain '..'`,
      )
    };
    entry = FileNameEntry::create(fileNameStr);
    idx = SKStore.binSearch(
      i ~> this.entries[i].invertedName,
      entry.invertedName,
      0,
      this.entries.size() - 1,
    );
    if (idx < 0 || idx >= this.entries.size()) return None();
    if (this.entries[idx].invertedName.startsWith(entry.invertedName)) {
      return Some(FileName::create(this.entries[idx].name))
    };
    None();
  }
}

class FileNameIndex private (modules: S.EHandle<S.SID, NodeModuleDir>) {
  static fun create(
    context: mutable S.Context,
    fileNames: S.EHandle<FAbsolute, S.StringFile>,
  ): this {
    static(
      fileNames
        .map(
          S.SID::keyType,
          FileNameEntry::type,
          context,
          S.DirName::create("/skjs/file/index/"),
          (_context, writer, fileName, _valueIter) ~> {
            for (ancestor in fileName.dirName.allAncestors()) {
              if (ancestor.endsWith("node_modules")) {
                modulePath = ancestor.toString();
                writer.set(
                  S.SID(modulePath),
                  FileNameEntry::create(fileName.toString()),
                );
                return void
              }
            }
          },
        )
        .map(
          S.SID::keyType,
          NodeModuleDir::type,
          context,
          S.DirName::create("/skjs/node_modules/index/"),
          (_context, writer, key, valueIter) ~> {
            writer.set(key, NodeModuleDir(valueIter.toArray().sorted()))
          },
        ),
    )
  }

  fun lookup(
    context: mutable S.Context,
    dir: DirName,
    file: FileName,
  ): ?FileName {
    dir match {
    | DRelative _ -> internal_error("path should be DAbsolute")
    | path @ DAbsolute _ ->
      for (ancestor in path.allAncestors()) {
        this.modules.maybeGet(
          context,
          S.SID((ancestor / DRelative::node_modules).toString()),
        ) match {
        | None() -> continue
        | Some(mod) ->
          mod.lookup(file) match {
          | None() -> void
          | x @ Some(_) -> return x
          }
        }
      };
      None()
    }
  }
}

/***************************************************************************/
// Given an import statement in a TypeScript file: 1. Determine the
// import path from the import statement.  2. Resolve the module
// according to the following steps:

//     a. If the import path is a relative path (starts with "./" or
//         "../"): i. Try appending ".ts", ".tsx", ".d.ts" to the path
//         and check if the file exists.  ii. If the file does not exist,
//         try treating the path as a directory and look for an
//         "index.ts", "index.tsx", or "index.d.ts" file in that
//         directory.

//     b. If the import path is a non-relative module name: i. Look in
//         the nearest node_modules directory.  ii. Travel up the
//         directory tree and look into each node_modules directory until
//         the root of the file system is reached.  iii. In each
//         node_modules directory, attempt to find the module. For a
//         module named "Example", look for
//         "Example.d.ts". If not found, it then looks for a package.json
//         file in the "Example" directory, and reads the "typings" or
//         "types" field to determine the path to the declaration file.
//         iv. If the package.json does not specify a "typings" or
//         "types" field, try to find an "index.d.ts" file
//         in the module's root directory.
/***************************************************************************/

fun resolveName(
  context: mutable S.Context,
  index: FileNameIndex,
  root: DAbsolute,
  cwd: DirName,
  moduleName: String,
): ?FileName {
  if (moduleName.endsWith("-js")) {
    !moduleName = moduleName.stripSuffix("-js");
  };
  isAbsolute = Path.isAbsolute(moduleName);
  if (isAbsolute || moduleName.startsWith(".")) {
    if (moduleName == "." || moduleName == "./") {
      print_error("Could not resolve module '.'");
      return None();
    };
    fullName = if (isAbsolute) {
      FileName::create(moduleName)
    } else {
      cwd + FRelative::create(moduleName)
    };
    suffix = Path.extname(moduleName);
    suffix match {
    | ".ts" | ".tsx" if (fullName.exists()) -> return Some(fullName)
    | ".js" | ".mjs" ->
      stripped = fullName.baseName.stripSuffix(suffix);
      for (ext in Array[".ts", ".tsx", ".d.ts"]) {
        tryPath = fullName with {baseName => stripped + ext};
        if (tryPath.exists()) return Some(tryPath)
      };
      print_error(`Could not find file: ${fullName}`);
      print_error(`From: ${cwd}`)
    | _ ->
      if (!isAbsolute) {
        for (ext in Array[".d.ts", "/index.d.ts", "/index.cjs"]) {
          tryPath = cwd + FRelative::create(moduleName + ext);
          if (tryPath.exists()) return Some(tryPath)
        }
      };
      print_error(`Could not find module[3]: ${moduleName}`);
      print_error(`From: ${cwd}`)
    };
    return None()
  };

  for (prepost in Array[
    ("./@types/", "/index.d.ts"),
    ("./@types/node/", ".d.ts"),
  ]) {
    tryPath = FileName::create(prepost.i0 + moduleName + prepost.i1);
    index.lookup(context, root, tryPath) match {
    | None() -> void
    | x @ Some _ -> return x
    }
  };

  if (moduleName.contains(":")) {
    requireTypesPath =
      root +
      FRelative::create(
        "./node_modules/@types/" + moduleName.split(":").join("/") + ".d.ts",
      );
    debug(requireTypesPath.toString());
    index.lookup(context, cwd, requireTypesPath) match {
    | x @ Some _ -> return x
    | _ ->
      print_error(`Could not find module[2]: ${moduleName}`);
      print_error(`From: ${cwd}`)
    };
    return None();
  };

  for (ext in Array[
    "/index.d.ts",
    "/dist/index.d.ts",
    "/dist/types/types.d.ts",
    "/types/index.d.ts",
    "/typing/index.d.ts",
  ]) {
    index.lookup(context, cwd, FileName::create(moduleName + ext)) match {
    | None() -> void
    | x @ Some _ -> return x
    }
  };

  index.lookup(
    context,
    cwd,
    FileName::create(moduleName.replace("/", ".").replace("@", "") + ".d.ts"),
  ) match {
  | None() -> void
  | x @ Some _ -> return x
  };

  //  if (moduleName.contains("/")) {
  index.lookup(context, cwd, FileName::create(moduleName + ".d.ts")) match {
  | None() -> void
  | x @ Some _ -> return x
  };
  index.lookup(
    context,
    cwd,
    FileName::create(moduleName + "/index.cjs"),
  ) match {
  | None() -> void
  | x @ Some _ -> return x
  };
  //  };

  debug(`Could not find module[1]: ${moduleName}`);
  None()
}

fun resolveStubs(
  importStubs: Array<DAbsolute>,
  moduleName: String,
): ?FAbsolute {
  res: ?FAbsolute = None();
  for (importStub in importStubs) {
    path = FAbsolute(importStub / DRelative::create(moduleName), "index.d.ts");
    if (path.exists()) {
      res match {
      | Some(existing) ->
        debug(
          `Found at least 2 stubs with name ${moduleName}: ${existing} and {path}`,
        )
      | None() -> !res = Some(path)
      }
    }
  };
  res
}

module end;
