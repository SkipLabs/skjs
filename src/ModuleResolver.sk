/***************************************************************************/
/* Module performing the module name resolution for SKJS. */
/***************************************************************************/

module alias S = SKStore;

module SKJS;

/***************************************************************************/
// Primitives used to manipulate file names, directory names etc ...
/***************************************************************************/

fun splitPath(dirNameStr: String): Array<String> {
  dirNameStr.splitIterator("/").filter(x -> x != "" && x != ".").collect(Array)
}

trait DirName(path: Array<String>) extends Show

value class DRelative uses DirName, Hashable, XXHashable, Orderable {
  static fun create(dirNameStr: String): DRelative {
    invariant(
      Path.isRelative(dirNameStr),
      "Trying to create a relative directory from an absolute path",
    );
    DRelative(splitPath(dirNameStr))
  }

  fun toString(): String {
    if (this.path.isEmpty()) return "";
    this.path.join("/") + "/"
  }
}

class DAbsolute extends S.File uses DirName, Orderable, Hashable, XXHashable {
  static fun create(dirNameStr: String): DAbsolute {
    DAbsolute(splitPath(Path.resolve(dirNameStr)))
  }

  fun toString(): String {
    if (this.path.size() == 0) return "/";
    "/" + this.path.join("/") + "/"
  }

  fun isRoot(): Bool {
    this.path.size() <= 0
  }

  fun basename(): String {
    if (this.path.size() <= 0) {
      ""
    } else {
      this.path[this.path.size() - 1]
    }
  }

  fun parent(): this {
    path = this.path.slice(0, -1);
    static(path)
  }

  fun +(other: FRelative): FAbsolute {
    FAbsolute(this / other.dirName, other.baseName)
  }

  fun /(other: DRelative): this {
    result = Vector::mcreateFromItems(this.path);
    for (elt in other.path) {
      if (elt == "..") {
        result.maybePop() match {
        | None() ->
          internal_error(
            `Invalid path: ${static(this.path.concat(other.path))}`,
          )
        | Some(_) -> continue
        }
      };
      result.push(elt)
    };
    static(result.toArray())
  }
}

trait FileNameBase<D: DirName>(dirName: D, baseName: String) {
  fun toString(): String {
    `${this.dirName}${this.baseName}`
  }
}

class FAbsolute
  extends S.Key
  uses FileNameBase<DAbsolute>, Hashable, XXHashable {
  const nil: FAbsolute = FAbsolute(DAbsolute(Array[]), "");

  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    vec = splitPath(Path.resolve(fileName));
    path = vec.slice(0, vec.size() - 1);
    dirName = DAbsolute(path);
    baseName = vec[vec.size() - 1];
    FAbsolute(dirName, baseName)
  }

  fun toString from FileNameBase;

  fun exists(): Bool {
    FileSystem.exists(this.toString())
  }
}

value class FRelative uses
  FileNameBase<DRelative>,
  Hashable,
  XXHashable,
  Orderable,
{
  const nil: FRelative = FRelative(DRelative(Array[]), "");

  static fun create(fileName: String): this {
    if (fileName.endsWith("/")) {
      internal_error(`File name '${fileName}' is not expected to end with /`)
    };
    invariant(
      Path.isRelative(fileName),
      "Trying to create a relative file from an absolute path",
    );
    vec = splitPath(fileName);
    path = vec.slice(0, vec.size() - 1);
    dirName = DRelative(path);
    baseName = vec[vec.size() - 1];
    FRelative(dirName, baseName)
  }
}

/***************************************************************************/
// RootId identifies which root a relative path is measured from.
// Encoded as: 0 = project root, N>0 = import-stubs[N-1].
/***************************************************************************/
class RootId private (value: Int) extends S.Key uses Hashable, XXHashable {
  const project: RootId = RootId(0);

  static fun stub(index: Int): this {
    static(index + 1)
  }

  fun isProject(): Bool {
    this.value == 0
  }

  fun xxhash(): XXHash {
    this.value.xxhash()
  }

  fun hash(): Int {
    this.value.hash()
  }

  fun compare(other: S.Key): Order {
    other match {
    | o @ RootId _ -> this.value.compare(o.value)
    | _ -> invariant_violation("RootId comparison to non-RootId Key")
    }
  }
}

/***************************************************************************/
// RootMap: maps RootId -> DAbsolute.
// Created once during initialization, read everywhere paths need resolving.
/***************************************************************************/
class RootMap(projectRoot: DAbsolute, importStubs: Array<DAbsolute>) {
  fun get(rootId: RootId): DAbsolute {
    if (rootId.isProject()) {
      this.projectRoot
    } else {
      this.importStubs[rootId.value - 1]
    }
  }
}

/***************************************************************************/
// FPath: a file path relative to a known root.
// This is the primary internal file identifier, replacing FAbsolute
// for all internal storage, SKStore keys, and AST positions.
/***************************************************************************/

class FPath(
  rootId: RootId,
  relative: FRelative,
) extends S.Key uses Hashable, XXHashable {
  const nil: FPath = FPath(RootId::project, FRelative::nil);

  static fun create(rootId: RootId, relPath: String): this {
    FPath(rootId, FRelative::create(relPath))
  }

  fun xxhash(): XXHash {
    (this.rootId.value, this.relative).xxhash()
  }

  fun hash(): Int {
    (this.rootId.value, this.relative).hash()
  }

  fun compare(other: S.Key): Order {
    other match {
    | o @ FPath _ ->
      this.rootId.value.compare(o.rootId.value) match {
      | EQ() -> this.relative.compare(o.relative)
      | x -> x
      }
    | _ -> invariant_violation("FPath comparison to non-FPath Key")
    }
  }

  fun toString(): String {
    this.relative.toString()
  }

  fun toAbsolute(rootMap: RootMap): FAbsolute {
    rootMap.get(this.rootId) + this.relative
  }

  fun dirPath(): DPath {
    DPath(this.rootId, this.relative.dirName)
  }
}

// A directory path relative to a known root.
// Analogous to FPath for files — avoids storing absolute directory paths.
value class DPath(rootId: RootId, relative: DRelative) {
  fun toAbsolute(rootMap: RootMap): DAbsolute {
    rootMap.get(this.rootId) / this.relative
  }

  // Resolve a relative module path (e.g. "./foo" or "../bar.ts") to an FPath.
  fun resolveFile(relModName: String): FPath {
    rel = FRelative::create(relModName);
    segs = Vector::mcreateFromItems(this.relative.path);
    for (seg in rel.dirName.path) {
      if (seg == ".." && !segs.isEmpty() && segs[segs.size() - 1] != "..") {
        _ = segs.pop()
      } else {
        segs.push(seg)
      }
    };
    FPath(this.rootId, FRelative(DRelative(segs.toArray()), rel.baseName))
  }
}

/***************************************************************************/
// Resolve a relative import path ("./" or "../"):
//   1. If the path has a JS-like extension (.js, .mjs, .cjs), replace it
//      with the corresponding TS extension (.ts/.tsx/.d.ts, .mts/.d.mts,
//      .cts/.d.cts) and check if the file exists.
//   2. Otherwise, try appending .ts, .tsx, .d.ts to the path.
//   3. If still not found, try treating the path as a directory and look
//      for index.ts, index.tsx, or index.d.ts.
/***************************************************************************/

fun hasJsLikeExtension(name: String): Bool {
  name.endsWith(".js") || name.endsWith(".mjs") || name.endsWith(".cjs")
}

fun isTsFile(fileName: String): Bool {
  fileName.endsWith(".ts") || fileName.endsWith(".tsx")
}

fun hasTsExtension(name: String): Bool {
  name.endsWith(".ts") || name.endsWith(".tsx")
}

fun resolveName(cwd: DPath, rootMap: RootMap, moduleName: String): ?FPath {
  if (moduleName == "." || moduleName == "./") {
    print_error("Could not resolve module '.'");
    return None();
  };
  absCwd = cwd.toAbsolute(rootMap);
  absName = absCwd + FRelative::create(moduleName);
  suffix = Path.extname(moduleName);
  // Try a candidate: check absolute path for exists(), return relative FPath.
  tryCandidate = (candidate: String) ~> {
    fpath = cwd.resolveFile(candidate);
    if (fpath.toAbsolute(rootMap).exists()) Some(fpath) else None()
  };
  suffix match {
  | ".ts" | ".tsx" if (absName.exists()) ->
    return Some(cwd.resolveFile(moduleName))
  | ".js" ->
    stripped = moduleName.stripSuffix(suffix);
    for (ext in Array[".ts", ".tsx", ".d.ts"]) {
      tryCandidate(stripped + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  | ".mjs" ->
    stripped = moduleName.stripSuffix(suffix);
    for (ext in Array[".mts", ".d.mts", ".ts", ".d.ts"]) {
      tryCandidate(stripped + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  | ".cjs" ->
    stripped = moduleName.stripSuffix(suffix);
    for (ext in Array[".cts", ".d.cts", ".ts", ".d.ts"]) {
      tryCandidate(stripped + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  | _ ->
    for (ext in Array[
      ".ts",
      ".tsx",
      ".d.ts",
      "/index.ts",
      "/index.tsx",
      "/index.d.ts",
    ]) {
      tryCandidate(moduleName + ext) match {
      | some @ Some(_) -> return some
      | None() -> void
      }
    }
  };
  print_error(`Could not find module: ${moduleName}`);
  print_error(`From: ${absCwd}`);
  None()
}

// Match a module name against a tsconfig paths pattern.
// Patterns may contain at most one '*' wildcard.
// Returns the captured wildcard portion, or "" for exact matches.
// Returns None() if no match.
fun matchPathPattern(moduleName: String, pattern: String): ?String {
  if (!pattern.contains("*")) {
    // Exact match
    if (moduleName == pattern) Some("") else None()
  } else {
    parts = pattern.split("*");
    prefix = parts[0];
    suffix = parts[1];
    if (
      moduleName.length() >= prefix.length() + suffix.length() &&
      moduleName.startsWith(prefix) &&
      moduleName.endsWith(suffix)
    ) {
      captured = moduleName.sub(
        moduleName.getIter().forward(prefix.length()),
        moduleName.length() - prefix.length() - suffix.length(),
      );
      Some(captured)
    } else {
      None()
    }
  }
}

// Resolve a module name using tsconfig paths aliases.
// root is the resolved baseUrl directory.
// Returns the first matching file path, or None().
fun resolvePathAlias(
  root: DAbsolute,
  compilerOptions: TsCompilerOptions,
  moduleName: String,
): ?FPath {
  if (compilerOptions.paths.isEmpty()) return None();
  for (pattern => substitutions in compilerOptions.paths) {
    matchPathPattern(moduleName, pattern) match {
    | None() -> void
    | Some(captured) ->
      for (sub in substitutions) {
        resolved = if (sub.contains("*")) {
          sub.replace("*", captured)
        } else {
          sub
        };
        for (ext in Array[
          "",
          ".ts",
          ".tsx",
          ".d.ts",
          "/index.ts",
          "/index.tsx",
          "/index.d.ts",
        ]) {
          relPath = resolved + ext;
          fullPath = Path.resolve(Path.join(root.toString(), relPath));
          if (FileSystem.exists(fullPath)) {
            return Some(FPath::create(RootId::project, relPath))
          }
        }
      }
    }
  };
  None()
}

fun resolveStubs(importStubs: Array<DAbsolute>, moduleName: String): ?FPath {
  res: ?FPath = None();
  for (i => importStub in importStubs) {
    path = FAbsolute(importStub / DRelative::create(moduleName), "index.d.ts");
    if (path.exists()) {
      fpath = FPath::create(RootId::stub(i), moduleName + "/index.d.ts");
      res match {
      | Some(existing) ->
        debug(
          `Found at least 2 stubs with name ${moduleName}: ${existing} and ${path}`,
        )
      | None() -> !res = Some(fpath)
      }
    }
  };
  res
}

module end;
