/**
 * Delayed array literal typing: defers tuple vs array choice until use-site.
 *
 * ## Overview
 *
 * When an array literal [e1, e2, ...] is encountered, we defer the decision of
 * whether it should be typed as a tuple or an array. The literal is assigned a
 * fresh type variable α (the "commitment variable") and remembers its element
 * types. Later, when the literal is used in a context requiring a specific type,
 * we "commit" α to either Array<U> or Tuple[...].
 *
 * ## Notation
 *
 * ArrayLit<α, elts> represents a delayed literal with:
 *   - α: the commitment type variable (uncommitted when unbound)
 *   - elts: the precise element types from the literal
 *
 * Commitment states:
 *   - Uncommitted: α is unbound, literal can still become array or tuple
 *   - ArrayLit<Array<U>, elts>: α bound to Array<U>, committed as array
 *   - ArrayLit<Tuple[...], elts>: α bound to Tuple[...], committed as tuple
 *
 * ## Key Operations
 *
 * 1. typeFromLiteral: Creates ArrayLit<α, elts> with fresh α
 * 2. expand: Returns committed type if bound, else defaults to Tuple[elts...]
 * 3. refineForArrayUse: Commits to Array when array-like indexing is used
 * 4. subtyping: Handles ArrayLit on LHS or RHS of subtype checks
 *
 * ## Subtyping Rules
 *
 * When checking u1 <: u2 where one side is an uncommitted ArrayLit:
 *
 * Case 1: u1 <: ArrayLit<α, elts> (RHS is literal)
 *   → Commit α to Array<union(elts)>, then check u1 <: Array<...>
 *
 * Case 2: ArrayLit<α, elts> <: u2 (LHS is literal)
 *   2a. u2 is unconstrained type variable → commit to Tuple[elts], bind u2
 *   2a'. u2 is constrained type variable → commit to Tuple if constraint contains tuple, else Array
 *   2b. u2 contains Array<U> → commit to Array<union(elts)>
 *   2c. u2 is Tuple[...] → commit to Tuple[elts], check element subtyping
 *
 * ## Fresh Literal Elements
 *
 * An element written as a direct primitive literal (`0`, `'a'`, `-1`, ...)
 * additionally records its precise literal type (TArrayLit.freshElts). The
 * element checks in cases 2b and 2c use the precise type when the target
 * demands literal precision -- it contains a literal type, or is an unbound
 * inference variable whose constraints do -- and the widened element type
 * otherwise. This mirrors how TS fresh literal types widen unless the
 * contextual type includes a literal type: `[[0, 1]]` matches
 * Array<[0, number]>, and under `K extends 0 | 1` the call checks
 * successfully (the precise element satisfies the constraint; K then
 * resolves to the constraint, not to the literal candidate as in TS).
 * Freshness never escapes: every commitment uses the target type or the
 * widened element types.
 *
 * See docs/delayed-array-literal-typing.tex for the formal type theory.
 */

module SKJS;

class ArrayLitTyping() {
  // Returns the single uncommitted ArrayLit in ty, or None if none/committed/multiple.
  static private fun getSingleArrayLitUncommitted(
    subst: mutable Subst,
    tenv: TEnv,
    ty: TType,
  ): ?TArrayLit {
    if (!ty.clauses.isEmpty()) return None();
    ty.insts.getSingleArrayLit() match {
    | Some(arrLit) ->
      ArrayLitTyping::arrayLitCommittedType(subst, tenv, arrLit) match {
      | Some(_) -> None()
      | None() -> Some(arrLit)
      }
    | None() -> None()
    }
  }

  // Returns the type α is committed to, or None if uncommitted.
  static private fun arrayLitCommittedType(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
  ): ?TType {
    subst.peek(tenv, arrLit.tvar)
  }

  // Default type when α is uncommitted: Tuple[...].
  // Used during expansion and when biasing unconstrained type variables.
  static private fun arrayLitDefaultType(arrLit: TArrayLit): TType {
    ArrayLitTyping::arrayLitToTupleType(arrLit)
  }

  // Expands ArrayLit<α, elts> to its committed type, or default if uncommitted.
  static fun expand(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
  ): TType {
    ArrayLitTyping::arrayLitCommittedType(subst, tenv, arrLit) match {
    | Some(ty) -> ty
    | None() -> ArrayLitTyping::arrayLitDefaultType(arrLit)
    }
  }

  // Converts ArrayLit<α, elts> to Tuple[elts...] (mutable, matching TS:
  // `[1, 2]` is a mutable tuple unless `as const` is used).
  static private fun arrayLitToTupleType(arrLit: TArrayLit): TType {
    TType::tuple(arrLit.tvar.pos, arrLit.tupleElts, false)
  }

  // Computes the element type for an array literal by unioning all elements.
  static private fun arrayLitEltType(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
  ): TType {
    eltType = TType::bottom(arrLit.tvar.pos);
    for (elt in arrLit.tupleElts) {
      !eltType = TType::union(subst, tenv, eltType, elt)
    };
    eltType
  }

  // Converts ArrayLit<α, elts> to Array<U> by unioning all elements.
  static private fun arrayLitToArrayTType(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
  ): TType {
    eltType = ArrayLitTyping::arrayLitEltType(subst, tenv, arrLit);
    TType::inst(Name(arrLit.tvar.pos, "Array"), TArgs(Array[eltType]))
  }

  // Commits ArrayLit<α, elts> by binding α to committedTy (irreversible).
  static private fun arrayLitCommitType(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
    committedTy: TType,
  ): void {
    subst.grow(tenv, arrLit.tvar, committedTy, Covariant());
  }

  // Extracts element types from Array<U> or ReadonlyArray<U> instances in ty (handles unions).
  // If ty = Array<U1> | ... | Array<Un>, returns [U1, ..., Un].
  // ReadonlyArray<U> is treated the same way so that array literals can commit
  // to Array<U> when the expected type is ReadonlyArray<U>.
  static private fun arrayInstArgs(ty: TType): Array<TType> {
    result = mutable Vector[];
    for (inst in ty.insts) {
      inst match {
      | TSInst(Name(_, "Array"), TArgs(targs)) if (targs.size() == 1) ->
        result.push(targs[0])
      | TSInst(Name(_, "ReadonlyArray"), TArgs(targs)) if (targs.size() == 1) ->
        result.push(targs[0])
      | _ -> void
      }
    };
    result.toArray()
  }

  // Returns true if any constraint in the set contains a tuple type.
  static private fun constraintsContainTuple(
    subst: mutable Subst,
    tenv: TEnv,
    constraints: SortedSet<TType>,
  ): Bool {
    constraints.any(cstr ->
      cstr.getSTypes(subst, tenv, Covariant()) match {
      | Some(stypes) -> stypes.any(stype -> stype.isTuple().isSome())
      | _ -> false
      }
    )
  }

  // Creates ArrayLit<α, elts> with fresh type variable α.
  // Example: [1, 2] -> ArrayLit<α, elts=[number, number]>
  // freshElts[i] carries the precise literal type of element i when it was a
  // direct primitive literal (see TArrayLit), None otherwise.
  // Precondition: elementTypes must be non-empty (empty arrays are handled separately).
  static fun typeFromLiteral(
    tcenv: mutable TCEnv,
    pos: PosRange,
    elementTypes: Array<TType>,
    freshElts: Array<?TType>,
  ): TType {
    invariant(!elementTypes.isEmpty());
    invariant(elementTypes.size() == freshElts.size());
    tvar = tcenv.subst.gen(pos);
    tcenv.subst.setOrigin(tvar, FromArrayLiteral(pos));
    TType::arrayLit(tvar, elementTypes, freshElts)
  }

  // True when checking against `target` should keep a fresh literal precise:
  // the target contains a primitive literal type, or it is an unbound
  // inference variable one of whose constraints does. This mirrors TS, which
  // keeps a fresh literal type when the contextual type includes a literal
  // type (so `0` matches a parameter of type `0`, and satisfies
  // `K extends 0 | 1` during inference) and widens it to its base type
  // otherwise. Unlike TS, a type parameter is not bound to the literal
  // candidate: K resolves to its constraint, not to `0`.
  // Peeks on a clone of the substitution: resolving the target covariantly on
  // the live substitution would close open inference variables prematurely.
  static private fun targetExpectsLiteral(
    subst: mutable Subst,
    tenv: TEnv,
    target: TType,
  ): Bool {
    target.getSingleVar() match {
    | Some(tvar) if (subst.isUnbound(tvar)) ->
      return tvar.constraints.any(cstr ->
        ArrayLitTyping::containsLiteralType(subst, tenv, cstr)
      )
    | _ -> void
    };
    ArrayLitTyping::containsLiteralType(subst, tenv, target)
  }

  // Returns true if ty resolves to something containing a primitive literal
  // type (a TPrimValue carrying concrete values).
  static private fun containsLiteralType(
    subst: mutable Subst,
    tenv: TEnv,
    ty: TType,
  ): Bool {
    ty.getSTypes(subst.clone(), tenv, Covariant()) match {
    | Some(stypes) ->
      stypes.any(stype ->
        stype match {
        | TPrimValue(_, Some _, _) -> true
        | _ -> false
        }
      )
    | None() -> false
    }
  }

  // The type to check element i against `target`: its precise fresh literal
  // type when the target demands literal precision, the widened element type
  // otherwise.
  static private fun effectiveElt(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
    i: Int,
    target: TType,
  ): TType {
    arrLit.freshElts[i] match {
    | Some(precise) ->
      if (ArrayLitTyping::targetExpectsLiteral(subst, tenv, target)) {
        precise
      } else {
        arrLit.tupleElts[i]
      }
    | None() -> arrLit.tupleElts[i]
    }
  }

  // Like arrayLitEltType, but uses the precise fresh literal types when the
  // target element type demands literal precision.
  static private fun arrayLitEltTypeForTarget(
    subst: mutable Subst,
    tenv: TEnv,
    arrLit: TArrayLit,
    target: TType,
  ): TType {
    // The freshElts check must come first: targetExpectsLiteral expands the
    // target, which is expensive for large unions and wasted when nothing is
    // fresh.
    keepFresh =
      arrLit.freshElts.any(f -> f.isSome()) &&
      ArrayLitTyping::targetExpectsLiteral(subst, tenv, target);
    eltType = TType::bottom(arrLit.tvar.pos);
    for (i => elt in arrLit.tupleElts) {
      eff = if (keepFresh) arrLit.freshElts[i].default(elt) else elt;
      !eltType = TType::union(subst, tenv, eltType, eff)
    };
    eltType
  }

  // Returns true if index type forces array refinement (string, symbol, or non-literal number).
  // Excludes literal numeric indices (e.g., x[0]) which could be tuple or array.
  static private fun shouldRefineArrayFromIndexType(idxSType: SType): Bool {
    idxSType match {
    | TPrimValue(TString(), _, _) -> true
    | TPrimValue(TSymbol(), _, _) -> true
    | TPrimValue(TNum(), None(), _) -> true
    | _ -> false
    }
  }

  // Refines ArrayLit<α, elts> to Array<U> when array-like indexing is used.
  // Returns ty unchanged if:
  //   - the index type doesn't force array refinement, or
  //   - ty is not an uncommitted array literal.
  // Otherwise commits the literal to Array<union(elts)> and returns it.
  static fun refineForArrayUse(
    tcenv: mutable TCEnv,
    tenv: TEnv,
    ty: TType,
    idxSType: SType,
  ): TType {
    if (!ArrayLitTyping::shouldRefineArrayFromIndexType(idxSType)) return ty;
    ArrayLitTyping::getSingleArrayLitUncommitted(tcenv.subst, tenv, ty) match {
    | None() -> ty
    | Some(arrLit) ->
      // Commit to Array<union(elts)>
      arrayTy = ArrayLitTyping::arrayLitToArrayTType(tcenv.subst, tenv, arrLit);
      ArrayLitTyping::arrayLitCommitType(tcenv.subst, tenv, arrLit, arrayTy);
      arrayTy
    }
  }

  // Handles subtyping when u1 or u2 contains ArrayLit<α, elts>.
  // Each branch commits the literal to tuple or array based on context.
  static fun subtyping(
    subst: mutable Subst,
    tenv: TEnv,
    u1: TType,
    u2: TType,
  ): ?STResult<TType> {
    // Case 1: u1 <: ArrayLit<α, elts> (RHS is uncommitted literal)
    // Example: f([1,2], [3,4]) where T was inferred from [1,2] and reused.
    ArrayLitTyping::getSingleArrayLitUncommitted(subst, tenv, u2) match {
    | Some(arrLit) ->
      // Commit RHS to Array<union(elts)> as permissive supertype.
      arrayTy = ArrayLitTyping::arrayLitToArrayTType(subst, tenv, arrLit);
      ArrayLitTyping::arrayLitCommitType(subst, tenv, arrLit, arrayTy);
      return Some(TType::isSub(subst, tenv, u1, arrayTy))
    | None() -> void
    };

    // Case 2: ArrayLit<α, elts> <: u2 (LHS is uncommitted literal)
    ArrayLitTyping::getSingleArrayLitUncommitted(subst, tenv, u1) match {
    | Some(arrLit) ->
      // Case 2a: ArrayLit<α, elts> <: β (type variable)
      u2.getSingleVar() match {
      // Case 2a: unconstrained type variable → commit to Tuple, bind variable
      | Some(tvar) if (tvar.constraints.isEmpty()) ->
        defaultTy = ArrayLitTyping::arrayLitDefaultType(arrLit);
        ArrayLitTyping::arrayLitCommitType(subst, tenv, arrLit, defaultTy);
        subst.grow(tenv, tvar, defaultTy, Contravariant());
        return Some(STOk())
      // Case 2a': constrained type variable → commit based on constraint type
      | Some(tvar) ->
        // If constraints contain a tuple, commit to Tuple; otherwise commit to Array
        committedTy = if (
          ArrayLitTyping::constraintsContainTuple(subst, tenv, tvar.constraints)
        ) {
          ArrayLitTyping::arrayLitToTupleType(arrLit)
        } else {
          ArrayLitTyping::arrayLitToArrayTType(subst, tenv, arrLit)
        };
        ArrayLitTyping::arrayLitCommitType(subst, tenv, arrLit, committedTy);
        return Some(TType::isSub(subst, tenv, committedTy, u2))
      | _ -> void
      };
      // Case 2b: ArrayLit<α, elts> <: Array<U1> | ... | Array<Un>
      arrayCandidates = ArrayLitTyping::arrayInstArgs(u2);
      if (!arrayCandidates.isEmpty()) {
        expectedEltType = TType::unionN(
          subst,
          tenv,
          arrLit.tvar.pos,
          arrayCandidates,
        );
        litEltType = ArrayLitTyping::arrayLitEltTypeForTarget(
          subst,
          tenv,
          arrLit,
          expectedEltType,
        );
        result = TType::isSub(subst, tenv, litEltType, expectedEltType);
        // Covariance is sound here: we're committing an uncommitted literal,
        // not assigning an already-typed array. Future writes check against expectedEltType.
        arrayTy = TType::inst(
          Name(arrLit.tvar.pos, "Array"),
          TArgs(Array[expectedEltType]),
        );
        ArrayLitTyping::arrayLitCommitType(subst, tenv, arrLit, arrayTy);
        return Some(result)
      };
      // Case 2c: ArrayLit<α, elts> <: Tuple[U1, ...]
      u2.getSTypes(subst, tenv, Covariant()).flatMap(sTypes ->
        sTypes.getSingleTuple(subst, tenv)
      ) match {
      | Some(targetElts) if (targetElts.size() == arrLit.tupleElts.size()) ->
        // Commit to the target tuple's element types (contextual widening).
        // TS widens `[1, "x"]` to `[number, string]` when the target is a
        // mutable tuple; we do the same by committing to the target elements
        // and then verifying each literal element subtypes its target.
        savedSubst = subst.save();
        committedTy = TType::tuple(arrLit.tvar.pos, targetElts, false);
        ArrayLitTyping::arrayLitCommitType(subst, tenv, arrLit, committedTy);
        for (i in Range(0, targetElts.size())) {
          eltTy = ArrayLitTyping::effectiveElt(
            subst,
            tenv,
            arrLit,
            i,
            targetElts[i],
          );
          TType::isSub(subst, tenv, eltTy, targetElts[i]) match {
          | STOk() -> void
          | err @ STError _ ->
            subst.restore(savedSubst);
            return Some(err)
          }
        };
        return Some(STOk())
      | Some(_) ->
        // Arity mismatch: don't commit — let subsequent use sites commit
        // against their own targets. Fall through so the caller sees this
        // as an ArrayLit subtyping failure without locking the literal
        // into a mismatched tuple shape.
        void
      | None() -> void
      }
    | None() -> void
    };
    None()
  }
}

module end;
