module SKJS;

class MaxSizeReached() extends Exception {
  fun getMessage(): String {
    "Internal error: column max size reached"
  }
}

const kDefaultMaxDepth: Int = 2;

value class Margin{
  max_depth: Int = kDefaultMaxDepth,
  size: Int = 0,
  str: String = "",
}

mutable base class TypePpState private {
  mutable cols: Int = 0,
  mutable buffer: List<String> = List[],
  mutable expandingTVars: SortedSet<TVarID> = SortedSet[],
} {
  readonly fun chill(): SavedTypePp {
    SavedTypePp::create(this)
  }

  mutable fun replace(saved: SavedTypePp): void {
    this.!cols = saved.cols;
    this.!buffer = saved.buffer;
    this.!expandingTVars = saved.expandingTVars;
  }
}

mutable class SavedTypePp private {} extends TypePpState {
  static fun create(state: readonly TypePpState): SavedTypePp {
    SavedTypePp{
      cols => state.cols,
      buffer => state.buffer,
      expandingTVars => state.expandingTVars,
    }
  }
}

// Named fields every tuple expansion carries besides its positional fields:
// `length` and the array-protocol members inherited from the ReadonlyArray
// and SKJS_ArrayAndTupleBase stub interfaces. Anything else is a member the
// tuple shorthand would hide. A stub member missing here only costs the
// shorthand (the object form prints instead), never correctness.
const kTupleProtocolFieldNames: SortedSet<String> = SortedSet[
  "concat",
  "every",
  "filter",
  "find",
  "findIndex",
  "flatMap",
  "forEach",
  "includes",
  "indexOf",
  "join",
  "lastIndexOf",
  "length",
  "map",
  "reduce",
  "reduceRight",
  "slice",
  "some",
];

// Returns Some((element types, positionals are readonly)) when the tuple
// shorthand can render `fields` without hiding anything: an array-branded
// object whose named fields are exactly the positional indexes 0..N-1
// (agreeing on mutability), a literal `length` N, and array-protocol
// members. Single pass over the fields (no isTuple/asTuple re-walks).
fun tupleShorthand(fields: TFields): ?(Array<TType>, Bool) {
  if (fields.isArray != Some(true)) return None();
  arity: ?Int = None();
  positionals = mutable Map<Int, TType>[];
  maxIndex = -1;
  readonlyCount = 0;
  for (field in fields.fields) {
    name = field.name.value;
    name.toIntOption() match {
    | Some(i) if (i >= 0) ->
      positionals.set(i, field.get);
      if (i > maxIndex) !maxIndex = i;
      if (field.set.isBottom()) {
        !readonlyCount = readonlyCount + 1;
      }
    | _ ->
      if (!kTupleProtocolFieldNames.contains(name)) return None();
      if (name == "length") {
        !arity = field.get.getSingleConstant() match {
        | Some(TPrimValue(TNum(), Some(lits), _)) ->
          lits.singleElt().flatMap(lit -> lit.val.toIntOption())
        | _ -> None()
        }
      }
    }
  };
  n = arity match {
  | Some(x) if (x >= 0) -> x
  | _ -> return None()
  };
  // Field names are unique, so count n with max n-1 means exactly 0..n-1.
  if (positionals.size() != n || (n != 0 && maxIndex != n - 1)) {
    return None()
  };
  if (readonlyCount != 0 && readonlyCount != n) return None();
  Some((Array::fillBy(n, i -> positionals[i]), readonlyCount != 0))
}

mutable class TypePp{
  compact: Bool,
  // Mirrors --verbose: when true, internal-only details (synthetic index
  // name; see kSyntheticIndexName) are kept in the printed output for
  // debugging instead of being filtered out.
  verbose: Bool = false,
  substValues: SortedMap<TVarID, SubstValue> = SortedMap[],
  applyType: (TType -> TType) = x -> x,
} extends TypePpState {
  const MAX_COLS: Int = 80;

  mutable fun render(f: mutable TypePp -> void): String {
    f(this);
    strings = this.buffer.reversed();
    if (this.compact) {
      !strings = strings.map(str ~> {
        String::fromChars(
          str
            .getIter()
            .filter(c ~> c != '\t' && c != '\n' && c != ' ')
            .collect(Array),
        )
      })
    };
    "".join(strings)
  }

  mutable fun out(level: Int, margin: Margin, str: String): void {
    // The string does not contain special characters
    for (c in str) {
      if (c == '\n' || c == '\r' || c == '\t') {
        internal_error("unexpected character")
      };
    };
    if (this.cols < margin.size) {
      // The string does not start with a space
      for (_c in str) {
        //        if (c == ' ') internal_error("unexpected white space: " + str);
        break void;
      };
      this.!cols = margin.size;
      this.!buffer = List.Cons(margin.str, this.buffer);
    };
    this.!cols = this.cols + str.length();
    if (level != 0 && this.cols > TypePp::MAX_COLS) {
      throw MaxSizeReached()
    };
    this.!buffer = List.Cons(str, this.buffer);
  }

  mutable fun newLine(): void {
    this.!cols = 0;
    this.!buffer = List.Cons("\n", this.buffer);
  }

  mutable fun branch(
    level: Int,
    margin: Margin,
    f1: (mutable this, Int, Margin) ~> void,
    f2: (mutable this, Int, Margin, Margin) -> void,
  ): void {
    if (this.compact || level > 0) {
      f1(this, level, margin);
      return void
    };
    saved = this.chill();
    try {
      f1(this, level + 1, margin)
    } catch {
    | MaxSizeReached() ->
      this.replace(saved);
      prevMargin = margin;
      !margin.size = margin.size + 2;
      !margin.str = margin.str + "  ";
      f2(this, level, prevMargin, margin)
    | exn -> throw (exn)
    }
  }

  mutable fun stype(level: Int, margin: Margin, sty: SType): void {
    sty match {
    | TObject(_, Some(inst), _) -> this.inst(level, margin, inst)
    | obj @ TObject(_, _, _) ->
      first = true;
      for (fields in obj.getAllFields()) {
        if (!first) this.out(level, margin, " | ");
        !first = false;
        this.object(level, margin, fields)
      }
    | TPrimUnit(k, _) -> this.out(level, margin, k.toString())
    | TPrimValue(k, None(), _) -> this.out(level, margin, k.toString())
    | TPrimValue(TSymbol(), Some(arr), _) ->
      rendered = arr
        .values()
        .map(lit -> TypePp::displayUniqueSymbolId(lit.val))
        .collect(Array)
        .join(" | ");
      this.out(level, margin, rendered)
    | TPrimValue(_, Some(arr), _) ->
      this.out(level, margin, arr.toStringList(true))
    }
  }

  mutable fun tfun(level: Int, margin: Margin, arg: (Bool, TFun)): void {
    (isMethod, tfun) = arg;
    this.branch(
      level,
      margin,
      (pp, level, margin) ~> {
        if (tfun.tparams.size() != 0) {
          pp.out(level, margin, "<");
          for (i => tparam in tfun.tparams) {
            if (i != 0) pp.out(level, margin, ", ");
            pp.tparamName(level, margin, tparam.name, tparam.id);
            tparam.cstr match {
            | None() -> void
            | Some(x) ->
              pp.out(level, margin, " extends ");
              pp.type(level, margin, x)
            }
          };
          pp.out(level, margin, ">");
        };
        pp.out(level, margin, "(");
        tfun.thisParam.each(thisTy -> {
          pp.out(level, margin, "this: ");
          pp.type(level, margin, thisTy);
        });
        for (i => param in tfun.params) {
          if (i != 0 || tfun.thisParam.isSome()) pp.out(level, margin, ", ");
          pp.type(level, margin, param)
        };
        for (i => param in tfun.optionalParams) {
          if (i != 0 || tfun.params.size() != 0 || tfun.thisParam.isSome()) {
            pp.out(level, margin, ", ")
          };
          pp.out(level, margin, "_?:");
          pp.type(level, margin, param)
        };
        tfun.spreadParam.each(at -> {
          if (
            tfun.optionalParams.size() != 0 ||
            tfun.params.size() != 0 ||
            tfun.thisParam.isSome()
          ) {
            pp.out(level, margin, ", ")
          };
          pp.out(level, margin, "..._: ");
          pp.type(level, margin, at)
        });
        if (isMethod) {
          pp.out(level, margin, "): ");
        } else {
          pp.out(level, margin, ") => ");
        };
        pp.type(level, margin, tfun.retType);
      },
      (pp, level, prevMargin, margin) ~> {
        if (tfun.tparams.size() != 0) {
          pp.out(level, margin, "<");
          for (i => tparam in tfun.tparams) {
            if (i != 0) pp.out(level, margin, ", ");
            pp.tparamName(level, margin, tparam.name, tparam.id);
            tparam.cstr match {
            | None() -> void
            | Some(x) ->
              pp.out(level, margin, " extends ");
              pp.type(level, margin, x)
            }
          };
          pp.out(level, margin, ">");
        };
        pp.out(level, margin, "(");
        pp.newLine();
        tfun.thisParam.each(thisTy -> {
          pp.out(level, margin, "this: ");
          pp.type(level, margin, thisTy);
          pp.out(level, margin, ",");
          pp.newLine();
        });
        for (param in tfun.params) {
          pp.type(level, margin, param);
          pp.out(level, margin, ",");
          pp.newLine();
        };
        for (param in tfun.optionalParams) {
          pp.out(level, margin, "_?: ");
          pp.type(level, margin, param);
          pp.out(level, margin, ",");
          pp.newLine();
        };
        tfun.spreadParam.each(at -> {
          pp.out(level, margin, "..._: ");
          pp.type(level, margin, at);
          pp.newLine();
        });
        if (isMethod) {
          pp.out(level, prevMargin, "): ");
        } else {
          pp.out(level, prevMargin, ") => ");
        };
        pp.type(level, margin, tfun.retType);
      },
    )
  }

  mutable fun tuple(level: Int, margin: Margin, values: Array<TType>): void {
    this.out(level, margin, "[");
    this.branch(
      level,
      margin,
      (pp, level, margin) ~> {
        for (i => ty in values) {
          if (i != 0) {
            pp.out(level, margin, ", ");
          };
          pp.type(level, margin, ty);
        };
        pp.out(level, margin, "]");
      },
      (pp, level, prevMargin, margin) -> {
        pp.newLine();
        for (ty in values) {
          pp.type(level, margin, ty);
          pp.out(level, margin, ",");
          pp.newLine();
        };
        pp.newLine();
        pp.out(level, prevMargin, "]");
        pp.newLine();
      },
    )
  }

  mutable fun object(level: Int, margin: Margin, fields: TFields): void {
    // A bare `object` keyword branch prints as `object`; once it gains
    // structural members (e.g. through an intersection) it prints those.
    if (fields.isBareNonPrimitive()) {
      this.out(level, margin, "object");
      return void
    };
    // A tuple-shaped object prints as the tuple it denotes when the
    // shorthand hides nothing: besides its positional fields, a tuple
    // expansion carries only `length` and the array-protocol members
    // inherited from the stubs (`map`, `indexOf`, `filter`, ...). Any other
    // member (e.g. an intersection's extra field) keeps the expanded object
    // form, which also stays available under --verbose.
    if (!this.verbose) {
      tupleShorthand(fields) match {
      | Some((elts, isReadonly)) ->
        if (isReadonly) this.out(level, margin, "readonly ");
        return this.tuple(level, margin, elts)
      | None() -> void
      }
    };
    (
      fields.fields.isEmpty(),
      !fields.hasNonSyntheticIndex(),
      fields.call,
      fields.new,
    ) match {
    | (true, true, Some((false, TFuns(tfun, _pos))), None()) ->
      this.tfun(level, margin, (false, tfun))
    | (true, true, None(), Some((false, TFuns(tfun, _pos)))) ->
      this.out(level, margin, "new ");
      this.tfun(level, margin, (false, tfun))
    | _ ->
      this.out(level, margin, "{");
      this.branch(
        level,
        margin,
        (pp, level, margin) ~> {
          pp.out(level, margin, " ");
          pp.fields(level, margin, fields, false);
          pp.out(level, margin, " }");
        },
        (pp, level, prevMargin, margin) -> {
          pp.newLine();
          pp.fields(level, margin, fields, true);
          pp.newLine();
          pp.out(level, prevMargin, "}");
          pp.newLine();
        },
      )
    }
  }

  mutable fun fields(
    level: Int,
    margin: Margin,
    fields: TFields,
    multiLine: Bool,
  ): void {
    fieldArray = fields.fields;
    symbolFieldArray = fields.symbolFields;
    // Hide synthetic indexes (kSyntheticIndexName): they exist to make
    // object literals satisfy indexed-type constraints during subtyping
    // and must not appear in user-visible printed types. Kept under
    // --verbose for debugging.
    hideSynthetic: ((?TField) -> ?TField) = idx ->
      if (this.verbose) idx else {
        idx.flatMap(f -> if (f.isSynthetic()) None() else Some(f))
      };
    stringIdx = hideSynthetic(fields.stringIndex);
    numberIdx = hideSynthetic(fields.numberIndex);
    symbolIdx = hideSynthetic(fields.symbolIndex);
    hasIndexes = stringIdx.isSome() || numberIdx.isSome() || symbolIdx.isSome();
    for (i => field in fieldArray) {
      fieldName = field.name.value;
      escapedName = TypePp::escapeName(fieldName);
      if (field.set.isBottom()) {
        this.out(level, margin, "readonly ");
        this.out(level, margin, escapedName);
        if (field.isOptional) this.out(level, margin, "?");
        this.out(level, margin, ": ");
        this.type(level, margin, field.get);
      } else if (field.get != field.set) {
        this.out(level, margin, "get ");
        this.out(level, margin, escapedName);
        this.out(level, margin, "(): ");
        this.type(level, margin, field.get);
        this.out(level, margin, ", set ");
        this.out(level, margin, escapedName);
        this.out(level, margin, "(v: ");
        this.type(level, margin, field.set);
        this.out(level, margin, ")");
      } else {
        this.out(level, margin, escapedName);
        if (field.isOptional) this.out(level, margin, "?");
        this.out(level, margin, ": ");
        this.type(level, margin, field.get);
      };
      if (
        i != fieldArray.size() - 1 ||
        !symbolFieldArray.isEmpty() ||
        hasIndexes ||
        fields.call.isSome() ||
        fields.new.isSome()
      ) {
        this.out(level, margin, ",");
        if (multiLine) this.newLine() else {
          this.out(level, margin, " ")
        };
      }
    };
    for (i => field in symbolFieldArray) {
      this.out(
        level,
        margin,
        `[${TypePp::displayUniqueSymbolId(field.name.value)}]`,
      );
      if (field.isOptional) {
        this.out(level, margin, "?")
      };
      this.out(level, margin, ": ");
      this.type(level, margin, field.get);
      if (
        i != symbolFieldArray.size() - 1 ||
        hasIndexes ||
        fields.call.isSome() ||
        fields.new.isSome()
      ) {
        this.out(level, margin, ",");
        if (multiLine) this.newLine() else {
          this.out(level, margin, " ")
        };
      }
    };
    hasMore = fields.call.isSome() || fields.new.isSome();
    stringIdx.each(index -> {
      this.indexField(level, margin, "string", index);
      if (numberIdx.isSome() || symbolIdx.isSome() || hasMore) {
        this.out(level, margin, ",");
        if (multiLine) this.newLine() else {
          this.out(level, margin, " ")
        }
      }
    });
    numberIdx.each(index -> {
      this.indexField(level, margin, "number", index);
      if (symbolIdx.isSome() || hasMore) {
        this.out(level, margin, ",");
        if (multiLine) this.newLine() else {
          this.out(level, margin, " ")
        }
      }
    });
    symbolIdx.each(index -> {
      this.indexField(level, margin, "symbol", index);
      if (hasMore) {
        this.out(level, margin, ",");
        if (multiLine) this.newLine() else {
          this.out(level, margin, " ")
        }
      }
    });
    fields.call match {
    | None() -> void
    | Some((opt, TFuns(tfun, _pos))) ->
      if (opt) this.out(level, margin, "?");
      this.tfun(level, margin, (true, tfun));
      if (fields.new.isSome()) {
        this.out(level, margin, ",");
        if (multiLine) this.newLine() else {
          this.out(level, margin, " ")
        }
      }
    };
    fields.new match {
    | None() -> void
    | Some((opt, TFuns(tfun, _pos))) ->
      if (opt) this.out(level, margin, "?");
      this.out(level, margin, "new ");
      this.tfun(level, margin, (true, tfun))
    }
  }

  mutable fun indexField(
    level: Int,
    margin: Margin,
    keyKind: String,
    index: TField,
  ): void {
    if (index.set.isBottom()) {
      this.out(level, margin, "readonly ")
    };
    this.out(level, margin, "[ ");
    this.out(level, margin, TypePp::escapeName(index.name.value));
    this.out(level, margin, ": ");
    this.out(level, margin, keyKind);
    this.out(level, margin, " ]: ");
    this.type(level, margin, index.get);
    if (!index.set.isBottom() && index.get != index.set) {
      this.out(level, margin, " (set: ");
      this.type(level, margin, index.set);
      this.out(level, margin, ")");
    }
  }

  static fun escapeName(name: String): String {
    chars = mutable Vector[];
    for (c in name) {
      if (c == '"') chars.push('\\');
      chars.push(c)
    };
    String::fromChars(chars.toArray())
  }

  // Decodes a unique-symbol identifier into a user-facing display string.
  // Encoded form: unique_symbol:<filePath>:<symbol>:<relStart>:<displayName>
  // - When the displayName segment is non-empty: `typeof <name>`.
  // - When it is empty (anonymous unique symbol): `unique symbol defined in
  //   <file> at <symbol>` — the symbol is the `SymbolicPos::toString`
  //   form, e.g. `constant(objWithUniqueSymbol)` or `class(MyClass)`.
  // - When the prefix doesn't match: fall back to the raw id.
  static fun displayUniqueSymbolId(val: String): String {
    prefix = "unique_symbol:";
    if (val.startsWith(prefix)) {
      parts = val.stripPrefix(prefix).split(":");
      if (parts.size() == 4) {
        displayName = parts[3];
        if (!displayName.isEmpty()) {
          `typeof ${displayName}`
        } else {
          `unique symbol defined in ${parts[0]} at ${parts[1]}`
        }
      } else {
        val
      }
    } else {
      val
    }
  }

  mutable fun clause(level: Int, margin: Margin, clause: Clause): void {
    for (j => tparam in clause.vars) {
      if (j != 0) {
        this.out(level, margin, " & ");
      };
      this.tparamName(level, margin, tparam.name, tparam.id);
    };
    clause.stypes match {
    | None() ->
      invariant(!clause.vars.isEmpty(), "several clauses with a Top clause");
      void
    | Some(c) ->
      if (!clause.vars.isEmpty()) this.out(level, margin, " extends ");
      this.sTypes(level, margin, c)
    }
  }

  mutable fun sTypes(level: Int, margin: Margin, sTypes: STypes): void {
    for (k => sty in sTypes) {
      if (k != 0) {
        this.out(level, margin, " | ");
      };
      this.stype(level, margin, sty);
    }
  }

  mutable fun clauses(level: Int, margin: Margin, clauses: Clauses): void {
    if (clauses.isTop()) {
      this.out(level, margin, "unknown")
    } else if (clauses.isEmpty()) {
      this.out(level, margin, "never")
    } else {
      for (i => clause in clauses.clauses) {
        if (i != 0) {
          this.out(level, margin, " | ");
        };
        this.clause(level, margin, clause);
      };
    }
  }

  mutable fun type(level: Int, margin: Margin, ty: TType): void {
    !ty = this.applyType(ty);
    !margin.max_depth = margin.max_depth - 1;
    if (margin.max_depth < 0) {
      this.out(level, margin, "...");
      return void;
    };
    if (ty.isTop()) {
      this.out(level, margin, "unknown");
      return void;
    };
    if (ty.isBottom()) {
      this.out(level, margin, "never");
      return void;
    };
    clausesNonEmpty = !ty.clauses.isEmpty();
    if (clausesNonEmpty) {
      this.clauses(level, margin, ty.clauses)
    };
    // When clauses were printed, the first inst must still be joined to them
    // with " | "; otherwise e.g. `undefined` (clause) + `Array<number>` (inst)
    // runs together as `undefinedArray<number>`. The multi-line branch already
    // separates the groups via its buffer-based newLine, so only the
    // single-line branch needs the leading separator (see #683).
    this.insts(level, margin, ty.insts, clausesNonEmpty)
  }

  mutable fun insts(
    level: Int,
    margin: Margin,
    insts: TInsts,
    leadingSep: Bool = false,
  ): void {
    this.branch(
      level,
      margin,
      (pp, level, margin) ~> {
        for (i => inst in insts) {
          if (i != 0 || leadingSep) pp.out(level, margin, " | ");
          inst match {
          | tsinst @ TSInst _ -> pp.inst(level, margin, tsinst)
          | TArrayLit(_tvar, tupleElts, _) ->
            pp.out(level, margin, "ArrayLit<");
            for (j => eltTy in tupleElts) {
              if (j != 0) pp.out(level, margin, ", ");
              pp.type(level, margin, eltTy);
            };
            pp.out(level, margin, ">")
          | TInter(tys) ->
            j = 0;
            for (ity in tys) {
              pp.out(level, margin, "(");
              pp.type(level, margin, ity);
              pp.out(level, margin, ")");
              if (j < tys.size() - 1) pp.out(level, margin, " & ");
              !j = j + 1;
            }
          | tvar @ TVar _ -> pp.tvar(level, margin, tvar)
          }
        }
      },
      (pp, level, _prevMargin, margin) ~> {
        for (inst in insts) {
          pp.buffer match {
          | List.Nil()
          | List.Cons("\n", _) ->
            void
          | _ -> pp.newLine()
          };
          inst match {
          | tsinst @ TSInst _ -> pp.inst(level, margin, tsinst)
          | TArrayLit(_tvar, tupleElts, _) ->
            pp.out(level, margin, "ArrayLit<");
            for (i => eltTy in tupleElts) {
              if (i != 0) pp.out(level, margin, ", ");
              pp.type(level, margin, eltTy);
            };
            pp.out(level, margin, ">")
          | TInter(tys) ->
            i = 0;
            for (ity in tys) {
              pp.type(level, margin, ity);
              if (i < tys.size() - 1) pp.out(level, margin, " & ");
              !i = i + 1;
            }
          | tvar @ TVar _ -> pp.tvar(level, margin, tvar)
          }
        }
      },
    );
  }

  mutable fun inst(level: Int, margin: Margin, inst: TSInst): void {
    tupleKind(inst.name.value) match {
    | Some(kind) ->
      if (kind.isReadonly) this.out(level, margin, "readonly ");
      this.tuple(level, margin, inst.targs.targs);
      return void
    | None() -> void
    };
    this.out(level, margin, inst.name.value);
    targs = inst.targs;
    if (targs.targs.size() != 0) {
      this.out(level, margin, "<");
      for (i => targ in targs.targs) {
        if (i != 0) this.out(level, margin, ", ");
        this.type(level, margin, targ);
      };
      this.out(level, margin, ">");
    }
  }

  mutable fun tvar(level: Int, margin: Margin, tvar: TVar): void {
    this.out(level, margin, `'${tvar.id}`);
    if (!tvar.constraints.isEmpty()) {
      this.out(level, margin, " extends ");
      first = true;
      for (c in tvar.constraints) {
        if (first) {
          !first = false;
        } else {
          this.out(level, margin, " & ");
        };
        this.type(level, margin, c)
      }
    };
    if (!this.expandingTVars.contains(tvar.id)) {
      this.substValues.maybeGet(tvar.id) match {
      | Some(sv) ->
        boundTy = sv match {
        | SVOpen(ty) -> ty
        | SVClosed(ty) -> ty
        };
        this.!expandingTVars = this.expandingTVars.set(tvar.id);
        this.out(level, margin, " = ");
        this.type(level, margin, boundTy);
        this.!expandingTVars = this.expandingTVars.remove(tvar.id)
      | None() -> void
      }
    }
  }

  mutable fun tparamName(
    level: Int,
    margin: Margin,
    name: String,
    id: Id,
  ): void {
    // The qualified id (name:counter:file-hash) disambiguates same-named type
    // parameters but is not user-readable; like synthetic indexes above, it
    // must not appear in user-visible printed types and is kept under
    // --verbose for debugging.
    if (!this.verbose) {
      this.out(level, margin, name);
      return void
    };
    idStr = id.toString();
    nameColon = name + ":";
    if (idStr.startsWith(nameColon)) {
      this.out(level, margin, idStr)
    } else {
      this.out(level, margin, nameColon + id)
    }
  }
}

fun rawPrettyPrint(
  compact: Bool,
  f: mutable TypePp -> void,
  substValues: SortedMap<TVarID, SubstValue> = SortedMap[],
  verbose: Bool = false,
  applyType: TType -> TType = x ~> x,
): String {
  pp = mutable TypePp{compact, verbose, substValues, applyType};
  pp.render(f)
}

fun prettyPrint(
  subst: mutable Subst,
  tenv: TEnv,
  compact: Bool,
  f: mutable TypePp -> void,
): String {
  pp = mutable TypePp{
    compact,
    verbose => tenv.verbose,
    applyType => ty -> ty.expandTVarsForPp(subst, tenv),
  };
  pp.render(f)
}

fun prettyPrintType(
  compact: Bool,
  ty: TType,
  subst: mutable Subst,
  tenv: TEnv,
  max_depth: Int = kDefaultMaxDepth,
): String {
  !subst = subst.clone();
  prettyPrint(subst, tenv, compact, pp -> {
    pp.type(0, Margin{max_depth}, ty);
  })
}

fun prettyPrintSType(
  subst: mutable Subst,
  tenv: TEnv,
  stype: SType,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  prettyPrint(subst, tenv, compact, pp -> pp.stype(0, Margin{max_depth}, stype))
}

fun prettyPrintSTypes(
  subst: mutable Subst,
  tenv: TEnv,
  sTypes: STypes,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  prettyPrint(subst, tenv, compact, pp ->
    pp.sTypes(0, Margin{max_depth}, sTypes)
  )
}

fun prettyPrintClause(
  subst: mutable Subst,
  tenv: TEnv,
  clause: Clause,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  if (clause.isTop()) {
    prettyPrint(subst, tenv, compact, pp ->
      pp.out(0, Margin{max_depth}, "unknown")
    )
  } else {
    prettyPrint(subst, tenv, compact, pp -> {
      pp.clause(0, Margin{max_depth}, clause);
    })
  }
}

fun prettyPrintClauses(
  subst: mutable Subst,
  tenv: TEnv,
  clauses: Clauses,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  prettyPrint(subst, tenv, compact, pp ->
    pp.clauses(0, Margin{max_depth}, clauses)
  )
}

fun prettyPrintTInsts(
  subst: mutable Subst,
  tenv: TEnv,
  insts: TInsts,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  prettyPrint(subst, tenv, compact, pp -> pp.insts(0, Margin{max_depth}, insts))
}

fun prettyPrintTFun(
  subst: mutable Subst,
  tenv: TEnv,
  tFun: TFun,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  prettyPrint(subst, tenv, compact, pp ->
    pp.tfun(0, Margin{max_depth}, (false, tFun))
  )
}

fun prettyPrintFields(
  subst: mutable Subst,
  tenv: TEnv,
  fields: TFields,
  compact: Bool = false,
  max_depth: Int = kDefaultMaxDepth,
): String {
  prettyPrint(subst, tenv, compact, pp ->
    pp.object(0, Margin{max_depth}, fields)
  )
}

module end;
