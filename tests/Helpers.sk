module SKJSTests;

base class ReferenceError{line: Int} {
  fun validate(
    fileName: SKJS.FAbsolute,
    errors: Sequence<SKJS.Error>,
  ): ?SKTest.ExpectationError;
  fun getMessage(): String;
}

base class AnnotationKind final () {
  const str: String;
  const chars: Vector<Char>;
}

class TS_EXPECT_ERROR extends AnnotationKind {
  const str: String = "ts-expect-error";
  const chars: Vector<Char> = TS_EXPECT_ERROR::str.chars();
}

class SKJS_EXPECT_ERROR extends AnnotationKind {
  const str: String = "skjs-expect-error";
  const chars: Vector<Char> = SKJS_EXPECT_ERROR::str.chars();
}

extension class .String {
  fun trimForComparison(): String {
    i = this.getIter();
    _ = i.find(c ~> c == '\n'); // Keep first line only
    _ = i.rfind(c ~> !String.isWhitespace(c)); // Ignore trailing whitespaces
    _ = i.next();
    i.rfind(c ~> c != '.') match { // Ignore trailing dots
    | None() -> return ""
    | Some(_) -> void
    };
    if (i.current() is Some('!')) {
      _ = i.next() // Do not ignore last dot following a !
    };
    _ = i.next();
    this.getIter().substring(i)
  }
}

class ExpectError{expectedErrors: SortedSet<String>} extends ReferenceError {
  fun validate(
    fileName: SKJS.FAbsolute,
    errors: Sequence<SKJS.Error>,
  ): ?SKTest.ExpectationError {
    if (this.expectedErrors.size() > 0) {
      actuals = errors
        .map(error -> {
          msg = error match {
          | SKJS.SinglePosError(_pos, errorKind) -> errorKind.toString()
          | SKJS.TypingError(messages, _stErr) -> messages[0].i1
          };
          msg.trimForComparison()
        })
        .collect(SortedSet);
      if (actuals != this.expectedErrors) {
        return Some(
          SKTest.ExpectationError(
            `${fileName}:${this.line} Wrong error message(s)`,
            this.getMessage(),
            actuals.toArray().join(" / "),
          ),
        )
      }
    };
    None()
  }

  fun getMessage(): String {
    `${this.expectedErrors.toArray().join(" / ")}`
  }
}

/* Try to match an annotation kind at the given position in the char array.
 * Returns (str, isFullMatch, newPos) or None if the first char doesn't
 * match any annotation kind. */
fun tryMatchAnnotation(
  allChars: Array<Char>,
  pos: Int,
): ?(Concrete<AnnotationKind>, Bool, Int) {
  if (pos >= allChars.size()) return None();
  possibleAnnot = if (allChars[pos] == TS_EXPECT_ERROR::chars[0]) {
    TS_EXPECT_ERROR
  } else if (allChars[pos] == SKJS_EXPECT_ERROR::chars[0]) {
    SKJS_EXPECT_ERROR
  } else {
    return None()
  };
  posInAnnot = 0;
  do {
    !pos = pos + 1;
    !posInAnnot = posInAnnot + 1;
  } while (pos < allChars.size() &&
    posInAnnot < possibleAnnot::chars.size() &&
    allChars[pos] == possibleAnnot::chars[posInAnnot]);
  Some((possibleAnnot, posInAnnot >= possibleAnnot::chars.size(), pos))
}

/* Returns an array of line numbers and rest-of-line for all lines
 * matching .*\/\/\s*(@(skjs|ts)-expect-error)\s+(?<rest-of-line>[^\n]*)
 * The returned line numbers are the line numbers on which errors are
 * expected, i.e. if the comment is on the first line, the corresponding
 * returned line number is 2.
 *
 * Throws if the annotation is found somewhere else. */
fun findExpectErrors(contents: String): readonly Vector<ExpectError> {
  /*
    Correctness is based on the fact that these are all disjoint sets:
    - '\n'
    - ' ', '\t'
    - '/'
    - '@'
    - characters in TS_EXPECT_ERROR::chars union SKJS_EXPECT_ERROR::chars
    and on the fact that the first characters of TS_EXPECT_ERROR::chars and
    SKJS_EXPECT_ERROR::chars differ.
   */
  result = mutable Vector[];
  chars = contents.chars().toArray();
  pos = 0;
  // Do not trust the lexer's newLinesMap, as a way to double-check it
  lineNumber = 1;
  while (pos < chars.size()) {
    if (chars[pos] == '\n') {
      !lineNumber = lineNumber + 1;
    };
    if (chars[pos] == '@') {
      !pos = pos + 1;
      if (pos >= chars.size()) {
        break void
      };
      tryMatchAnnotation(chars, pos) match {
      | Some((annot, true, _newPos)) ->
        invariant_violation(`Line ${lineNumber}: misplaced @${annot::str}`)
      | Some((_, _, newPos)) -> !pos = newPos
      | None() -> void
      };
      continue;
    };
    if (chars[pos] != '/') {
      !pos = pos + 1;
      continue;
    };
    !pos = pos + 1;
    if (pos >= chars.size()) {
      break void;
    };
    if (chars[pos] != '/') {
      continue;
    };
    !pos = pos + 1;
    while (pos < chars.size() && (chars[pos] == ' ' || chars[pos] == '\t')) {
      !pos = pos + 1
    };
    if (pos >= chars.size()) {
      break void;
    };
    if (chars[pos] != '@') {
      continue;
    };
    !pos = pos + 1;
    if (pos >= chars.size()) {
      break void
    };
    tryMatchAnnotation(chars, pos) match {
    | None() -> continue
    | Some((_annot, isFullMatch, newPos)) ->
      !pos = newPos;
      if (!isFullMatch) continue
    };
    while (pos < chars.size() && (chars[pos] == ' ' || chars[pos] == '\t')) {
      !pos = pos + 1
    };
    restOfLineStart = pos;
    while (pos < chars.size() && chars[pos] != '\n') {
      !pos = pos + 1;
    };
    restOfLine = String::fromChars(
      chars.slice(restOfLineStart, pos),
    ).trimForComparison();
    lastResultI = result.size() - 1;
    result.maybeGet(lastResultI) match {
    | Some(lastResult) if (lastResult.line == lineNumber) ->
      if (lastResult.expectedErrors.contains(restOfLine)) {
        invariant_violation(
          `Line ${lineNumber}: duplicate annotation: ${restOfLine}`,
        )
      };
      result![lastResultI] = lastResult with {
        line => lineNumber + 1,
        expectedErrors => lastResult.expectedErrors.add(restOfLine),
      }
    | _ ->
      result.push(
        ExpectError{
          line => lineNumber + 1,
          expectedErrors => SortedSet[restOfLine],
        },
      )
    }
  };
  result
}

fun isDigit(c: Char): Bool {
  c >= '0' && c <= '9'
}

fun isFileNameChar(c: Char): Bool {
  c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || isDigit(c) || c == '.'
}

fun isNotEOL(c: Char): Bool {
  c != '\n' && c != '\r'
}

class TSConformanceReferenceError{
  fileName: String,
  column: Int,
  errorCode: Int,
  message: String,
  extraMessages: Array<String>,
} extends ReferenceError {
  fun validate(
    _fileName: SKJS.FAbsolute,
    _errors: Sequence<SKJS.Error>,
  ): ?SKTest.ExpectationError {
    // Maybe TODO: check errors contains a single error?
    // Error messages do not match anyway, let's assume it's the same error
    None()
  }
  fun getMessage(): String {
    `TS${this.errorCode} ${this.message}`
  }
}

/* Parses the first lines of a TypeScript conformance reference errors file and returns them */
mutable class TSConformanceReferenceErrorsParser private {
  private fileName: String,
  private chars: Array<Char>,
  private mutable pos: Int = 0,
  private mutable lineNumber: Int = 1,
  private mutable lineStart: Int = 0,
} {
  static fun parse(
    fileName: String,
  ): mutable Iterator<TSConformanceReferenceError> {
    contents = FileSystem.readTextFile(fileName);
    chars = contents.chars().toArray();
    p = mutable static{fileName, chars};
    p.file()
  }

  readonly fun currentPosition(): String {
    c = this.pos - this.lineStart + 1;
    `File ${this.fileName}, line ${this.lineNumber}, character ${c} (position ${
      this.pos
    })`
  }

  mutable fun file(): mutable Iterator<TSConformanceReferenceError> {
    loop {
      invariant(
        this.pos < this.chars.size(),
        `${this.currentPosition()}: Expected more error lines`,
      );
      this.possibleEatChar('\r');
      if (this.chars[this.pos] == '\n') {
        break void;
      };
      fileName = this.readString(isFileNameChar);
      this.eatChar('(');
      line = this.readInt();
      this.eatChar(',');
      column = this.readInt();
      this.eatString("): error TS");
      errorCode = this.readInt();
      invariant(
        errorCode >= 1000 && errorCode <= 9999,
        `${this.currentPosition()}: Error code ${errorCode} is expected to be between 1000 and 9999`,
      );
      this.eatString(": ");
      message = this.readString(isNotEOL);
      this.possibleEatChar('\r');
      this.eatChar('\n');
      extraMessages = this.extra().collect(Array);
      yield TSConformanceReferenceError{
        fileName,
        line,
        column,
        errorCode,
        message,
        extraMessages,
      };
    };
    loop {
      invariant(
        this.pos < this.chars.size(),
        `${this.currentPosition()}: Expected more lines after errors`,
      );
      if (this.chars[this.pos] == '=') {
        this.eatString("==== ");
        break void;
      };
      this.possibleEatChar('\r');
      invariant(
        this.chars[this.pos] == '\n',
        `${this.currentPosition()}: Unexpected character ${this.chars[
          this.pos,
        ]} after errors`,
      );
      this.eatChar('\n');
    }
  }

  mutable fun nextChar(): void {
    if (this.chars[this.pos] == '\n') {
      this.!lineNumber = this.lineNumber + 1;
      this.!lineStart = this.pos + 1;
    };
    this.!pos = this.pos + 1;
  }

  mutable fun possibleEatChar(c: Char): void {
    if (this.pos < this.chars.size() && this.chars[this.pos] == c) {
      this.nextChar();
    }
  }

  mutable fun eatChar(c: Char): void {
    invariant(
      this.pos < this.chars.size(),
      `${this.currentPosition()}: Expected character ${c} but got end of file`,
    );
    invariant(
      this.chars[this.pos] == c,
      `${this.currentPosition()}: Expected character ${c} but got ${this.chars[
        this.pos,
      ]}`,
    );
    this.nextChar();
  }

  mutable fun eatString(s: String): void {
    for (c in s.chars()) {
      this.eatChar(c);
    }
  }

  mutable fun readInt(): Int {
    this.readString(isDigit).toInt()
  }

  mutable fun readString(validChar: Char -> Bool): String {
    start = this.pos;
    while (this.pos < this.chars.size() && validChar(this.chars[this.pos])) {
      this.nextChar();
    };
    invariant(
      this.pos > start,
      `${this.currentPosition()}: Expected non-empty string`,
    );
    String::fromChars(this.chars.slice(start, this.pos))
  }

  mutable fun extra(): mutable Iterator<String> {
    loop {
      invariant(
        this.pos < this.chars.size(),
        `${this.currentPosition()}: Unexpected end of file while reading extra`,
      );
      if (this.chars[this.pos] != ' ') {
        break void;
      };
      this.eatString("  ");
      yield this.readString(isNotEOL);
      this.possibleEatChar('\r');
      this.eatChar('\n');
    }
  }
}

fun parseTSConformanceReferenceErrors(
  fileName: String,
): mutable Iterator<TSConformanceReferenceError> {
  TSConformanceReferenceErrorsParser::parse(fileName)
}

module end;

module SKJS;

extension class Checker {
  fun errorsToString(
    context: mutable SKStore.Context,
    errs: Sequence<Error>,
  ): String {
    errs.map(err -> this.errorToString(context, err)).join(" / ")
  }
}

module end;
