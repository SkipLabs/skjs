module SKJSTests;

base class ReferenceError{line: Int} {
  fun validate(
    subst: mutable SKJS.Subst,
    tenv: SKJS.TEnv,
    fileName: SKJS.FPath,
    errors: Sequence<SKJS.Error>,
  ): ?SKTest.ExpectationError;
  fun getMessage(): String;
}

base class AnnotationKind final () {
  const str: String;
  const chars: Vector<Char>;
}

class TS_EXPECT_ERROR extends AnnotationKind {
  const str: String = "ts-expect-error";
  const chars: Vector<Char> = TS_EXPECT_ERROR::str.chars();
}

class SKJS_EXPECT_ERROR extends AnnotationKind {
  const str: String = "skjs-expect-error";
  const chars: Vector<Char> = SKJS_EXPECT_ERROR::str.chars();
}

base class UpdateMode {
  children =
  | UMValidateOnly()

  static fun fromEnv(): UpdateMode {
    Environ.varOpt("UPDATE_EXPECT") match {
    | Some("1") -> UMUpdate()
    | Some("2") -> UMFullMessages()
    | Some("3") -> UMFullRewrite()
    | None() -> UMValidateOnly()
    | Some(v) ->
      print_string(
        `Warning: Unknown UPDATE_EXPECT value "${v}", defaulting to 1\n`,
      );
      UMUpdate()
    }
  }
}

base class UMDoUpdate extends UpdateMode {
  children =
  | UMUpdate()
  | UMFullMessages()
  | UMFullRewrite()
}

extension class .String {
  // Keep first line only, right-trimmed. When trimDots is true, also strip
  // trailing dots (and whitespace exposed by their removal).
  fun trimMessage(trimDots: Bool = false): String {
    i = this.getIter();
    _ = i.find(c ~> c == '\n'); // Keep first line only
    _ = i.rfind(c ~> !String.isWhitespace(c)); // Ignore trailing whitespaces
    _ = i.next();
    if (trimDots) {
      i.rfind(c ~> c != '.') match { // Ignore trailing dots
      | None() -> return ""
      | Some(_) -> void
      };
      if (i.current() is Some('!')) {
        _ = i.next() // Do not ignore last dot following a !
      };
      _ = i.next(); // Advance past the non-dot char so rfind can see it
      // Trim whitespace exposed by dot removal (e.g. "msg   ...")
      i.rfind(c ~> !String.isWhitespace(c)) match {
      | None() -> return ""
      | Some(_) -> void
      };
      _ = i.next();
    };
    if (i.current() is None()) this else this.getIter().substring(i)
  }
}

class ExpectError{
  expectedErrors: SortedSet<String>,
  expectedLineNAnnotations: Map<Int, String>,
} extends ReferenceError {
  fun validate(
    subst: mutable SKJS.Subst,
    tenv: SKJS.TEnv,
    fileName: SKJS.FPath,
    errors: Sequence<SKJS.Error>,
  ): ?SKTest.ExpectationError {
    if (this.expectedErrors.size() > 0) {
      actuals = errors.map(errorToExpectMessage).collect(SortedSet);
      if (actuals != this.expectedErrors) {
        return Some(
          SKTest.ExpectationError(
            `${fileName}:${this.line} Wrong error message(s)`,
            this.getMessage(),
            actuals.toArray().join(" / "),
          ),
        )
      }
    };
    // @skjs-expect-error-lineN is only valid when exactly one @skjs-expect-error
    // is present. Continuation lines are checked against the first reported error
    // on that source line.
    if (!this.expectedLineNAnnotations.isEmpty()) {
      if (this.expectedErrors.size() != 1) {
        return Some(
          SKTest.ExpectationError(
            `${fileName}:${
              this.line
            } @skjs-expect-error-lineN requires exactly one @skjs-expect-error`,
            "(1 @skjs-expect-error annotation)",
            `(${this.expectedErrors.size()} @skjs-expect-error annotations)`,
          ),
        )
      };
      allMsgs = getErrorMessages(subst, tenv, errors.first());
      for ((n, expectedForN) in this.expectedLineNAnnotations.items()) {
        actualForN = if (n < 1 || n > allMsgs.size()) "" else {
          allMsgs[n - 1].trimMessage(true)
        };
        if (actualForN != expectedForN) {
          return Some(
            SKTest.ExpectationError(
              `${fileName}:${this.line} Wrong error message on line ${n}`,
              expectedForN,
              actualForN,
            ),
          )
        }
      }
    };
    None()
  }

  fun getMessage(): String {
    `${this.expectedErrors.toArray().join(" / ")}`
  }
}

/* Try to match an annotation kind at the given position in the char array.
 * Returns (str, isFullMatch, newPos) or None if the first char doesn't
 * match any annotation kind. */
fun tryMatchAnnotation(
  allChars: Array<Char>,
  pos: Int,
): ?(Concrete<AnnotationKind>, Bool, Int) {
  if (pos >= allChars.size()) return None();
  possibleAnnot = if (allChars[pos] == TS_EXPECT_ERROR::chars[0]) {
    TS_EXPECT_ERROR
  } else if (allChars[pos] == SKJS_EXPECT_ERROR::chars[0]) {
    SKJS_EXPECT_ERROR
  } else {
    return None()
  };
  posInAnnot = 0;
  do {
    !pos = pos + 1;
    !posInAnnot = posInAnnot + 1;
  } while (pos < allChars.size() &&
    posInAnnot < possibleAnnot::chars.size() &&
    allChars[pos] == possibleAnnot::chars[posInAnnot]);
  Some((possibleAnnot, posInAnnot >= possibleAnnot::chars.size(), pos))
}

class AnnotationLine{
  commentLineNumber: Int,
  annot: Concrete<AnnotationKind>,
  lineN: Int,
  message: String,
  originalMessage: String,
}

class AnnotationGroup{errorLine: Int, annotations: Array<AnnotationLine>}

fun errorToFullMessage(error: SKJS.Error): String {
  error match {
  | SKJS.SinglePosError(_pos, errorKind) -> errorKind.toString()
  | SKJS.TypingError(_, _, messages, _stErr) -> messages[0].i1
  | SKJS.NamingError(messages) -> messages[0].i1
  }
}

// Returns all message lines for one error. For TypingError this includes the
// primary messages followed by the expanded stErr detail lines.
fun getErrorMessages(
  subst: mutable SKJS.Subst,
  tenv: SKJS.TEnv,
  error: SKJS.Error,
): Array<String> {
  error match {
  | SKJS.SinglePosError(_, _) -> Array[errorToFullMessage(error)]
  | SKJS.TypingError(_, _, messages, e) ->
    stErrMsgs = e
      .toError(subst, tenv, SKJS.STErrorDetail::default)
      .toArray()
      .map(m -> m.i1);
    messages.map(m -> m.i1).concat(stErrMsgs)
  | SKJS.NamingError(messages) -> messages.map(m -> m.i1)
  }
}

fun getLineNAnnotationsFromError(
  subst: mutable SKJS.Subst,
  tenv: SKJS.TEnv,
  error: SKJS.Error,
): Map<Int, String> {
  result = mutable Map[];
  allMsgs = getErrorMessages(subst, tenv, error);
  for (lineIdx => lineText in allMsgs) {
    n = lineIdx + 1;
    if (n == 1) continue;
    trimmed = lineText.trimMessage(true);
    if (trimmed != "") {
      result.set(n, trimmed)
    }
  };
  result.chill()
}

fun errorToExpectMessage(error: SKJS.Error): String {
  errorToFullMessage(error).trimMessage(true)
}

/* Returns all expect-error annotation groups with their metadata.
 * Matches .*\/\/\s*(@(skjs|ts)-expect-error)\s+(?<rest-of-line>[^\n]*)
 * Consecutive annotations are grouped together; the error is expected
 * on the line after the last annotation in the group.
 *
 * Throws if the annotation is found somewhere else (e.g. not in a comment). */
fun findAnnotationLines(contents: String): readonly Vector<AnnotationGroup> {
  /*
    Correctness is based on the fact that these are all disjoint sets:
    - '\n'
    - ' ', '\t'
    - '/'
    - '@'
    - characters in TS_EXPECT_ERROR::chars union SKJS_EXPECT_ERROR::chars
    and on the fact that the first characters of TS_EXPECT_ERROR::chars and
    SKJS_EXPECT_ERROR::chars differ.
   */
  groups = mutable Vector[];
  currentGroup = mutable Vector[];
  lastCommentLine = -2;
  chars = contents.chars().toArray();
  pos = 0;
  // Do not trust the lexer's newLinesMap, as a way to double-check it
  lineNumber = 1;
  while (pos < chars.size()) {
    if (chars[pos] == '\n') {
      !lineNumber = lineNumber + 1;
    };
    if (chars[pos] == '@') {
      !pos = pos + 1;
      if (pos >= chars.size()) {
        break void
      };
      tryMatchAnnotation(chars, pos) match {
      | Some((annot, true, _newPos)) ->
        invariant_violation(`Line ${lineNumber}: misplaced @${annot::str}`)
      | Some((_, _, newPos)) -> !pos = newPos
      | None() -> void
      };
      continue;
    };
    if (chars[pos] != '/') {
      !pos = pos + 1;
      continue;
    };
    !pos = pos + 1;
    if (pos >= chars.size()) {
      break void;
    };
    if (chars[pos] != '/') {
      continue;
    };
    !pos = pos + 1;
    while (pos < chars.size() && (chars[pos] == ' ' || chars[pos] == '\t')) {
      !pos = pos + 1
    };
    if (pos >= chars.size()) {
      break void;
    };
    if (chars[pos] != '@') {
      continue;
    };
    !pos = pos + 1;
    if (pos >= chars.size()) {
      break void
    };
    annot = tryMatchAnnotation(chars, pos) match {
    | None() -> continue
    | Some((annot, isFullMatch, newPos)) ->
      !pos = newPos;
      if (!isFullMatch) continue;
      annot
    };
    // Try to match -lineN suffix for @skjs-expect-error-lineN annotations
    lineN = 1;
    if (annot::str == SKJS_EXPECT_ERROR::str) {
      tryMatchLineN(chars, pos) match {
      | Some((n, newPos)) ->
        !lineN = n;
        !pos = newPos
      | None() -> void
      }
    };
    while (pos < chars.size() && (chars[pos] == ' ' || chars[pos] == '\t')) {
      !pos = pos + 1
    };
    restOfLineStart = pos;
    while (pos < chars.size() && chars[pos] != '\n') {
      !pos = pos + 1;
    };
    rawEnd = pos;
    while (
      rawEnd > restOfLineStart &&
      (chars[rawEnd - 1] == ' ' || chars[rawEnd - 1] == '\t')
    ) {
      !rawEnd = rawEnd - 1
    };
    rawMessage = String::fromChars(chars.slice(restOfLineStart, rawEnd));
    if (lineNumber != lastCommentLine + 1 && currentGroup.size() > 0) {
      groups.push(
        AnnotationGroup{
          errorLine => lastCommentLine + 1,
          annotations => currentGroup.toArray(),
        },
      );
      currentGroup.clear()
    };
    currentGroup.push(
      AnnotationLine{
        commentLineNumber => lineNumber,
        annot,
        lineN,
        message => rawMessage.trimMessage(true),
        originalMessage => rawMessage,
      },
    );
    !lastCommentLine = lineNumber
  };
  if (currentGroup.size() > 0) {
    groups.push(
      AnnotationGroup{
        errorLine => lastCommentLine + 1,
        annotations => currentGroup.toArray(),
      },
    )
  };
  groups
}

fun findExpectErrors(contents: String): readonly Vector<ExpectError> {
  findAnnotationLines(contents).map(group -> {
    expectedErrors = SortedSet[];
    expectedLineNAnnotations = mutable Map[];
    for (a in group.annotations) {
      if (a.lineN == 1) {
        if (expectedErrors.contains(a.message)) {
          invariant_violation(
            `Line ${a.commentLineNumber}: duplicate annotation: ${
              a.originalMessage
            }`,
          )
        };
        !expectedErrors = expectedErrors.set(a.message)
      } else {
        if (expectedLineNAnnotations.containsKey(a.lineN)) {
          invariant_violation(
            `Line ${a.commentLineNumber}: duplicate annotation: ${
              a.originalMessage
            }`,
          )
        };
        expectedLineNAnnotations.set(a.lineN, a.message)
      }
    };
    ExpectError{
      line => group.errorLine,
      expectedErrors,
      expectedLineNAnnotations => expectedLineNAnnotations.chill(),
    }
  })
}

fun getIndent(line: String): String {
  i = line.getIter();
  _ = i.find(c ~> c != ' ' && c != '\t');
  _ = i.prev();
  line.getIter().substring(i)
}

fun emitLineNAnnotations(
  result: mutable Vector<String>,
  indent: String,
  lineNAnnotations: Map<Int, String>,
): void {
  for ((n, trimmed) in lineNAnnotations.items()) {
    if (trimmed != "") {
      result.push(`${indent}// @${SKJS_EXPECT_ERROR::str}-line${n} ${trimmed}`)
    }
  }
}

/* Rewrites a file's expect-error annotations to match actual errors.
 * - Updates messages for existing annotations (preserving @ts vs @skjs prefix)
 * - Removes annotations where errors no longer occur
 * - Adds @skjs-expect-error annotations for new errors
 * - At most one @ts-expect-error per group, always last */
fun updateFileAnnotations(
  contents: String,
  actualErrorsByLine: Map<Int, SortedSet<String>>,
  fullMessages: Map<String, String>,
  update: UMDoUpdate = UMUpdate(),
  actualLineNAnnotationsByLine: Map<Int, Map<Int, String>> = Map[],
): ?String {
  groups = findAnnotationLines(contents);
  lines = contents.split("\n");

  // Build set of annotation comment line numbers and maps for lookup
  commentLineNumbers = SortedSet[];
  lastTsExpect = mutable Map[]; // errorLine -> message (last @ts-expect-error)
  existingGroups = mutable Map[]; // errorLine -> AnnotationGroup
  for (group in groups) {
    existingGroups.set(group.errorLine, group);
    for (a in group.annotations) {
      !commentLineNumbers = commentLineNumbers.add(a.commentLineNumber);
    };
    // Only track @ts-expect-error for "emit last" if it's the last line-1 annotation
    lastLine1AnnotIdx = -1;
    for (aIdx in Range(0, group.annotations.size())) {
      if (group.annotations[aIdx].lineN == 1) {
        !lastLine1AnnotIdx = aIdx
      }
    };
    if (lastLine1AnnotIdx >= 0) {
      lastAnnot = group.annotations[lastLine1AnnotIdx];
      if (lastAnnot.annot::str == TS_EXPECT_ERROR::str) {
        lastTsExpect.set(group.errorLine, lastAnnot.message)
      }
    }
  };
  result = mutable Vector[];
  for (lineIdx => lineContents in lines) {
    lineNum = lineIdx + 1;
    if (commentLineNumbers.contains(lineNum)) {
      continue
    };
    // Insert updated annotations before this code line
    actualErrorsByLine.maybeGet(lineNum) match {
    | Some(errors) ->
      actualLineNAnnotationsOpt = actualLineNAnnotationsByLine.maybeGet(
        lineNum,
      );
      actualLineNAnnotations = actualLineNAnnotationsOpt.default(Map[]);
      hasLineNData = actualLineNAnnotationsOpt is Some(_);
      existingHasLineN = existingGroups
        .maybeGet(lineNum)
        .map(g -> g.annotations.any(a -> a.lineN != 1))
        .default(false);
      shouldEmitLineN = hasLineNData && existingHasLineN;
      // Check if existing annotations already match — preserve original order
      existingMatch = if (update is UMUpdate()) {
        existingGroups.maybeGet(lineNum) match {
        | Some(g) ->
          line1Msgs = SortedSet[];
          lineNAnnotations = mutable Map[];
          for (a in g.annotations) {
            if (a.lineN == 1) {
              !line1Msgs = line1Msgs.set(a.message)
            } else {
              lineNAnnotations.set(a.lineN, a.message)
            }
          };
          if (
            line1Msgs == errors &&
            (!existingHasLineN ||
              lineNAnnotations.chill() == actualLineNAnnotations)
          ) {
            Some(g)
          } else {
            None()
          }
        | _ -> None()
        }
      } else {
        None()
      };
      existingMatch match {
      | Some(g) ->
        for (a in g.annotations) {
          result.push(lines[a.commentLineNumber - 1])
        }
      | None() ->
        // Use original group indentation when available, fall back to code line
        groupIndent = getIndent(
          existingGroups
            .maybeGet(lineNum)
            .map(g -> lines[g.annotations[0].commentLineNumber - 1])
            .default(lineContents),
        );
        // @ts-expect-error emitted last only if it was the last annotation in the original group
        tsMsg = lastTsExpect.maybeGet(lineNum) match {
        | Some(msg) if (errors.contains(msg)) -> Some(msg)
        | _ -> None()
        };
        // Phase 1: Emit existing annotations still in errors, preserving order
        // (skip last @ts-expect-error — Phase 3 emits it; skip entirely when reordering)
        // (skip lineN annotations — they are re-emitted after all line-1 annotations)
        emitted = SortedSet[];
        if (!(update is UMFullRewrite())) {
          existingGroups.maybeGet(lineNum) match {
          | Some(g) ->
            for (a in g.annotations) {
              if (a.lineN != 1) continue;
              isTsMsg = tsMsg match {
              | Some(msg) if (msg == a.message) -> true
              | _ -> false
              };
              if (!isTsMsg && errors.contains(a.message)) {
                msgText = if (update is UMUpdate()) {
                  a.originalMessage
                } else {
                  fullMessages.maybeGet(a.message).default(a.message)
                };
                result.push(`${groupIndent}// @${a.annot::str} ${msgText}`);
                !emitted = emitted.set(a.message)
              }
            }
          | None() -> void
          }
        };
        // Phase 2: Emit new @skjs-expect-error annotations
        for (trimmedMsg in errors) {
          if (emitted.contains(trimmedMsg)) continue;
          tsMsg match {
          | Some(msg) if (msg == trimmedMsg) -> continue
          | _ -> void
          };
          msgText = fullMessages.maybeGet(trimmedMsg).default(trimmedMsg);
          result.push(`${groupIndent}// @${SKJS_EXPECT_ERROR::str} ${msgText}`)
        };
        // Phase 3: Emit @ts-expect-error last (only if new, not already emitted)
        tsMsg match {
        | Some(trimmedMsg) if (!emitted.contains(trimmedMsg)) ->
          msgText = fullMessages.maybeGet(trimmedMsg).default(trimmedMsg);
          result.push(`${groupIndent}// @${TS_EXPECT_ERROR::str} ${msgText}`)
        | _ -> void
        };
        // Emit lineN annotations after all line-1 annotations
        if (shouldEmitLineN) {
          emitLineNAnnotations(result, groupIndent, actualLineNAnnotations)
        }
      }
    | None() -> void
    };
    result.push(lineContents)
  };
  if (
    result.size() == lines.size() &&
    result.items().all(p -> p.i1 == lines[p.i0])
  ) {
    None()
  } else {
    Some("\n".join(result))
  }
}

fun isDigit(c: Char): Bool {
  c >= '0' && c <= '9'
}

fun isFileNameChar(c: Char): Bool {
  c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || isDigit(c) || c == '.'
}

fun isNotEOL(c: Char): Bool {
  c != '\n' && c != '\r'
}

// Tries to match "-lineN" (N >= 2) at pos. Returns (N, newPos) or None.
fun tryMatchLineN(chars: Array<Char>, pos: Int): ?(Int, Int) {
  suffix = "-line";
  suffixChars = suffix.chars().toArray();
  p = pos;
  matched = true;
  i = 0;
  while (matched && i < suffixChars.size()) {
    if (p >= chars.size() || chars[p] != suffixChars[i]) {
      !matched = false
    } else {
      !p = p + 1;
      !i = i + 1
    }
  };
  if (!matched || p >= chars.size() || !isDigit(chars[p])) {
    None()
  } else {
    numStart = p;
    !p = p + 1;
    while (p < chars.size() && isDigit(chars[p])) {
      !p = p + 1
    };
    n = String::fromChars(chars.slice(numStart, p)).toInt();
    if (n < 2) None() else Some((n, p))
  }
}

class TSConformanceReferenceError{
  fileName: String,
  column: Int,
  errorCode: Int,
  message: String,
  extraMessages: Array<String>,
} extends ReferenceError {
  fun validate(
    _subst: mutable SKJS.Subst,
    _tenv: SKJS.TEnv,
    _fileName: SKJS.FPath,
    _errors: Sequence<SKJS.Error>,
  ): ?SKTest.ExpectationError {
    // Maybe TODO: check errors contains a single error?
    // Error messages do not match anyway, let's assume it's the same error
    None()
  }
  fun getMessage(): String {
    `TS${this.errorCode} ${this.message}`
  }
}

/* Parses the first lines of a TypeScript conformance reference errors file and returns them */
mutable class TSConformanceReferenceErrorsParser private {
  private fileName: String,
  private chars: Array<Char>,
  private mutable pos: Int = 0,
  private mutable lineNumber: Int = 1,
  private mutable lineStart: Int = 0,
} {
  static fun parse(
    fileName: String,
  ): mutable Iterator<TSConformanceReferenceError> {
    contents = FileSystem.readTextFile(fileName);
    chars = contents.chars().toArray();
    p = mutable static{fileName, chars};
    p.file()
  }

  readonly fun currentPosition(): String {
    c = this.pos - this.lineStart + 1;
    `File ${this.fileName}, line ${this.lineNumber}, character ${c} (position ${
      this.pos
    })`
  }

  mutable fun file(): mutable Iterator<TSConformanceReferenceError> {
    loop {
      invariant(
        this.pos < this.chars.size(),
        `${this.currentPosition()}: Expected more error lines`,
      );
      this.possibleEatChar('\r');
      if (this.chars[this.pos] == '\n') {
        break void;
      };
      fileName = this.readString(isFileNameChar);
      this.eatChar('(');
      line = this.readInt();
      this.eatChar(',');
      column = this.readInt();
      this.eatString("): error TS");
      errorCode = this.readInt();
      invariant(
        errorCode >= 1000 && errorCode <= 9999,
        `${this.currentPosition()}: Error code ${errorCode} is expected to be between 1000 and 9999`,
      );
      this.eatString(": ");
      message = this.readString(isNotEOL);
      this.possibleEatChar('\r');
      this.eatChar('\n');
      extraMessages = this.extra().collect(Array);
      yield TSConformanceReferenceError{
        fileName,
        line,
        column,
        errorCode,
        message,
        extraMessages,
      };
    };
    loop {
      invariant(
        this.pos < this.chars.size(),
        `${this.currentPosition()}: Expected more lines after errors`,
      );
      if (this.chars[this.pos] == '=') {
        this.eatString("==== ");
        break void;
      };
      this.possibleEatChar('\r');
      invariant(
        this.chars[this.pos] == '\n',
        `${this.currentPosition()}: Unexpected character ${this.chars[
          this.pos,
        ]} after errors`,
      );
      this.eatChar('\n');
    }
  }

  mutable fun nextChar(): void {
    if (this.chars[this.pos] == '\n') {
      this.!lineNumber = this.lineNumber + 1;
      this.!lineStart = this.pos + 1;
    };
    this.!pos = this.pos + 1;
  }

  mutable fun possibleEatChar(c: Char): void {
    if (this.pos < this.chars.size() && this.chars[this.pos] == c) {
      this.nextChar();
    }
  }

  mutable fun eatChar(c: Char): void {
    invariant(
      this.pos < this.chars.size(),
      `${this.currentPosition()}: Expected character ${c} but got end of file`,
    );
    invariant(
      this.chars[this.pos] == c,
      `${this.currentPosition()}: Expected character ${c} but got ${this.chars[
        this.pos,
      ]}`,
    );
    this.nextChar();
  }

  mutable fun eatString(s: String): void {
    for (c in s.chars()) {
      this.eatChar(c);
    }
  }

  mutable fun readInt(): Int {
    this.readString(isDigit).toInt()
  }

  mutable fun readString(validChar: Char -> Bool): String {
    start = this.pos;
    while (this.pos < this.chars.size() && validChar(this.chars[this.pos])) {
      this.nextChar();
    };
    invariant(
      this.pos > start,
      `${this.currentPosition()}: Expected non-empty string`,
    );
    String::fromChars(this.chars.slice(start, this.pos))
  }

  mutable fun extra(): mutable Iterator<String> {
    loop {
      invariant(
        this.pos < this.chars.size(),
        `${this.currentPosition()}: Unexpected end of file while reading extra`,
      );
      if (this.chars[this.pos] != ' ') {
        break void;
      };
      this.eatString("  ");
      yield this.readString(isNotEOL);
      this.possibleEatChar('\r');
      this.eatChar('\n');
    }
  }
}

fun parseTSConformanceReferenceErrors(
  fileName: String,
): mutable Iterator<TSConformanceReferenceError> {
  TSConformanceReferenceErrorsParser::parse(fileName)
}

module end;

module SKJS;

extension class Checker {
  fun errorsToString(
    context: mutable SKStore.Context,
    errs: Sequence<Error>,
  ): String {
    errs.map(err -> this.errorToString(context, err)).join(" / ")
  }
}

module end;
