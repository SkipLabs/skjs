module SKJSTests;

// An array literal's commitment is a dependency even when its original
// element list is empty. Reuse one obligation across later binding changes.
@test
fun testHiddenEscapeThroughArrayCommitment(): void {
  context = SKStore.Context::mcreate{};
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  base = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::createCheckingOwner(base);
  pos = SKJS.PosRange::none;
  hidden = subst.genSkolemTParam(pos, "hidden", None());
  hiddenType = SKJS.TType::ofClauses(
    pos,
    SKJS.Clauses::single(hidden.withoutConstraint()),
  );
  commitment = SKJS.ArrayLiteralSelector::create(subst, pos);
  element = subst.gen(pos);
  root = SKJS.TType::arrayLit(commitment, Array[], Array[]);
  check = SKJS.HiddenEscapeCheck(
    pos,
    SortedSet[hidden.id],
    Array[root],
    "escape",
    2080,
  );
  SKTest.expectEq(false, check.fails(subst));
  commitment.commit(
    subst,
    observationTypeEnv(observationSubst()),
    SKJS.TType::inst(
      SKJS.Name(pos, "Array"),
      SKJS.TArgs(Array[SKJS.TType::var(element)]),
    ),
  );
  SKTest.expectEq(false, check.fails(subst));
  saved = subst.save();
  observationBind(subst, element, hiddenType, false);
  direct = SKJS.HiddenEscapeCheck(
    pos,
    SortedSet[hidden.id],
    Array[SKJS.TType::var(element)],
    "escape",
    2080,
  );
  SKTest.expectEq(true, direct.fails(subst));
  SKTest.expectEq(true, check.fails(subst));
  subst.restore(saved);
  SKTest.expectEq(false, check.fails(subst));
}

@test
fun testSubstSemanticEpochDoesNotRewind(): void {
  context = SKStore.Context::mcreate{};
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  base = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::createCheckingOwner(base);
  pos = SKJS.PosRange::none;

  saved = subst.save();
  savedVersion = subst.inferenceVersion();
  initialEpoch = subst.typeOwnerEpoch();
  _ = subst.gen(pos);
  afterGrowthEpoch = subst.typeOwnerEpoch();

  SKTest.expectEq(savedVersion + 1, subst.inferenceVersion());
  SKTest.expectEq(initialEpoch + 1, afterGrowthEpoch);

  subst.restore(saved);
  SKTest.expectEq(savedVersion, subst.inferenceVersion());
  SKTest.expectEq(afterGrowthEpoch + 1, subst.typeOwnerEpoch());
}

// Hidden identity is separate from diagnostic spelling and survives renaming.
@test
fun testHiddenWitnessSyntheticNamespace(): void {
  context = SKStore.Context::mcreate{};
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  base = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::createCheckingOwner(base);
  hidden = subst.genSkolemTParam(SKJS.PosRange::none, "hidden", None());
  ordinary = SKJS.Id::createSynthetic("skolem:0");
  SKTest.expectEq(false, hidden.id == ordinary);
  SKTest.expectEq(true, hidden.id.isHiddenWitness());
  SKTest.expectEq(false, ordinary.isHiddenWitness());
  SKTest.expectEq(true, hidden.id.prefixWith("$").isHiddenWitness());
  SKTest.expectEq(true, hidden.id.prefixWith("$").isSynthetic());
  SKTest.expectEq(true, ordinary.prefixWith("$").isSynthetic());
}

@test
fun testHiddenWitnessAllocationDoesNotRewindWithInference(): void {
  context = SKStore.Context::mcreate{};
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  base = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::createCheckingOwner(base);
  pos = SKJS.PosRange::none;
  before = subst.genSkolemTParam(pos, "hidden", None());
  checkpoint = subst.skolemCheckpoint();
  saved = subst.save();
  abandoned = subst.genSkolemTParam(pos, "hidden", None());
  _ = subst.gen(pos);
  subst.restore(saved);
  after = subst.genSkolemTParam(pos, "hidden", None());
  SKTest.expectEq(false, before.id == after.id);
  SKTest.expectEq(false, abandoned.id == after.id);
  SKTest.expectEq(
    SortedSet[abandoned.id, after.id],
    subst.skolemIdsSince(checkpoint),
  );
}

fun tryHiddenWitnessAllocation(subst: mutable SKJS.Subst): ?SKJS.Id {
  minted: ?SKJS.Id = None();
  try {
    !minted = Some(
      subst.genSkolemTParam(SKJS.PosRange::none, "hidden", None()).id,
    )
  } catch {
  | InvariantViolation(_) -> void
  | exn -> throw exn
  };
  minted
}

// All detached construction routes need the same witness-allocation boundary.
@test
fun testHiddenWitnessAllocationAuthorities(): void {
  owner = observationSubst();
  pos = SKJS.PosRange::none;
  first = owner.genSkolemTParam(pos, "hidden", None());
  SKTest.expectEq(
    None(),
    tryHiddenWitnessAllocation(owner.compatibilityProbe()),
  );
  SKTest.expectEq(
    None(),
    tryHiddenWitnessAllocation(owner.diagnosticComputation()),
  );
  // Detached construction must not restart the owner's namespace.
  SKTest.expectEq(
    None(),
    tryHiddenWitnessAllocation(SKJS.Subst::mcreate(owner)),
  );
  SKTest.expectEq(
    None(),
    tryHiddenWitnessAllocation(owner.testMcreateWithState(owner)),
  );
  SKTest.expectEq(
    None(),
    tryHiddenWitnessAllocation(
      SKJS.Subst::mcreateFromSaved(owner.context, owner.saveAll()),
    ),
  );
  after = owner.genSkolemTParam(pos, "hidden", None());
  SKTest.expectEq(false, first.id == after.id);
}

module end;
