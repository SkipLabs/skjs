// Converts a CGNode_ to a short descriptor string for test assertions.
// Format: "fn:<name>", "method:<class>.<name>", "static:<class>.<name>",
//         "ctor:<class>", "toplevel", "arrow-annot", "lambda", "anonFun:<name>"
module SKJS;

extension base class CGNode_ {
  fun descriptor(): String {
    this match {
    | TopLevelFunction(name, _) -> `fn:${name.getName()}`
    | Method(name, class_, static_) ->
      prefix = if (static_) "static" else "method";
      `${prefix}:${class_.value}.${name.getName()}`
    | Constructor(class_, _) -> `ctor:${class_.value}`
    | Toplevel(_) -> "toplevel"
    | ArrowTypeAnnot(_) -> "arrow-annot"
    | AnonymousLambda(pos, _) -> `lambda:${pos.symbol}@${pos.relStart.value}`
    | AnonymousFunDef(fd) -> `anonFun:${fd.name.getName()}`
    }
  }

  fun isSynthetic(): Bool {
    this is ArrowTypeAnnot _ || this is AnonymousLambda _
  }
}

module end;

module SKJSTests;

// Parsed callgraph block: entries, full mode flag, closure mode flag,
// directive line index, and block end index (first line after the entries).
value class ParsedCallgraph(
  entries: Array<(String, Array<String>)>,
  full: Bool,
  closure: Bool,
  directiveIdx: Int,
  blockEnd: Int,
)

// Parses callgraph directive blocks from file contents. A file may
// contain multiple blocks (e.g. one direct-edge and one closure block).
// Recognized directives:
//   @skjs-callgraph            — direct edges, exclude synthetic nodes
//   @skjs-callgraph-full       — direct edges, include synthetic nodes
//   @skjs-callgraph-closure    — transitive closure, exclude synthetic nodes
//   @skjs-callgraph-closure-full — transitive closure, include synthetic nodes
// Returns Success(empty) if no directive, Success(blocks) on success,
// or Failure(msg) on error.
fun parseCallgraph(contents: String): Result<Array<ParsedCallgraph>, String> {
  lines = contents.split("\n").map(l -> l.trim());
  blocks = mutable Vector[];
  seenDirect = false;
  seenClosure = false;
  for (i => line in lines) {
    isClosureFull = line == "// @skjs-callgraph-closure-full";
    isClosure = line == "// @skjs-callgraph-closure";
    isFull = line == "// @skjs-callgraph-full";
    isBase = line == "// @skjs-callgraph";
    if (isClosureFull || isClosure || isFull || isBase) {
      full = isClosureFull || isFull;
      closure = isClosureFull || isClosure;
      if (closure && seenClosure) {
        return Failure(`duplicate closure directive at line ${i + 1}`)
      };
      if (!closure && seenDirect) {
        return Failure(`duplicate direct-edge directive at line ${i + 1}`)
      };
      if (closure) !seenClosure = true else !seenDirect = true;
      entries = mutable Vector[];
      blockEnd = i + 1;
      for (j in Range(i + 1, lines.size())) {
        jline = lines[j];
        if (!jline.startsWith("// ")) break void;
        rest = jline.sub(jline.getIter().forward(3), jline.length() - 3).trim();
        if (rest == "") break void;
        parts = rest.split(": ");
        if (parts.size() != 2) {
          return Failure(`malformed callgraph entry at line ${j + 1}: ${rest}`)
        };
        caller = parts[0].trim();
        calleesStr = parts[1].trim();
        callees = calleesStr
          .split(",")
          .map(s -> s.trim())
          .filter(s -> s != "")
          .collect(Array);
        entries.push((caller, callees));
        !blockEnd = j + 1
      };
      blocks.push(
        ParsedCallgraph(entries.toArray(), full, closure, i, blockEnd),
      )
    } else if (line.contains("@skjs-callgraph")) {
      return Failure(`stray @skjs-callgraph at line ${i + 1}: ${line}`)
    }
  };
  Success(blocks.toArray())
}

// Formats an adjacency map as a readable string for error messages.
fun formatAdjMap(adjMap: readonly Map<String, readonly Set<String>>): String {
  if (adjMap.size() == 0) return "(empty)";
  lines = mutable Vector[];
  for (caller in adjMap.keys().collect(Array).sorted()) {
    calleeStr = adjMap[caller].collect(Array).sorted().join(", ");
    lines.push(`${caller}: ${calleeStr}`)
  };
  lines.join("\n")
}

// Updates callgraph annotations in a file based on the actual callgraph.
fun updateCallgraphAnnotations(
  fileName: SKJS.FAbsolute,
  fileContents: String,
  actual: readonly Map<String, readonly Set<String>>,
  parsed: ParsedCallgraph,
  update: UMDoUpdate,
): void {
  rawLines = fileContents.split("\n");
  directiveIdx = parsed.directiveIdx;
  blockEnd = parsed.blockEnd;
  full = parsed.full;
  existingEntries = parsed.entries;

  result = mutable Vector[];
  for (i in Range(0, directiveIdx)) {
    result.push(rawLines[i])
  };

  directive = if (full) "// @skjs-callgraph-full" else "// @skjs-callgraph";
  result.push(directive);

  update match {
  | UMFullRewrite() ->
    // Level 3: sort callers and callees
    for (caller in actual.keys().collect(Array).sorted()) {
      callees = actual[caller].collect(Array).sorted().join(", ");
      result.push(`// ${caller}: ${callees}`)
    }
  | UMFullMessages() ->
    // Level 2: sort callers, preserve callee order (+ append new, - stale)
    existingCalleesOrder = Map::createFromItems(
      existingEntries.map(entry -> (entry.i0, entry.i1)),
    );
    for (caller in actual.keys().collect(Array).sorted()) {
      actualCallees = actual[caller];
      calleeList = existingCalleesOrder.maybeGet(caller) match {
      | Some(oldCallees) ->
        // Keep existing order for callees that still exist, append new ones
        kept = oldCallees.filter(c -> actualCallees.contains(c));
        newOnes = actualCallees.collect(Array).sorted().filter(c ->
          !Set::createFromItems(oldCallees).contains(c)
        );
        kept.concat(newOnes)
      | None() ->
        // New caller: use sorted order
        actualCallees.collect(Array).sorted()
      };
      result.push(`// ${caller}: ${calleeList.join(", ")}`)
    }
  | UMUpdate() ->
    // Level 1: preserve existing caller order, insert new at sorted position
    existingCallers = existingEntries.map(e -> e.i0);
    existingCalleesOrder = Map::createFromItems(
      existingEntries.map(entry -> (entry.i0, entry.i1)),
    );
    // Callers that still exist, in original order
    keptCallers = existingCallers.filter(c -> actual.containsKey(c));
    // New callers not in original
    newCallers = actual
      .keys()
      .collect(Array)
      .filter(c -> !existingCalleesOrder.containsKey(c))
      .sorted();

    // Merge: insert each new caller at its sorted position among kept callers
    allCallers = mutable Vector[];
    newIdx = 0;
    for (caller in keptCallers) {
      while (newIdx < newCallers.size() && newCallers[newIdx] < caller) {
        allCallers.push(newCallers[newIdx]);
        !newIdx = newIdx + 1
      };
      allCallers.push(caller)
    };
    while (newIdx < newCallers.size()) {
      allCallers.push(newCallers[newIdx]);
      !newIdx = newIdx + 1
    };

    for (caller in allCallers) {
      actualCallees = actual[caller];
      calleeList = existingCalleesOrder.maybeGet(caller) match {
      | Some(oldCallees) ->
        kept = oldCallees.filter(c -> actualCallees.contains(c));
        newOnes = actualCallees.collect(Array).sorted().filter(c ->
          !Set::createFromItems(oldCallees).contains(c)
        );
        kept.concat(newOnes)
      | None() -> actualCallees.collect(Array).sorted()
      };
      result.push(`// ${caller}: ${calleeList.join(", ")}`)
    }
  };

  for (i in Range(blockEnd, rawLines.size())) {
    result.push(rawLines[i])
  };

  if (
    result.size() != rawLines.size() ||
    !result.items().all(p -> p.i1 == rawLines[p.i0])
  ) {
    FileSystem.writeTextFile(fileName.toString(), "\n".join(result));
    print_string(`Updated: ${fileName}\n`)
  }
}

// Computes the transitive closure of an adjacency map.
// Returns a map from each node to the set of all nodes reachable from it.
fun computeTransitiveClosure(
  adj: readonly Map<String, readonly Set<String>>,
): Map<String, Set<String>> {
  allNodes = mutable Set[];
  for (caller => callees in adj) {
    allNodes.insert(caller);
    for (callee in callees) allNodes.insert(callee);
  };
  result: mutable Map<String, Set<String>> = mutable Map[];
  for (node in allNodes) {
    visited = mutable Set[];
    worklist = mutable Vector[node];
    while (worklist.size() > 0) {
      current = worklist.pop();
      if (visited.contains(current)) continue;
      visited.insert(current);
      adj.maybeGet(current) match {
      | Some(nexts) ->
        for (next in nexts) {
          if (!visited.contains(next)) worklist.push(next)
        }
      | None() -> void
      }
    };
    // Remove self from reachable set
    visited.remove(node);
    if (visited.size() > 0) {
      result![node] = Set::createFromIterator(visited.values())
    }
  };
  Map::createFromIterator(result.items())
}

// Main validator for callgraph tests.
fun validateCallGraph(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
  update: UpdateMode,
): Array<SKTest.ExpectationError> {
  fileName = checkResult.fileName;
  parseErrorOpt = checkResult.parseError;
  typeErrors = checkResult.errors;

  if (parseErrorOpt is Some _) {
    return Array[
      SKTest.ExpectationError(
        `${fileName}: Parse error in callgraph test`,
        "no parse errors",
        "parse error found",
      ),
    ]
  };

  if (typeErrors.size() > 0) {
    return Array[
      SKTest.ExpectationError(
        `${fileName}: Type errors in callgraph test`,
        "no type errors",
        `${typeErrors.size()} type error(s) found`,
      ),
    ]
  };

  fileContents = checker.files.filesContent.get(context, fileName).value;

  parsedBlocks = parseCallgraph(fileContents) match {
  | Failure(msg) ->
    return Array[
      SKTest.ExpectationError(
        `${fileName}: Callgraph parse error`,
        "valid callgraph block",
        msg,
      ),
    ]
  | Success(blocks) if (blocks.size() == 0) ->
    // Skip declaration files (stubs/builtins) silently
    if (fileName.toString().endsWith(".d.ts")) return Array[];
    return Array[
      SKTest.ExpectationError(
        `${fileName}: No @skjs-callgraph directive found`,
        "@skjs-callgraph or @skjs-callgraph-full",
        "no directive",
      ),
    ]
  | Success(blocks) -> blocks
  };

  // Build the full (unfiltered) adjacency map once — used by all blocks
  fullAdj: mutable Map<String, mutable Set<String>> = mutable Map[];
  checkResult.callgraph.each((caller, callees) -> {
    callerDesc = caller.id.descriptor();
    for (callee in callees) {
      calleeDesc = callee.id.descriptor();
      if (!fullAdj.containsKey(callerDesc)) {
        fullAdj![callerDesc] = mutable Set[];
      };
      fullAdj[callerDesc].insert(calleeDesc);
    }
  });
  for ((sub, sup) in checkResult.subtypingEdges) {
    supDesc = sup.id.descriptor();
    subDesc = sub.id.descriptor();
    if (!fullAdj.containsKey(supDesc)) {
      fullAdj![supDesc] = mutable Set[];
    };
    fullAdj[supDesc].insert(subDesc);
  };

  // Collect synthetic descriptors
  syntheticDescs = mutable Set[];
  checkResult.callgraph.each((caller, callees) -> {
    if (caller.id.isSynthetic()) syntheticDescs.insert(caller.id.descriptor());
    for (callee in callees) {
      if (callee.id.isSynthetic()) syntheticDescs.insert(callee.id.descriptor())
    }
  });
  for ((sub, sup) in checkResult.subtypingEdges) {
    if (sub.id.isSynthetic()) syntheticDescs.insert(sub.id.descriptor());
    if (sup.id.isSynthetic()) syntheticDescs.insert(sup.id.descriptor());
  };

  errors = mutable Vector[];

  for (parsed in parsedBlocks) {
    expectedAdj: Map<String, Set<String>> = Map::createFromItems(
      parsed.entries.map(e -> (e.i0, Set::createFromItems(e.i1))),
    );
    full = parsed.full;

    // Filter synthetic nodes from adjacency map when needed
    filteredAdj: Map<String, Set<String>> = if (full) {
      Map::createFromItems(
        fullAdj
          .items()
          .map(p -> (p.i0, Set::createFromItems(p.i1.toArray())))
          .collect(Array),
      )
    } else {
      Map::createFromIterator(
        fullAdj
          .items()
          .filter(p -> !syntheticDescs.contains(p.i0))
          .map(p -> {
            filtered = p.i1.filter(s -> !syntheticDescs.contains(s)).values();
            (p.i0, Set::createFromIterator(filtered))
          })
          .filter(p -> p.i1.size() > 0),
      )
    };

    // In update mode, rewrite direct-edge blocks
    if (!parsed.closure) {
      update match {
      | doUpdate @ UMDoUpdate _ ->
        updateCallgraphAnnotations(
          fileName.toAbsolute(checker.files.rootMap),
          fileContents,
          filteredAdj,
          parsed,
          doUpdate,
        );
        continue
      | _ -> void
      }
    };

    checkAdj: Map<String, Set<String>> = if (parsed.closure) {
      // Invert the callgraph to get the depgraph, then compute transitive
      // closure. This answers "if X changes, which nodes are affected?"
      depAdj: mutable Map<String, mutable Set<String>> = mutable Map[];
      for (caller => callees in fullAdj) {
        for (callee in callees) {
          if (!depAdj.containsKey(callee)) {
            depAdj![callee] = mutable Set[];
          };
          depAdj[callee].insert(caller);
        }
      };
      closureAdj = computeTransitiveClosure(depAdj);
      if (full) {
        closureAdj
      } else {
        Map::createFromIterator(
          closureAdj
            .items()
            .filter(p -> !syntheticDescs.contains(p.i0))
            .map(p -> {
              filtered = p.i1.filter(s -> !syntheticDescs.contains(s));
              (p.i0, filtered)
            })
            .filter(p -> p.i1.size() > 0),
        )
      }
    } else {
      filteredAdj
    };

    for (caller => expectedCallees in expectedAdj) {
      checkAdj.maybeGet(caller) match {
      | None() ->
        errors.push(
          SKTest.ExpectationError(
            `${fileName}: Missing caller in callgraph`,
            `${caller}: ${expectedCallees.collect(Array).sorted().join(", ")}`,
            `actual callgraph:\n${formatAdjMap(checkAdj)}`,
          ),
        )
      | Some(actualCallees) ->
        for (callee in expectedCallees) {
          if (!actualCallees.contains(callee)) {
            errors.push(
              SKTest.ExpectationError(
                `${fileName}: Missing callee for ${caller}`,
                `${caller}: ${expectedCallees
                  .collect(Array)
                  .sorted()
                  .join(", ")}`,
                `${caller}: ${actualCallees
                  .collect(Array)
                  .sorted()
                  .join(", ")}`,
              ),
            )
          }
        };
        if (!parsed.closure) {
          for (callee in actualCallees) {
            if (!expectedCallees.contains(callee)) {
              errors.push(
                SKTest.ExpectationError(
                  `${fileName}: Unexpected callee for ${caller}`,
                  `${caller}: ${expectedCallees
                    .collect(Array)
                    .sorted()
                    .join(", ")}`,
                  `${caller}: ${actualCallees
                    .collect(Array)
                    .sorted()
                    .join(", ")}`,
                ),
              )
            }
          }
        }
      }
    };

    if (!parsed.closure) {
      for (caller => actualCallees in checkAdj) {
        if (!expectedAdj.containsKey(caller)) {
          errors.push(
            SKTest.ExpectationError(
              `${fileName}: Unexpected caller in callgraph`,
              "no extra callers",
              `${caller}: ${actualCallees.collect(Array).sorted().join(", ")}`,
            ),
          )
        }
      }
    }
  };

  errors.toArray()
}

module end;
