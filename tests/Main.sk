module SKJSTests;

fun getLinedTypeErrors(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FAbsolute,
  typeErrors: Array<SKJS.Error>,
): Array<(Int, SKJS.TypingError)> {
  newLines = checker.newLinesMap.get(context, fileName);
  symbols = checker.symbolsMap.get(context, fileName);
  resolver = SKJS.PositionResolver{fileName, newLines, symbols};

  typeErrors
    .map(err ->
      err match {
      | e @ SKJS.TypingError(messages) ->
        invariant(!messages.isEmpty(), "Empty typing error");
        pos = messages[0].i0;
        if (pos.fileName != fileName) {
          errStr = checker.errorToString(context, e);
          SKTest.fail(`Typing error in another file (${fileName}): ${errStr}`);
        };
        line = resolver.relPos(pos.getStart(symbols)).line;
        (line, e)
      | e ->
        errStr = checker.errorToString(context, e);
        throw SKTest.ExpectationError(
          "Unexpected non-typing error",
          "nothing or typing errors",
          errStr,
        )
      }
    )
    .sortedBy(line_err ~> line_err.i0);
}

fun validateReferenceErrors<R: ReferenceError>(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FAbsolute,
  typeErrors: Array<SKJS.Error>,
  referenceErrors: mutable Iterator<R>,
): void {
  referenceError = referenceErrors.next();

  linedTypeErrors = getLinedTypeErrors(context, checker, fileName, typeErrors);

  i = 0;
  while (i < linedTypeErrors.size()) {
    (line, typeError) = linedTypeErrors[i];
    referenceError match {
    | Some(
      ref @ ReferenceError{line => expectedLine},
    ) if (line == expectedLine) ->
      ref.validate(fileName.toString(), typeError)
    | Some(ReferenceError{line => expectedLine}) if (line > expectedLine) ->
      break void
    | _ ->
      errStr = checker.errorToString(context, typeError);
      expected = referenceError match {
      | Some(ref @ ReferenceError _) ->
        `Error later (line ${ref.line}): ${ref.getMessage()}`
      | None() -> "no errors"
      };
      throw SKTest.ExpectationError("Unexpected typing error", expected, errStr)
    };
    !i = i + 1;
    if (i >= linedTypeErrors.size() || linedTypeErrors[i].i0 != line) {
      !referenceError = referenceErrors.next()
    }
  };

  referenceError match {
  | None() -> void
  | Some(ref @ ReferenceError{line}) ->
    throw SKTest.ExpectationError(
      "Expected error",
      `${fileName}:${line} ${ref.getMessage()}`,
      "no errors",
    )
  }
}

// Expects no parse errors, type errors must be prefixed with @ts-expect-error
// or @skjs-expect-error
fun validateParseable(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult match {
  | SKJS.CheckResult(x, y, z, _, _) -> (x, y, z)
  };

  SKTest.expectEq(parseErrorOpt, None(), "Expected no parse errors");

  fileContents = checker.files.filesContent.get(context, fileName);
  tsExpectErrors = findExpectErrors(fileContents.value);

  validateReferenceErrors(
    context,
    checker,
    fileName,
    typeErrors,
    tsExpectErrors,
  );
}

// Expects no parse errors, type errors should correspond to the reference ones
fun validateTSConformance(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult match {
  | SKJS.CheckResult(x, y, z, _, _) -> (x, y, z)
  };

  SKTest.expectEq(parseErrorOpt, None(), "Expected no parse errors");

  fileContents = checker.files.filesContent.get(context, fileName).value;
  if (fileContents.startsWith("// @")) {
    throw SKTest.ExpectationError(
      "Comment-based config is not supported yet (TODO?)",
      "no comment-based config",
      fileContents.take(50) + "...",
    );
  };

  dir = fileName.dirName;
  while (dir.basename() != "cases") {
    !dir = dir.parent();
    if (dir.isRoot()) {
      return void; // non ts-conformance file, e.g. builtins
    };
  };
  errorsFile =
    dir / SKJS.DRelative::create("../reference") +
    SKJS.FRelative::create(
      `${fileName.baseName.stripSuffix(".ts")}.errors.txt`,
    );
  referenceErrors = if (errorsFile.exists()) {
    parseTSConformanceReferenceErrors(errorsFile.toString());
  } else {
    Array[].iterator()
  };

  validateReferenceErrors(
    context,
    checker,
    fileName,
    typeErrors,
    referenceErrors,
  )
}

// Expects at least an error, either parsing or typing
fun validateNotSupported(
  _context: mutable SKStore.Context,
  _checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult match {
  | SKJS.CheckResult(x, y, z, _, _) -> (x, y, z)
  };

  if (parseErrorOpt is None() && typeErrors.isEmpty()) {
    throw SKTest.ExpectationError(
      `Not-supported test ${fileName} should produce at least an error`,
      "an error",
      "no errors",
    );
  }
}

const builtinsArgFileName: String = "./import-stubs/@types/skjs/index.d.ts";

fun expectFilesSuccess(
  checkerCreateResult: Result<SKJS.Files, String>,
): SKJS.Files {
  checkerCreateResult match {
  | Failure(err) ->
    throw SKTest.ExpectationError(
      "Unexpected failure",
      "Success on Checker creation",
      err,
    )
  | Success(checker) -> checker
  }
}

type Validator = (
  mutable SKStore.Context,
  SKJS.Checker,
  SKJS.CheckResult,
) ~> void;

fun testFile(
  fileName: String,
  validateResult: Validator = validateParseable,
): void {
  builtinsFileName = Path.resolve(builtinsArgFileName);
  context = SKStore.Context::mcreate{};

  srcFiles = Array[fileName];
  files =
    SKJS.Files::create(context, ".", builtinsFileName, srcFiles, false) |>
    expectFilesSuccess;

  checker = SKJS.Checker::create{context, files};
  for (res in checker.checkFiles(context).items(context)) {
    if (res.i0.toString() == builtinsFileName) {
      validateParseable(context, checker, res.i1.next().fromSome());
    } else {
      validateResult(context, checker, res.i1.next().fromSome());
    }
  }
}

fun testDirectory(
  dirName: String,
  validateResult: Validator = validateParseable,
): void {
  dir = Path.resolve(dirName);
  srcFiles = FileSystem.readDirectory(dir).filterMap(f ~>
    if (f.endsWith(".ts")) Some(Path.join(dir, f)) else {
      if (f != "." && f != "..") {
        invariant_violation(`Unexpected non-ts file ${f} in ${dir}`)
      };
      None()
    }
  );
  builtinsFileName = Path.resolve(builtinsArgFileName);
  importStubs = Array["./import-stubs"];
  context = SKStore.Context::mcreate{};
  files =
    SKJS.Files::create(
      context,
      ".",
      builtinsFileName,
      srcFiles,
      false,
      importStubs,
    ) |> expectFilesSuccess;

  checker = SKJS.Checker::create{context, files};
  for (res in checker.checkFiles(context).items(context)) {
    if (res.i0.toString() == builtinsFileName) {
      validateParseable(context, checker, res.i1.next().fromSome());
    } else {
      validateResult(context, checker, res.i1.next().fromSome());
    }
  }
}

@test
fun testExamples(): void {
  testDirectory("./examples/src/");
}

@test
fun testExpectError(): void {
  testDirectory("./tests/expect-error/")
}

@test
fun testTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/cases/");
  cases = FileSystem.readFilesRecursive(dir);
  for (case in cases) {
    testFile(case, validateTSConformance);
  }
}

@test
fun testNotSupportedTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/not-supported/");
  files = FileSystem.readFilesRecursive(dir);
  for (file in files) {
    try {
      testFile(file, validateNotSupported)
    } catch {
    | InvariantViolation(_) -> void
    | e -> throw e
    }
  }
}

fun checkNoLostTest(path: String): void {
  files = if (FileSystem.isDirectory(path)) {
    FileSystem.readFilesRecursive(path)
  } else {
    Array[path]
  };
  for (file in files) {
    if (file.endsWith(".ts")) {
      invariant_violation(`${file} not covered by tests`)
    };
    if (file.endsWith(".js")) {
      invariant_violation(`${file}: no JS file expected`)
    }
  }
}

@test
fun testNoLostTest(): void {
  cwd = getcwd();
  files = FileSystem.readDirectory(cwd);
  for (file in files) {
    absFile = Path.join(cwd, file);
    file match {
    | "examples" ->
      subFiles = FileSystem.readDirectory(absFile);
      for (subFile in subFiles) {
        if (subFile == "src") continue; // handled in testExamples
        checkNoLostTest(Path.join(absFile, subFile))
      }
    | "tests" ->
      subFiles = FileSystem.readDirectory(absFile);
      for (subFile in subFiles) {
        subFile match {
        | "expect-error" /* handled in testExpectError */ | "ts-conformance" /* handled in testTypeScriptConformance and testNotSupportedTypeScriptConformance */ ->
          void
        | _ -> checkNoLostTest(Path.join(absFile, subFile))
        }
      }
    | "import-stubs" /* intentionally ignored because they are not tests themselves */ ->
      void
    | _ -> checkNoLostTest(absFile)
    }
  }
}

module end;
