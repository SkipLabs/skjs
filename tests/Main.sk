module SKJSTests;

fun getLinedErrors(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FAbsolute,
  errors: Array<SKJS.Error>,
): Array<(Int, SKJS.Error)> {
  newLines = checker.newLinesMap.get(context, fileName);
  symbols = checker.symbolsMap.get(context, fileName);
  resolver = SKJS.PositionResolver{fileName, newLines, symbols};

  errors
    .map(err -> {
      errPos = err match {
      | SKJS.TypingError(messages) ->
        invariant(!messages.isEmpty(), "Empty typing error");
        SKJS.EPRange(messages[0].i0)
      | SKJS.SinglePosError(errPos, _errKind) -> errPos
      };
      errFileName = errPos match {
      | SKJS.EPRange(posRange) -> posRange.fileName
      | SKJS.EPChar(fn, _pos) -> fn
      };
      if (errFileName != fileName) {
        errStr = checker.errorToString(context, err);
        SKTest.fail(`Typing error in another file (${fileName}): ${errStr}`);
      };
      pos = errPos match {
      | SKJS.EPRange(posRange) -> posRange.getStart(symbols)
      | SKJS.EPChar(_fileName, pos) -> pos
      };
      line = resolver.relPos(pos).line;
      (line, err)
    })
    .sortedBy(line_err ~> line_err.i0);
}

fun validateReferenceErrors<R: ReferenceError>(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FAbsolute,
  actualErrors: Array<SKJS.Error>,
  referenceErrors: mutable Iterator<R>,
): Array<SKTest.ExpectationError> {
  referenceErrorOpt = referenceErrors.next();

  linedActualErrors = getLinedErrors(context, checker, fileName, actualErrors);

  expectationErrors = mutable Vector[];

  i = 0;
  loop {
    actualErrorOpt = linedActualErrors.maybeGet(i);
    (actualErrorOpt, referenceErrorOpt) match {
    | (None(), None()) -> break void
    | (
      Some((actualLine, actualError)),
      Some(ref @ ReferenceError{line => expectedLine}),
    ) if (actualLine == expectedLine) ->
      ref.validate(fileName, actualError).each(expectationErrors.push);
      !i = i + 1;
      if (
        i >= linedActualErrors.size() ||
        linedActualErrors[i].i0 != actualLine
      ) {
        !referenceErrorOpt = referenceErrors.next()
      };
      actualError match {
      | SKJS.LexingOrParsingError _ ->
        newLines = checker.newLinesMap.get(context, fileName);
        for (line in Range(actualLine - 1, newLines.size() - 1)) {
          if (newLines[line + 1] > newLines[line] + 1) {
            expectationErrors.push(
              SKTest.ExpectationError(
                `${fileName}:${actualLine} Parse error must be on last non-empty line`,
                "end of file",
                `more content on line ${line + 1}`,
              ),
            );
            break void
          }
        };
        break void
      | _ -> void
      }
    | (
      Some((actualLine, actualError)),
      Some(ReferenceError{line => expectedLine}),
    ) if (actualLine < expectedLine) ->
      errStr = checker.errorToString(context, actualError);
      expectationErrors.push(
        SKTest.ExpectationError("Unexpected error", "error later", errStr),
      );
      !i = i + 1
    | (Some((_actualLine, actualError)), None()) ->
      errStr = checker.errorToString(context, actualError);
      expectationErrors.push(
        SKTest.ExpectationError("Unexpected error", "no errors", errStr),
      );
      !i = i + 1
    | (_, Some(ref @ ReferenceError{line => expectedLine})) ->
      expectationErrors.push(
        SKTest.ExpectationError(
          "Expected error",
          `${fileName}:${expectedLine} ${ref.getMessage()}`,
          "no errors",
        ),
      );
      !referenceErrorOpt = referenceErrors.next()
    }
  };

  expectationErrors.toArray()
}

// Errors must be prefixed with @ts-expect-error or @skjs-expect-error
fun validateExpectErrorComments(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
): Array<SKTest.ExpectationError> {
  (fileName, parseErrorOpt, typeErrors) = checkResult match {
  | SKJS.CheckResult(x, y, z, _, _) -> (x, y, z)
  };

  fileContents = checker.files.filesContent.get(context, fileName);
  tsExpectErrors = findExpectErrors(fileContents.value);

  actualErrors = parseErrorOpt match {
  | None() -> typeErrors
  | Some(parseError) -> typeErrors.concat(Array[parseError])
  };

  validateReferenceErrors(
    context,
    checker,
    fileName,
    actualErrors,
    tsExpectErrors,
  )
}

// Expects no parse errors, type errors should correspond to the reference ones
fun validateTSConformance(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
): Array<SKTest.ExpectationError> {
  (fileName, parseErrorOpt, typeErrors) = checkResult match {
  | SKJS.CheckResult(x, y, z, _, _) -> (x, y, z)
  };

  SKTest.expectEq(parseErrorOpt, None(), "Expected no parse errors");

  fileContents = checker.files.filesContent.get(context, fileName).value;
  if (fileContents.startsWith("// @")) {
    return Array[
      SKTest.ExpectationError(
        "Comment-based config is not supported yet (TODO?)",
        "no comment-based config",
        fileContents.take(50) + "...",
      ),
    ]
  };

  dir = fileName.dirName;
  while (dir.basename() != "cases") {
    !dir = dir.parent();
    if (dir.isRoot()) {
      return Array[]; // non ts-conformance file, e.g. builtins
    };
  };
  errorsFile =
    dir / SKJS.DRelative::create("../reference") +
    SKJS.FRelative::create(
      `${fileName.baseName.stripSuffix(".ts")}.errors.txt`,
    );
  referenceErrors = if (errorsFile.exists()) {
    parseTSConformanceReferenceErrors(errorsFile.toString());
  } else {
    Array[].iterator()
  };

  validateReferenceErrors(
    context,
    checker,
    fileName,
    typeErrors,
    referenceErrors,
  )
}

// Expects at least an error, either parsing or typing
fun validateNotSupported(
  _context: mutable SKStore.Context,
  _checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
): Array<SKTest.ExpectationError> {
  (fileName, parseErrorOpt, typeErrors) = checkResult match {
  | SKJS.CheckResult(x, y, z, _, _) -> (x, y, z)
  };

  if (parseErrorOpt is None() && typeErrors.isEmpty()) {
    return Array[
      SKTest.ExpectationError(
        `Not-supported test ${fileName} should produce at least an error`,
        "an error",
        "no errors",
      ),
    ]
  };
  Array[]
}

const builtinsArgFileName: String = "./import-stubs/@types/skjs/index.d.ts";

fun expectFilesSuccess(
  checkerCreateResult: Result<SKJS.Files, String>,
): SKJS.Files {
  checkerCreateResult match {
  | Failure(err) ->
    throw SKTest.ExpectationError(
      "Unexpected failure",
      "Success on Checker creation",
      err,
    )
  | Success(checker) -> checker
  }
}

fun reportExpectationErrors(
  expectationErrors: Array<SKTest.ExpectationError>,
): void {
  expectationErrors.size() match {
  | 0 -> void
  | 1 -> throw expectationErrors[0]
  | _ ->
    expectationErrors.each(err -> print_string(err.getMessage() + "\n\n"));
    invariant_violation("Got errors")
  }
}

type Validator = (
  mutable SKStore.Context,
  SKJS.Checker,
  SKJS.CheckResult,
) ~> Array<SKTest.ExpectationError>;

fun testFiles(
  srcFiles: Array<String>,
  importStubs: Array<String>,
  validateResult: Validator,
): void {
  builtinsFileName = Path.resolve(builtinsArgFileName);
  context = SKStore.Context::mcreate{};

  files =
    SKJS.Files::create(
      context,
      ".",
      builtinsFileName,
      srcFiles,
      false,
      importStubs,
    ) |> expectFilesSuccess;

  checker = SKJS.Checker::create{context, files, keepGoing => true};
  expectationErrors = checker
    .checkFiles(context)
    .items(context)
    .map(res ->
      if (res.i0.toString() == builtinsFileName) {
        validateExpectErrorComments(context, checker, res.i1.next().fromSome())
      } else {
        validateResult(context, checker, res.i1.next().fromSome())
      }
    )
    .collect(Array)
    .flatten();
  reportExpectationErrors(expectationErrors)
}

fun testFile(
  fileName: String,
  validateResult: Validator = validateExpectErrorComments,
): void {
  srcFiles = Array[fileName];
  importStubs = Array[];
  testFiles(srcFiles, importStubs, validateResult)
}

fun testDirectory(
  dirName: String,
  validateResult: Validator = validateExpectErrorComments,
): void {
  dir = Path.resolve(dirName);
  srcFiles = FileSystem.readDirectory(dir).filterMap(f ~>
    if (f.endsWith(".ts")) Some(Path.join(dir, f)) else {
      if (f != "." && f != "..") {
        invariant_violation(`Unexpected non-ts file ${f} in ${dir}`)
      };
      None()
    }
  );
  importStubs = Array["./import-stubs"];
  testFiles(srcFiles, importStubs, validateResult)
}

@test
fun testExamples(): void {
  testDirectory("./examples/src/");
}

@test
fun testExpectError(): void {
  testDirectory("./tests/expect-error/")
}

@test
fun testTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/cases/");
  cases = FileSystem.readFilesRecursive(dir);
  for (case in cases) {
    testFile(case, validateTSConformance);
  }
}

@test
fun testNotSupportedTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/not-supported/");
  files = FileSystem.readFilesRecursive(dir);
  for (file in files) {
    try {
      testFile(file, validateNotSupported)
    } catch {
    | InvariantViolation(_) -> void
    | e -> throw e
    }
  }
}

fun checkNoLostTest(path: String): void {
  files = if (FileSystem.isDirectory(path)) {
    FileSystem.readFilesRecursive(path)
  } else {
    Array[path]
  };
  for (file in files) {
    if (file.endsWith(".ts")) {
      invariant_violation(`${file} not covered by tests`)
    };
    if (file.endsWith(".js")) {
      invariant_violation(`${file}: no JS file expected`)
    }
  }
}

@test
fun testNoLostTest(): void {
  cwd = getcwd();
  files = FileSystem.readDirectory(cwd);
  for (file in files) {
    absFile = Path.join(cwd, file);
    file match {
    | "examples" ->
      subFiles = FileSystem.readDirectory(absFile);
      for (subFile in subFiles) {
        if (subFile == "src") continue; // handled in testExamples
        checkNoLostTest(Path.join(absFile, subFile))
      }
    | "tests" ->
      subFiles = FileSystem.readDirectory(absFile);
      for (subFile in subFiles) {
        subFile match {
        | "expect-error" /* handled in testExpectError */ | "ts-conformance" /* handled in testTypeScriptConformance and testNotSupportedTypeScriptConformance */ ->
          void
        | _ -> checkNoLostTest(Path.join(absFile, subFile))
        }
      }
    | "import-stubs" /* intentionally ignored because they are not tests themselves */ ->
      void
    | _ -> checkNoLostTest(absFile)
    }
  }
}

module end;
