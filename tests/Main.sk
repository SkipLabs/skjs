module SKJSTests;

// Expects no parse errors, type errors must be prefixed with @ts-expect-error
fun validateParseable(
  checker: mutable SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult;

  SKTest.expectEq(parseErrorOpt, None(), "Expected no parse errors");

  newLines = checker.newLinesMap.get(checker.context, fileName);
  resolver = SKJS.PositionResolver{fileName, newLines};

  linedTypeErrors = typeErrors
    .map(err ->
      err match {
      | e @ SKJS.TypingError(messages) ->
        invariant(!messages.isEmpty(), "Empty typing error");
        pos = messages[0].i0;
        if (pos.fileName != fileName) {
          errStr = checker.errorToString(e);
          SKTest.fail(`Typing error in another file (${fileName}): ${errStr}`);
        };
        line = resolver.relPos(pos.start).line;
        (line, e)
      | e ->
        errStr = checker.errorToString(e);
        throw SKTest.ExpectationError(
          "Unexpected non-typing error",
          "nothing or typing errors",
          errStr,
        )
      }
    )
    .sortedBy(line_err ~> line_err.i0);

  fileContents = checker.files.filesContent.get(
    checker.context,
    SKStore.SID(fileName),
  );
  tsExpectErrors = findTSExpectErrors(fileContents.value);
  tsExpectError = tsExpectErrors.next();

  for (linedTypeError in linedTypeErrors) {
    (line, typeError) = linedTypeError;
    tsExpectError match {
    | Some((expectedLine, _restOfExpectComment)) if (line == expectedLine) ->
      !tsExpectError = tsExpectErrors.next()
    | Some((expectedLine, _restOfExpectComment)) if (line > expectedLine) ->
      break void
    | _ ->
      errStr = checker.errorToString(typeError);
      throw SKTest.ExpectationError(
        "Unexpected typing error",
        "no errors",
        errStr,
      )
    };
  };

  tsExpectError match {
  | None() -> void
  | Some((expectedLine, restOfExpectComment)) ->
    throw SKTest.ExpectationError(
      "Expected error",
      `${fileName}:${expectedLine} ${restOfExpectComment}`,
      "no errors",
    )
  }
}

const builtinsArgFileName: String = "./examples/src/builtins.ts";

fun expectCheckerSuccess(
  checkerCreateResult: Result<mutable SKJS.Checker, String>,
): mutable SKJS.Checker {
  checkerCreateResult match {
  | Failure(err) ->
    throw SKTest.ExpectationError(
      "Unexpected failure",
      "Success on Checker creation",
      err,
    )
  | Success(checker) -> checker
  }
}

fun testFile(
  fileName: String,
  validateResult: (
    mutable SKJS.Checker,
    SKJS.CheckResult,
  ) ~> void = validateParseable,
): void {
  checker =
    SKJS.Checker::create{builtinsArgFileName, srcFiles => Array[fileName]} |>
    expectCheckerSuccess;
  for (res in checker.checkFiles()) validateResult(checker, res);
}

fun testDirectory(
  dirName: String,
  validateResult: (
    mutable SKJS.Checker,
    SKJS.CheckResult,
  ) ~> void = validateParseable,
): void {
  dir = Path.resolve(dirName);
  srcFiles = FileSystem.readDirectory(dir).filterMap(f ~>
    if (f.endsWith(".ts")) Some(Path.join(dir, f)) else None()
  );
  builtinsFileName = Path.resolve(builtinsArgFileName);
  checker =
    SKJS.Checker::create{builtinsArgFileName, srcFiles} |> expectCheckerSuccess;
  for (res in checker.checkFiles()) {
    if (res.i0 != builtinsFileName) {
      validateResult(checker, res);
    }
  }
}

@test
fun testUnit(): void {
  testFile("./tests/unit.ts");
}

@test
fun testExamples(): void {
  testDirectory("./examples/src/");
}

@test
fun testExpectError(): void {
  testDirectory("./tests/expect-error/")
}

module end;
