module SKJSTests;

fun getLinedTypeErrors(
  checker: mutable SKJS.Checker,
  fileName: String,
  typeErrors: Array<SKJS.Error>,
): Array<(Int, SKJS.TypingError)> {
  newLines = checker.newLinesMap.get(checker.context, fileName);
  resolver = SKJS.PositionResolver{fileName, newLines};

  typeErrors
    .map(err ->
      err match {
      | e @ SKJS.TypingError(messages) ->
        invariant(!messages.isEmpty(), "Empty typing error");
        pos = messages[0].i0;
        if (pos.fileName != fileName) {
          errStr = checker.errorToString(e);
          SKTest.fail(`Typing error in another file (${fileName}): ${errStr}`);
        };
        line = resolver.relPos(pos.start).line;
        (line, e)
      | e ->
        errStr = checker.errorToString(e);
        throw SKTest.ExpectationError(
          "Unexpected non-typing error",
          "nothing or typing errors",
          errStr,
        )
      }
    )
    .sortedBy(line_err ~> line_err.i0);
}

fun validateReferenceErrors<R: ReferenceError>(
  checker: mutable SKJS.Checker,
  fileName: String,
  typeErrors: Array<SKJS.Error>,
  referenceErrors: mutable Iterator<R>,
): void {
  referenceError = referenceErrors.next();

  linedTypeErrors = getLinedTypeErrors(checker, fileName, typeErrors);

  for (linedTypeError in linedTypeErrors) {
    (line, typeError) = linedTypeError;
    referenceError match {
    | Some(
      ref @ ReferenceError{line => expectedLine},
    ) if (line == expectedLine) ->
      ref.validate(fileName, typeError);
      !referenceError = referenceErrors.next()
    | Some(ReferenceError{line => expectedLine}) if (line > expectedLine) ->
      break void
    | _ ->
      errStr = checker.errorToString(typeError);
      throw SKTest.ExpectationError(
        "Unexpected typing error",
        "no errors",
        errStr,
      )
    };
  };

  referenceError match {
  | None() -> void
  | Some(ref @ ReferenceError{line}) ->
    throw SKTest.ExpectationError(
      "Expected error",
      `${fileName}:${line} ${ref.getMessage()}`,
      "no errors",
    )
  }
}

// Expects no parse errors, type errors must be prefixed with @ts-expect-error
fun validateParseable(
  checker: mutable SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult;

  SKTest.expectEq(parseErrorOpt, None(), "Expected no parse errors");

  fileContents = checker.files.filesContent.get(
    checker.context,
    SKStore.SID(fileName),
  );
  tsExpectErrors = findTSExpectErrors(fileContents.value);

  validateReferenceErrors(checker, fileName, typeErrors, tsExpectErrors);
}

// Expects no parse errors, type errors should correspond to the reference ones
fun validateTSConformance(
  checker: mutable SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult;

  SKTest.expectEq(parseErrorOpt, None(), "Expected no parse errors");

  (dir, base) = Path.split(fileName);
  while (Path.basename(dir) != "cases") {
    !dir = Path.parentname(dir);
    if (dir == "/") {
      return void; // non ts-conformance file, e.g. builtins
    };
  };
  errorsFile = Path.join(
    dir,
    `../reference/${base.stripSuffix(".ts")}.errors.txt`,
  );
  if (FileSystem.exists(errorsFile)) {
    SKTest.fail(`TODO: support reference errors: ${errorsFile}`);
  };

  fileContents = checker.files.filesContent.get(
    checker.context,
    SKStore.SID(fileName),
  ).value;
  if (fileContents.startsWith("// @")) {
    throw SKTest.ExpectationError(
      "Comment-based config is not supported yet (TODO?)",
      "no comment-based config",
      fileContents.take(50) + "...",
    );
  };

  SKTest.expectEq(typeErrors.size(), 0, "expected no type errors")
}

// Expects at least an error, either parsing or typing
fun validateNotSupported(
  _checker: mutable SKJS.Checker,
  checkResult: SKJS.CheckResult,
): void {
  (fileName, parseErrorOpt, typeErrors) = checkResult;

  if (parseErrorOpt is None() && typeErrors.isEmpty()) {
    throw SKTest.ExpectationError(
      `Not-supported test ${fileName} should produce at least an error`,
      "an error",
      "no errors",
    );
  }
}

const builtinsArgFileName: String = "./examples/src/builtins.ts";

fun expectCheckerSuccess(
  checkerCreateResult: Result<mutable SKJS.Checker, String>,
): mutable SKJS.Checker {
  checkerCreateResult match {
  | Failure(err) ->
    throw SKTest.ExpectationError(
      "Unexpected failure",
      "Success on Checker creation",
      err,
    )
  | Success(checker) -> checker
  }
}

type Validator = (mutable SKJS.Checker, SKJS.CheckResult) ~> void;

fun testFile(
  fileName: String,
  validateResult: Validator = validateParseable,
): void {
  builtinsFileName = Path.resolve(builtinsArgFileName);
  checker =
    SKJS.Checker::create{builtinsArgFileName, srcFiles => Array[fileName]} |>
    expectCheckerSuccess;
  for (res in checker.checkFiles()) {
    if (res.i0 == builtinsFileName) {
      validateParseable(checker, res);
    } else {
      validateResult(checker, res);
    }
  }
}

fun testDirectory(
  dirName: String,
  validateResult: Validator = validateParseable,
): void {
  dir = Path.resolve(dirName);
  srcFiles = FileSystem.readDirectory(dir).filterMap(f ~>
    if (f.endsWith(".ts")) Some(Path.join(dir, f)) else None()
  );
  builtinsFileName = Path.resolve(builtinsArgFileName);
  checker =
    SKJS.Checker::create{builtinsArgFileName, srcFiles} |> expectCheckerSuccess;
  for (res in checker.checkFiles()) {
    if (res.i0 == builtinsFileName) {
      validateParseable(checker, res);
    } else {
      validateResult(checker, res);
    }
  }
}

@test
fun testUnit(): void {
  testFile("./tests/unit.ts");
}

@test
fun testExamples(): void {
  testDirectory("./examples/src/");
}

@test
fun testExpectError(): void {
  testDirectory("./tests/expect-error/")
}

@test
fun testTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/cases/");
  cases = FileSystem.readFilesRecursive(dir);
  for (case in cases) {
    testFile(case, validateTSConformance);
  }
}

@test
fun testNotSupportedTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/not-supported/");
  files = FileSystem.readFilesRecursive(dir);
  for (file in files) {
    try {
      testFile(file, validateNotSupported)
    } catch {
    | InvariantViolation(_) -> void
    | e -> throw e
    }
  }
}

module end;
