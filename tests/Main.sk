module SKJSTests;

fun getLinedErrors(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FPath,
  errors: Array<SKJS.Error>,
): Array<(Int, Sequence<SKJS.Error>)> {
  newLines = checker.newLinesMap.get(context, fileName);
  symbols = checker.symbolsMap.get(context, fileName);
  absFileName = fileName.toAbsolute(checker.files.rootMap);
  resolver = SKJS.PositionResolver{absFileName, newLines, symbols};

  m = mutable Map[];
  for (err in errors) {
    errPos = err match {
    | SKJS.NamingError(messages)
    | SKJS.SubtypingError(_, _, messages, _stErr) ->
      invariant(!messages.isEmpty(), "Empty typing error");
      SKJS.EPRange(messages[0].i0)
    | SKJS.SinglePosError(errPos, _errKind) -> errPos
    };
    errFileName = errPos.fileName();
    if (errFileName != fileName) {
      errStr = checker.errorToString(context, err);
      SKTest.fail(`Typing error in another file (${fileName}): ${errStr}`);
    };
    pos = errPos match {
    | SKJS.EPRange(posRange) -> posRange.getStart(symbols)
    | SKJS.EPChar(_fileName, pos) -> pos
    };
    line = resolver.lineCol(pos).line;
    errs_at_line = m.getOrAdd(line, () -> Vector::mcreate(0));
    errs_at_line.push(err)
  };
  m
    .iterator()
    .map(line_errs -> (line_errs.i0, line_errs.i1.toArray()))
    .collect(Array)
    .sortedBy(line_errs ~> line_errs.i0)
}

fun validateReferenceErrors<R: ReferenceError>(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FPath,
  allActualErrors: Array<SKJS.Error>,
  referenceErrors: mutable Iterator<R>,
): Array<SKTest.ExpectationError> {
  tenv = checker.checker;
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  tcenvb = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::mcreate(tcenvb);

  referenceErrorOpt = referenceErrors.next();

  linedActualErrors = getLinedErrors(
    context,
    checker,
    fileName,
    allActualErrors,
  );

  expectationErrors = mutable Vector[];

  i = 0;
  loop {
    actualErrorsOpt = linedActualErrors.maybeGet(i);
    (actualErrorsOpt, referenceErrorOpt) match {
    | (None(), None()) -> break void
    | (
      Some((actualLine, actualErrors)),
      Some(ref @ ReferenceError{line => expectedLine}),
    ) if (actualLine == expectedLine) ->
      ref
        .validate(subst, tenv, fileName, actualErrors)
        .each(expectationErrors.push);
      !i = i + 1;
      if (
        i >= linedActualErrors.size() ||
        linedActualErrors[i].i0 != actualLine
      ) {
        !referenceErrorOpt = referenceErrors.next()
      };
      if (actualErrors.any(e -> e is SKJS.LexingOrParsingError _)) {
        newLines = checker.newLinesMap.get(context, fileName);
        for (line in Range(actualLine - 1, newLines.size() - 1)) {
          if (newLines[line + 1] > newLines[line] + 1) {
            expectationErrors.push(
              SKTest.ExpectationError(
                `${fileName}:${actualLine} Parse error must be on last non-empty line`,
                "end of file",
                `more content on line ${line + 1}`,
              ),
            );
            break void
          }
        };
        break void
      }
    | (
      Some((actualLine, actualErrors)),
      Some(ReferenceError{line => expectedLine}),
    ) if (actualLine < expectedLine) ->
      errStr = checker.errorsToString(context, actualErrors);
      expectationErrors.push(
        SKTest.ExpectationError("Unexpected error", "error later", errStr),
      );
      !i = i + 1
    | (Some((_actualLine, actualErrors)), None()) ->
      errStr = checker.errorsToString(context, actualErrors);
      expectationErrors.push(
        SKTest.ExpectationError("Unexpected error", "no errors", errStr),
      );
      !i = i + 1
    | (_, Some(ref @ ReferenceError{line => expectedLine})) ->
      expectationErrors.push(
        SKTest.ExpectationError(
          "Expected error",
          `${fileName}:${expectedLine} ${ref.getMessage()}`,
          "no errors",
        ),
      );
      !referenceErrorOpt = referenceErrors.next()
    }
  };

  expectationErrors.toArray()
}

fun doUpdateExpectErrorComments(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  fileName: SKJS.FPath,
  fileContents: String,
  actualErrors: Array<SKJS.Error>,
  update: UMDoUpdate,
): void {
  linedErrors = getLinedErrors(context, checker, fileName, actualErrors);
  tenv = checker.checker;
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  tcenvb = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::mcreate(tcenvb);
  errorsByLine = mutable Map[];
  fullMessages = mutable Map[];
  actualLineNAnnotationsByLine = mutable Map[];
  for (lineErrs in linedErrors) {
    if (!lineErrs.i1.isEmpty()) {
      err = lineErrs.i1.first();
      actualLineNAnnotationsByLine.set(
        lineErrs.i0,
        getLineNAnnotationsFromError(subst, tenv, err),
      )
    };
    trimmedMsgs = SortedSet[];
    for (err in lineErrs.i1) {
      full = errorToFullMessage(err);
      trimmed = full.trimMessage(true);
      fullMessages.set(trimmed, full.trimMessage());
      !trimmedMsgs = trimmedMsgs.set(trimmed)
    };
    errorsByLine.set(lineErrs.i0, trimmedMsgs)
  };
  updateFileAnnotations(
    fileContents,
    errorsByLine.chill(),
    fullMessages.chill(),
    update,
    actualLineNAnnotationsByLine.chill(),
  ).each(updatedContents -> {
    absFileName = fileName.toAbsolute(checker.files.rootMap);
    FileSystem.writeTextFile(absFileName.toString(), updatedContents);
    print_string(`Updated: ${absFileName}\n`)
  })
}

// Errors must be prefixed with @ts-expect-error or @skjs-expect-error.
// When update is UMUpdate(), rewrites annotations in-place and returns no errors.
fun validateExpectErrorComments(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
  update: UpdateMode,
): Array<SKTest.ExpectationError> {
  fileName = checkResult.fileName;
  parseErrorOpt = checkResult.parseError;
  typeErrors = checkResult.errors;
  typeWarnings = checkResult.warnings;

  fileContents = checker.files.filesContent.get(context, fileName);

  // Commit 1: warnings are a separate field but, until @skjs-expect-warning
  // exists, the harness still matches them as ordinary expected diagnostics.
  actualErrors = parseErrorOpt match {
  | None() -> typeErrors.concat(typeWarnings)
  | Some(parseError) ->
    typeErrors.concat(typeWarnings).concat(Array[parseError])
  };

  update match {
  | UMValidateOnly() ->
    tsExpectErrors = findExpectErrors(fileContents.value).iterator();
    validateReferenceErrors(
      context,
      checker,
      fileName,
      actualErrors,
      tsExpectErrors,
    )
  | doUpdate @ UMDoUpdate _ ->
    doUpdateExpectErrorComments(
      context,
      checker,
      fileName,
      fileContents.value,
      actualErrors,
      doUpdate,
    );
    Array[]
  }
}

// Expects no parse errors, type errors should correspond to the reference ones
fun validateTSConformance(
  context: mutable SKStore.Context,
  checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
  _update: UpdateMode,
): Array<SKTest.ExpectationError> {
  fileName = checkResult.fileName;
  parseErrorOpt = checkResult.parseError;
  typeErrors = checkResult.errors;

  SKTest.expectEq(parseErrorOpt is None(), true, "Expected no parse errors");

  fileContents = checker.files.filesContent.get(context, fileName).value;
  if (fileContents.startsWith("// @")) {
    return Array[
      SKTest.ExpectationError(
        "Comment-based config is not supported yet (TODO?)",
        "no comment-based config",
        fileContents.take(50) + "...",
      ),
    ]
  };

  absFileName = fileName.toAbsolute(checker.files.rootMap);
  dir = absFileName.dirName;
  while (dir.basename() != "cases") {
    !dir = dir.parent();
    if (dir.isRoot()) {
      return Array[]; // non ts-conformance file, e.g. builtins
    };
  };
  errorsFile =
    dir / SKJS.DRelative::create("../reference") +
    SKJS.FRelative::create(
      `${fileName.relative.baseName.stripSuffix(".ts")}.errors.txt`,
    );
  referenceErrors = if (FileSystem.exists(errorsFile.toString())) {
    parseTSConformanceReferenceErrors(errorsFile.toString());
  } else {
    Array[].iterator()
  };

  validateReferenceErrors(
    context,
    checker,
    fileName,
    typeErrors,
    referenceErrors,
  )
}

// Expects at least an error, either parsing or typing
fun validateNotSupported(
  _context: mutable SKStore.Context,
  _checker: SKJS.Checker,
  checkResult: SKJS.CheckResult,
  _update: UpdateMode,
): Array<SKTest.ExpectationError> {
  fileName = checkResult.fileName;
  parseErrorOpt = checkResult.parseError;
  typeErrors = checkResult.errors;

  if (parseErrorOpt is None() && typeErrors.isEmpty()) {
    return Array[
      SKTest.ExpectationError(
        `Not-supported test ${fileName} should produce at least an error`,
        "an error",
        "no errors",
      ),
    ]
  };
  Array[]
}

fun expectFilesSuccess(
  checkerCreateResult: Result<SKJS.Files, String>,
): SKJS.Files {
  checkerCreateResult match {
  | Failure(err) ->
    throw SKTest.ExpectationError(
      "Unexpected failure",
      "Success on Checker creation",
      err,
    )
  | Success(checker) -> checker
  }
}

fun reportExpectationErrors(
  expectationErrors: Array<SKTest.ExpectationError>,
): void {
  expectationErrors.size() match {
  | 0 -> void
  | 1 -> throw expectationErrors[0]
  | _ ->
    expectationErrors.each(err -> print_string(err.getMessage() + "\n\n"));
    invariant_violation("Got errors")
  }
}

type Validator = (
  mutable SKStore.Context,
  SKJS.Checker,
  SKJS.CheckResult,
  UpdateMode,
) ~> Array<SKTest.ExpectationError>;

fun testFiles(
  srcFiles: Array<String>,
  importStubs: Array<String>,
  validateResult: Validator,
  update: UpdateMode = UMValidateOnly(),
): void {
  reportExpectationErrors(
    checkFilesWithRoot(".", srcFiles, importStubs, validateResult, update),
  )
}

fun checkFilesWithRoot(
  root: String,
  srcFiles: Array<String>,
  importStubs: Array<String>,
  validateResult: Validator,
  update: UpdateMode = UMValidateOnly(),
  compilerOptions: SKJS.TsCompilerOptions = SKJS.TsCompilerOptions{},
): Array<SKTest.ExpectationError> {
  fs = SKJS.Fs::disk();
  context = SKStore.Context::mcreate{};

  files =
    SKJS.Files::create(context, fs, root, srcFiles, importStubs) |>
    expectFilesSuccess;

  checker = SKJS.Checker::create{
    context,
    fs,
    files,
    errorHandling => SKJS.EHKeepGoing(),
    errorDetailConfig => SKJS.ErrorDetailConfig::minimal(),
    compilerOptions,
  }.fromSuccess();
  checker
    .checkFiles(context)
    .items(context)
    .map(res ->
      if (res.i0 == files.builtinsFileName) {
        validateExpectErrorComments(
          context,
          checker,
          res.i1.next().fromSome(),
          update,
        )
      } else {
        validateResult(context, checker, res.i1.next().fromSome(), update)
      }
    )
    .collect(Array)
    .flatten()
}

fun testFile(
  fileName: String,
  validateResult: Validator = validateExpectErrorComments,
  update: UpdateMode = UMValidateOnly(),
): void {
  srcFiles = Array[fileName];
  importStubs = Array["./import-stubs"];
  testFiles(srcFiles, importStubs, validateResult, update)
}

fun testDirectory(
  dirName: String,
  validateResult: Validator = validateExpectErrorComments,
  update: UpdateMode = UMValidateOnly(),
): void {
  dir = Path.resolve(dirName);
  srcFiles = FileSystem.readDirectory(dir).filterMap(f ~>
    if (SKJS.isTsFile(f)) Some(Path.join(dir, f)) else {
      if (f != "." && f != "..") {
        invariant_violation(`Unexpected non-ts file ${f} in ${dir}`)
      };
      None()
    }
  );
  importStubs = Array["./import-stubs"];
  testFiles(srcFiles, importStubs, validateResult, update)
}

@test
fun testExamples(): void {
  testDirectory(
    "./examples/src/",
    validateExpectErrorComments,
    UpdateMode::fromEnv(),
  );
}

@test
fun testExpectError(): void {
  testDirectory(
    "./tests/expect-error/",
    validateExpectErrorComments,
    UpdateMode::fromEnv(),
  )
}

@test
fun testTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/cases/");
  cases = FileSystem.readFilesRecursive(dir);
  for (case in cases) {
    testFile(case, validateTSConformance);
  }
}

@test
fun testNotSupportedTypeScriptConformance(): void {
  dir = Path.resolve("./tests/ts-conformance/not-supported/");
  files = FileSystem.readFilesRecursive(dir);
  for (file in files) {
    try {
      testFile(file, validateNotSupported)
    } catch {
    | InvariantViolation(_) -> void
    | e -> throw e
    }
  }
}

fun testProject(projectDir: String, update: UpdateMode): void {
  fs = SKJS.Fs::disk();
  dir = Path.resolve(projectDir);
  configPath = Path.join(dir, "tsconfig.json");
  (config, diagnostics) = SKJS.loadTsConfig(fs, configPath);

  // Validate tsconfig lint diagnostics against @skjs-expect-error annotations
  rawContents = FileSystem.readTextFile(configPath);
  tsconfigDiagErrors = validateTsConfigDiags(
    configPath,
    rawContents,
    diagnostics,
    update,
  );

  srcFiles = SKJS.resolveConfigFiles(fs, config);
  configDirStr = config.configDir.toString();
  root = config.compilerOptions.baseUrl match {
  | Some(bu) -> Path.join(configDirStr, bu)
  | None() ->
    config.compilerOptions.rootDir match {
    | Some(rd) -> Path.join(configDirStr, rd)
    | None() -> configDirStr
    }
  };
  fileErrors = checkFilesWithRoot(
    root,
    srcFiles,
    Array["./import-stubs"],
    validateExpectErrorComments,
    update,
    config.compilerOptions,
  );
  reportExpectationErrors(tsconfigDiagErrors.concat(fileErrors))
}

// Validate tsconfig diagnostics against expect-error annotations.
// Similar to validateReferenceErrors but for TsConfigDiag instead of Error.
// When update is UMDoUpdate, rewrites annotations in-place and returns no errors.
fun validateTsConfigDiags(
  configPath: String,
  rawContents: String,
  diags: Array<SKJS.TsConfigDiag>,
  update: UpdateMode,
): Array<SKTest.ExpectationError> {
  update match {
  | doUpdate @ UMDoUpdate _ ->
    errorsByLine = mutable Map[];
    fullMessages = mutable Map[];
    for (diag in diags) {
      trimmed = diag.message.trimMessage(true);
      fullMessages.set(trimmed, diag.message.trimMessage());
      existing = errorsByLine.maybeGet(diag.line).default(SortedSet[]);
      errorsByLine.set(diag.line, existing.set(trimmed))
    };
    updateFileAnnotations(
      rawContents,
      errorsByLine.chill(),
      fullMessages.chill(),
      doUpdate,
    ).each(updatedContents -> {
      FileSystem.writeTextFile(configPath, updatedContents);
      print_string(`Updated: ${configPath}\n`)
    });
    Array[]
  | UMValidateOnly() ->
    expectErrors = findExpectErrors(rawContents).iterator();
    expectErrorOpt = expectErrors.next();

    // Group diagnostics by line (mirrors getLinedErrors for SKJS.Error)
    m = mutable Map[];
    for (diag in diags) {
      diagsAtLine = m.getOrAdd(diag.line, () -> Vector::mcreate(0));
      diagsAtLine.push(diag)
    };
    groupedDiags = m
      .iterator()
      .map(entry -> (entry.i0, entry.i1.toArray()))
      .collect(Array)
      .sortedBy(entry ~> entry.i0);

    errors = mutable Vector[];

    i = 0;
    loop {
      groupOpt = groupedDiags.maybeGet(i);
      (groupOpt, expectErrorOpt) match {
      | (None(), None()) -> break void
      | (
        Some((actualLine, lineDiags)),
        Some(ref @ ExpectError{line => expectedLine}),
      ) if (actualLine == expectedLine) ->
        actuals = lineDiags
          .map(d -> d.message.trimMessage(true))
          .collect(SortedSet);
        if (actuals != ref.expectedErrors) {
          errors.push(
            SKTest.ExpectationError(
              `${configPath}:${actualLine} Wrong tsconfig diagnostic`,
              ref.getMessage(),
              actuals.toArray().join(" / "),
            ),
          )
        };
        !i = i + 1;
        !expectErrorOpt = expectErrors.next()
      | (
        Some((actualLine, lineDiags)),
        Some(ExpectError{line => expectedLine}),
      ) if (actualLine < expectedLine) ->
        diagStr = lineDiags.map(d -> d.message).join("; ");
        errors.push(
          SKTest.ExpectationError(
            `${configPath}:${actualLine} Unexpected tsconfig diagnostic`,
            "no diagnostic",
            diagStr,
          ),
        );
        !i = i + 1
      | (Some((actualLine, lineDiags)), None()) ->
        diagStr = lineDiags.map(d -> d.message).join("; ");
        errors.push(
          SKTest.ExpectationError(
            `${configPath}:${actualLine} Unexpected tsconfig diagnostic`,
            "no diagnostic",
            diagStr,
          ),
        );
        !i = i + 1
      | (_, Some(ref @ ExpectError{line => expectedLine})) ->
        errors.push(
          SKTest.ExpectationError(
            `${configPath}:${expectedLine} Expected tsconfig diagnostic`,
            ref.getMessage(),
            "no diagnostic",
          ),
        );
        !expectErrorOpt = expectErrors.next()
      }
    };

    errors.toArray()
  }
}

@test
fun testCallGraph(): void {
  testDirectory("./tests/callgraph/", validateCallGraph, UpdateMode::fromEnv())
}

@test
fun testCallGraphUnsupported(): void {
  testDirectory(
    "./tests/callgraph-unsupported/",
    validateExpectErrorComments,
    UpdateMode::fromEnv(),
  )
}

@test
fun testProjects(): void {
  update = UpdateMode::fromEnv();
  dir = Path.resolve("./tests/projects/");
  for (subDir in FileSystem.readDirectory(dir)) {
    projectDir = Path.join(dir, subDir);
    if (FileSystem.isDirectory(projectDir)) {
      testProject(projectDir, update)
    }
  }
}

fun checkNoLostTest(path: String): void {
  files = if (FileSystem.isDirectory(path)) {
    FileSystem.readFilesRecursive(path)
  } else {
    Array[path]
  };
  for (file in files) {
    if (SKJS.isTsFile(file)) {
      invariant_violation(`${file} not covered by tests`)
    };
    if (file.endsWith(".js")) {
      invariant_violation(`${file}: no JS file expected`)
    }
  }
}

@test
fun testNoLostTest(): void {
  cwd = getcwd();

  // Check examples/ - specific subdirs are covered by other tests
  examplesDir = Path.join(cwd, "examples");
  coveredExampleDirs = Set[
    "src", // handled in testExamples
  ];
  for (subDir in FileSystem.readDirectory(examplesDir)) {
    if (coveredExampleDirs.contains(subDir)) continue;
    checkNoLostTest(Path.join(examplesDir, subDir))
  };

  // Check tests/ - specific subdirs are covered by other tests
  testsDir = Path.join(cwd, "tests");
  coveredTestDirs = Set[
    "expect-error", // handled in testExpectError
    "ts-conformance", // handled in testTypeScriptConformance and testNotSupportedTypeScriptConformance
    "projects", // handled in testProjects
    "callgraph", // handled in testCallGraph
    "callgraph-unsupported", // handled in testCallGraphUnsupported
  ];
  for (subDir in FileSystem.readDirectory(testsDir)) {
    if (coveredTestDirs.contains(subDir)) continue;
    checkNoLostTest(Path.join(testsDir, subDir))
  }
}

module end;
