module SKJSTests;

// A backslash as the final character of an unterminated string literal must not
// push the lexer past end-of-input. When it does (pos + 2 with nothing left to
// escape), the reported error position lands one character past the buffer, and
// rendering it panics with "Out of bounds" instead of reporting an unterminated
// string. Follow-up to the string-escape decoding work (#771).
//
// The test inspects the reported error position directly rather than rendering
// it, so it stays robust regardless of how the position is displayed: the fix
// keeps the position within [0, size], where before it overshot to size + 1.
@test
fun testTrailingBackslashDoesNotOvershoot(): void {
  for (q in Array["\"", "'", "`"]) {
    content = "type T = " + q + "\\";
    size = content.chars().size();
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    errOpt = try {
      _ = parser.toplevelDefs();
      None()
    } catch {
    | SKJS.ErrorExn(err) -> Some(err)
    | exn -> throw exn
    };
    errOpt match {
    | Some(le @ SKJS.LexingError _) ->
      le.pos match {
      | SKJS.EPChar(_, p) ->
        SKTest.expectTrue(
          p.value <= size,
          `${content}: error position ${p.value} must stay within size ${size}`,
        )
      | _ -> SKTest.expectTrue(false, `${content}: expected an EPChar position`)
      }
    | _ ->
      SKTest.expectTrue(
        false,
        `${content}: expected an unterminated-string LexingError`,
      )
    }
  }
}

// A LineContinuation may use a CRLF line terminator (`\` + CR + LF), which
// ECMAScript elides to nothing. The scanner consumes the LF as part of the
// continuation, so `"x\<CR><LF>y"` lexes cleanly as one string token rather
// than raising NewLineInString.
@test
fun testCrlfLineContinuation(): void {
  bs = "\\";
  cr = Char::fromCode(13).toString();
  lf = Char::fromCode(10).toString();
  // const a = "x\<CR><LF>y";  (the backslash-CRLF is a line continuation)
  content = `const a = "x${bs}${cr}${lf}y";`;
  fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
  lexer = SKJS.Lexer::mcreate(fileName, content);
  parser = mutable SKJS.Parser(lexer);
  threw = try {
    _ = parser.toplevelDefs();
    false
  } catch {
  | SKJS.ErrorExn(_) -> true
  | exn -> throw exn
  };
  SKTest.expectFalse(
    threw,
    "a CRLF line continuation should lex as one string token",
  )
}

// A numeric literal that ends exactly at end-of-file (no trailing character)
// must lex cleanly. The number scanner read `contents[pos]` without a bounds
// check, so after the final digit it indexed one past the buffer and threw
// OutOfBounds — a crash on a realistic input (a file ending in a number with no
// newline). The scanner now stops at end-of-input like the identifier scanner.
@test
fun testNumberAtEofDoesNotCrash(): void {
  threw = false;
  for (content in Array["type A = 5", "type B = 0x1f", "type C = 1.5e3"]) {
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    try {
      _ = parser.toplevelDefs()
    } catch {
    | _ -> !threw = true
    }
  };
  SKTest.expectFalse(
    threw,
    "a numeric literal at end-of-file must lex without crashing",
  )
}

// In expression context the lexer emits template *chunk* tokens; a brace inside
// a string argument of an interpolation is handled by the ordinary expression
// parse (the chunk stops at `${`), so this lexes and parses cleanly rather than
// scanning to end-of-input. (#820)
@test
fun testTemplateBraceInStringArgLexesCleanly(): void {
  bt = "`";
  q = "\"";
  // function f() { const s = `${"{"}`; }
  content =
    "function f() { const s = " +
    bt +
    "${" +
    q +
    "{" +
    q +
    "}" +
    bt +
    "; }";
  fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
  lexer = SKJS.Lexer::mcreate(fileName, content);
  parser = mutable SKJS.Parser(lexer);
  threw = try {
    _ = parser.toplevelDefs();
    false
  } catch {
  | SKJS.ErrorExn(_) -> true
  | exn -> throw exn
  };
  SKTest.expectFalse(threw, "a brace in a string arg must lex/parse cleanly")
}

// A backslash as the final character of a template chunk (expression context)
// must report an in-bounds unterminated error, not overshoot the buffer — the
// analogue of testTrailingBackslashDoesNotOvershoot for scanTemplateChunk.
@test
fun testTemplateChunkTrailingBackslash(): void {
  bt = "`";
  bs = "\\";
  content = "const a = " + bt + bs; // const a = `\   (unterminated, backslash last)
  size = content.chars().size();
  fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
  lexer = SKJS.Lexer::mcreate(fileName, content);
  parser = mutable SKJS.Parser(lexer);
  errOpt = try {
    _ = parser.toplevelDefs();
    None()
  } catch {
  | SKJS.ErrorExn(err) -> Some(err)
  | exn -> throw exn
  };
  errOpt match {
  | Some(le @ SKJS.LexingError _) ->
    le.pos match {
    | SKJS.EPChar(_, p) ->
      SKTest.expectTrue(
        p.value <= size,
        `error position ${p.value} must stay within size ${size}`,
      )
    | _ -> SKTest.expectTrue(false, "expected an EPChar position")
    }
  | _ -> SKTest.expectTrue(false, "expected an unterminated-template error")
  }
}

// A template type inside a parenthesized type must not derail `isTypeFunParams`,
// the parser's only blind token-scanning lookahead. It counts parens by lexing
// tokens, so it must step over a template whole (Lexer.skipTemplate): lexing on
// would resume inside the interpolation and treat the template's own closing
// backtick as the start of a NEW template, scanning to end-of-input — and an
// interpolation containing parens would corrupt the count. The error thrown
// would escape lookAhead, which does not catch ErrorExn.
@test
fun testTemplateTypeInParenthesizedTypeLexesCleanly(): void {
  bt = "`";
  for (hole in Array["string", "(q: string) => void"]) {
    // type T = (x: `a${<hole>}b`) => void;
    content = `type T = (x: ${bt}a$\{${hole}}b${bt}) => void;`;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    threw = try {
      _ = parser.toplevelDefs();
      false
    } catch {
    | SKJS.ErrorExn(_) -> true
    | exn -> throw exn
    };
    SKTest.expectFalse(
      threw,
      `${content}: a template type in a parenthesized type must parse cleanly`,
    )
  }
}

// A string literal's body excludes LineTerminators, and a lone <CR> is one, so
// a string holding a raw one is unterminated -- tsc reports TS1002 and node will
// not parse the file. The scanner reads only <LF> as ending a line, so SKJS
// accepts it.
//
// Tested here rather than as an expect-error fixture for two reasons: the CR has
// to survive as a byte, and once a <CR> ends a line the fixture could not put the
// error on the last non-empty line, which that harness requires of a parse error.
@test
fun testLoneCarriageReturnInStringIsRejected(): void {
  cr = Char::fromCode(13).toString();
  for (q in Array["\"", "'"]) {
    // function f(): void { const s = "a<CR>b"; }
    content = `function f(): void { const s = ${q}a${cr}b${q}; }`;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    threw = try {
      _ = parser.toplevelDefs();
      false
    } catch {
    | SKJS.ErrorExn(_) -> true
    | exn -> throw exn
    };
    SKTest.expectTrue(
      threw,
      `${q}: a lone carriage return must end the string as unterminated`,
    )
  }
}

// The other half of the same rule: <LS> and <PS> are LineTerminators too, but
// ES2019's JSON-superset change admits them into a string literal, so they are
// content there rather than the end of it. node parses this and tsc accepts it.
// Folding them in with <LF>/<CR> is the obvious way to get the rule wrong, and
// it would turn valid programs into parse errors.
@test
fun testLineAndParagraphSeparatorsAreAllowedInStrings(): void {
  for (sep in Array[Char::fromCode(0x2028), Char::fromCode(0x2029)]) {
    for (q in Array["\"", "'"]) {
      content = `function f(): void { const s = ${q}a${sep}b${q}; }`;
      fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
      lexer = SKJS.Lexer::mcreate(fileName, content);
      parser = mutable SKJS.Parser(lexer);
      threw = try {
        _ = parser.toplevelDefs();
        false
      } catch {
      | SKJS.ErrorExn(_) -> true
      | exn -> throw exn
      };
      SKTest.expectFalse(
        threw,
        `${q}: U+${sep.code()} is content in a string, not the end of it`,
      )
    }
  }
}

// ECMA-262 sec 12.2: WhiteSpace is <TAB>, <VT>, <FF>, <ZWNBSP> and every
// Unicode Space_Separator (Zs) -- <SP> and <NBSP> among them -- and sec 12.3
// adds the LineTerminators <LF>, <CR>, <LS> and <PS>. Any of them may sit
// between two tokens.
//
// The sets are the ones node itself reports, which excludes two characters worth
// naming: U+180E was Zs before Unicode 6.3 and is not whitespace now, and U+200B
// (zero width space) never was, despite its name.
@test
fun testEveryJSWhiteSpaceSeparatesTokens(): void {
  codes = Array[
    0x09,
    0x0B,
    0x0C,
    0x20,
    0xA0,
    0x1680,
    0x2000,
    0x200A,
    0x2028,
    0x2029,
    0x202F,
    0x205F,
    0x3000,
    0xFEFF,
    0x0A,
    0x0D,
  ];
  for (code in codes) {
    ws = Char::fromCode(code).toString();
    content = `const a${ws}= 1;`;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    threw = try {
      _ = parser.toplevelDefs();
      false
    } catch {
    | SKJS.ErrorExn(_) -> true
    | exn -> throw exn
    };
    SKTest.expectFalse(threw, `U+${code} between two tokens`)
  };
  // The other half of the rule: these two look like whitespace and are not, so
  // they stay invalid characters. U+180E was Space_Separator until Unicode 6.3,
  // and U+200B is called a zero width space but never was one; node rejects
  // both between tokens.
  for (code in Array[0x180E, 0x200B]) {
    notWs = Char::fromCode(code).toString();
    content = `const a${notWs}= 1;`;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    threw = try {
      _ = parser.toplevelDefs();
      false
    } catch {
    | SKJS.ErrorExn(_) -> true
    | exn -> throw exn
    };
    SKTest.expectTrue(threw, `U+${code} is not whitespace`)
  }
}

// A line comment runs to the next LineTerminator, which is any of <LF>, <CR>,
// <LS> and <PS> -- not <LF> alone. Reading only <LF> let a comment ended by any
// of the others swallow the code after it, so a real error was silently
// accepted: that half hid bugs rather than inventing them.
@test
fun testLineCommentEndsAtEveryLineTerminator(): void {
  for (code in Array[0x0A, 0x0D, 0x2028, 0x2029]) {
    term = Char::fromCode(code).toString();
    content = `// a comment${term}const a = 1;`;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    defs = parser.toplevelDefs();
    SKTest.expectEq(
      defs.size(),
      1,
      `U+${code} after a line comment: the const that follows it`,
    )
  }
}

// A `#!` hashbang is only a hashbang at the very start of the file (a leading
// byte order mark aside); tsc rejects one anywhere else (TS18026), and `#`
// otherwise begins a private name. The scanner fired the hashbang branch on any
// `#!` it reached and silently dropped the rest of that line (#823).
//
// Every case carries a `)(` after the `#!`, which is a parse error unless it is
// swallowed. So a case parses cleanly exactly when its `#!` was treated as a
// hashbang -- which makes the harness able to see the difference at every
// position, including that a byte order mark before the `#!` still counts as
// the start while whitespace does not.
@test
fun testHashbangOnlyAtFileStart(): void {
  lf = Char::fromCode(10).toString();
  bom = Char::fromCode(0xFEFF).toString();
  // (source, whether it should parse cleanly = whether the `#!` is a hashbang)
  cases = Array[
    (`#! )( ${lf}const x = 1;`, true),
    (`${bom}#! )( ${lf}const x = 1;`, true),
    (`const x = 1;${lf}#! )( ${lf}const y = 2;`, false),
    (` #! )( ${lf}const x = 1;`, false),
  ];
  for (case in cases) {
    (content, shouldParse) = case;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    threw = try {
      _ = parser.toplevelDefs();
      false
    } catch {
    | SKJS.ErrorExn(_) -> true
    | exn -> throw exn
    };
    SKTest.expectEq(!threw, shouldParse, content)
  }
}

// A `.` that a digit follows begins a NumericLiteral (`.5` is `0.5`), which the
// scanner never checked for: it always produced a `.`, so `.5` failed to parse
// where tsc accepts it (#821). `...` and a `.` that no digit follows are
// unaffected, and so is a trailing dot (`5.`), which the number scan already
// consumed.
@test
fun testLeadingDotNumber(): void {
  // (source, first token's kind, that token's text)
  cases = Array[
    (".5", "a number", ".5"),
    (".5e3", "a number", ".5e3"),
    (".5e+3", "a number", ".5e+3"),
    // Not a digit after the dot: still a dot.
    (".a", ".", "."),
    ("...a", "...", "..."),
    // Already handled by the number scan, which consumes a trailing dot.
    ("5.", "a number", "5."),
    ("5.5", "a number", "5.5"),
  ];
  for (case in cases) {
    (content, expectedKind, expectedText) = case;
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    lexer.next() match {
    | None() -> SKTest.expectTrue(false, `${content}: no token at all`)
    | Some(tok) ->
      SKTest.expectEq(tok.kind.toString(), expectedKind, `${content}: kind`);
      SKTest.expectEq(
        lexer.getTokenRawStringContent(tok),
        expectedText,
        `${content}: text`,
      )
    }
  }
}

module end;
