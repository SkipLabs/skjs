module SKJSTests;

// A backslash as the final character of an unterminated string literal must not
// push the lexer past end-of-input. When it does (pos + 2 with nothing left to
// escape), the reported error position lands one character past the buffer, and
// rendering it panics with "Out of bounds" instead of reporting an unterminated
// string. Follow-up to the string-escape decoding work (#771).
//
// The test inspects the reported error position directly rather than rendering
// it, so it stays robust regardless of how the position is displayed: the fix
// keeps the position within [0, size], where before it overshot to size + 1.
@test
fun testTrailingBackslashDoesNotOvershoot(): void {
  for (q in Array["\"", "'", "`"]) {
    content = "type T = " + q + "\\";
    size = content.chars().size();
    fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
    lexer = SKJS.Lexer::mcreate(fileName, content);
    parser = mutable SKJS.Parser(lexer);
    errOpt = try {
      _ = parser.toplevelDefs();
      None()
    } catch {
    | SKJS.ErrorExn(err) -> Some(err)
    | exn -> throw exn
    };
    errOpt match {
    | Some(le @ SKJS.LexingError _) ->
      le.pos match {
      | SKJS.EPChar(_, p) ->
        SKTest.expectTrue(
          p.value <= size,
          `${content}: error position ${p.value} must stay within size ${size}`,
        )
      | _ -> SKTest.expectTrue(false, `${content}: expected an EPChar position`)
      }
    | _ ->
      SKTest.expectTrue(
        false,
        `${content}: expected an unterminated-string LexingError`,
      )
    }
  }
}

// A LineContinuation may use a CRLF line terminator (`\` + CR + LF), which
// ECMAScript elides to nothing. The scanner consumes the LF as part of the
// continuation, so `"x\<CR><LF>y"` lexes cleanly as one string token rather
// than raising NewLineInString.
@test
fun testCrlfLineContinuation(): void {
  bs = "\\";
  cr = Char::fromCode(13).toString();
  lf = Char::fromCode(10).toString();
  // const a = "x\<CR><LF>y";  (the backslash-CRLF is a line continuation)
  content = `const a = "x${bs}${cr}${lf}y";`;
  fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
  lexer = SKJS.Lexer::mcreate(fileName, content);
  parser = mutable SKJS.Parser(lexer);
  threw = try {
    _ = parser.toplevelDefs();
    false
  } catch {
  | SKJS.ErrorExn(_) -> true
  | exn -> throw exn
  };
  SKTest.expectFalse(
    threw,
    "a CRLF line continuation should lex as one string token",
  )
}

module end;
