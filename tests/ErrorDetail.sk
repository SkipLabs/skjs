// Unit tests for SubtypingError rendering across STErrorDetail levels
// (default, normal, verbose, full), especially STRecFieldsMissingIndex (#738).
module SKJSTests;

fun renderSingleSubtypingErrorAt(
  source: String,
  detail: SKJS.STErrorDetail,
): Array<String> {
  virtualPath = "/virtual/error-detail-test.ts";
  fs = SKJS.OverlayFs{
    underlying => SKJS.DiskFs(),
    overlay => mkMem(Array[(virtualPath, source)]),
  };
  context = SKStore.Context::mcreate{};
  files =
    SKJS.Files::create(
      context,
      fs,
      "/virtual",
      Array[virtualPath],
      Array[Path.resolve("./import-stubs")],
    ) |> expectFilesSuccess;
  SKJS.writeConfig(
    context,
    SKJS.CheckerConfig{
      errorHandling => SKJS.EHDefault(),
      errorDetailConfig => SKJS.ErrorDetailConfig::minimal(),
    },
  );
  checker = SKJS.Checker::create{context, fs, files}.fromSuccess();
  checked = checker.checkFiles(context);
  filePath = SKJS.FPath::create(SKJS.RootId::project, "error-detail-test.ts");
  errors = checked.getArray(context, filePath).flatMap(f -> f.errors);
  SKTest.expectEq(1, errors.size(), `expected 1 error, got ${errors.size()}`);
  errors[0] match {
  | se @ SKJS.SubtypingError _ ->
    se.renderDetail(context, detail).map(m -> m.i1)
  | other ->
    invariant_violation(
      `expected SubtypingError, got ${checker.errorToString(context, other)}`,
    )
  }
}

@test
fun testMissingIndexErrorDetailLevels(): void {
  // Missing index signature where the target index value is a type alias
  // expanding to a union.
  source =
    "type Val = number | string;\n" +
    "function f(x: {}): { [k: string]: Val } {\n" +
    "  return x;\n" +
    "}\n";

  // Default, normal, and verbose surface the enclosing object pair and the
  // missing-index reason without the internal probe witness.
  expectedSummary = Array[
    "Type '{}'",
    "is not assignable to type '{ [k: string]: Val; }'",
    "Missing index signature 'k' in source type",
  ];
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::default),
    expectedSummary,
    "default detail",
  );
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::normal),
    expectedSummary,
    "normal detail",
  );
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::verbose),
    expectedSummary,
    "verbose detail",
  );

  // At full detail, STRecFieldsMissingIndex also renders the recursive probe
  // witness err.toError(subst, tenv, detailForRec), expanding the aliased
  // index value type.
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::full),
    Array[
      "Type '{}'",
      "is not assignable to type '{ [k: string]: Val; }'",
      "Missing index signature 'k' in source type",
      "Type 'unknown'",
      "is not assignable to type 'Val'",
      "Type 'unknown'",
      "is not assignable to type 'number | string'",
    ],
    "full detail",
  );
}

@test
fun testMissingIndexSetterProbeErrorDetail(): void {
  // Target index `{ [k: string]: unknown }`: the getter probe
  // (`unknown <: unknown`) succeeds, and the setter probe (`unknown <: never`)
  // fails.
  source =
    "function f(x: {}): { [k: string]: unknown } {\n" +
    "  return x;\n" +
    "}\n";

  expectedSummary = Array[
    "Type '{}'",
    "is not assignable to type '{ [k: string]: unknown; }'",
    "Missing index signature 'k' in source type",
  ];
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::default),
    expectedSummary,
    "default detail",
  );
  // At full detail, the setter-probe witness (`unknown <: never`) is appended.
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::full),
    Array[
      "Type '{}'",
      "is not assignable to type '{ [k: string]: unknown; }'",
      "Missing index signature 'k' in source type",
      "Type 'unknown'",
      "is not assignable to type 'never'",
    ],
    "full detail",
  );
}

@test
fun testClosedTargetMissingIndexErrorDetail(): void {
  // Closed<T> uses a never-valued index signature; assigning an open object
  // type reports the closed-target explanation.
  source =
    "function f(x: { a: number }): Closed<{ a: number }> {\n" +
    "  return x;\n" +
    "}\n";

  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::default),
    Array[
      "Type '{ a: number; }'",
      "is not assignable to type 'Closed<{ a: number; }>'",
      "The target is a closed object type: every unnamed key is provably absent, but the source is an open object type that may have unknown extra keys",
    ],
    "default detail for Closed<T>",
  );
  // At full detail, the recursive probe witness (`unknown <: never`) is also
  // surfaced after the closed-target explanation.
  SKTest.expectEq(
    renderSingleSubtypingErrorAt(source, SKJS.STErrorDetail::full),
    Array[
      "Type '{ a: number; }'",
      "is not assignable to type 'Closed<{ a: ...; }>'",
      "Type '{ a: number; }'",
      "is not assignable to type 'Closed<{ a: number; }>'",
      "The target is a closed object type: every unnamed key is provably absent, but the source is an open object type that may have unknown extra keys",
      "Type 'unknown'",
      "is not assignable to type 'never'",
    ],
    "full detail for Closed<T>",
  );
}

fun singleErrorMessages(source: String): Array<String> {
  virtualPath = "/virtual/error-detail-test.ts";
  fs = SKJS.OverlayFs{
    underlying => SKJS.DiskFs(),
    overlay => mkMem(Array[(virtualPath, source)]),
  };
  context = SKStore.Context::mcreate{};
  files =
    SKJS.Files::create(
      context,
      fs,
      "/virtual",
      Array[virtualPath],
      Array[Path.resolve("./import-stubs")],
    ) |> expectFilesSuccess;
  SKJS.writeConfig(
    context,
    SKJS.CheckerConfig{
      errorHandling => SKJS.EHDefault(),
      errorDetailConfig => SKJS.ErrorDetailConfig::minimal(),
    },
  );
  checker = SKJS.Checker::create{context, fs, files}.fromSuccess();
  checked = checker.checkFiles(context);
  filePath = SKJS.FPath::create(SKJS.RootId::project, "error-detail-test.ts");
  errors = checked.getArray(context, filePath).flatMap(f -> f.errors);
  SKTest.expectEq(1, errors.size(), `expected 1 error, got ${errors.size()}`);
  errors[0] match {
  | ne @ SKJS.NamingError _ -> ne.messages.map(m -> m.i1)
  | other ->
    invariant_violation(
      `expected NamingError, got ${checker.errorToString(context, other)}`,
    )
  }
}

@test
fun testMissingPropertyNeverIndexMessages(): void {
  // Plain open object: no closed or never-index note.
  SKTest.expectEq(
    singleErrorMessages(
      "function f(x: { readonly a: number }): void { const v = x.b; }\n",
    ),
    Array[
      "Property 'b' does not exist on this type",
      "Possible options are:\na",
    ],
    "open object missing property",
  );

  // Closed<T>: closed-object note.
  SKTest.expectEq(
    singleErrorMessages(
      "function f(x: Closed<{ readonly a: number }>): void { const v = x.b; }\n",
    ),
    Array[
      "Property 'b' does not exist on this type",
      "Possible options are:\na",
      "The object type is closed: its unnamed keys are provably absent",
    ],
    "closed object missing property",
  );

  // Number never-index with numeric key: currently omits the never-index note.
  SKTest.expectEq(
    singleErrorMessages(
      "function f(x: { readonly a: number; [k: number]: never }): void { const v = x[0]; }\n",
    ),
    Array[
      "Property '0' does not exist on this type",
      "Possible options are:\na",
    ],
    "never number index numeric key",
  );

  // Symbol never-index with string key: currently falsely emits the closed note.
  SKTest.expectEq(
    singleErrorMessages(
      "function f(x: { readonly a: number; [k: symbol]: never }): void { const v = x.b; }\n",
    ),
    Array[
      "Property 'b' does not exist on this type",
      "Possible options are:\na",
      "The object type is closed: its unnamed keys are provably absent",
    ],
    "never symbol index string key",
  );

  // Closed<T> symbol key: currently emits no closed/never-index note.
  SKTest.expectEq(
    singleErrorMessages(
      "declare const sym: unique symbol;\n" +
        "function f(x: Closed<{ readonly a: number }>): void { const v = x[sym]; }\n",
    ),
    Array["This symbol property does not exist on the object"],
    "closed object missing symbol key",
  );

  // Closed<T> destructuring: currently emits no closed/never-index note.
  SKTest.expectEq(
    singleErrorMessages(
      "function f(x: Closed<{ readonly a: number }>): void { const { b } = x; }\n",
    ),
    Array[
      "Property 'b' does not exist on this type",
      "Out of 'Closed<{ readonly a: ...; }>'",
    ],
    "closed object destructuring",
  );
}

module end;
