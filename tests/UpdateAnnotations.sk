module SKJSTests;

fun lines(parts: Array<String>): String {
  "\n".join(parts)
}

@test
fun testUpdateFileAnnotations(): void {
  noErrors = Map[];
  noFull = Map[];

  // 1. No changes needed
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["Type mismatch"]],
      noFull,
    ),
    None(),
    "No changes needed",
  );

  // 2. Error message changes
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Old message",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["New message"]],
      Map["New message" => "New message full"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error New message full",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Error message changes",
  );

  // 3. Error removed
  SKTest.expectEq(
    updateFileAnnotations(
      lines(Array["// @skjs-expect-error Some error", "const x: number = 42;"]),
      noErrors,
      noFull,
    ),
    Some("const x: number = 42;"),
    "Error removed",
  );

  // 4. New error appears
  SKTest.expectEq(
    updateFileAnnotations(
      "const x: number = \"hello\";",
      Map[1 => SortedSet["Type mismatch"]],
      Map["Type mismatch" => "Type mismatch full"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch full",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "New error appears",
  );

  // 5. Multiple errors on one line
  SKTest.expectEq(
    updateFileAnnotations(
      "const x: number = \"hello\";",
      Map[1 => SortedSet["Error A", "Error B"]],
      Map["Error A" => "Error A", "Error B" => "Error B"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Error A",
          "// @skjs-expect-error Error B",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Multiple errors on one line",
  );

  // 6. @ts-expect-error preserved when message still matches
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @ts-expect-error Type mismatch",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["Type mismatch"]],
      noFull,
    ),
    None(),
    "@ts-expect-error preserved",
  );

  // 7. @ts-expect-error dropped when message no longer matches
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @ts-expect-error Old message",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["New message"]],
      Map["New message" => "New message"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error New message",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "@ts-expect-error dropped",
  );

  // 8. Mixed ordering: @skjs first, @ts last
  SKTest.expectEq(
    updateFileAnnotations(
      lines(Array["// @ts-expect-error Msg B", "const x: number = \"hello\";"]),
      Map[2 => SortedSet["Msg A", "Msg B"]],
      Map["Msg A" => "Msg A"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg A",
          "// @ts-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Mixed @skjs/@ts ordering",
  );

  // 9. Both @skjs and @ts preexisting, no changes needed
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg A",
          "// @ts-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg A", "Msg B"]],
      noFull,
    ),
    None(),
    "Both @skjs and @ts preexisting, no changes",
  );

  // 10. Both @skjs and @ts preexisting, errors change
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg A",
          "// @ts-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg B", "Msg C"]],
      Map["Msg C" => "Msg C"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg C",
          "// @ts-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Both @skjs and @ts preexisting, errors change",
  );

  // 11. Indentation preserved from code line
  SKTest.expectEq(
    updateFileAnnotations(
      "    const x: number = \"hello\";",
      Map[1 => SortedSet["Type error"]],
      Map["Type error" => "Type error"],
    ),
    Some(
      lines(
        Array[
          "    // @skjs-expect-error Type error",
          "    const x: number = \"hello\";",
        ],
      ),
    ),
    "Indentation preserved",
  );

  // 12. All annotations removed
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Error A",
          "// @skjs-expect-error Error B",
          "const x: number = 42;",
        ],
      ),
      noErrors,
      noFull,
    ),
    Some("const x: number = 42;"),
    "All annotations removed",
  );

  // 13. Original message formatting preserved
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch...",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["Type mismatch"]],
      noFull,
    ),
    None(),
    "Original message formatting preserved",
  );

  // 14. Full message used for new errors
  SKTest.expectEq(
    updateFileAnnotations(
      "const x: number = \"hello\";",
      Map[1 => SortedSet["Type mismatch"]],
      Map["Type mismatch" => "Type mismatch between types."],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch between types.",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Full message used for new errors",
  );

  // 15. Full rewrite replaces preserved annotation text
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch...",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["Type mismatch"]],
      Map["Type mismatch" => "Type mismatch between types."],
      UMFullMessages(),
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch between types.",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Full rewrite replaces preserved annotation text",
  );

  // 16. Full rewrite falls back to trimmed when no full message available
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch...",
          "const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["Type mismatch"]],
      noFull,
      UMFullMessages(),
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Full rewrite falls back to trimmed when no full message",
  );

  // 17. Non-alphabetical annotation order preserved when set matches
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg B",
          "// @skjs-expect-error Msg A",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg A", "Msg B"]],
      Map["Msg A" => "Msg A", "Msg B" => "Msg B"],
    ),
    None(),
    "Non-alphabetical order preserved when set matches",
  );

  // 18. Partial group change preserves order of remaining annotations
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg C",
          "// @skjs-expect-error Msg B",
          "// @skjs-expect-error Msg A",
          "const x: number = \"hello\";",
        ],
      ),
      Map[4 => SortedSet["Msg A", "Msg C"]],
      Map["Msg A" => "Msg A", "Msg C" => "Msg C"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg C",
          "// @skjs-expect-error Msg A",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Partial group change preserves order of remaining",
  );

  // 19. Partial group change: new messages added after existing
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg B",
          "// @skjs-expect-error Msg A",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg A", "Msg B", "Msg C"]],
      Map["Msg A" => "Msg A", "Msg B" => "Msg B", "Msg C" => "Msg C"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg B",
          "// @skjs-expect-error Msg A",
          "// @skjs-expect-error Msg C",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "New messages added after existing in original order",
  );

  // 20. Non-last @ts-expect-error stays in original position
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @ts-expect-error Msg A",
          "// @skjs-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg A", "Msg C"]],
      Map["Msg C" => "Msg C"],
    ),
    Some(
      lines(
        Array[
          "// @ts-expect-error Msg A",
          "// @skjs-expect-error Msg C",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Non-last @ts-expect-error stays in position",
  );

  // 21. useFullMessages rewrites text but preserves order
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg B...",
          "// @skjs-expect-error Msg A...",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg A", "Msg B"]],
      Map["Msg A" => "Msg A full", "Msg B" => "Msg B full"],
      UMFullMessages(),
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg B full",
          "// @skjs-expect-error Msg A full",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "UMFullMessages rewrites text but preserves order",
  );

  // 22. Last @ts-expect-error stays last when group changes
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg A",
          "// @ts-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg B", "Msg C"]],
      Map["Msg C" => "Msg C"],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg C",
          "// @ts-expect-error Msg B",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Last @ts-expect-error stays last when group changes",
  );

  // 23. reorder forces alphabetical order
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Msg B...",
          "// @skjs-expect-error Msg A...",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Msg A", "Msg B"]],
      Map["Msg A" => "Msg A full", "Msg B" => "Msg B full"],
      UMFullRewrite(),
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Msg A full",
          "// @skjs-expect-error Msg B full",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "reorder forces alphabetical order",
  );

  // 24. Original annotation indentation preserved when text updated
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "    // @skjs-expect-error Type error...",
          "  const x: number = \"hello\";",
        ],
      ),
      Map[2 => SortedSet["Type error"]],
      Map["Type error" => "Type error full"],
      UMFullMessages(),
    ),
    Some(
      lines(
        Array[
          "    // @skjs-expect-error Type error full",
          "  const x: number = \"hello\";",
        ],
      ),
    ),
    "Original annotation indentation preserved",
  );

  // 25. lineN annotation — no changes needed
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Invalid call",
          "// @skjs-expect-error-line2 This error would go away if this field was readonly",
          "testFoo();",
        ],
      ),
      Map[3 => SortedSet["Invalid call"]],
      noFull,
      UMUpdate(),
      Map[3 => Map[2 => "This error would go away if this field was readonly"]],
    ),
    None(),
    "lineN annotation — no changes needed",
  );

  // 26. lineN annotation not added automatically
  SKTest.expectEq(
    updateFileAnnotations(
      "testFoo();",
      Map[1 => SortedSet["Invalid call"]],
      Map["Invalid call" => "Invalid call"],
      UMUpdate(),
      Map[1 => Map[2 => "This error would go away if this field was readonly"]],
    ),
    Some(lines(Array["// @skjs-expect-error Invalid call", "testFoo();"])),
    "lineN annotation not added automatically",
  );

  // 27. lineN annotation removed when error has no second line
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Invalid call",
          "// @skjs-expect-error-line2 Stale hint",
          "testFoo();",
        ],
      ),
      Map[3 => SortedSet["Invalid call"]],
      Map["Invalid call" => "Invalid call"],
      UMUpdate(),
      Map[3 => Map[]],
    ),
    Some(lines(Array["// @skjs-expect-error Invalid call", "testFoo();"])),
    "lineN annotation removed when error has no second line",
  );

  // 28. lineN annotation updated when second line changes
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Invalid call",
          "// @skjs-expect-error-line2 Old hint",
          "testFoo();",
        ],
      ),
      Map[3 => SortedSet["Invalid call"]],
      Map["Invalid call" => "Invalid call"],
      UMUpdate(),
      Map[3 => Map[2 => "New hint"]],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Invalid call",
          "// @skjs-expect-error-line2 New hint",
          "testFoo();",
        ],
      ),
    ),
    "lineN annotation updated when second line changes",
  );

  // 29. Multiple errors on line — no lineN data means plain annotations only
  SKTest.expectEq(
    updateFileAnnotations(
      "testFoo();",
      Map[1 => SortedSet["Error A", "Error B"]],
      Map["Error A" => "Error A", "Error B" => "Error B"],
      UMUpdate(),
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Error A",
          "// @skjs-expect-error Error B",
          "testFoo();",
        ],
      ),
    ),
    "Multiple errors without lineN data",
  );

  // Warning: new warning appears (no existing annotation)
  SKTest.expectEq(
    updateFileAnnotations(
      "const x: number = 42;",
      noErrors,
      Map["Useless thing" => "Useless thing full"],
      UMUpdate(),
      Map[],
      Map[1 => SortedSet["Useless thing"]],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-warning Useless thing full",
          "const x: number = 42;",
        ],
      ),
    ),
    "New warning appears",
  );

  // Warning: unchanged warning needs no update
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array["// @skjs-expect-warning Useless thing", "const x: number = 42;"],
      ),
      noErrors,
      noFull,
      UMUpdate(),
      Map[],
      Map[2 => SortedSet["Useless thing"]],
    ),
    None(),
    "Warning unchanged",
  );

  // Warning: stale warning removed
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array["// @skjs-expect-warning Useless thing", "const x: number = 42;"],
      ),
      noErrors,
      noFull,
      UMUpdate(),
      Map[],
      Map[],
    ),
    Some("const x: number = 42;"),
    "Stale warning removed",
  );

  // Warning: error and warning on the same line — errors first, then warnings
  SKTest.expectEq(
    updateFileAnnotations(
      "const x: number = \"hello\";",
      Map[1 => SortedSet["Type mismatch"]],
      Map[
        "Type mismatch" => "Type mismatch",
        "Useless thing" => "Useless thing",
      ],
      UMUpdate(),
      Map[],
      Map[1 => SortedSet["Useless thing"]],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch",
          "// @skjs-expect-warning Useless thing",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Error and warning on the same line",
  );

  // Warning: a diagnostic that became a warning is re-tagged
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array["// @skjs-expect-error Useless thing", "const x: number = 42;"],
      ),
      noErrors,
      Map["Useless thing" => "Useless thing"],
      UMUpdate(),
      Map[],
      Map[2 => SortedSet["Useless thing"]],
    ),
    Some(
      lines(
        Array["// @skjs-expect-warning Useless thing", "const x: number = 42;"],
      ),
    ),
    "Error re-tagged as warning",
  );

  // Warning: an unchanged mixed error+warning line round-trips to no-op
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-error Type mismatch",
          "// @skjs-expect-warning Useless thing",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["Type mismatch"]],
      noFull,
      UMUpdate(),
      Map[],
      Map[3 => SortedSet["Useless thing"]],
    ),
    None(),
    "Mixed error+warning unchanged",
  );

  // Warning: a warning-before-error group whose error message changed keeps its
  // original block order (warnings first) instead of being silently reordered.
  SKTest.expectEq(
    updateFileAnnotations(
      lines(
        Array[
          "// @skjs-expect-warning Useless thing",
          "// @skjs-expect-error Old error",
          "const x: number = \"hello\";",
        ],
      ),
      Map[3 => SortedSet["New error"]],
      Map["New error" => "New error"],
      UMUpdate(),
      Map[],
      Map[3 => SortedSet["Useless thing"]],
    ),
    Some(
      lines(
        Array[
          "// @skjs-expect-warning Useless thing",
          "// @skjs-expect-error New error",
          "const x: number = \"hello\";",
        ],
      ),
    ),
    "Warning-before-error order preserved when error message changes",
  );
}

@test
fun testLineNValidation(): void {
  fs = SKJS.Fs::disk();
  compilerOptions: SKJS.TsCompilerOptions = SKJS.TsCompilerOptions{};
  context = SKStore.Context::mcreate{};
  files =
    SKJS.Files::create(context, fs, ".", Array[], Array["./import-stubs"]) |>
    expectFilesSuccess;
  SKJS.writeConfig(
    context,
    SKJS.CheckerConfig{
      compilerOptions,
      errorHandling => SKJS.EHKeepGoing(),
      errorDetailConfig => SKJS.ErrorDetailConfig::minimal(),
    },
  );
  checker = SKJS.Checker::create{context, fs, files}.fromSuccess();
  tenv = checker.checker;
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  tcenvb = mutable SKJS.TCEnvLight{context, results};
  subst = SKJS.Subst::mcreate(tcenvb);
  ref = findExpectErrors(
    lines(Array["// @skjs-expect-error-line2 Hint only", "testFoo();"]),
  )[0];
  fileName = SKJS.FPath::create(SKJS.RootId::project, "tmp.ts");
  emptyErrors: Array<SKJS.Error> = Array[];
  ref.validate(subst, tenv, fileName, emptyErrors) match {
  | Some(err) ->
    SKTest.expectEq(
      err.getMessage(),
      SKTest.ExpectationError(
        `${fileName}:2 @skjs-expect-error-lineN requires exactly one @skjs-expect-error`,
        "(1 @skjs-expect-error annotation)",
        "(0 @skjs-expect-error annotations)",
      ).getMessage(),
      "lineN without primary annotation is rejected",
    )
  | None() ->
    invariant_violation("Expected lineN without primary annotation to fail")
  };

  // ExpectError.validate runs once per severity, so a mismatched warning
  // expectation must be labelled "Wrong warning message(s)", not "error".
  warnRef = findExpectErrors(
    lines(Array["// @skjs-expect-warning Useless thing", "testFoo();"]),
  )[0];
  warnRef.validate(subst, tenv, fileName, emptyErrors) match {
  | Some(err) ->
    SKTest.expectTrue(
      err.getMessage().contains("Wrong warning message(s)"),
      `a warning mismatch should be labelled as a warning, got: ${err.getMessage()}`,
    )
  | None() ->
    invariant_violation("Expected a mismatched warning expectation to fail")
  };

  // A -lineN suffix is only supported on @skjs-expect-error. On any other kind
  // it must be rejected with a clear error rather than silently swallowed into
  // the diagnostic message (see findAnnotationLines). Assert on the guard's
  // distinctive "is not supported" wording so the test cannot pass on some
  // unrelated throw (e.g. the "misplaced" or "duplicate annotation" guards).
  expectRejectedLineN = (contents: String, kind: String) -> {
    caught = try {
      _ = findExpectErrors(contents);
      None()
    } catch {
    | e -> Some(e.getMessage())
    };
    caught match {
    | Some(msg) ->
      SKTest.expectTrue(
        msg.contains("is not supported"),
        `${kind}-lineN should be rejected by the -lineN guard, got: ${msg}`,
      )
    | None() ->
      SKTest.fail(`${kind}-lineN should be rejected, but nothing was raised`)
    }
  };
  expectRejectedLineN(
    lines(Array["// @skjs-expect-warning-line2 Hint", "testFoo();"]),
    "@skjs-expect-warning",
  );
  expectRejectedLineN(
    lines(Array["// @ts-expect-error-line2 Hint", "testFoo();"]),
    "@ts-expect-error",
  )
}

module end;
