@test
fun testRescuedMapDetailPositions(): void {
  source = "declare function wrap<K extends 0 | 1>(x: Map<string, K>): K;\nfunction f(a: Map<string, 5>): void { const r = wrap(a); }\n";
  (context, errors) = checkSingleVirtualFileErrors(source);
  SKTest.expectEq(1, errors.size());
  errors[0] match {
  | err @ SKJS.SubtypingError _ ->
    detail = err.renderDetail(context, SKJS.STErrorDetail::default);
    SKTest.expectTrue(detail.size() >= 2, "expected rescued detail lines");
    for (entry in detail) {
      SKTest.expectTrue(
        entry.i0.fileName.rootId.isProject(),
        `expected project anchor, got ${entry.i0.fileName} for: ${entry.i1}`,
      )
    };
    SKTest.expectEq("Type '5'", detail[0].i1);
    SKTest.expectEq("is not assignable to type '0 | 1'", detail[1].i1)
  | _ -> SKTest.fail("expected SubtypingError")
  }
}

@test
fun testArrayConstraintRendersShorthandWithoutCollisionNote(): void {
  source = "declare function f<K extends Array<0 | 1>>(x: K): K;\nfunction g(): void { const r = f(5); }\n";
  (context, errors) = checkSingleVirtualFileErrors(source);
  SKTest.expectEq(1, errors.size());
  errors[0] match {
  | err @ SKJS.SubtypingError _ ->
    detail = err.renderDetail(context, SKJS.STErrorDetail::default);
    SKTest.expectEq(2, detail.size());
    SKTest.expectEq("Type '5'", detail[0].i1);
    SKTest.expectEq("is not assignable to type '(0 | 1)[]'", detail[1].i1);
    // No spurious '#' disambiguation note from expanded Array methods.
    SKTest.expectFalse(
      detail.any(m -> m.i1.contains("#")),
      "did not expect '#' disambiguation note on shorthand Array",
    )
  | _ -> SKTest.fail("expected SubtypingError")
  }
}

module end;
