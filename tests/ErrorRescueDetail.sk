    SKTest.expectFalse(
      detail[0].i0.fileName.rootId.isProject(),
      `pre-fix: expected stub anchor, got ${detail[0].i0.fileName}`,
    )
  | _ -> SKTest.fail("expected SubtypingError")
  }
}

@test
fun testArrayConstraintCollisionNotePreFix(): void {
  source = "declare function f<K extends Array<0 | 1>>(x: K): K;\nfunction g(): void { const r = f(5); }\n";
  (context, errors) = checkSingleVirtualFileErrors(source);
  SKTest.expectEq(1, errors.size());
  errors[0] match {
  | err @ SKJS.SubtypingError _ ->
    detail = err.renderDetail(context, SKJS.STErrorDetail::default);
    // Pre-fix (#672 item 3 residual): expanded Array<0 | 1> dumps all methods
    // and emits a spurious collision note from reduce/flatMap/reduceRight <U>.
    SKTest.expectTrue(
      detail.any(m -> m.i1.contains("#")),
      "pre-fix: expected spurious '#' disambiguation note on expanded Array",
    )
  | _ -> SKTest.fail("expected SubtypingError")
  }
}

module end;
