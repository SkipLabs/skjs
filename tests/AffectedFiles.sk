// Tests for CallGraph.affectedFiles(): given a set of changed definitions,
// computes the transitive set of files affected via the call graph.
// Uses a project (callgraph-affected/) with the call chain
// a() -> helperB() -> helperC(), an unrelated function, and a class
// hierarchy Base -> Child -> useChild() for subclass propagation.
module SKJSTests;

// Finds Def AST nodes matching a given function name in a parsed file.
fun findDefsByName(defs: Array<SKJS.Def>, targetName: String): Array<SKJS.Def> {
  results = mutable Vector[];
  for (def in defs) {
    def.value match {
    | fd @ SKJS.TopLevelFunDef _ ->
      if (fd.name.getName() == targetName) results.push(def)
    | c @ SKJS.Class _ -> if (c.name.value == targetName) results.push(def)
    | SKJS.Export(inner) ->
      innerDef = SKJS.Def::create(def.pos, inner);
      findDefsByName(Array[innerDef], targetName).each(results.push)
    | SKJS.ExportDeclare(inner) ->
      innerDef = SKJS.Def::create(def.pos, inner);
      findDefsByName(Array[innerDef], targetName).each(results.push)
    | SKJS.Declare(inner) ->
      innerDef = SKJS.Def::create(def.pos, inner);
      findDefsByName(Array[innerDef], targetName).each(results.push)
    | _ -> void
    }
  };
  results.toArray()
}

@test
fun testAffectedFiles(): void {
  fs = SKJS.Fs::disk();
  projectDir = Path.resolve("./tests/projects/callgraph-affected");
  configPath = Path.join(projectDir, "tsconfig.json");
  (config, diagnostics) = SKJS.loadTsConfig(fs, configPath);
  SKTest.expectTrue(
    diagnostics.isEmpty(),
    `expected no tsconfig diagnostics, got ${diagnostics.size()}`,
  );

  srcFiles = SKJS.resolveConfigFiles(fs, config);
  context = SKStore.Context::mcreate{};

  files =
    SKJS.Files::create(
      context,
      fs,
      projectDir,
      srcFiles,
      Array["./import-stubs"],
    ) |> expectFilesSuccess;

  SKJS.writeConfig(
    context,
    SKJS.CheckerConfig{
      compilerOptions => config.compilerOptions,
      errorHandling => SKJS.EHKeepGoing(),
      errorDetailConfig => SKJS.ErrorDetailConfig::minimal(),
    },
  );
  checker = SKJS.Checker::create{context, fs, files}.fromSuccess();

  checked = checker.checkFiles(context);
  callGraph = SKJS.CallGraph::build(context, checked);

  // Helper to get FPath for a source file under the project root
  resolve = (name: String) ~> SKJS.FPath::create(SKJS.RootId::project, name);
  aFile = resolve("src/a.ts");
  bFile = resolve("src/b.ts");
  cFile = resolve("src/c.ts");
  unrelatedFile = resolve("src/unrelated.ts");

  // Extract Def for helperC from c.ts
  cParsed = checker.parsedFiles.getArray(context, cFile);
  cDefs = cParsed[0].value match {
  | SKJS.PROk(defs) -> findDefsByName(defs, "helperC")
  | _ -> invariant_violation("Expected parsed file for c.ts")
  };
  invariant(cDefs.size() > 0, "Expected to find helperC def");

  // Test: changing helperC transitively affects b.ts and a.ts via the
  // call chain a() -> helperB() -> helperC().
  affected = callGraph.affectedFiles(context, cDefs);
  SKTest.expectTrue(affected.contains(cFile), "c.ts should be affected");
  SKTest.expectTrue(
    affected.contains(bFile),
    "b.ts should be affected (calls helperC)",
  );
  SKTest.expectTrue(
    affected.contains(aFile),
    "a.ts should be affected (calls helperB which calls helperC)",
  );
  SKTest.expectFalse(
    affected.contains(unrelatedFile),
    "unrelated.ts should not be affected",
  );

  // Test: changing unrelated should only affect unrelated.ts
  unrelatedParsed = checker.parsedFiles.getArray(context, unrelatedFile);
  unrelatedDefs = unrelatedParsed[0].value match {
  | SKJS.PROk(defs) -> findDefsByName(defs, "unrelated")
  | _ -> invariant_violation("Expected parsed file for unrelated.ts")
  };
  invariant(unrelatedDefs.size() > 0, "Expected to find unrelated def");

  affected2 = callGraph.affectedFiles(context, unrelatedDefs);
  SKTest.expectTrue(
    affected2.contains(unrelatedFile),
    "unrelated.ts should be affected by own change",
  );
  SKTest.expectFalse(
    affected2.contains(aFile),
    "a.ts should not be affected by unrelated change",
  );

  // Test: changing Base class should affect child.ts (extends Base)
  // and user.ts (uses Child which extends Base) via class hierarchy.
  baseFile = resolve("src/base.ts");
  childFile = resolve("src/child.ts");
  userFile = resolve("src/user.ts");

  baseParsed = checker.parsedFiles.getArray(context, baseFile);
  baseDefs = baseParsed[0].value match {
  | SKJS.PROk(defs) -> findDefsByName(defs, "Base")
  | _ -> invariant_violation("Expected parsed file for base.ts")
  };
  invariant(baseDefs.size() > 0, "Expected to find Base def");

  affected3 = callGraph.affectedFiles(context, baseDefs);
  SKTest.expectTrue(
    affected3.contains(baseFile),
    "base.ts should be affected by own change",
  );
  SKTest.expectTrue(
    affected3.contains(childFile),
    "child.ts should be affected (Child extends Base)",
  );
  SKTest.expectTrue(
    affected3.contains(userFile),
    "user.ts should be affected (uses Child which extends Base)",
  );
  SKTest.expectFalse(
    affected3.contains(unrelatedFile),
    "unrelated.ts should not be affected by Base change",
  );
}

module end;
