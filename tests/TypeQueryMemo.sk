module SKJSTests;

// Protocol tests: callback results below are controlled fixture values, not
// independent proofs of the arbitrary subtype/intersection labels in the keys.
// The source controls and checker suites exercise the actual type algorithms.
fun queryMemoContext(): SKJS.TypeQueryContext {
  SKJS.TypeQueryContext(SortedMap[], false, false, false)
}

fun queryMemoFailure(): SKJS.STResult<SKJS.TType> {
  // Distinct primitive kinds are represented at the clause level by the checker.
  // This fixture uses the existing recursive error constructor instead of
  // inventing a new result variant just for the memo protocol.
  num = observationNumber();
  str = observationString();
  SKJS.STRecTypeWithHint(
    SKJS.STRecClauses(List[], SKJS.Clause::top(), num.clauses, str.clauses),
    List[],
    num,
    str,
  )
}

@test
fun testSubtypeMemoHitsOnlyAfterUnchangedSuccess(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  calls = 0;
  compute: () -> SKJS.STResult<SKJS.TType> = () -> {
    !calls = calls + 1;
    SKJS.STOk()
  };
  _ = subst.memoizedSubtype(context, n, s, compute);
  _ = subst.memoizedSubtype(context, n, s, compute);
  SKTest.expectEq(1, calls);
}

@test
fun testSubtypeMemoInvalidatedByCandidateMutation(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  _ = subst.gen(SKJS.PosRange::none);
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testSubtypeMemoCannotPublishAfterMutationAndRestore(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  saved = subst.save();
  _ = subst.memoizedSubtype(context, n, s, () -> {
    _ = subst.gen(SKJS.PosRange::none);
    subst.restore(saved);
    SKJS.STOk()
  });
  SKTest.expectEq(saved.version, subst.version);
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testRestoredSubtypeMemoHasOldEpoch(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  saved = subst.save();
  _ = subst.gen(SKJS.PosRange::none);
  subst.restore(saved);
  // Restore carries the old data, not permission to use its old snapshot.
  SKTest.expectEq(false, subst.seenSub.isEmpty());
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testUninstrumentedTransitivePayloadChangeInvalidatesMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  outer = subst.gen(SKJS.PosRange::none);
  inner = subst.gen(SKJS.PosRange::none);
  n = observationNumber();
  s = observationString();
  subst.!values[outer.id] = SKJS.SVClosed(SKJS.TType::var(inner));
  subst.!values[inner.id] = SKJS.SVOpen(n);
  epoch = subst.semanticEpoch;
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  // Deliberately bypass supported mutation to exercise the payload guard.
  subst.!values[inner.id] = SKJS.SVOpen(s);
  SKTest.expectEq(epoch, subst.semanticEpoch);
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testFrozenQueryBypassesExistingSubtypeMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  subst.!freezeCandidates = true;
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testFrozenSuccessDoesNotCreateSubtypeMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  subst.!freezeCandidates = true;
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  subst.!freezeCandidates = false;
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testConditionalSubtypeSuccessCannotBecomeCompletedMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  conditional = context with {hasAssumptions => true};
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(conditional, n, s, () -> SKJS.STOk());
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testConditionalQueryDoesNotReadCompletedSubtypeMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  conditional = context with {hasAssumptions => true};
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  result = subst.memoizedSubtype(conditional, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testLexicalBindingChangeInvalidatesSubtypeMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  changed = context with {bindings => SortedMap[("T", n)]};
  result = subst.memoizedSubtype(changed, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testFailedSubtypeQueryIsNotCached(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  calls = 0;
  result = subst.memoizedSubtype(context, n, s, () -> {
    !calls = calls + 1;
    SKJS.STOk()
  });
  SKTest.expectEq(1, calls);
  SKTest.expectEq(true, result is SKJS.STOk _);
}

@test
fun testIntersectionMemoRecomputesAfterStateChange(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  first = subst.memoizedIntersection(context, n, s, () -> n);
  hit = subst.memoizedIntersection(context, n, s, () -> s);
  SKTest.expectEq(n, first);
  SKTest.expectEq(n, hit);
  _ = subst.gen(SKJS.PosRange::none);
  miss = subst.memoizedIntersection(context, n, s, () -> s);
  SKTest.expectEq(s, miss);
}

@test
fun testIntersectionDoesNotPublishAcrossMutation(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedIntersection(context, n, s, () -> {
    _ = subst.gen(SKJS.PosRange::none);
    n
  });
  value = subst.memoizedIntersection(context, n, s, () -> s);
  SKTest.expectEq(s, value);
}

@test
fun testReentrantIntersectionFromAnotherSnapshotDoesNotReplaceAnswer(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  value = subst.memoizedIntersection(context, n, s, () -> {
    _ = subst.gen(SKJS.PosRange::none);
    _ = subst.memoizedIntersection(context, n, s, () -> s);
    n
  });
  SKTest.expectEq(n, value);
}

@test
fun testIntersectionModesAreNotInterchangeable(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedIntersection(context, n, s, () -> n);
  expanded = context with {expandInter => true};
  value = subst.memoizedIntersection(expanded, n, s, () -> s);
  SKTest.expectEq(s, value);
  deferred = expanded with {inTypeDefValidation => true};
  value2 = subst.memoizedIntersection(deferred, n, s, () -> n);
  SKTest.expectEq(n, value2);
}

@test
fun testBareVariableIntersectionStillBypassesMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  tv = subst.gen(SKJS.PosRange::none);
  t = SKJS.TType::var(tv);
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedIntersection(context, t, n, () -> n);
  value = subst.memoizedIntersection(context, t, n, () -> s);
  SKTest.expectEq(s, value);
  SKTest.expectEq(true, subst.isUnbound(tv));
}

@test
fun testQueryMemoDoesNotEscapeClone(): void {
  subst = observationSubst();
  clone = subst.clone();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = clone.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testQueryMemoExceptionCannotPublishSuccess(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  caught = false;
  try {
    _ = subst.memoizedSubtype(context, n, s, () -> {
      throw ObservationTestFailure()
    })
  } catch {
  | ObservationTestFailure() -> !caught = true
  | exn -> throw exn
  };
  SKTest.expectEq(true, caught);
  result = subst.memoizedSubtype(context, n, s, () -> queryMemoFailure());
  SKTest.expectEq(true, result is SKJS.STError _);
}

@test
fun testProbeCannotUseCheckingPurposeMemo(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedSubtype(context, n, s, () -> SKJS.STOk());
  subst.withTypeArgumentProbe(probe -> {
    // The probe can inherit cache data, but not reuse a checking-mode entry.
    result = probe.memoizedSubtype(context, n, s, () -> queryMemoFailure());
    SKTest.expectEq(true, result is SKJS.STError _)
  });
}

@test
fun testFrozenIntersectionBypassesMemoWithoutReplacingIt(): void {
  subst = observationSubst();
  context = queryMemoContext();
  n = observationNumber();
  s = observationString();
  _ = subst.memoizedIntersection(context, n, s, () -> n);
  subst.!freezeCandidates = true;
  frozen = subst.memoizedIntersection(context, n, s, () -> s);
  SKTest.expectEq(s, frozen);
  subst.!freezeCandidates = false;
  thawed = subst.memoizedIntersection(context, n, s, () -> s);
  SKTest.expectEq(n, thawed);
}

@test
fun testObservationMemoHitRetainsItsOriginalReadDependency(): void {
  subst = observationSubst();
  context = queryMemoContext();
  tv = subst.gen(SKJS.PosRange::none);
  n = observationNumber();
  s = observationString();
  subst.!values[tv.id] = SKJS.SVOpen(n);
  result = subst.withCommittedTypeReads<Bool>(scratch -> {
    _ = scratch.memoizedSubtype(context, n, s, () -> {
      _ = scratch.peekRaw(tv);
      SKJS.STOk()
    });
    hit = scratch.memoizedSubtype(context, n, s, () -> queryMemoFailure());
    Some(hit is SKJS.STOk _)
  });
  SKTest.expectEq(true, result is SKJS.TRReady(true));
  SKTest.expectEq(true, subst.isClosed(tv));
  // A scratch memo is not copied into the live owner by commitment.
  SKTest.expectEq(true, subst.seenSub.isEmpty());
}

module end;
