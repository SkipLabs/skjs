module SKJSTests;

@test
fun testJSNumericStringValidIntegers(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("0"));
  SKTest.expectTrue(SKJS.isJSNumericString("1"));
  SKTest.expectTrue(SKJS.isJSNumericString("9"));
  SKTest.expectTrue(SKJS.isJSNumericString("42"));
  SKTest.expectTrue(SKJS.isJSNumericString("100"));
  SKTest.expectTrue(SKJS.isJSNumericString("999999"));
}

@test
fun testJSNumericStringValidNegativeIntegers(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("-1"));
  SKTest.expectTrue(SKJS.isJSNumericString("-42"));
  SKTest.expectTrue(SKJS.isJSNumericString("-999"));
}

@test
fun testJSNumericStringValidDecimals(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("1.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.1"));
  SKTest.expectTrue(SKJS.isJSNumericString("42.123"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.123456789"));
}

@test
fun testJSNumericStringValidNegativeDecimals(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("-0.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("-1.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("-42.7"));
}

@test
fun testJSNumericStringValidScientific(): void {
  // Large numbers: single-digit integer + e+N
  SKTest.expectTrue(SKJS.isJSNumericString("1e+21"));
  SKTest.expectTrue(SKJS.isJSNumericString("5e+100"));
  SKTest.expectTrue(SKJS.isJSNumericString("1e+308"));
  // 9e+308 overflows to Infinity: String(9e+308) is "Infinity", not "9e+308"
  SKTest.expectFalse(SKJS.isJSNumericString("9e+308"));
  // Small numbers: single-digit integer + e-N
  SKTest.expectTrue(SKJS.isJSNumericString("1e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("5e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("5e-324"));
  SKTest.expectTrue(SKJS.isJSNumericString("1e-323"));
  // 9e-324 rounds to the denormal 1e-323: String(9e-324) is "1e-323"
  SKTest.expectFalse(SKJS.isJSNumericString("9e-324"));
  // With decimal in significand
  SKTest.expectTrue(SKJS.isJSNumericString("1.5e+22"));
  SKTest.expectTrue(SKJS.isJSNumericString("3.14e-8"));
  // Negative scientific
  SKTest.expectTrue(SKJS.isJSNumericString("-1e+21"));
  SKTest.expectTrue(SKJS.isJSNumericString("-5e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("-1.5e+22"));
}

@test
fun testJSNumericStringRejectsEmpty(): void {
  SKTest.expectFalse(SKJS.isJSNumericString(""));
}

@test
fun testJSNumericStringRejectsNegativeZero(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("-0"));
}

@test
fun testJSNumericStringRejectsLeadingZeros(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("01"));
  SKTest.expectFalse(SKJS.isJSNumericString("007"));
  SKTest.expectFalse(SKJS.isJSNumericString("00"));
}

@test
fun testJSNumericStringRejectsTrailingDecimalZeros(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("1.0"));
  SKTest.expectFalse(SKJS.isJSNumericString("1.50"));
  SKTest.expectFalse(SKJS.isJSNumericString("0.10"));
  SKTest.expectFalse(SKJS.isJSNumericString("42.00"));
}

@test
fun testJSNumericStringRejectsMalformedDecimals(): void {
  SKTest.expectFalse(SKJS.isJSNumericString(".5"));
  SKTest.expectFalse(SKJS.isJSNumericString("1."));
  SKTest.expectFalse(SKJS.isJSNumericString("."));
  SKTest.expectFalse(SKJS.isJSNumericString("-.5"));
}

@test
fun testJSNumericStringRejectsNonCanonicalScientific(): void {
  // Missing sign on exponent
  SKTest.expectFalse(SKJS.isJSNumericString("1e3"));
  // Zero exponent (not canonical)
  SKTest.expectFalse(SKJS.isJSNumericString("1e+0"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e-0"));
  // Leading zero in exponent
  SKTest.expectFalse(SKJS.isJSNumericString("1e+01"));
  // Multi-digit integer with exponent (not canonical)
  SKTest.expectFalse(SKJS.isJSNumericString("42e+5"));
  SKTest.expectFalse(SKJS.isJSNumericString("10e+1"));
  // Zero with exponent
  SKTest.expectFalse(SKJS.isJSNumericString("0e+1"));
  // Trailing zero in significand decimal
  SKTest.expectFalse(SKJS.isJSNumericString("1.50e+21"));
}

@test
fun testJSNumericStringRejectsSpecialValues(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("NaN"));
  SKTest.expectFalse(SKJS.isJSNumericString("Infinity"));
  SKTest.expectFalse(SKJS.isJSNumericString("-Infinity"));
}

@test
fun testJSNumericStringRejectsNonNumeric(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("foo"));
  SKTest.expectFalse(SKJS.isJSNumericString("abc"));
  SKTest.expectFalse(SKJS.isJSNumericString(" 1"));
  SKTest.expectFalse(SKJS.isJSNumericString("1 "));
  SKTest.expectFalse(SKJS.isJSNumericString("1x"));
  SKTest.expectFalse(SKJS.isJSNumericString("-"));
  SKTest.expectFalse(SKJS.isJSNumericString("+1"));
}

// isJSNumberKeyName = isJSNumericString plus the non-finite names a number key
// can produce (String(Infinity) === "Infinity", etc.).
@test
fun testJSNumberKeyNameAcceptsNonFinite(): void {
  SKTest.expectTrue(SKJS.isJSNumberKeyName("Infinity"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("-Infinity"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("NaN"));
}

@test
fun testJSNumberKeyNameAcceptsFiniteNumericStrings(): void {
  SKTest.expectTrue(SKJS.isJSNumberKeyName("0"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("-42"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("1.5"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("1e+21"));
}

@test
fun testJSNumberKeyNameRejectsNonNumeric(): void {
  SKTest.expectFalse(SKJS.isJSNumberKeyName("abc"));
  SKTest.expectFalse(SKJS.isJSNumberKeyName("Infinity ")); // not canonical
  SKTest.expectFalse(SKJS.isJSNumberKeyName("infinity")); // wrong case
  SKTest.expectFalse(SKJS.isJSNumberKeyName("-0")); // String(-0) === "0"
  SKTest.expectFalse(SKJS.isJSNumberKeyName("01"));
}

// --- normalizeJSNumber tests ---

@test
fun testNormalizeAlreadyCanonical(): void {
  // Already canonical values pass through unchanged
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("1"));
  SKTest.expectEq("42", SKJS.normalizeJSNumber("42"));
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1000"));
  SKTest.expectEq("1.5", SKJS.normalizeJSNumber("1.5"));
  SKTest.expectEq("0.1", SKJS.normalizeJSNumber("0.1"));
  SKTest.expectEq("-1", SKJS.normalizeJSNumber("-1"));
  SKTest.expectEq("-0.5", SKJS.normalizeJSNumber("-0.5"));
}

@test
fun testNormalizeUnderscores(): void {
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1_000"));
  SKTest.expectEq("1000000", SKJS.normalizeJSNumber("1_000_000"));
  SKTest.expectEq("100", SKJS.normalizeJSNumber("1_0_0"));
}

@test
fun testNormalizeHex(): void {
  SKTest.expectEq("16", SKJS.normalizeJSNumber("0x10"));
  SKTest.expectEq("255", SKJS.normalizeJSNumber("0xFF"));
  SKTest.expectEq("255", SKJS.normalizeJSNumber("0XFF"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0x0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("0x1"));
  SKTest.expectEq("10", SKJS.normalizeJSNumber("0xA"));
  SKTest.expectEq("256", SKJS.normalizeJSNumber("0x100"));
}

@test
fun testNormalizeBinary(): void {
  SKTest.expectEq("2", SKJS.normalizeJSNumber("0b10"));
  SKTest.expectEq("5", SKJS.normalizeJSNumber("0b101"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0b0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("0b1"));
  SKTest.expectEq("255", SKJS.normalizeJSNumber("0b11111111"));
  SKTest.expectEq("7", SKJS.normalizeJSNumber("0B111"));
}

@test
fun testNormalizeOctal(): void {
  SKTest.expectEq("15", SKJS.normalizeJSNumber("0o17"));
  SKTest.expectEq("8", SKJS.normalizeJSNumber("0o10"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0o0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("0o1"));
  SKTest.expectEq("511", SKJS.normalizeJSNumber("0o777"));
  SKTest.expectEq("7", SKJS.normalizeJSNumber("0O7"));
}

@test
fun testNormalizeTrailingDecimalZeros(): void {
  SKTest.expectEq("1", SKJS.normalizeJSNumber("1.0"));
  SKTest.expectEq("1.5", SKJS.normalizeJSNumber("1.50"));
  SKTest.expectEq("42", SKJS.normalizeJSNumber("42.00"));
  SKTest.expectEq("0.1", SKJS.normalizeJSNumber("0.10"));
  SKTest.expectEq("100", SKJS.normalizeJSNumber("100.0"));
}

@test
fun testNormalizeScientific(): void {
  // Scientific to plain integer
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1e3"));
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1E3"));
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1e+3"));
  SKTest.expectEq("500", SKJS.normalizeJSNumber("5e2"));
  SKTest.expectEq("15000", SKJS.normalizeJSNumber("1.5e4"));
  // Scientific to plain decimal
  SKTest.expectEq("0.001", SKJS.normalizeJSNumber("1e-3"));
  SKTest.expectEq("0.015", SKJS.normalizeJSNumber("1.5e-2"));
  SKTest.expectEq("0.000001", SKJS.normalizeJSNumber("1e-6"));
}

@test
fun testNormalizeScientificToScientific(): void {
  // Large exponents stay scientific (n > 21)
  SKTest.expectEq("1e+21", SKJS.normalizeJSNumber("1e21"));
  SKTest.expectEq("1e+21", SKJS.normalizeJSNumber("1e+21"));
  SKTest.expectEq("1.5e+22", SKJS.normalizeJSNumber("1.5e22"));
  SKTest.expectEq("1.5e+22", SKJS.normalizeJSNumber("1.5e+22"));
  // Small exponents stay scientific (n <= -6)
  SKTest.expectEq("1e-7", SKJS.normalizeJSNumber("1e-7"));
  SKTest.expectEq("1.5e-8", SKJS.normalizeJSNumber("1.5e-8"));
}

@test
fun testNormalizeNegative(): void {
  SKTest.expectEq("-1", SKJS.normalizeJSNumber("-1.0"));
  SKTest.expectEq("-1000", SKJS.normalizeJSNumber("-1e3"));
  SKTest.expectEq("-16", SKJS.normalizeJSNumber("-0x10"));
  SKTest.expectEq("-2", SKJS.normalizeJSNumber("-0b10"));
  SKTest.expectEq("-15", SKJS.normalizeJSNumber("-0o17"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0.0"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0x0"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0o0"));
}

@test
fun testNormalizeResultIsCanonical(): void {
  // Every normalized result should pass isJSNumericString
  inputs = Array[
    "0",
    "1",
    "42",
    "1_000",
    "0x10",
    "0xFF",
    "0b10",
    "0o17",
    "1.0",
    "1.50",
    "1e3",
    "1e+3",
    "1e-3",
    "1e21",
    "1e-7",
    "1.5e4",
    "1.5e22",
    "-1",
    "-1.0",
    "-0x10",
    "-0b10",
    "-0o17",
  ];
  for (input in inputs) {
    result = SKJS.normalizeJSNumber(input);
    SKTest.expectTrue(SKJS.isJSNumericString(result));
  };
}

// --- normalizeJSBigInt tests ------------------------------------------------

@test
fun testNormalizeJSBigInt(): void {
  SKTest.expectEq("0n", SKJS.normalizeJSBigInt("0n"));
  SKTest.expectEq("1000n", SKJS.normalizeJSBigInt("1_000n"));
  SKTest.expectEq("16n", SKJS.normalizeJSBigInt("0x10n"));
  SKTest.expectEq("7n", SKJS.normalizeJSBigInt("0b111n"));
  SKTest.expectEq("15n", SKJS.normalizeJSBigInt("0o17n"));
  SKTest.expectEq("0n", SKJS.normalizeJSBigInt("0x0n"));
  // Bigints are arbitrary precision: radix conversion is exact beyond 2^64.
  SKTest.expectEq(
    "18446744073709551615n",
    SKJS.normalizeJSBigInt("0xFFFFFFFFFFFFFFFFn"),
  );
  SKTest.expectEq(
    "340282366920938463463374607431768211455n",
    SKJS.normalizeJSBigInt("0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFn"),
  );
  // 64 hex digits (2^256 - 1): exact far beyond any Int, via skbigint.
  SKTest.expectEq(
    "115792089237316195423570985008687907853269984665640564039457584007913129639935n",
    SKJS.normalizeJSBigInt(
      "0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFn",
    ),
  );
  // 65 binary digits with separators (2^65 - 1).
  SKTest.expectEq(
    "36893488147419103231n",
    SKJS.normalizeJSBigInt(
      "0b11111111111111111111111111111111111111111111111111111111111111111n",
    ),
  );
  // Separators inside a radix literal are stripped before conversion.
  SKTest.expectEq("4n", SKJS.normalizeJSBigInt("0b1_0_0n"));
  SKTest.expectEq("255n", SKJS.normalizeJSBigInt("0xF_Fn"));
}

// --- jsNumberLiteralDouble / isExactJSNumberName tests ---------------------

// jsNumberLiteralDouble is total: invalid radix digits parse to None rather
// than throwing, so arbitrary property-name strings are safe to probe.
@test
fun testJSNumberLiteralDoubleRejectsInvalidRadixDigits(): void {
  SKTest.expectEq(None(), SKJS.jsNumberLiteralDouble("0x1p3"));
  SKTest.expectEq(None(), SKJS.jsNumberLiteralDouble("0b12"));
  SKTest.expectEq(None(), SKJS.jsNumberLiteralDouble("0o8"));
  SKTest.expectEq(Some(0.0), SKJS.jsNumberLiteralDouble("0x0"));
  SKTest.expectEq(Some(16.0), SKJS.jsNumberLiteralDouble("0x10"));
  SKTest.expectEq(Some(-2.0), SKJS.jsNumberLiteralDouble("-0b10"));
  SKTest.expectEq(Some(Float::inf), SKJS.jsNumberLiteralDouble("Infinity"));
  SKTest.expectEq(Some(-Float::inf), SKJS.jsNumberLiteralDouble("-Infinity"));
  // Radix names beyond 2^53 convert exactly to decimal via skbigint, then
  // parse to the correctly-rounded double: 0x10000000000000000 is 2^64.
  SKTest.expectEq(
    Some(18446744073709551616.0),
    SKJS.jsNumberLiteralDouble("0x10000000000000000"),
  );
  // 2^53 + 1 rounds to 2^53.
  SKTest.expectEq(
    Some(9007199254740992.0),
    SKJS.jsNumberLiteralDouble("0x20000000000001"),
  );
}

// An exact name is one that parses and prints back to itself; this is the
// String() form of its double ("NaN" is never exact, "Infinity" is).
@test
fun testExactJSNumberName(): void {
  SKTest.expectTrue(SKJS.isExactJSNumberName("0"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("-1.5"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("1e+21"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("1e+308"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("9e+308"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("9007199254740992"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("Infinity"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("-Infinity"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("NaN"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("9007199254740993"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("1e+309"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("0x10"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("-0"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("0x1p3"));
}

// --- negateJSNumberLiteral tests ------------------------------------------

@test
fun testNegateJSNumberLiteral(): void {
  SKTest.expectEq("-5", SKJS.negateJSNumberLiteral("5"));
  SKTest.expectEq("-1.5", SKJS.negateJSNumberLiteral("1.5"));
  SKTest.expectEq("5", SKJS.negateJSNumberLiteral("-5"));
  SKTest.expectEq("0", SKJS.negateJSNumberLiteral("0"));
  SKTest.expectEq("0n", SKJS.negateJSNumberLiteral("0n"));
  SKTest.expectEq("-16n", SKJS.negateJSNumberLiteral("16n"));
}

// --- Pinned known gaps --------------------------------------------------

// Shapes that are valid numbers but not canonical String(Number(x)) output:
// String(1e3) is "1000", 22-digit integers print as scientific, and
// String(1e-7) is "1e-7". The ECMA-262 magnitude bounds (n > 21 / n <= -6)
// pick the form.
@test
fun testJSNumericStringRejectsOutOfBoundsForms(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("1e+3"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e+20"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e-6"));
  SKTest.expectFalse(SKJS.isJSNumericString("10000000000000000000000"));
  SKTest.expectFalse(SKJS.isJSNumericString("0.0000001"));
  // Boundary cases on the canonical side
  SKTest.expectTrue(SKJS.isJSNumericString("1e+21"));
  SKTest.expectTrue(SKJS.isJSNumericString("1e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.000001"));
  SKTest.expectTrue(SKJS.isJSNumericString("100000000000000000000"));
  SKTest.expectTrue(SKJS.isJSNumericString("1e+308"));
  // An exponent that overflows to Infinity is not a finite canonical form
  // (tsc's numeric-name test, (+s).toString() === s, rejects it too)
  SKTest.expectFalse(SKJS.isJSNumericString("9e+308"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e+309"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e18446744073709551619"));
  // Radix spellings with invalid digits are rejected without throwing
  SKTest.expectFalse(SKJS.isJSNumericString("0x1p3"));
  SKTest.expectFalse(SKJS.isJSNumericString("0b12"));
}

// Literals beyond double precision normalize to the ECMAScript String() form
// of the double they denote (issue #781): tsc keys number literal types by
// their double, so two spellings of one double are one literal type. The
// digits come from Float.toString's shortest round-trip form, and a value
// that overflows is named "Infinity".
@test
fun testNormalizeCanonicalizesBeyondPrecision(): void {
  SKTest.expectEq(
    "18446744073709552000",
    SKJS.normalizeJSNumber("0xFFFFFFFFFFFFFFFF"),
  );
  SKTest.expectEq(
    "9223372036854776000",
    SKJS.normalizeJSNumber("0x8000000000000000"),
  );
  SKTest.expectEq(
    "9007199254740992",
    SKJS.normalizeJSNumber("9007199254740993"),
  );
  SKTest.expectEq(
    "9007199254740992",
    SKJS.normalizeJSNumber("0x20000000000001"),
  );
  SKTest.expectEq(
    "123456789012345680000",
    SKJS.normalizeJSNumber("123456789012345678901"),
  );
  SKTest.expectEq(
    "0.30000000000000004",
    SKJS.normalizeJSNumber("0.300000000000000044"),
  );
  SKTest.expectEq(
    "1.2345678901234568e-7",
    SKJS.normalizeJSNumber("0.0000001234567890123456789"),
  );
  SKTest.expectEq("1e+21", SKJS.normalizeJSNumber("999999999999999999999"));
  SKTest.expectEq("5e-324", SKJS.normalizeJSNumber("4.9406564584124654e-324"));
  SKTest.expectEq(
    "1.7976931348623157e+308",
    SKJS.normalizeJSNumber("1.7976931348623158e308"),
  );
  // Underflow is the double +0, and the sign of a negative zero drops.
  SKTest.expectEq("0", SKJS.normalizeJSNumber("1e-400"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-1e-400"));
  // Overflow is the double Infinity, named as String() prints it; the sign
  // is kept.
  SKTest.expectEq("Infinity", SKJS.normalizeJSNumber("1e309"));
  SKTest.expectEq("-Infinity", SKJS.normalizeJSNumber("-1e309"));
  SKTest.expectEq("Infinity", SKJS.normalizeJSNumber("1.7976931348623159e308"));
  // An exponent too large for an Int still parses to a double:
  // Infinity here, as tsc names it.
  SKTest.expectEq("Infinity", SKJS.normalizeJSNumber("1e18446744073709551619"));
  // 2^53 itself is exactly representable and normalizes as before.
  SKTest.expectEq(
    "9007199254740992",
    SKJS.normalizeJSNumber("0x20000000000000"),
  );
}

// Spellings the runtime float parser does not take as they are: a leading
// `.`, and zero padding past its input-length limit, which is dropped
// before parsing. A spelling still too long after that keeps its form.
@test
fun testNormalizeParserEdgeSpellings(): void {
  SKTest.expectEq("0.5", SKJS.normalizeJSNumber(".5"));
  SKTest.expectEq("500", SKJS.normalizeJSNumber(".5e3"));
  SKTest.expectEq("5", SKJS.normalizeJSNumber("5."));
  SKTest.expectEq("1.5", SKJS.normalizeJSNumber("1.5" + "0".repeat(300)));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0." + "0".repeat(300)));
  SKTest.expectEq(
    "1.23e-301",
    SKJS.normalizeJSNumber("0." + "0".repeat(300) + "123"),
  );
  SKTest.expectEq("1.2e+261", SKJS.normalizeJSNumber("12" + "0".repeat(260)));
  SKTest.expectEq(
    "0.07",
    SKJS.normalizeJSNumber("7" + "0".repeat(260) + "e-262"),
  );
  long = "1." + "0".repeat(260) + "1";
  SKTest.expectEq(long, SKJS.normalizeJSNumber(long));
}

// Number names are compared by name, except a spelling the normalizer kept
// (too long to parse), which may denote any double.
@test
fun testNumberNamesCompareByName(): void {
  SKTest.expectFalse(
    SKJS.jsNumberLiteralsMayCollide("9007199254740992", "9007199254740994"),
  );
  SKTest.expectFalse(SKJS.jsNumberLiteralsMayCollide("1e+308", "Infinity"));
  SKTest.expectTrue(SKJS.jsNumberLiteralsMayCollide("1e+308", "1e+308"));
  long = "1." + "0".repeat(260) + "1";
  SKTest.expectTrue(SKJS.jsNumberLiteralsMayCollide(long, "1"));
  SKTest.expectTrue(SKJS.jsNumberLiteralMayBeFalsy(long));
  SKTest.expectTrue(SKJS.jsNumberLiteralMayBeTruthy(long));
  SKTest.expectFalse(SKJS.jsNumberLiteralMayBeFalsy("5e-324"));
  SKTest.expectTrue(SKJS.jsNumberLiteralMayBeFalsy("0"));
  SKTest.expectFalse(SKJS.jsNumberLiteralMayBeTruthy("0"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("-Infinity"));
  SKTest.expectTrue(SKJS.isExactJSNumberName("1.7976931348623157e+308"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("NaN"));
  SKTest.expectFalse(SKJS.isExactJSNumberName("1e308"));
  SKTest.expectFalse(SKJS.isExactJSNumberName(long));
}

// jsNumberToString is the ECMAScript String() form of a double: the digits
// come from Float.toString, Ryu's shortest round-trip form since std 0.5.0
// (SkipLabs/skip#1288), so the result always parses back to the same double.
@test
fun testJSNumberToString(): void {
  SKTest.expectEq("NaN", SKJS.jsNumberToString(Float::nan));
  SKTest.expectEq("Infinity", SKJS.jsNumberToString(Float::inf));
  SKTest.expectEq("-Infinity", SKJS.jsNumberToString(-Float::inf));
  SKTest.expectEq("0", SKJS.jsNumberToString(0.0));
  SKTest.expectEq("0", SKJS.jsNumberToString(-0.0));
  SKTest.expectEq("1", SKJS.jsNumberToString(1.0));
  SKTest.expectEq("-1.5", SKJS.jsNumberToString(-1.5));
  SKTest.expectEq("0.1", SKJS.jsNumberToString(0.1));
  SKTest.expectEq(
    "0.30000000000000004",
    SKJS.jsNumberToString(0.30000000000000004),
  );
  SKTest.expectEq(
    "9007199254740992",
    SKJS.jsNumberToString(9007199254740993.0),
  );
  SKTest.expectEq("1e+21", SKJS.jsNumberToString(1.0e21));
  SKTest.expectEq("1e-7", SKJS.jsNumberToString(1.0e-7));
  SKTest.expectEq("5e-324", SKJS.jsNumberToString(5.0e-324));
  SKTest.expectEq(
    "1.7976931348623157e+308",
    SKJS.jsNumberToString(1.7976931348623157e308),
  );
}

// --- jsNumberLiteralSurprise tests -----------------------------------------

fun surpriseMsg(raw: String): ?String {
  SKJS.jsNumberLiteralSurprise(raw).map(p -> p.i0)
}

// A literal is surprising when JS reads it as a different value than the
// exact decimal written: overflow to ±Infinity, underflow to 0, or rounding
// (precision loss, including denormal rounding). Cosmetic respellings of the
// same value and exactly representable values stay silent.
@test
fun testNumberLiteralSurprise(): void {
  SKTest.expectEq(
    Some("Number literal '1e309' overflows to Infinity"),
    surpriseMsg("1e309"),
  );
  SKTest.expectEq(
    Some("Number literal '-2e309' overflows to -Infinity"),
    surpriseMsg("-2e309"),
  );
  SKTest.expectEq(
    Some("Number literal '1e-400' underflows to 0"),
    surpriseMsg("1e-400"),
  );
  SKTest.expectEq(
    Some("Number literal '2e-324' underflows to 0"),
    surpriseMsg("2e-324"),
  );
  SKTest.expectEq(
    Some(
      "Number literal '9007199254740993' is rounded to 9007199254740992 by IEEE-754 double precision",
    ),
    surpriseMsg("9007199254740993"),
  );
  SKTest.expectEq(
    Some(
      "Number literal '9e-324' is rounded to 1e-323 by IEEE-754 double precision",
    ),
    surpriseMsg("9e-324"),
  );
  SKTest.expectEq(
    Some(
      "Number literal '0x20000000000001' is rounded to 9007199254740992 by IEEE-754 double precision",
    ),
    surpriseMsg("0x20000000000001"),
  );
  SKTest.expectEq(
    Some(
      "Number literal '0.300000000000000044' is rounded to 0.30000000000000004 by IEEE-754 double precision",
    ),
    surpriseMsg("0.300000000000000044"),
  );
  // Controls: same value respelled, or exactly representable — silent.
  SKTest.expectEq(None(), surpriseMsg("1e3"));
  SKTest.expectEq(None(), surpriseMsg("0x10"));
  SKTest.expectEq(None(), surpriseMsg("1.0"));
  SKTest.expectEq(None(), surpriseMsg("1_000"));
  SKTest.expectEq(None(), surpriseMsg(".5"));
  SKTest.expectEq(None(), surpriseMsg("0.1"));
  SKTest.expectEq(None(), surpriseMsg("1e21"));
  SKTest.expectEq(None(), surpriseMsg("5e-324"));
  SKTest.expectEq(None(), surpriseMsg("-0"));
  SKTest.expectEq(None(), surpriseMsg("9007199254740992"));
  SKTest.expectEq(None(), surpriseMsg("0.30000000000000004"));
  SKTest.expectEq(None(), surpriseMsg("0"));
  SKTest.expectEq(None(), surpriseMsg("0e999999"));
}

module end;
