module SKJSTests;

@test
fun testJSNumericStringValidIntegers(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("0"));
  SKTest.expectTrue(SKJS.isJSNumericString("1"));
  SKTest.expectTrue(SKJS.isJSNumericString("9"));
  SKTest.expectTrue(SKJS.isJSNumericString("42"));
  SKTest.expectTrue(SKJS.isJSNumericString("100"));
  SKTest.expectTrue(SKJS.isJSNumericString("999999"));
}

@test
fun testJSNumericStringValidNegativeIntegers(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("-1"));
  SKTest.expectTrue(SKJS.isJSNumericString("-42"));
  SKTest.expectTrue(SKJS.isJSNumericString("-999"));
}

@test
fun testJSNumericStringValidDecimals(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("1.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.1"));
  SKTest.expectTrue(SKJS.isJSNumericString("42.123"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.123456789"));
}

@test
fun testJSNumericStringValidNegativeDecimals(): void {
  SKTest.expectTrue(SKJS.isJSNumericString("-0.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("-1.5"));
  SKTest.expectTrue(SKJS.isJSNumericString("-42.7"));
}

@test
fun testJSNumericStringValidScientific(): void {
  // Large numbers: single-digit integer + e+N
  SKTest.expectTrue(SKJS.isJSNumericString("1e+21"));
  SKTest.expectTrue(SKJS.isJSNumericString("5e+100"));
  SKTest.expectTrue(SKJS.isJSNumericString("9e+308"));
  // Small numbers: single-digit integer + e-N
  SKTest.expectTrue(SKJS.isJSNumericString("1e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("5e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("9e-324"));
  // With decimal in significand
  SKTest.expectTrue(SKJS.isJSNumericString("1.5e+22"));
  SKTest.expectTrue(SKJS.isJSNumericString("3.14e-8"));
  // Negative scientific
  SKTest.expectTrue(SKJS.isJSNumericString("-1e+21"));
  SKTest.expectTrue(SKJS.isJSNumericString("-5e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("-1.5e+22"));
}

@test
fun testJSNumericStringRejectsEmpty(): void {
  SKTest.expectFalse(SKJS.isJSNumericString(""));
}

@test
fun testJSNumericStringRejectsNegativeZero(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("-0"));
}

@test
fun testJSNumericStringRejectsLeadingZeros(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("01"));
  SKTest.expectFalse(SKJS.isJSNumericString("007"));
  SKTest.expectFalse(SKJS.isJSNumericString("00"));
}

@test
fun testJSNumericStringRejectsTrailingDecimalZeros(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("1.0"));
  SKTest.expectFalse(SKJS.isJSNumericString("1.50"));
  SKTest.expectFalse(SKJS.isJSNumericString("0.10"));
  SKTest.expectFalse(SKJS.isJSNumericString("42.00"));
}

@test
fun testJSNumericStringRejectsMalformedDecimals(): void {
  SKTest.expectFalse(SKJS.isJSNumericString(".5"));
  SKTest.expectFalse(SKJS.isJSNumericString("1."));
  SKTest.expectFalse(SKJS.isJSNumericString("."));
  SKTest.expectFalse(SKJS.isJSNumericString("-.5"));
}

@test
fun testJSNumericStringRejectsNonCanonicalScientific(): void {
  // Missing sign on exponent
  SKTest.expectFalse(SKJS.isJSNumericString("1e3"));
  // Zero exponent (not canonical)
  SKTest.expectFalse(SKJS.isJSNumericString("1e+0"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e-0"));
  // Leading zero in exponent
  SKTest.expectFalse(SKJS.isJSNumericString("1e+01"));
  // Multi-digit integer with exponent (not canonical)
  SKTest.expectFalse(SKJS.isJSNumericString("42e+5"));
  SKTest.expectFalse(SKJS.isJSNumericString("10e+1"));
  // Zero with exponent
  SKTest.expectFalse(SKJS.isJSNumericString("0e+1"));
  // Trailing zero in significand decimal
  SKTest.expectFalse(SKJS.isJSNumericString("1.50e+21"));
}

@test
fun testJSNumericStringRejectsSpecialValues(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("NaN"));
  SKTest.expectFalse(SKJS.isJSNumericString("Infinity"));
  SKTest.expectFalse(SKJS.isJSNumericString("-Infinity"));
}

@test
fun testJSNumericStringRejectsNonNumeric(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("foo"));
  SKTest.expectFalse(SKJS.isJSNumericString("abc"));
  SKTest.expectFalse(SKJS.isJSNumericString(" 1"));
  SKTest.expectFalse(SKJS.isJSNumericString("1 "));
  SKTest.expectFalse(SKJS.isJSNumericString("1x"));
  SKTest.expectFalse(SKJS.isJSNumericString("-"));
  SKTest.expectFalse(SKJS.isJSNumericString("+1"));
}

// isJSNumberKeyName = isJSNumericString plus the non-finite names a number key
// can produce (String(Infinity) === "Infinity", etc.).
@test
fun testJSNumberKeyNameAcceptsNonFinite(): void {
  SKTest.expectTrue(SKJS.isJSNumberKeyName("Infinity"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("-Infinity"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("NaN"));
}

@test
fun testJSNumberKeyNameAcceptsFiniteNumericStrings(): void {
  SKTest.expectTrue(SKJS.isJSNumberKeyName("0"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("-42"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("1.5"));
  SKTest.expectTrue(SKJS.isJSNumberKeyName("1e+21"));
}

@test
fun testJSNumberKeyNameRejectsNonNumeric(): void {
  SKTest.expectFalse(SKJS.isJSNumberKeyName("abc"));
  SKTest.expectFalse(SKJS.isJSNumberKeyName("Infinity ")); // not canonical
  SKTest.expectFalse(SKJS.isJSNumberKeyName("infinity")); // wrong case
  SKTest.expectFalse(SKJS.isJSNumberKeyName("-0")); // String(-0) === "0"
  SKTest.expectFalse(SKJS.isJSNumberKeyName("01"));
}

// --- normalizeJSNumber tests ---

@test
fun testNormalizeAlreadyCanonical(): void {
  // Already canonical values pass through unchanged
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("1"));
  SKTest.expectEq("42", SKJS.normalizeJSNumber("42"));
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1000"));
  SKTest.expectEq("1.5", SKJS.normalizeJSNumber("1.5"));
  SKTest.expectEq("0.1", SKJS.normalizeJSNumber("0.1"));
  SKTest.expectEq("-1", SKJS.normalizeJSNumber("-1"));
  SKTest.expectEq("-0.5", SKJS.normalizeJSNumber("-0.5"));
}

@test
fun testNormalizeUnderscores(): void {
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1_000"));
  SKTest.expectEq("1000000", SKJS.normalizeJSNumber("1_000_000"));
  SKTest.expectEq("100", SKJS.normalizeJSNumber("1_0_0"));
}

@test
fun testNormalizeHex(): void {
  SKTest.expectEq("16", SKJS.normalizeJSNumber("0x10"));
  SKTest.expectEq("255", SKJS.normalizeJSNumber("0xFF"));
  SKTest.expectEq("255", SKJS.normalizeJSNumber("0XFF"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0x0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("0x1"));
  SKTest.expectEq("10", SKJS.normalizeJSNumber("0xA"));
  SKTest.expectEq("256", SKJS.normalizeJSNumber("0x100"));
}

@test
fun testNormalizeBinary(): void {
  SKTest.expectEq("2", SKJS.normalizeJSNumber("0b10"));
  SKTest.expectEq("5", SKJS.normalizeJSNumber("0b101"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0b0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("0b1"));
  SKTest.expectEq("255", SKJS.normalizeJSNumber("0b11111111"));
  SKTest.expectEq("7", SKJS.normalizeJSNumber("0B111"));
}

@test
fun testNormalizeOctal(): void {
  SKTest.expectEq("15", SKJS.normalizeJSNumber("0o17"));
  SKTest.expectEq("8", SKJS.normalizeJSNumber("0o10"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("0o0"));
  SKTest.expectEq("1", SKJS.normalizeJSNumber("0o1"));
  SKTest.expectEq("511", SKJS.normalizeJSNumber("0o777"));
  SKTest.expectEq("7", SKJS.normalizeJSNumber("0O7"));
}

@test
fun testNormalizeTrailingDecimalZeros(): void {
  SKTest.expectEq("1", SKJS.normalizeJSNumber("1.0"));
  SKTest.expectEq("1.5", SKJS.normalizeJSNumber("1.50"));
  SKTest.expectEq("42", SKJS.normalizeJSNumber("42.00"));
  SKTest.expectEq("0.1", SKJS.normalizeJSNumber("0.10"));
  SKTest.expectEq("100", SKJS.normalizeJSNumber("100.0"));
}

@test
fun testNormalizeScientific(): void {
  // Scientific to plain integer
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1e3"));
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1E3"));
  SKTest.expectEq("1000", SKJS.normalizeJSNumber("1e+3"));
  SKTest.expectEq("500", SKJS.normalizeJSNumber("5e2"));
  SKTest.expectEq("15000", SKJS.normalizeJSNumber("1.5e4"));
  // Scientific to plain decimal
  SKTest.expectEq("0.001", SKJS.normalizeJSNumber("1e-3"));
  SKTest.expectEq("0.015", SKJS.normalizeJSNumber("1.5e-2"));
  SKTest.expectEq("0.000001", SKJS.normalizeJSNumber("1e-6"));
}

@test
fun testNormalizeScientificToScientific(): void {
  // Large exponents stay scientific (n > 21)
  SKTest.expectEq("1e+21", SKJS.normalizeJSNumber("1e21"));
  SKTest.expectEq("1e+21", SKJS.normalizeJSNumber("1e+21"));
  SKTest.expectEq("1.5e+22", SKJS.normalizeJSNumber("1.5e22"));
  SKTest.expectEq("1.5e+22", SKJS.normalizeJSNumber("1.5e+22"));
  // Small exponents stay scientific (n <= -6)
  SKTest.expectEq("1e-7", SKJS.normalizeJSNumber("1e-7"));
  SKTest.expectEq("1.5e-8", SKJS.normalizeJSNumber("1.5e-8"));
}

@test
fun testNormalizeNegative(): void {
  SKTest.expectEq("-1", SKJS.normalizeJSNumber("-1.0"));
  SKTest.expectEq("-1000", SKJS.normalizeJSNumber("-1e3"));
  SKTest.expectEq("-16", SKJS.normalizeJSNumber("-0x10"));
  SKTest.expectEq("-2", SKJS.normalizeJSNumber("-0b10"));
  SKTest.expectEq("-15", SKJS.normalizeJSNumber("-0o17"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0.0"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0x0"));
  SKTest.expectEq("0", SKJS.normalizeJSNumber("-0o0"));
}

@test
fun testNormalizeResultIsCanonical(): void {
  // Every normalized result should pass isJSNumericString
  inputs = Array[
    "0",
    "1",
    "42",
    "1_000",
    "0x10",
    "0xFF",
    "0b10",
    "0o17",
    "1.0",
    "1.50",
    "1e3",
    "1e+3",
    "1e-3",
    "1e21",
    "1e-7",
    "1.5e4",
    "1.5e22",
    "-1",
    "-1.0",
    "-0x10",
    "-0b10",
    "-0o17",
  ];
  for (input in inputs) {
    result = SKJS.normalizeJSNumber(input);
    SKTest.expectTrue(SKJS.isJSNumericString(result));
  };
}

// --- negateJSNumberLiteral tests ------------------------------------------

@test
fun testNegateJSNumberLiteral(): void {
  SKTest.expectEq("-5", SKJS.negateJSNumberLiteral("5"));
  SKTest.expectEq("-1.5", SKJS.negateJSNumberLiteral("1.5"));
  SKTest.expectEq("5", SKJS.negateJSNumberLiteral("-5"));
  SKTest.expectEq("0", SKJS.negateJSNumberLiteral("0"));
  SKTest.expectEq("0n", SKJS.negateJSNumberLiteral("0n"));
  SKTest.expectEq("-16n", SKJS.negateJSNumberLiteral("16n"));
}

// --- Pinned known gaps --------------------------------------------------

// Shapes that are valid numbers but not canonical String(Number(x)) output:
// String(1e3) is "1000", 22-digit integers print as scientific, and
// String(1e-7) is "1e-7". The ECMA-262 magnitude bounds (n > 21 / n <= -6)
// pick the form.
@test
fun testJSNumericStringRejectsOutOfBoundsForms(): void {
  SKTest.expectFalse(SKJS.isJSNumericString("1e+3"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e+20"));
  SKTest.expectFalse(SKJS.isJSNumericString("1e-6"));
  SKTest.expectFalse(SKJS.isJSNumericString("10000000000000000000000"));
  SKTest.expectFalse(SKJS.isJSNumericString("0.0000001"));
  // Boundary cases on the canonical side
  SKTest.expectTrue(SKJS.isJSNumericString("1e+21"));
  SKTest.expectTrue(SKJS.isJSNumericString("1e-7"));
  SKTest.expectTrue(SKJS.isJSNumericString("0.000001"));
  SKTest.expectTrue(SKJS.isJSNumericString("100000000000000000000"));
}

// Literals whose exact value is not representable in an IEEE-754 double
// (radix literals above 2^53, exponents beyond the guard) are left in their
// spelled form rather than normalized with wrapping Int arithmetic.
@test
fun testNormalizeKeepsImpreciseSpelledForm(): void {
  SKTest.expectEq(
    "0xFFFFFFFFFFFFFFFF",
    SKJS.normalizeJSNumber("0xFFFFFFFFFFFFFFFF"),
  );
  SKTest.expectEq(
    "0x8000000000000000",
    SKJS.normalizeJSNumber("0x8000000000000000"),
  );
  SKTest.expectEq(
    "1e18446744073709551619",
    SKJS.normalizeJSNumber("1e18446744073709551619"),
  );
  // 2^53 itself is exactly representable and still normalizes.
  SKTest.expectEq(
    "9007199254740992",
    SKJS.normalizeJSNumber("0x20000000000000"),
  );
}

module end;
