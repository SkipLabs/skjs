// Unit tests for package.json types/typings resolution in ModuleResolver.
module SKJSTests;

fun mkStubMem(files: Array<(String, String)>): SKJS.MemFs {
  m = mutable Map[];
  for (kv in files) {
    m.set(kv.i0, kv.i1)
  };
  SKJS.MemFs::fromMap(m.chill())
}

@test
fun testResolveStubsPackageJson(): void {
  stubs = Array[SKJS.DAbsolute::create("/stubs")];

  // Explicit `types` field pointing to a non-index.d.ts path.
  fsTypes = mkStubMem(
    Array[
      ("/stubs/foo/package.json", `{"types": "./lib/foo.d.ts"}`),
      ("/stubs/foo/lib/foo.d.ts", "export declare const x: number;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsTypes, stubs, "foo"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "foo/lib/foo.d.ts"),
    ),
    "package.json types field",
  );

  // `types` takes precedence over `typings` when both are present.
  fsPrecedence = mkStubMem(
    Array[
      (
        "/stubs/both/package.json",
        `{"types": "./a.d.ts", "typings": "./b.d.ts"}`,
      ),
      ("/stubs/both/a.d.ts", "export declare const a: number;"),
      ("/stubs/both/b.d.ts", "export declare const b: string;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsPrecedence, stubs, "both"),
    SKJS.StubFound(SKJS.FPath::create(SKJS.RootId::stub(0), "both/a.d.ts")),
    "types takes precedence over typings",
  );

  // `typings` alias with extensionless target.
  fsTypings = mkStubMem(
    Array[
      ("/stubs/bar/package.json", `{"typings": "types/bar"}`),
      ("/stubs/bar/types/bar.d.ts", "export declare const y: string;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsTypings, stubs, "bar"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "bar/types/bar.d.ts"),
    ),
    "package.json typings alias (extensionless)",
  );

  // Directory target in `types` resolves to `<dir>/index.d.ts`.
  fsDirTarget = mkStubMem(
    Array[
      ("/stubs/dirpkg/package.json", `{"types": "./types"}`),
      ("/stubs/dirpkg/types/index.d.ts", "export declare const d: number;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsDirTarget, stubs, "dirpkg"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "dirpkg/types/index.d.ts"),
    ),
    "package.json types pointing to directory",
  );

  // Missing `types` target falls back to index.d.ts.
  fsMissingTarget = mkStubMem(
    Array[
      ("/stubs/fall/package.json", `{"types": "./missing.d.ts"}`),
      ("/stubs/fall/index.d.ts", "export declare const f: boolean;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsMissingTarget, stubs, "fall"),
    SKJS.StubFound(SKJS.FPath::create(SKJS.RootId::stub(0), "fall/index.d.ts")),
    "missing types target falls back to index.d.ts",
  );

  // Path escaping stub root is ignored (does not resolve outside stub dir).
  fsEscape = mkStubMem(
    Array[
      ("/stubs/esc/package.json", `{"types": "../../secret.d.ts"}`),
      ("/secret.d.ts", "export declare const s: string;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsEscape, stubs, "esc"),
    SKJS.StubNotFound(),
    "types path escaping stub root rejected",
  );

  // Fallback to index.d.ts without package.json.
  fsIndexDts = mkStubMem(
    Array[("/stubs/legacy/index.d.ts", "export declare const z: boolean;")],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsIndexDts, stubs, "legacy"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "legacy/index.d.ts"),
    ),
    "index.d.ts fallback",
  );

  // Fallback to index.ts / index.tsx.
  fsIndexTs = mkStubMem(
    Array[("/stubs/tsonly/index.ts", "export const a: number = 1;")],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsIndexTs, stubs, "tsonly"),
    SKJS.StubFound(SKJS.FPath::create(SKJS.RootId::stub(0), "tsonly/index.ts")),
    "index.ts fallback",
  );

  fsIndexTsx = mkStubMem(
    Array[("/stubs/tsxonly/index.tsx", "export const a: number = 1;")],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsIndexTsx, stubs, "tsxonly"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "tsxonly/index.tsx"),
    ),
    "index.tsx fallback",
  );

  // Malformed package.json returns a clear StubError diagnostic (no crash).
  fsBroken = mkStubMem(Array[("/stubs/broken/package.json", "{not json")]);
  SKJS.resolveStubs(fsBroken, stubs, "broken") match {
  | SKJS.StubError(msg) ->
    SKTest.expectTrue(
      msg.contains("Invalid package.json for module 'broken'"),
      `unexpected error message: ${msg}`,
    )
  | other -> SKTest.fail(`Expected StubError, got ${other}`)
  };

  // Non-object package.json also returns StubError.
  fsArrayPkg = mkStubMem(Array[("/stubs/arrpkg/package.json", "[1, 2, 3]")]);
  SKJS.resolveStubs(fsArrayPkg, stubs, "arrpkg") match {
  | SKJS.StubError(msg) ->
    SKTest.expectTrue(
      msg.contains("Invalid package.json for module 'arrpkg'"),
      `unexpected error message: ${msg}`,
    )
  | other -> SKTest.fail(`Expected StubError, got ${other}`)
  };
}

@test
fun testResolveStubsAtTypesFallback(): void {
  stubs = Array[SKJS.DAbsolute::create("/stubs")];

  // Unscoped package with no types falls back to @types/<pkg>.
  fsDt = mkStubMem(
    Array[
      ("/stubs/untyped/package.json", `{"name": "untyped"}`),
      ("/stubs/@types/untyped/index.d.ts", "export declare const x: number;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsDt, stubs, "untyped"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "@types/untyped/index.d.ts"),
    ),
    "@types/<pkg> fallback",
  );

  // Scoped package @scope/pkg -> @types/scope__pkg (reusing package.json types).
  fsScoped = mkStubMem(
    Array[
      ("/stubs/@types/acme__pkg/package.json", `{"types": "./lib/pkg.d.ts"}`),
      (
        "/stubs/@types/acme__pkg/lib/pkg.d.ts",
        "export declare const y: string;",
      ),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsScoped, stubs, "@acme/pkg"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "@types/acme__pkg/lib/pkg.d.ts"),
    ),
    "@types/scope__pkg fallback",
  );

  // Own types take precedence over @types/<pkg> across stub dirs.
  stubs2 = Array[
    SKJS.DAbsolute::create("/stubs1"),
    SKJS.DAbsolute::create("/stubs2"),
  ];
  fsOwn = mkStubMem(
    Array[
      ("/stubs1/@types/own/index.d.ts", "export declare const s: 'dt';"),
      ("/stubs2/own/package.json", `{"types": "./own.d.ts"}`),
      ("/stubs2/own/own.d.ts", "export declare const s: 'own';"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsOwn, stubs2, "own"),
    SKJS.StubFound(SKJS.FPath::create(SKJS.RootId::stub(1), "own/own.d.ts")),
    "own types take precedence over @types",
  );

  // Does not recurse on @types/* itself.
  fsNoLoop = mkStubMem(
    Array[
      (
        "/stubs/@types/types__foo/index.d.ts",
        "export declare const z: number;",
      ),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsNoLoop, stubs, "@types/foo"),
    SKJS.StubNotFound(),
    "does not map @types/foo to @types/types__foo",
  );
}

@test
fun testResolveStubsPackageJsonExports(): void {
  stubs = Array[SKJS.DAbsolute::create("/stubs")];

  fs = mkStubMem(
    Array[
      (
        "/stubs/dual/package.json",
        `{
          "types": "./legacy.d.ts",
          "exports": {
            ".": { "types": "./lib/index.d.ts", "import": "./lib/index.mjs" },
            "./utils": { "types": "./lib/utils.d.ts", "default": "./lib/utils.js" },
            "./sub/*": { "types": "./lib/sub/*.d.ts" },
            "./blocked": null
          }
        }`,
      ),
      ("/stubs/dual/legacy.d.ts", "export declare const old: number;"),
      ("/stubs/dual/lib/index.d.ts", "export declare const cur: string;"),
      ("/stubs/dual/lib/utils.d.ts", "export declare const u: number;"),
      ("/stubs/dual/lib/sub/a.d.ts", "export declare const a: boolean;"),
      ("/stubs/dual/internal.d.ts", "export declare const s: string;"),
    ],
  );

  // `exports["."].types` takes precedence over top-level `types`.
  SKTest.expectEq(
    SKJS.resolveStubs(fs, stubs, "dual"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "dual/lib/index.d.ts"),
    ),
    "exports['.'].types overrides top-level types",
  );

  // Exact subpath export.
  SKTest.expectEq(
    SKJS.resolveStubs(fs, stubs, "dual/utils"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "dual/lib/utils.d.ts"),
    ),
    "exports['./utils'].types",
  );

  // Pattern subpath export.
  SKTest.expectEq(
    SKJS.resolveStubs(fs, stubs, "dual/sub/a"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "dual/lib/sub/a.d.ts"),
    ),
    "exports['./sub/*'].types",
  );

  // Unexported subpath fails with TS-style exports diagnostic (no fallback).
  SKJS.resolveStubs(fs, stubs, "dual/internal") match {
  | SKJS.StubError(msg) ->
    SKTest.expectTrue(
      msg.contains("Package subpath './internal' is not defined by 'exports'"),
      `unexpected error message: ${msg}`,
    )
  | other ->
    SKTest.fail(`Expected StubError for unexported subpath, got ${other}`)
  };

  // Explicitly null-blocked subpath also fails with exports diagnostic.
  SKJS.resolveStubs(fs, stubs, "dual/blocked") match {
  | SKJS.StubError(msg) ->
    SKTest.expectTrue(
      msg.contains("Package subpath './blocked' is not defined by 'exports'"),
      `unexpected error message: ${msg}`,
    )
  | other -> SKTest.fail(`Expected StubError for null export, got ${other}`)
  };

  // Shorthand condition object (no "." key) and `default` condition fallback.
  fsShorthand = mkStubMem(
    Array[
      (
        "/stubs/short/package.json",
        `{"exports": { "default": "./lib/entry.js" }}`,
      ),
      ("/stubs/short/lib/entry.d.ts", "export declare const s: number;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsShorthand, stubs, "short"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "short/lib/entry.d.ts"),
    ),
    "shorthand exports condition object with default .js -> .d.ts",
  );

  // String shorthand exports (`"exports": "./lib/main.d.ts"`).
  fsStr = mkStubMem(
    Array[
      ("/stubs/strpkg/package.json", `{"exports": "./lib/main.d.ts"}`),
      ("/stubs/strpkg/lib/main.d.ts", "export declare const m: number;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsStr, stubs, "strpkg"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "strpkg/lib/main.d.ts"),
    ),
    "string shorthand exports for '.'",
  );
  SKJS.resolveStubs(fsStr, stubs, "strpkg/other") match {
  | SKJS.StubError(msg) ->
    SKTest.expectTrue(
      msg.contains("Package subpath './other' is not defined by 'exports'"),
      `unexpected error message: ${msg}`,
    )
  | other ->
    SKTest.fail(
      `Expected StubError for subpath on string exports, got ${other}`,
    )
  };

  // Longest-prefix pattern wins over shorter wildcard.
  fsSpecific = mkStubMem(
    Array[
      (
        "/stubs/spec/package.json",
        `{
          "exports": {
            "./*": "./generic/*.d.ts",
            "./deep/*": "./specific/*.d.ts"
          }
        }`,
      ),
      ("/stubs/spec/generic/deep/x.d.ts", "export declare const g: number;"),
      ("/stubs/spec/specific/x.d.ts", "export declare const s: string;"),
    ],
  );
  SKTest.expectEq(
    SKJS.resolveStubs(fsSpecific, stubs, "spec/deep/x"),
    SKJS.StubFound(
      SKJS.FPath::create(SKJS.RootId::stub(0), "spec/specific/x.d.ts"),
    ),
    "longest-prefix exports pattern wins",
  );
}

module end;
