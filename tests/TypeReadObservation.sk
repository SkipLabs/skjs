module SKJSTests;

fun observationSubst(): mutable SKJS.Subst {
  context = SKStore.Context::mcreate{};
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  base = mutable SKJS.TCEnvLight{context, results};
  SKJS.Subst::mcreate(base)
}

fun observationNumber(): SKJS.TType {
  SKJS.TType::single(SKJS.TPrimValue::number(SKJS.PosRange::none))
}

fun observationString(): SKJS.TType {
  SKJS.TType::single(SKJS.TPrimValue::string(SKJS.PosRange::none))
}

// Direct values writes below set up internal states, as in HiddenEscape.sk.
// They are deliberately not production inference operations. Tests that check
// the epoch use gen/restore, not an uninstrumented fixture write.
@test
fun testObservedBindingIsCommitted(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[tv.id] = SKJS.SVOpen(num);
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
  SKTest.expectEq(Some(num), subst.peekRaw(tv));
  SKTest.expectEq(epoch + 1, subst.semanticEpoch);
}

@test
fun testUnboundObservationIsBlockedNotUnavailable(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isUnbound(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testUnavailableObservationDoesNotCommit(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads<SKJS.TType>(scratch -> {
    _ = scratch.peekRaw(tv);
    None()
  });
  SKTest.expectEq(true, result is SKJS.TRUnavailable _);
  SKTest.expectEq(true, subst.isOpen(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testObservedClosedOuterStillCommitsInnerRead(): void {
  subst = observationSubst();
  outer = subst.gen(SKJS.PosRange::none);
  inner = subst.gen(SKJS.PosRange::none);
  subst.!values[outer.id] = SKJS.SVClosed(SKJS.TType::var(inner));
  subst.!values[inner.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch ->
    scratch.peekRaw(outer).flatMap(ty ->
      ty.getSingleVar().flatMap(tv -> scratch.peekRaw(tv))
    )
  );
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(inner));
}

@test
fun testUninspectedSymbolicMemberRemainsOpen(): void {
  subst = observationSubst();
  outer = subst.gen(SKJS.PosRange::none);
  member = subst.gen(SKJS.PosRange::none);
  arrayTy = SKJS.TType::inst(
    SKJS.Name(SKJS.PosRange::none, "Array"),
    SKJS.TArgs(Array[SKJS.TType::var(member)]),
  );
  subst.!values[outer.id] = SKJS.SVOpen(arrayTy);
  // No binding for member is needed to retain the symbolic Array<member>.
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(outer));
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(outer));
  SKTest.expectEq(true, subst.isUnbound(member));
}

@test
fun testNestedCloneContributesReadDependencies(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch -> {
    child = scratch.clone();
    child.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testNestedNormalizationSubstKeepsSnapshot(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch -> {
    // The omitted state must not replace the inherited candidate store by an
    // empty one, as ordinary declaration-only normalization is allowed to do.
    child = SKJS.Subst::mcreate(scratch);
    child.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testCaughtAllocationDoesNotAuthorizeObservation(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> {
    saved = scratch.save();
    try {
      _ = scratch.gen(SKJS.PosRange::none)
    } catch {
    | SKJS.SubstObservationBlocked() -> void
    | exn -> throw exn
    };
    scratch.restore(saved);
    // Even returning a concrete answer without a further read cannot erase
    // the blocked latch by catching the exception and restoring the state.
    Some(observationNumber())
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testFrozenTransferIsAtomic(): void {
  subst = observationSubst();
  field = subst.genForField(SKJS.PosRange::none);
  candidate = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[field.id] = SKJS.SVOpen(num);
  subst.!values[candidate.id] = SKJS.SVOpen(num);
  subst.!freezeCandidates = true;
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> {
    _ = scratch.peekRaw(field);
    scratch.peekRaw(candidate)
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  // Pinning the field would be allowed, but must not happen when committing
  // the complete read set would require sealing a frozen candidate.
  SKTest.expectEq(true, subst.isOpen(field));
  SKTest.expectEq(true, subst.isOpen(candidate));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testFrozenAlreadyClosedReadSucceeds(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVClosed(observationNumber());
  subst.!freezeCandidates = true;
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testOwnerRollbackInvalidatesInFlightRead(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  saved = subst.save();
  version = subst.version;
  result = subst.withCommittedTypeReads(scratch -> {
    value = scratch.peekRaw(tv);
    subst.restore(saved);
    value
  });
  SKTest.expectEq(version, subst.version);
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
}

@test
fun testBindingComparisonProtectsUninstrumentedFixtureChange(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch -> {
    value = scratch.peekRaw(tv);
    // Deliberately bypass epoch accounting to exercise the second guard.
    subst.!values[tv.id] = SKJS.SVOpen(observationString());
    value
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
}

@test
fun testObservedScratchDoesNotInheritSuccessCaches(): void {
  subst = observationSubst();
  num = observationNumber();
  str = observationString();
  subst.!seenSub = SortedSet[(num, str)];
  subst.!seenInter[(num, str)] = num;
  result = subst.withCommittedTypeReads<SKJS.TType>(scratch -> {
    SKTest.expectEq(true, scratch.seenSub.isEmpty());
    SKTest.expectEq(true, scratch.seenInter.isEmpty());
    scratch.!seenSub = SortedSet[(str, num)];
    Some(num)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(SortedSet[(num, str)], subst.seenSub);
}

@test
fun testImmutableSnapshotDoesNotFollowLiveReplacement(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[tv.id] = SKJS.SVOpen(num);
  snapshot = subst.snapshot();
  subst.!values[tv.id] = SKJS.SVOpen(observationString());
  SKTest.expectEq(Some(num), snapshot.peekRaw(tv));
  SKTest.expectEq(true, subst.isOpen(tv));
}

class ObservationTestFailure() extends Exception

@test
fun testUnexpectedObservationExceptionPropagates(): void {
  subst = observationSubst();
  caught = false;
  try {
    _ = subst.withCommittedTypeReads<SKJS.TType>(_scratch -> {
      throw ObservationTestFailure()
    })
  } catch {
  | ObservationTestFailure() -> !caught = true
  | exn -> throw exn
  };
  SKTest.expectEq(true, caught);
}

@test
fun testNestedForeignCandidateStateIsRefused(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  foreign = observationSubst();
  other = foreign.gen(SKJS.PosRange::none);
  foreign.!values[other.id] = SKJS.SVOpen(observationString());
  foreignState = foreign.save();
  result = subst.withCommittedTypeReads(scratch -> {
    child = SKJS.Subst::mcreate(scratch, foreignState);
    child.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
}

module end;
