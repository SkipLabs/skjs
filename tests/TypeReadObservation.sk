module SKJSTests;

fun observationSubst(): mutable SKJS.Subst {
  context = SKStore.Context::mcreate{};
  results = SKJS.TCResultsAcc::mcreate{errorHandling => SKJS.EHDefault()};
  base = mutable SKJS.TCEnvLight{context, results};
  SKJS.Subst::mcreate(base)
}

fun observationNumber(): SKJS.TType {
  SKJS.TType::single(SKJS.TPrimValue::number(SKJS.PosRange::none))
}

fun observationString(): SKJS.TType {
  SKJS.TType::single(SKJS.TPrimValue::string(SKJS.PosRange::none))
}

// Direct values writes below set up internal states, as in HiddenEscape.sk.
// They are deliberately not production inference operations. Tests that check
// the epoch use gen/restore, not an uninstrumented fixture write.
@test
fun testObservedBindingIsCommitted(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[tv.id] = SKJS.SVOpen(num);
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
  SKTest.expectEq(Some(num), subst.peekRaw(tv));
  SKTest.expectEq(epoch + 1, subst.semanticEpoch);
}

@test
fun testUnboundObservationIsBlockedNotUnavailable(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isUnbound(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testUnavailableObservationDoesNotCommit(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads<SKJS.TType>(scratch -> {
    _ = scratch.peekRaw(tv);
    None()
  });
  SKTest.expectEq(true, result is SKJS.TRUnavailable _);
  SKTest.expectEq(true, subst.isOpen(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testObservedClosedOuterStillCommitsInnerRead(): void {
  subst = observationSubst();
  outer = subst.gen(SKJS.PosRange::none);
  inner = subst.gen(SKJS.PosRange::none);
  subst.!values[outer.id] = SKJS.SVClosed(SKJS.TType::var(inner));
  subst.!values[inner.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch ->
    scratch.peekRaw(outer).flatMap(ty ->
      ty.getSingleVar().flatMap(tv -> scratch.peekRaw(tv))
    )
  );
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(inner));
}

@test
fun testUninspectedSymbolicMemberRemainsOpen(): void {
  subst = observationSubst();
  outer = subst.gen(SKJS.PosRange::none);
  member = subst.gen(SKJS.PosRange::none);
  arrayTy = SKJS.TType::inst(
    SKJS.Name(SKJS.PosRange::none, "Array"),
    SKJS.TArgs(Array[SKJS.TType::var(member)]),
  );
  subst.!values[outer.id] = SKJS.SVOpen(arrayTy);
  // No binding for member is needed to retain the symbolic Array<member>.
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(outer));
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(outer));
  SKTest.expectEq(true, subst.isUnbound(member));
}

@test
fun testNestedCloneContributesReadDependencies(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch -> {
    child = scratch.clone();
    child.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testNestedNormalizationSubstKeepsSnapshot(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch -> {
    // The omitted state must not replace the inherited candidate store by an
    // empty one, as ordinary declaration-only normalization is allowed to do.
    child = SKJS.Subst::mcreate(scratch);
    child.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testCaughtAllocationDoesNotAuthorizeObservation(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> {
    saved = scratch.save();
    try {
      _ = scratch.gen(SKJS.PosRange::none)
    } catch {
    | SKJS.SubstObservationBlocked() -> void
    | exn -> throw exn
    };
    scratch.restore(saved);
    // Even returning a concrete answer without a further read cannot erase
    // the blocked latch by catching the exception and restoring the state.
    Some(observationNumber())
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testFrozenTransferIsAtomic(): void {
  subst = observationSubst();
  field = subst.genForField(SKJS.PosRange::none);
  candidate = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[field.id] = SKJS.SVOpen(num);
  subst.!values[candidate.id] = SKJS.SVOpen(num);
  subst.!freezeCandidates = true;
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> {
    _ = scratch.peekRaw(field);
    scratch.peekRaw(candidate)
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  // Pinning the field would be allowed, but must not happen when committing
  // the complete read set would require sealing a frozen candidate.
  SKTest.expectEq(true, subst.isOpen(field));
  SKTest.expectEq(true, subst.isOpen(candidate));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testFrozenAlreadyClosedReadSucceeds(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVClosed(observationNumber());
  subst.!freezeCandidates = true;
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

@test
fun testOwnerRollbackInvalidatesInFlightRead(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  saved = subst.save();
  version = subst.version;
  result = subst.withCommittedTypeReads(scratch -> {
    value = scratch.peekRaw(tv);
    subst.restore(saved);
    value
  });
  SKTest.expectEq(version, subst.version);
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
}

@test
fun testBindingComparisonProtectsUninstrumentedFixtureChange(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads(scratch -> {
    value = scratch.peekRaw(tv);
    // Deliberately bypass epoch accounting to exercise the second guard.
    subst.!values[tv.id] = SKJS.SVOpen(observationString());
    value
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
}

@test
fun testObservedScratchDoesNotInheritSuccessCaches(): void {
  subst = observationSubst();
  num = observationNumber();
  str = observationString();
  subst.!seenSub = SortedSet[(num, str)];
  subst.!seenInter[(num, str)] = num;
  result = subst.withCommittedTypeReads<SKJS.TType>(scratch -> {
    SKTest.expectEq(true, scratch.seenSub.isEmpty());
    SKTest.expectEq(true, scratch.seenInter.isEmpty());
    scratch.!seenSub = SortedSet[(str, num)];
    Some(num)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(SortedSet[(num, str)], subst.seenSub);
}

@test
fun testImmutableSnapshotDoesNotFollowLiveReplacement(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[tv.id] = SKJS.SVOpen(num);
  snapshot = subst.snapshot();
  subst.!values[tv.id] = SKJS.SVOpen(observationString());
  SKTest.expectEq(Some(num), snapshot.peekRaw(tv));
  SKTest.expectEq(true, subst.isOpen(tv));
}

class ObservationTestFailure() extends Exception

@test
fun testUnexpectedObservationExceptionPropagates(): void {
  subst = observationSubst();
  caught = false;
  try {
    _ = subst.withCommittedTypeReads<SKJS.TType>(_scratch -> {
      throw ObservationTestFailure()
    })
  } catch {
  | ObservationTestFailure() -> !caught = true
  | exn -> throw exn
  };
  SKTest.expectEq(true, caught);
}

@test
fun testNestedForeignCandidateStateIsRefused(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  foreign = observationSubst();
  other = foreign.gen(SKJS.PosRange::none);
  foreign.!values[other.id] = SKJS.SVOpen(observationString());
  foreignState = foreign.save();
  result = subst.withCommittedTypeReads(scratch -> {
    child = SKJS.Subst::mcreate(scratch, foreignState);
    child.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isOpen(tv));
}

// A saved candidate store can agree with the observation while its cached
// answers have never contributed to that observation's read frame. The caches
// below are deliberately poisoned fixtures, not claimed valid subtype facts.
@test
fun testObservedRestoreCannotImportOwnerCaches(): void {
  subst = observationSubst();
  num = observationNumber();
  str = observationString();
  pos = SKJS.PosRange::none;
  key = SKJS.ExpansionKey(
    SKJS.TypeDefinitionIdentity(pos.fileName, "ObservedAlias", 0),
    SKJS.TArgs(Array[]),
  );
  subst.!seenSub = SortedSet[(num, str)];
  subst.!seenInter[(num, str)] = num;
  subst.!seenUnion[(num, str)] = num;
  subst.!seenExpansion[key] = str;
  saved = subst.save();
  result = subst.withCommittedTypeReads<SKJS.TType>(scratch -> {
    scratch.restore(saved);
    SKTest.expectEq(true, scratch.seenSub.isEmpty());
    SKTest.expectEq(true, scratch.seenInter.isEmpty());
    SKTest.expectEq(true, scratch.seenUnion.isEmpty());
    SKTest.expectEq(true, scratch.seenExpansion.isEmpty());
    Some(num)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  // Scratch cleanup does not rewrite the live owner's inference caches.
  SKTest.expectEq(saved.seenSub, subst.seenSub);
  SKTest.expectEq(saved.seenInter, subst.seenInter);
  SKTest.expectEq(saved.seenUnion, subst.seenUnion);
  SKTest.expectEq(saved.seenExpansion, subst.seenExpansion);
}

@test
fun testObservedLocalRestoreKeepsInspectedDependencies(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  str = observationString();
  subst.!values[tv.id] = SKJS.SVOpen(num);
  result = subst.withCommittedTypeReads(scratch -> {
    observed = scratch.peekRaw(tv);
    scratch.!seenSub = SortedSet[(num, str)];
    saved = scratch.save();
    scratch.restore(saved);
    SKTest.expectEq(true, scratch.seenSub.isEmpty());
    observed
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testNestedObservedRestoreCannotImportOwnerCaches(): void {
  subst = observationSubst();
  num = observationNumber();
  str = observationString();
  subst.!seenSub = SortedSet[(num, str)];
  saved = subst.save();
  result = subst.withCommittedTypeReads<SKJS.TType>(scratch -> {
    nested = scratch.clone();
    nested.restore(saved);
    SKTest.expectEq(true, nested.seenSub.isEmpty());
    Some(num)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
}

@test
fun testOrdinaryRestoreStillRestoresInferenceCaches(): void {
  subst = observationSubst();
  num = observationNumber();
  str = observationString();
  subst.!seenSub = SortedSet[(num, str)];
  subst.!seenInter[(num, str)] = num;
  saved = subst.save();
  subst.!seenSub = SortedSet[];
  subst.!seenInter = SortedMap[];
  subst.restore(saved);
  SKTest.expectEq(saved.seenSub, subst.seenSub);
  SKTest.expectEq(saved.seenInter, subst.seenInter);
}

// Unlike an optional read, a negative decision is consumed by the caller.
// Its read set must therefore be committed, even when the value is false.
@test
fun testFalseTypeDecisionCommitsItsReads(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeDecision<Bool>(scratch ->
    scratch.peekRaw(tv).fromSome().getSingleVar().isSome()
  );
  SKTest.expectEq(true, result is SKJS.TRReady(false));
  SKTest.expectEq(true, subst.isClosed(tv));
  SKTest.expectEq(epoch + 1, subst.semanticEpoch);
}

// This is the shape of the function-subtyping tuple decision: no fixed tuple
// was found, but that conclusion is not an unavailable optional observation.
@test
fun testAbsentTupleDecisionCommitsItsReads(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeDecision<?Array<SKJS.TType>>(scratch -> {
    _ = scratch.peekRaw(tv);
    None()
  });
  SKTest.expectEq(true, result is SKJS.TRReady(None()));
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testBlockedDecisionIsNotFalse(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeDecision<Bool>(scratch ->
    scratch.isClosed(tv)
  );
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(true, subst.isUnbound(tv));
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

// Catching a forbidden inference operation cannot produce a trusted negative
// decision; the shared blocked latch survives the caught exception.
@test
fun testCaughtBlockDoesNotAuthorizeNegativeDecision(): void {
  subst = observationSubst();
  epoch = subst.semanticEpoch;
  result = subst.withCommittedTypeDecision<Bool>(scratch -> {
    try {
      _ = scratch.gen(SKJS.PosRange::none)
    } catch {
    | SKJS.SubstObservationBlocked() -> void
    | exn -> throw exn
    };
    false
  });
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(epoch, subst.semanticEpoch);
}

// The layout can inspect an outer binding without inspecting its element.
// Later positional checks must still be able to infer that symbolic element.
@test
fun testRestLayoutDecisionLeavesSymbolicElementOpen(): void {
  subst = observationSubst();
  outer = subst.gen(SKJS.PosRange::none);
  element = subst.gen(SKJS.PosRange::none);
  arrayTy = SKJS.TType::inst(
    SKJS.Name(SKJS.PosRange::none, "Array"),
    SKJS.TArgs(Array[SKJS.TType::var(element)]),
  );
  subst.!values[outer.id] = SKJS.SVOpen(arrayTy);
  result = subst.withCommittedTypeDecision<?Array<SKJS.TType>>(scratch -> {
    _ = scratch.peekRaw(outer);
    None()
  });
  SKTest.expectEq(true, result is SKJS.TRReady(None()));
  SKTest.expectEq(true, subst.isClosed(outer));
  SKTest.expectEq(true, subst.isUnbound(element));
}

// Rejecting the enclosing alternative abandons its layout decision too.
// The normal rollback path must restore the pre-decision open binding.
@test
fun testRestLayoutCommitmentRollsBackWithAlternative(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  saved = subst.save();
  result = subst.withCommittedTypeDecision<Bool>(scratch -> {
    _ = scratch.peekRaw(tv);
    false
  });
  SKTest.expectEq(true, result is SKJS.TRReady(false));
  SKTest.expectEq(true, subst.isClosed(tv));
  subst.restore(saved);
  SKTest.expectEq(true, subst.isOpen(tv));
  SKTest.expectEq(saved.version, subst.version);
}

// Alias/class constraint probes may solve throwaway variables while a surrounding
// materialization is observing its real dependencies. Those speculative writes
// must neither block the observation nor escape into the owner.
@test
fun testDetachedTypeArgumentProbeDoesNotBlockObservation(): void {
  subst = observationSubst();
  observed = subst.gen(SKJS.PosRange::none);
  subst.!values[observed.id] = SKJS.SVOpen(observationNumber());
  ownerVersion = subst.version;
  result = subst.withCommittedTypeReads<Bool>(scratch -> {
    scratch.withTypeArgumentProbe(probe -> {
      // Allocation is a genuine instrumented mutation and needs no fabricated
      // typing environment. Fixture binding writes only set up the probe state.
      speculative = probe.gen(SKJS.PosRange::none);
      probe.!values[speculative.id] = SKJS.SVOpen(observationString());
      SKTest.expectEq(
        true,
        probe.typeComputationPurpose() is SKJS.TCPTypeArgumentProbe(),
      );
    });
    _ = scratch.peekRaw(observed);
    Some(true)
  });
  SKTest.expectEq(true, result is SKJS.TRReady(true));
  SKTest.expectEq(true, subst.isClosed(observed));
  // Only committing the observed binding mutates the owner; speculative probe
  // allocation/growth lives on the detached clone.
  SKTest.expectEq(ownerVersion + 1, subst.version);
}

@test
fun testProbePurposeSurvivesCloneAndNormalization(): void {
  subst = observationSubst();
  originalVersion = subst.version;
  subst.withTypeArgumentProbe(probe -> {
    child = probe.clone();
    fresh = SKJS.Subst::mcreate(child);
    SKTest.expectEq(
      true,
      fresh.typeComputationPurpose() is SKJS.TCPTypeArgumentProbe(),
    );
    _ = fresh.gen(SKJS.PosRange::none);
    decision = probe.withCommittedTypeDecision<Bool>(scratch -> {
      nested = SKJS.Subst::mcreate(scratch.clone());
      nested.typeComputationPurpose() is SKJS.TCPTypeArgumentProbe()
    });
    SKTest.expectEq(true, decision is SKJS.TRReady(true));
  });
  SKTest.expectEq(originalVersion, subst.version);
  SKTest.expectEq(true, subst.typeComputationPurpose() is SKJS.TCPChecking());
}

@test
fun testProbeCannotInstallAnObservedPayload(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  num = observationNumber();
  subst.!values[tv.id] = SKJS.SVOpen(num);
  result = subst.withCommittedTypeReads(scratch -> {
    scratch.withTypeArgumentProbe(probe -> {
      probe.!values[tv.id] = SKJS.SVClosed(observationString());
    });
    scratch.peekRaw(tv)
  });
  SKTest.expectEq(true, result is SKJS.TRReady _);
  SKTest.expectEq(Some(num), subst.peekRaw(tv));
  SKTest.expectEq(true, subst.isClosed(tv));
}

@test
fun testDiagnosticReadDoesNotContributeACommitment(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  subst.!values[tv.id] = SKJS.SVOpen(observationNumber());
  result = subst.withCommittedTypeReads<Bool>(scratch -> {
    diagnostic = scratch.cloneForTypeDiagnostics();
    _ = diagnostic.peekRaw(tv);
    _ = diagnostic.gen(SKJS.PosRange::none);
    SKTest.expectEq(
      true,
      diagnostic.typeComputationPurpose() is SKJS.TCPDiagnostic(),
    );
    Some(true)
  });
  SKTest.expectEq(true, result is SKJS.TRReady(true));
  SKTest.expectEq(true, subst.isOpen(tv));
}

@test
fun testDetachedPurposeDoesNotChangeOnRestore(): void {
  subst = observationSubst();
  saved = subst.save();
  diagnostic = subst.cloneForTypeDiagnostics();
  diagnostic.restore(saved);
  SKTest.expectEq(
    true,
    diagnostic.typeComputationPurpose() is SKJS.TCPDiagnostic(),
  );
  child = SKJS.Subst::mcreate(diagnostic);
  SKTest.expectEq(
    true,
    child.typeComputationPurpose() is SKJS.TCPDiagnostic(),
  );
}

@test
fun testProbeExceptionDoesNotGetSwallowed(): void {
  subst = observationSubst();
  caught = false;
  try {
    subst.withTypeArgumentProbe(_probe -> {
      throw ObservationTestFailure()
    });
  } catch {
  | ObservationTestFailure() -> !caught = true
  | exn -> throw exn
  };
  SKTest.expectEq(true, caught);
}

module end;
