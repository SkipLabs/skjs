@test
fun testFrozenClosedOuterDoesNotHideNormalizerRead(): void {
  subst = observationSubst();
  outer = subst.gen(SKJS.PosRange::none);
  inner = subst.gen(SKJS.PosRange::none);
  observationBind(subst, outer, SKJS.TType::var(inner), true);
  observationBind(subst, inner, observationNumber(), false);
  subst.!freezeCandidates = true;
  stamp = subst.typeQueryReadStamp();
  scratch = SKJS.Subst::mcreate(subst, subst.save());
  raw = scratch.peekRaw(outer);
  SKTest.expectEq(true, subst.canCacheTypeQuerySince(stamp));
  _ = raw.flatMap(ty -> ty.getSingleVar().flatMap(tv -> scratch.peekRaw(tv)));
  SKTest.expectEq(false, subst.canCacheTypeQuerySince(stamp));
}

@test
fun testFrozenObservedReadCannotMemoize(): void {
  subst = observationSubst();
  tv = subst.gen(SKJS.PosRange::none);
  observationBind(subst, tv, observationNumber(), false);
  subst.!freezeCandidates = true;
  stamp = subst.typeQueryReadStamp();
  result = subst.withCommittedTypeReads(scratch -> scratch.peekRaw(tv));
  SKTest.expectEq(true, result is SKJS.TRBlocked _);
  SKTest.expectEq(false, subst.canCacheTypeQuerySince(stamp));
}

// Exercise the real query wrapper with a controlled recursive context. This
// exposes memo lifetime directly; it is not a source-program counterexample.
fun observationTypeEnv(subst: mutable SKJS.Subst): SKJS.TEnv {
  context = subst.context;
  fs = SKJS.Fs::disk();
  files =
    SKJS.Files::create(
      context,
      fs,
      ".",
      Array["tests/expect-error/type-query-memo-stability.ts"],
      Array["./import-stubs"],
    ) |> expectFilesSuccess;
  SKJS.writeConfig(
    context,
    SKJS.CheckerConfig{
      errorHandling => SKJS.EHDefault(),
      errorDetailConfig => SKJS.ErrorDetailConfig::minimal(),
    },
  );
  SKJS.Checker::create{context, fs, files}.fromSuccess().checker
}

@test
fun testRecursiveSubtypeMemoScope(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  number = observationNumber();
  string = observationString();
  assumed = tenv with {
    seenSub => SortedSet[(subst.inferenceVersion(), number, string)],
  };
  conditional = SKJS.TType::isSub(subst, assumed, number, string);
  SKTest.expectEq(true, conditional is SKJS.STOk());
  // The conditional result must not escape its recursive context.
  outside = SKJS.TType::isSub(subst, tenv, number, string);
  SKTest.expectEq(false, outside is SKJS.STOk());
}

@test
fun testIndependentSubtypeInsideRecursiveContextCanMemoize(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  number = observationNumber();
  string = observationString();
  top = SKJS.TType::top(SKJS.PosRange::none);
  assumed = tenv with {
    seenSub => SortedSet[(subst.inferenceVersion(), number, string)],
  };
  result = SKJS.TType::isSub(subst, assumed, number, top);
  SKTest.expectEq(true, result is SKJS.STOk());
  SKTest.expectEq(true, subst.seenSub.contains((number, top)));
}

@test
fun testRecursiveIntersectionMemoScope(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  number = observationNumber();
  string = observationString();
  assumed = tenv with {seenInter => SortedSet[(number, string)]};
  deferredIntersection = SKJS.TType::inter(subst, assumed, number, string);
  SKTest.expectEq(true, deferredIntersection.getSingleInter().isSome());
  outside = SKJS.TType::inter(subst, tenv, number, string);
  SKTest.expectEq(true, outside.isBottom());
}

@test
fun testRecursiveQueryInCloneSurvivesRollback(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  number = observationNumber();
  string = observationString();
  assumed = tenv with {
    seenSub => SortedSet[(subst.inferenceVersion(), number, string)],
  };
  stamp = subst.typeQueryReadStamp();
  scratch = subst.clone();
  saved = scratch.save();
  _ = SKJS.TType::isSub(scratch, assumed, number, string);
  scratch.restore(saved);
  SKTest.expectEq(false, subst.canCacheTypeQuerySince(stamp));
  // Only computations that consumed the conditional answer are excluded.
  fresh = subst.typeQueryReadStamp();
  SKTest.expectEq(true, subst.canCacheTypeQuerySince(fresh));
}

// Protocol test: a descendant cannot publish its ancestor's premise, while a
// successful enclosing computation can discharge the premise it introduced.
@test
fun testCompletedRecursiveQueryDischargesOwnPremise(): void {
  subst = observationSubst();
  premise = SKJS.TQSubtype(
    subst.inferenceVersion(),
    observationNumber(),
    observationString(),
  );
  independent = subst.withTypeQuery(() -> {
    stamp = subst.typeQueryReadStamp();
    subst.introduceTypeQueryAssumption(premise);
    nested = subst.withTypeQuery(() -> {
      childStamp = subst.typeQueryReadStamp();
      subst.recordRecursiveTypeQuery(premise);
      (subst.canCacheTypeQuerySince(childStamp), true)
    });
    SKTest.expectEq(false, nested);
    (subst.canCacheTypeQuerySince(stamp), true)
  });
  SKTest.expectEq(true, independent);
}

@test
fun testAbandonedRecursiveQueryDoesNotDischargePremise(): void {
  subst = observationSubst();
  premise = SKJS.TQSubtype(
    subst.inferenceVersion(),
    observationNumber(),
    observationString(),
  );
  stamp = subst.typeQueryReadStamp();
  caught = false;
  try {
    _ = subst.withTypeQuery<Bool>(() -> {
      subst.introduceTypeQueryAssumption(premise);
      subst.recordRecursiveTypeQuery(premise);
      throw ObservationTestFailure()
    })
  } catch {
  | ObservationTestFailure() -> !caught = true
  | exn -> throw exn
  };
  SKTest.expectEq(true, caught);
  SKTest.expectEq(false, subst.canCacheTypeQuerySince(stamp));
  // A fresh computation still has no dependency on that abandoned attempt.
  fresh = subst.typeQueryReadStamp();
  SKTest.expectEq(true, subst.canCacheTypeQuerySince(fresh));
}

@test
fun testQueryMutationInsideClone(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  tv = subst.gen(SKJS.PosRange::none);
  subst.grow(tenv, tv, observationNumber(), SKJS.Contravariant());
  stamp = subst.typeMutationStamp();
  scratch = subst.clone();
  _ = scratch.get(tenv, tv, SKJS.Covariant());
  SKTest.expectEq(true, scratch.isClosed(tv));
  SKTest.expectEq(true, subst.isOpen(tv));
  // The shared stamp sees the clone's commitment without changing the owner.
  SKTest.expectEq(false, subst.typeMutationStamp() == stamp);
}

@test
fun testQueryMutationUndoneByRollback(): void {
  subst = observationSubst();
  saved = subst.save();
  stamp = subst.typeMutationStamp();
  _ = subst.gen(SKJS.PosRange::none);
  subst.restore(saved);
  // Returning to the old version does not mean the query made no changes.
  SKTest.expectEq(false, subst.typeMutationStamp() == stamp);
}

@test
fun testQueryCacheOnlyRestore(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  saved = subst.save();
  stamp = subst.typeMutationStamp();
  _ = SKJS.TType::isSub(
    subst,
    tenv,
    observationNumber(),
    SKJS.TType::top(SKJS.PosRange::none),
  );
  SKTest.expectEq(false, subst.seenSub.isEmpty());
  subst.restore(saved);
  SKTest.expectEq(true, subst.seenSub.isEmpty());
  SKTest.expectEq(true, subst.typeMutationStamp() == stamp);
}

fun substituteNumberConstraint(
  subst: mutable SKJS.Subst,
  tenv: SKJS.TEnv,
  candidate: SKJS.TVar,
): SKJS.TType {
  pos = SKJS.PosRange::none;
  parameter = SKJS.TParamWithConstraint(
    "T",
    SKJS.FPath::nil,
    SKJS.Id::createSynthetic("substitution-test-T"),
    Some(observationNumber()),
  );
  original = SKJS.TType::fromTParamWithConstraint(subst, tenv, pos, parameter);
  original.mapTParams(subst, tenv, _ -> Some(SKJS.TType::var(candidate)))
}

@test
fun testFrozenSubstitutionRetainsSatisfiedConstraint(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  tv = subst.gen(SKJS.PosRange::none);
  subst.grow(tenv, tv, observationNumber(), SKJS.Contravariant());
  subst.!freezeCandidates = true;
  mapped = substituteNumberConstraint(subst, tenv, tv);
  subst.!freezeCandidates = false;
  SKTest.expectEq(true, subst.isOpen(tv));
  subst.grow(tenv, tv, observationString(), SKJS.Contravariant());
  // The retained intersection must still exclude strings after growth.
  result = SKJS.TType::isSub(subst, tenv, mapped, observationNumber());
  SKTest.expectEq(true, result is SKJS.STOk());
}

@test
fun testFrozenSubstitutionRetainsDisjointConstraint(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  tv = subst.gen(SKJS.PosRange::none);
  subst.grow(tenv, tv, observationString(), SKJS.Contravariant());
  subst.!freezeCandidates = true;
  mapped = substituteNumberConstraint(subst, tenv, tv);
  subst.!freezeCandidates = false;
  SKTest.expectEq(true, subst.isOpen(tv));
  subst.grow(tenv, tv, observationNumber(), SKJS.Contravariant());
  // A currently disjoint intersection must admit number after growth.
  result = SKJS.TType::isSub(subst, tenv, observationNumber(), mapped);
  SKTest.expectEq(true, result is SKJS.STOk());
}

@test
fun testFrozenSubstitutionCanSimplifyClosedCandidate(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  tv = subst.gen(SKJS.PosRange::none);
  subst.grow(tenv, tv, observationNumber(), SKJS.Covariant());
  subst.!freezeCandidates = true;
  mapped = substituteNumberConstraint(subst, tenv, tv);
  subst.!freezeCandidates = false;
  SKTest.expectEq(true, subst.isClosed(tv));
  SKTest.expectEq(Some(tv), mapped.getSingleVar());
}

// Restoring a computation mode cannot discharge a provisional read.
@test
fun testFrozenReadDependencySurvivesModeExit(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  inner = subst.gen(SKJS.PosRange::none);
  outer = subst.gen(SKJS.PosRange::none);
  subst.grow(tenv, inner, observationNumber(), SKJS.Contravariant());
  subst.grow(tenv, outer, SKJS.TType::var(inner), SKJS.Covariant());
  stamp = subst.typeQueryReadStamp();
  subst.!freezeCandidates = true;
  result = SKJS.TType::isSub(
    subst,
    tenv,
    SKJS.TType::var(outer),
    observationNumber(),
  );
  subst.!freezeCandidates = false;
  SKTest.expectEq(true, result is SKJS.STOk());
  SKTest.expectEq(true, subst.isClosed(outer));
  SKTest.expectEq(true, subst.isOpen(inner));
  // Ending the frozen scope cannot establish the provisional answer.
  SKTest.expectEq(false, subst.canCacheTypeQuerySince(stamp));
  subst.grow(tenv, inner, observationString(), SKJS.Contravariant());
  later = SKJS.TType::isSub(
    subst,
    tenv,
    SKJS.TType::var(outer),
    observationNumber(),
  );
  SKTest.expectEq(false, later is SKJS.STOk());
}

@test
fun testFrozenCloneDependencySurvivesModeExitAndRestore(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  tv = subst.gen(SKJS.PosRange::none);
  subst.grow(tenv, tv, observationNumber(), SKJS.Contravariant());
  saved = subst.save();
  stamp = subst.typeQueryReadStamp();
  scratch = subst.clone();
  scratch.!freezeCandidates = true;
  _ = scratch.get(tenv, tv, SKJS.Covariant());
  scratch.!freezeCandidates = false;
  subst.restore(saved);
  // Neither scratch disposal nor rollback establishes its provisional read.
  SKTest.expectEq(false, subst.canCacheTypeQuerySince(stamp));
  fresh = subst.typeQueryReadStamp();
  _ = SKJS.TType::isSub(
    subst,
    tenv,
    observationNumber(),
    SKJS.TType::top(SKJS.PosRange::none),
  );
  SKTest.expectEq(true, subst.canCacheTypeQuerySince(fresh));
}

@test
fun testObservedSubtypeDecisionDoesNotProposeGrowth(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  pos = SKJS.PosRange::none;
  target = subst.gen(pos);
  subst.grow(tenv, target, observationNumber(), SKJS.Contravariant());
  undefined = SKJS.TType::single(SKJS.TPrimUnit(SKJS.TUndefined(), pos));
  decision = subst.withCommittedTypeDecision<Bool>(scratch ->
    SKJS.TType::isSub(
      scratch,
      tenv.forTypeReadObservation(),
      undefined,
      SKJS.TType::var(target),
    ) is SKJS.STOk()
  );
  // A false result commits the numeric read without proposing undefined.
  SKTest.expectEq(true, decision is SKJS.TRReady(false));
  SKTest.expectEq(true, subst.isClosed(target));
}

// A callback may capture its handle, but it must not learn further candidate
// shapes after publication or after an exception has abandoned the read set.
@test
fun testReadContextExpiresOnEveryExit(): void {
  for (fail in Array[false, true]) {
    subst = observationSubst();
    tenv = observationTypeEnv(subst);
    inspected = subst.gen(SKJS.PosRange::none);
    later = subst.gen(SKJS.PosRange::none);
    observationBind(subst, inspected, observationNumber(), false);
    observationBind(subst, later, observationString(), false);
    escaped = SKJS.SubstReadCell::mcreate();
    copied = SKJS.SubstReadCell::mcreate();
    failed = false;
    try {
      _ = subst.withCommittedReadContext<SKJS.TType>(tenv, context -> {
        escaped.!value = Some(context);
        copied.!value = Some(context with {});
        result = context.peekRaw(inspected);
        if (fail) {
          throw ObservationTestFailure()
        } else {
          result
        }
      })
    } catch {
    | ObservationTestFailure() -> !failed = true
    | exn -> throw exn
    };
    SKTest.expectEq(fail, failed);
    SKTest.expectEq(!fail, subst.isClosed(inspected));
    blocked = false;
    try {
      _ = escaped.value.fromSome().peekRaw(later)
    } catch {
    | InvariantViolation(_) -> !blocked = true
    | exn -> throw exn
    };
    SKTest.expectEq(true, blocked);
    SKTest.expectEq(true, subst.isOpen(later));
    copyBlocked = false;
    try {
      _ = copied.value.fromSome().peekRaw(later)
    } catch {
    | InvariantViolation(_) -> !copyBlocked = true
    | exn -> throw exn
    };
    SKTest.expectEq(true, copyBlocked);
  }
}

@test
fun testObservedLiteralRequiresCurrentSelection(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  file = SKJS.FPath::create(
    SKJS.RootId::project,
    "tests/expect-error/type-query-memo-stability.ts",
  );
  lexer = SKJS.Lexer::mcreate(file, "");
  pos = SKJS.PosRange::create(lexer, SKJS.Pos(0), SKJS.Pos(0));
  selector = SKJS.ArrayLiteralSelector::create(subst, pos);
  literal = SKJS.TType::arrayLit(
    selector,
    Array[observationNumber()],
    Array[None()],
  );
  saved = subst.save();
  read = () ->
    subst.withCommittedReadDecision(tenv, context ->
      context.spreadTuple(literal)
    );
  SKTest.expectEq(true, read() is SKJS.TRBlocked _);
  SKTest.expectEq(None(), selector.peek(subst, tenv));
  selector.commit(
    subst,
    tenv,
    SKJS.TType::tuple(pos, Array[observationNumber()], false),
  );
  result = read();
  SKTest.expectEq(
    true,
    result match {
    | SKJS.TRReady(Some(elements)) -> elements == Array[observationNumber()]
    | _ -> false
    },
  );
  subst.restore(saved);
  // A successful read of the previous selection cannot survive rollback.
  SKTest.expectEq(true, read() is SKJS.TRBlocked _);
  SKTest.expectEq(None(), selector.peek(subst, tenv));
}

// Elimination publishes a lasting fact; keeping an alternative does not.
@test
fun testAlternativePruningCommitsOnlyElimination(): void {
  check = (
    bound: ?SKJS.TType,
    optional: Bool,
    frozenCandidates: Bool,
    eliminate: Bool,
  ) -> {
    subst = observationSubst();
    tenv = observationTypeEnv(subst);
    pos = SKJS.PosRange::none;
    candidate = subst.gen(pos);
    bound.each(ty -> observationBind(subst, candidate, ty, false));
    objectType = (ty: SKJS.TType, isOptional: Bool) -> {
      field = constructionField(ty) with {isOptional};
      fields = SKJS.TFields::createFromSorted{
        fields => SortedMap[].set(field.name, field),
      };
      SKJS.TType::single(SKJS.TObject::createSingleBranch(fields, None(), pos))
    };
    current = objectType(SKJS.TType::var(candidate), optional);
    contract = objectType(observationString(), false);
    subst.!freezeCandidates = frozenCandidates;
    result = current.withStableContents(subst, tenv, contract, true);
    SKTest.expectEq(eliminate, result.isBottom());
    if (!eliminate) {
      SKTest.expectEq(contract, result)
    };
    SKTest.expectEq(eliminate, subst.isClosed(candidate));
    SKTest.expectEq(bound, subst.peekRaw(candidate));
  };
  check(Some(observationNumber()), false, false, true);
  check(Some(observationString()), false, false, false);
  // Optional fields do not prove separation, even with an unknown payload.
  check(None(), true, false, false);
  // Neither an unresolved payload nor a frozen open candidate permits pruning.
  check(None(), false, false, false);
  check(Some(observationNumber()), false, true, false);
}

@test
fun testIteratorProjectionTracksIntermediateShapes(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  file = SKJS.FPath::create(
    SKJS.RootId::project,
    "tests/expect-error/type-query-memo-stability.ts",
  );
  lexer = SKJS.Lexer::mcreate(file, "");
  pos = SKJS.PosRange::create(lexer, SKJS.Pos(0), SKJS.Pos(0));
  symbolId = tenv.getSymbolIteratorUniqueId(subst, pos).fromSome();
  object = (name: String, ty: SKJS.TType, symbol: Bool) -> {
    field = constructionField(ty) with {name => SKJS.FieldNameString(name)};
    fields = SortedMap[].set(field.name, field);
    shape = if (symbol) {
      SKJS.TFields::createFromSorted{symbolFields => fields}
    } else {
      SKJS.TFields::createFromSorted{fields}
    };
    SKJS.TType::single(SKJS.TObject::createSingleBranch(shape, None(), pos))
  };
  callable = (result: SKJS.TType) ->
    SKJS.TType::single(
      SKJS.TObject::createCall(
        SKJS.TFuns::singleFun(
          SKJS.TFun(
            Array[],
            SKJS.NoThis(),
            Array[],
            Array[],
            None(),
            result,
            SKJS.CGNodes(SortedSet[]),
          ),
          pos,
        ),
      ),
    );
  element = subst.gen(pos);
  nextResult = subst.gen(pos);
  nextMethod = subst.gen(pos);
  iterator = subst.gen(pos);
  method = subst.gen(pos);
  observationBind(
    subst,
    nextMethod,
    callable(SKJS.TType::var(nextResult)),
    false,
  );
  observationBind(
    subst,
    iterator,
    object("next", SKJS.TType::var(nextMethod), false),
    false,
  );
  observationBind(subst, method, callable(SKJS.TType::var(iterator)), false);
  source = object(symbolId, SKJS.TType::var(method), true);
  read = () ->
    subst.withCommittedReadContext(tenv, context ->
      context.restElement(source, SKJS.Covariant())
    );
  // Partial traversal must not publish the reads before an unknown result shape.
  SKTest.expectEq(true, read() is SKJS.TRBlocked _);
  for (candidate in Array[method, iterator, nextMethod]) {
    SKTest.expectEq(true, subst.isOpen(candidate))
  };
  observationBind(
    subst,
    nextResult,
    object("value", SKJS.TType::var(element), false),
    false,
  );
  SKTest.expectEq(
    true,
    read() match {
    | SKJS.TRReady(ty) -> ty == SKJS.TType::var(element)
    | _ -> false
    },
  );
  for (candidate in Array[method, iterator, nextMethod, nextResult]) {
    SKTest.expectEq(true, subst.isClosed(candidate))
  };
  // The element is returned symbolically; discovering the protocol did not read it.
  SKTest.expectEq(true, subst.isUnbound(element));
}

@test
fun testObservedCallbackSubtypeCommitsAtomically(): void {
  subst = observationSubst();
  tenv = observationTypeEnv(subst);
  pos = SKJS.PosRange::none;
  input = subst.gen(pos);
  output = subst.gen(pos);
  observationBind(subst, input, observationNumber(), false);
  callback = (arg, result) ->
    SKJS.TType::single(
      SKJS.TObject::createCall(
        SKJS.TFuns::singleFun(
          SKJS.TFun(
            Array[],
            SKJS.NoThis(),
            Array[arg],
            Array[],
            None(),
            result,
            SKJS.CGNodes(SortedSet[]),
          ),
          pos,
        ),
      ),
    );
  source = callback(observationNumber(), SKJS.TType::var(output));
  target = callback(SKJS.TType::var(input), observationString());
  check = () ->
    subst.withCommittedReadDecision<Bool>(tenv, context ->
      context.isSubtype(source, target)
    );
  // The contravariant input is read before the unresolved covariant output.
  // A blocked comparison must not publish its earlier successful read.
  SKTest.expectEq(true, check() is SKJS.TRBlocked());
  SKTest.expectEq(false, subst.snapshot().isClosed(input));
  observationBind(subst, output, observationString(), false);
  check() match {
  | SKJS.TRReady(value) -> SKTest.expectEq(true, value)
  | _ -> SKTest.expectEq(true, false)
  };
  SKTest.expectEq(true, subst.snapshot().isClosed(input));
  SKTest.expectEq(true, subst.snapshot().isClosed(output));
}

module end;
