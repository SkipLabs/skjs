{"name": "skjs", "target": "arm64-apple-darwin24.4.0", "hash": "1654144608487979699", "pkg_dir": "/Users/cristianocalcagno/GitHub/skjs", "sources": [{"path": "src/ArraySet.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Generic operations on sorted set represented with sorted arrays. */\n/***************************************************************************/\n\nmodule ArraySet;\n\n// see iterDiffInterDiff\nprivate mutable class DiffInterDiffIterator<T: Orderable> private (\n  private mutable head1: ?T,\n  private tail1: mutable Iterator<T>,\n  private mutable head2: ?T,\n  private tail2: mutable Iterator<T>,\n) extends Iterator<(?T, ?T)> {\n  static fun create(\n    iter1: mutable Iterator<T>,\n    iter2: mutable Iterator<T>,\n  ): mutable Iterator<(?T, ?T)> {\n    head1 = iter1.next();\n    head2 = iter2.next();\n    mutable static(head1, iter1, head2, iter2)\n  }\n\n  readonly fun sizeHint(): ?Int {\n    size1 = this.tail1.sizeHint().map((n) ->\n      if (this.head1.isSome()) n + 1 else n\n    );\n    size2 = this.tail2.sizeHint().map((n) ->\n      if (this.head2.isSome()) n + 1 else n\n    );\n    (size1, size2) match {\n    | (Some(m), Some(n)) ->\n      Some(m + n) // actual size will be between max and sum of sizes\n    | (Some(n), None())\n    | (None(), Some(n)) ->\n      Some(n)\n    | (None(), None()) -> None()\n    }\n  }\n\n  mutable fun next(): ?(?T, ?T) {\n    none: ?T = None();\n    go = (x, y) -> {\n      if (x.isSome()) this.!head1 = this.tail1.next();\n      if (y.isSome()) this.!head2 = this.tail2.next();\n      Some((x, y))\n    };\n    (this.head1, this.head2) match {\n    | (None(), None()) -> None()\n    | (None(), Some(_)) -> go(none, this.head2)\n    | (Some(_), None()) -> go(this.head1, none)\n    | (Some(x), Some(y)) ->\n      x.compare(y) match {\n      | LT() -> go(this.head1, none)\n      | EQ() -> go(this.head1, this.head2)\n      | GT() -> go(none, this.head2)\n      }\n    }\n  }\n}\n\n// A set of orderable elements backed by a sorted array.\nclass .ArraySet<T: Orderable> private (\n  private inner: Vector<T>,\n) uses Orderable, XXHashable[T: XXHashable] {\n  static fun empty(): this {\n    static(Vector[])\n  }\n\n  fun size(): Int {\n    this.inner.size()\n  }\n\n  private static fun create<T: Orderable>(\n    size: Int,\n    init: (T -> void) -> void,\n  ): ArraySet<T> {\n    // create by allocating, initializing via calling push, and checking\n    inner = Vector::mcreate(size);\n    init(inner.push);\n    // inner must be strictly increasing\n    assert(\n      {\n        prev: ?T = None();\n        for (curr in inner) {\n          prev match {\n          | Some(p) ->\n            if (p >= curr) {\n              internal_error(\"ArraySet::create\")\n            }\n          | None() -> void\n          };\n          !prev = Some(curr);\n        };\n        true\n      },\n    );\n    ArraySet(unsafe_chill_trust_me(inner))\n  }\n\n  static fun createFromIterator<T: Orderable, I: mutable Iterator<T>>(\n    items: I,\n  ): ArraySet<T> {\n    static::create(items.sizeHint().default(0), items.each)\n  }\n\n  static fun single(x: T): this {\n    static(Vector[x])\n  }\n\n  fun isEmpty(): Bool {\n    this.inner.isEmpty()\n  }\n\n  fun toArray(): Array<T> {\n    this.inner.toArray()\n  }\n\n  fun values(): mutable Iterator<T> {\n    this.inner.values()\n  }\n\n  fun items(): mutable Iterator<(Int, T)> {\n    this.inner.items()\n  }\n\n  fun filter(f: T -> Bool): this {\n    static(this.inner.filter(f))\n  }\n\n  fun map<U: Orderable>(f: T -> U): ArraySet<U> {\n    // use a SortedSet to sort and dedup since callers of map do not\n    // guarantee that f is monotone\n    static::createFromIterator(this.values().map(f).collect(SortedSet).values())\n  }\n\n  // s.iterDiffInterDiff(t) contains (Some(x), None()) for every element in\n  // s but not t, (None(), Some(y)) for every y in t but not s, and\n  // (Some(x), Some(y)) for every pair of elements that are in both s and t.\n  fun iterDiffInterDiff(that: this): mutable Iterator<(?T, ?T)> {\n    DiffInterDiffIterator::create(this.inner.values(), that.inner.values())\n  }\n\n  fun iterDiff(that: this): mutable Iterator<T> {\n    this.iterDiffInterDiff(that).filterMap((xO_yO) ->\n      xO_yO match {\n      | (xO @ Some(_), None()) -> xO\n      | _ -> None()\n      }\n    )\n  }\n\n  fun contains(that: this): Bool {\n    !this.iterDiffInterDiff(that).any((xO_yO) -> xO_yO is (None(), Some(_)))\n  }\n\n  fun iterUnion(that: this): mutable Iterator<T> {\n    this.iterDiffInterDiff(that).map((xO_yO) ->\n      xO_yO match {\n      | (Some(x), _)\n      | (None(), Some(x)) ->\n        x\n      | (None(), None()) -> internal_error(\"ArraySet.union\")\n      }\n    )\n  }\n\n  fun union(that: this): this {\n    static::createFromIterator(this.iterUnion(that))\n  }\n}\n\nmodule end;\n\nmodule SKJS;\n\nprivate fun mapUnion<T, Key: Orderable>(\n  iter1: mutable Iterator<T>,\n  iter2: mutable Iterator<T>,\n  proj: T ~> Key,\n  missing: T -> T,\n  union: (T, T) -> T,\n): Array<T> {\n  result = mutable Vector[];\n  head1 = iter1.next();\n  head2 = iter2.next();\n  loop {\n    (head1, head2) match {\n    | (None(), None()) -> break void\n    | (None(), Some(y)) ->\n      result.push(missing(y));\n      !head2 = iter2.next()\n    | (Some(x), None()) ->\n      result.push(missing(x));\n      !head1 = iter1.next()\n    | (Some(x), Some(y)) if (proj(x) < proj(y)) ->\n      result.push(missing(x));\n      !head1 = iter1.next()\n    | (Some(x), Some(y)) if (proj(x) > proj(y)) ->\n      result.push(missing(y));\n      !head2 = iter2.next()\n    | (Some(x), Some(y)) ->\n      result.push(union(x, y));\n      !head1 = iter1.next();\n      !head2 = iter2.next()\n    }\n  };\n  result.toArray()\n}\n\nprivate fun mapInter<T, Key: Orderable>(\n  iter1: mutable Iterator<T>,\n  iter2: mutable Iterator<T>,\n  proj: T ~> Key,\n  inter: (T, T) -> T,\n): (Array<T>, Array<T>, Array<T>) {\n  noMatch1 = mutable Vector[];\n  noMatch2 = mutable Vector[];\n  present = mutable Vector[];\n  head1 = iter1.next();\n  head2 = iter2.next();\n  loop {\n    (head1, head2) match {\n    | (None(), None()) -> break void\n    | (None(), Some(y)) ->\n      noMatch2.push(y);\n      !head2 = iter2.next()\n    | (Some(x), None()) ->\n      noMatch1.push(x);\n      !head1 = iter1.next()\n    | (Some(x), Some(y)) if (proj(x) < proj(y)) ->\n      noMatch1.push(x);\n      !head1 = iter1.next()\n    | (Some(x), Some(y)) if (proj(x) > proj(y)) ->\n      noMatch2.push(y);\n      !head2 = iter2.next()\n    | (Some(x), Some(y)) ->\n      present.push(inter(x, y));\n      !head1 = iter1.next();\n      !head2 = iter2.next()\n    }\n  };\n  (noMatch1.toArray(), noMatch2.toArray(), present.toArray())\n}\n\nclass ArrayValues private (\n  values: Array<(PosRange, String)>,\n) uses XXHashable, Orderable, Show {\n  // Invariant: values is not empty and is sorted by x ~> x.i1\n\n  static fun single(elt: (PosRange, String)): this {\n    static(Array[elt])\n  }\n\n  static fun ofSet(set: SortedSet<String>, pos: PosRange): ?this {\n    if (set.isEmpty()) None() else {\n      Some(static(set.toArray().map(s -> (pos, s))))\n    }\n  }\n\n  fun hash(): Int {\n    // Custom hash that excludes positions, only hashes the strings\n    this.values.map(x -> x.i1).hash()\n  }\n\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    // Custom xxhash that excludes positions, only hashes the strings\n    result = 0;\n    for (i in Range(0, this.values.size())) {\n      !result = XXHash64.xxHash64(\n        result,\n        this.values[i].i1.xxhash(ignorePos).value,\n      );\n    };\n    XXHash(result)\n  }\n\n  fun size(): Int {\n    this.values.size()\n  }\n\n  fun singleElt(): ?(PosRange, String) {\n    if (this.values.size() == 1) Some(this.values[0]) else None()\n  }\n\n  fun filter(f: ((PosRange, String)) -> Bool): ?this {\n    values = this.values.filter(f);\n    if (values.isEmpty()) None() else Some(static(values))\n  }\n\n  fun union(other: ArrayValues): ArrayValues {\n    ArrayValues(\n      mapUnion(\n        this.values.iterator(),\n        other.values.iterator(),\n        x ~> x.i1,\n        x ~> x,\n        (x, _) ~> x,\n      ),\n    )\n  }\n\n  fun inter(other: this): ?this {\n    (_noMatches1, _notMatches2, result) = mapInter(\n      this.values.iterator(),\n      other.values.iterator(),\n      x ~> x.i1,\n      (x, _) ~> x,\n    );\n    if (result.isEmpty()) None() else Some(static(result))\n  }\n\n  fun toStringList(): String {\n    this.values.map(x -> x.i1).join(\" | \")\n  }\n\n  fun toString(): String {\n    inspect(this).toString()\n  }\n\n  fun contains(x: String): Bool {\n    idx = SKStore.binSearch(\n      i ~> this.values[i].i1,\n      x,\n      0,\n      this.values.size() - 1,\n    );\n    if (idx < 0 || idx >= this.values.size()) return false;\n    this.values[idx].i1 == x\n  }\n}\n\nmodule end;\n"}, {"path": "src/Ast.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// The abstract syntax tree.\n\n// This abstract syntax tree contains constructions that we don't want\n// to support (such as namespaces). But identifying those constructions\n// could still be useful to provide a good error messages.\n/***************************************************************************/\n\nmodule SKJS;\n\n/***************************************************************************/\n// <name> ::= <string>\n/***************************************************************************/\n\nvalue class Name(pos: PosRange, value: String) uses XXHashable, Orderable {\n  fun hash(): Int {\n    // Custom hash that excludes position\n    this.value.hash()\n  }\n\n  fun toString(): String {\n    this.value\n  }\n}\n\n/***************************************************************************/\n// <def> ::=\n//   | <expr>\n//   | type <name> [ <type-param>* ] <type>\n//   | class\n//   | enum <name> { (<name> = <expr>?)* }\n//   | namespace <name> { <def>* }\n//   | module <name> { <def>* }\n//   | export (type? <module-names> from <expr>?)\n//   | export (type? default?) <def>\n//   | export default (type?) <expr>\n//   | export = <expr>\n//   | export as <name>\n//   | export import <name> = <expr>\n//   | global { <def>* }\n//   | import (type?) <module-names> <import-name> (from <import-kind>)\n//   | import <name>\n//   | declare <def>\n//   | <var-def-kind> { <var-def>* }\n/***************************************************************************/\n\nclass Def(pos: PosRange, value: Def_) uses XXHashable\n\nbase class Def_ uses XXHashable {\n  children =\n  | ToplevelExpr(Expr)\n  | TypeDef{name: Name, tdefParams: Array<TypeParam>, body: Type}\n  | Class{\n    kind: ClassKind,\n    name: Name,\n    extends_: Array<Type>,\n    implements: Array<Type>,\n    tparams: Array<TypeParam>,\n    fields: Array<FieldType>,\n  }\n  | Enum(isConst: ?PosRange, name: Name, fields: Array<(Name, ?Expr)>)\n  | Namespace(name: Name, Array<Def>)\n  | Module(name: Name, ?Array<Def>)\n  | ExportNames(isType: ?PosRange, ModuleNames, maybeFrom: ?Expr)\n  | Export(isType: ?PosRange, default: ?PosRange, def: Def_)\n  | ExportDefault(isType: ?PosRange, name: Expr)\n  | ExportEq(e: Expr)\n  | ExportAs(name: Name)\n  | ExportImport(name: Name, expr: Expr)\n  | Global(Array<Def>)\n  | Import(\n    kind: ImportKind,\n    isType: ?PosRange,\n    ModuleNames,\n    importFrom: ImportName,\n  )\n  | ImportExpr(Name)\n  | Declare(Def)\n  | VarDefs(kind: VarDefKind, varDefs: Array<VarDef>)\n}\n\nbase class ImportName uses XXHashable {\n  children =\n  | INPath(Name)\n  | INName(Name)\n}\n\n/***************************************************************************/\n// <var-def> ::= <pattern> (: <type>)? (= <expr>)?\n/***************************************************************************/\n\nclass VarDef(pat: Pattern, type: ?Type, value: ?Expr) uses XXHashable\n\n/***************************************************************************/\n// <pattern> ::=\n//   | <name>\n//   | <pattern> ::= [ <pattern>* ]\n//   | <pattern> ::= { (<name> : <pattern> (= <expr>)?)*, (...<name>)? }\n/***************************************************************************/\n\nclass Pattern(pos: PosRange, value: Pattern_) uses XXHashable\n\nbase class Pattern_ uses XXHashable {\n  children =\n  | PVar(Name)\n  | PArray(Array<Pattern>)\n  | PObject{fields: Array<(Name, Pattern, ?Expr)>, rest: ?Name}\n}\n\n/***************************************************************************/\n// <fun-def> ::=\n//   (async?) <modifiers>? (get | set?)\n//     <symbol>? [ < <type-param>* > ]? ( <param>* )\n//       (: <type>?)\n//     <fun-def-body>\n/***************************************************************************/\n\nclass FunDef{\n  pos: PosRange,\n  isAsync: ?PosRange,\n  isGetSet: ?FieldGetSet,\n  name: ?SimpleSymbol,\n  optional: ?PosRange,\n  tparams: Array<TypeParam>,\n  params: Array<Param>,\n  retType: (PosRange, ?(Type)),\n  body: FunDefBody,\n  cgNode: ?CGNode,\n} extends Def_, FieldType, Field uses XXHashable\n\nbase class FunDefBody uses XXHashable {\n  children =\n  | FDBNone(PosRange)\n  | FDBSome(Array<Stmt>)\n}\n\n/***************************************************************************/\n// <module-names> ::=\n//   | * (as <name>)?\n//   | { <module-def-name>* }\n//   | <name>, { <module-def-name>* }\n/***************************************************************************/\n\nbase class ModuleNames uses XXHashable {\n  children =\n  | MStar(?Name)\n  | MCurly(Array<ModuleDefName>)\n  | MName(Name, Array<ModuleDefName>)\n}\n\n/***************************************************************************/\n// <module-def-name> ::= (type?) <name> (as <name>)?\n/***************************************************************************/\n\nclass ModuleDefName(\n  isType: ?PosRange,\n  name: Name,\n  asName: ?Name,\n) uses XXHashable\n\n/***************************************************************************/\n// <type-param> ::= <name> (: <type>)? (= <type>)?\n/***************************************************************************/\n\nclass TypeParam(\n  id: Id,\n  name: Name,\n  constraint: ?Type,\n  default: ?Type,\n) uses XXHashable\n\n/***************************************************************************/\n// <param> ::= <modifiers> <param-names> (\"?\"?) (: <type>)? (= <expr>)?\n/***************************************************************************/\n\nclass Param(\n  pos: PosRange,\n  modifiers: Modifiers,\n  name: ParamNames,\n  optional: ?PosRange,\n  type: ?Type,\n  default: ?Expr,\n) uses XXHashable\n\n/***************************************************************************/\n// <param-names> ::=\n//   | ... <name>\n//   | <name>\n//   | [ <param-names>* ]\n//   | { <param-names>* }\n/***************************************************************************/\n\nbase class ParamNames uses XXHashable {\n  children =\n  | PNDDD(name: Name)\n  | PNName(name: Name)\n  | PNSquare(Array<ParamNames>)\n  | PNCurly(Array<ParamNames>)\n}\n\n/***************************************************************************/\n// <stmt_> ::=\n//   | ;\n//   | <expr>\n//   | break\n//   | return <expr>?\n//   | throw <expr>\n//   | if ( <expr> ) <stmt>* (else <stmt>*)?\n//   | for ( <stmt> in <expr> ) <stmt>*\n//   | for ( <stmt> of <expr> ) <stmt>*\n//   | for ( <stmt> ; <expr> ; <expr> ) <stmt>*\n//   | while ( <expr> ) <stmt>*\n//   | let <binding>*\n//   | var <binding>*\n//   | const <binding>*\n//   | switch ( <expr> ) { <switch-branch>* }\n//   | try { <stmt>* } (catch ( <pattern> (: <type>)? ) { <stmt>* })? (finally { <stmt>* })?\n//   | { <stmt>* }\n/***************************************************************************/\n\nclass Stmt(pos: PosRange, value: Stmt_) uses XXHashable\nbase class Stmt_ uses XXHashable {\n  children =\n  | StmtEmpty()\n  | StmtExpr(Expr)\n  | Break()\n  | Continue()\n  | Return(PosRange, ?Expr)\n  | Throw(Expr)\n  | If(Expr, Array<Stmt>, ?Array<Stmt>)\n  | ForInOf(ForInOfKind, Stmt, Expr, Array<Stmt>)\n  | For(Stmt, Expr, Expr, Array<Stmt>)\n  | While(Expr, Array<Stmt>)\n  | Bind(BindKind, Array<Binding>)\n  | Switch(Expr, Array<SwitchBranch>)\n  | Block(Array<Stmt>)\n  | Try(Array<Stmt>, ?CatchClause, ?Array<Stmt>)\n}\n\nbase class ForInOfKind uses XXHashable {\n  children =\n  | ForIn()\n  | ForOf()\n}\n\n/***************************************************************************/\n// <binding> ::= <pattern> (: <type>)? (= <expr>)?\n/***************************************************************************/\n\nclass Binding(pat: Pattern, type: ?Type, value: ?Expr) uses XXHashable\n\nbase class BindKind uses XXHashable {\n  children =\n  | BKLet()\n  | BKConst()\n  | BKVar()\n}\n\n/***************************************************************************/\n// <switch-branch> ::=\n//   | case <expr> : <stmt>*\n//   | default : <stmt>*\n/***************************************************************************/\n\nbase class SwitchBranch uses XXHashable {\n  children =\n  | Case(Expr, Array<Stmt>)\n  | Default(Array<Stmt>)\n}\n\n/***************************************************************************/\n// <catch-clause> ::= catch ( <pattern> (: <type>)? ) <stmt>*\n/***************************************************************************/\n\nclass CatchClause(\n  param: ?Pattern,\n  type: ?Type,\n  body: Array<Stmt>,\n) uses XXHashable\n\n/***************************************************************************/\n// <expr> ::=\n//   | <string-number>\n//   | <name>\n//   | ... <name>\n//   | <string-kind> <string>\n//   | typeof <expr>\n//   | keyof <type>\n//   | await <expr>\n//   | <expr> [ <expr> ]\n//   | new <name> ( <type>* ) ( <expr>* )\n//   | <unop> <expr>\n//   | <expr> <post-op>\n//   | <expr> <binop> <expr>\n//   | <expr> ( <type>* ) ( <expr>* )\n//   | ( (<name> (: <type>)?)* )\n//   | { <field>* }\n//   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>\n//   | [ <expr>* ]\n//   | <expr> ? <expr> : <expr>\n//   | <expr> in <expr>\n//   | <expr> instanceof <expr>\n//   | <expr> as <type>\n//   | /<regexp>/\n//   | async <expr>\n/***************************************************************************/\n\nclass Expr(pos: PosRange, value: Expr_) uses XXHashable\n\nbase class Expr_ uses XXHashable {\n  children =\n  | Number(String)\n  | BigInt(String)\n  | Var(Name)\n  | Spread(Name)\n  | EString(String)\n  | TypeOf(Expr)\n  | Await(Expr)\n  | Get(Expr, Expr)\n  | New(Name, Array<Type>, Array<Expr>)\n  | Unop(UnaryOperator, Expr)\n  | PostOp(PostOperator, Expr)\n  | Binop(BinaryOperator, Expr, Expr)\n  | Call(Expr, Array<Type>, Array<Expr>)\n  | Params(Array<(Name, ?Type)>)\n  | Object(Array<Field>)\n  | Closure(Array<(Name, ?Type)>, ?Type, ClosureBody)\n  | EArray(Array<Expr>)\n  | EIf(Expr, Expr, Expr)\n  | In(Expr, Expr)\n  | InstanceOf(Expr, Expr)\n  | As(Expr, Type)\n  | AsConst(Expr)\n  | Regexp(String)\n  | Async(Expr)\n  | TemplateLiteral(Array<String>, Array<Expr>)\n}\n\nbase class ClosureBody uses XXHashable {\n  children =\n  | CBExpr(Expr)\n  | CBBlock(Array<Stmt>)\n}\n\n/***************************************************************************/\n// <field> ::= <name> : <expr> | ... <expr>\n/***************************************************************************/\nbase class Field uses XXHashable {\n  children =\n  | FDNormal(name: Name, expr: Expr)\n  | FDSpread(expr: Expr)\n}\n\n/***************************************************************************/\n// <post-op> ::= -- | ++ | !\n/***************************************************************************/\nbase class PostOperator uses XXHashable {\n  children =\n  | PODecr()\n  | POIncr()\n  | POExcl()\n}\n\n/***************************************************************************/\n// <symbol> ::=\n//   | <name>\n//   | [ <name> ]\n//   | [ <name> in <type> (? <type>)? (<fn-op>)? ]\n//   | [ <name> : <type> ]\n/***************************************************************************/\nbase class Symbol uses XXHashable {\n  fun getName(): String\n  | FNNormal(n)\n  | FNSymbol(n)\n  | FNIn(n, _, _, _)\n  | FNColon(n, _) ->\n    n.value\n}\n\nbase class SimpleSymbol extends Symbol {\n  children =\n  | FNNormal(Name)\n  | FNSymbol(Name)\n}\n\nbase class IndexSymbol extends Symbol {\n  children =\n  | FNIn(Name, Type, ?Type, ?FNOp)\n  | FNColon(indexName: Name, indexType: Type)\n}\n\nclass FieldGetSet(kind: FieldGetSetKind, pos: PosRange) uses XXHashable\n\n/***************************************************************************/\n// <field-type-value> ::=\n//    <field-get-set>? <modifiers> <symbol> \"?\"? : <type> = <expr>?\n/***************************************************************************/\nbase class FieldType{modifiers: Modifiers} uses XXHashable {\n  fun isStatic(): Bool {\n    this.modifiers.modifiers.any(mod -> mod is ModStatic _)\n  }\n}\n\nclass FieldTypeValue{\n  pos: PosRange,\n  setGet: ?FieldGetSet,\n  name: Symbol,\n  optional: ?PosRange,\n  type: Type,\n  value: ?Expr,\n} extends FieldType\n\n/***************************************************************************/\n// <type_> ::=\n//   | \" <string> \"\n//   | ' <string> '\n//   | ` <string> `\n//   | true | false\n//   | <number>\n//   | <bigint>\n//   | <prim-kind>\n//   | typeof <type>\n//   | <type> []\n//   | { <field-type>* }\n//   | <name> < <type>* >\n//   | <type> | <type>\n//   | <type> & <type>\n//   | [ <tuple-elt-type>* ]\n//   | function ( <ta-fun-param>* ) : <type>\n//   | <type> [ <type> ]\n//   | <type> extends <type> ? <type> : <type>\n//   | <type> extends <type>\n//   | readonly <type>\n//   | import ( <expr> , <name>? , <type>* )\n//   | infer <name>\n//   | []\n//   | keyof <type>\n//   | new <type>\n//   | abstract <type>\n//   | <type> is <type>\n//   | asserts <name>\n//   | <name> asserts <type>\n//   | unique symbol\n/***************************************************************************/\n\nclass Type(pos: PosRange, value: Type_) uses XXHashable\n\nbase class Type_ uses XXHashable {\n  children =\n  | TAStringLiteral(String)\n  | TATemplate(String)\n  | TANumLiteral(String)\n  | TABigIntLiteral(String)\n  | TAPrim(TPrimKind)\n  | TATypeOf(Type)\n  | TAArray(Type)\n  | TAObject(Array<FieldType>)\n  | TAInst(Name, Array<Type>)\n  | TAUnion(Type, Type)\n  | TAInter(Type, Type)\n  | TATuple(Array<TupleEltType>)\n  | TAFun(Bool, Array<TypeParam>, Array<TAFunParam>, Type, CGNode)\n  | TAGet(Type, Type)\n  | TAExtendsQuestion(Type, Type, Type, Type)\n  | TAExtends(Type, Type)\n  | TAReadonly(Type)\n  | TAImport(Expr, ?Name, ?Array<Type>)\n  | TAInfer(Name)\n  | TAEmptyArray()\n  | TAKeyOf(Type)\n  | TANew(Type)\n  | TAAbstract(Type)\n  | TAIs(Type, Type)\n  | TAAsserts(Name)\n  | TAAssertIs(Name, Type)\n  | TAUniqueSymbol()\n}\n\n/***************************************************************************/\n// <tuple-elt-type> ::= <name>? \"?\"? <type> | ... <name> <type>\n/***************************************************************************/\n\nbase class TupleEltType uses XXHashable {\n  children =\n  | TEType(name: ?Name, optional: ?PosRange, Type)\n  | TESpread(name: ?Name, Type)\n}\n\n/***************************************************************************/\n// <ta-fun-param> ::= <ta-param-names> \"?\"? : <type>\n/***************************************************************************/\n\nclass TAFunParam(\n  name: ?TAParamNames,\n  optional: ?PosRange,\n  type: Type,\n) uses XXHashable\n\n/***************************************************************************/\n// <ta-param-names> ::=\n//   | <name>\n//   | ... <name>\n//   | { <curly-name>* } (as <name>)?\n/***************************************************************************/\n\nbase class TAParamNames uses XXHashable {\n  children =\n  | TAParamName(Name)\n  | TAParamSpread(Name)\n  | TACurlyNames(Array<CurlyName>, ?Name)\n}\n\n/***************************************************************************/\n// <curly-name> ::= <name> (: <type>)?\n/***************************************************************************/\n\nclass CurlyName(name: Name, type: ?Type) uses XXHashable\n\n/***************************************************************************/\n// Modifiers\n/***************************************************************************/\n\nbase class Modifier final (pos: PosRange) uses XXHashable {\n  children =\n  | ModAbstract\n  | ModAsync\n  | ModPrivate\n  | ModProtected\n  | ModPublic\n  | ModReadonly\n  | ModStatic\n\n  fun toString(): String\n  | ModAbstract _ -> \"abstract\"\n  | ModAsync _ -> \"async\"\n  | ModPrivate _ -> \"private\"\n  | ModProtected _ -> \"protected\"\n  | ModPublic _ -> \"public\"\n  | ModReadonly _ -> \"readonly\"\n  | ModStatic _ -> \"static\"\n}\n\nclass Modifiers(\n  isRemove: ?PosRange,\n  modifiers: Array<Modifier>,\n) uses XXHashable {\n  static fun empty(): this {\n    Modifiers(None(), Array[])\n  }\n}\n\n/***************************************************************************/\n/* Enums */\n/***************************************************************************/\n\nbase class VarDefKind uses XXHashable {\n  children =\n  | VDKConst()\n  | VDKVar()\n  | VDKLet()\n}\n\nbase class TPrimKind uses XXHashable {\n  children =\n  | TPKNull()\n  | TPKBool()\n  | TPKNum()\n  | TPKString()\n  | TPKBigInt()\n}\n\nbase class FieldGetSetKind uses XXHashable {\n  children =\n  | FGet()\n  | FSet()\n}\n\nbase class ImportKind uses XXHashable {\n  children =\n  | IKFrom()\n  | IKEq()\n}\n\nbase class ClassKind uses XXHashable, Orderable {\n  children =\n  | CKInterface()\n  | CKClass()\n  | CKAbstract()\n}\n\nbase class FNOp uses XXHashable {\n  children =\n  | FNQuestion(PosRange)\n  | FNRemove(PosRange)\n  | FNAdd(PosRange)\n}\n\nbase class UnaryOperator uses XXHashable {\n  children =\n  | UOExclamationMark()\n  | UOTild()\n  | UOMinus()\n}\n\nbase class AssignableBinaryOperator extends BinaryOperator uses XXHashable {\n  children =\n  | BOMultiplication()\n  | BODivision()\n  | BORemainder()\n  | BOAddition()\n  | BOSubtraction()\n  | BOLeftShift()\n  | BOSignedRightShift()\n  | BOZeroFilledRightShift()\n  | BOBitwiseAnd()\n  | BOBitwiseXor()\n  | BOBitwiseOr()\n  | BOLogicalAnd()\n  | BOLogicalOr()\n  | BONullishCoalescing()\n}\n\nbase class BinaryOperator uses XXHashable {\n  children =\n  | BODot()\n  | BOOptionalDot()\n  | BOExclamationMarkDot()\n  | BOLessThan()\n  | BOLessThanOrEqual()\n  | BOGreaterThan()\n  | BOGreaterThanOrEqual()\n  | BOAssignment()\n  | BOOpAssignment(AssignableBinaryOperator)\n}\n\nbase class BOStrictComparison() extends BinaryOperator {\n  children =\n  | BOStrictEquality()\n  | BOStrictInequality()\n}\n\nmodule end;\n"}, {"path": "src/ClassHeriarchy.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nconst kClassHierarchyId: String = \"/skjs/class-hierarchy/\";\n\nconst kClassHierarchyDirName: SKStore.DirName = SKStore.DirName::create(\n  kClassHierarchyId,\n);\n\nclass CHNode(\n  name: String,\n  kind: ClassKind,\n  fileName: String,\n  symbol: SymbolicPos,\n) extends SKStore.File, SKStore.Key uses XXHashable\n\nclass ClassHierarchyFile(\n  classHierarchy: SortedMap<CHNode, SortedSet<CHNode>> = SortedMap[],\n) extends SKStore.File {\n  fun recordClassHierarchy(child: Class, parent: Class): this {\n    childNode = CHNode(\n      child.name.value,\n      child.kind,\n      child.name.pos.fileName,\n      child.name.pos.symbol,\n    );\n    parentNode = CHNode(\n      parent.name.value,\n      parent.kind,\n      parent.name.pos.fileName,\n      parent.name.pos.symbol,\n    );\n    current = this.classHierarchy.maybeGet(childNode).default(SortedSet[]);\n    new = current.set(parentNode);\n    ClassHierarchyFile(this.classHierarchy.set(childNode, new))\n  }\n\n  fun each(fn: (CHNode, SortedSet<CHNode>) -> void): void {\n    this.classHierarchy.each(fn)\n  }\n}\n\nfun recordClassHierarchy(\n  context: mutable SKStore.Context,\n  child: Class,\n  parent: mutable SKStore.Context -> Class,\n): void {\n  context.getGlobal(kClassHierarchyId).map(ClassHierarchyFile::type) match {\n  | Some(classHierarchy) ->\n    context.setGlobal(\n      kClassHierarchyId,\n      classHierarchy.recordClassHierarchy(child, parent(context)),\n    )\n  | _ -> void\n  }\n}\n\nfun initClassHierarchy(context: mutable SKStore.Context): void {\n  context.setGlobal(kClassHierarchyId, ClassHierarchyFile())\n}\n\nfun collectClassHierarchy(\n  context: mutable SKStore.Context,\n): ?ClassHierarchyFile {\n  classHierarchy = context\n    .getGlobal(kClassHierarchyId)\n    .map(ClassHierarchyFile::type);\n  context.removeGlobal(kClassHierarchyId);\n  classHierarchy\n}\n\nfun buildClassHierarchy(\n  context: mutable SKStore.Context,\n  checked: SKStore.EHandle<SKStore.SID, CheckResult>,\n  dirName: SKStore.DirName = kClassHierarchyDirName,\n): SKStore.EHandle<CHNode, CHNode> {\n  checked.map(\n    CHNode::keyType,\n    CHNode::type,\n    context,\n    dirName,\n    (_context, writer, _sid, res) ~> {\n      res.first.classHierarchy.each(ih ->\n        ih.each((k, v) -> writer.setArray(k, v.toArray()))\n      )\n    },\n  );\n}\n\nmodule end;\n"}, {"path": "src/Error.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Module handling all the errors. */\n/***************************************************************************/\n\n/***************************************************************************/\n/* The function that is called whenever there is an internal error. */\n/***************************************************************************/\n\n@cpp_extern(\"SKIP_print_backtrace\")\nnative fun printBacktrace(): void;\n\nfun internal_error<T>(msg: String): T {\n  printBacktrace();\n  invariant_violation(\"Internal error: \" + msg);\n}\n\nmodule SKJS;\n\n/***************************************************************************/\n/* The function that is called whenever there is a user-visible error. */\n/***************************************************************************/\n\nfun error<T>(err: Error): T {\n  throw ErrorExn(err)\n}\n\n/***************************************************************************/\n/* The exception that is thrown whenever there is an error. */\n/***************************************************************************/\n\nclass ErrorExn(error: Error) extends Exception\n\n/***************************************************************************/\n/* The class for all the errors. */\n/***************************************************************************/\n\nbase class Error uses Equality {\n  fun toString(\n    context: mutable SKStore.Context,\n    newLinesMap: NewLinesMap,\n    symbolsMap: SymbolsMap,\n  ): String;\n\n  static fun resolver(\n    fileName: String,\n    context: mutable SKStore.Context,\n    newLinesMap: NewLinesMap,\n    symbolsMap: SymbolsMap,\n  ): PositionResolver {\n    newLines = newLinesMap.get(context, fileName);\n    symbols = symbolsMap.get(context, fileName);\n    PositionResolver{fileName, newLines, symbols}\n  }\n}\n\n/***************************************************************************/\n/* Errors with a single position. */\n/***************************************************************************/\n\nbase class SinglePosError<K: ErrorKind>(\n  pos: ErrorPos,\n  errorKind: K,\n) extends Error {\n  fun toString(\n    context: mutable SKStore.Context,\n    newLinesMap: NewLinesMap,\n    symbolsMap: SymbolsMap,\n  ): String {\n    fileName = this.pos.fileName();\n    resolver = static::resolver(fileName, context, newLinesMap, symbolsMap);\n    this.pos.toString(resolver) + \"\\n\" + this.errorKind.toString()\n  }\n}\n\nclass ParsingError extends SinglePosError<ParsingKind>\nclass LexingError extends SinglePosError<LexingKind>\n\n/***************************************************************************/\n/* There are two types of positions:\n * - PosRanges: when an error has a beginning and an end\n * - Pos: when an error points at somewhere in the code (for example a lexing\n *   error)\n */\n/***************************************************************************/\n\nbase class ErrorPos uses Equality {\n  children =\n  | EPRange(PosRange)\n  | EPChar(String, Pos)\n\n  fun fileName(): String\n  | EPRange(p) -> p.fileName\n  | EPChar(fileName, _) -> fileName\n\n  fun toString(resolver: PositionResolver): String\n  | EPRange(p) -> resolver.relPosRange(p).toString()\n  | EPChar(_, p) -> resolver.relPos(p).toString()\n}\n\n/***************************************************************************/\n/* Error kinds (description of the error) */\n/***************************************************************************/\n\nbase class ErrorKind uses Equality {\n  fun toString(): String;\n}\nbase class ParsingKind extends ErrorKind\nbase class LexingKind extends ErrorKind\n\n/***************************************************************************/\n/* Lexing errors */\n/***************************************************************************/\n\nclass UnknownCharacter(char: Char) extends LexingKind {\n  fun toString(): String {\n    `Unknown character: ${this.char} (${this.char.code()})`\n  }\n}\nclass UnknownOperator(str: String) extends LexingKind {\n  fun toString(): String {\n    `Unknown operator: ${this.str}`\n  }\n}\nclass UnterminatedString() extends LexingKind {\n  fun toString(): String {\n    `Unterminated string`\n  }\n}\nclass NewLineInString() extends LexingKind {\n  fun toString(): String {\n    `New line in string`\n  }\n}\nclass UnterminatedComment() extends LexingKind {\n  fun toString(): String {\n    `Unterminated comment`\n  }\n}\n\n/***************************************************************************/\n/* Parsing errors */\n/***************************************************************************/\n\nclass UnterminatedFunDef() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated function definition`\n  }\n}\nclass UnterminatedStmt() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated statement`\n  }\n}\nclass UnterminatedDef() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated definition`\n  }\n}\nclass UnexpectedToken() extends ParsingKind {\n  fun toString(): String {\n    `Unexpected token`\n  }\n}\nclass InvalidImport() extends ParsingKind {\n  fun toString(): String {\n    `Invalid import, all imports are expected to be of the form:\nimport ... from './path_to_file.js';\n  or\nimport ... from '../path_to_file.js';`\n  }\n}\nclass UnterminatedImport() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated import`\n  }\n}\nclass UnterminatedBlock() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated block`\n  }\n}\nclass UnterminatedExpr() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated expr`\n  }\n}\nclass UnterminatedNamespace() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated namespace`\n  }\n}\nclass UnterminatedExportList() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated export`\n  }\n}\nclass ExpectedDefinition() extends ParsingKind {\n  fun toString(): String {\n    `Expected a definition`\n  }\n}\nclass UnterminatedType() extends ParsingKind {\n  fun toString(): String {\n    `Unterminated type`\n  }\n}\nclass ExpectedToken(tokenKind: TokenKind) extends ParsingKind {\n  fun toString(): String {\n    `Expected token ${this.tokenKind}`\n  }\n}\n\nclass ExpectedString() extends ParsingKind {\n  fun toString(): String {\n    `Expected a string`\n  }\n}\nclass ExpectedDeclaration() extends ParsingKind {\n  fun toString(): String {\n    `Expected a string`\n  }\n}\nclass ExpectedStringNot(str: String) extends ParsingKind {\n  fun toString(): String {\n    `Expected a string, not '${this.str}`\n  }\n}\nclass ExpectedTokenNot(tokenKind: TokenKind) extends ParsingKind {\n  fun toString(): String {\n    `Expected ${this.tokenKind}`\n  }\n}\nclass ExpectedStrNot(str: String) extends ParsingKind {\n  fun toString(): String {\n    `Expected ${this.str}`\n  }\n}\nclass ExpectedVarName() extends ParsingKind {\n  fun toString(): String {\n    `Expected a variable name`\n  }\n}\nclass InvalidClosure() extends ParsingKind {\n  fun toString(): String {\n    `Invalid closure`\n  }\n}\nclass ExpectedParams() extends ParsingKind {\n  fun toString(): String {\n    `Expected params`\n  }\n}\nclass DuplicateFieldNames(pos2: RelPos) extends ParsingKind {\n  fun toString(): String {\n    `Duplicate field name\\n${this.pos2}\\nPrevious one found here`\n  }\n}\nclass TooManyTags(pos2: RelPos) extends ParsingKind {\n  fun toString(): String {\n    `Duplicate tags\\n${this.pos2}\\nPrevious one found here`\n  }\n}\n\nclass DontUseEquality() extends ParsingKind {\n  fun toString(): String {\n    \"Don't use ==, use === instead\"\n  }\n}\n\nclass DontUseInequality() extends ParsingKind {\n  fun toString(): String {\n    \"Don't use !=, use !== instead\"\n  }\n}\n\nclass NonAssociative(op: String) extends ParsingKind {\n  fun toString(): String {\n    `The operator ${this.op} is not associative`\n  }\n}\n\nclass FunctionInExpr() extends ParsingKind {\n  fun toString(): String {\n    \"Function inside expressions are not supported, use closures instead\"\n  }\n}\n\nclass ExpectedStmt() extends ParsingKind {\n  fun toString(): String {\n    \"Expected a statement\"\n  }\n}\n\nclass ExpectedCatchOrFinally() extends ParsingKind {\n  fun toString(): String {\n    \"Expected catch or finally clause\"\n  }\n}\n\nclass MissingReturnType() extends ParsingKind {\n  fun toString(): String {\n    \"Missing return type\"\n  }\n}\n\nclass MissingParameterName() extends ParsingKind {\n  fun toString(): String {\n    \"Function parameter must have a name\"\n  }\n}\n\nclass NonDefaultAnonymousFunctionExport() extends ParsingKind {\n  fun toString(): String {\n    \"An anonymous function can be exported only if it is the default export\"\n  }\n}\n\n/***************************************************************************/\n/* Name resolution error */\n/***************************************************************************/\n\nclass NotFound(name: String) extends ParsingKind {\n  fun toString(): String {\n    `Type ${this.name} not found`\n  }\n}\n\nmodule end;\n"}, {"path": "src/FileDefs.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// Logic that resolves exports/imports in a file.\n//\n// Note that a lot of that logic is poorly tested and probably\n// wrong. We probably don't want to support most of the constructions\n// in there anyway.\n//\n// The things that we should support properly:\n// import { x, y, z } from ...;\n// export { x, y, z } from ...\n//\n// The rest is too old. I am pushing the code as is, but this needs cleanup.\n/***************************************************************************/\n\nmodule alias S = SKStore;\n\nmodule SKJS;\n\nclass FileDefsMap(fileDefsDir: S.LHandle<S.SID, FileDefs>) {\n  static fun create(\n    context: mutable S.Context,\n    index: FileNameIndex,\n    rootOpt: ?DirName,\n    importStubs: Array<DirName>,\n    parsedFiles: S.EHandle<S.SID, ParsedResultFile>,\n  ): this {\n    static(\n      S.LHandle::create(\n        S.SID::keyType,\n        FileDefs::type,\n        context,\n        S.DirName::create(\"/skjs/fileDefs/\"),\n        (context, _self, key) ~> {\n          fileName = FileName::create(key.value);\n          parsedFile = parsedFiles.get(context, key);\n          parsedFile.value match {\n          | PROk(defs) ->\n            Array[\n              FileDefs::create(\n                context,\n                index,\n                rootOpt,\n                fileName.dirName,\n                importStubs,\n                defs,\n              ),\n            ]\n          | _ -> Array[]\n          }\n        },\n      ),\n    )\n  }\n\n  fun get(context: mutable S.Context, fileName: FileName): FileDefs {\n    this.fileDefsDir.get(context, S.SID(fileName.toString()))\n  }\n}\n\nmutable class FileDefsState{\n  context: mutable S.Context,\n  index: FileNameIndex,\n  rootOpt: ?DirName,\n  dirName: DirName,\n  importStubs: Array<DirName>,\n  importedStar: mutable Set<String> = mutable Set[],\n  importedFrom: mutable Map<String, (String, FileName)> = mutable Map[],\n  importedModulesFrom: mutable Map<String, FileName> = mutable Map[],\n  exported: mutable Map<String, String> = mutable Map[],\n  exportedStar: mutable Set<String> = mutable Set[],\n  exportedFrom: mutable Map<String, (String, FileName)> = mutable Map[],\n  exportedModules: mutable Set<String> = mutable Set[],\n  exportedModulesFrom: mutable Map<String, FileName> = mutable Map[],\n  mutable default: ?String = None(),\n  namespaces: mutable Map<String, FileDefs> = mutable Map[],\n  exportedNamespaces: mutable Map<String, FileDefs> = mutable Map[],\n  modules: mutable Map<String, FileDefs> = mutable Map[],\n  defs: mutable Map<String, mutable Vector<Def>> = mutable Map[],\n  mutable exportEq: ?Name = None(),\n} {\n  mutable fun processDefs(parsedDefs: Array<Def>): FileDefs {\n    for (def in parsedDefs) {\n      def.value match {\n      | ToplevelExpr(_) -> void\n      | TypeDef _\n      | Class _\n      | Enum _\n      | Namespace _\n      | Module _\n      | FunDef _\n      | VarDefs _ ->\n        this.newDef(None(), false, def)\n      | ExportNames(_, names, None()) -> this.exportNames(names)\n      | ExportNames(_, names, Some(Expr(_, EString(mname)))) ->\n        fn = resolveName(\n          this.context,\n          this.index,\n          this.rootOpt,\n          this.dirName,\n          mname,\n        ) match {\n        | None() -> continue\n        | Some(x) -> x\n        };\n        this.exportNamesFrom(names, fn)\n      | ExportNames _ -> internal_error(\"TODO: unsupported export\")\n      | ExportDefault(_, Expr(_, Var(n))) -> this.!default = Some(n.value)\n      | ExportDefault _ -> internal_error(\"TODO: unsupported export\")\n      | ExportEq(v) ->\n        v.value match {\n        | Var(n) -> this.!exportEq = Some(n)\n        | _ ->\n          debug(v);\n          debug(\"TODO: exportEq other than a name\")\n        }\n      | ExportAs _ -> void\n      | ExportImport _ -> debug(\"TODO: exportImport\")\n      | Global _ -> debug(\"TODO: todo global\")\n      | Import(_, _, names, importName) ->\n        importName match {\n        | INPath(mname) ->\n          resolveName(\n            this.context,\n            this.index,\n            this.rootOpt,\n            this.dirName,\n            mname.value,\n          )\n        | INName(mname) -> resolveStubs(this.importStubs, mname.value)\n        } match {\n        | None() -> void\n        | Some(fn) -> this.importNamesFrom(names, fn)\n        }\n\n      | Declare(d @ Def(_, TypeDef _))\n      | Declare(d @ Def(_, Class _))\n      | Declare(d @ Def(_, Enum _))\n      | Declare(d @ Def(_, Namespace _))\n      | Declare(d @ Def(_, Module _))\n      | Declare(d @ Def(_, FunDef _))\n      | Declare(d @ Def(_, VarDefs _)) ->\n        this.newDef(None(), false, d)\n      /*\n              d match {\n              | Module(_, Some(defs)) ->\n                for (moduleDef in defs) {\n                  this.newDef(\n                    None(),\n                    false,\n                    moduleDef,\n                  );\n                }\n              | _ -> void\n              }\n      */\n\n      | Export(_, None(), d @ TypeDef _)\n      | Export(_, None(), d @ Class _)\n      | Export(_, None(), d @ Enum _)\n      | Export(_, None(), d @ Namespace _)\n      | Export(_, None(), d @ Module _)\n      | Export(_, None(), d @ FunDef _)\n      | Export(_, None(), d @ VarDefs _) ->\n        this.newDef(None(), true, Def(def.pos, d))\n\n      | Export(_, x @ Some _, d @ TypeDef _)\n      | Export(_, x @ Some _, d @ Class _)\n      | Export(_, x @ Some _, d @ Enum _)\n      | Export(_, x @ Some _, d @ Namespace _)\n      | Export(_, x @ Some _, d @ Module _)\n      | Export(_, x @ Some _, d @ FunDef _)\n      | Export(_, x @ Some _, d @ VarDefs _) ->\n        this.newDef(x, true, Def(def.pos, d))\n\n      | Export(_, None(), Declare(d @ Def(_, TypeDef _)))\n      | Export(_, None(), Declare(d @ Def(_, Class _)))\n      | Export(_, None(), Declare(d @ Def(_, Enum _)))\n      | Export(_, None(), Declare(d @ Def(_, Namespace _)))\n      | Export(_, None(), Declare(d @ Def(_, Module _)))\n      | Export(_, None(), Declare(d @ Def(_, FunDef _)))\n      | Export(_, None(), Declare(d @ Def(_, VarDefs _))) ->\n        this.newDef(None(), true, d)\n\n      | Export(_, x @ Some _, Declare(d @ Def(_, TypeDef _)))\n      | Export(_, x @ Some _, Declare(d @ Def(_, Class _)))\n      | Export(_, x @ Some _, Declare(d @ Def(_, Enum _)))\n      | Export(_, x @ Some _, Declare(d @ Def(_, Namespace _)))\n      | Export(_, x @ Some _, Declare(d @ Def(_, Module _)))\n      | Export(_, x @ Some _, Declare(d @ Def(_, FunDef _)))\n      | Export(_, x @ Some _, Declare(d @ Def(_, VarDefs _))) ->\n        this.newDef(x, true, d)\n\n      | Export(_, _, Declare(Def(_, Declare _)))\n      | Export(_, _, ExportNames _)\n      | Export(_, _, Global _)\n      | Export(_, _, Import _)\n      | Export(_, _, ImportExpr _)\n      | Export(_, _, ToplevelExpr _)\n      | Export(_, _, Export _)\n      | Export(_, _, ExportAs _)\n      | Export(_, _, ExportDefault _)\n      | Export(_, _, ExportEq _)\n      | Export(_, _, ExportImport _)\n      | Export(_, _, Declare(Def(_, ExportNames _)))\n      | Export(_, _, Declare(Def(_, Global _)))\n      | Export(_, _, Declare(Def(_, Import _)))\n      | Export(_, _, Declare(Def(_, ImportExpr _)))\n      | Export(_, _, Declare(Def(_, ToplevelExpr _)))\n      | Export(_, _, Declare(Def(_, Export _)))\n      | Export(_, _, Declare(Def(_, ExportAs _)))\n      | Export(_, _, Declare(Def(_, ExportDefault _)))\n      | Export(_, _, Declare(Def(_, ExportEq _)))\n      | Export(_, _, Declare(Def(_, ExportImport _))) ->\n        internal_error(\"Internal error\")\n\n      | Declare(Def(_, Global _)) -> debug((\"TODO declare global\"))\n      | Declare _ -> internal_error(\"TODO rest of declare\")\n      | ImportExpr _ -> void\n      }\n    };\n    this.toFileDefs()\n  }\n\n  private readonly fun toFileDefs(): FileDefs {\n    FileDefs{\n      importedStar => this.importedStar.chill(),\n      importedFrom => this.importedFrom.chill(),\n      importedModulesFrom => this.importedModulesFrom.chill(),\n      exported => this.exported.chill(),\n      exportedStar => this.exportedStar.chill(),\n      exportedFrom => this.exportedFrom.chill(),\n      exportedModules => this.exportedModules.chill(),\n      exportedModulesFrom => this.exportedModulesFrom.chill(),\n      default => this.default,\n      namespaces => this.namespaces.chill(),\n      exportedNamespaces => this.exportedNamespaces.chill(),\n      modules => this.modules.chill(),\n      defs => this.defs.map((_, x) -> x.toArray()),\n      exportEq => this.exportEq,\n    }\n  }\n\n  private mutable fun createFileDefs(defs: Array<Def>): FileDefs {\n    state = mutable static{\n      context => this.context,\n      index => this.index,\n      rootOpt => this.rootOpt,\n      dirName => this.dirName,\n      importStubs => this.importStubs,\n    };\n    state.processDefs(defs)\n  }\n\n  mutable fun newDef(isDefault: ?PosRange, isExport: Bool, def: Def): void {\n    def.value match {\n    | TypeDef{name} ->\n      if (isDefault is Some _) this.!default = Some(name.value);\n      if (isExport) this.exported![name.value] = name.value;\n      if (!this.defs.containsKey(name.value)) {\n        this.defs![name.value] = mutable Vector[];\n      };\n      this.defs[name.value].push(def)\n    | Class{name} ->\n      if (isDefault is Some _) this.!default = Some(name.value);\n      if (isExport) this.exported![name.value] = name.value;\n      if (!this.defs.containsKey(name.value)) {\n        this.defs![name.value] = mutable Vector[];\n      };\n      this.defs[name.value].push(def)\n    | Enum(_, name, _) ->\n      if (isDefault is Some _) this.!default = Some(name.value);\n      if (isExport) this.exported![name.value] = name.value;\n      if (!this.defs.containsKey(name.value)) {\n        this.defs![name.value] = mutable Vector[];\n      };\n      this.defs[name.value].push(def)\n    | Namespace(name, defs) ->\n      fileDefs = this.createFileDefs(defs);\n      if (isExport) {\n        this.exportedNamespaces![name.value] = fileDefs\n      } else {\n        this.namespaces![name.value] = fileDefs\n      }\n    | Module(name, Some(defs)) ->\n      this.modules![name.value] = this.createFileDefs(defs)\n    | FunDef{name, pos} ->\n      fname = name.fromSome() match {\n      | FNNormal(n) -> n.value\n      | FNSymbol(n) ->\n        typingError(\n          Array[(pos, `Invalid name for a toplevel function: symbol ${n}`)],\n        )\n      };\n      if (isDefault is Some _) this.!default = Some(fname);\n      if (isExport) this.exported![fname] = fname;\n      if (!this.defs.containsKey(fname)) {\n        this.defs![fname] = mutable Vector[];\n      };\n      this.defs[fname].push(def)\n\n    | VarDefs(k, varDefs) ->\n      if (isDefault is Some _) {\n        if (varDefs.size() > 1) {\n          internal_error(\"TODO: more than one default\");\n        };\n        this.!default = Some(\n          varDefs[0].pat.value match {\n          | PVar(x) -> x.value\n          | _ -> internal_error(\"TODO: cannot have default base on names\")\n          },\n        );\n      };\n      for (varDef in varDefs) {\n        exportName = varDefs[0].pat.value match {\n        | PVar(x) -> x\n        | _ -> internal_error(\"TODO: cannot have exports base on names\")\n        };\n        if (isExport) this.exported![exportName.value] = exportName.value;\n        if (!this.defs.containsKey(exportName.value)) {\n          this.defs![exportName.value] = mutable Vector[];\n        };\n        this.defs[exportName.value].push(\n          Def(exportName.pos, VarDefs(k, Array[varDef])),\n        );\n      }\n    | _ -> internal_error(\"Internal error: expected a definition\")\n    }\n  }\n\n  private mutable fun exportNames(names: ModuleNames): void {\n    names match {\n    | MStar(Some(moduleName)) -> this.exportedModules.insert(moduleName.value)\n    | MStar(None()) -> debug(\"TODO error export *\")\n    | MCurly(moduleDefNames) ->\n      for (moduleDefName in moduleDefNames) {\n        moduleDefName.asName match {\n        | None() ->\n          this.exported![moduleDefName.name.value] = moduleDefName.name.value\n        | Some(asName) ->\n          this.exported![moduleDefName.name.value] = asName.value\n        }\n      }\n    | MName(moduleName, moduleDefNames) ->\n      this.exportedModules.insert(moduleName.value);\n      for (moduleDefName in moduleDefNames) {\n        moduleDefName.asName match {\n        | None() ->\n          this.exported![moduleDefName.name.value] = moduleDefName.name.value\n        | Some(asName) ->\n          this.exported![moduleDefName.name.value] = asName.value\n        }\n      }\n    }\n  }\n\n  private mutable fun exportNamesFrom(\n    names: ModuleNames,\n    fileName: FileName,\n  ): void {\n    names match {\n    | MStar(Some(moduleName)) ->\n      this.exportedModulesFrom![moduleName.value] = fileName\n    | MStar(None()) -> this.exportedStar.insert(fileName.toString())\n    | MCurly(moduleDefNames) ->\n      for (moduleDefName in moduleDefNames) {\n        moduleDefName.asName match {\n        | None() ->\n          this.exportedFrom![moduleDefName.name.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        | Some(asName) ->\n          this.exportedFrom![asName.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        }\n      }\n    | MName(moduleName, moduleDefNames) ->\n      this.exportedModulesFrom![moduleName.value] = fileName;\n      for (moduleDefName in moduleDefNames) {\n        moduleDefName.asName match {\n        | None() ->\n          this.exportedFrom![moduleDefName.name.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        | Some(asName) ->\n          this.exportedFrom![asName.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        }\n      }\n    }\n  }\n\n  private mutable fun importNamesFrom(\n    names: ModuleNames,\n    fileName: FileName,\n  ): void {\n    names match {\n    | MStar(Some(moduleName)) ->\n      this.importedModulesFrom![moduleName.value] = fileName\n    | MStar(None()) -> this.importedStar.insert(fileName.toString())\n    | MCurly(moduleDefNames) ->\n      for (moduleDefName in moduleDefNames) {\n        moduleDefName.asName match {\n        | None() ->\n          this.importedFrom![moduleDefName.name.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        | Some(asName) ->\n          this.importedFrom![asName.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        }\n      }\n    | MName(moduleName, moduleDefNames) ->\n      this.importedModulesFrom![moduleName.value] = fileName;\n      for (moduleDefName in moduleDefNames) {\n        moduleDefName.asName match {\n        | None() ->\n          this.importedFrom![moduleDefName.name.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        | Some(asName) ->\n          this.importedFrom![asName.value] = (\n            moduleDefName.name.value,\n            fileName,\n          )\n        }\n      }\n    }\n  }\n}\n\nclass FileDefs{\n  importedStar: Set<String>,\n  importedFrom: Map<String, (String, FileName)>,\n  importedModulesFrom: Map<String, FileName>,\n  exported: Map<String, String>,\n  exportedStar: Set<String>,\n  exportedFrom: Map<String, (String, FileName)>,\n  exportedModules: Set<String>,\n  exportedModulesFrom: Map<String, FileName>,\n  default: ?String,\n  namespaces: Map<String, FileDefs>,\n  exportedNamespaces: Map<String, FileDefs>,\n  modules: Map<String, FileDefs>,\n  defs: Map<String, Array<Def>>,\n  exportEq: ?Name,\n} extends S.File {\n  static fun create(\n    context: mutable S.Context,\n    index: FileNameIndex,\n    rootOpt: ?DirName,\n    dirName: DirName,\n    importStubs: Array<DirName>,\n    parsedDefs: Array<Def>,\n  ): FileDefs {\n    state = mutable FileDefsState{\n      context,\n      index,\n      rootOpt,\n      dirName,\n      importStubs,\n    };\n    state.processDefs(parsedDefs)\n  }\n}\n\nbase class IDefMap {\n  fun getType(mutable S.Context, Name): DefMapType;\n  fun get(mutable S.Context, FileName, Name): Array<Def>;\n}\n\nbase class DefMapType {\n  children =\n  | TDType(TypeDef)\n  | TDClass(Class)\n}\n\nclass DefMap{\n  index: FileNameIndex,\n  fileDefsMap: FileDefsMap,\n  builtins: Set<String>,\n  builtinsFileName: FileName,\n} extends IDefMap {\n  private fun notFound<T>(defName: Name): T {\n    error(ParsingError(EPRange(defName.pos), NotFound(defName.value)))\n  }\n\n  fun getType(context: mutable S.Context, name: Name): DefMapType {\n    for (def in this.get(context, FileName::create(name.pos.fileName), name)) {\n      def.value match {\n      | td @ TypeDef _ -> return TDType(td)\n      | c @ Class _ -> return TDClass(c)\n      | _ -> void\n      }\n    };\n    typingError(Array[(name.pos, \"Unbound name\")])\n  }\n\n  fun get(\n    context: mutable S.Context,\n    fileName: FileName,\n    defName: Name,\n  ): Array<Def> {\n    fileDefs = this.fileDefsMap.get(\n      context,\n      if (this.builtins.contains(defName.value)) this.builtinsFileName else {\n        fileName\n      },\n    );\n    this.getInDefs(context, fileDefs, defName)\n  }\n\n  private fun getInDefs(\n    context: mutable S.Context,\n    fileDefs: FileDefs,\n    defName: Name,\n  ): Array<Def> {\n    if (defName.value.contains(\".\")) {\n      arr = defName.value.split(\".\");\n      moduleName = arr[0];\n      newDefName = arr.slice(1, arr.size()).join(\".\");\n      fileDefs.importedModulesFrom.maybeGet(moduleName) match {\n      | Some(fileName) ->\n        return this.get(context, fileName, Name(defName.pos, newDefName))\n      | None() -> void\n      };\n      fileDefs.exportedModulesFrom.maybeGet(moduleName) match {\n      | Some(fileName) ->\n        return this.get(context, fileName, Name(defName.pos, newDefName))\n      | None() -> void\n      };\n      fileDefs.namespaces.maybeGet(moduleName) match {\n      | Some(fileName) ->\n        return this.getInDefs(context, fileName, Name(defName.pos, newDefName))\n      | None() -> void\n      };\n      fileDefs.exportedNamespaces.maybeGet(moduleName) match {\n      | Some(fileName) ->\n        return this.getInDefs(context, fileName, Name(defName.pos, newDefName))\n      | None() -> void\n      };\n      fileDefs.importedFrom.maybeGet(moduleName) match {\n      | Some((origName, newFileName)) ->\n        return this.get(\n          context,\n          newFileName,\n          Name(defName.pos, origName + newDefName),\n        )\n      | None() -> void\n      };\n      fileDefs.exportedFrom.maybeGet(moduleName) match {\n      | Some((origName, newFileName)) ->\n        return this.get(\n          context,\n          newFileName,\n          Name(defName.pos, origName + newDefName),\n        )\n      | None() -> void\n      };\n      this.notFound(defName);\n    };\n    fileDefs.importedFrom.maybeGet(defName.value) match {\n    | Some((exportedDefName, importedFileName)) ->\n      return this.getExported(\n        context,\n        importedFileName,\n        Name(defName.pos, exportedDefName),\n      )\n    | None() -> void\n    };\n    for (importedFileName in fileDefs.importedStar) {\n      return this.getExported(\n        context,\n        FileName::create(importedFileName),\n        defName,\n      );\n    };\n    for (exportedFileName in fileDefs.exportedStar) {\n      return this.getExported(\n        context,\n        FileName::create(exportedFileName),\n        defName,\n      );\n    };\n    fileDefs.defs.maybeGet(defName.value) match {\n    | Some(def) -> return def\n    | None() -> void\n    };\n    fileDefs.exportEq match {\n    | None() -> void\n    | Some(name) ->\n      fileDefs.namespaces.maybeGet(name.value) match {\n      | Some(fileName) -> return this.getInDefs(context, fileName, defName)\n      | None() ->\n        debug(fileDefs.namespaces.items().map(x -> x.i0).collect(Array));\n        this.notFound(defName)\n      }\n    };\n    for (exportedNamespace in fileDefs.exportedNamespaces) {\n      try {\n        Some(this.getInDefs(context, exportedNamespace, defName))\n      } catch {\n      | _ -> None()\n      } match {\n      | None() -> void\n      | Some(x) -> return x\n      }\n    };\n    this.notFound(defName);\n  }\n\n  private fun getExported(\n    context: mutable S.Context,\n    fileName: FileName,\n    defName: Name,\n  ): Array<Def> {\n    fileDefs = this.fileDefsMap.get(context, fileName);\n    this.getExportedInDefs(context, fileDefs, defName)\n  }\n\n  private fun getExportedInDefs(\n    context: mutable S.Context,\n    fileDefs: FileDefs,\n    defName: Name,\n  ): Array<Def> {\n    if (defName.value.contains(\".\")) {\n      arr = defName.value.split(\".\");\n      moduleName = arr[0];\n      newDefName = arr.slice(1, arr.size()).join(\".\");\n      fileDefs.importedModulesFrom.maybeGet(moduleName) match {\n      | Some(fileName) ->\n        return this.getExported(\n          context,\n          fileName,\n          Name(defName.pos, newDefName),\n        )\n      | None() -> void\n      };\n      fileDefs.exportedModulesFrom.maybeGet(moduleName) match {\n      | Some(fileName) ->\n        return this.getExported(\n          context,\n          fileName,\n          Name(defName.pos, newDefName),\n        )\n      | None() -> void\n      };\n      this.notFound(defName);\n    };\n    fileDefs.exportEq match {\n    | None() -> void\n    | Some(name) ->\n      fileDefs.namespaces.maybeGet(name.value) match {\n      | Some(fileName) -> return this.getInDefs(context, fileName, defName)\n      | None() ->\n        debug(fileDefs.exportedNamespaces.containsKey(name.value));\n        this.notFound(defName)\n      }\n    };\n\n    if (defName.value == \"default\" && fileDefs.default is Some _) {\n      defaultName = fileDefs.default.fromSome();\n      return this.getInDefs(context, fileDefs, Name(defName.pos, defaultName))\n    } else {\n      fileDefs.exported.maybeGet(defName.value) match {\n      | Some(asName) ->\n        return this.getInDefs(context, fileDefs, Name(defName.pos, asName))\n      | None() -> void\n      };\n      fileDefs.exportedFrom.maybeGet(defName.value) match {\n      | Some((newDefName, newFileName)) ->\n        return this.getExported(\n          context,\n          newFileName,\n          Name(defName.pos, newDefName),\n        )\n      | None() -> void\n      }\n    };\n    for (exportedFileName in fileDefs.exportedStar) {\n      return this.getExported(\n        context,\n        FileName::create(exportedFileName),\n        defName,\n      );\n    };\n\n    for (moduleDefs in fileDefs.modules) {\n      try {\n        Some(this.getInDefs(context, moduleDefs, defName))\n      } catch {\n      | _ -> None()\n      } match {\n      | Some(x) -> return x\n      | None() -> void\n      }\n    };\n    this.notFound(defName);\n  }\n}\n\nmodule end;\n"}, {"path": "src/Files.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Module loading all the files we need in memory. */\n/***************************************************************************/\n\nmodule alias S = SKStore;\n\nmodule SKJS;\n\nbase class ParsedResult {\n  children =\n  | PROk(Array<Def>)\n  | PRError(Error)\n}\n\nclass ParsedResultAndSymbolsFile(\n  value: ParsedResult,\n  symbols: Map<SymbolicPos, Int>,\n) extends SKStore.File\n\nclass ParsedResultFile(value: ParsedResult) extends SKStore.File\n\nconst parseErrorKey: SKStore.SID = SKStore.SID(\"\");\n\nconst filesDirName: SKStore.DirName = SKStore.DirName::create(\"/skjs/files/\");\nconst parsesDirName: SKStore.DirName = SKStore.DirName::create(\n  \"/skjs/parsed_with_errors/\",\n);\nconst oldParsesDirName: SKStore.DirName = SKStore.DirName::create(\n  \"/skjs/changed_file_old_parse_results/\",\n);\nclass Files(\n  isInit: Bool,\n  rootOpt: ?DirName,\n  builtinsFileName: FileName,\n  filesContent: SKStore.EHandle<SKStore.SID, SKStore.StringFile>,\n  importStubs: Array<DirName>,\n  changedFileOldParsedResults: ?SortedMap<String, ParsedResult>,\n) {\n  static fun create(\n    context: mutable SKStore.Context,\n    baseUrlOpt: ?String,\n    builtinsFileNameStr: String,\n    srcFileSeq: Sequence<String>,\n    trackChangedFiles: Bool = false,\n    sourceDirOpt: ?String = None(),\n    importStubs: Array<String> = Array[],\n  ): Result<Files, String> {\n    builtinsFileName = FileName::create(Path.resolve(builtinsFileNameStr));\n    rootOpt = baseUrlOpt.map(baseUrl -> DirName::create(Path.resolve(baseUrl)));\n    if (srcFileSeq.isEmpty()) {\n      root = rootOpt match {\n      | Some(root) -> root\n      | None() -> DirName::create(FileSystem.realpath(\".\"))\n      };\n      !rootOpt = Some(root);\n      srcDir = sourceDirOpt match {\n      | Some(dir) -> Path.resolve(dir)\n      | None() -> Path.join(root.toString(), \"src\")\n      };\n      if (!FileSystem.exists(srcDir)) {\n        return Failure(`Could not find source dir: ${srcDir}`);\n      };\n      !srcFileSeq = FileSystem.readFilesRecursive(srcDir, fileName ->\n        fileName.endsWith(\".ts\")\n      );\n    } else {\n      !srcFileSeq = srcFileSeq.map(f -> Path.resolve(f));\n    };\n    if (srcFileSeq.isEmpty()) {\n      return Failure(\"No source files!\");\n    };\n    if (!builtinsFileName.exists()) {\n      return Failure(`Builtins not found: ${builtinsFileName}`);\n    };\n    !importStubs = importStubs.map(dir -> Path.resolve(dir));\n    importStubsFiles = importStubs\n      .map(dir ->\n        FileSystem.readFilesRecursive(dir, fileName ->\n          fileName.endsWith(\"index.d.ts\")\n        )\n      )\n      .flatten();\n    srcFiles = Array[\n      srcFileSeq,\n      Array[builtinsFileName.toString()],\n      importStubsFiles,\n    ].flatten().collect(SortedSet);\n\n    isInit = context.unsafeMaybeGetEagerDir(filesDirName) is None();\n    fileHdl = createOrReuseEagerDir(\n      context,\n      SKStore.SID::keyType,\n      SKStore.StringFile::type,\n      filesDirName,\n    );\n    fileDir = context.unsafeGetEagerDir(filesDirName);\n    oldParses: SortedMap<String, ParsedResult> = SortedMap::create();\n\n    for (fileName in srcFiles) {\n      key = SKStore.SID(fileName);\n      content = FileSystem.readTextFile(fileName);\n      if (!isInit && trackChangedFiles) {\n        oldFile = fileDir.getArrayRaw(key);\n        if (\n          oldFile.size() == 1 &&\n          SKStore.StringFile::type(oldFile[0]).value != content\n        ) {\n          // stash defs from previous run to compare against new versions\n          oldParsedResult = context\n            .unsafeGetEagerDir(parsesDirName)\n            .getArrayRaw(key)\n            .map(ParsedResultAndSymbolsFile::type)[0].value;\n          !oldParses = oldParses.set(fileName, oldParsedResult);\n        }\n      };\n      fileHdl.writeArray(context, key, Array[SKStore.StringFile(content)]);\n    };\n    for (kv in fileHdl.items(context)) {\n      fileName = kv.i0.value;\n      if (!srcFiles.contains(fileName)) {\n        fileHdl.writeArray(context, kv.i0, Array[]);\n      };\n    };\n    changedFileOldParsedResults = if (trackChangedFiles) Some(oldParses) else {\n      None()\n    };\n    Success(\n      Files(\n        isInit,\n        rootOpt,\n        builtinsFileName,\n        fileHdl,\n        importStubs.map(DirName::create),\n        changedFileOldParsedResults,\n      ),\n    )\n  }\n\n  fun parse(\n    context: mutable SKStore.Context,\n    newLinesMap: NewLinesMap,\n  ): (SKStore.EHandle<SKStore.SID, ParsedResultAndSymbolsFile>, SymbolsMap) {\n    parsedFiles = this.filesContent.map(\n      SKStore.SID::keyType,\n      ParsedResultAndSymbolsFile::type,\n      context,\n      SKStore.DirName::create(\"/skjs/parsed_with_errors/\"),\n      (_context, writer, key, contentIter) ~> {\n        fileName = key.value;\n        content = contentIter.first.value;\n        lexer = Lexer::mcreate(fileName, content, this.rootOpt);\n        parser = mutable Parser(lexer);\n        try {\n          writer.setArray(\n            key,\n            Array[\n              ParsedResultAndSymbolsFile(\n                PROk(parser.toplevelDefs()),\n                lexer.getAllSymbolLocations(),\n              ),\n            ],\n          )\n        } catch {\n        | ErrorExn(err) ->\n          symbols = lexer.getAllSymbolLocations();\n          // Store the error under parseErrorKey for error reporting\n          writer.setArray(\n            parseErrorKey,\n            Array[ParsedResultAndSymbolsFile(PRError(err), symbols)],\n          );\n          // Also store the symbols under the actual filename for symbol resolution\n          writer.setArray(\n            key,\n            Array[ParsedResultAndSymbolsFile(PRError(err), symbols)],\n          )\n        | exn -> throw exn\n        }\n      },\n    );\n    errors = parsedFiles.unsafeGetArray(context, parseErrorKey);\n    symbolsMap = SymbolsMap::create(context, parsedFiles);\n    if (errors.size() != 0) {\n      for (error in errors) {\n        error.value match {\n        | PRError(err) ->\n          print_error(err.toString(context, newLinesMap, symbolsMap))\n        | _ -> internal_error(\"Unexpected parsing result\")\n        }\n      };\n      throw Exit(2);\n    };\n    (parsedFiles, symbolsMap)\n  }\n\n  // (added-defs, removed-defs) since last run\n  fun getChangedDefs(\n    context: mutable SKStore.Context,\n  ): (Array<Def>, Array<Def>) {\n    added: mutable Vector<Def> = mutable Vector[];\n    removed: mutable Vector<Def> = mutable Vector[];\n\n    oldParses = this.changedFileOldParsedResults match {\n    | Some(oldParses) -> oldParses\n    | None() ->\n      invariant_violation(\n        \"getChangedDefs called without any old parsed results\",\n      )\n    };\n    currentParses = context.unsafeMaybeGetEagerDir(parsesDirName) match {\n    | Some _ ->\n      SKStore.EHandle(\n        SKStore.SID::keyType,\n        ParsedResultAndSymbolsFile::type,\n        parsesDirName,\n      )\n    | None() ->\n      invariant_violation(\n        \"getChangedDefs called without any current parsed results \",\n      )\n    };\n    for ((fileName, previousParsedResult) in oldParses.items()) {\n      currentParsedResult = currentParses.get(\n        context,\n        SKStore.SID(fileName),\n      ).value;\n      (previousParsedResult, currentParsedResult) match {\n      | (PRError(_), PRError(_)) -> continue\n      | (PROk(prevDefs), PRError(_)) -> removed.extend(prevDefs)\n      | (PRError(_), PROk(currDefs)) -> added.extend(currDefs)\n      | (PROk(prevDefs), PROk(currDefs)) ->\n        prevDefsByHash = SortedMap::createFromIterator(\n          prevDefs.values().map((def) -> (def.xxhash(true), def)),\n        );\n        currDefsByHash = SortedMap::createFromIterator(\n          currDefs.values().map((def) -> (def.xxhash(true), def)),\n        );\n        for ((hash, def) in prevDefsByHash.items()) {\n          if (!currDefsByHash.containsKey(hash)) removed.push(def)\n        };\n        for ((hash, def) in currDefsByHash.items()) {\n          if (!prevDefsByHash.containsKey(hash)) added.push(def)\n        }\n      }\n    };\n    (added.toArray(), removed.toArray())\n  }\n}\n\nfun removeSymbols(\n  context: mutable SKStore.Context,\n  parsedResultAndSymbols: SKStore.EHandle<\n    SKStore.SID,\n    ParsedResultAndSymbolsFile,\n  >,\n): SKStore.EHandle<SKStore.SID, ParsedResultFile> {\n  parsedResultAndSymbols.map(\n    SKStore.SID::keyType,\n    ParsedResultFile::type,\n    context,\n    SKStore.DirName::create(\"/parsed/nosymbols/\"),\n    (_context, writer, key, values) ~> {\n      writer.set(key, ParsedResultFile(values.first.value))\n    },\n  )\n}\n\nmodule end;\n"}, {"path": "src/InternalKeyedArrayMap.sk", "mtime": 1762775914, "contents": "//\n// Data structure for maps backed by arrays where the keys are internal to\n// the data and obtained using a projection function\n//\n\ntrait Projectable<T> {\n  readonly fun project(): T;\n}\n\nmodule InternalKeyedArrayMap;\n\n// see iterDiffInterDiff\nprivate mutable class DiffInterDiffIterator<\n  K: Orderable,\n  T: Projectable<K>,\n> private (\n  private mutable head1: ?T,\n  private tail1: mutable Iterator<T>,\n  private mutable head2: ?T,\n  private tail2: mutable Iterator<T>,\n) extends Iterator<(?T, ?T)> {\n  static fun create(\n    iter1: mutable Iterator<T>,\n    iter2: mutable Iterator<T>,\n  ): mutable Iterator<(?T, ?T)> {\n    head1 = iter1.next();\n    head2 = iter2.next();\n    mutable static(head1, iter1, head2, iter2)\n  }\n\n  readonly fun sizeHint(): ?Int {\n    size1 = this.tail1.sizeHint().map((n) ->\n      if (this.head1.isSome()) n + 1 else n\n    );\n    size2 = this.tail2.sizeHint().map((n) ->\n      if (this.head2.isSome()) n + 1 else n\n    );\n    (size1, size2) match {\n    | (Some(m), Some(n)) ->\n      Some(m + n) // actual size will be between max and sum of sizes\n    | (Some(n), None())\n    | (None(), Some(n)) ->\n      Some(n)\n    | (None(), None()) -> None()\n    }\n  }\n\n  mutable fun next(): ?(?T, ?T) {\n    none: ?T = None();\n    go = (x, y) -> {\n      if (x.isSome()) this.!head1 = this.tail1.next();\n      if (y.isSome()) this.!head2 = this.tail2.next();\n      Some((x, y))\n    };\n    (this.head1, this.head2) match {\n    | (None(), None()) -> None()\n    | (None(), Some(_)) -> go(none, this.head2)\n    | (Some(_), None()) -> go(this.head1, none)\n    | (Some(x), Some(y)) ->\n      x.project().compare(y.project()) match {\n      | LT() -> go(this.head1, none)\n      | EQ() -> go(this.head1, this.head2)\n      | GT() -> go(none, this.head2)\n      }\n    }\n  }\n}\n\n// A map where the keys are projected from the values, backed by a sorted array\nclass .InternalKeyedArrayMap<K: Orderable, T: Projectable<K>> private (\n  private inner: Vector<T>,\n) uses Orderable[T: Orderable], XXHashable[T: XXHashable] {\n  //\n  private static fun createFromSortedVector(inner: Vector<T>): this {\n    // inner must be strictly increasing under project, which is expected to\n    // hold since every transformation of T, such as the argument of map,\n    // should preserve project\n    prev: ?T = None();\n    for (curr in inner) {\n      prev match {\n      | Some(p) ->\n        if (p.project() >= curr.project()) {\n          internal_error(\"InternalKeyedArrayMap::create\")\n        }\n      | None() -> void\n      };\n      !prev = Some(curr);\n    };\n    static(inner)\n  }\n\n  private static fun create(size: Int, init: (T -> void) -> void): this {\n    // create by allocating, initializing via push, and checking collisions\n    inner = Vector::mcreate(size);\n    init(inner.push);\n    static::createFromSortedVector(unsafe_chill_trust_me(inner))\n  }\n\n  static fun createFromSortedIterator<I: mutable Iterator<T>>(items: I): this {\n    static::create(items.sizeHint().default(0), items.each)\n  }\n\n  static fun createFromIterator<I: mutable Iterator<T>>(items: I): this {\n    inner = Vector::mcreateFromIterator(items);\n    inner.sortBy(x ~> x.project());\n    static::createFromSortedVector(unsafe_chill_trust_me(inner))\n  }\n\n  static fun empty(): this {\n    static(Vector[])\n  }\n\n  static fun single(x: T): this {\n    static(Vector[x])\n  }\n\n  fun isEmpty(): Bool {\n    this.inner.isEmpty()\n  }\n\n  fun size(): Int {\n    this.inner.size()\n  }\n\n  fun singleElt(): ?T {\n    if (this.inner.size() == 1) Some(this.inner[0]) else None()\n  }\n\n  fun minimum(): ?T {\n    this.inner.maybeGet(0)\n  }\n\n  fun maybeGet(k: K): ?T {\n    idx = SKStore.binSearch(\n      i ~> this.inner[i].project(),\n      k,\n      0,\n      this.inner.size() - 1,\n    );\n    if (idx < 0 || idx >= this.inner.size() || this.inner[idx].project() != k) {\n      None()\n    } else {\n      Some(this.inner[idx])\n    }\n  }\n\n  fun containsKey(k: K): Bool {\n    this.maybeGet(k).isSome()\n  }\n\n  fun toArray(): Array<T> {\n    this.inner.toArray()\n  }\n\n  fun values(): mutable Iterator<T> {\n    this.inner.values()\n  }\n\n  fun items(): mutable Iterator<(Int, T)> {\n    this.inner.items()\n  }\n\n  fun any(f: T -> Bool): Bool {\n    this.inner.any(f)\n  }\n\n  fun all(f: T -> Bool): Bool {\n    this.inner.all(f)\n  }\n\n  fun find(f: T -> Bool): ?T {\n    this.inner.find(f)\n  }\n\n  fun filter(f: T -> Bool): this {\n    // don't need to call create since Vector.filter returns a subset and\n    // preserves order\n    static(this.inner.filter(f))\n  }\n\n  // REQUIRES: f must preserve project: x.project() == f(x).project() for any x\n  fun map(f: T -> T): this {\n    f1 = (x) -> {\n      y = f(x);\n      assert(x.project() == y.project());\n      y\n    };\n    static::createFromSortedIterator(this.inner.values().map(f1))\n  }\n\n  // REQUIRES: f must preserve project: x.project() == f(x).project() for any x\n  fun filterMap(f: T -> ?T): this {\n    f1 = (x) -> {\n      yO = f(x);\n      yO match {\n      | None() -> void\n      | Some(y) -> assert(x.project() == y.project())\n      };\n      yO\n    };\n    static::createFromSortedIterator(this.inner.values().filterMap(f1))\n  }\n\n  // s.iterDiffInterDiff(t) contains (Some(x), None()) for every element in\n  // s but not t, (None(), Some(y)) for every y in t but not s, and\n  // (Some(x), Some(y)) for every pair of elements that are in both s and t.\n  fun iterDiffInterDiff(that: this): mutable Iterator<(?T, ?T)> {\n    DiffInterDiffIterator::create(this.inner.values(), that.inner.values())\n  }\n\n  fun iterDiff(that: this): mutable Iterator<(T, ?T)> {\n    this.iterDiffInterDiff(that).filterMap((xO_yO) ->\n      xO_yO match {\n      | (Some(x), yO) -> Some((x, yO))\n      | (None(), _) -> None()\n      }\n    )\n  }\n\n  // s.leq(t, leqT) is Success if leqT(x, t.maybeGet(x)) is Success for every\n  // x in s, otherwise the first Failure encountered is returned\n  // immediately. Note that any extra elements in t are ignored.\n  fun leq<E>(that: this, leqT: (T, ?T) -> Result<void, E>): Result<void, E> {\n    this.iterDiff(that).findMap((x_yO) ->\n      x_yO match {\n      | (x, yO) ->\n        leqT(x, yO) match {\n        | Success(void) -> None()\n        | Failure(err) -> Some(err)\n        }\n      }\n    ) match {\n    | None() -> Success(void)\n    | Some(err) -> Failure(err)\n    }\n  }\n\n  // s.geq(t, geqT) is Success if geqT(s.maybeGet(y), y) is Success for every\n  // y in t, otherwise the first Failure encountered is returned\n  // immediately. Note that any extra elements in s are ignored.\n  fun geq<E>(that: this, geqT: (?T, T) -> Result<void, E>): Result<void, E> {\n    that.leq(this, (y, xO) -> geqT(xO, y))\n  }\n\n  // s.merge(t, f) is the set of elements v where Some(v) is returned by f\n  // from (Some(x), None) for every element in s but not t, (None, Some(y))\n  // for every y in t but not s, and (Some(x), Some(y)) for every pair of\n  // elements that are in both s and t. If f returns None, it indicates the\n  // unit of the merge operation and no corresponding element is included in\n  // the result.\n  //\n  // REQUIRES: f must preserve project:\n  // x.project() == f(Some(x),_).each(project) for any x and\n  // y.project() == f(_,Some(y)).each(project) for any y\n  fun merge(that: this, f: (?T, ?T) -> ?T): this {\n    static::createFromSortedIterator(\n      this.iterDiffInterDiff(that).filterMap((xO_yO) ->\n        xO_yO match {\n        | (xO, yO) -> f(xO, yO)\n        }\n      ),\n    )\n  }\n\n  // mergeOption is a generalization of merge where f may return None() to\n  // indicate the zero of the merge operation, causing mergeOption to return\n  // None() immediately, Some(None()) indicating the unit of the merge\n  // operation, and Some(Some(z)) indicating an element.\n  //\n  // REQUIRES: f must preserve project:\n  // x.project() == f(Some(x),_).each(project) for any x and\n  // y.project() == f(_,Some(y)).each(project) for any y\n  fun mergeOption(that: this, f: (?T, ?T) -> ??T): ?this {\n    zero = false;\n    result =\n      this.iterDiffInterDiff(that)\n        .map((xO_yO) -> {\n          zOO = xO_yO match {\n          | (xO, yO) -> f(xO, yO)\n          };\n          if (zOO.isNone()) !zero = true;\n          zOO\n        })\n        .takeWhile((zOO) -> zOO.isSome())\n        .map((zOO) -> zOO.fromSome())\n        .filterNone() |> static::createFromSortedIterator;\n    if (zero) None() else Some(result)\n  }\n\n  fun union(that: this): this {\n    this.merge(that, (xO, yO) ~>\n      xO match {\n      | None() -> yO\n      | _ -> xO\n      }\n    )\n  }\n\n  fun mapInter(that: this, f: (T, T) -> T): this {\n    this.merge(that, (xO, yO) ->\n      (xO, yO) match {\n      | (Some(x), Some(y)) -> Some(f(x, y))\n      | _ -> None()\n      }\n    )\n  }\n\n  fun mapUnion(that: this, f: (T, T) -> T): this {\n    this.merge(that, (xO, yO) ->\n      (xO, yO) match {\n      | (Some(z), None())\n      | (None(), Some(z)) ->\n        Some(z)\n      | (Some(x), Some(y)) -> Some(f(x, y))\n      | (None(), None()) -> None()\n      }\n    )\n  }\n\n  fun mapInterOption(that: this, f: (T, T) -> ?T): ?this {\n    this.mergeOption(that, (xO, yO) ->\n      (xO, yO) match {\n      | (Some(x), Some(y)) ->\n        f(x, y) match {\n        | None() -> None()\n        | sz -> Some(sz)\n        }\n      | _ -> Some(None())\n      }\n    )\n  }\n\n  fun mapUnionOption(that: this, f: (T, T) -> ?T): ?this {\n    this.mergeOption(that, (xO, yO) ->\n      (xO, yO) match {\n      | (Some(z), None())\n      | (None(), Some(z)) ->\n        Some(Some(z))\n      | (Some(x), Some(y)) ->\n        f(x, y) match {\n        | Some(z) -> Some(Some(z))\n        | None() -> None()\n        }\n      | (None(), None()) -> Some(None())\n      }\n    )\n  }\n}\n\nmodule end;\n"}, {"path": "src/Lexer.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// The SKJS lexer.\n/***************************************************************************/\n\nmodule SKJS;\n\nbase class SymbolicPos uses Orderable, Hashable, XXHashable {\n  children =\n  | SPTopLevel()\n  | SPClass(className: String)\n  | SPMethod(className: String, metName: String)\n  | SPFunction(funName: String)\n  | SPConstant(constName: String)\n}\n\nmutable class Lexer{\n  mutable currentSymbol: SymbolicPos = SPTopLevel(),\n  mutable currentSymbolPos: Int = -1,\n\n  // Track unique symbol locations encountered during parsing\n  symbolLocations: mutable Map<SymbolicPos, Int> = mutable Map[],\n\n  // The name of the file that we are lexing\n  fileName: String,\n\n  // The relative path for consistent ID generation across machines\n  relativeFileName: String,\n\n  // The contents of the file\n  contents: Array<Char>,\n\n  // Are we lexing a type? If so << and >> are two separate tokens.\n  // For example: Array<Array<number>>, we don't want the last >> to\n  // be lexed as the operator '>>'.\n  mutable inType: Bool = false,\n\n  // The current position in the file\n  mutable pos: Int = 0,\n\n  // The last token that was lexed, None() if we haven't started.\n  mutable lastTok: ?Token = None(),\n} {\n  // This method is useful to be able to \"look ahead\". There are a few\n  // constructions where determining what we are parsing is a bit\n  // complicated. For example, a call with explicit type arguments is\n  // really tricky. Consider: foo<targs>(args), we have to parse all\n  // the type arguments in \"targs\" to determine that we are dealing\n  // with a type argument and not a comparison. That's when this\n  // saving mechanism is used. So that we can try to parse something\n  // and then come back to where we were once we know what we are\n  // dealing with.\n  readonly private fun save(): this {\n    Lexer{\n      fileName => this.fileName,\n      relativeFileName => this.relativeFileName,\n      contents => this.contents,\n      pos => this.pos,\n      lastTok => this.lastTok,\n    }\n  }\n\n  // Returns true if the token is equal to the string passed as\n  // parameter. Note that we do not allocate a string for the token on\n  // purpose, we want to save as many allocations as possible.\n  readonly fun isEqTok(tok: Token, str: String): Bool {\n    pos = tok.posStart.value;\n    for (c in str) {\n      if (this.contents[pos] != c) return false;\n      !pos = pos + 1;\n    };\n    pos == tok.posEnd.value\n  }\n\n  // Returns the string associated with a token.\n  readonly fun getStrTok(tok: Token): String {\n    str = String::fromChars(\n      this.contents.slice(tok.posStart.value, tok.posEnd.value),\n    );\n    tok.kind match {\n    | TKQuote() -> str.stripPrefix(\"'\").stripSuffix(\"'\").replace(\"\\\\'\", \"'\")\n    | TKDoubleQuote() ->\n      str.stripPrefix(\"\\\"\").stripSuffix(\"\\\"\").replace(\"\\\\\\\"\", \"\\\"\")\n    | _ -> str\n    }\n  }\n\n  // Returns the current token in the form a string.\n  readonly fun getStr(): ?String {\n    this.peek().map(x -> this.getStrTok(x))\n  }\n\n  // Returns true if the current token is equal to the string.\n  readonly fun isEq(str: String): Bool {\n    this.peek() match {\n    | None() -> false\n    | Some(tok) -> this.isEqTok(tok, str)\n    }\n  }\n\n  // Creates a lexer from a saved point in the past.\n  static private fun mcreateFromSaved(lexer: Lexer): mutable Lexer {\n    mutable Lexer{\n      fileName => lexer.fileName,\n      relativeFileName => lexer.relativeFileName,\n      contents => lexer.contents,\n      pos => lexer.pos,\n      lastTok => lexer.lastTok,\n    }\n  }\n\n  mutable fun lookAhead(f: () -> Bool): Bool {\n    saved = this.save();\n    result = f();\n    this.!pos = saved.pos;\n    this.!lastTok = saved.lastTok;\n    this.!inType = saved.inType;\n    result\n  }\n\n  static fun mcreate(\n    fileName: String,\n    contents: String,\n    rootOpt: ?DirName,\n  ): mutable this {\n    // Compute relative path for consistent ID generation across machines\n    base = rootOpt match {\n    | Some(root) -> root.toString()\n    | None() -> getcwd()\n    };\n    relativeFileName = Path.relativeTo{path => fileName, base};\n    mutable static{\n      fileName,\n      relativeFileName,\n      contents => contents.chars().toArray(),\n    }\n  }\n\n  readonly fun peekKind(): ?TokenKind {\n    this.peek().map(x -> x.kind)\n  }\n\n  readonly fun peekStr(): ?String {\n    this.peek().map(x -> this.getStrTok(x))\n  }\n\n  readonly fun error<T>(start: Int, errKind: LexingKind): T {\n    error(LexingError(EPChar(this.fileName, Pos(start)), errKind))\n  }\n\n  readonly fun posEnd(): ErrorPos {\n    EPChar(this.fileName, Pos(this.contents.size() - 1))\n  }\n\n  readonly fun posStart(tok: Token): ErrorPos {\n    EPChar(this.fileName, tok.posStart)\n  }\n\n  // This is the method containing the main logic of the lexer. Note\n  // that we are skipping whitespaces and comments before running the\n  // actual logic.\n  readonly fun peek(): ?Token {\n    start = this.pos;\n    // Skipping white spaces and comments\n    loop {\n      if (start >= this.contents.size()) return None();\n      this.contents[start] match {\n      | '\\r' | '\\t' | ' ' | '\\n' ->\n        !start = start + 1;\n        continue\n      | c if (c.code() == 65279) ->\n        !start = start + 1;\n        continue\n      | '#' if (\n        start + 1 < this.contents.size() &&\n        this.contents[start + 1] == '!'\n      ) ->\n        !start = start + 1;\n        loop {\n          if (start >= this.contents.size()) return None();\n          if (this.contents[start] == '\\n') {\n            !start = start + 1;\n            break void;\n          };\n          !start = start + 1;\n        }\n      | '/' if (\n        start + 1 < this.contents.size() &&\n        this.contents[start + 1] == '/'\n      ) ->\n        !start = start + 1;\n        loop {\n          if (start >= this.contents.size()) return None();\n          if (this.contents[start] == '\\n') {\n            !start = start + 1;\n            break void;\n          };\n          !start = start + 1;\n        }\n      | '/' if (\n        start + 1 < this.contents.size() &&\n        this.contents[start + 1] == '*'\n      ) ->\n        !start = start + 2;\n        loop {\n          if (start >= this.contents.size()) {\n            this.error(start, UnterminatedComment())\n          };\n          if (this.contents[start] == '/' && this.contents[start - 1] == '*') {\n            !start = start + 1;\n            break void;\n          };\n          !start = start + 1;\n        }\n      | _ -> break void\n      }\n    };\n    pos = start;\n    if (pos >= this.contents.size()) return None();\n    mkToken = (kind: TokenKind) -> {\n      Some(Token(kind, Pos(start), Pos(pos)))\n    };\n    this.contents[pos] match {\n    | '(' ->\n      !pos = pos + 1;\n      mkToken(TKOpenParen())\n\n    | ')' ->\n      !pos = pos + 1;\n      mkToken(TKCloseParen())\n\n    | '[' ->\n      !pos = pos + 1;\n      mkToken(TKOpenSquare())\n    | ']' ->\n      !pos = pos + 1;\n      mkToken(TKCloseSquare())\n\n    | '{' ->\n      !pos = pos + 1;\n      mkToken(TKOpenCurly())\n    | '}' ->\n      !pos = pos + 1;\n      mkToken(TKCloseCurly())\n\n    | '\\'' ->\n      !pos = pos + 1;\n      loop {\n        if (pos >= this.contents.size()) {\n          this.error(pos, UnterminatedString())\n        };\n        c = this.contents[pos];\n        if (c == '\\n') this.error(pos, NewLineInString());\n        if (c == '\\\\') {\n          !pos = pos + 2;\n          continue\n        };\n        if (c == '\\'') {\n          !pos = pos + 1;\n          break void;\n        };\n        !pos = pos + 1;\n      };\n      mkToken(TKQuote())\n\n    | '\"' ->\n      !pos = pos + 1;\n      loop {\n        if (pos >= this.contents.size()) {\n          this.error(pos, UnterminatedString());\n        };\n        c = this.contents[pos];\n        if (c == '\\n') this.error(pos, NewLineInString());\n        if (c == '\\\\') {\n          !pos = pos + 2;\n          continue\n        };\n        if (c == '\"') {\n          !pos = pos + 1;\n          break void;\n        };\n        !pos = pos + 1;\n      };\n      mkToken(TKDoubleQuote())\n\n    | '`' ->\n      !pos = pos + 1;\n      loop {\n        if (pos >= this.contents.size()) {\n          this.error(pos, UnterminatedString());\n        };\n        c = this.contents[pos];\n        if (c == '\\\\') {\n          !pos = pos + 2;\n          continue\n        };\n        if (c == '$') {\n          !pos = pos + 1;\n          if (pos >= this.contents.size()) {\n            this.error(pos, UnterminatedString());\n          };\n          if (this.contents[pos] == '{') {\n            count = 0;\n            loop {\n              if (pos >= this.contents.size()) {\n                this.error(pos, UnterminatedString());\n              };\n              if (this.contents[pos] == '{') {\n                !count = count + 1;\n                !pos = pos + 1;\n                continue\n              };\n              if (this.contents[pos] == '}') {\n                !count = count - 1;\n                if (count == 0) break void;\n                !pos = pos + 1;\n                continue;\n              };\n              !pos = pos + 1;\n            }\n          } else {\n            continue\n          };\n        };\n        if (c == '`') {\n          !pos = pos + 1;\n          break void;\n        };\n        !pos = pos + 1;\n      };\n      mkToken(TKBackTick())\n\n    | '.' ->\n      !pos = pos + 1;\n      if (\n        pos + 1 < this.contents.size() &&\n        this.contents[pos] == '.' &&\n        this.contents[pos + 1] == '.'\n      ) {\n        !pos = pos + 2;\n        mkToken(TKDotDotDot())\n      } else {\n        mkToken(TKDot())\n      }\n\n    | ',' ->\n      !pos = pos + 1;\n      mkToken(TKComma())\n\n    | ';' ->\n      !pos = pos + 1;\n      mkToken(TKSemi())\n\n    | ':' ->\n      !pos = pos + 1;\n      mkToken(TKColon())\n\n    | '<' if (this.inType) ->\n      !pos = pos + 1;\n      mkToken(TKLessThan())\n\n    | '>' if (this.inType) ->\n      !pos = pos + 1;\n      mkToken(TKGreaterThan())\n\n    | c if (\n      c >= 'a' && c <= 'z' ||\n      c >= 'A' && c <= 'Z' ||\n      c == '_' ||\n      c == '$' ||\n      c == '#'\n    ) ->\n      !pos = pos + 1;\n      loop {\n        if (pos >= this.contents.size()) break void;\n        l = this.contents[pos];\n        if (\n          l >= 'a' && l <= 'z' ||\n          l >= 'A' && l <= 'Z' ||\n          l == '_' ||\n          l == '$' ||\n          l >= '0' && l <= '9'\n        ) {\n          !pos = pos + 1;\n          continue\n        };\n        break void;\n      };\n      Some(Token(TKVar(), Pos(start), Pos(pos)))\n\n    | c if (c >= '0' && c <= '9') ->\n      loop {\n        l = this.contents[pos];\n        if (\n          l >= '0' && l <= '9' ||\n          l == 'E' ||\n          l == 'e' ||\n          l == '.' ||\n          l == 'x' ||\n          l == 'X' ||\n          l == 'b' ||\n          l == 'B' ||\n          l == '_' ||\n          l >= 'a' && l <= 'f' ||\n          l >= 'A' && l <= 'F'\n        ) {\n          !pos = pos + 1;\n          continue\n        };\n        break void;\n      };\n      if (pos < this.contents.size() && this.contents[pos] == 'n') {\n        !pos = pos + 1;\n        mkToken(TKBigInt())\n      } else {\n        mkToken(TKNumber())\n      }\n\n    | '~' ->\n      !pos = pos + 1;\n      mkToken(TKTild())\n\n    | c ->\n      savedPos = pos;\n      if (!specialChars.contains(c)) {\n        this.error(pos, UnknownCharacter(c));\n      };\n      loop {\n        if (pos >= this.contents.size()) break void;\n        if (specialChars.contains(this.contents[pos])) {\n          !pos = pos + 1;\n          continue;\n        };\n        break void;\n      };\n      str = String::fromChars(this.contents.slice(start, pos));\n      operators.maybeGet(str) match {\n      | None() ->\n        if (str.startsWith(\"?\")) {\n          !pos = savedPos + 1;\n          mkToken(TKQuestionMark())\n        } else if (str.startsWith(\"!\")) {\n          !pos = savedPos + 1;\n          mkToken(TKExclamationMark())\n        } else if (str.startsWith(\"/\")) {\n          !pos = savedPos + 1;\n          mkToken(TKDivision())\n        } else {\n          this.error(pos, UnknownOperator(str));\n        }\n      | Some(kind) -> mkToken(kind)\n      }\n    }\n  }\n\n  mutable fun next(): ?Token {\n    tokOpt = this.peek();\n    this.!lastTok = tokOpt;\n    tokOpt match {\n    | None() -> tokOpt\n    | Some(tok) ->\n      this.!pos = tok.posEnd.value;\n      tokOpt\n    }\n  }\n\n  readonly fun getLastPos(): Pos {\n    this.lastTok.fromSome().posEnd\n  }\n\n  // Record a symbol location for tracking - only stores first occurrence\n  mutable fun recordSymbolLocation(symbol: SymbolicPos, position: Int): void {\n    this.symbolLocations.maybeGet(symbol) match {\n    | None() -> this.symbolLocations.set(symbol, position)\n    | Some(_existingPos) ->\n      // Symbol already exists - keep the first occurrence, ignore subsequent ones\n      // This allows for TypeScript method overloads and interface redeclarations\n      void\n    }\n  }\n\n  // Get recorded location for a symbol\n  readonly fun getSymbolLocation(symbol: SymbolicPos): ?Int {\n    this.symbolLocations.maybeGet(symbol)\n  }\n\n  // Check if a symbol is already defined\n  readonly fun isSymbolDefined(symbol: SymbolicPos): Bool {\n    this.symbolLocations.maybeGet(symbol).isSome()\n  }\n\n  // Get all recorded symbols and their locations\n  readonly fun getAllSymbolLocations(): Map<SymbolicPos, Int> {\n    this.symbolLocations.chill()\n  }\n}\n\nmodule end;\n"}, {"path": "src/Main.sk", "mtime": 1762775914, "contents": "module SKJS;\n\n/***************************************************************************/\n// Version\n/***************************************************************************/\n\nconst kVersion: String = \"0.9\";\n\n/***************************************************************************/\n// Help\n/***************************************************************************/\n\nfun help(): (Cli.Command, Cli.ParseResults ~> void) {\n  (\n    Cli.Command(\"help\")\n      .arg(\n        Cli.Arg::string(\"command\")\n          .positional()\n          .about(\n            \"If specified, the subcommand for which help is to be displayed\",\n          ),\n      )\n      .about(\"Displays help for a skjs subcommand\"),\n    execHelp,\n  )\n}\n\nfun execHelp(args: Cli.ParseResults): void {\n  optSubcmd = args.maybeGetString(\"command\");\n  optSubcmd.flatMap(subcmd ->\n    args.cmd._subcommands.filter(cmd -> cmd.name == subcmd).maybeGet(0)\n  ) match {\n  | Some(cmd) -> print_string(Cli.usage(cmd, true, Some(args.cmd)))\n  | _ ->\n    optSubcmd match {\n    | Some(subcmd) -> print_error(`error: Invalid subcommand ${subcmd}.`)\n    | _ -> print_string(Cli.usage(args.cmd, true))\n    }\n  };\n}\n\n/***************************************************************************/\n// Main entry point\n/***************************************************************************/\n\nfun main_no_exit(): void {\n  saved = SKStore.newObstack();\n  cmd = Cli.Command(\"skjs\")\n    .about(\"SKJS SKIP development framework\")\n    .arg(\n      Cli.Arg::bool(\"version\")\n        .short(\"V\")\n        .long(\"version\")\n        .about(\"Print version info and exit\"),\n    )\n    .arg(\n      Cli.Arg::bool(\"verbose\")\n        .short(\"v\")\n        .long(\"verbose\")\n        .about(\"Use verbose output\")\n        .global(),\n    );\n  suppliers = Array[check, run, help];\n  commands = mutable Map[];\n  for (supplier in suppliers) {\n    (subcommand, cmdFn) = supplier();\n    !cmd = cmd.subcommand(subcommand);\n    commands.set(subcommand.name, cmdFn);\n  };\n  !cmd = cmd.help();\n  args = cmd.parseArgs();\n  if (args.getBool(\"version\")) {\n    print_string(Environ.args().next().default(\"skjs\") + \" \" + kVersion);\n    SKStore.destroyObstack(saved);\n    throw Exit(0);\n  } else {\n    args.maybeGetSubcommand() match {\n    | Some(subcmd) ->\n      commands.maybeGet(subcmd) match {\n      | Some(handler) ->\n        throw Exit(\n          if (args.getBool(\"backtrace\", Some(false))) {\n            handler(args);\n            SKStore.destroyObstack(saved);\n            0\n          } else {\n            try {\n              handler(args);\n              SKStore.destroyObstack(saved);\n              0\n            } catch {\n            | exn ->\n              e = SKStore.destroyObstackWithValue(saved, exn);\n              throw e\n            }\n          },\n        )\n      | _ -> internal_error(`Unknown subcommand ${subcmd}`)\n      }\n    | None() ->\n      print_string(Cli.usage(args.cmd, true));\n      SKStore.destroyObstack(saved);\n      throw Exit(0)\n    }\n  };\n}\n\nclass Exit(code: Int) extends Exception\n\nfun main(): void {\n  try {\n    main_no_exit()\n  } catch {\n  | Exit(code) -> skipExit(code)\n  | e -> throw e\n  }\n}\n\n/***************************************************************************/\n/* Runs a specific file */\n/***************************************************************************/\n\nfun run(): (Cli.Command, Cli.ParseResults ~> void) {\n  (\n    Cli.Command(\"run\")\n      .about(\"Typecheck, then run using Bun runtime\")\n      .arg(\n        Cli.Arg::string(\"main\")\n          .value_name(\"PATH\")\n          .about(\n            \"Path to main (defaults to first source file, required if none are provided at command line)\",\n          ),\n      )\n      .args(checkArgs),\n    execRun,\n  )\n}\n\nfun execRun(args: Cli.ParseResults): void {\n  status = execCheckWithStatus(args);\n  if (status != 0) return void;\n  fileName = args.getArray(\"src-file\").maybeFirst() match {\n  | Some(firstSrcFile) -> firstSrcFile\n  | None() ->\n    args.maybeGetString(\"main\") match {\n    | Some(mainSrcFile) -> mainSrcFile\n    | None() ->\n      print_error(\"--main is required when no source files are provided\");\n      throw Exit(2)\n    }\n  };\n  if (!fileName.startsWith(\"./\")) {\n    print_error(\"File does not start with ./: \" + fileName);\n    throw Exit(2);\n  };\n  if (!FileSystem.exists(fileName)) {\n    print_error(\"File not found: \" + fileName);\n    throw Exit(2);\n  };\n  Posix.execvp(Array[\"bun\", fileName])\n}\n\n/***************************************************************************/\n/* Typechecks the files */\n/***************************************************************************/\n\nconst checkArgs: Array<Cli.Arg> = Array[\n  Cli.Arg::string(\"src-file\")\n    .positional()\n    .repeatable()\n    .about(\"Source files (default: src/**/*.ts)\"),\n  Cli.Arg::string(\"dir\")\n    .value_name(\"PATH\")\n    .about(\"Source directory to check (default: src)\"),\n  Cli.Arg::string(\"init\").about(\"Initializes persistent cache\"),\n  Cli.Arg::string(\"data\").about(\"Uses persistent cache\"),\n  Cli.Arg::bool(\"backtrace\")\n    .short(\"b\")\n    .long(\"backtrace\")\n    .about(\"Internal (debugging)\"),\n  Cli.Arg::string(\"base-url\")\n    .value_name(\"PATH\")\n    .about(\"Base directory from which to resolve modules\"),\n  Cli.Arg::string(\"builtins-file\")\n    .value_name(\"PATH\")\n    .about(\n      \"Path to the file containing type declarations for JavaScript builtins (default: IMPORT-PATH/@types/skjs/index.d.ts)\",\n    ),\n  Cli.Arg::string(\"import-stubs\")\n    .value_name(\"IMPORT-PATH\")\n    .repeatable()\n    .about(\"Path to directory containing stubs for imports\"),\n  Cli.Arg::bool(\"log-affected-files\").about(\n    \"Output a list of files potentially affected by changes since laqst run.  Requires `--data` persistent cache.\",\n  ),\n];\n\nfun check(): (Cli.Command, Cli.ParseResults ~> void) {\n  (\n    Cli.Command(\"check\").about(\"Typecheck some source file(s)\").args(checkArgs),\n    execCheck,\n  )\n}\n\nfun execCheck(args: Cli.ParseResults): void {\n  status = execCheckWithStatus(args);\n  throw Exit(status);\n}\n\nconst sinkDirName: SKStore.DirName = SKStore.DirName::create(\"/sink/\");\n\nfun execCheckWithStatus(args: Cli.ParseResults): Int {\n  backtrace = args.getBool(\"backtrace\");\n  baseUrlOpt = args.maybeGetString(\"base-url\");\n  importStubs = args.getArray(\"import-stubs\");\n  builtinsFileName = args.maybeGetString(\"builtins-file\") match {\n  | Some(x) -> x\n  | None() ->\n    importStubs.size() match {\n    | 0 ->\n      print_error(\n        \"--builtins-file unspecified but --import-stubs unspecified as well\",\n      );\n      throw Exit(2)\n    | 1 -> Path.join(importStubs[0], \"@types/skjs/index.d.ts\")\n    | _ ->\n      print_error(\n        \"--bultins-file unspecified but more than one --import-stubs specified\",\n      );\n      throw Exit(2)\n    }\n  };\n  logAffectedFiles = args.getBool(\"log-affected-files\");\n  sourceDirOpt = args.maybeGetString(\"dir\");\n  if (logAffectedFiles) {\n    if (args.maybeGetString(\"init\").isSome()) {\n      print_error(\n        \"--log-affected-files is incompatible with --init; run with --data after initializing\",\n      );\n      throw Exit(2);\n    };\n    if (args.maybeGetString(\"data\").isNone()) {\n      print_error(\n        \"--log-affected-files requires a persisted cache of results; did you run with --init? \",\n      );\n      throw Exit(2);\n    };\n  };\n  srcFiles: Sequence<String> = args.getArray(\"src-file\");\n  errorsDirName = SKStore.DirName::create(\"/check/errors/\");\n\n  context = SKStore.runWithGcReturnContext(\n    SKStore.Context::create{},\n    (context) ~> {\n      files = Files::create(\n        context,\n        baseUrlOpt,\n        builtinsFileName,\n        srcFiles,\n        logAffectedFiles,\n        sourceDirOpt,\n        importStubs,\n      ) match {\n      | Failure(err) ->\n        print_error(err);\n        return SKStore.CStop(None())\n      | Success(checker) -> checker\n      };\n\n      _ = applyOrReuseMap(\n        getInitDir(context),\n        SKStore.UnitID::keyType,\n        SKStore.VoidFile::type,\n        context,\n        sinkDirName,\n        (context, _writer, _key, _values) ~> {\n          checker = Checker::create{context, files, backtrace};\n          checked = checker.checkFiles(context);\n          _ = checked.map(\n            SKStore.UnitID::keyType,\n            SKStore.StringFile::type,\n            context,\n            errorsDirName,\n            (context, writer, _key, valueIter) ~> {\n              (parseErrorOpt, typeErrors) = valueIter.getUnique() match {\n              | None() ->\n                internal_error(\"Unexpected missing value in print-errors\")\n              | Some(CheckResult(_, x, y, _, _)) -> (x, y)\n              };\n              errors = mutable Vector[];\n              parseErrorOpt match {\n              | None() -> void\n              | Some(err) ->\n                errors.push(\n                  SKStore.StringFile(checker.errorToString(context, err)),\n                )\n              };\n\n              for (error in typeErrors) {\n                errors.push(\n                  SKStore.StringFile(checker.errorToString(context, error)),\n                );\n              };\n              writer.setArray(SKStore.UnitID::singleton, errors.toArray());\n            },\n          );\n          _ = CallGraph::build(context, checked);\n        },\n      );\n      context.update();\n      if (logAffectedFiles) {\n        CallGraph::create(context).each(callgraph -> {\n          (_addedDefs, removedDefs) = files.getChangedDefs(context);\n          callgraph.affectedFiles(context, removedDefs).each(print_string);\n        })\n      };\n\n      SKStore.CStop(None())\n    },\n  );\n  context.maybeGetEagerDir(errorsDirName) match {\n  | None() -> 2\n  | Some(dir) ->\n    errors = dir.getArrayRaw(SKStore.UnitID::singleton);\n    for (error in errors) {\n      print_error(SKStore.StringFile::type(error).value);\n      print_error(\"\");\n    };\n    if (errors.size() != 0) 2 else 0\n  }\n}\n\nclass CheckResult(\n  fileName: String,\n  parseError: ?Error,\n  errors: Array<Error>,\n  callgraph: ?CallGraphFile = None(),\n  classHierarchy: ?ClassHierarchyFile = None(),\n) extends SKStore.File\n\nclass Checker private {\n  files: Files,\n  parsedFiles: SKStore.EHandle<SKStore.SID, ParsedResultFile>,\n  checker: TypeChecker,\n  newLinesMap: NewLinesMap,\n  symbolsMap: SymbolsMap,\n} {\n  static fun create{\n    context: mutable SKStore.Context,\n    files: Files,\n    backtrace: Bool = false,\n  }: this {\n    newLinesMap = NewLinesMap::create(context, files);\n    index = FileNameIndex::create(context, files.filesContent);\n    (parsedAndSymbolsFiles, symbolsMap) = files.parse(context, newLinesMap);\n    parsedFiles = removeSymbols(context, parsedAndSymbolsFiles);\n    fileDefsMap = FileDefsMap::create(\n      context,\n      index,\n      files.rootOpt,\n      files.importStubs,\n      parsedFiles,\n    );\n    builtinDefs = fileDefsMap.get(context, files.builtinsFileName);\n    builtins = builtinDefs.defs.items().map(x -> x.i0).collect(Set);\n    builtinsFileName = files.builtinsFileName;\n    defMap = DefMap{index, fileDefsMap, builtins, builtinsFileName};\n    tenv = TEnv{defMap};\n    checker = TypeChecker{builtins, backtrace, defMap, tenv, builtinsFileName};\n    static{files, parsedFiles, checker, newLinesMap, symbolsMap}\n  }\n\n  fun checkFiles(\n    context: mutable SKStore.Context,\n  ): SKStore.EHandle<SKStore.SID, CheckResult> {\n    this.parsedFiles.map(\n      SKStore.SID::keyType,\n      CheckResult::type,\n      context,\n      SKStore.DirName::create(\"/check-results/\"),\n      (context, writer, fileNameKey, valueIter) ~> {\n        parsedFile = valueIter.getUnique() match {\n        | None() -> internal_error(\"File not parsed\")\n        | Some(x) -> x\n        };\n        parsedFile.value match {\n        | PROk(defs) ->\n          initCallGraph(context);\n          errors = this.checker.check(context, defs);\n          writer.set(\n            fileNameKey,\n            CheckResult(\n              fileNameKey.value,\n              None(),\n              errors,\n              collectCallGraph(context),\n            ),\n          )\n        | PRError(err) ->\n          writer.set(\n            fileNameKey,\n            CheckResult(fileNameKey.value, Some(err), Array[]),\n          )\n        }\n      },\n    );\n  }\n\n  fun errorToString(context: mutable SKStore.Context, err: Error): String {\n    err.toString(context, this.newLinesMap, this.symbolsMap)\n  }\n}\n\nmodule end;\n"}, {"path": "src/ModuleResolver.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Module performing the module name resolution for SKJS. */\n/***************************************************************************/\n\nmodule alias S = SKStore;\n\nmodule SKJS;\n\n/***************************************************************************/\n// Primitives used to manipulate file names, directory names etc ...\n/***************************************************************************/\n\nfun splitPath(dirNameStr: String): Array<String> {\n  result = mutable Vector<String>[];\n  for (elt in dirNameStr.split(\"/\").filter(x -> x != \"\")) {\n    if (elt == \".\") continue;\n    result.push(elt)\n  };\n  result.toArray()\n}\n\nfun removeDotDot(path: Array<String>): Array<String> {\n  result = mutable Vector<String>[];\n  for (elt in path) {\n    if (elt == \"..\") {\n      result.maybePop() match {\n      | None() -> internal_error(\"Invalid path: \" + path)\n      | Some(_) -> continue\n      }\n    };\n    result.push(elt)\n  };\n  result.toArray();\n}\n\nbase class DirName(path: Array<String>) uses Orderable, Show {\n  children =\n  | DRelative()\n  | DAbsolute()\n\n  fun +(other: FileName): FileName {\n    !other.dirName = this / other.dirName;\n    other\n  }\n\n  fun /(other: DirName): DirName {\n    (this, other) match {\n    | (DRelative(d1), DRelative(d2)) -> DRelative(d1.concat(d2))\n    | (DRelative _, DAbsolute _) ->\n      internal_error(\n        \"Internal error: cannot add an absolute path to a relative one\",\n      )\n    | (DAbsolute(d1), DRelative(d2)) -> DAbsolute(removeDotDot(d1.concat(d2)))\n    | (DAbsolute _, DAbsolute _) ->\n      internal_error(\n        \"Internal error: cannot add an absolute path to another absolute path\",\n      )\n    }\n  }\n\n  fun toString(): String {\n    if (this.path.size() == 0) return \"/\";\n    \"/\" + this.path.join(\"/\") + \"/\"\n  }\n\n  fun endsWith(str: String): Bool {\n    if (str == \"\") internal_error(\"str should not be empty\");\n    this.path.size() > 0 && this.path[this.path.size() - 1] == str\n  }\n\n  static fun create(dirNameStr: String): DirName {\n    path = splitPath(dirNameStr);\n    if (dirNameStr.startsWith(\"/\")) DAbsolute(removeDotDot(path)) else {\n      DRelative(path)\n    }\n  }\n\n  fun allAncestors(): mutable Iterator<DirName> {\n    this match {\n    | DRelative(_) ->\n      internal_error(\n        \"Internal error: cannot call allAncestors on a relative path\",\n      )\n    | DAbsolute(path) ->\n      for (i in Range(0, path.size())) {\n        yield (DAbsolute(this.path.slice(0, this.path.size() - i)))\n      }\n    }\n  }\n\n  fun exists(): Bool {\n    FileSystem.exists(this.toString())\n  }\n}\n\nclass FileName(dirName: DirName, baseName: String) {\n  static fun create(fileName: String): this {\n    if (fileName.endsWith(\"/\")) {\n      internal_error(`File name '${fileName}' is not expected to end with /`)\n    };\n    vec = splitPath(fileName);\n    path = vec.slice(0, vec.size() - 1);\n    dirName = if (fileName.startsWith(\"/\")) {\n      DAbsolute(path)\n    } else {\n      DRelative(path)\n    };\n    baseName = vec[vec.size() - 1];\n    static(dirName, baseName)\n  }\n\n  fun toString(): String {\n    this.dirName.toString() + this.baseName\n  }\n\n  fun exists(): Bool {\n    FileSystem.exists(this.toString())\n  }\n\n  fun hash(): Int {\n    hash = this.baseName.hash();\n    for (elt in this.dirName.path) {\n      !hash = 3 * hash + elt.hash();\n    };\n    hash\n  }\n}\n\n/***************************************************************************/\n/* Class to help lookup file names quickly. */\n/***************************************************************************/\n\nclass FileNameEntry(\n  invertedName: String,\n  name: String,\n) extends S.File uses Orderable {\n  static fun create(fileName: String): this {\n    inv = mutable Vector[];\n    chars = fileName.chars();\n    for (i in Range(0, chars.size())) {\n      inv.push(chars[chars.size() - i - 1]);\n    };\n    static(String::fromChars(inv.toArray()), fileName)\n  }\n\n  fun compare(other: FileNameEntry): Order {\n    this.invertedName.compare(other.invertedName)\n  }\n}\n\nclass NodeModuleDir(entries: Array<FileNameEntry>) extends S.File {\n  fun lookup(fileName: FileName): ?FileName {\n    fileNameStr = fileName.toString();\n    if (fileNameStr.contains(\"..\")) {\n      internal_error(\n        `File name '${fileNameStr}' is not expected to contain '..'`,\n      )\n    };\n    entry = FileNameEntry::create(fileNameStr);\n    idx = SKStore.binSearch(\n      i ~> this.entries[i].invertedName,\n      entry.invertedName,\n      0,\n      this.entries.size() - 1,\n    );\n    if (idx < 0 || idx >= this.entries.size()) return None();\n    if (this.entries[idx].invertedName.startsWith(entry.invertedName)) {\n      return Some(FileName::create(this.entries[idx].name))\n    };\n    None();\n  }\n}\n\nclass FileNameIndex private (modules: S.EHandle<S.SID, NodeModuleDir>) {\n  static fun create(\n    context: mutable S.Context,\n    fileNames: S.EHandle<S.SID, S.StringFile>,\n  ): this {\n    static(\n      fileNames\n        .map(\n          S.SID::keyType,\n          FileNameEntry::type,\n          context,\n          S.DirName::create(\"/skjs/file/index/\"),\n          (_context, writer, key, _valueIter) ~> {\n            fileName = key.value;\n            for (ancestor in FileName::create(\n              fileName,\n            ).dirName.allAncestors()) {\n              if (ancestor.endsWith(\"node_modules\")) {\n                modulePath = ancestor.toString();\n                writer.set(S.SID(modulePath), FileNameEntry::create(fileName));\n                return void\n              }\n            }\n          },\n        )\n        .map(\n          S.SID::keyType,\n          NodeModuleDir::type,\n          context,\n          S.DirName::create(\"/skjs/node_modules/index/\"),\n          (_context, writer, key, valueIter) ~> {\n            writer.set(key, NodeModuleDir(valueIter.toArray().sorted()))\n          },\n        ),\n    )\n  }\n\n  fun lookup(\n    context: mutable S.Context,\n    path: DirName,\n    file: FileName,\n  ): ?FileName {\n    if (!(path is DAbsolute _)) internal_error(\"path should be DAbsolute\");\n    for (ancestor in path.allAncestors()) {\n      this.modules.maybeGet(\n        context,\n        S.SID((ancestor / DirName::create(\"node_modules/\")).toString()),\n      ) match {\n      | None() -> continue\n      | Some(mod) ->\n        mod.lookup(file) match {\n        | None() -> void\n        | x @ Some(_) -> return x\n        }\n      }\n    };\n    None()\n  }\n}\n\n/***************************************************************************/\n// Given an import statement in a TypeScript file: 1. Determine the\n// import path from the import statement.  2. Resolve the module\n// according to the following steps:\n\n//     a. If the import path is a relative path (starts with \"./\" or\n//         \"../\"): i. Try appending \".ts\", \".tsx\", \".d.ts\" to the path\n//         and check if the file exists.  ii. If the file does not exist,\n//         try treating the path as a directory and look for an\n//         \"index.ts\", \"index.tsx\", or \"index.d.ts\" file in that\n//         directory.\n\n//     b. If the import path is a non-relative module name: i. Look in\n//         the nearest node_modules directory.  ii. Travel up the\n//         directory tree and look into each node_modules directory until\n//         the root of the file system is reached.  iii. In each\n//         node_modules directory, attempt to find the module. For a\n//         module named \"Example\", look for\n//         \"Example.d.ts\". If not found, it then looks for a package.json\n//         file in the \"Example\" directory, and reads the \"typings\" or\n//         \"types\" field to determine the path to the declaration file.\n//         iv. If the package.json does not specify a \"typings\" or\n//         \"types\" field, try to find an \"index.d.ts\" file\n//         in the module's root directory.\n/***************************************************************************/\n\nfun resolveName(\n  context: mutable S.Context,\n  index: FileNameIndex,\n  rootOpt: ?DirName,\n  cwd: DirName,\n  moduleName: String,\n): ?FileName {\n  if (moduleName.endsWith(\"-js\")) {\n    !moduleName = moduleName.stripSuffix(\"-js\");\n  };\n  isAbsolute = Path.isAbsolute(moduleName);\n  if (isAbsolute || moduleName.startsWith(\".\")) {\n    if (moduleName == \".\" || moduleName == \"./\") {\n      print_error(\"Could not resolve module '.'\");\n      return None();\n    };\n    fullName = if (isAbsolute) {\n      FileName::create(moduleName)\n    } else {\n      cwd + FileName::create(moduleName)\n    };\n    suffix = Path.extname(moduleName);\n    suffix match {\n    | \".ts\" | \".tsx\" if (fullName.exists()) -> return Some(fullName)\n    | \".js\" | \".mjs\" ->\n      stripped = fullName.baseName.stripSuffix(suffix);\n      for (ext in Array[\".ts\", \".tsx\", \".d.ts\"]) {\n        tryPath = fullName with {baseName => stripped + ext};\n        if (tryPath.exists()) return Some(tryPath)\n      };\n      print_error(`Could not find file: ${fullName}`);\n      print_error(`From: ${cwd}`)\n    | _ ->\n      if (!isAbsolute) {\n        for (ext in Array[\".d.ts\", \"/index.d.ts\", \"/index.cjs\"]) {\n          tryPath = cwd + FileName::create(moduleName + ext);\n          if (tryPath.exists()) return Some(tryPath)\n        }\n      };\n      print_error(`Could not find module[3]: ${moduleName}`);\n      print_error(`From: ${cwd}`)\n    };\n    return None()\n  };\n\n  root = rootOpt.default(cwd);\n\n  for (prepost in Array[\n    (\"./@types/\", \"/index.d.ts\"),\n    (\"./@types/node/\", \".d.ts\"),\n  ]) {\n    tryPath = FileName::create(prepost.i0 + moduleName + prepost.i1);\n    index.lookup(context, root, tryPath) match {\n    | None() -> void\n    | x @ Some _ -> return x\n    }\n  };\n\n  if (moduleName.contains(\":\")) {\n    requireTypesPath =\n      root +\n      FileName::create(\n        \"./node_modules/@types/\" + moduleName.split(\":\").join(\"/\") + \".d.ts\",\n      );\n    debug(requireTypesPath.toString());\n    index.lookup(context, cwd, requireTypesPath) match {\n    | x @ Some _ -> return x\n    | _ ->\n      print_error(`Could not find module[2]: ${moduleName}`);\n      print_error(`From: ${cwd}`)\n    };\n    return None();\n  };\n\n  for (ext in Array[\n    \"/index.d.ts\",\n    \"/dist/index.d.ts\",\n    \"/dist/types/types.d.ts\",\n    \"/types/index.d.ts\",\n    \"/typing/index.d.ts\",\n  ]) {\n    index.lookup(context, cwd, FileName::create(moduleName + ext)) match {\n    | None() -> void\n    | x @ Some _ -> return x\n    }\n  };\n\n  index.lookup(\n    context,\n    cwd,\n    FileName::create(moduleName.replace(\"/\", \".\").replace(\"@\", \"\") + \".d.ts\"),\n  ) match {\n  | None() -> void\n  | x @ Some _ -> return x\n  };\n\n  //  if (moduleName.contains(\"/\")) {\n  index.lookup(context, cwd, FileName::create(moduleName + \".d.ts\")) match {\n  | None() -> void\n  | x @ Some _ -> return x\n  };\n  index.lookup(\n    context,\n    cwd,\n    FileName::create(moduleName + \"/index.cjs\"),\n  ) match {\n  | None() -> void\n  | x @ Some _ -> return x\n  };\n  //  };\n\n  debug(`Could not find module[1]: ${moduleName}`);\n  None()\n}\n\nfun resolveStubs(importStubs: Array<DirName>, moduleName: String): ?FileName {\n  for (importStub in importStubs) {\n    path = FileName(importStub / DirName::create(moduleName), \"index.d.ts\");\n    if (path.exists()) break Some(path)\n  } else {\n    debug(`Could not find module[4]: ${moduleName}`);\n    None()\n  }\n}\n\nmodule end;\n"}, {"path": "src/NewLines.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// Module resolving NewLines.\n/***************************************************************************/\n\nmodule SKJS;\n\n/***************************************************************************/\n/* Newlines directory. */\n/***************************************************************************/\n\nclass NewLinesFile(newLines: Array<Int>) extends SKStore.File\n\nfun makeNewLinesDir(\n  context: mutable SKStore.Context,\n  files: SKStore.EHandle<SKStore.SID, SKStore.StringFile>,\n): SKStore.LHandle<SKStore.SID, NewLinesFile> {\n  SKStore.LHandle::create(\n    SKStore.SID::keyType,\n    NewLinesFile::type,\n    context,\n    SKStore.DirName::create(\"/skjs/newlines/\"),\n    (context, _self, key) ~> {\n      content = files.get(context, key).value;\n      newLines = mutable Vector[];\n      i = 0;\n      for (c in content) {\n        if (c == '\\n') newLines.push(i);\n        !i = i + 1;\n      };\n      newLines.push(i);\n      Array[NewLinesFile(newLines.toArray())]\n    },\n  )\n}\n\n/***************************************************************************/\n/* Newlines map (associates Newlines to a filename) */\n/***************************************************************************/\n\nclass NewLinesMap{dir: SKStore.LHandle<SKStore.SID, NewLinesFile>} {\n  static fun create(context: mutable SKStore.Context, files: Files): this {\n    static{dir => makeNewLinesDir(context, files.filesContent)}\n  }\n  fun get(context: mutable SKStore.Context, fileName: String): Array<Int> {\n    this.dir.get(context, SKStore.SID(fileName)).newLines\n  }\n}\n\nmodule end;\n"}, {"path": "src/Parser.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Main Parser class for TypeScript parsing. */\n/***************************************************************************/\n\nmodule SKJS;\n\nmutable class Parser(lex: mutable Lexer, mutable id: Int = 1) {\n  // Set symbol context in the lexer\n  mutable fun setSymbolContext(symbol: SymbolicPos, pos: Int): void {\n    this.lex.!currentSymbol = symbol;\n    this.lex.!currentSymbolPos = pos;\n  }\n\n  // Record a symbol definition (only call this when a symbol is actually defined)\n  mutable fun recordSymbolDefinition(symbol: SymbolicPos, pos: Int): void {\n    this.lex.recordSymbolLocation(symbol, pos);\n  }\n\n  // Get current symbol context from the lexer\n  readonly fun getCurrentSymbol(): SymbolicPos {\n    this.lex.currentSymbol\n  }\n\n  // Get current symbol position from the lexer\n  readonly fun getCurrentSymbolPos(): Int {\n    this.lex.currentSymbolPos\n  }\n\n  // Get current symbol context (both symbol and position)\n  readonly fun getCurrentSymbolContext(): (SymbolicPos, Int) {\n    (this.lex.currentSymbol, this.lex.currentSymbolPos)\n  }\n\n  // Get all recorded symbol locations\n  readonly fun getAllSymbolLocations(): Map<SymbolicPos, Int> {\n    this.lex.getAllSymbolLocations()\n  }\n\n  // Get location for a specific symbol\n  readonly fun getSymbolLocation(symbol: SymbolicPos): ?Int {\n    this.lex.getSymbolLocation(symbol)\n  }\n\n  // Check if a symbol is already defined\n  readonly fun isSymbolDefined(symbol: SymbolicPos): Bool {\n    this.lex.isSymbolDefined(symbol)\n  }\n}\n\nmodule end;\n"}, {"path": "src/ParserDefs.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Definition parsing methods for the TypeScript parser. */\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class Parser {\n  /***************************************************************************/\n  // Basic parsing methods for names and symbols\n  /***************************************************************************/\n\n  // <name> ::= <string>\n  mutable fun getName(): Name {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))\n    | Some(tok) ->\n      tok.kind match {\n      | TKVar() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok),\n        )\n      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))\n      }\n    }\n  }\n\n  // <string> | \"<string>\" | '<string>'\n  mutable fun getNameOrString(): Name {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))\n    | Some(tok) ->\n      tok.kind match {\n      | TKQuote() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok).stripPrefix(\"'\").stripSuffix(\"'\"),\n        )\n      | TKDoubleQuote() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok).stripPrefix(\"\\\"\").stripSuffix(\"\\\"\"),\n        )\n      | TKVar() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok),\n        )\n      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))\n      }\n    }\n  }\n\n  // \"<string>\" | '<string>'\n  mutable fun getString(): Name {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))\n    | Some(tok) ->\n      tok.kind match {\n      | TKQuote() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok).stripPrefix(\"'\").stripSuffix(\"'\"),\n        )\n      | TKDoubleQuote() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok).stripPrefix(\"\\\"\").stripSuffix(\"\\\"\"),\n        )\n      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))\n      }\n    }\n  }\n\n  // \"<string>\" | '<string>' | <int>\n  mutable fun getNameOrStringOrInt(): Name {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKVar()))\n    | Some(tok) ->\n      tok.kind match {\n      | TKQuote() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok).stripPrefix(\"'\").stripSuffix(\"'\"),\n        )\n      | TKDoubleQuote() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok).stripPrefix(\"\\\"\").stripSuffix(\"\\\"\"),\n        )\n      | TKSubtraction() ->\n        start = tok.posStart;\n        nbr = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n        | Some(x) -> x\n        };\n        Name(\n          PosRange::create(this.lex, start, nbr.posEnd),\n          \"-\" + this.lex.getStrTok(nbr),\n        )\n      | TKNumber()\n      | TKVar() ->\n        Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          this.lex.getStrTok(tok),\n        )\n      | _ -> this.error(this.lex.posStart(tok), ExpectedToken(TKVar()))\n      }\n    }\n  }\n\n  /***************************************************************************/\n  // Symbol parsing\n  //\n  // <symbol> ::=\n  //   | <name>\n  //   | [ <name> ]\n  //   | [ <name> in <type> (? <type>)? (<fn-op>)? ]\n  //   | [ <name> : <type> ]\n  /***************************************************************************/\n\n  // Parse a symbol (used in function names and computed property names)\n  mutable fun getSymbol(): Symbol {\n    if (this.lex.peekKind() is Some(TKOpenSquare())) {\n      _ = this.lex.next();\n      if (\n        this.lex.peekKind() is Some(TKQuote()) ||\n        this.lex.peekKind() is Some(TKDoubleQuote()) ||\n        this.lex.peekKind() is Some(TKSubtraction()) ||\n        this.lex.peekKind() is Some(TKAddition())\n      ) {\n        name = this.getNameOrStringOrInt();\n        this.expect(TKCloseSquare());\n        FNNormal(name);\n      } else {\n        fname = this.getName();\n        if (this.lex.isEq(\"in\")) {\n          _ = this.lex.next();\n          ty = this.type(0);\n          asOpt = if (this.lex.isEq(\"as\")) {\n            _ = this.lex.next();\n            Some(this.type(0))\n          } else {\n            None()\n          };\n          this.expect(TKCloseSquare());\n          op = if (this.lex.peekKind() is Some(TKRemoveQM())) {\n            tokRemove = this.lex.next().fromSome();\n            Some(\n              FNRemove(\n                PosRange::create(\n                  this.lex,\n                  tokRemove.posStart,\n                  tokRemove.posEnd,\n                ),\n              ),\n            );\n          } else if (this.lex.peekKind() is Some(TKAddQM())) {\n            tokAdd = this.lex.next().fromSome();\n            Some(\n              FNAdd(PosRange::create(this.lex, tokAdd.posStart, tokAdd.posEnd)),\n            );\n          } else if (this.lex.peekKind() is Some(TKQuestionMark())) {\n            tokQuestion = this.lex.next().fromSome();\n            Some(\n              FNQuestion(\n                PosRange::create(\n                  this.lex,\n                  tokQuestion.posStart,\n                  tokQuestion.posEnd,\n                ),\n              ),\n            )\n          } else {\n            None()\n          };\n          FNIn(fname, ty, asOpt, op)\n        } else if (this.lex.peekKind() is Some(TKColon())) {\n          _ = this.lex.next();\n          indexType = this.type(0);\n          this.expect(TKCloseSquare());\n          FNColon(fname, indexType)\n        } else {\n          this.expect(TKCloseSquare());\n          FNSymbol(fname);\n        }\n      }\n    } else {\n      FNNormal(this.getNameOrStringOrInt())\n    }\n  }\n\n  /***************************************************************************/\n  // Modifier parsing\n  //\n  // <modifier> =\n  //   | protected\n  //   | private\n  //   | public\n  //   | static\n  //   | abstract\n  //   | readonly\n  /***************************************************************************/\n\n  // Parse modifiers for class members and variables\n  mutable fun modifiers(isRemove: ?PosRange): Modifiers {\n    modifiers = mutable Vector[];\n    loop {\n      if (\n        isRemove is None() &&\n        this.lex.lookAhead(() -> {\n          _ = this.lex.next();\n          !(this.lex.peekKind() is Some(TKVar()))\n        })\n      ) break void;\n      mod = this.lex.peekStr() match {\n      | Some(\"abstract\") -> ModAbstract\n      | Some(\"async\") -> ModAsync\n      | Some(\"private\") -> ModPrivate\n      | Some(\"protected\") -> ModProtected\n      | Some(\"public\") -> ModPublic\n      | Some(\"readonly\") -> ModReadonly\n      | Some(\"static\") -> ModStatic\n      | _ -> break void\n      };\n      nameTok = this.lex.next().fromSome();\n      modifiers.push(\n        mod(PosRange::create(this.lex, nameTok.posStart, nameTok.posEnd)),\n      )\n    };\n    Modifiers(isRemove, modifiers.toArray())\n  }\n\n  /***************************************************************************/\n  // Get/Set modifier recognition\n  //\n  // Recognizes get/set modifiers. In JS, it is legal to write something like:\n  // obj = {\n  //    get myfield() { ... some code ... }\n  // };\n  //\n  // When you do that, it means that the method \"myfield\" will be\n  // called every time the field \"myfield\" is accessed. So concretely,\n  // if you write obj.myfield, instead of accessing a field, you are\n  // really executing a method.\n  /***************************************************************************/\n\n  // Check if current token is a getter or setter\n  mutable fun isGetSet(): ?FieldGetSet {\n    if (\n      this.lex.peekStr() is Some(\"get\") ||\n      this.lex.peekStr() is Some(\"set\")\n    ) {\n      kind = if (this.lex.peekStr() is Some(\"get\")) FGet() else FSet();\n      isGetterOrSetter = this.lex.lookAhead(() -> {\n        _ = this.lex.next();\n        this.lex.next().map(x -> x.kind) is Some(TKVar());\n      });\n      if (isGetterOrSetter) {\n        nextTok = this.lex.next().fromSome();\n        Some(\n          FieldGetSet(\n            kind,\n            PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd),\n          ),\n        )\n      } else {\n        None()\n      }\n    } else {\n      None()\n    }\n  }\n\n  /***************************************************************************/\n  // Field parsing\n  //\n  // Parses fields that are not methods.\n  // <field> ::= <name> : <expr> | ... <expr>\n  /***************************************************************************/\n\n  // Parse a normal field type (not a method)\n  mutable fun getNormalFieldType(\n    fieldPos: PosRange,\n    modifiers: Modifiers,\n    fieldGetSet: ?FieldGetSet,\n    fieldName: Symbol,\n    isOptional: ?PosRange,\n  ): FieldType {\n    fieldValue = if (this.lex.peekKind() is Some(TKAssignment())) {\n      _ = this.lex.next();\n      Some(this.expr(0))\n    } else {\n      None()\n    };\n    this.expect(TKColon());\n    fieldType = this.type(0);\n    if (this.lex.peekKind() is Some(TKAssignment())) {\n      eqTok = this.lex.next().fromSome();\n      if (fieldValue is Some _) {\n        this.error(this.lex.posStart(eqTok), UnexpectedToken())\n      };\n      !fieldValue = Some(this.expr(0));\n    };\n    FieldTypeValue{\n      pos => fieldPos,\n      setGet => fieldGetSet,\n      modifiers,\n      name => fieldName,\n      optional => isOptional,\n      type => fieldType,\n      value => fieldValue,\n    }\n  }\n\n  // Parse a field type (method or normal field)\n  mutable fun getFieldType(modifiers: Modifiers): FieldType {\n    fieldGetSet = this.isGetSet();\n    fieldNamePos = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n    | Some(x) -> x.posStart\n    };\n    fieldName = this.getSymbol();\n    fieldPos = PosRange::create(\n      this.lex,\n      this.lex.getLastPos(),\n      this.lex.getLastPos(),\n    );\n    isOptional = if (this.lex.peekKind() is Some(TKQuestionMark())) {\n      tok = this.lex.next().fromSome();\n      Some(PosRange::create(this.lex, tok.posStart, tok.posEnd));\n    } else {\n      None()\n    };\n    fieldName match {\n    | methodName @ SimpleSymbol _ if (\n      this.lex.peekKind() is Some(TKOpenParen()) ||\n      this.lex.peekKind() is Some(TKLessThan())\n    ) ->\n      this.methodDef(\n        None(),\n        modifiers,\n        fieldGetSet,\n        (fieldNamePos, methodName),\n        true,\n        isOptional,\n        None(),\n      )\n    | _ ->\n      this.getNormalFieldType(\n        fieldPos,\n        modifiers,\n        fieldGetSet,\n        fieldName,\n        isOptional,\n      )\n    }\n  }\n\n  // Parse object fields (used in object types and object literals)\n  mutable fun objectFields(): Array<FieldType> {\n    if (this.lex.peekKind() is Some(TKCloseCurly())) {\n      _ = this.lex.next();\n      return Array[];\n    };\n    fields = mutable Vector<FieldType>[];\n    loop {\n      removeModifiers = if (this.lex.peekKind() is Some(TKSubtraction())) {\n        nextTok = this.lex.next().fromSome();\n        Some(PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd))\n      } else {\n        None()\n      };\n      modifiers = this.modifiers(removeModifiers);\n      if (\n        this.lex.peekKind() is Some(TKOpenParen()) ||\n        this.lex.peekKind() is Some(TKLessThan())\n      ) {\n        method = this.anonMethodDef(\n          None(),\n          modifiers,\n          None(),\n          None(),\n          false,\n          None(),\n          None(),\n        );\n        fields.push(method);\n      } else {\n        field = this.getFieldType(modifiers);\n        fields.push(field)\n      };\n      semiTok = this.lex.peek() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      semiTok.kind match {\n      | TKCloseCurly() ->\n        _ = this.lex.next();\n        break void\n      | TKComma()\n      | TKSemi() ->\n        _ = this.lex.next();\n        if (this.lex.peekKind() is Some(TKCloseCurly())) {\n          _ = this.lex.next();\n          break void\n        }\n      | _ -> void\n      }\n    };\n    fields.toArray()\n  }\n\n  /***************************************************************************/\n  // Definition parsing\n  //\n  // <def> ::=\n  //   | <expr>\n  //   | type <name> [ <type-param>* ] <type>\n  //   | class\n  //   | enum <name> { (<name> = <expr>?)* }\n  //   | namespace <name> { <def>* }\n  //   | module <name> { <def>* }\n  //   | export (type? <module-names> from <expr>?)\n  //   | export (type? default?) <def>\n  //   | export default (type?) <expr>\n  //   | export = <expr>\n  //   | export as <name>\n  //   | export import <name> = <expr>\n  //   | global { <def>* }\n  //   | import (type?) <module-names> <import-name> (from <import-kind>)\n  //   | import <name>\n  //   | declare <def>\n  //   | <var-def-kind> { <var-def>* }\n  /***************************************************************************/\n\n  // Parse a definition\n  mutable fun def(topLevel: Bool): Def {\n    while (this.lex.peekKind() is Some(TKSemi())) {\n      _ = this.lex.next();\n    };\n    this.defHelper(topLevel)\n  }\n\n  // Parse top-level definitions\n  mutable fun toplevelDefs(): Array<Def> {\n    defs = mutable Vector[];\n    loop {\n      this.maybeDef(true) match {\n      | None() -> return defs.toArray()\n      | Some(def) -> defs.push(def)\n      }\n    }\n  }\n\n  // Parse a block of definitions\n  mutable fun defs(topLevel: Bool): Array<Def> {\n    this.expect(TKOpenCurly());\n    if (this.lex.peekKind() is Some(TKCloseCurly())) {\n      _ = this.lex.next();\n      return Array[]\n    };\n    defs = mutable Vector[];\n    loop {\n      def = this.def(topLevel);\n      defs.push(def);\n      loop {\n        if (this.lex.peekKind() is Some(TKSemi())) {\n          _ = this.lex.next();\n          continue;\n        };\n        break void;\n      };\n      if (this.lex.peekKind() is Some(TKCloseCurly())) {\n        _ = this.lex.next();\n        break defs.toArray()\n      }\n    }\n  }\n\n  // Try to parse a definition, returning None if at end of input\n  mutable fun maybeDef(topLevel: Bool): ?Def {\n    while (this.lex.peekKind() is Some(TKSemi())) {\n      _ = this.lex.next();\n    };\n    if (this.lex.peekKind() is None()) return None();\n    Some(this.def(topLevel))\n  }\n\n  // Helper for parsing definitions with position tracking\n  mutable fun defHelper(topLevel: Bool): Def {\n    tok = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n    | Some(x) -> x\n    };\n    start = tok.posStart;\n    def_ = this.defHelper_(topLevel);\n    end = this.lex.lastTok.fromSome().posEnd;\n    Def(PosRange::create(this.lex, start, end), def_)\n  }\n\n  // Internal definition parsing implementation\n  mutable fun defHelper_(topLevel: Bool): Def_ {\n    tok = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n    | Some(x) -> x\n    };\n    this.lex.getStrTok(tok) match {\n    | \"declare\" ->\n      _ = this.lex.next();\n      def = this.def(topLevel);\n      Declare(def)\n    | \"global\" ->\n      _ = this.lex.next();\n      Global(this.defs(false))\n    | \"namespace\" ->\n      _ = this.lex.next();\n      name = this.getName();\n      defs = this.defs(false);\n      Namespace(name, defs)\n    | \"import\" ->\n      _ = this.lex.next();\n      isType = if (this.lex.peekStr() == Some(\"type\")) {\n        nextTok = this.lex.next().fromSome();\n        Some(PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd))\n      } else {\n        None()\n      };\n      if (\n        this.lex.peekKind() is Some(TKDoubleQuote()) ||\n        this.lex.peekKind() is Some(TKQuote())\n      ) {\n        this.error(this.lex.posEnd(), InvalidImport())\n      } else {\n        importNames = this.moduleNames();\n        if (this.lex.isEq(\"from\")) {\n          _ = this.lex.next();\n          importFrom = this.getString();\n          if (\n            importFrom.value.startsWith(\"./\") ||\n            importFrom.value.startsWith(\"../\")\n          ) {\n            if (!importFrom.value.endsWith(\".js\")) {\n              this.error(this.lex.posEnd(), InvalidImport())\n            } else {\n              Import(IKFrom(), isType, importNames, INPath(importFrom))\n            }\n          } else {\n            Import(IKFrom(), isType, importNames, INName(importFrom))\n          }\n        } else {\n          this.error(this.lex.posEnd(), InvalidImport())\n        }\n      }\n    | \"export\" ->\n      _ = this.lex.next();\n      if (this.lex.isEq(\"import\")) {\n        _ = this.lex.next();\n        name = this.getName();\n        this.expect(TKAssignment());\n        e = this.expr(0);\n        return ExportImport(name, e);\n      };\n      if (this.lex.isEq(\"as\")) {\n        _ = this.lex.next();\n        this.expectStr(\"namespace\");\n        return ExportAs(this.getName());\n      };\n      if (this.lex.peekKind() is Some(TKAssignment())) {\n        _ = this.lex.next();\n        return ExportEq(this.expr(0));\n      };\n      isType = if (this.lex.peekStr() is Some(\"type\")) {\n        if (\n          this.lex.lookAhead(() -> {\n            _ = this.lex.next();\n            this.lex.next().map(x -> x.kind) is Some(TKVar()) &&\n              (this.lex.peekKind() is Some(TKAssignment()) ||\n                this.lex.peekKind() is Some(TKLessThan()))\n          })\n        ) {\n          None()\n        } else {\n          nextTok = this.lex.next().fromSome();\n          Some(PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd))\n        }\n      } else {\n        None()\n      };\n      if (\n        this.lex.peekKind() is Some(TKOpenCurly()) ||\n        this.lex.peekKind() is Some(TKMultiplication())\n      ) {\n        names = this.moduleNames();\n        maybeFrom = if (this.lex.isEq(\"from\")) {\n          _ = this.lex.next();\n          Some(this.expr(0))\n        } else {\n          None()\n        };\n        ExportNames(isType, names, maybeFrom)\n      } else {\n        default = if (this.lex.peekStr() is Some(\"default\")) {\n          nextTok = this.lex.next().fromSome();\n          Some(PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd))\n        } else {\n          None()\n        };\n        this.lex.peekStr() match {\n        | Some(\"function\") ->\n          if (\n            this.lex.lookAhead(() -> {\n              _ = this.lex.next();\n              this.lex.peekKind() is Some(TKOpenParen()) ||\n                this.lex.peekKind() is Some(TKLessThan())\n            })\n          ) {\n            if (default is None()) {\n              this.error(\n                this.lex.posStart(tok),\n                NonDefaultAnonymousFunctionExport(),\n              )\n            };\n            _ = this.lex.next();\n            Export(\n              isType,\n              default,\n              this.anonMethodDef(\n                None(),\n                Modifiers::empty(),\n                None(),\n                None(),\n                true,\n                None(),\n                None(),\n              ),\n            )\n          } else {\n            Export(isType, default, this.def(false).value)\n          }\n        | Some(\"async\")\n        | Some(\"namespace\")\n        | Some(\"declare\")\n        | Some(\"module\")\n        | Some(\"enum\")\n        | Some(\"class\")\n        | Some(\"const\")\n        | Some(\"interface\")\n        | Some(\"let\")\n        | Some(\"var\")\n        | Some(\"abstract\")\n        | Some(\"type\") ->\n          def = this.def(false);\n          Export(isType, default, def.value)\n        | _ ->\n          if (default is None()) {\n            this.error(this.lex.posStart(tok), UnexpectedToken())\n          };\n          e = this.expr(0);\n          ExportDefault(isType, e)\n        }\n      }\n    | \"async\" ->\n      asyncTok = this.lex.next().fromSome();\n      this.expectStr(\"function\");\n      this.funDef(\n        Some(PosRange::create(this.lex, asyncTok.posStart, asyncTok.posEnd)),\n        true,\n      )\n    | \"function\" ->\n      _ = this.lex.next();\n      this.funDef(None(), true)\n    | \"type\" ->\n      _ = this.lex.next();\n      this.typeDef()\n    | \"var\" ->\n      _ = this.lex.next();\n      this.varDef(VDKVar())\n    | \"const\" ->\n      _ = this.lex.next();\n      if (this.lex.peekStr() is Some(\"enum\")) {\n        enumTok = this.lex.next().fromSome();\n        posRange = PosRange::create(this.lex, enumTok.posStart, enumTok.posEnd);\n        this.enum(Some(posRange))\n      } else {\n        this.varDef(VDKConst())\n      }\n    | \"module\" ->\n      _ = this.lex.next();\n      name = this.getNameOrString();\n      defs = if (this.lex.peekKind() is Some(TKOpenCurly())) {\n        Some(this.defs(false))\n      } else {\n        None()\n      };\n      Module(name, defs)\n    | \"abstract\" ->\n      _ = this.lex.next();\n      this.expectStr(\"class\");\n      this.class_(tok.posStart.value, CKAbstract())\n    | \"enum\" ->\n      _ = this.lex.next();\n      this.enum(None())\n    | \"interface\" ->\n      _ = this.lex.next();\n      this.class_(tok.posStart.value, CKInterface())\n    | \"class\" ->\n      _ = this.lex.next();\n      this.class_(tok.posStart.value, CKClass())\n    | \"let\" ->\n      _ = this.lex.next();\n      this.varDef(VDKLet())\n    | _ -> ToplevelExpr(this.expr(0))\n    }\n  }\n\n  /***************************************************************************/\n  // Module name parsing\n  /***************************************************************************/\n\n  // Parse module names in import/export statements\n  mutable fun moduleNames(): ModuleNames {\n    if (this.lex.peekKind() is Some(TKMultiplication())) {\n      _ = this.lex.next();\n      asName = if (this.lex.peekStr() is Some(\"as\")) {\n        _ = this.lex.next();\n        Some(this.getName())\n      } else {\n        None()\n      };\n      MStar(asName)\n    } else if (this.lex.peekKind() is Some(TKOpenCurly())) {\n      _ = this.lex.next();\n      if (this.lex.peekKind() is Some(TKCloseCurly())) {\n        _ = this.lex.next();\n        MCurly(Array[]);\n      } else {\n        names = this.curlyNames();\n        MCurly(names)\n      }\n    } else {\n      name = this.getName();\n      curlyNames = if (this.lex.peekKind() is Some(TKComma())) {\n        _ = this.lex.next();\n        this.expect(TKOpenCurly());\n        this.curlyNames();\n      } else {\n        Array[]\n      };\n      MName(name, curlyNames);\n    }\n  }\n\n  // Parse curly-braced names in imports\n  mutable fun curlyNames(): Array<ModuleDefName> {\n    names = mutable Vector[];\n    loop {\n      isType = if (\n        this.lex.lookAhead(() -> {\n          this.lex.peekStr() is Some(\"type\") &&\n            {\n              _ = this.lex.next();\n              this.lex.peekKind() is Some(TKVar())\n            }\n        })\n      ) {\n        nextTok = this.lex.next().fromSome();\n        Some(PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd))\n      } else {\n        None()\n      };\n      name = this.getName();\n      asName = if (this.lex.isEq(\"as\")) {\n        _ = this.lex.next();\n        Some(this.getName())\n      } else {\n        None()\n      };\n      names.push(ModuleDefName(isType, name, asName));\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedImport())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKCloseCurly() -> break void\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKCloseCurly())) {\n          _ = this.lex.next();\n          break void\n        }\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKCloseCurly()),\n        )\n      }\n    };\n    names.toArray()\n  }\n\n  /***************************************************************************/\n  // Variable definition parsing\n  //\n  // <var-def> ::= <pattern> (: <type>)? (= <expr>)?\n  /***************************************************************************/\n\n  // Parse variable definitions\n  mutable fun varDef(kind: VarDefKind): VarDefs {\n    // Track symbol context for the entire variable definition block\n    contextInfo = if (\n      kind is VDKConst() &&\n      this.getCurrentSymbol() is SPTopLevel()\n    ) {\n      (prevSymbol, prevPos) = this.getCurrentSymbolContext();\n      Some((prevSymbol, prevPos))\n    } else {\n      None()\n    };\n\n    defs = mutable Vector[];\n    loop {\n      pat = this.pattern();\n\n      // Track top-level constants as symbols\n      if (kind is VDKConst() && this.getCurrentSymbol() is SPTopLevel()) {\n        pat.value match {\n        | PVar(name) ->\n          constSymbol = SPConstant(name.value);\n          symbolContextPos = name.pos.relStart.value;\n          // Use the relative position since we're at top level (SPTopLevel)\n          this.recordSymbolDefinition(constSymbol, symbolContextPos);\n          this.setSymbolContext(constSymbol, symbolContextPos)\n        | _ ->\n          void // Only track simple variable patterns\n        }\n      };\n\n      type = if (this.lex.peekKind() is Some(TKColon())) {\n        this.expect(TKColon());\n        Some(this.type(0));\n      } else {\n        None()\n      };\n      value = if (this.lex.peekKind() is Some(TKAssignment())) {\n        _ = this.lex.next();\n        Some(this.expr(0));\n      } else {\n        None()\n      };\n      defs.push(VarDef(pat, type, value));\n\n      commaTok = this.lex.peek() match {\n      | None() -> break void\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKSemi() ->\n        _ = this.lex.next();\n        break void\n      | TKComma() ->\n        _ = this.lex.next();\n        continue\n      | _ -> break void\n      }\n    };\n\n    // Restore previous symbol context if we were parsing constants\n    contextInfo match {\n    | Some((prevSymbol, prevPos)) -> this.setSymbolContext(prevSymbol, prevPos)\n    | None() -> void\n    };\n\n    VarDefs(kind, defs.toArray())\n  }\n\n  /***************************************************************************/\n  // Type definition parsing\n  /***************************************************************************/\n\n  // Parse type definitions\n  mutable fun typeDef(): TypeDef {\n    name = this.getName();\n    tdefParams = if (this.lex.peekKind() is Some(TKLessThan())) {\n      _ = this.lex.next();\n      this.typeDefsParams();\n    } else {\n      Array[]\n    };\n    this.expect(TKAssignment());\n    body = this.type(0);\n    if (this.lex.peekKind() is Some(TKSemi())) {\n      _ = this.lex.next();\n    };\n    TypeDef{name, body, tdefParams}\n  }\n\n  // Parse enum definitions\n  mutable fun enum(isConst: ?PosRange): Enum {\n    name = this.getName();\n    this.expect(TKOpenCurly());\n    if (this.lex.peekKind() is Some(TKCloseCurly())) {\n      _ = this.lex.next();\n      return Enum(isConst, name, Array[]);\n    };\n    fields = mutable Vector<(Name, ?Expr)>[];\n    loop {\n      fieldName = this.getName();\n      fieldValue = if (this.lex.peekKind() is Some(TKAssignment())) {\n        _ = this.lex.next();\n        Some(this.expr(0));\n      } else {\n        None()\n      };\n      fields.push((fieldName, fieldValue));\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKCloseCurly() -> break void\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKCloseCurly())) {\n          _ = this.lex.next();\n          break void\n        }\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKCloseCurly()),\n        )\n      }\n    };\n    Enum(isConst, name, fields.toArray())\n  }\n\n  // Parse class definitions\n  mutable fun class_(_pos: Int, kind: ClassKind): Class {\n    name = this.getName();\n    // Record the class definition and set context\n    classSymbol = SPClass(name.value);\n    symbolContextPos = this.lex.pos;\n    this.recordSymbolDefinition(classSymbol, symbolContextPos);\n    (prevSymbol, prevPos) = this.getCurrentSymbolContext();\n    this.setSymbolContext(classSymbol, symbolContextPos);\n\n    tparams = if (this.lex.peekKind() is Some(TKLessThan())) {\n      _ = this.lex.next();\n      this.typeDefsParams();\n    } else {\n      Array[]\n    };\n    extends_ = if (this.lex.isEq(\"extends\")) {\n      _ = this.lex.next();\n      extends_ = mutable Vector[];\n      loop {\n        ty = this.type(0);\n        extends_.push(ty);\n        if (this.lex.peekKind() is Some(TKComma())) {\n          _ = this.lex.next();\n        } else {\n          break extends_.toArray()\n        }\n      }\n    } else {\n      Array[]\n    };\n    implements = if (this.lex.peekStr() is Some(\"implements\")) {\n      _ = this.lex.next();\n      implements = mutable Vector[];\n      loop {\n        ty = this.type(0);\n        implements.push(ty);\n        if (this.lex.peekKind() is Some(TKComma())) {\n          _ = this.lex.next();\n        } else {\n          break implements.toArray()\n        }\n      }\n    } else {\n      Array[]\n    };\n    this.expect(TKOpenCurly());\n    fields = this.objectFields();\n\n    // Restore previous context\n    this.setSymbolContext(prevSymbol, prevPos);\n\n    /* Desugar parameter properties */\n\n    parameterProperties = mutable Vector[];\n    !fields = fields.map(field ->\n      field match {\n      | fd @ FunDef{name => Some(FNNormal(Name(_, \"constructor\")))} ->\n        initializationStatements = mutable Vector[];\n        !fd.params = fd.params.map(param -> {\n          param match {\n          | Param(\n            pos,\n            modifiers,\n            PNName(pName),\n            /*optional*/ None(),\n            Some(type),\n            default,\n          ) ->\n            isParameterProperty = false;\n            !param.modifiers.modifiers = modifiers.modifiers.filter(modifier ->\n              modifier match {\n              | ModPrivate _\n              | ModProtected _\n              | ModPublic _\n              | ModReadonly _ ->\n                !isParameterProperty = true;\n                false\n              | _ -> true\n              }\n            );\n            if (isParameterProperty) {\n              parameterProperties.push(\n                FieldTypeValue{\n                  pos,\n                  setGet => None(),\n                  name => FNNormal(pName),\n                  optional => None(),\n                  type,\n                  value => default,\n                  modifiers,\n                },\n              );\n              eThis = Expr(pos, Var(Name(pos, \"this\")));\n              eName = Expr(pos, Var(pName));\n              eThisDotName = Expr(pos, Binop(BODot(), eThis, eName));\n              eAssign = Expr(pos, Binop(BOAssignment(), eThisDotName, eName));\n              initializationStatements.push(Stmt(pos, StmtExpr(eAssign)))\n            }\n          | _ -> void\n          };\n          param\n        });\n        fd.body match {\n        | FDBNone _ -> void\n        | FDBSome(stmts) ->\n          !stmts = initializationStatements.toArray().concat(stmts);\n          !fd.body = FDBSome(stmts)\n        };\n        fd\n      | _ -> field\n      }\n    );\n    !fields = fields.concat(parameterProperties.toArray());\n\n    Class{kind, name, extends_, implements, tparams, fields}\n  }\n\n  /***************************************************************************/\n  // Type parameter parsing\n  /***************************************************************************/\n\n  // Parse type definition parameters\n  mutable fun typeDefsParams(): Array<TypeParam> {\n    tdparams = mutable Vector[];\n    loop {\n      name = this.getName();\n      constr = this.lex.peekStr() match {\n      | Some(\"extends\") ->\n        _ = this.lex.next();\n        Some(this.type(0))\n      | _ -> None()\n      };\n      default = if (this.lex.peekKind() is Some(TKAssignment())) {\n        _ = this.lex.next();\n        ty = this.type(0);\n        Some(ty)\n      } else {\n        None()\n      };\n      this.!id = this.id + 1;\n      tdparams.push(\n        TypeParam(\n          Id::create(name.value, this.id, this.lex),\n          name,\n          constr,\n          default,\n        ),\n      );\n      tokComma = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      tokComma.kind match {\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKGreaterThan())) {\n          _ = this.lex.next();\n          return tdparams.toArray()\n        }\n      | TKGreaterThan() -> return tdparams.toArray()\n      | _ ->\n        this.error(\n          this.lex.posStart(tokComma),\n          ExpectedTokenNot(TKGreaterThan()),\n        )\n      }\n    }\n  }\n\n  // Parse type parameters for functions and classes\n  mutable fun typeParams(): Array<TypeParam> {\n    result = mutable Vector[];\n    loop {\n      tparamName = this.getName();\n      tparamType = if (this.lex.isEq(\"extends\")) {\n        _ = this.lex.next();\n        ty = this.type(0);\n        Some(ty)\n      } else {\n        None()\n      };\n      default = if (this.lex.peekKind() is Some(TKAssignment())) {\n        _ = this.lex.next();\n        Some(this.type(0))\n      } else {\n        None()\n      };\n      this.!id = this.id + 1;\n      result.push(\n        TypeParam(\n          Id::create(tparamName.value, this.id, this.lex),\n          tparamName,\n          tparamType,\n          default,\n        ),\n      );\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKGreaterThan())) {\n          _ = this.lex.next();\n          return result.toArray()\n        }\n      | TKGreaterThan() -> return result.toArray()\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKGreaterThan()),\n        )\n      }\n    }\n  }\n\n  /***************************************************************************/\n  // Function definition parsing\n  //\n  // <fun-def> ::=\n  //   (async?) <modifiers>? (get | set?)\n  //     <symbol>? [ < <type-param>* > ]? ( <param>* )\n  //       (: <type>?)\n  //     <fun-def-body>\n  /***************************************************************************/\n\n  // Parse function definitions\n  mutable fun funDef(isAsync: ?PosRange, parseBlock: Bool): FunDef {\n    funTok = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())\n    | Some(x) -> x\n    };\n    funName = this.getName();\n    // Record the function definition and set context\n    funcSymbol = SPFunction(funName.value);\n    symbolContextPos = this.lex.pos;\n    this.recordSymbolDefinition(funcSymbol, symbolContextPos);\n    (prevSymbol, prevPos) = this.getCurrentSymbolContext();\n    this.setSymbolContext(funcSymbol, symbolContextPos);\n\n    cgNode = None(); // TODO: Add call graph support back\n\n    result = this.methodDef(\n      isAsync,\n      Modifiers::empty(),\n      None(),\n      (funTok.posStart, FNNormal(funName)),\n      parseBlock,\n      None(),\n      cgNode,\n    );\n\n    // Restore previous context\n    this.setSymbolContext(prevSymbol, prevPos);\n    result\n  }\n\n  // Parse method definitions\n  mutable fun methodDef(\n    isAsync: ?PosRange,\n    modifiers: Modifiers,\n    fieldGetSet: ?FieldGetSet,\n    funName: (Pos, SimpleSymbol),\n    parseBlock: Bool,\n    optional: ?PosRange,\n    cgNode: ?CGNode,\n  ): FunDef {\n    this.anonMethodDef(\n      isAsync,\n      modifiers,\n      fieldGetSet,\n      Some(funName),\n      parseBlock,\n      optional,\n      cgNode,\n    )\n  }\n\n  // Parse anonymous method definitions\n  mutable fun anonMethodDef(\n    isAsync: ?PosRange,\n    methodModifiers: Modifiers,\n    isGetSet: ?FieldGetSet,\n    funName: ?(Pos, SimpleSymbol),\n    parseBlock: Bool,\n    isOptional: ?PosRange,\n    cgNode: ?CGNode,\n  ): FunDef {\n    // Record method/function definition and set context\n    (prevSymbol, prevPos) = this.getCurrentSymbolContext();\n    (funName, this.getCurrentSymbol()) match {\n    | (Some((_funPos, FNNormal(name))), SPClass(className)) ->\n      methodSymbol = SPMethod(className, name.value);\n      symbolContextPos = this.lex.pos;\n      this.recordSymbolDefinition(methodSymbol, symbolContextPos);\n      this.setSymbolContext(methodSymbol, symbolContextPos)\n    | (Some((_funPos, FNNormal(name))), _) ->\n      funcSymbol = SPFunction(name.value);\n      symbolContextPos = this.lex.pos;\n      this.recordSymbolDefinition(funcSymbol, symbolContextPos);\n      this.setSymbolContext(funcSymbol, symbolContextPos)\n    | _ ->\n      void // Keep current context for anonymous methods\n    };\n\n    funStart = this.lex.lastTok.fromSome().posEnd;\n    tparams = if (this.lex.peekKind() is Some(TKLessThan())) {\n      _ = this.lex.next();\n      this.typeParams();\n    } else {\n      Array[]\n    };\n    params = mutable Vector[];\n    this.expect(TKOpenParen());\n    this.lex.peekKind() match {\n    | Some(TKCloseParen()) ->\n      _ = this.lex.next();\n      void\n    | _ ->\n      loop {\n        modifiers = this.modifiers(None());\n        start = this.lex.peek() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())\n        | Some(tok) -> tok.posStart\n        };\n        paramName = this.paramNames();\n        end = this.lex.lastTok.fromSome().posEnd;\n        pos = PosRange::create(this.lex, start, end);\n        optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {\n          nextTok = this.lex.next().fromSome();\n          Some(PosRange::create(this.lex, nextTok.posStart, nextTok.posEnd))\n        } else {\n          None()\n        };\n        paramType = if (this.lex.peekKind() is Some(TKColon())) {\n          _ = this.lex.next();\n          Some(this.type(0))\n        } else {\n          None()\n        };\n        paramValue = if (this.lex.peekKind() is Some(TKAssignment())) {\n          _ = this.lex.next();\n          Some(this.expr(0))\n        } else {\n          None()\n        };\n        params.push(\n          Param(pos, modifiers, paramName, optional, paramType, paramValue),\n        );\n        nextTok = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())\n        | Some(x) -> x\n        };\n        nextTok.kind match {\n        | TKCloseParen() -> break void\n        | TKComma() ->\n          if (this.lex.peekKind() is Some(TKCloseParen())) {\n            _ = this.lex.next();\n            break void;\n          }\n        | _ ->\n          this.error(\n            this.lex.posStart(nextTok),\n            ExpectedTokenNot(TKCloseParen()),\n          )\n        }\n      }\n    };\n    retType = if (this.lex.peekKind() is Some(TKColon())) {\n      this.expect(TKColon());\n      retTypeTok = this.lex.peek();\n      retType = this.type(0);\n      retPos = PosRange::create(\n        this.lex,\n        retTypeTok.fromSome().posStart,\n        this.lex.lastTok.fromSome().posEnd,\n      );\n      (retPos, Some(retType))\n    } else {\n      start = this.lex.lastTok.fromSome().posEnd;\n      end = this.lex.peek() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())\n      | Some(x) -> x.posStart\n      };\n      (PosRange::create(this.lex, start, end), None())\n    };\n    body = if (parseBlock) {\n      bodyTok = this.lex.peek() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedFunDef())\n      | Some(x) -> x\n      };\n      bodyTok.kind match {\n      | TKOpenCurly() -> FDBSome(this.block())\n      | _ ->\n        FDBNone(PosRange::create(this.lex, bodyTok.posStart, bodyTok.posEnd))\n      }\n    } else {\n      lastTok = this.lex.lastTok.fromSome();\n      FDBNone(PosRange::create(this.lex, lastTok.posStart, lastTok.posEnd))\n    };\n    funEnd = this.lex.lastTok.fromSome().posEnd;\n\n    // Restore previous context\n    this.setSymbolContext(prevSymbol, prevPos);\n    FunDef{\n      pos => PosRange::create(this.lex, funStart, funEnd),\n      isAsync,\n      modifiers => methodModifiers,\n      tparams => tparams,\n      isGetSet,\n      name => funName.map(x -> x.i1),\n      optional => isOptional,\n      params => params.toArray(),\n      retType,\n      body,\n      cgNode,\n    }\n  }\n\n  /***************************************************************************/\n  // Parameter name parsing\n  /***************************************************************************/\n\n  // Parse parameter names in function definitions\n  mutable fun paramNames(): ParamNames {\n    if (this.lex.peekKind() is Some(TKOpenSquare())) {\n      _ = this.lex.next();\n      PNSquare(this.squareParamNames());\n    } else if (this.lex.peekKind() is Some(TKOpenCurly())) {\n      _ = this.lex.next();\n      PNCurly(this.curlyParamNames())\n    } else if (this.lex.peekKind() is Some(TKDotDotDot())) {\n      _ = this.lex.next();\n      PNDDD(this.getName())\n    } else {\n      name = this.getName();\n      PNName(name)\n    }\n  }\n\n  // Parse square-bracketed parameter names\n  mutable fun squareParamNames(): Array<ParamNames> {\n    if (this.lex.peekKind() is Some(TKCloseSquare())) return Array[];\n    names = mutable Vector[];\n    loop {\n      names.push(this.paramNames());\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKCloseSquare())) {\n          _ = this.lex.next();\n          break void;\n        }\n      | TKCloseSquare() -> break void\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKCloseSquare()),\n        )\n      }\n    };\n    names.toArray()\n  }\n\n  // Parse curly-bracketed parameter names\n  mutable fun curlyParamNames(): Array<ParamNames> {\n    if (this.lex.peekKind() is Some(TKCloseCurly())) return Array[];\n    names = mutable Vector[];\n    loop {\n      names.push(this.paramNames());\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKCloseCurly())) {\n          _ = this.lex.next();\n          break void;\n        }\n      | TKCloseCurly() -> break void\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKCloseSquare()),\n        )\n      }\n    };\n    names.toArray()\n  }\n}\n\nmodule end;\n"}, {"path": "src/ParserExpr.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Expression parsing methods for the TypeScript parser. */\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class Parser {\n  /***************************************************************************/\n  // Expression parsing\n  //\n  // <expr> ::=\n  //   | <string-number>\n  //   | <name>\n  //   | ... <name>\n  //   | <string-kind> <string>\n  //   | typeof <expr>\n  //   | keyof <type>\n  //   | await <expr>\n  //   | <expr> [ <expr> ]\n  //   | new <name> ( <type>* ) ( <expr>* )\n  //   | <unop> <expr>\n  //   | <expr> <post-op>\n  //   | <expr> <binop> <expr>\n  //   | <expr> ( <type>* ) ( <expr>* )\n  //   | ( (<name> (: <type>)?)* )\n  //   | { <field>* }\n  //   | function ( (<name> (: <type>)?)* ) (: <type>)? <closure-body>\n  //   | [ <expr>* ]\n  //   | <expr> ? <expr> : <expr>\n  //   | <expr> instanceof <expr>\n  //   | <expr> as const\n  //   | <expr> as <type>\n  //   | < <type> > <expr>\n  //   | /<regexp>/\n  //   | async <expr>\n  /***************************************************************************/\n\n  // Parse an expression with given precedence level\n  mutable fun expr(prec: Int): Expr {\n    inTypeCopy = this.lex.inType;\n    this.lex.!inType = false;\n    start = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n    | Some(tok) -> tok.posStart\n    };\n    e_ = this.expr_(prec);\n    end = this.lex.lastTok.fromSome().posEnd;\n    this.lex.!inType = inTypeCopy;\n    Expr(PosRange::create(this.lex, start, end), e_)\n  }\n\n  // Parse regular expression literals (/pattern/flags)\n  // Handles escaped characters and flag parsing\n  mutable fun parseRegexpExpr(): Expr_ {\n    _ = this.lex.next();\n    pos = this.lex.pos;\n    loop {\n      if (pos >= this.lex.contents.size()) {\n        this.error(this.lex.posEnd(), UnterminatedExpr())\n      };\n      c = this.lex.contents[pos];\n      if (c == '\\\\') {\n        !pos = pos + 2;\n        continue;\n      };\n      !pos = pos + 1;\n      if (c == '/') break void;\n    };\n    loop {\n      if (pos >= this.lex.contents.size()) {\n        this.error(this.lex.posEnd(), UnterminatedExpr())\n      };\n      c = this.lex.contents[pos];\n      if (\n        c == 'g' ||\n        c == 'i' ||\n        c == 'm' ||\n        c == 's' ||\n        c == 'u' ||\n        c == 'y'\n      ) {\n        !pos = pos + 1;\n        continue;\n      };\n      break void\n    };\n    regexp = String::fromChars(this.lex.contents.slice(this.lex.pos, pos));\n    this.lex.!pos = pos;\n    Regexp(regexp)\n  }\n\n  // Parse array literal expressions [elem1, elem2, ...]\n  // Handles empty arrays and trailing commas\n  mutable fun parseArrayExpr(): Expr_ {\n    if (this.lex.peekKind() is Some(TKCloseSquare())) {\n      _ = this.lex.next();\n      EArray(Array[])\n    } else {\n      values = mutable Vector[];\n      loop {\n        values.push(this.expr(0));\n        commaTok = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n        | Some(x) -> x\n        };\n        commaTok.kind match {\n        | TKCloseSquare() -> break EArray(values.toArray())\n        | TKComma() ->\n          if (this.lex.peekKind() is Some(TKCloseSquare())) {\n            _ = this.lex.next();\n            break EArray(values.toArray())\n          }\n        | _ ->\n          this.error(\n            this.lex.posStart(commaTok),\n            ExpectedTokenNot(TKCloseSquare()),\n          )\n        }\n      }\n    }\n  }\n\n  // Parse object literal expressions {key: value, ...}\n  // Handles empty objects, method definitions, and spread syntax\n  mutable fun parseObjectExpr(): Expr_ {\n    if (this.lex.peekKind() is Some(TKCloseCurly())) {\n      _ = this.lex.next();\n      Object(Array[])\n    } else {\n      fields = mutable Vector[];\n      fields.push(this.field());\n      loop {\n        commaTok = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n        | Some(x) -> x\n        };\n        commaTok.kind match {\n        | TKCloseCurly() -> break Object(fields.toArray())\n        | TKSemi()\n        | TKComma() ->\n          if (this.lex.peekKind() is Some(TKCloseCurly())) {\n            _ = this.lex.next();\n            break Object(fields.toArray())\n          } else {\n            fields.push(this.field());\n          }\n        | _ ->\n          this.error(\n            this.lex.posStart(commaTok),\n            ExpectedTokenNot(TKCloseCurly()),\n          )\n        }\n      }\n    }\n  }\n\n  // Parse parenthesized expressions and parameter lists\n  // Handles: (expr), (param), (param: type), (param1, param2, ...)\n  mutable fun parseParenExpr(): Expr_ {\n    if (this.lex.peekKind() is Some(TKCloseParen())) {\n      _ = this.lex.next();\n      Params(Array[])\n    } else {\n      first = this.expr_(0);\n      firstTypeOpt = if (this.lex.peekKind() is Some(TKColon())) {\n        _ = this.lex.next();\n        Some(this.type(0))\n      } else {\n        None()\n      };\n      commaTok = this.lex.peek() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKCloseParen() ->\n        _ = this.lex.next();\n        firstTypeOpt match {\n        | None() -> first\n        | Some _ ->\n          firstName = first match {\n          | Var(x) -> x\n          | _ -> this.error(this.lex.posStart(commaTok), ExpectedVarName())\n          };\n          Params(Array[(firstName, firstTypeOpt)])\n        }\n      | TKComma() ->\n        _ = this.lex.next();\n        firstName = first match {\n        | Var(x) -> x\n        | _ -> this.error(this.lex.posStart(commaTok), ExpectedVarName())\n        };\n        params = mutable Vector[(firstName, firstTypeOpt)];\n        loop {\n          tok = this.lex.peek();\n          e = this.expr(0) match {\n          | Expr(_, Var(x)) -> x\n          | Expr _ ->\n            this.error(\n              EPChar(this.lex.fileName, tok.fromSome().posStart),\n              ExpectedVarName(),\n            )\n          };\n          tyOpt = if (this.lex.peekKind() is Some(TKColon())) {\n            _ = this.lex.next();\n            Some(this.type(0))\n          } else {\n            None()\n          };\n          params.push((e, tyOpt));\n          closeTok = this.lex.next() match {\n          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n          | Some(x) -> x\n          };\n          closeTok.kind match {\n          | TKCloseParen() -> break void\n          | TKComma() ->\n            if (this.lex.peekKind() is Some(TKCloseParen())) {\n              _ = this.lex.next();\n              break void;\n            }\n          | _ ->\n            this.error(\n              this.lex.posStart(closeTok),\n              ExpectedTokenNot(TKCloseParen()),\n            )\n          }\n        };\n        Params(params.toArray())\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKCloseParen()),\n        )\n      }\n    }\n  }\n\n  // Parse atomic expressions (literals, variables, unary operators)\n  // Handles: numbers, strings, variables, typeof, await, new, unary ops\n  mutable fun parseAtomicExpr(tok: Token): Expr_ {\n    tok.kind match {\n    | TKNumber() -> Number(this.lex.getStrTok(tok))\n    | TKBigInt() -> BigInt(this.lex.getStrTok(tok))\n    | TKTild() ->\n      (_assoc, tildPrec) = precedence[TKTild()];\n      Unop(UOTild(), this.expr(tildPrec))\n    | TKDotDotDot() -> Spread(this.getName())\n    | TKVar() ->\n      str = this.lex.getStrTok(tok);\n      str match {\n      | \"function\" -> this.error(this.lex.posStart(tok), FunctionInExpr())\n      | \"new\" ->\n        name = this.getName();\n        targs = if (this.lex.peekKind() is Some(TKLessThan())) {\n          _ = this.lex.next();\n          this.typeList()\n        } else {\n          Array[]\n        };\n        this.expect(TKOpenParen());\n        args = this.arguments();\n        New(name, targs, args)\n      | \"async\" -> Async(this.expr(0))\n      | \"await\" -> Await(this.expr(0))\n      | \"typeof\" -> TypeOf(this.expr(typeOfPrec))\n      | _ ->\n        Var(Name(PosRange::create(this.lex, tok.posStart, tok.posEnd), str))\n      }\n    | TKQuote()\n    | TKDoubleQuote() ->\n      EString(this.lex.getStrTok(tok))\n    | TKBackTick() -> this.parseTemplateLiteral(tok)\n    | subTok @ TKAddition()\n    | subTok @ TKSubtraction() ->\n      (_assoc, bopPrec) = precedence[subTok];\n      this.expr_(bopPrec)\n    | subTok @ TKExclamationMark() ->\n      (_, unopPrec) = precedence[subTok];\n      Unop(UOExclamationMark(), this.expr(unopPrec))\n    | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())\n    }\n  }\n\n  // Internal expression parsing implementation\n  // Parses primary expressions and then delegates to binary/postfix operator handling\n  mutable fun expr_(prec: Int): Expr_ {\n    tok = this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n    | Some(x) -> x\n    };\n    left: Expr_ = tok.kind match {\n    | TKOpenParen() -> this.parseParenExpr()\n    | TKOpenCurly() -> this.parseObjectExpr()\n    | TKOpenSquare() -> this.parseArrayExpr()\n    | TKDivision() -> this.parseRegexpExpr()\n    | TKLessThan() ->\n      ty = this.type(0);\n      this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(Token(TKGreaterThan(), _, _)) -> void\n      | Some(unexpectedTok) ->\n        this.error(\n          this.lex.posStart(unexpectedTok),\n          ExpectedTokenNot(TKGreaterThan()),\n        )\n      };\n      e = this.expr(prec);\n      return As(e, ty)\n    | _ -> this.parseAtomicExpr(tok)\n    };\n\n    this.parseBinaryAndPostfixOps(left, tok, prec)\n  }\n\n  // Handle binary operators with precedence climbing\n  mutable fun tryParseBinaryOp(\n    mutableLeft: Expr_,\n    binopTok: Token,\n    tok: Token,\n    prec: Int,\n  ): ?Expr_ {\n    (assoc, bopPrec) = precedence.maybeGet(binopTok.kind) match {\n    | None() -> return None()\n    | Some(x) -> x\n    };\n    binop = binopTok.kind.toBinop() match {\n    | None() -> return None()\n    | Some(x) -> x\n    };\n    if (bopPrec == prec) {\n      leftPosRange = PosRange::create(\n        this.lex,\n        tok.posStart,\n        this.lex.getLastPos(),\n      );\n      _ = this.lex.next();\n      newLeft = assoc match {\n      | ALeft() ->\n        right = this.expr(prec + 1);\n        Binop(binop, Expr(leftPosRange, mutableLeft), right)\n      | ARight() ->\n        Binop(binop, Expr(leftPosRange, mutableLeft), this.expr(prec))\n      | ANonAssoc() ->\n        this.error(\n          this.lex.posStart(binopTok),\n          NonAssociative(this.lex.getStrTok(binopTok)),\n        )\n      };\n      Some(newLeft)\n    } else if (bopPrec > prec) {\n      leftPosRange = PosRange::create(\n        this.lex,\n        tok.posStart,\n        this.lex.getLastPos(),\n      );\n      _ = this.lex.next();\n      newLeft = Binop(\n        binop,\n        Expr(leftPosRange, mutableLeft),\n        this.expr(bopPrec + 1),\n      );\n      Some(newLeft)\n    } else {\n      if (bopPrec >= prec) {\n        internal_error(\"bopPrec should be less than prec\")\n      };\n      None()\n    }\n  }\n\n  // Handle closure syntax (: type => expr and => expr)\n  mutable fun tryParseClosure(\n    mutableLeft: Expr_,\n    binopTok: Token,\n    tok: Token,\n  ): ?Expr_ {\n    if (\n      binopTok.kind is TKColon() &&\n      this.lex.lookAhead(() -> {\n        try {\n          _ = this.lex.next();\n          _ = this.type(0);\n          this.lex.peekKind() is Some(TKClosure())\n        } catch {\n        | ErrorExn _ -> false\n        | exn -> throw exn\n        }\n      })\n    ) {\n      _ = this.lex.next();\n      rty = this.type(0);\n      this.expect(TKClosure());\n      params = mutableLeft match {\n      | Params(params) -> params\n      | Var(varName) -> Array[(varName, None())]\n      | _ -> this.error(this.lex.posStart(tok), ExpectedParams())\n      };\n      closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {\n        CBBlock(this.blockOrStmt())\n      } else {\n        CBExpr(this.expr(0))\n      };\n      Some(Closure(params, Some(rty), closureBody))\n    } else if (binopTok.kind is TKClosure()) {\n      _ = this.lex.next();\n      params = mutableLeft match {\n      | Params(params) -> params\n      | Var(varName) -> Array[(varName, None())]\n      | _ -> this.error(this.lex.posStart(tok), ExpectedParams())\n      };\n      closureBody = if (this.lex.peekKind() is Some(TKOpenCurly())) {\n        CBBlock(this.blockOrStmt())\n      } else {\n        CBExpr(this.expr(0))\n      };\n      Some(Closure(params, None(), closureBody))\n    } else {\n      None()\n    }\n  }\n\n  // Handle type casting with 'as' keyword and 'as const' syntax\n  mutable fun tryParseTypeCast(\n    mutableLeft: Expr_,\n    binopTok: Token,\n    tok: Token,\n  ): ?Expr_ {\n    if (this.lex.isEqTok(binopTok, \"as\")) {\n      leftPosRange = PosRange::create(\n        this.lex,\n        tok.posStart,\n        this.lex.getLastPos(),\n      );\n      _ = this.lex.next();\n\n      // Check if this is 'as const'\n      if (this.lex.isEq(\"const\")) {\n        _ = this.lex.next(); // consume 'const'\n        result = AsConst(Expr(leftPosRange, mutableLeft));\n        Some(result)\n      } else {\n        ty = this.type(0);\n        result = As(Expr(leftPosRange, mutableLeft), ty);\n        loop {\n          if (this.lex.isEq(\"as\")) {\n            _ = this.lex.next();\n            type = this.type(0);\n            !result = As(\n              Expr(\n                PosRange::create(this.lex, tok.posStart, this.lex.getLastPos()),\n                result,\n              ),\n              type,\n            );\n          };\n          break void;\n        };\n        Some(result)\n      }\n    } else {\n      None()\n    }\n  }\n\n  // Handle function calls with optional type arguments\n  mutable fun tryParseFunctionCall(\n    mutableLeft: Expr_,\n    binopTok: Token,\n    tok: Token,\n    prec: Int,\n  ): ?Expr_ {\n    hasTArgs = this.hasTArgs();\n    if (binopTok.kind is TKOpenParen() || hasTArgs) {\n      if (prec >= callPrec) return None();\n      _ = this.lex.next();\n      targs = mutable Vector[];\n      if (hasTArgs) {\n        loop {\n          targs.push(this.type(0));\n          commaTok = this.lex.next() match {\n          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n          | Some(tk) -> tk\n          };\n          commaTok.kind match {\n          | TKComma() ->\n            if (this.lex.peekKind() is Some(TKGreaterThan())) {\n              _ = this.lex.next();\n              break void\n            }\n          | TKGreaterThan() -> break void\n          | _ ->\n            this.error(\n              this.lex.posStart(commaTok),\n              ExpectedToken(TKGreaterThan()),\n            )\n          }\n        };\n        this.expect(TKOpenParen())\n      };\n      args = this.arguments();\n      newLeft = Call(\n        Expr(\n          PosRange::create(this.lex, tok.posStart, this.lex.getLastPos()),\n          mutableLeft,\n        ),\n        targs.toArray(),\n        args,\n      );\n      Some(newLeft)\n    } else {\n      None()\n    }\n  }\n\n  // Handle postfix operators (++, --, !)\n  mutable fun tryParsePostfixOp(\n    mutableLeft: Expr_,\n    binopTok: Token,\n    tok: Token,\n    prec: Int,\n  ): (Bool, Expr_) {\n    binopTok.kind match {\n    | TKIncr() ->\n      (_assoc, opPrec) = precedence[binopTok.kind];\n      if (prec <= opPrec) {\n        leftPosRange = PosRange::create(\n          this.lex,\n          tok.posStart,\n          this.lex.getLastPos(),\n        );\n        _ = this.lex.next();\n        (true, PostOp(POIncr(), Expr(leftPosRange, mutableLeft)))\n      } else {\n        (false, mutableLeft)\n      }\n    | TKDecr() ->\n      (_assoc, opPrec) = precedence[binopTok.kind];\n      if (prec <= opPrec) {\n        leftPosRange = PosRange::create(\n          this.lex,\n          tok.posStart,\n          this.lex.getLastPos(),\n        );\n        _ = this.lex.next();\n        (true, PostOp(PODecr(), Expr(leftPosRange, mutableLeft)))\n      } else {\n        (false, mutableLeft)\n      }\n    | TKExclamationMark() ->\n      (_assoc, opPrec) = precedence[TKIncr()];\n      if (prec <= opPrec) {\n        leftPosRange = PosRange::create(\n          this.lex,\n          tok.posStart,\n          this.lex.getLastPos(),\n        );\n        _ = this.lex.next();\n        (true, PostOp(POExcl(), Expr(leftPosRange, mutableLeft)))\n      } else {\n        (false, mutableLeft)\n      }\n    | _ -> (false, mutableLeft)\n    }\n  }\n\n  // Handle binary and postfix operators with precedence\n  // Processes: function calls, array access, binary ops, ternary, in, instanceof, as casts\n  // Uses precedence climbing algorithm for correct operator associativity\n  mutable fun parseBinaryAndPostfixOps(\n    left: Expr_,\n    tok: Token,\n    prec: Int,\n  ): Expr_ {\n    mutableLeft = left;\n    loop {\n      binopTok = this.lex.peek() match {\n      | None() -> return mutableLeft\n      | Some(x) -> x\n      };\n      isIn = this.lex.isEqTok(binopTok, \"in\");\n      if (isIn || this.lex.isEqTok(binopTok, \"instanceof\")) {\n        (_assoc, opPrec) = in_and_instanceofPrec;\n        if (prec <= opPrec) {\n          leftPosRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          _ = this.lex.next();\n          rhs = this.expr(opPrec);\n          lhs = Expr(leftPosRange, mutableLeft);\n          !mutableLeft = if (isIn) In(lhs, rhs) else InstanceOf(lhs, rhs);\n          continue;\n        };\n        return mutableLeft;\n      };\n      (postfixHandled, postfixResult) = this.tryParsePostfixOp(\n        mutableLeft,\n        binopTok,\n        tok,\n        prec,\n      );\n      if (postfixHandled) {\n        !mutableLeft = postfixResult;\n        return mutableLeft;\n      };\n      if (binopTok.kind is TKQuestionMark()) {\n        (_assoc, opPrec) = precedence[binopTok.kind];\n        if (prec <= opPrec) {\n          leftPosRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          _ = this.lex.next();\n          e2 = this.expr(0);\n          this.expect(TKColon());\n          e3 = this.expr(opPrec);\n          !mutableLeft = EIf(Expr(leftPosRange, mutableLeft), e2, e3);\n        };\n        return mutableLeft;\n      };\n      this.tryParseClosure(mutableLeft, binopTok, tok).each(closureResult ->\n        !mutableLeft = closureResult\n      );\n      if (binopTok.kind is TKOpenSquare()) {\n        if (prec >= callPrec) return mutableLeft;\n        _ = this.lex.next();\n        !mutableLeft = Get(\n          Expr(\n            PosRange::create(this.lex, tok.posStart, this.lex.getLastPos()),\n            mutableLeft,\n          ),\n          this.expr(0),\n        );\n        this.expect(TKCloseSquare());\n        continue;\n      };\n      this.tryParseFunctionCall(mutableLeft, binopTok, tok, prec) match {\n      | None() -> void\n      | Some(callResult) ->\n        !mutableLeft = callResult;\n        continue\n      };\n      if (binopTok.kind is TKEquality()) {\n        this.error(this.lex.posStart(binopTok), DontUseEquality())\n      };\n      if (binopTok.kind is TKInequality()) {\n        this.error(this.lex.posStart(binopTok), DontUseInequality())\n      };\n      this.tryParseTypeCast(mutableLeft, binopTok, tok) match {\n      | None() -> void\n      | Some(castResult) -> return castResult\n      };\n      this.tryParseBinaryOp(mutableLeft, binopTok, tok, prec) match {\n      | None() -> void\n      | Some(binaryResult) ->\n        !mutableLeft = binaryResult;\n        continue\n      };\n      return mutableLeft\n    }\n  }\n\n  // Check if the current position starts with type arguments\n  mutable fun hasTArgs(): Bool {\n    this.lex.lookAhead(() -> {\n      binopTok = this.lex.peek() match {\n      | None() -> return false\n      | Some(x) -> x\n      };\n      if (!(binopTok.kind is TKLessThan())) return false;\n      try {\n        _ = this.lex.next();\n        loop {\n          _ = this.type(0);\n          commaTok = this.lex.next() match {\n          | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n          | Some(tk) -> tk\n          };\n          commaTok.kind match {\n          | TKComma() ->\n            if (this.lex.peekKind() is Some(TKGreaterThan())) {\n              _ = this.lex.next();\n              break void\n            }\n          | TKGreaterThan() -> break void\n          | _ ->\n            this.error(\n              this.lex.posStart(commaTok),\n              ExpectedToken(TKGreaterThan()),\n            )\n          }\n        };\n        this.expect(TKOpenParen());\n        true\n      } catch {\n      | ErrorExn _ -> false\n      | exn -> throw exn\n      }\n    })\n  }\n\n  // Parse function call arguments\n  mutable fun arguments(): Array<Expr> {\n    if (this.lex.peekKind() is Some(TKCloseParen())) {\n      _ = this.lex.next();\n      return Array[]\n    };\n    args = mutable Vector[];\n    loop {\n      args.push(this.expr(0));\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKCloseParen() -> break void\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKCloseParen())) {\n          _ = this.lex.next();\n          break void\n        }\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKCloseParen()),\n        )\n      }\n    };\n    args.toArray()\n  }\n\n  // Parse object field in expression context\n  mutable fun field(): Field {\n    if (this.lex.peekKind() is Some(TKDotDotDot())) {\n      _ = this.lex.next();\n      e = this.expr(0);\n      return FDSpread(e);\n    };\n    modifiers = this.modifiers(None());\n    fieldGetSet = this.isGetSet();\n    fieldNameTok = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n    | Some(x) -> x\n    };\n    fieldName = this.getNameOrStringOrInt();\n    if (\n      this.lex.peekKind() is Some(TKOpenParen()) ||\n      this.lex.peekKind() is Some(TKLessThan())\n    ) {\n      return this.anonMethodDef(\n        None(),\n        modifiers,\n        fieldGetSet,\n        Some((fieldNameTok.posStart, FNNormal(fieldName))),\n        true,\n        None(),\n        None(),\n      )\n    };\n    tok = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedExpr())\n    | Some(x) -> x\n    };\n    tok.kind match {\n    | TKColon() ->\n      _ = this.lex.next();\n      FDNormal(fieldName, this.expr(0))\n    | TKComma()\n    | TKCloseCurly() ->\n      FDNormal(fieldName, Expr(fieldName.pos, Var(fieldName)))\n    | _ -> this.error(this.lex.posStart(tok), ExpectedTokenNot(TKCloseCurly()))\n    }\n  }\n\n  // Parse template literals with interpolation: `text ${expr} more text`\n  mutable fun parseTemplateLiteral(tok: Token): Expr_ {\n    rawContent = this.lex.getStrTok(tok);\n\n    if (!rawContent.contains(\"${\")) {\n      // Simple template literal without interpolation\n      return EString(rawContent)\n    };\n\n    // Parse template literal with interpolation by manipulating lexer position\n    // The lexer has already consumed the entire template, but we can re-parse it\n\n    parts = mutable Vector<String>[];\n    expressions = mutable Vector<Expr>[];\n\n    // Save current lexer position\n    originalPos = this.lex.pos;\n    originalLastTok = this.lex.lastTok;\n\n    // Reset to start of template content (after opening backtick)\n    templateStart = tok.posStart.value + 1; // Skip opening `\n    templateEnd = tok.posEnd.value - 1; // Skip closing `\n    this.lex.!pos = templateStart;\n    this.lex.!lastTok = None();\n\n    currentStart = templateStart;\n    pos = templateStart;\n\n    // Parse through the template content\n    loop {\n      if (pos >= templateEnd) break void;\n\n      // Look for ${ pattern\n      if (\n        pos + 1 < templateEnd &&\n        this.lex.contents[pos] == '$' &&\n        this.lex.contents[pos + 1] == '{'\n      ) {\n        // Add string part before ${\n        if (pos > currentStart) {\n          part = String::fromChars(this.lex.contents.slice(currentStart, pos));\n          parts.push(part);\n        };\n\n        // Skip ${\n        !pos = pos + 2;\n        this.lex.!pos = pos;\n\n        // Find matching }\n        braceCount = 1;\n        exprStart = pos;\n        loop {\n          if (pos >= templateEnd) {\n            this.error(\n              EPChar(this.lex.fileName, tok.posStart),\n              UnterminatedExpr(),\n            );\n          };\n          c = this.lex.contents[pos];\n          if (c == '{') !braceCount = braceCount + 1;\n          if (c == '}') !braceCount = braceCount - 1;\n          if (braceCount == 0) break void;\n          !pos = pos + 1;\n        };\n\n        // Set lexer to parse the expression content\n        this.lex.!pos = exprStart;\n        expr = this.expr(0);\n        expressions.push(expr);\n\n        // Move past the closing }\n        !pos = pos + 1;\n        !currentStart = pos;\n        this.lex.!pos = pos;\n      } else {\n        !pos = pos + 1;\n      }\n    };\n\n    // Add final string part\n    if (currentStart < templateEnd) {\n      part = String::fromChars(\n        this.lex.contents.slice(currentStart, templateEnd),\n      );\n      parts.push(part);\n    };\n\n    // Restore lexer position\n    this.lex.!pos = originalPos;\n    this.lex.!lastTok = originalLastTok;\n\n    TemplateLiteral(parts.toArray(), expressions.toArray())\n  }\n}\n\nmodule end;\n"}, {"path": "src/ParserPattern.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Pattern parsing methods for the TypeScript parser. */\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class Parser {\n  /***************************************************************************/\n  // Pattern parsing\n  //\n  // <pattern> ::=\n  //   | <name>\n  //   | <pattern> ::= [ <pattern>* ]\n  //   | <pattern> ::= { (<name> : <pattern>)* }\n  /***************************************************************************/\n\n  // Parse a pattern (used in destructuring assignments and function parameters)\n  mutable fun pattern(): Pattern {\n    start = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n    | Some(x) -> x\n    };\n    pat_ = this.pattern_();\n    Pattern(\n      PosRange::create(\n        this.lex,\n        start.posStart,\n        this.lex.lastTok.fromSome().posEnd,\n      ),\n      pat_,\n    )\n  }\n\n  // Internal pattern parsing implementation\n  mutable fun pattern_(): Pattern_ {\n    this.lex.peekKind() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n    | Some(TKOpenSquare()) ->\n      _ = this.lex.next();\n      if (this.lex.peekKind() is Some(TKCloseSquare())) {\n        _ = this.lex.next();\n        return PArray(Array[])\n      };\n      pats = mutable Vector[];\n      loop {\n        pats.push(this.pattern());\n        commaTok = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n        | Some(x) -> x\n        };\n        commaTok.kind match {\n        | TKComma() ->\n          if (this.lex.peekKind() is Some(TKCloseSquare())) {\n            _ = this.lex.next();\n            break void;\n          }\n        | TKCloseSquare() -> break void\n        | _ -> this.error(this.lex.posStart(commaTok), UnexpectedToken())\n        }\n      };\n      PArray(pats.toArray())\n    | Some(TKOpenCurly()) ->\n      _ = this.lex.next();\n      if (this.lex.peekKind() is Some(TKCloseCurly())) {\n        _ = this.lex.next();\n        return PObject{fields => Array[], rest => None()}\n      };\n      fields = mutable Vector[];\n      rest: ?Name = None();\n      loop {\n        if (this.lex.peekKind() is Some(TKDotDotDot())) {\n          _ = this.lex.next();\n          !rest = Some(this.getName());\n          if (this.lex.peekKind() is Some(TKComma())) {\n            _ = this.lex.next()\n          };\n          this.expect(TKCloseCurly());\n          break void\n        };\n        fieldName = this.getName();\n        fieldPat = if (this.lex.peekKind() is Some(TKColon())) {\n          _ = this.lex.next();\n          Some(this.pattern());\n        } else {\n          None()\n        };\n        fieldDefault = if (this.lex.peekKind() is Some(TKAssignment())) {\n          _ = this.lex.next();\n          Some(this.expr(0))\n        } else {\n          None()\n        };\n        fields.push(\n          (\n            fieldName,\n            fieldPat match {\n            | None() -> Pattern(fieldName.pos, PVar(fieldName))\n            | Some(x) -> x\n            },\n            fieldDefault,\n          ),\n        );\n        commaTok = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedDef())\n        | Some(x) -> x\n        };\n        commaTok.kind match {\n        | TKComma() ->\n          if (this.lex.peekKind() is Some(TKCloseCurly())) {\n            _ = this.lex.next();\n            break void;\n          }\n        | TKCloseCurly() -> break void\n        | _ -> this.error(this.lex.posStart(commaTok), UnexpectedToken())\n        }\n      };\n      PObject{fields => fields.toArray().sortedBy(x ~> x.i0.value), rest}\n    | _ -> PVar(this.getName())\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/ParserStmt.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Statement parsing methods for the TypeScript parser. */\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class Parser {\n  /***************************************************************************/\n  // Statement parsing\n  //\n  // <stmt_> ::=\n  //   | ;\n  //   | <expr>\n  //   | return <expr>?\n  //   | throw <expr>\n  //   | if ( <expr> ) <stmt>* (else <stmt>*)?\n  //   | for ( <stmt> in <expr> ) <stmt>*\n  //   | for ( <stmt> of <expr> ) <stmt>*\n  //   | for ( <stmt> ; <expr> ; <expr> ) <stmt>*\n  //   | while ( <expr> ) <stmt>*\n  //   | let <binding>*\n  //   | var <binding>*\n  //   | const <binding>*\n  //   | switch ( <expr> ) { <switch-branch>* }\n  //   | try { <stmt>* } (catch ( <pattern> (: <type>)? ) { <stmt>* })? (finally { <stmt>* })?\n  //   | { <stmt>* }\n  /***************************************************************************/\n\n  // Parse a block of statements\n  mutable fun block(): Array<Stmt> {\n    (this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedBlock())\n    | Some(x) -> x\n    }).kind match {\n    | TKOpenCurly() ->\n      _ = this.lex.next();\n      stmts = mutable Vector[];\n      loop {\n        this.stmt() match {\n        | None() ->\n          this.expect(TKCloseCurly());\n          return stmts.toArray()\n        | Some(st) -> stmts.push(st)\n        }\n      }\n    | _ ->\n      this.stmt() match {\n      | None() -> Array[]\n      | Some(x) -> Array[x]\n      }\n    }\n  }\n\n  // Parse a single statement\n  mutable fun stmt(): ?Stmt {\n    start = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n    | Some(tok) -> tok.posStart\n    };\n    result = this.stmt_();\n    end = this.lex.lastTok.fromSome().posEnd;\n    result match {\n    | None() -> None()\n    | Some(x) -> Some(Stmt(PosRange::create(this.lex, start, end), x))\n    }\n  }\n\n  // Internal statement parsing implementation\n  mutable fun stmt_(): ?Stmt_ {\n    tok = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n    | Some(x) -> x\n    };\n    tok.kind match {\n    | TKCloseCurly() -> None()\n    | TKSemi() ->\n      _ = this.lex.next();\n      Some(StmtEmpty())\n    | TKOpenCurly() ->\n      _ = this.lex.next();\n      stmts = mutable Vector[];\n      loop {\n        this.stmt() match {\n        | None() -> break void\n        | Some(st) -> stmts.push(st)\n        }\n      };\n      this.expect(TKCloseCurly());\n      Some(Block(stmts.toArray()))\n    | TKVar() ->\n      keyword = this.lex.getStrTok(tok);\n      keyword match {\n      | \"break\" ->\n        _ = this.lex.next();\n        Some(Break())\n      | \"continue\" ->\n        _ = this.lex.next();\n        Some(Continue())\n      | \"switch\" ->\n        _ = this.lex.next();\n        this.expect(TKOpenParen());\n        e = this.expr(0);\n        this.expect(TKCloseParen());\n        this.expect(TKOpenCurly());\n        cases = mutable Vector<SwitchBranch>[];\n        loop {\n          caseTok = this.lex.next() match {\n          | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n          | Some(x) -> x\n          };\n          this.lex.getStrTok(caseTok) match {\n          | \"case\" ->\n            value = this.expr(0);\n            this.expect(TKColon());\n            stmts = mutable Vector[];\n            loop {\n              this.stmt() match {\n              | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n              | Some(st) -> stmts.push(st)\n              };\n              this.lex.peekStr() match {\n              | Some(\"case\")\n              | Some(\"default\")\n              | Some(\"}\") ->\n                break void\n              | _ -> void\n              }\n            };\n            cases.push(Case(value, stmts.toArray()))\n          | \"default\" ->\n            this.expect(TKColon());\n            stmts = mutable Vector[];\n            loop {\n              this.stmt() match {\n              | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n              | Some(st) -> stmts.push(st)\n              };\n              this.lex.peekStr() match {\n              | Some(\"case\")\n              | Some(\"default\")\n              | Some(\"}\") ->\n                break void\n              | _ -> void\n              }\n            };\n            cases.push(Default(stmts.toArray()))\n          | \"}\" -> break void\n          | _ -> this.error(this.lex.posStart(caseTok), UnexpectedToken())\n          }\n        };\n        Some(Switch(e, cases.toArray()))\n      | \"if\" ->\n        _ = this.lex.next();\n        this.expect(TKOpenParen());\n        e = this.expr(0);\n        this.expect(TKCloseParen());\n        ifBlock = this.block();\n        elseBlock = this.lex.peekStr() match {\n        | Some(\"else\") ->\n          _ = this.lex.next();\n          Some(this.block())\n        | _ -> None()\n        };\n        Some(If(e, ifBlock, elseBlock))\n      | \"return\" ->\n        retTok = this.lex.next().fromSome();\n        if (\n          this.lex.peekKind() is Some(TKSemi()) ||\n          this.lex.peekKind() is Some(TKCloseCurly())\n        ) {\n          return Some(\n            Return(\n              PosRange::create(this.lex, retTok.posStart, retTok.posEnd),\n              None(),\n            ),\n          );\n        };\n        Some(\n          Return(\n            PosRange::create(this.lex, retTok.posStart, retTok.posEnd),\n            Some(this.expr(0)),\n          ),\n        )\n      | \"throw\" ->\n        _ = this.lex.next();\n        Some(Throw(this.expr(0)))\n      | \"while\" ->\n        _ = this.lex.next();\n        this.expect(TKOpenParen());\n        cond = this.expr(0);\n        this.expect(TKCloseParen());\n        if (this.lex.peekKind() is Some(TKOpenCurly())) {\n          _ = this.lex.next();\n          stmts = mutable Vector[];\n          loop {\n            this.stmt() match {\n            | None() -> break void\n            | Some(st) -> stmts.push(st)\n            };\n          };\n          this.expect(TKCloseCurly());\n          return Some(While(cond, stmts.toArray()));\n        };\n        this.stmt() match {\n        | None() -> this.error(this.lex.posEnd(), ExpectedStmt())\n        | Some(st) -> Some(While(cond, Array[st]))\n        }\n      | \"for\" ->\n        _ = this.lex.next();\n        this.expect(TKOpenParen());\n        st = this.stmt() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n        | Some(x) -> x\n        };\n        inTok = this.lex.next() match {\n        | None() -> this.error(this.lex.posEnd(), UnterminatedStmt())\n        | Some(x) -> x\n        };\n        inTok.kind match {\n        | TKVar() ->\n          forInOfKind = this.lex.getStrTok(inTok) match {\n          | \"in\" -> ForIn()\n          | \"of\" -> ForOf()\n          | _ ->\n            this.error(this.lex.posStart(inTok), ExpectedTokenNot(TKSemi()))\n          };\n          e = this.expr(0);\n          this.expect(TKCloseParen());\n          block = this.blockOrStmt();\n          Some(ForInOf(forInOfKind, st, e, block))\n        | TKSemi() ->\n          cond = this.expr(0);\n          this.expect(TKSemi());\n          incr = this.expr(0);\n          this.expect(TKCloseParen());\n          block = this.blockOrStmt();\n          Some(For(st, cond, incr, block))\n        | _ -> this.error(this.lex.posStart(inTok), ExpectedTokenNot(TKSemi()))\n        }\n      | bk @ \"let\"\n      | bk @ \"const\"\n      | bk @ \"var\" ->\n        _ = this.lex.next();\n        bkind = bk match {\n        | \"let\" -> BKLet()\n        | \"const\" -> BKConst()\n        | \"var\" -> BKVar()\n        | _ -> internal_error(\"Internal error\")\n        };\n        bindings = mutable Vector[];\n        loop {\n          pat = this.pattern();\n          type = if (this.lex.peekKind() is Some(TKColon())) {\n            _ = this.lex.next();\n            Some(this.type(0));\n          } else {\n            None()\n          };\n          e = if (this.lex.peekKind() is Some(TKAssignment())) {\n            this.expect(TKAssignment());\n            value = this.expr(0);\n            Some(value)\n          } else {\n            None()\n          };\n          bindings.push(Binding(pat, type, e));\n          if (this.lex.peekKind() is Some(TKComma())) {\n            _ = this.lex.next();\n          } else {\n            break void\n          }\n        };\n        Some(Bind(bkind, bindings.toArray()))\n      | \"try\" ->\n        _ = this.lex.next();\n        this.expect(TKOpenCurly());\n        tryBlock = mutable Vector[];\n        loop {\n          this.stmt() match {\n          | None() -> break void\n          | Some(st) -> tryBlock.push(st)\n          }\n        };\n        this.expect(TKCloseCurly());\n\n        catchClause = this.lex.peekStr() match {\n        | Some(\"catch\") ->\n          _ = this.lex.next();\n          (param, type) = if (this.lex.peekKind() is Some(TKOpenParen())) {\n            this.expect(TKOpenParen());\n            param = if (this.lex.peekKind() is Some(TKCloseParen())) {\n              None()\n            } else {\n              Some(this.pattern())\n            };\n            type = if (this.lex.peekKind() is Some(TKColon())) {\n              _ = this.lex.next();\n              Some(this.type(0))\n            } else {\n              None()\n            };\n            this.expect(TKCloseParen());\n            (param, type)\n          } else {\n            (None(), None())\n          };\n          this.expect(TKOpenCurly());\n          catchBlock = mutable Vector[];\n          loop {\n            this.stmt() match {\n            | None() -> break void\n            | Some(st) -> catchBlock.push(st)\n            }\n          };\n          this.expect(TKCloseCurly());\n          Some(CatchClause(param, type, catchBlock.toArray()))\n        | _ -> None()\n        };\n\n        finallyBlock = this.lex.peekStr() match {\n        | Some(\"finally\") ->\n          _ = this.lex.next();\n          this.expect(TKOpenCurly());\n          finallyStmts = mutable Vector[];\n          loop {\n            this.stmt() match {\n            | None() -> break void\n            | Some(st) -> finallyStmts.push(st)\n            }\n          };\n          this.expect(TKCloseCurly());\n          Some(finallyStmts.toArray())\n        | _ -> None()\n        };\n\n        if (catchClause is None() && finallyBlock is None()) {\n          this.error(this.lex.posEnd(), ExpectedCatchOrFinally())\n        };\n\n        Some(Try(tryBlock.toArray(), catchClause, finallyBlock))\n\n      | _ ->\n        e = this.expr(0);\n        Some(StmtExpr(e))\n      }\n    | _ -> Some(StmtExpr(this.expr(0)))\n    }\n  }\n\n  // Parse either a block or a single statement\n  mutable fun blockOrStmt(): Array<Stmt> {\n    this.lex.peekKind() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKOpenCurly()))\n    | Some(TKOpenCurly()) -> this.block()\n    | _ ->\n      this.stmt() match {\n      | None() -> this.error(this.lex.posEnd(), ExpectedToken(TKOpenCurly()))\n      | Some(x) -> Array[x]\n      }\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/ParserType.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class Parser {\n  /***************************************************************************/\n  // <type_> ::=\n  //   | \" <string> \"\n  //   | ' <string> '\n  //   | ` <string> `\n  //   | true | false\n  //   | <number>\n  //   | <bigint>\n  //   | <prim-kind>\n  //   | typeof <type>\n  //   | <type> []\n  //   | { <field-type>* }\n  //   | <name> < <type>* >\n  //   | <type> | <type>\n  //   | <type> & <type>\n  //   | [ <tuple-elt-type>* ]\n  //   | function ( <ta-fun-param>* ) : <type>\n  //   | <type> [ <type> ]\n  //   | <type> extends <type> ? <type> : <type>\n  //   | <type> extends <type>\n  //   | readonly <type>\n  //   | import ( <expr> , <name>? , <type>* )\n  //   | infer <name>\n  //   | []\n  //   | keyof <type>\n  //   | new <type>\n  //   | abstract <type>\n  //   | <type> is <type>\n  //   | asserts <name>\n  //   | <name> asserts <type>\n  //   | unique symbol\n  /***************************************************************************/\n\n  mutable fun type(prec: Int): Type {\n    inTypeCopy = this.lex.inType;\n    this.lex.!inType = true;\n    start = this.lex.peek() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n    | Some(tok) -> tok.posStart\n    };\n    if (\n      this.lex.peekKind() is Some(TKBitwiseOr()) ||\n      this.lex.peekKind() is Some(TKBitwiseAnd())\n    ) {\n      _ = this.lex.next();\n    };\n    type = this.type_(prec);\n    end = this.lex.lastTok.fromSome().posEnd;\n    this.lex.!inType = inTypeCopy;\n    Type(PosRange::create(this.lex, start, end), type)\n  }\n\n  mutable fun type_(prec: Int): Type_ {\n    tok = this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n    | Some(x) -> x\n    };\n    left = tok.kind match {\n    | TKQuote() -> TAStringLiteral(this.lex.getStrTok(tok))\n    | TKDoubleQuote() -> TAStringLiteral(this.lex.getStrTok(tok))\n    | TKBackTick() -> TATemplate(this.lex.getStrTok(tok))\n    | TKBigInt() -> TABigIntLiteral(this.lex.getStrTok(tok))\n    | TKNumber() -> TANumLiteral(this.lex.getStrTok(tok))\n    | TKLessThan() ->\n      tparams = this.typeParams();\n      this.type(0) match {\n      | Type(_, TAFun(isMethod, emptyTParams, params, retType, cgNode)) ->\n        if (emptyTParams.size() != 0) {\n          internal_error(\"emptyTParams should be empty\")\n        };\n        TAFun(isMethod, tparams, params, retType, cgNode)\n      | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())\n      }\n    | TKOpenSquare() ->\n      if (this.lex.peekKind() is Some(TKCloseSquare())) {\n        _ = this.lex.next();\n        TAEmptyArray()\n      } else {\n        result = mutable Vector<TupleEltType>[];\n        loop {\n          if (this.lex.peekKind() is Some(TKDotDotDot())) {\n            _ = this.lex.next();\n            ty = this.type(0);\n            if (this.lex.peekKind() is Some(TKColon())) {\n              colonTok = this.lex.next().fromSome();\n              ty.value match {\n              | TAInst(n, targs) if (targs.size() == 0) ->\n                result.push(TESpread(Some(n), this.type(0)))\n              | _ -> this.error(this.lex.posStart(colonTok), UnexpectedToken())\n              }\n            } else {\n              result.push(TESpread(None(), ty))\n            };\n          } else if ( // Named elements in a tuple\n            this.lex.lookAhead(() -> {\n              this.lex.peekKind() is Some(TKVar()) &&\n                {\n                  _ = this.lex.next();\n                  this.lex.peekKind() is Some(TKColon()) ||\n                    this.lex.peekKind() is Some(TKQuestionMark()) &&\n                      {\n                        _ = this.lex.next();\n                        this.lex.peekKind() is Some(TKColon())\n                      }\n                }\n            })\n          ) {\n            name = this.getName();\n            optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {\n              nextTokPos = this.lex.next().fromSome();\n              Some(\n                PosRange::create(\n                  this.lex,\n                  nextTokPos.posStart,\n                  nextTokPos.posEnd,\n                ),\n              )\n            } else {\n              None()\n            };\n            this.expect(TKColon());\n            type = this.type(0);\n            result.push(TEType(Some(name), optional, type));\n          } else {\n            type = this.type(0);\n            optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {\n              nextTokPos = this.lex.next().fromSome();\n              Some(\n                PosRange::create(\n                  this.lex,\n                  nextTokPos.posStart,\n                  nextTokPos.posEnd,\n                ),\n              )\n            } else {\n              None()\n            };\n            result.push(TEType(None(), optional, type));\n          };\n          commaTok = this.lex.next() match {\n          | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n          | Some(x) -> x\n          };\n          commaTok.kind match {\n          | TKCloseSquare() -> break void\n          | TKComma() ->\n            if (this.lex.peekKind() is Some(TKCloseSquare())) {\n              _ = this.lex.next();\n              break void\n            }\n          | _ ->\n            this.error(\n              this.lex.posStart(commaTok),\n              ExpectedTokenNot(TKCloseSquare()),\n            )\n          }\n        };\n        TATuple(result.toArray())\n      }\n    | TKOpenParen() ->\n      if (this.isTypeFunParams()) {\n        params = this.typeFunParams();\n        this.expect(TKClosure());\n        retType = this.type(0);\n        TAFun(\n          false,\n          Array[],\n          params,\n          retType,\n          CGNode::create(ArrowTypeAnnot(this.lex.fileName)),\n        )\n      } else {\n        res = this.type(0).value;\n        this.expect(TKCloseParen());\n        res\n      }\n    | TKOpenCurly() -> TAObject(this.objectFields())\n    | TKVar() ->\n      this.lex.getStrTok(tok) match {\n      | \"typeof\" -> TATypeOf(this.type(0))\n      | \"import\" ->\n        this.expect(TKOpenParen());\n        e = this.expr(0);\n        this.expect(TKCloseParen());\n        if (this.lex.peekKind() is Some(TKDot())) {\n          this.expect(TKDot());\n          name = this.getName();\n          loop {\n            if (this.lex.peekKind() != Some(TKDot())) break void;\n            _ = this.lex.next();\n            dotName = this.getName();\n            !name = Name(\n              name.pos.extend(dotName.pos),\n              name.value + \".\" + dotName.value,\n            );\n          };\n          targs = if (this.lex.peekKind() is Some(TKLessThan())) {\n            _ = this.lex.next();\n            this.typeList()\n          } else {\n            Array[]\n          };\n          TAImport(e, Some(name), Some(targs))\n        } else {\n          TAImport(e, None(), None())\n        }\n      | \"asserts\" ->\n        name = this.getName();\n        if (this.lex.peekStr() is Some(\"is\")) {\n          _ = this.lex.next();\n          TAAssertIs(name, this.type(0))\n        } else {\n          TAAsserts(name)\n        }\n      | \"unique\" ->\n        this.expectStr(\"symbol\");\n        TAUniqueSymbol()\n      | \"null\" -> TAPrim(TPKNull())\n      | \"number\" -> TAPrim(TPKNum())\n      | \"boolean\" -> TAPrim(TPKBool())\n      | \"string\" -> TAPrim(TPKString())\n      | \"bigint\" -> TAPrim(TPKBigInt())\n      | \"readonly\" -> TAReadonly(this.type(prec))\n      | \"infer\" -> TAInfer(this.getName())\n      | \"keyof\" -> TAKeyOf(this.type(prec))\n      | \"abstract\" -> TANew(this.type(prec))\n      | \"new\" -> TANew(this.type(prec))\n      | className ->\n        name = Name(\n          PosRange::create(this.lex, tok.posStart, tok.posEnd),\n          className,\n        );\n        loop {\n          if (this.lex.peekKind() != Some(TKDot())) break void;\n          _ = this.lex.next();\n          dotName = this.getName();\n          !name = Name(\n            name.pos.extend(dotName.pos),\n            name.value + \".\" + dotName.value,\n          );\n        };\n        targs = if (this.lex.peekKind() is Some(TKLessThan())) {\n          _ = this.lex.next();\n          this.typeList()\n        } else {\n          Array[]\n        };\n        TAInst(name, targs)\n      }\n    | TKSubtraction() ->\n      numTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      numTok.kind match {\n      | TKNumber() -> TANumLiteral(\"-\" + this.lex.getStrTok(numTok))\n      | _ -> this.error(this.lex.posStart(numTok), ExpectedTokenNot(TKNumber()))\n      }\n    | TKAddition() ->\n      numTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      numTok.kind match {\n      | TKNumber() -> TANumLiteral(this.lex.getStrTok(numTok))\n      | _ -> this.error(this.lex.posStart(numTok), ExpectedTokenNot(TKNumber()))\n      }\n    | _ -> this.error(this.lex.posStart(tok), UnexpectedToken())\n    };\n\n    loop {\n      if (\n        this.lex.lookAhead(() -> {\n          pos = this.lex.pos;\n          this.lex.peekKind() is Some(TKOpenSquare()) &&\n            {\n              _ = this.lex.next();\n              if (this.lex.peekKind() is Some(TKCloseSquare())) return false;\n              for (i in Range(pos, this.lex.pos)) {\n                if (this.lex.contents[i] == '\\n') return true;\n              };\n              false\n            }\n        })\n      ) {\n        break void;\n      };\n      if (this.lex.peekKind() is Some(TKOpenSquare())) {\n        _ = this.lex.next();\n        if (this.lex.peekKind() is Some(TKCloseSquare())) {\n          _ = this.lex.next();\n          leftRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          !left = TAArray(Type(leftRange, left));\n          continue;\n        };\n        ty = this.type(0);\n        leftRange = PosRange::create(\n          this.lex,\n          tok.posStart,\n          this.lex.getLastPos(),\n        );\n        this.expect(TKCloseSquare());\n        !left = TAGet(Type(leftRange, left), ty);\n      } else {\n        break void\n      }\n    };\n\n    loop {\n      this.lex.peekKind() match {\n      | Some(TKVar()) if (this.lex.peekStr() == Some(\"is\")) ->\n        _ = this.lex.next();\n        leftRange = PosRange::create(\n          this.lex,\n          tok.posStart,\n          this.lex.getLastPos(),\n        );\n        !left = TAIs(Type(leftRange, left), this.type(0))\n      | Some(TKVar()) if (this.lex.peekStr() is Some(\"extends\")) ->\n        (_assoc, assignPrec) = precedence[TKAssignment()];\n        ternaryCondPrec = assignPrec + 1;\n        if (prec >= ternaryCondPrec) return left;\n        _ = this.lex.next();\n        ty1 = this.type(ternaryCondPrec);\n        if (this.lex.peekKind() is Some(TKQuestionMark())) {\n          this.expect(TKQuestionMark());\n          ty2 = this.type(0);\n          this.expect(TKColon());\n          ty3 = this.type(assignPrec);\n          leftRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          !left = TAExtendsQuestion(Type(leftRange, left), ty1, ty2, ty3);\n        } else {\n          leftRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          !left = TAExtends(Type(leftRange, left), ty1);\n        };\n        continue\n      | Some(bop @ TKBitwiseOr())\n      | Some(bop @ TKBitwiseAnd()) ->\n        isType = bop match {\n        | TKBitwiseOr() -> true\n        | TKBitwiseAnd() -> false\n        | _ -> internal_error(\"Internal error\")\n        };\n        (assoc, bopPrec) = precedence[bop];\n        if (!(assoc is ALeft())) internal_error(\"assoc should be ALeft\");\n        if (bopPrec == prec) {\n          leftRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          _ = this.lex.next();\n          right = this.type(prec + 1);\n          !left = isType match {\n          | true -> TAUnion(Type(leftRange, left), right)\n          | false -> TAInter(Type(leftRange, left), right)\n          };\n          continue;\n        };\n        if (bopPrec > prec) {\n          leftRange = PosRange::create(\n            this.lex,\n            tok.posStart,\n            this.lex.getLastPos(),\n          );\n          _ = this.lex.next();\n          right = this.type(bopPrec);\n          !left = isType match {\n          | true -> TAUnion(Type(leftRange, left), right)\n          | false -> TAInter(Type(leftRange, left), right)\n          };\n          continue;\n        };\n        if (bopPrec >= prec) {\n          internal_error(\"bopPrec should be less than prec\")\n        };\n        return left\n      | _ -> return left\n      }\n    }\n  }\n\n  mutable fun isTypeFunParams(): Bool {\n    this.lex.lookAhead(() -> {\n      countParen = 1;\n      loop {\n        this.lex.next().map(x -> x.kind) match {\n        | None() -> return false\n        | Some(TKOpenParen()) -> !countParen = countParen + 1\n        | Some(TKCloseParen()) ->\n          !countParen = countParen - 1;\n          if (countParen == 0) {\n            return this.lex.peekKind() is Some(TKClosure())\n          }\n        | Some _ -> continue\n        }\n      }\n    })\n  }\n\n  mutable fun typeFunParams(): Array<TAFunParam> {\n    if (this.lex.peekKind() is Some(TKCloseParen())) {\n      _ = this.lex.next();\n      return Array[];\n    };\n    result = mutable Vector[];\n    loop {\n      tok = this.lex.peek() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      tok.kind match {\n      | TKDotDotDot() ->\n        _ = this.lex.next();\n        spreadName = this.getName();\n        optional = if (this.lex.peekKind() is Some(TKQuestionMark())) {\n          qm = this.lex.next().fromSome();\n          Some(PosRange::create(this.lex, qm.posStart, qm.posEnd))\n        } else {\n          None()\n        };\n        if (this.lex.peekKind() is Some(TKColon())) {\n          _ = this.lex.next();\n          type = this.type(0);\n          result.push(\n            TAFunParam(Some(TAParamSpread(spreadName)), optional, type),\n          );\n        } else {\n          this.error(this.lex.posStart(tok), UnexpectedToken())\n        }\n      | TKOpenCurly() ->\n        _ = this.lex.next();\n        curlyNames = mutable Vector[];\n        spread: ?Name = None();\n        loop {\n          if (this.lex.peekKind() is Some(TKDotDotDot())) {\n            _ = this.lex.next();\n            !spread = Some(this.getName());\n            if (this.lex.peekKind() is Some(TKComma())) {\n              _ = this.lex.next();\n            };\n            this.expect(TKCloseCurly());\n            break void;\n          };\n          name = this.getName();\n          if (this.lex.peekKind() is Some(TKColon())) {\n            _ = this.lex.next();\n            type = this.type(0);\n            curlyNames.push(CurlyName(name, Some(type)))\n          } else {\n            curlyNames.push(CurlyName(name, None()))\n          };\n          commaTok = this.lex.next() match {\n          | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n          | Some(x) -> x\n          };\n          commaTok.kind match {\n          | TKComma() ->\n            if (this.lex.peekKind() is Some(TKCloseCurly())) {\n              _ = this.lex.next();\n              break void\n            }\n          | TKCloseCurly() -> break void\n          | _ -> this.error(this.lex.posStart(commaTok), UnexpectedToken())\n          }\n        };\n        qm = if (this.lex.peekKind() is Some(TKQuestionMark())) {\n          nextTokPos = this.lex.next().fromSome();\n          Some(\n            PosRange::create(this.lex, nextTokPos.posStart, nextTokPos.posEnd),\n          )\n        } else {\n          None()\n        };\n        this.expect(TKColon());\n        type = this.type(0);\n        result.push(\n          TAFunParam(\n            Some(TACurlyNames(curlyNames.toArray(), spread)),\n            qm,\n            type,\n          ),\n        )\n      | _ ->\n        if (\n          this.lex.lookAhead(() -> {\n            _ = this.lex.next();\n            this.lex.peekKind() is Some(TKQuestionMark()) ||\n              this.lex.peekKind() is Some(TKColon())\n          })\n        ) {\n          paramName = this.getName();\n          if (this.lex.peekKind() is Some(TKQuestionMark())) {\n            qm = this.lex.next().fromSome();\n            this.expect(TKColon());\n            type = this.type(0);\n            result.push(\n              TAFunParam(\n                Some(TAParamName(paramName)),\n                Some(PosRange::create(this.lex, qm.posStart, qm.posEnd)),\n                type,\n              ),\n            );\n          } else {\n            if (!(this.lex.peekKind() is Some(TKColon()))) {\n              internal_error(\"expected TKColon\")\n            };\n            _ = this.lex.next();\n            type = this.type(0);\n            result.push(TAFunParam(Some(TAParamName(paramName)), None(), type));\n          }\n        } else {\n          this.error(this.lex.posStart(tok), MissingParameterName())\n        }\n      };\n      tokComma = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      tokComma.kind match {\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKCloseParen())) {\n          _ = this.lex.next();\n          return result.toArray()\n        }\n      | TKCloseParen() -> return result.toArray()\n      | _ ->\n        this.error(\n          this.lex.posStart(tokComma),\n          ExpectedTokenNot(TKCloseParen()),\n        )\n      }\n    }\n  }\n\n  mutable fun typeList(): Array<Type> {\n    result = mutable Vector[];\n    loop {\n      result.push(this.type(0));\n      commaTok = this.lex.next() match {\n      | None() -> this.error(this.lex.posEnd(), UnterminatedType())\n      | Some(x) -> x\n      };\n      commaTok.kind match {\n      | TKGreaterThan() -> return result.toArray()\n      | TKComma() ->\n        if (this.lex.peekKind() is Some(TKGreaterThan())) {\n          _ = this.lex.next();\n          return result.toArray()\n        }\n      | _ ->\n        this.error(\n          this.lex.posStart(commaTok),\n          ExpectedTokenNot(TKGreaterThan()),\n        )\n      }\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/ParserUtils.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class Parser {\n  /***************************************************************************/\n  // Helpers\n  /***************************************************************************/\n\n  readonly fun error<T>(pos: ErrorPos, kind: ParsingKind): T {\n    error(ParsingError(pos, kind))\n  }\n\n  mutable fun expect(kind: TokenKind): void {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedToken(kind))\n    | Some(tok) if (tok.kind == kind) -> void\n    | Some(tok) -> this.error(this.lex.posStart(tok), ExpectedTokenNot(kind))\n    }\n  }\n\n  mutable fun expectStr(str: String): void {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedStrNot(str))\n    | Some(tok) ->\n      if (this.lex.isEqTok(tok, str)) void else {\n        this.error(this.lex.posStart(tok), ExpectedStrNot(str))\n      }\n    }\n  }\n\n  mutable fun expectStringValue(): void {\n    this.lex.next() match {\n    | None() -> this.error(this.lex.posEnd(), ExpectedString())\n    | Some(tok) ->\n      tok.kind match {\n      | TKQuote()\n      | TKDoubleQuote()\n      | TKBackTick() ->\n        void\n      | _ ->\n        this.error(\n          this.lex.posStart(tok),\n          ExpectedStringNot(this.lex.getStrTok(tok)),\n        )\n      }\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/Position.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Positions in the source code. */\n/***************************************************************************/\n\nmodule SKJS;\n\n/***************************************************************************/\n/* Position types. */\n/***************************************************************************/\n\nvalue class RelPos(fileName: String, line: Int, col: Int) uses Show, Equality {\n  fun toString(): String {\n    fileName = this.fileName.replace(\"\\\"\", \"\\\\\\\"\");\n    `File \"${fileName}\", line ${this.line}, character ${this.col}:`\n  }\n}\nvalue class RelPosRange(start: RelPos, end: RelPos) {\n  fun toString(): String {\n    if (this.start.fileName != this.end.fileName) {\n      internal_error(\"start and end fileName must match\")\n    };\n    if (this.start.line != this.end.line) {\n      return this.start.toString();\n    };\n    fileName = this.start.fileName.replace(\"\\\"\", \"\\\\\\\"\");\n    `File \"${fileName}\", line ${this.start.line}, character ${this.start.col}-${\n      this.end.col\n    }:`\n  }\n}\n\nvalue class Pos(value: Int) uses Hashable, XXHashable, Orderable {\n  const none: this = Pos(-1);\n\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    if (ignorePos) {\n      // Intentionally collide all PosRange hashes so that ASTs can compare as equal if they only differ in PosRange values\n      XXHash(3691082372) // first 8 bytes of sha256(\"Pos\")\n    } else {\n      internal_error(\"should never xx-hash a Pos\")\n    };\n  }\n}\n\nvalue class PosRange private (\n  symbol: SymbolicPos,\n  fileName: String,\n  relStart: Pos,\n  relEnd: Pos,\n) uses XXHashable, Orderable {\n  const none: this = PosRange(SPTopLevel(), \"\", Pos::none, Pos::none);\n\n  static fun create(lexer: readonly Lexer, start: Pos, end: Pos): this {\n    symbolPos = lexer.currentSymbolPos;\n    relativeStart = Pos(start.value - symbolPos);\n    relativeEnd = Pos(end.value - symbolPos);\n    static(lexer.currentSymbol, lexer.fileName, relativeStart, relativeEnd)\n  }\n\n  fun extend(end: PosRange): this {\n    if (this.symbol != end.symbol) {\n      internal_error(\"Cannot extend a position with a different symbol\");\n    };\n    this with {relEnd => end.relEnd}\n  }\n\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    if (ignorePos) {\n      // Intentionally collide all PosRange hashes so that ASTs can compare as equal if they only differ in PosRange values\n      XXHash(1232240476) // first 8 bytes of sha256(\"PosRange\")\n    } else {\n      internal_error(\"should never xx-hash a PosRange\")\n    };\n  }\n\n  fun getStart(symbols: Map<SymbolicPos, Int>): Pos {\n    this.symbol match {\n    | SPTopLevel() -> this.relStart\n    | other -> Pos(symbols[other] + this.relStart.value)\n    }\n  }\n\n  fun getEnd(symbols: Map<SymbolicPos, Int>): Pos {\n    this.symbol match {\n    | SPTopLevel() -> this.relEnd\n    | other -> Pos(symbols[other] + this.relEnd.value)\n    }\n  }\n\n  fun atEnd(): this {\n    this with {relStart => this.relEnd}\n  }\n}\n\n/***************************************************************************/\n/* Position resolver. */\n/***************************************************************************/\n\nclass PositionResolver{\n  fileName: String = \"\",\n  newLines: Array<Int> = Array[],\n  symbols: Map<SymbolicPos, Int>,\n} {\n  fun relPosRange(pos: PosRange): RelPosRange {\n    RelPosRange(\n      this.relPos(pos.getStart(this.symbols)),\n      this.relPos(pos.getEnd(this.symbols)),\n    )\n  }\n\n  fun relPos(pos: Pos): RelPos {\n    idx = SKStore.binSearch(\n      i ~> this.newLines[i],\n      pos.value,\n      0,\n      this.newLines.size() - 1,\n    );\n    if (idx <= 0 || idx >= this.newLines[idx]) {\n      return RelPos(this.fileName, 1, pos.value + 1)\n    };\n    RelPos(this.fileName, idx + 1, pos.value - this.newLines[idx - 1])\n  }\n}\n\nmodule end;\n"}, {"path": "src/Reachability.sk", "mtime": 1762775914, "contents": "/*****************************************************************************/\n/* Reachability Analysis for SKJS */\n/*****************************************************************************/\n\nmodule SKJS;\n\nbase class CGNode_ uses XXHashable, Show {\n  children =\n  | TopLevelFunDef(name: SimpleSymbol, fileName: String)\n  | Method(name: ?SimpleSymbol, class_: Name, fileName: String, static_: Bool)\n  | ObjectMethod(name: SimpleSymbol, fileName: String)\n  | Constructor(class_: Name, fileName: String)\n  | Toplevel(fileName: String)\n  | ArrowTypeAnnot(fileName: String)\n\n  fun getFileName(): String {\n    this match {\n    | TopLevelFunDef(_, fileName)\n    | Method(_, _, fileName, _)\n    | ObjectMethod(_, fileName)\n    | Constructor(_, fileName)\n    | Toplevel(fileName)\n    | ArrowTypeAnnot(fileName) ->\n      fileName\n    | AnonymousLambda(pos, _) -> pos.fileName\n    | AnonymousFunDef(fd) -> fd.pos.fileName\n    }\n  }\n\n  fun toString(): String {\n    this match {\n    | TopLevelFunDef(name, file) -> `toplevel: ${name.getName()} (${file})`\n    | Method(name, class_, file, static_) ->\n      strStatic = if (static_) \"static \" else \"\";\n      strName = name match {\n      | Some(n) -> n.getName()\n      | None() -> \"__anonymous\"\n      };\n      `${strStatic}${class_}.${strName} (${file})`\n    | ObjectMethod(name, file) -> `anonymous_object.${name.getName()} (${file})`\n    | Constructor(class_, file) -> `${class_}.constructor (${file})`\n    | Toplevel(file) -> `top-level expr (${file}`\n    | ArrowTypeAnnot(file) -> `arrow-type annotation (${file})`\n    | AnonymousLambda(pos, _closure) ->\n      `lambda (${pos.fileName}:${pos.relStart.value})`\n    | AnonymousFunDef(fd) ->\n      name = fd.name match {\n      | Some(n) -> \"\\\"\" + n.getName() + \"\\\"\"\n      | None() -> \"(anonymous)\"\n      };\n      `function def \" ${name} (${fd.pos.fileName}:${fd.pos.relStart.value})`\n    }\n  }\n}\nclass AnonymousLambda(\n  pos: PosRange,\n  closure: Closure,\n) extends CGNode_ uses XXHashable {\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    //always hash the pos to be more conservative\n    XXHash(\n      XXHash64.xxHash64(\n        (\n          this.pos.fileName,\n          this.pos.relStart.value,\n          this.pos.relEnd.value,\n        ).xxhash().value,\n        this.closure.xxhash(ignorePos).value,\n      ),\n    )\n  }\n}\nclass AnonymousFunDef(funDef: FunDef) extends CGNode_ {\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    //always hash the pos to be more conservative\n    XXHash(\n      XXHash64.xxHash64(\n        (\n          this.funDef.pos.fileName,\n          this.funDef.pos.relStart.value,\n          this.funDef.pos.relEnd.value,\n        ).xxhash().value,\n        this.funDef.xxhash(ignorePos).value,\n      ),\n    )\n  }\n}\n\nclass CGNode private (\n  id: CGNode_,\n  precomputed_hash: XXHash,\n) extends SKStore.Key, SKStore.File uses Hashable, XXHashable {\n  static fun create(id: CGNode_): this {\n    static(id, id.xxhash(true))\n  }\n\n  static fun toplevel(fileName: String): this {\n    static::create(Toplevel(fileName))\n  }\n\n  fun hash(): Int {\n    this.precomputed_hash.value\n  }\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    if (ignorePos) this.precomputed_hash else this.id.xxhash(false)\n  }\n  fun toString(): String {\n    `CGNode[${this.id}]`\n  }\n  fun compare(other: SKStore.Key): Order {\n    other match {\n    | CGNode(_otherId, otherHash) -> this.precomputed_hash.compare(otherHash)\n    | _ -> invariant_violation(\"CGNode comparison to non-CGNode Key\")\n    }\n  }\n}\n\nclass CGNodes(nodes: SortedSet<CGNode>) uses XXHashable, Orderable {\n  fun toString(): String {\n    nodes = this.nodes.collect(Vector).map((n) -> n.id).join(\", \");\n    `CGNodes[${nodes}]`\n  }\n\n  static fun singleton(node: CGNode): this {\n    static(SortedSet::create().add(node))\n  }\n  static fun empty(): this {\n    static(SortedSet::create())\n  }\n\n  fun union(that: CGNodes): this {\n    static(this.nodes.union(that.nodes))\n  }\n  fun intersection(that: CGNodes): this {\n    static(this.nodes.intersection(that.nodes))\n  }\n  fun compare(other: CGNodes): Order {\n    this.nodes.inner.compare(other.nodes.inner)\n  }\n\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    XXHash(\n      this.nodes.iterator().foldl(\n        (seed, node) -> XXHash64.xxHash64(seed, node.xxhash(ignorePos).value),\n        -1,\n      ),\n    )\n  }\n}\n\nclass CallGraphFile(\n  callgraph: SortedMap<CGNode, Array<CGNode>> = SortedMap[],\n) extends SKStore.File {\n  fun recordCalls(caller: CGNode, newCallees: CGNodes): this {\n    oldCallees = this.callgraph.maybeGet(caller).default(Array[]);\n    callees = oldCallees.foldl(\n      (nodes, node) -> nodes.set(node),\n      newCallees.nodes,\n    );\n    CallGraphFile(this.callgraph.set(caller, callees.toArray()))\n  }\n\n  fun each(fn: (CGNode, Array<CGNode>) -> void): void {\n    this.callgraph.each(fn)\n  }\n}\n\nconst kCallGraphId: String = \"/skjs/call-graph/\";\n\nconst callGraphDirName: SKStore.DirName = SKStore.DirName::create(\n  \"/call-graph/\",\n);\nconst depGraphDirName: SKStore.DirName = SKStore.DirName::create(\n  \"/dependency-graph/\",\n);\n\nclass CallGraph private (\n  callgraph: SKStore.EHandle<CGNode, CGNode>,\n  depgraph: SKStore.EHandle<CGNode, CGNode>,\n) {\n  static fun build(\n    context: mutable SKStore.Context,\n    checked: SKStore.EHandle<SKStore.SID, CheckResult>,\n  ): this {\n    callgraph = checked.map(\n      CGNode::keyType,\n      CGNode::type,\n      context,\n      callGraphDirName,\n      (_context, writer, _sid, res) ~> {\n        res.first.callgraph.each(cg -> cg.each((k, v) -> writer.setArray(k, v)))\n      },\n    );\n    depgraph = callgraph.map(\n      CGNode::keyType,\n      CGNode::type,\n      context,\n      depGraphDirName,\n      (_context, writer, caller, callees) ~> {\n        for (callee in callees) {\n          writer.append(callee, caller)\n        }\n      },\n    );\n    static(callgraph, depgraph)\n  }\n\n  static fun create(context: readonly SKStore.Context): ?this {\n    context.unsafeMaybeGetEagerDir(callGraphDirName).map(_ ->\n      static(\n        SKStore.EHandle(CGNode::keyType, CGNode::type, callGraphDirName),\n        SKStore.EHandle(CGNode::keyType, CGNode::type, depGraphDirName),\n      )\n    )\n  }\n\n  private fun transitiveClosure(\n    context: mutable SKStore.Context,\n    roots: Sequence<CGNode>,\n  ): Set<CGNode> {\n    frontier: mutable Vector<CGNode> = Vector::mcreateFromItems(roots);\n    closure: mutable Set<CGNode> = Set::mcreateFromItems(roots);\n    while (frontier.size() > 0) {\n      curr = frontier.pop();\n      for (succ in this.depgraph.getIter(context, curr)) {\n        if (!closure.contains(succ)) {\n          closure.insert(succ);\n          frontier.push(succ);\n        }\n      }\n    };\n    closure.chill()\n  }\n\n  fun affectedFiles(\n    context: mutable SKStore.Context,\n    changedDefs: Array<Def>,\n    debug: Bool = false,\n  ): SortedSet<String> {\n    affectedCGNodes: mutable Set<CGNode> = mutable Set[];\n    affectedClasses: mutable Set<(String, String)> = mutable Set[]; // (className, fileName) pairs\n    for (def in changedDefs) {\n      checkDef(def, affectedCGNodes, affectedClasses)\n    };\n    for (item in this.depgraph.items(context)) {\n      node = item.i0;\n      node.id match {\n      | Method(_, class_, fileName, _)\n      | Constructor(class_, fileName) ->\n        classIdent = (class_.value, fileName);\n        if (affectedClasses.contains(classIdent)) {\n          affectedCGNodes.insert(node)\n        }\n      | ObjectMethod _\n      | TopLevelFunDef _\n      | Toplevel _\n      | ArrowTypeAnnot _\n      | AnonymousLambda _\n      | AnonymousFunDef _ ->\n        void\n      }\n    };\n    closure = this.transitiveClosure(context, affectedCGNodes.chill());\n\n    if (debug) {\n      print_error(\"[debug] Directly-affected CG nodes:\");\n      for (node in affectedCGNodes) {\n        print_error(\"[debug]   \" + node.toString())\n      };\n      print_error(\"[debug] Transitively-affected CG nodes:\");\n      for (node in closure) {\n        print_error(\"[debug]   \" + node.toString())\n      }\n    };\n\n    closure\n      .iterator()\n      .foldl(\n        (affectedFiles, cgNode) -> {\n          affectedFiles.set(cgNode.id.getFileName())\n        },\n        SortedSet<String>[],\n      )\n  }\n}\n\nfun recordCalls(\n  context: mutable SKStore.Context,\n  caller: CGNode,\n  newCallees: CGNodes,\n): void {\n  context.getGlobal(kCallGraphId).map(CallGraphFile::type) match {\n  | Some(callgraph) ->\n    context.setGlobal(kCallGraphId, callgraph.recordCalls(caller, newCallees))\n  | _ -> void\n  }\n}\n\nfun initCallGraph(context: mutable SKStore.Context): void {\n  context.setGlobal(kCallGraphId, CallGraphFile())\n}\n\nfun collectCallGraph(context: mutable SKStore.Context): ?CallGraphFile {\n  inheritance = context.getGlobal(kCallGraphId).map(CallGraphFile::type);\n  context.removeGlobal(kCallGraphId);\n  inheritance\n}\n\n// lifted helper outside of `affectedFiles` for recursion\nprivate fun checkDef(\n  def: Def,\n  nodes: mutable Set<CGNode>,\n  classes: mutable Set<(String, String)>,\n): void {\n  def.value match {\n  // Unsupported syntactic forms\n  | ExportImport _\n  | Global _\n  | ExportAs _\n  | ExportEq _\n  | Module _\n  | Namespace _\n  | ExportDefault _\n  | Enum _ ->\n    notSupported(def.pos)\n  // Syntactic forms which can't be called\n  | ImportExpr _\n  | TypeDef _\n  | ExportNames _\n  | Import _\n  | VarDefs _ ->\n    void\n  | Declare(d) -> checkDef(d, nodes, classes)\n  | Export(_, _, d) -> checkDef(Def(def.pos, d), nodes, classes)\n  | ToplevelExpr(_) -> nodes.insert(CGNode::toplevel(def.pos.fileName))\n  | fd @ FunDef _ ->\n    cgNode = fd.name match {\n    | Some(name) -> CGNode::create(TopLevelFunDef(name, fd.pos.fileName))\n    | None() -> CGNode::create(AnonymousFunDef(fd))\n    };\n    nodes.insert(cgNode)\n  | c @ Class _ -> classes.insert((c.name.value, def.pos.fileName))\n  }\n}\n\nmodule end;\n"}, {"path": "src/SKStoreUtils.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nconst initDirName: SKStore.DirName = SKStore.DirName::create(\"/init/\");\n\nfun getInitDir(\n  context: mutable SKStore.Context,\n): SKStore.EHandle<SKStore.UnitID, SKStore.VoidFile> {\n  createOrReuseEagerDir(\n    context,\n    SKStore.UnitID::keyType,\n    SKStore.VoidFile::type,\n    initDirName,\n    Array[(SKStore.UnitID::singleton, SKStore.VoidFile())],\n  )\n}\n\nfun createOrReuseEagerDir<K: SKStore.Key, V: SKStore.File>(\n  context: mutable SKStore.Context,\n  keyType: SKStore.Key ~> K,\n  fileType: SKStore.File ~> V,\n  dirName: SKStore.DirName,\n  init: Array<(K, V)> = Array[],\n): SKStore.EHandle<K, V> {\n  context.unsafeMaybeGetEagerDir(dirName) match {\n  | Some(_dir) -> SKStore.EHandle(keyType, fileType, dirName)\n  | None() -> context.mkdir(keyType, fileType, dirName, init)\n  }\n}\n\nfun applyOrReuseMap<\n  K: SKStore.Key,\n  V: SKStore.File,\n  K2: SKStore.Key,\n  V2: SKStore.File,\n>(\n  dir: SKStore.EHandle<K, V>,\n  keyType: SKStore.Key ~> K2,\n  type: SKStore.File ~> V2,\n  context: mutable SKStore.Context,\n  dirName: SKStore.DirName,\n  f: (\n    mutable SKStore.Context,\n    mutable SKStore.TWriter<K2, V2>,\n    K,\n    mutable SKStore.NonEmptyIterator<V>,\n  ) ~> void,\n): SKStore.EHandle<K2, V2> {\n  context.unsafeMaybeGetEagerDir(dirName) match {\n  | None() -> dir.map(keyType, type, context, dirName, f)\n  | Some _ -> SKStore.EHandle(keyType, type, dirName)\n  }\n}\n\nmodule end;\n\nmodule SKStore;\n\n@cpp_noinline\nfun runWithGcReturnContext(\n  initCtx: Context,\n  f: mutable Context ~> ContextOp,\n  synchronizer: ?Synchronizer = None(),\n  sync: Bool = false,\n  fork: ?String = None(),\n): mutable Context {\n  contexts = runWithGcIntern(\n    initCtx,\n    icontext ~> {\n      context = icontext.mclone();\n      cop = f(context);\n      (context.clone(), cop);\n    },\n    synchronizer,\n    sync,\n    fork,\n  );\n  contexts[fork].mclone()\n}\n\nmodule end;\n"}, {"path": "src/SymbolsMap.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// Module resolving Symbols.\n/***************************************************************************/\n\nmodule SKJS;\n\n/***************************************************************************/\n/* Symbols directory. */\n/***************************************************************************/\n\nclass SymbolsFile(symbols: Map<SymbolicPos, Int>) extends SKStore.File\n\nfun makeSymbolsDir(\n  context: mutable SKStore.Context,\n  parsedFiles: SKStore.EHandle<SKStore.SID, ParsedResultAndSymbolsFile>,\n): SKStore.EHandle<SKStore.SID, SymbolsFile> {\n  parsedFiles.map(\n    SKStore.SID::keyType,\n    SymbolsFile::type,\n    context,\n    SKStore.DirName::create(\"/skjs/symbols/\"),\n    (_context, writer, key, values) ~> {\n      writer.set(key, SymbolsFile(values.first.symbols))\n    },\n  )\n}\n\n/***************************************************************************/\n/* Symbols map (associates Symbols to a filename) */\n/***************************************************************************/\n\nclass SymbolsMap{dir: SKStore.EHandle<SKStore.SID, SymbolsFile>} {\n  static fun create(\n    context: mutable SKStore.Context,\n    parsedFiles: SKStore.EHandle<SKStore.SID, ParsedResultAndSymbolsFile>,\n  ): this {\n    static{dir => makeSymbolsDir(context, parsedFiles)}\n  }\n  fun get(\n    context: mutable SKStore.Context,\n    fileName: String,\n  ): Map<SymbolicPos, Int> {\n    this.dir.get(context, SKStore.SID(fileName)).symbols\n  }\n}\n\nmodule end;\n"}, {"path": "src/TEnv.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// The typing environment.\n//\n// The typing environment retrieves the abstract syntax tree\n// corresponding to a type definition and turns it into a type.\n/***************************************************************************/\n\nmodule SKJS;\n\nconst cstrName: String = \"constructor\";\nvalue class CstrType(cstr: ?TType)\n\nclass TEnv{\n  // The defMap associates an AST to a type name.\n  private defMap: IDefMap,\n\n  // The type-parameters that are currently in scope. So if we see a\n  // type definition with a matching name, we know we are dealing with\n  // a universally quantified type variable.\n  tparams: SortedMap<String, TParamWithConstraint> = SortedMap[],\n\n  // The type substitution, which is different than the one used for\n  // existentials during inference. This one is used to instantiate a type\n  // with parameters with type arguments. So when you write new\n  // mytype<number>, it's this substitution that will take care of replacing\n  // the instances of type-parameter in the definition of mytype. However,\n  // if you introduce an existential (like you would with a parametric new\n  // construct without explicit type arguments), a different substitution is\n  // used (cf TVar).\n  subst: SortedMap<String, (Bool, TType)> = SortedMap[],\n\n  // When expanding a type definition, we don't want to recursively\n  // get all the type instances of a type, we only want to go one\n  // level deep. Concretely, consider the following type:\n  //\n  // type foo = { field1: null | foo, field2: number };\n  //\n  // When we expand foo, we want to get:\n  //   { field1: null | foo, field2: number };\n  //\n  // We don't want the instance of foo to be expanded (because that\n  // could be infinite). Instead, the second instance of foo will only\n  // be expanded if that turns out to be necessary for the inference.\n  // The field \"seenInstantiate\" enforces the fact that we only expand one\n  // level deep by keeping track of the types that we are in the\n  // process of expanding.\n  seenInstantiate: SortedSet<String> = SortedSet[],\n\n  // This field keeps track of type names that, if used, would define\n  // a cyclic type definition.\n  forbiddenInsts: SortedSet<String> = SortedSet[],\n\n  // This field keeps track of the intersections that we are in the\n  // process of computing. If a cycle occurs, the type TInter(t1, t2)\n  // will be returned.\n  seenInter: SortedSet<(TType, TType)> = SortedSet[],\n\n  // This field keeps track of the unions that we are in the\n  // process of computing. If a cycle occurs, the type TUnion(t1, t2)\n  // will be returned.\n  seenUnion: SortedSet<(TType, TType)> = SortedSet[],\n\n  // This field keeps track of the subtyping relations that we are in\n  // the process of checking. If a cycle occurs, the subtyping\n  // relation is considered correct (by co-induction).\n  seenSub: SortedSet<(Int, TType, TType)> = SortedSet[],\n} {\n  // Given a type name and type arguments, first retrieves the type\n  // definition (using the defMap) and then produces a type where the\n  // type parameters have been replaced with the corresponding type\n  // arguments (as expected).\n  fun instantiate(subst: mutable Subst, name: Name, targs: TArgs): TType {\n    // We are dealing with a recursive instance, if we keep on\n    // unfolding, we will end up in an infinite loop. Instead, we\n    // produce a type that can be later lazily unfolded if need be.\n    if (this.seenInstantiate.contains(name.value)) {\n      return TType::inst(name, targs);\n    };\n    !this.seenInstantiate = this.seenInstantiate.set(name.value);\n\n    tdef = this.defMap.getType(subst.context, name);\n    clauses = tdef match {\n    | TDType(ta) -> ta.tdefParams\n    | TDClass(ca) -> ca.tparams\n    };\n    if (targs.targs.size() > clauses.size()) {\n      typingError(\n        Array[\n          (\n            name.pos,\n            `Too many type parameters: given ${targs.targs.size()}, expected ${clauses.size()}`,\n          ),\n        ],\n      )\n    };\n\n    for (i => tparam in clauses) {\n      targ = if (i < targs.targs.size()) targs.targs[i] else {\n        tparam.default match {\n        | Some(default) -> this.normalize(subst.context, default)\n        | None() ->\n          typingError(\n            Array[\n              (\n                name.pos,\n                `Not enough type parameters: given ${targs.targs.size()}, expected ${clauses.size()}`,\n              ),\n            ],\n          )\n        }\n      };\n      tparam.constraint match {\n      | None() -> void\n      | Some(cstr) ->\n        cstrTy = this.normalize(subst.context, cstr);\n        isSubTType(subst, this, targ, cstrTy) match {\n        | STOk() -> void\n        | STError _ ->\n          typingError(\n            Array[\n              (name.pos, \"Constraint not satisfied\"),\n              (targ.pos, `This is of type: ${targ}`),\n              (cstr.pos, `It does not implement: ${cstrTy}`),\n            ],\n          )\n        }\n      };\n      !this.subst[tparam.name.value] = (true, targ);\n    };\n\n    tdef match {\n    | TDType(ta) -> this.normalize(subst.context, ta.body)\n    | TDClass(_) -> this.new(subst.context, name, targs.targs)\n    }\n  }\n\n  fun getClass(context: mutable SKStore.Context, className: Name): Class {\n    tdef = this.defMap.getType(context, className);\n    tdef match {\n    | TDType(_) -> typingError(Array[(className.pos, \"Expected a class name\")])\n    | TDClass(ca) -> ca\n    };\n  }\n\n  fun makeTArgs(\n    context: mutable SKStore.Context,\n    subst: mutable Subst,\n    className: Name,\n  ): Array<TType> {\n    this.getClass(context, className).tparams.map(tparam -> {\n      tvar = subst.gen(className.pos);\n      ty = TType::var(tvar);\n      tparam.constraint match {\n      | None() -> ty\n      | Some(cstr) ->\n        TType::union(subst, this, this.normalize(context, cstr), ty)\n      }\n    })\n  }\n\n  fun new(\n    context: mutable SKStore.Context,\n    className: Name,\n    targs: Array<TType>,\n    filter: FieldType ~> Bool = _ ~> true,\n  ): TType {\n    obj = this.newObject(context, className, targs, filter);\n    TType::single(obj)\n  }\n\n  fun newConstructor(\n    context: mutable SKStore.Context,\n    className: Name,\n    targs: Array<TType>,\n  ): CstrType {\n    c = this.getClass(context, className);\n    if (c.tparams.size() != targs.size()) {\n      typingError(\n        Array[(className.pos, `Expected ${c.tparams.size()} parameters`)],\n      )\n    };\n    visitedClasses = SortedSet[];\n    CstrType(\n      this.findConstructor(\n        context,\n        visitedClasses,\n        className,\n        c.tparams,\n        targs,\n      ),\n    )\n  }\n\n  fun newObject(\n    context: mutable SKStore.Context,\n    className: Name,\n    targs: Array<TType>,\n    filter: FieldType ~> Bool = _ ~> true,\n  ): TObject {\n    c = this.getClass(context, className);\n    if (c.tparams.size() != targs.size()) {\n      typingError(\n        Array[(className.pos, `Expected ${c.tparams.size()} parameters`)],\n      )\n    };\n    visitedClasses = SortedSet[];\n    fields = mutable Map[];\n    indexes = mutable Vector[];\n    thisType = TType::inst(className, TArgs(targs));\n    !this.subst[\"this\"] = (false, thisType);\n    this.addFields(\n      context,\n      fields,\n      indexes,\n      visitedClasses,\n      None(),\n      className,\n      targs,\n      fieldType ~> {\n        filter(fieldType) && !fieldType.isStatic()\n      },\n    );\n    TObject(\n      TFields::create(fields.values().collect(Array), indexes.toArray()),\n      className.pos,\n    )\n  }\n\n  fun newStatic(context: mutable SKStore.Context, className: Name): TType {\n    obj = this.newStaticObject(context, className);\n    TType::single(obj)\n  }\n\n  private fun newStaticObject(\n    context: mutable SKStore.Context,\n    className: Name,\n  ): TObject {\n    c = this.getClass(context, className);\n    targs = Array[];\n    visitedClasses = SortedSet[];\n    fields = mutable Map[];\n    indexes = mutable Vector[];\n    this.addFields(\n      context,\n      fields,\n      indexes,\n      visitedClasses,\n      Some(c.tparams),\n      className,\n      targs,\n      fieldType ~> fieldType.isStatic(),\n    );\n    pos = className.pos;\n    if (!fields.containsKey(cstrName)) {\n      fields![cstrName] = this.makeEmptyConstructor(context, pos, className, c);\n    };\n    TObject(\n      TFields::create(fields.values().collect(Array), indexes.toArray()),\n      pos,\n    )\n  }\n\n  private fun makeEmptyConstructor(\n    context: mutable SKStore.Context,\n    pos: PosRange,\n    className: Name,\n    c: Class,\n  ): TField {\n    cgNode = CGNode::create(\n      Method(\n        Some(FNNormal(Name(pos, cstrName))),\n        className,\n        c.name.pos.fileName,\n        true,\n      ),\n    );\n    targs = c.tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[])));\n    retType = Type(pos, TAInst(className, targs));\n    ftype = Type(pos, TAFun(true, c.tparams, Array[], retType, cgNode));\n    TField::create(\n      pos,\n      \"constructor\",\n      false,\n      this.normalize(context, ftype),\n    ).fromSome()\n  }\n\n  // TParamWithConstraint corresponding to syntactic TypeParam\n  private fun makeTParam(\n    context: mutable SKStore.Context,\n    tparam: TypeParam,\n  ): TParamWithConstraint {\n    cstr = tparam.constraint.map(cstr -> this.normalize(context, cstr));\n    TParamWithConstraint(\n      tparam.name.value,\n      tparam.name.pos.fileName,\n      tparam.id,\n      cstr,\n    )\n  }\n\n  fun addTParams(subst: mutable Subst, clauses: Array<TypeParam>): this {\n    for (tparam in clauses) {\n      ty = TType::fromTParamWithConstraint(\n        subst,\n        this,\n        tparam.name.pos,\n        this.makeTParam(subst.context, tparam),\n      );\n      !this.subst[tparam.name.value] = (false, ty)\n    };\n    this\n  }\n\n  private fun processClassSetup(\n    context: mutable SKStore.Context,\n    visitedClasses: SortedSet<String>,\n    withTParams: Bool,\n    className: Name,\n    targs: Array<TType>,\n  ): (this, Class) {\n    if (visitedClasses.contains(className.value)) {\n      typingError(Array[(className.pos, \"Cyclic class definition\")]);\n    };\n    !visitedClasses = visitedClasses.set(className.value);\n    defs = this.defMap.get(\n      context,\n      FileName::create(className.pos.fileName),\n      className,\n    );\n    cls = for (def in defs) {\n      def.value match {\n      | cls @ Class _ -> break cls\n      | _ -> void\n      }\n    } else {\n      typingError(Array[(className.pos, \"Unbound class\")])\n    };\n    if (targs.size() != 0 && targs.size() != cls.tparams.size()) {\n      typingError(\n        Array[\n          (className.pos, \"Invalid number of type arguments\"),\n          (cls.name.pos, \"Class declaration is here\"),\n        ],\n      )\n    };\n    if (withTParams) {\n      for (i => tparam in cls.tparams) {\n        !this.subst[tparam.name.value] = (false, targs[i])\n      };\n    };\n    (this, cls)\n  }\n\n  private fun addFields(\n    context: mutable SKStore.Context,\n    acc: mutable Map<String, TField>,\n    indexes: mutable Vector<TIndexField>,\n    visitedClasses: SortedSet<String>,\n    isStatic: ?Array<TypeParam>,\n    className: Name,\n    targs: Array<TType>,\n    filter: FieldType ~> Bool,\n  ): void {\n    (!this, cls) = this.processClassSetup(\n      context,\n      visitedClasses,\n      isStatic is None(),\n      className,\n      targs,\n    );\n    for (extend in cls.extends_) {\n      extend.value match {\n      | TAInst(parentName, paramTArgs) ->\n        this.addFields(\n          context,\n          acc,\n          indexes,\n          visitedClasses,\n          isStatic,\n          parentName,\n          if (isStatic is Some _) Array[] else {\n            paramTArgs.map(targ -> this.normalize(context, targ))\n          },\n          filter,\n        )\n      | _ -> typingError(Array[(extend.pos, \"Unexpected extend\")])\n      }\n    };\n    for (fieldType in cls.fields) {\n      fieldType match {\n      | field @ FieldTypeValue _ ->\n        if (!filter(fieldType)) continue;\n        field.setGet match {\n        | None() -> void\n        | Some(FieldGetSet(_, pos)) -> notSupported(pos)\n        };\n        for (modifier in field.modifiers.modifiers) {\n          modifier match {\n          | ModStatic(pos) ->\n            typingError(Array[(pos, \"static fields are forbidden\")])\n          | ModPublic _ -> void /* public is the default */\n          | ModPrivate _\n          | ModProtected _\n          | ModReadonly _ ->\n            /* TODO: intentionally ignore accessibility modifiers since TypeScript do check them */ void\n          | mod ->\n            typingError(\n              Array[\n                (\n                  modifier.pos,\n                  `TODO: field modifier '${mod}' (TEnv#addFields)`,\n                ),\n              ],\n            )\n          }\n        };\n        field.name match {\n        | FNNormal(fdName) ->\n          fieldName = fdName.value;\n          type = this.normalize(context, field.type);\n          TField::create(\n            field.pos,\n            fieldName,\n            field.optional is Some _,\n            type,\n          ) match {\n          | None() ->\n            typingError(\n              Array[\n                (field.pos, `Forbidden field name '${fieldName}' in a class`),\n              ],\n            )\n          | Some(f) -> acc![fieldName] = f\n          }\n        | FNColon(indexName, indexType) ->\n          keyType = this.normalize(context, indexType);\n          valueType = this.normalize(context, field.type);\n          indexes.push(\n            TIndexField(indexName.pos, indexName.value, keyType, valueType),\n          )\n        | _ -> typingError(Array[(field.pos, \"Unsupported field name\")])\n        }\n      | fd @ FunDef _ ->\n        isConstructor = fd.name match {\n        | Some(FNNormal(name @ Name(_, \"constructor\"))) -> Some(name)\n        | _ -> None()\n        };\n        metIsStatic = isConstructor.isSome() || fd.isStatic();\n        if (metIsStatic != isStatic.isSome()) continue;\n        (metName, metType) = isConstructor match {\n        | Some(name) ->\n          (\n            name,\n            this.makeConstructor(context, className, isStatic.fromSome(), fd),\n          )\n        | None() ->\n          cgNode = CGNode::create(\n            Method(fd.name, className, fd.pos.fileName, metIsStatic),\n          );\n          this.funDecl(context, true, fd, cgNode)\n        };\n        TField::create(fd.pos, metName.value, false, metType) match {\n        | None() ->\n          typingError(Array[(fd.pos, `Forbidden method name '${metName}'`)])\n        | Some(field) -> acc![metName.value] = field\n        }\n      }\n    }\n  }\n\n  private fun findConstructor(\n    context: mutable SKStore.Context,\n    visitedClasses: SortedSet<String>,\n    className: Name,\n    tparams: Array<TypeParam>,\n    targs: Array<TType>,\n  ): ?TType {\n    this.findConstructorMethod(\n      context,\n      visitedClasses,\n      className,\n      tparams,\n      targs,\n    ) match {\n    | None() -> None()\n    | Some(fd) -> Some(this.makeConstructor(context, className, tparams, fd))\n    }\n  }\n\n  private fun findConstructorMethod(\n    context: mutable SKStore.Context,\n    visitedClasses: SortedSet<String>,\n    className: Name,\n    tparams: Array<TypeParam>,\n    targs: Array<TType>,\n  ): ?FunDef {\n    (!this, cls) = this.processClassSetup(\n      context,\n      visitedClasses,\n      true,\n      className,\n      targs,\n    );\n    for (fieldType in cls.fields) {\n      fieldType match {\n      | fd @ FunDef _ if (fd.name is Some(FNNormal(Name(_, \"constructor\")))) ->\n        return Some(fd)\n      | _ -> void\n      }\n    };\n    for (extend in cls.extends_) {\n      extend.value match {\n      | TAInst(parentName, paramTArgs) ->\n        return this.findConstructorMethod(\n          context,\n          visitedClasses,\n          parentName,\n          tparams,\n          paramTArgs.map(targ -> this.normalize(context, targ)),\n        )\n      | _ -> typingError(Array[(extend.pos, \"Unexpected extend\")])\n      }\n    };\n    None()\n  }\n\n  // Normalizes constructor signatures by making type parameters and\n  // return types explicit.  For example, in a generic class A<T> {\n  // constructor() {} }, the constructor is transformed into:\n  // constructor<T>(...): A<T> This ensures constructors reflect their\n  // class's type parameters and return type.\n\n  fun makeConstructor(\n    context: mutable SKStore.Context,\n    className: Name,\n    tparams: Array<TypeParam>,\n    fd: FunDef,\n  ): TType {\n    cgNode = CGNode::create(Method(fd.name, className, fd.pos.fileName, true));\n    !tparams = tparams.map(x -> {\n      // We give the tparams a different name to make sure they are\n      // not confused with the type parameters of the class\n      !x.id = x.id.prefixWith(\"$\");\n      x\n    });\n    params = fd.params.map(this.convertParam);\n    retType = fd.retType match {\n    | (pos, None()) -> // constructor\n      Type(\n        pos,\n        TAInst(\n          Name(pos, className.value),\n          tparams.map(x -> Type(x.name.pos, TAInst(x.name, Array[]))),\n        ),\n      )\n    | (_, Some(x)) ->\n      typingError(Array[(x.pos, \"Unexpected annotation for constructor\")])\n    };\n    this.normalize(\n      context,\n      Type(fd.pos, TAFun(true, tparams, params, retType, cgNode)),\n    );\n  }\n\n  private fun convertParam(param: Param): TAFunParam {\n    (paramName, ty) = param.name match {\n    | PNName(n) ->\n      param.type match {\n      | None() -> typingError(Array[(n.pos, \"Missing type annotation\")])\n      | Some(ty) -> (TAParamName(n), ty)\n      }\n    | PNDDD(n) ->\n      param.type match {\n      | None() -> typingError(Array[(n.pos, \"Missing type annotation\")])\n      | Some(x) -> (TAParamSpread(n), x)\n      }\n    | _ ->\n      typingError(\n        Array[(param.pos, \"TODO: support for param pattern in typeDecl\")],\n      )\n    };\n    param.optional match {\n    | None() -> void\n    | Some(optionalPos) ->\n      !ty = Type(\n        param.pos,\n        TAUnion(\n          ty,\n          Type(optionalPos, TAInst(Name(optionalPos, \"undefined\"), Array[])),\n        ),\n      )\n    };\n    optional = param.default match {\n    | None() -> param.optional\n    | Some(defaultExpr) -> Some(defaultExpr.pos)\n    };\n    TAFunParam(Some(paramName), optional, ty)\n  }\n\n  fun funDecl(\n    context: mutable SKStore.Context,\n    isMethod: Bool,\n    fd: FunDef,\n    cgNode: CGNode,\n  ): (Name, TType) {\n    name = fd.name match {\n    | Some(FNNormal(name)) ->\n      if (name.value == \"constructor\") {\n        what = if (isMethod) \"method\" else \"function\";\n        typingError(Array[(name.pos, `Forbidden ${what} name: ${name}`)])\n      };\n      name\n    | None() -> notSupported(fd.pos, \"anonymous function\")\n    | _ -> notSupported(fd.pos, \"non-normal function name\")\n    };\n    retType = fd.retType match {\n    | (pos, None()) ->\n      // constructors must use makeConstructor\n      typingError(Array[(pos, \"Missing return type annotation\")])\n    | (_, Some(x)) -> x\n    };\n    fty = this.normalize(\n      context,\n      Type(\n        fd.pos,\n        TAFun(\n          isMethod,\n          fd.tparams,\n          fd.params.map(this.convertParam),\n          retType,\n          cgNode,\n        ),\n      ),\n    );\n    (name, fty)\n  }\n\n  fun normalize(context: mutable SKStore.Context, typeAst: Type): TType {\n    subst = Subst::mcreate{context};\n    pos = typeAst.pos;\n    typeAst.value match {\n    | TABigIntLiteral(x) -> TType::single(TPrimValue::single(TBigInt(), x, pos))\n    | TAAssertIs _ -> internal_error(\"TODO assertIs \")\n    | TAAbstract _ -> internal_error(\"TODO abstract \")\n    | TAUniqueSymbol() -> internal_error(\"TODO uniqueSymbol \")\n    | TAAsserts _ -> internal_error(\"TODO asserts \")\n    | TAIs _ -> internal_error(\"TODO is \")\n    | TAKeyOf(ty) ->\n      targetType = this.normalize(context, ty);\n      this.keyOfType(subst, targetType, pos)\n    | TANew(Type(tyPos, TAFun(_, clauses, params, retType, cgNode))) ->\n      tfun = this.normalize(\n        context,\n        Type(tyPos, TAFun(true, clauses, params, retType, cgNode)),\n      );\n      TType::single(\n        TObject(\n          TFields::create(\n            Array[TField::create(pos, cstrName, false, tfun).fromSome()],\n            Array[],\n          ),\n          pos,\n        ),\n      )\n    | TANew _ -> typingError(Array[(pos, \"Invalid new\")])\n    | TAEmptyArray _ -> internal_error(\"TODO emptyArray \")\n    | TAInfer _ -> internal_error(\"TODO infer \")\n    | TATemplate _ -> internal_error(\"TODO template \")\n    | TAImport _ -> internal_error(\"TODO import \")\n    | TAReadonly _ -> internal_error(\"TODO readonly \")\n    | TAExtends _ -> internal_error(\"TODO extends \")\n    | TAExtendsQuestion _ -> internal_error(\"TODO extendsQuestion \")\n    | TAStringLiteral(x) -> TType::single(TPrimValue::single(TString(), x, pos))\n    | TANumLiteral(x) -> TType::single(TPrimValue::single(TNum(), x, pos))\n    | TATypeOf(ty) ->\n      ty.value match {\n      | TAInst(Name(_, \"undefined\"), targs) ->\n        if (targs.size() != 0) {\n          typingError(Array[(pos, \"Unexpected type parameters for undefined\")])\n        };\n        TType::single(TPrimUnit(TUndefined(), pos))\n      | TAInst(className, targs) ->\n        c = this.getClass(context, className);\n        this.findConstructorMethod(\n          context,\n          SortedSet[],\n          className,\n          c.tparams,\n          targs.map(x -> this.normalize(context, x)),\n        ) match {\n        | None() ->\n          TType::single(\n            TObject(\n              TFields::create(\n                Array[this.makeEmptyConstructor(context, pos, className, c)],\n                Array[],\n              ),\n              pos,\n            ),\n          )\n        | Some(fd) ->\n          tfun = this.makeConstructor(context, className, c.tparams, fd);\n          TType::single(\n            TObject(\n              TFields::create(\n                Array[TField::create(pos, cstrName, false, tfun).fromSome()],\n                Array[],\n              ),\n              pos,\n            ),\n          )\n        }\n      | _ -> typingError(Array[(ty.pos, \"Invalid typeof\")])\n      }\n    | TAPrim(kind) ->\n      TType::single(\n        kind match {\n        | TPKNull() -> TPrimUnit(TNull(), pos)\n        | TPKBool() -> TPrimValue::boolean(pos)\n        | TPKNum() -> TPrimValue::number(pos)\n        | TPKString() -> TPrimValue::string(pos)\n        | TPKBigInt() -> TPrimValue::bigint(pos)\n        },\n      )\n    | TAObject(fields) ->\n      (algebraicBranchField, tFields) = this.createTFields(context, fields);\n      createObject(pos, algebraicBranchField, tFields)\n    | TAInst(Name(p, \"object\"), targs) ->\n      if (targs.size() != 0) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::single(TObject(TFields::empty(), pos))\n\n    | TAArray(ty) ->\n      TType::inst(Name(pos, \"Array\"), TArgs(Array[this.normalize(context, ty)]))\n\n    | TAInst(Name(p, \"void\"), targs) ->\n      if (targs.size() != 0) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::single(TPrimUnit(TVoid(), pos))\n    | TAInst(Name(p, \"undefined\"), targs) ->\n      if (targs.size() != 0) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::single(TPrimUnit(TUndefined(), pos))\n    | TAInst(Name(p, \"Promise\"), targs) ->\n      if (targs.size() != 1) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::single(TPromise(this.normalize(context, targs[0]), pos))\n    | TAInst(Name(p, \"unknown\"), targs) ->\n      if (targs.size() != 0) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::top(pos)\n    | TAInst(Name(p, \"never\"), targs) ->\n      if (targs.size() != 0) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::bottom(pos)\n    | TAInst(Name(p, x @ \"true\"), targs)\n    | TAInst(Name(p, x @ \"false\"), targs) ->\n      if (targs.size() != 0) {\n        typingError(Array[(p, \"Invalid number of type arguments\")])\n      };\n      TType::single(TPrimValue::single(TBool(), x, pos))\n    | TAInst(n, targs) ->\n      if (this.tparams.containsKey(n.value)) {\n        if (targs.size() != 0) {\n          typingError(\n            Array[\n              (\n                n.pos,\n                \"A bound occurrence of a type parameter cannot have type arguments\",\n              ),\n            ],\n          )\n        };\n        tparam = this.tparams[n.value];\n        TType::fromTParamWithConstraint(subst, this, pos, tparam)\n      } else if (this.subst.containsKey(n.value)) {\n        if (targs.size() != 0) {\n          typingError(\n            Array[\n              (\n                n.pos,\n                \"A bound occurrence of a type parameter cannot have type arguments\",\n              ),\n            ],\n          )\n        };\n        (keepPos, ty) = this.subst[n.value];\n        if (keepPos) ty else ty.withPos(pos)\n      } else if (this.forbiddenInsts.contains(n.value)) {\n        typingError(Array[(n.pos, \"Cyclic definition\")])\n      } else {\n        tdef = this.defMap.getType(context, n);\n        tparams = tdef match {\n        | TDType(ta) -> ta.tdefParams\n        | TDClass(ca) -> ca.tparams\n        };\n        if (\n          targs.size() > tparams.size() ||\n          (targs.size() < tparams.size() &&\n            tparams[targs.size()].default is None())\n        ) {\n          typingError(\n            Array[\n              (\n                n.pos,\n                `Invalid number of type arguments: given ${targs.size()}, expected ${tparams.size()}`,\n              ),\n            ],\n          )\n        };\n\n        if (this.seenInstantiate.contains(n.value)) {\n          !this.forbiddenInsts = this.forbiddenInsts.set(n.value)\n        };\n        TType::inst(n, TArgs(targs.map(x -> this.normalize(context, x))))\n      }\n    | TAUnion(ty1, ty2) ->\n      TType::union(\n        subst,\n        this,\n        this.normalize(context, ty1),\n        this.normalize(context, ty2),\n      ).withPos(pos)\n    | TAInter(ty1, ty2) ->\n      TType::inter(\n        subst,\n        this,\n        this.normalize(context, ty1),\n        this.normalize(context, ty2),\n      ).withPos(pos)\n    | TATuple(tupleElts) ->\n      typeVec = mutable Vector[];\n      for (ty in tupleElts) {\n        ty match {\n        | TEType(n, optional, x) ->\n          if (n is Some _) internal_error(\"TODO named tuple\");\n          if (optional is Some _) {\n            internal_error(\"TODO optional element tuple\")\n          };\n          typeVec.push(x)\n        | TESpread _ -> internal_error(\"TODO tuple spread\")\n        }\n      };\n      types = typeVec.toArray();\n      TType::single(TTuple(types.map(ty -> this.normalize(context, ty)), pos))\n    | TAFun(isMethod, clauses, params, retType, cgNode) ->\n      TypeChecker::checkTypeParams(clauses);\n      funClauses = mutable Vector[];\n      for (tparam in clauses) {\n        if (tparam.default is Some _) {\n          typingError(\n            Array[\n              (\n                tparam.name.pos,\n                \"Optional type parameters are not supported for functions\",\n              ),\n            ],\n          )\n        };\n        funTParam = this.makeTParam(context, tparam);\n        funClauses.push(funTParam);\n        !this.tparams[tparam.name.value] = funTParam;\n      };\n      normalParams = mutable Vector[];\n      optionalParams = mutable Vector[];\n      optionalWitness: ?PosRange = None();\n      spreadParam: ?TType = None();\n      for (i => param in params) {\n        paramType = this.normalize(context, param.type);\n        param.name match {\n        | Some(TAParamSpread(spreadName)) ->\n          if (i != params.size() - 1) {\n            typingError(\n              Array[(spreadName.pos, \"... must always be the last parameter\")],\n            );\n          };\n          !spreadParam = Some(paramType);\n          continue\n        | _ -> void\n        };\n        param.optional match {\n        | None() ->\n          optionalWitness match {\n          | None() -> normalParams.push(paramType)\n          | Some(wpos) ->\n            typingError(\n              Array[\n                (param.type.pos, \"This parameter is not optional\"),\n                (wpos, \"It appears after this parameter that is optional\"),\n              ],\n            )\n          }\n        | Some(wpos) ->\n          !optionalWitness = Some(wpos);\n          optionalParams.push(paramType)\n        }\n      };\n      tfun = TFun(\n        funClauses.toArray(),\n        normalParams.toArray(),\n        optionalParams.toArray(),\n        spreadParam,\n        pos,\n        this.normalize(context, retType),\n        CGNodes::singleton(cgNode),\n      );\n      tfuns = if (isMethod) {\n        TFuns::singleMethod(tfun, pos)\n      } else {\n        TFuns::singleFun(tfun, pos)\n      };\n      TType::single(tfuns)\n    | TAGet _ -> internal_error(\"TODO TAGet\")\n    }\n  }\n\n  /*\n    The first element is the position and the type of the algebraic branch field if it is present.\n   */\n  private fun createTFields(\n    context: mutable SKStore.Context,\n    fieldTypes: Array<FieldType>,\n  ): (?(PosRange, TType), TFields) {\n    algebraicBranchField: ?(PosRange, TType) = None();\n    indexes = mutable Vector[];\n    fields = fieldTypes.filterMap(elt -> {\n      elt match {\n      | fd @ FieldTypeValue _ ->\n        for (modifier in fd.modifiers.modifiers) {\n          typingError(\n            Array[\n              (\n                modifier.pos,\n                `'${modifier}' modifier cannot appear on a type member.`,\n              ),\n            ],\n          )\n        };\n        fd.name match {\n        | FNIn _ -> typingError(Array[(fd.pos, \"TODO fnIn\")])\n        | FNSymbol _ -> internal_error(\"TODO symbol\")\n        | FNNormal(name) ->\n          if (name.value == \"constructor\") {\n            typingError(Array[(name.pos, `Forbidden field name: ${name}`)])\n          };\n          normalizedType = this.normalize(context, fd.type);\n          optField = TField::create(\n            name.pos,\n            name.value,\n            fd.optional is Some _,\n            normalizedType,\n          );\n          if (optField is None()) {\n            algebraicBranchField match {\n            | Some((existingPos, _existingType)) ->\n              typingError(\n                Array[\n                  (name.pos, `Duplicate field ${name}`),\n                  (existingPos, \"Previously declared here\"),\n                ],\n              )\n            | None() -> void\n            };\n            fd.optional match {\n            | Some(optionalPos) ->\n              typingError(\n                Array[(optionalPos, `Field ${name} cannot be optional`)],\n              )\n            | None() -> void\n            };\n            !algebraicBranchField = Some((name.pos, normalizedType))\n          };\n          optField\n        | FNColon(indexName, indexType) ->\n          keyType = this.normalize(context, indexType);\n          valueType = this.normalize(context, fd.type);\n          indexes.push(\n            TIndexField(indexName.pos, indexName.value, keyType, valueType),\n          );\n          None()\n        }\n      | fd @ FunDef _ ->\n        cgNode = CGNode::create(AnonymousFunDef(fd));\n        (name, decl) = this.funDecl(context, true, fd, cgNode);\n        optField = TField::create(name.pos, name.value, false, decl);\n        if (optField is None()) {\n          typingError(Array[(name.pos, `Forbidden method name ${name}`)])\n        };\n        optField\n      }\n    });\n    tFields = TFields::create(fields, indexes.toArray());\n    (algebraicBranchField, tFields)\n  }\n\n  /* Over-approximates keyof targetType\n     Though keyof should be treated symbolically because it is a decreasing\n     function of types.\n     In particular, do not use keyof to check that a key is valid.\n\n     Try to keep in synch with TypeChecker#get in TypeCheckExpr\n  */\n  fun keyOfType(subst: mutable Subst, targetType: TType, pos: PosRange): TType {\n    this.keys(subst, targetType, pos, false)\n  }\n\n  /* Over-approximates the type of the iterated key in a loop\n      for (let key in x)  where x has type iterableType\n\n      It is basically the same as keyof iterableType without:\n      - non-enumerable properties (TODO? private members)\n      - number and symbols\n      And is allowed on arrays and objects only\n   */\n  fun forInKeys(\n    subst: mutable Subst,\n    iterableType: TType,\n    pos: PosRange,\n  ): TType {\n    keys = this.keys(subst, iterableType, pos, true);\n    TType::inter(subst, this, keys, TType::single(TPrimValue::string(pos)))\n  }\n\n  fun keys(subst: mutable Subst, ty: TType, pos: PosRange, forIn: Bool): TType {\n    clauses = ty.expand(subst, this, Covariant()).clauses;\n    if (\n      clauses.any(clause -> (!clause.vars.isEmpty() || clause.stypes is None()))\n    ) {\n      return TType::union(\n        subst,\n        this,\n        TType::single(TPrimValue(TString(), None(), pos)),\n        TType::single(TPrimValue(TNum(), None(), pos)),\n      )\n    };\n    result = TType::bottom(pos);\n    maxRange = -1;\n    strings = SortedSet[];\n    for (clause in clauses) {\n      invariant(clause.vars.isEmpty());\n      stypes = Vector::mcreateFromIterator(clause.stypes.fromSome().values());\n      while (!stypes.isEmpty()) {\n        stype = stypes.pop();\n        stype match {\n        | TTuple(tyArr, _) -> !maxRange = max(maxRange, tyArr.size())\n        | TObject(fields, _) ->\n          for (field in fields) {\n            if (forIn && field.type.isMethod(subst, this)) continue;\n            !strings = strings.set(field.name);\n          };\n          for (index in fields.indexes) {\n            // TODO: convert numbers to strings\n            !result = TType::union(subst, this, result, index.keyType);\n          }\n        | TAlgebraic(branches, _) ->\n          !strings = strings.set(kAlgebraicBranchFieldName);\n          for (branch in branches) {\n            for (field in branch.fields) {\n              if (forIn && field.type.isMethod(subst, this)) continue;\n              !strings = strings.set(field.name);\n            };\n            for (index in branch.fields.indexes) {\n              // TODO: convert numbers to strings\n              !result = TType::union(subst, this, result, index.keyType);\n            }\n          }\n        | _ if (forIn) ->\n          typingError(\n            Array[(pos, \"for-in loop requires an object or array type\")],\n          )\n        | prim @ TPrimValue _ ->\n          obj = this.newObject(subst.context, prim.asClassName(), Array[]);\n          stypes.push(obj)\n        | TPrimUnit _ -> void /* bottom */\n        | TPromise _\n        | TFuns _ ->\n          internal_error(`TODO: keyof ${prettyPrintSType(stype)}`)\n        }\n      }\n    };\n    numbers = SortedSet::createFromItems(\n      Range(0, maxRange).map(i -> i.toString()),\n    );\n    !strings = strings.union(numbers);\n    ArrayValues::ofSet(strings, pos) match {\n    | None() -> void\n    | strValues @ Some _ ->\n      literals = ArrayValues::ofSet(numbers, pos) match {\n      | None() -> TType::single(TPrimValue(TString(), strValues, pos))\n      | nbrValues @ Some _ ->\n        TType::union(\n          subst,\n          this,\n          TType::single(TPrimValue(TString(), strValues, pos)),\n          TType::single(TPrimValue(TNum(), nbrValues, pos)),\n        )\n      };\n      !result = TType::union(subst, this, result, literals)\n    };\n    result\n  }\n}\n\nmodule end;\n"}, {"path": "src/TType.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// This file defines all the operation on types used during the\n// type-checking phase.\n//\n// All the class involved start with \"T\" for type, or \"ST\" for single\n// type. A class that starts with \"T\" is just a type, a type that\n// starts with \"ST\" means that it represents a single type out of a\n// larger union.\n//\n// For example: the type number | undefined is represented by a class\n// TType that contains a union of SType where the STypes are \"number\"\n// and \"undefined\".\n/***************************************************************************/\n\nmodule SKJS;\n\n/***************************************************************************/\n// The class representing all the types.\n//\n// The class has 2 important parts:\n//\n//   - the clauses which represent both parameters and concrete single types\n//   (number, undefined, null, ...) under a disjunctive normal form\n//\n//   - the instances (which represent type variables, unexpanded type\n//   instances and unexpanded intersections).\n//\n// A few examples:\n//   number | void           ==> TType(clauses = void | number)\n//   Foo<number> | number    ==> TType(clauses = number, insts = Foo<number>)\n//   T2 extends A | T1       ==> TType(clauses = T1 | T2 extends A)\n//\n// Note that some operations will require a so-called \"expansion\", an\n// expansion consisting in getting rid of all the instances and turn\n// them into clauses. Note that the expansion is only one\n// level deep, so if a type is defined recursively, the expansion will\n// not affect the instances defined inside the type.\n//\n// Interpretation:\n// \u301a ttype \u301b = \u301a ttype.insts \u301b \u2a06 \u301a ttype.clauses \u301b\n//\n/***************************************************************************/\n\nclass TType private {\n  // The position in the source-code that serves as a witness, when an\n  // error occurs involving this type, we will use that position in\n  // the error message.\n  pos: PosRange,\n\n  // The hash, it's important because we need to quickly determine if\n  // two types are different. The hash is computed by smart constructors,\n  // that's why the constructor is private\n  private h: XXHash,\n\n  // The list of type instances which can be:\n  // - Type variables\n  // - Unexpanded type instances MyClass<number>\n  // - Unexpanded intersections TInter(t1, t2)\n  insts: TInsts,\n\n  // Single types and type parameters (universally quantified type variables), in a\n  // sorted disjunctive normal form. So if you write: T1 & (T3 | T2)\n  // that will be turned into T1 & T2 | T1 & T3.\n  clauses: Clauses,\n} uses XXHashable, Orderable {\n  // CONSTRUCTORS\n\n  // Returns the type that is sub-type of all types. This type is\n  // impossible to construct, meaning, a value of this type is always\n  // unreachable code. However, that type can still be useful to\n  // represent some values (like exceptions).\n  static fun bottom(pos: PosRange): this {\n    static::create(pos, TInsts::empty(), Clauses::empty())\n  }\n\n  // Returns the type that represents all possible values. Every other\n  // type is sub-type of top.\n  static fun top(pos: PosRange): this {\n    static::create(pos, TInsts::empty(), Clauses::top())\n  }\n\n  // A single atomic type.\n  static fun single(sType: SType): this {\n    static::fromSTypes(sType.pos, STypes::single(sType))\n  }\n\n  // Type variable.\n  static fun var(v: TVar): this {\n    static::create(v.pos, TInsts::single(v), Clauses::empty())\n  }\n\n  // Unexpanded instance of a named generic type.\n  static fun inst(name: Name, targs: TArgs): this {\n    x = TSInst(name, targs);\n    static::create(name.pos, TInsts::single(x), Clauses::empty())\n  }\n\n  static private fun fromSTypes(pos: PosRange, sTypes: STypes): this {\n    static::fromClauses(pos, Clauses::fromSTypes(sTypes))\n  }\n\n  static private fun fromTParam(pos: PosRange, tParam: TParam): this {\n    TType::fromClauses(pos, Clauses::single(tParam))\n  }\n\n  static fun fromTParamWithConstraint(\n    subst: mutable Subst,\n    tenv: TEnv,\n    pos: PosRange,\n    tparam: TParamWithConstraint,\n  ): this {\n    ty = TType::fromTParam(pos, tparam.withoutConstraint());\n    tparam.cstr match {\n    | None() -> ty\n    | Some(cstr) -> TType::inter(subst, tenv, ty, cstr)\n    }\n  }\n\n  static private fun fromClauses(pos: PosRange, clauses: Clauses): this {\n    static::create(pos, TInsts::empty(), clauses)\n  }\n\n  static private fun create(\n    pos: PosRange,\n    insts: TInsts,\n    clauses: Clauses,\n  ): this {\n    if (clauses.isTop()) {\n      !insts = TInsts::empty();\n    };\n    h = (insts, clauses).xxhash(true);\n    static{h, pos, insts, clauses};\n  }\n\n  // TRANSFORMERS\n\n  // t.mapSTypes(subst, env, variance, f) is t with stypes updated by f, or\n  // None() if the result is Top\n  fun mapSTypes(\n    subst: mutable Subst,\n    env: TEnv,\n    variance: Variance,\n    f: (STypes) -> STypes,\n  ): ?this {\n    this.getSTypes(subst, env, variance).map(stypes ->\n      TType::fromSTypes(this.pos, f(stypes))\n    )\n  }\n\n  private fun mapClauses(\n    subst: mutable Subst,\n    tenv: TEnv,\n    f: Clause -> this,\n  ): this {\n    if (this.clauses.isEmpty()) {\n      this\n    } else {\n      accum = TType::create(this.pos, this.insts, Clauses::empty());\n      for (clause in this.clauses.clauses) {\n        !accum = TType::union(subst, tenv, accum, f(clause));\n      };\n      accum\n    }\n  }\n\n  // t.mapTParams(subst, tenv, f) is t with each TParam p replaced by u\n  // where f(p) is Some(u), or left unchanged if f(p) is None. The type's\n  // unions and intersections are rebuilt using subst and tenv.\n  fun mapTParams(\n    subst: mutable Subst,\n    tenv: TEnv,\n    f: (TParam) -> ?TType,\n  ): this {\n    this.mapClauses(subst, tenv, clause0 -> {\n      clause1 = TType::top(this.pos);\n      for (tparam in clause0.vars) {\n        paramTy = f(tparam) match {\n        | None() -> TType::fromTParam(this.pos, tparam)\n        | Some(ty) -> ty\n        };\n        !clause1 = TType::inter(subst, tenv, clause1, paramTy)\n      };\n      clause0.stypes match {\n      | None() -> clause1\n      | Some(stypes) ->\n        TType::inter(subst, tenv, clause1, TType::fromSTypes(this.pos, stypes))\n      }\n    })\n  }\n\n  fun withPos(pos: PosRange): this {\n    // pos is not part of the hash\n    this with {pos}\n  }\n\n  fun rawMap(insts: (TInsts) -> TInsts, clauses: (Clauses) -> Clauses): this {\n    static::create(this.pos, insts(this.insts), clauses(this.clauses))\n  }\n\n  // UTILITIES\n\n  fun toString(): String {\n    prettyPrintType(false, this)\n  }\n\n  fun compare(other: this): Order {\n    this.h.compare(other.h)\n  }\n\n  fun hash(): Int {\n    this.h.value\n  }\n\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    if (ignorePos) this.h else (this.insts, this.clauses).xxhash()\n  }\n\n  // BOOLEAN PROPERTIES\n\n  fun isBottom(): Bool {\n    this.insts.isEmpty() && this.clauses.isEmpty()\n  }\n\n  fun isTop(): Bool {\n    this.clauses.isTop()\n  }\n\n  fun isPrimitiveType(subst: mutable Subst, tenv: TEnv): Bool {\n    this.getSTypes(subst, tenv, Covariant()) match {\n    | None() -> false\n    | Some(stypes) ->\n      for (stype in stypes) {\n        stype match {\n        | TPrimUnit _\n        | TPrimValue _ ->\n          continue\n        | TTuple(tys, _) ->\n          for (ty in tys) {\n            if (!ty.isPrimitiveType(subst, tenv)) return false\n          }\n        | TAlgebraic _\n        | TFuns _\n        | TObject _\n        | TPromise _ ->\n          return false\n        }\n      };\n      true\n    }\n  }\n\n  fun isMethod(subst: mutable Subst, tenv: TEnv): Bool {\n    this.getSTypes(subst, tenv, Covariant()) match {\n    | None() -> false\n    | Some(stypes) ->\n      if (stypes.isEmpty()) return false;\n      for (stype in stypes) {\n        stype match {\n        | TFuns(funs, _, _) if (funs.isEmpty()) -> void\n        | _ -> return false\n        }\n      };\n      true\n    }\n  }\n\n  // OTHER PROPERTIES\n\n  // Returns the actual STypes after head expansion, forgetting type parameters,\n  // so the return value over-approximates the type\n  // Returns None() if the type eventually expands to Top\n  fun getSTypes(subst: mutable Subst, tenv: TEnv, variance: Variance): ?STypes {\n    this.expand_(subst, tenv, variance).getSTypes(subst, tenv)\n  }\n\n  fun expand_(subst: mutable Subst, tenv: TEnv, variance: Variance): Clauses {\n    clauses = this.clauses;\n    insts = Vector::mcreateFromItems(this.insts.insts);\n    seen = SortedSet::createFromItems(insts);\n    loop {\n      if (insts.isEmpty()) return clauses;\n      inst = insts.pop();\n      tyDef = inst match {\n      | TSInst(name, targs) -> tenv.instantiate(subst, name, targs)\n      | TInter(ty1, ty2) -> TType::inter(subst, tenv, ty1, ty2)\n      | TUnion(ty1, ty2) -> TType::union(subst, tenv, ty1, ty2)\n      | tvar @ TVar _ -> subst.get(tenv, tvar, variance)\n      };\n      if (tyDef.isTop()) return Clauses::top();\n      !clauses = Clauses::union(subst, tenv, clauses, tyDef.clauses);\n      for (newInst in tyDef.insts) {\n        if (seen.contains(newInst)) continue;\n        !seen = seen.set(newInst);\n        insts.push(newInst);\n      }\n    }\n  }\n\n  fun expand(subst: mutable Subst, tenv: TEnv, variance: Variance): TType {\n    static::fromClauses(this.pos, this.expand_(subst, tenv, variance))\n  }\n\n  fun getConstantString(): ?(PosRange, String) {\n    if (!this.insts.isEmpty()) None() else {\n      this.clauses.getConstantString()\n    }\n  }\n\n  fun getSingleVar(): ?TVar {\n    if (this.clauses.isEmpty()) this.insts.getSingleVar() else {\n      None()\n    }\n  }\n\n  /* t1.diff(t2)  computes t3, an over-approximation of t1 \\ t2\n     i.e. such that t3 <= t1 and t3 | t2 >= t1\n   */\n  fun diff(other: TType): TType {\n    diffInsts = this.insts.diff(other.insts);\n    diffClauses = this.clauses.diff(other.clauses);\n    static::create(this.pos, diffInsts, diffClauses)\n  }\n}\n\nbase class Variance {\n  children =\n  | Covariant()\n  | Contravariant()\n}\n\n/***************************************************************************/\n/* Object types. */\n/***************************************************************************/\n\n// Regular Typescript (open) object type\n// but disjoint from types in TAlgebraic\nclass TObject(fields: TFields) extends SType {\n  fun removeFields(fieldsToRemove: SortedSet<String>): this {\n    if (fieldsToRemove.isEmpty()) this else {\n      this with {fields => this.fields.removeFields(fieldsToRemove)}\n    }\n  }\n}\n\nconst kAlgebraicBranchFieldName: String = \"kind\";\n\nclass TAlgebraic(\n  branches: InternalKeyedArrayMap<String, TConstr>,\n) extends SType {\n  static fun single(x: TConstr, pos: PosRange): this {\n    static(InternalKeyedArrayMap::single(x), pos)\n  }\n\n  fun removeFields(fieldsToRemove: SortedSet<String>): this {\n    if (fieldsToRemove.isEmpty()) this else {\n      this with {\n        branches => this.branches.map(branch ->\n          branch.removeFields(fieldsToRemove)\n        ),\n      }\n    }\n  }\n}\n\nclass TConstr(\n  tag: String,\n  tagPos: PosRange,\n  // TODO: make fields private so that we don't try to access \"kind\" from fields\n  fields: TFields,\n) uses XXHashable, Orderable, Projectable<String> {\n  fun map(f: TFields -> TFields): this {\n    static(this.tag, this.tagPos, f(this.fields))\n  }\n\n  fun getType(\n    subst: mutable Subst,\n    tenv: TEnv,\n    fieldName: String,\n    pos: PosRange,\n  ): TType {\n    if (fieldName == kAlgebraicBranchFieldName) {\n      TType::single(TPrimValue::single(TString(), this.tag, this.tagPos))\n    } else {\n      this.fields.getType(subst, tenv, fieldName, pos)\n    }\n  }\n\n  fun removeFields(fieldsToRemove: SortedSet<String>): this {\n    if (fieldsToRemove.isEmpty()) this else {\n      this with {fields => this.fields.removeFields(fieldsToRemove)}\n    }\n  }\n\n  fun project(): String {\n    this.tag\n  }\n}\n\nfun createObject(\n  pos: PosRange,\n  algebraicBranchField: ?(PosRange, TType),\n  fields: TFields,\n): TType {\n  seen = mutable Set<String>[];\n  for (field in fields) {\n    if (seen.contains(field.name)) {\n      typingError(Array[(field.pos, \"Duplicate field\")])\n    };\n    seen.insert(field.name);\n  };\n  algebraicBranchField match {\n  | Some((algebraicBranchFieldPos, algebraicBranchFieldType)) ->\n    algebraicBranchFieldType.getConstantString() match {\n    | None() ->\n      typingError(\n        Array[\n          (\n            pos,\n            `Algebraic field ${kAlgebraicBranchFieldName} was expected to be a constant string`,\n          ),\n          (algebraicBranchFieldPos, `Got ${algebraicBranchFieldType} instead.`),\n        ],\n      )\n    | Some((tagPos, tag)) ->\n      TType::single(\n        TAlgebraic::single(\n          TConstr(tag, tagPos, fields),\n          algebraicBranchFieldPos,\n        ),\n      )\n    }\n  | None() -> TType::single(TObject(fields, pos))\n  }\n}\n\n/***************************************************************************/\n/* Tuples */\n/***************************************************************************/\n\nclass TTuple(tuple: Array<TType>) extends SType {\n  fun toString(): String {\n    internal_error(\"TODO TTuple toString\")\n  }\n}\n\n/***************************************************************************/\n/* Funs */\n/***************************************************************************/\n\nclass TFuns private (\n  funs: InternalKeyedArrayMap<(Int, Int), TFun>,\n  methods: InternalKeyedArrayMap<(Int, Int), TFun>,\n) extends SType {\n  /* Invariant: funs and methods are not both empty */\n\n  static fun singleFun(x: TFun, pos: PosRange): this {\n    static(\n      InternalKeyedArrayMap::single(x),\n      InternalKeyedArrayMap::empty(),\n      pos,\n    )\n  }\n\n  static fun singleMethod(x: TFun, pos: PosRange): this {\n    static(\n      InternalKeyedArrayMap::empty(),\n      InternalKeyedArrayMap::single(x),\n      pos,\n    )\n  }\n\n  fun mapFuns(f: TFun -> TFun): this {\n    static(this.funs.map(f), this.methods.map(f), this.pos)\n  }\n}\n\nclass TFun(\n  tparams: Array<TParamWithConstraint>,\n  params: Array<TType>,\n  optionalParams: Array<TType>,\n  spreadParam: ?TType,\n  minSizeWitness: PosRange,\n  retType: TType,\n  cgNodes: CGNodes,\n) uses XXHashable, Orderable, Projectable<(Int, Int)> {\n  fun toString(): String {\n    prettyPrintSType(TFuns::singleFun(this, PosRange::none))\n  }\n\n  fun project(): (Int, Int) {\n    (this.tparams.size(), this.params.size())\n  }\n}\n\n/***************************************************************************/\n/* Single types */\n/***************************************************************************/\n\n/* Types with a single inhabitant:\n- undefined for types void and undefined\n- null for type null\n\nIn Typescript, void is both bottom and a supertype of everything when used as a\nreturn type.\n\nIn SKJS, we decided (see https://github.com/SkipLabs/skjs/issues/75) that void\nwould be a distinct type from undefined. It contains the value undefined but\nwith no operations permitted on it.\n\nWe should ensure that nothing non-undefined can be of type void. */\nbase class TPrimUnitKind uses XXHashable, Orderable {\n  children =\n  | TUndefined()\n  | TVoid()\n  | TNull()\n\n  fun toString(): String {\n    this match {\n    | TUndefined() -> \"undefined\"\n    | TVoid() -> \"void\"\n    | TNull() -> \"null\"\n    }\n  }\n}\n\n/* Types with literal subtypes: booleans, numbers, strings, and bigints. */\nbase class TPrimValueKind uses XXHashable, Orderable {\n  children =\n  | TNum()\n  | TBool()\n  | TString()\n  | TBigInt()\n\n  fun toString(): String {\n    this match {\n    | TNum() -> \"number\"\n    | TBool() -> \"boolean\"\n    | TString() -> \"string\"\n    | TBigInt() -> \"bigint\"\n    }\n  }\n}\n\nbase class SType private (\n  pos: PosRange,\n) uses XXHashable, Orderable, Projectable<Int> {\n  children =\n  | TPromise(TType)\n\n  fun tag(): Int {\n    this match {\n    | TPrimUnit(TUndefined(), _) -> 0\n    | TPrimUnit(TVoid(), _) -> 1\n    | TPrimUnit(TNull(), _) -> 2\n    | TPrimValue(TBool(), _, _) -> 3\n    | TPrimValue(TNum(), _, _) -> 4\n    | TPrimValue(TString(), _, _) -> 5\n    | TPrimValue(TBigInt(), _, _) -> 6\n    | TTuple _ -> 7\n    | TPromise _ -> 8\n    | TObject _ -> 9\n    | TAlgebraic _ -> 10\n    | TFuns _ -> 11\n    }\n  }\n\n  fun project(): Int {\n    this.tag()\n  }\n}\n\nclass TPrimUnit(kind: TPrimUnitKind) extends SType\n\nclass TPrimValue(kind: TPrimValueKind, values: ?ArrayValues) extends SType {\n  static fun single(kind: TPrimValueKind, value: String, pos: PosRange): this {\n    static(kind, Some(ArrayValues::single((pos, value))), pos)\n  }\n\n  static fun full(kind: TPrimValueKind, pos: PosRange): this {\n    static(kind, None(), pos)\n  }\n\n  static fun boolean(pos: PosRange): this {\n    static::full(TBool(), pos)\n  }\n\n  static fun number(pos: PosRange): this {\n    static::full(TNum(), pos)\n  }\n\n  static fun string(pos: PosRange): this {\n    static::full(TString(), pos)\n  }\n\n  static fun bigint(pos: PosRange): this {\n    static::full(TBigInt(), pos)\n  }\n\n  fun asClassName(): Name {\n    Name(this.pos, this.kind.toString())\n  }\n}\n\nclass TField private (\n  pos: PosRange,\n  name: /* Invariant: name != kAlgebraicBranchFieldName */ String,\n  isOptional: Bool,\n  type: TType,\n) uses XXHashable, Orderable, Projectable<String> {\n  static fun create(\n    pos: PosRange,\n    name: String,\n    isOptional: Bool,\n    type: TType,\n  ): ?this {\n    if (name == kAlgebraicBranchFieldName) None() else {\n      Some(static(pos, name, isOptional, type))\n    }\n  }\n\n  fun withOptional(): this {\n    this with {isOptional => true}\n  }\n\n  fun mapType(f: TType -> TType): this {\n    this with {type => f(this.type)}\n  }\n\n  fun project(): String {\n    this.name\n  }\n}\n\n/* Fields such as { [keyName: KeyType]: ValueType } */\nclass TIndexField(\n  pos: PosRange,\n  keyName: String,\n  keyType: TType,\n  valueType: TType,\n) uses XXHashable, Orderable {\n  fun mapTypes(f: TType -> TType): this {\n    keyType = f(this.keyType);\n    valueType = f(this.valueType);\n    this with {keyType, valueType}\n  }\n}\n\nclass TFields private (\n  fields: InternalKeyedArrayMap<String, TField>,\n  indexes: Array<TIndexField>,\n  /* There can be several index fields.\n     Typescript allows only one per object, but is fine with\n     intersecting two objects with index fields, so it's like having\n     two of them. This array is expected to have zero or one element\n     most of the time, or at most a few elements.\n\n     TODO: allow only subtypes of string | number (| symbol)\n     TODO: if a field name is included an index key type, then its\n      type must be a subtype of the index key type\n  */\n) uses XXHashable, Orderable {\n  static fun empty(): this {\n    static(InternalKeyedArrayMap::empty(), Array[])\n  }\n\n  static fun create(fields: Array<TField>, indexes: Array<TIndexField>): this {\n    static(\n      InternalKeyedArrayMap::createFromSortedIterator(\n        fields.sortedBy(x ~> x.name).values(),\n      ),\n      indexes,\n    )\n  }\n\n  fun isEmpty(): Bool {\n    this.fields.isEmpty() && this.indexes.isEmpty()\n  }\n\n  fun map(\n    fField: TField -> TField,\n    fIndexField: TIndexField -> TIndexField,\n  ): this {\n    static(this.fields.map(fField), this.indexes.map(fIndexField))\n  }\n\n  fun filterMap(f: TField -> ?TField): this {\n    static(this.fields.filterMap(f), this.indexes)\n  }\n\n  fun values(): mutable Iterator<TField> {\n    this.fields.values()\n  }\n\n  fun maybeSingleIndex(): ?TIndexField {\n    this.indexes.size() match {\n    | 0 -> None()\n    | 1 -> Some(this.indexes[0])\n    | _ -> internal_error(\"TODO: multiple indexes\")\n    }\n  }\n\n  fun maybeGet(fieldName: String): ?TField {\n    this.fields.maybeGet(fieldName)\n  }\n\n  fun maybeGetType(\n    subst: mutable Subst,\n    tenv: TEnv,\n    fieldName: String,\n    pos: PosRange,\n  ): ?TType {\n    this.maybeGet(fieldName).map(fd -> {\n      ty = fd.type;\n      if (fd.isOptional) {\n        ty.unionUndefined(subst, tenv, pos)\n      } else {\n        ty\n      }\n    })\n  }\n\n  fun getTypeTypingError<T>(fieldName: String, pos: PosRange): T {\n    typingError(\n      Array[\n        (pos, `Unbound field: ${fieldName}`),\n        (\n          pos,\n          \"Possible options are:\\n\" +\n            this.fields.filter(x -> x.name != \"constructor\")\n              .toArray()\n              .map(x -> x.name)\n              .join(\"\\n\"),\n        ),\n      ],\n    )\n  }\n\n  fun getType(\n    subst: mutable Subst,\n    tenv: TEnv,\n    fieldName: String,\n    pos: PosRange,\n  ): TType {\n    this.maybeGetType(subst, tenv, fieldName, pos) match {\n    | None() -> this.getTypeTypingError(fieldName, pos)\n    | Some(ty) -> ty\n    }\n  }\n\n  // Returns None() if the field already exist\n  fun addField(fieldToAdd: TField): ?this {\n    if (this.fields.containsKey(fieldToAdd.name)) None() else {\n      Some(\n        static(\n          this.fields.union(InternalKeyedArrayMap::single(fieldToAdd)),\n          this.indexes,\n        ),\n      )\n    }\n  }\n\n  fun removeFields(fieldsToRemove: SortedSet<String>): this {\n    if (fieldsToRemove.isEmpty()) this else {\n      // TODO: better approximation of removing fields that may intersect with indexes\n      this with {\n        fields => this.fields.filter(field ->\n          !fieldsToRemove.contains(field.name)\n        ),\n      }\n    }\n  }\n}\n\nclass STypes private (\n  private stypes: InternalKeyedArrayMap<Int, SType>,\n) uses XXHashable, Orderable {\n  static fun empty(): this {\n    static(InternalKeyedArrayMap::empty())\n  }\n\n  static fun single(x: SType): this {\n    static(InternalKeyedArrayMap::single(x))\n  }\n\n  fun map(f: SType -> SType): this {\n    static(this.stypes.map(f))\n  }\n\n  fun filter(f: SType -> Bool): this {\n    static(this.stypes.filter(f))\n  }\n\n  fun filterMap(f: SType -> ?SType): this {\n    static(this.stypes.filterMap(f))\n  }\n\n  fun isEmpty(): Bool {\n    this.stypes.isEmpty()\n  }\n\n  fun size(): Int {\n    this.stypes.size()\n  }\n\n  fun items(): mutable Iterator<(Int, SType)> {\n    this.stypes.items()\n  }\n\n  fun values(): mutable Iterator<SType> {\n    this.stypes.values()\n  }\n\n  fun any(f: SType -> Bool): Bool {\n    this.stypes.any(f)\n  }\n\n  fun all(f: SType -> Bool): Bool {\n    this.stypes.all(f)\n  }\n\n  fun singleElt(): ?SType {\n    if (this.stypes.size() == 1) this.stypes.minimum() else None()\n  }\n\n  fun getConstantString(): ?(PosRange, String) {\n    this.singleElt() match {\n    | Some(TPrimValue(TString(), Some(values), _)) -> values.singleElt()\n    | _ -> None()\n    }\n  }\n\n  fun staticValue(): ?String {\n    this.singleElt() match {\n    | Some(TPrimValue(_, Some(values), _)) -> values.singleElt().map(v -> v.i1)\n    | _ -> None()\n    }\n  }\n\n  /* t1.diff(t2)  computes t3, an over-approximation of t1 \\ t2\n     i.e. such that t3 <= t1 and t3 | t2 >= t1\n   */\n  fun diff(other: STypes): STypes {\n    (noMatch1, _noMatch2, _present) = mapInter(\n      this.stypes.values(),\n      other.stypes.values(),\n      x ~> x.project(),\n      (x, _) ~> x,\n    );\n    static(InternalKeyedArrayMap::createFromSortedIterator(noMatch1.iterator()))\n  }\n}\n\n/* Type variable */\n//\n// Introduced:\n// - for local variables\n// - when instantiating a generic type or a function\n//\n// Interpretation:\n// \u301a tvar \u301b = more or less* subst[tvar.id] \u2a05 \u301a tvar.constraints \u301b\n// \u301a constraints \u301b = \u2a05 \u301a c \u301b for c in constraints\n//\n// *see Subst#get\nclass TVar private (\n  pos: PosRange,\n  id: Int,\n  constraints: SortedMap<Int, TType>,\n) extends TInst {\n  static fun create(pos: PosRange, id: Int): this {\n    static(pos, id, SortedMap[])\n  }\n\n  fun addConstraint(ty: TType): this {\n    !this.constraints[ty.hash()] = ty;\n    this\n  }\n\n  fun mapConstraints(f: TType -> TType): this {\n    !this.constraints = this.constraints.map((_id, ty) -> f(ty));\n    this\n  }\n  fun xxhash(ignorePos: Bool = false): XXHash {\n    XXHash(\n      this.constraints.items().foldl(\n        (seed, kv) -> {\n          k = kv.i0.xxhash(ignorePos).value;\n          v = kv.i1.xxhash(ignorePos).value;\n          XXHash64.xxHash64(XXHash64.xxHash64(seed, k), v)\n        },\n        XXHash64.xxHash64(this.id, this.pos.xxhash(ignorePos).value),\n      ),\n    )\n  }\n}\n\n/* Unexpanded named type */\n// possibly with type arguments\nclass TSInst(name: Name, targs: TArgs) extends TInst {}\n\nclass TArgs(targs: Array<TType>) uses XXHashable, Orderable\n\nbase class TInst uses XXHashable, Orderable\n\n/* \"Instance\"/Unexpanded types */\n//\n// Interpretation:\n// \u301a tinsts \u301b = \u2a06 \u301a inst \u301b, for inst in tinsts.insts\nclass TInsts private (insts: Array<TInst>) uses XXHashable, Orderable {\n  static fun empty(): this {\n    static(Array[])\n  }\n\n  static fun single(inst: TInst): this {\n    TInsts(Array[inst])\n  }\n\n  fun map(f: TInst -> TInst): this {\n    static(this.insts.map(f))\n  }\n\n  fun isEmpty(): Bool {\n    this.insts.isEmpty()\n  }\n\n  fun values(): mutable Iterator<TInst> {\n    this.insts.values()\n  }\n\n  fun getSingleVar(): ?TVar {\n    if (this.insts.size() == 1) {\n      this.insts[0] match {\n      | res @ TVar _ -> Some(res)\n      | _ -> None()\n      }\n    } else {\n      None()\n    }\n  }\n\n  /* t1.diff(t2)  computes t3, an over-approximation of t1 \\ t2\n     i.e. such that t3 <= t1 and t3 | t2 >= t1\n   */\n  fun diff(other: TInsts): TInsts {\n    (noMatch1, _noMatch2, _present) = mapInter(\n      this.values(),\n      other.values(),\n      x ~> x,\n      (x, _) ~> x,\n    );\n    static(noMatch1)\n  }\n}\n\nvalue class Id private (id: String) uses XXHashable, Orderable, Show {\n  static fun create(name: String, id: Int, lexer: readonly Lexer): this {\n    static(`${name}:${id}:${lexer.relativeFileName.hash()}`)\n  }\n\n  fun prefixWith(pre: String): this {\n    static(pre + this.id)\n  }\n\n  static fun createThis(): this {\n    static(\"this\")\n  }\n\n  fun toString(): String {\n    this.id\n  }\n}\n\nclass TParamWithConstraint(\n  name: String,\n  fileName: String,\n  id: Id,\n  cstr: ?TType,\n) uses XXHashable, Orderable {\n  //\n  fun withoutConstraint(): TParam {\n    TParam(this.name, this.fileName, this.id)\n  }\n}\n\nclass TParam(name: String, fileName: String, id: Id) uses XXHashable, Orderable\n\n/* Clause */\n//\n// Interpretation:\n// \u301a clause \u301b = \u301a clause.vars \u301b \u2a05 \u301a clause.stypes \u301b\n// \u301a vars \u301b = \u2a05 \u301a v \u301b, for v in vars\n// \u301a stypes \u301b = Top     if stypes is None\n//              \u301a st \u301b  if stypes = Some(st)\n//                \\-->  see STypes, this is a union\n//\n// In particular, Clause(ArraySet[], None()) represents \u22a4\n//                Clause(_, Some(STypes::empty())) represents \u22a5\nclass Clause private (\n  vars: ArraySet<TParam>,\n  stypes: ?STypes,\n) uses XXHashable, Orderable, Projectable<ArraySet<TParam>> {\n  /* Invariant: Clause cannot be bottom */\n\n  // Returns None if the result is bottom (i.e. if stypes is Some(bottom))\n  static fun create(vars: ArraySet<TParam>, stypes: ?STypes): ?this {\n    stypes match {\n    | Some(s) if (s.isEmpty()) -> None()\n    | _ -> Some(static(vars, stypes))\n    }\n  }\n\n  // Returns None if the result is bottom (i.e. if stypes is bottom)\n  static fun fromSTypes(stypes: STypes): ?this {\n    static::create(ArraySet::empty(), Some(stypes))\n  }\n\n  static fun undefined(pos: PosRange): this {\n    static(\n      ArraySet::empty(),\n      Some(STypes::single(TPrimUnit(TUndefined(), pos))),\n    )\n  }\n\n  static fun top(): this {\n    static(ArraySet::empty(), None())\n  }\n\n  // Returns None if the result is bottom\n  fun map(fTParam: TParam -> TParam, fSTypes: STypes -> STypes): ?this {\n    this.stypes.map(fSTypes) match {\n    | Some(sTypes) if (sTypes.isEmpty()) -> None()\n    | stypes ->\n      vars = this.vars.map(fTParam);\n      Some(static(vars, stypes))\n    }\n  }\n\n  fun getConstantString(): ?(PosRange, String) {\n    if (!this.vars.isEmpty()) None() else {\n      this.stypes.flatMap(sTypes -> sTypes.getConstantString())\n    }\n  }\n\n  fun isTop(): Bool {\n    this.stypes is None() && this.vars.isEmpty()\n  }\n\n  fun project(): ArraySet<TParam> {\n    this.vars\n  }\n\n  /*\n    t1.diff(t2)  computes t3, an over-approximation of t1 \\ t2\n    i.e. such that t3 <= 1 and t3 | t2 >= t1\n    Returns None if the result is bottom */\n  fun diff(other: ?STypes): ?Clause {\n    (this.stypes, other) match {\n    | (_, None()) ->\n      None() // anything - Top = bottom\n    | (None(), Some(_)) ->\n      Some(this) // Top - Something <= Top (keep clause)\n    | (Some(stypesThis), Some(stypesOther)) ->\n      // Compute the difference of the stypes\n      diffResult = stypesThis.diff(stypesOther);\n      Clause::create(this.vars, Some(diffResult))\n    }\n  }\n}\n\n/* Clauses: type parameters and simple types in DNF */\n//\n// Interpretation:\n// \u301a clauses \u301b = \u2a06 \u301a c \u301b, for c in clauses.clauses\nclass Clauses private (\n  clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,\n) uses XXHashable, Orderable {\n  /*\n    Invariant: if one of the clauses is Top, then there are no other clauses\n   */\n  private static fun create(\n    clauses: InternalKeyedArrayMap<ArraySet<TParam>, Clause>,\n  ): this {\n    if (clauses.any(c -> c.isTop())) static::top() else Clauses(clauses)\n  }\n\n  static fun empty(): this {\n    Clauses(InternalKeyedArrayMap::empty())\n  }\n\n  static fun top(): this {\n    Clauses(InternalKeyedArrayMap::single(Clause::top()))\n  }\n\n  fun map(f: Clause -> ?Clause): this {\n    static::create(\n      InternalKeyedArrayMap::createFromIterator(\n        this.clauses.values().filterMap(f),\n      ),\n    )\n  }\n\n  fun isEmpty(): Bool {\n    this.clauses.isEmpty()\n  }\n\n  fun isTop(): Bool {\n    this.clauses.singleElt() match {\n    | None() -> false\n    | Some(clause) -> clause.isTop()\n    }\n  }\n\n  static fun singleClause(clause: Clause): this {\n    static(InternalKeyedArrayMap::single(clause))\n  }\n\n  static fun single(tparam: TParam): this {\n    Clause::create(ArraySet::single(tparam), None()) match {\n    | None() -> static::empty()\n    | Some(clause) -> static(InternalKeyedArrayMap::single(clause))\n    }\n  }\n\n  static fun fromSTypes(stypes: STypes): this {\n    Clause::fromSTypes(stypes) match {\n    | None() -> static::empty()\n    | Some(clause) -> static(InternalKeyedArrayMap::single(clause))\n    }\n  }\n\n  fun getConstantString(): ?(PosRange, String) {\n    this.clauses.singleElt().flatMap(clause -> clause.getConstantString())\n  }\n\n  // Returns the actual STypes, forgetting type parameters,\n  // so the return value over-approximates the type\n  // Returns None() if the type eventually expands to Top\n  fun getSTypes(subst: mutable Subst, tenv: TEnv): ?STypes {\n    result = STypes::empty();\n    for (clause in this.clauses) {\n      clause.stypes match {\n      | None() -> return None()\n      | Some(clauseSTypes) ->\n        !result = STypes::union(subst, tenv, result, clauseSTypes)\n      }\n    };\n    Some(result)\n  }\n\n  fun primKind(): ?Name {\n    cand: ?TPrimValue = None();\n    for (clause in this.clauses) {\n      clause.stypes match {\n      | None() -> return None()\n      | Some(stypes) ->\n        for (stype in stypes) {\n          (stype, cand) match {\n          | (prim @ TPrimValue _, None()) -> !cand = Some(prim)\n          | (\n            TPrimValue(kind, _, _),\n            Some(TPrimValue(candKind, _, _)),\n          ) if (kind == candKind) ->\n            void\n          | _ -> return None()\n          }\n        }\n      }\n    };\n    cand.map(prim -> prim.asClassName())\n  }\n\n  fun getObject(): ?TObject {\n    this.clauses.singleElt().flatMap(clause ->\n      clause.stypes.flatMap(stypes -> {\n        stypes.singleElt() match {\n        | Some(obj @ TObject _) -> Some(obj)\n        | _ -> None()\n        }\n      })\n    )\n  }\n\n  /* t1.diff(t2)  computes t3, an over-approximation of t1 \\ t2\n     i.e. such that t3 <= t1 and t3 | t2 >= t1\n   */\n  fun diff(other: Clauses): Clauses {\n    noParamOtherOpt = other.clauses.maybeGet(ArraySet::empty());\n\n    // Use merge to handle the diff operation\n    diffClauses = this.clauses.merge(\n      other.clauses,\n      (clauseThisOpt, clauseOtherOpt) -> {\n        (clauseThisOpt, clauseOtherOpt, noParamOtherOpt) match {\n        | (Some(clauseThis), None(), None()) ->\n          Some(clauseThis) // Keep clause from this\n        | (None(), _, _) ->\n          None() // Don't include clauses only in other\n        | (Some(clauseThis), Some(another), None())\n        | (Some(clauseThis), None(), Some(another)) ->\n          clauseThis.diff(another.stypes)\n        | (Some(clauseThis), Some(clauseOther), Some(noParamOther)) ->\n          clauseThis.diff(clauseOther.stypes).flatMap(c ->\n            c.diff(noParamOther.stypes)\n          )\n        }\n      },\n    );\n\n    static::create(diffClauses)\n  }\n\n  fun any(f: Clause -> Bool): Bool {\n    this.clauses.any(f)\n  }\n\n  fun values(): mutable Iterator<Clause> {\n    this.clauses.values()\n  }\n}\n\n/***************************************************************************/\n/* Sub-typing */\n/***************************************************************************/\n\n/* Result for a check of subtyping of types T1 and T2 */\nbase class STResult\n\n/* T1 \u2291 T2 */\nclass STOk() extends STResult\n\n/* All other cases: T1 \u22e2 T2 */\nbase class STError extends STResult {\n  children =\n  | STNoConstraint()\n  | STMissingField(String)\n  | STMissingSpread()\n  | STTooManySType(SType)\n  | STTooManyTConstr(TConstr)\n  | STTooManyTTuple(TTuple)\n  | STTooManyTFun(TFun)\n  | STInvalidClause(Clause)\n  | STRec(STError, PosRange, TType)\n\n  fun toString(subst: mutable Subst, tenv: TEnv, ty: TType): String {\n    this match {\n    | STNoConstraint() -> \"This type parameter does not define a constraint\"\n    | STMissingSpread() -> \"Missing ... parameter\"\n    | STMissingField(fieldName) ->\n      `The field '${fieldName}' is missing\\n` +\n        `Out of the type: ${expandTVars(subst, tenv, ty)}`\n    | STTooManySType(sty) ->\n      sty match {\n      | TPrimUnit(kind, _) -> `This is a ${kind}`\n      | TPrimValue(TString(), None(), _) ->\n        \"This is of type string. \" +\n          \"Use 'as const' to create a string literal type, for example: \\\"foo\\\" as const or 'foo' as const.\"\n      | TPrimValue(kind, None(), _) -> `This is of type ${kind}`\n      | TPrimValue(kind, Some(x), _) ->\n        `This is a static ${kind}: ` +\n          x.values.map(x -> `'${x.i1}'`).join(\" | \")\n\n      | TPromise _ -> \"This is a Promise\"\n      | TAlgebraic _ ->\n        \"This is a constructor (the field kind is a static string)\"\n      | TFuns _ ->\n        \"This is a function of type: \" +\n          prettyPrintType(false, TType::single(sty))\n      | TObject _ -> \"This is an object\"\n      | TTuple(tuple, _) -> \"This is a tuple of size \" + tuple.size()\n      }\n    | STTooManyTConstr(_) -> \"This is a constructor\"\n    | STTooManyTTuple(tuple) -> \"This is a tuple of size \" + tuple.tuple.size()\n    | STTooManyTFun(f) ->\n      \"This is a function: \" +\n        prettyPrintType(\n          false,\n          TType::single(TFuns::singleFun(f, f.minSizeWitness)),\n        )\n    | STInvalidClause(clause) -> \"This is of type \" + prettyPrintClause(clause)\n    | STRec(st, _, ty2) -> st.toString(subst, tenv, ty2)\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/TTypeInter.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// Intersection operations for types.\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class TType {\n  // Unexpanded intersection.\n  static private fun unexpandedInter(t1: TType, t2: TType): this {\n    i = TInter::create(t1, t2);\n    static::create(t1.pos, TInsts::single(i), Clauses::empty())\n  }\n\n  static fun inter(\n    subst: mutable Subst,\n    tenv: TEnv,\n    ty1: TType,\n    ty2: TType,\n  ): TType {\n    if (ty1 == ty2) return ty1;\n    pair = (ty1, ty2);\n    subst.seenInter.maybeGet(pair) match {\n    | None() ->\n      result = static::inter_(subst, tenv, ty1, ty2);\n      subst.!seenInter[pair] = result;\n      result\n    | Some(ty) -> ty\n    }\n  }\n\n  private static fun inter_(\n    subst: mutable Subst,\n    tenv: TEnv,\n    ty1: TType,\n    ty2: TType,\n  ): TType {\n    expandPrim = (primClassName) -> static::inst(primClassName, TArgs(Array[]));\n    if (ty2.isTop() || ty1.isBottom()) return ty1;\n    if (ty1.isTop() || ty2.isBottom()) return ty2;\n    if (tenv.seenInter.contains((ty1, ty2))) {\n      return static::unexpandedInter(ty1, ty2);\n    };\n    !tenv.seenInter = tenv.seenInter.set((ty1, ty2));\n    ty1.getSingleVar() match {\n    | None() -> void\n    | Some(tvar) -> return TType::var(tvar.addConstraint(ty2))\n    };\n    ty2.getSingleVar() match {\n    | None() -> void\n    | Some(tvar) -> return TType::var(tvar.addConstraint(ty1))\n    };\n    clauses1 = ty1.expand_(subst, tenv, Covariant());\n    clauses2 = ty2.expand_(subst, tenv, Covariant());\n    (clauses1.primKind(), clauses2.getObject()) match {\n    | (Some(primKind), Some(stype)) ->\n      isSubTType(\n        subst,\n        tenv,\n        expandPrim(primKind),\n        TType::single(stype),\n      ) match {\n      | STOk() -> return ty1\n      | STError _ -> void\n      }\n    | _ -> void\n    };\n    (clauses2.primKind(), clauses1.getObject()) match {\n    | (Some(primKind), Some(stype)) ->\n      isSubTType(\n        subst,\n        tenv,\n        expandPrim(primKind),\n        TType::single(stype),\n      ) match {\n      | STOk() -> return ty2\n      | STError _ -> void\n      }\n    | _ -> void\n    };\n    clauses = Clauses::inter(subst, tenv, clauses1, clauses2);\n    TType::fromClauses(ty1.pos, clauses);\n  }\n}\n\nextension class TAlgebraic {\n  static fun inter(\n    subst: mutable Subst,\n    tenv: TEnv,\n    a1: TAlgebraic,\n    a2: TAlgebraic,\n  ): TAlgebraic {\n    static(\n      a1.branches.mapInter(a2.branches, (x, y) ->\n        TConstr::inter(subst, tenv, x, y)\n      ),\n      a1.pos,\n    )\n  }\n}\n\nextension class TConstr {\n  static fun inter(subst: mutable Subst, tenv: TEnv, x: this, y: this): this {\n    invariant(x.tag == y.tag);\n    static(x.tag, x.tagPos, interTFields(subst, tenv, x.fields, y.fields))\n  }\n}\n\nextension class TFuns {\n  static fun inter(\n    subst: mutable Subst,\n    tenv: TEnv,\n    f1: TFuns,\n    f2: TFuns,\n  ): ?TFuns {\n    funs = f1.funs.mapInter(f2.funs, (x, y) -> interTFun(subst, tenv, x, y));\n    methods = f1.methods.mapInter(f2.methods, (x, y) ->\n      interTFun(subst, tenv, x, y)\n    );\n    if (funs.isEmpty() && methods.isEmpty()) None() else {\n      Some(static(funs, methods, f1.pos))\n    }\n  }\n}\n\nextension class TField {\n  static fun inter(subst: mutable Subst, tenv: TEnv, x: this, y: this): this {\n    if (x.name != y.name) internal_error(\"field names must match\");\n    static(\n      x.pos,\n      x.name,\n      x.isOptional && y.isOptional,\n      TType::inter(subst, tenv, x.type, y.type),\n    )\n  }\n}\n\nextension class TIndexField {\n  static fun inter(subst: mutable Subst, tenv: TEnv, x: this, y: this): ?this {\n    /* Currently over-approximating by a union\n       for { [f: 0 | 1]: 4 | 5 } & { [g: 1 | 2]: 5 | 6 },\n       the result would be { [f: 0]: 4 | 5, [fg: 1]: 5, [g: 2]: 5 | 6}\n       but we return { [f: 0 | 1 | 2]: 4 | 5 | 6 } */\n    valueType = TType::union(subst, tenv, x.valueType, y.valueType);\n    keyType = TType::union(subst, tenv, x.keyType, y.keyType);\n    Some(static(x.pos, x.keyName, keyType, valueType))\n  }\n}\n\nextension class STypes {\n  // inter returns None when the intersection of the args is bottom\n  static fun inter(\n    subst: mutable Subst,\n    tenv: TEnv,\n    stypes1: STypes,\n    stypes2: STypes,\n  ): ?STypes {\n    stypes1.stypes.mapInterOption(stypes2.stypes, (x, y) ->\n      interSType(subst, tenv, x, y)\n    ) match {\n    | Some(stypes) if (!stypes.isEmpty()) -> Some(static(stypes))\n    | _ -> None()\n    }\n  }\n}\n\n/* Unexpanded intersection */\n//\n// Interpretation:\n// \u301a inter \u301b = \u301a inter.ty1 \u301b \u2a05 \u301a inter.ty2 \u301b\nclass TInter private (ty1: TType, ty2: TType) extends TInst {\n  static fun create(ty1: TType, ty2: TType): this {\n    if (ty1.isBottom() || ty2.isBottom() || ty1.isTop() || ty2.isTop()) {\n      internal_error(`Unexpected Bottom or Top in TInter: ${ty1} inter ${ty2}`)\n    };\n    static(ty1, ty2)\n  }\n}\n\nextension class Clause {\n  // Returns None if the result is bottom\n  fun inter(subst: mutable Subst, tenv: TEnv, other: Clause): ?Clause {\n    vars = this.vars.union(other.vars);\n    (this.stypes, other.stypes) match {\n    | (None(), stypes)\n    | (stypes, None()) ->\n      Some(Clause(vars, stypes))\n    | (Some(stypes1), Some(stypes2)) ->\n      STypes::inter(subst, tenv, stypes1, stypes2).map(stypes ->\n        Clause(vars, Some(stypes))\n      )\n    }\n  }\n}\n\nextension class Clauses {\n  static fun inter(\n    subst: mutable Subst,\n    tenv: TEnv,\n    clauses1: Clauses,\n    clauses2: Clauses,\n  ): Clauses {\n    result = SortedMap[];\n    for (clause1 in clauses1.clauses) {\n      for (clause2 in clauses2.clauses) {\n        clause1.inter(subst, tenv, clause2) match {\n        | None() -> void\n        | Some(inter) ->\n          if (!result.containsKey(inter.vars)) {\n            !result[inter.vars] = inter;\n          } else {\n            !result[inter.vars] = result[inter.vars].union(subst, tenv, inter)\n          }\n        }\n      }\n    };\n    Clauses(\n      InternalKeyedArrayMap::createFromSortedIterator(\n        result.items().map(x -> x.i1).iterator(),\n      ),\n    )\n  }\n}\n\nextension class TPrimValue {\n  static fun inter(t1: this, t2: this): ?this {\n    if (t1.kind != t2.kind) {\n      internal_error(\n        \"Intersection must be called on primitive value types of same kind\",\n      )\n    };\n    (t1.values, t2.values) match {\n    | (_, None()) -> Some(t1)\n    | (None(), Some _) -> Some(t2)\n    | (Some(s1), Some(s2)) ->\n      s1.inter(s2).map(values -> static(t1.kind, Some(values), t1.pos))\n    }\n  }\n}\n\nfun interTFields(\n  subst: mutable Subst,\n  tenv: TEnv,\n  fields1: TFields,\n  fields2: TFields,\n): TFields {\n  fields = mapUnion(\n    fields1.values(),\n    fields2.values(),\n    x ~> x.name,\n    x ~> x,\n    (x, y) -> TField::inter(subst, tenv, x, y),\n  );\n  // TODO: handle intersection between normal fields and index fields\n  indexes = {\n    index1o = fields1.maybeSingleIndex();\n    index2o = fields2.maybeSingleIndex();\n    (index1o, index2o) match {\n    | (None(), None()) -> None()\n    | (Some(index), None())\n    | (None(), Some(index)) ->\n      Some(index)\n    | (Some(index1), Some(index2)) ->\n      TIndexField::inter(subst, tenv, index1, index2)\n    } match {\n    | None() -> Array[]\n    | Some(index) -> Array[index]\n    }\n  };\n  TFields::create(fields, indexes)\n}\n\nfun interTObject(\n  subst: mutable Subst,\n  tenv: TEnv,\n  obj1: TObject,\n  obj2: TObject,\n): TObject {\n  TObject(interTFields(subst, tenv, obj1.fields, obj2.fields), obj1.pos)\n}\n\n// interSType returns None when the intersection of the args is bottom\nfun interSType(\n  subst: mutable Subst,\n  tenv: TEnv,\n  sty1: SType,\n  sty2: SType,\n): ?SType {\n  (sty1, sty2) match {\n  | (TPrimUnit(k1, _), TPrimUnit(k2, _)) ->\n    if (k1 != k2) internal_error(\"primitive void kinds must match\");\n    Some(sty1)\n\n  | (p1 @ TPrimValue _, p2 @ TPrimValue _) -> TPrimValue::inter(p1, p2)\n\n  | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->\n    Some(interTTuple(subst, tenv, tuple1, tuple2))\n\n  | (TPromise(ty1, pos1), TPromise(ty2, _)) ->\n    Some(TPromise(TType::inter(subst, tenv, ty1, ty2), pos1))\n\n  | (obj1 @ TObject _, obj2 @ TObject _) ->\n    Some(interTObject(subst, tenv, obj1, obj2))\n  | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->\n    Some(TAlgebraic::inter(subst, tenv, a1, a2))\n\n  | (f1 @ TFuns _, f2 @ TFuns _) -> TFuns::inter(subst, tenv, f1, f2)\n  | _ -> internal_error(\"Internal error\")\n  }\n}\n\nfun interTFun(subst: mutable Subst, tenv: TEnv, f1: TFun, f2: TFun): TFun {\n  if (f1.tparams.size() != f2.tparams.size()) {\n    internal_error(\"function clause sizes must match\")\n  };\n  tsubst = SortedMap[];\n  clauses = mutable Vector[];\n  for (i in Range(0, f1.tparams.size())) {\n    tparam1 = f1.tparams[i];\n    tparam2 = f2.tparams[i];\n    !tsubst[tparam2.id] = tparam1;\n    cstr = (tparam1.cstr, tparam2.cstr) match {\n    | (None(), None()) -> None()\n    | (None(), Some(x)) -> Some(x)\n    | (Some(x), None()) -> Some(x)\n    | (Some(x), Some(y)) -> Some(TType::union(subst, tenv, x, y))\n    };\n    clauses.push(tparam1 with {cstr});\n  };\n  !f2 = (mutable RenameClauses()).fun_(tsubst.chill(), f2);\n  params = mutable Vector[];\n  for (i in Range(0, f1.params.size())) {\n    params.push(TType::union(subst, tenv, f1.params[i], f2.params[i]));\n  };\n  optionalSize = min(f1.optionalParams.size(), f2.optionalParams.size());\n  optionalParams = mutable Vector[];\n  for (i in Range(0, optionalSize)) {\n    optionalParams.push(\n      TType::union(subst, tenv, f1.optionalParams[i], f2.optionalParams[i]),\n    );\n  };\n  if (f1.optionalParams.size() < f2.optionalParams.size()) {\n    for (i in Range(f1.optionalParams.size(), f2.optionalParams.size())) {\n      optionalParams.push(f2.optionalParams[i]);\n    }\n  } else if (f2.optionalParams.size() < f1.optionalParams.size()) {\n    for (i in Range(f2.optionalParams.size(), f1.optionalParams.size())) {\n      optionalParams.push(f1.optionalParams[i]);\n    }\n  };\n  totalSize1 = f1.params.size() + f1.optionalParams.size();\n  totalSize2 = f2.params.size() + f2.optionalParams.size();\n  sizeWitness = if (totalSize1 >= totalSize2) f1.minSizeWitness else {\n    f2.minSizeWitness\n  };\n  spreadParam = (f1.spreadParam, f2.spreadParam) match {\n  | (None(), None()) -> None()\n  | (ty @ Some _, None()) -> ty\n  | (None(), ty @ Some _) -> ty\n  | (Some(ty1), Some(ty2)) -> Some(TType::union(subst, tenv, ty1, ty2))\n  };\n  retType = TType::inter(subst, tenv, f1.retType, f2.retType);\n  cgNodes = f1.cgNodes.intersection(f2.cgNodes);\n  TFun(\n    clauses.toArray(),\n    params.toArray(),\n    optionalParams.toArray(),\n    spreadParam,\n    sizeWitness,\n    retType,\n    cgNodes,\n  )\n}\n\nfun interTTuple(\n  subst: mutable Subst,\n  tenv: TEnv,\n  tuple1: TTuple,\n  tuple2: TTuple,\n): TTuple {\n  result = mutable Vector[];\n  for (i in Range(0, min(tuple1.tuple.size(), tuple2.tuple.size()))) {\n    result.push(TType::inter(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]));\n  };\n  if (tuple1.tuple.size() < tuple2.tuple.size()) {\n    for (i in Range(tuple1.tuple.size(), tuple2.tuple.size())) {\n      result.push(tuple2.tuple[i]);\n    }\n  } else if (tuple2.tuple.size() < tuple1.tuple.size()) {\n    for (i in Range(tuple2.tuple.size(), tuple1.tuple.size())) {\n      result.push(tuple1.tuple[i]);\n    }\n  };\n  TTuple(result.toArray(), tuple1.pos)\n}\n\nmodule end;\n"}, {"path": "src/TTypePp.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nclass MaxSizeReached() extends Exception {\n  fun getMessage(): String {\n    \"Internal error: column max size reached\"\n  }\n}\n\nvalue class Margin(depth: Int = 0, size: Int = 0, str: String = \"\")\n\nmutable class TypePp{\n  compact: Bool,\n  mutable cols: Int = 0,\n  mutable buffer: List<String> = List[],\n} {\n  const MAX_COLS: Int = 80;\n\n  readonly fun chill(): this {\n    static{compact => this.compact, cols => this.cols, buffer => this.buffer}\n  }\n\n  mutable fun replace(saved: readonly TypePp): void {\n    this.!cols = saved.cols;\n    this.!buffer = saved.buffer;\n  }\n\n  mutable fun out(level: Int, margin: Margin, str: String): void {\n    // The string does not contain special characters\n    for (c in str) {\n      if (c == '\\n' || c == '\\r' || c == '\\t') {\n        internal_error(\"unexpected character\")\n      };\n    };\n    if (this.cols < margin.size) {\n      // The string does not start with a space\n      for (_c in str) {\n        //        if (c == ' ') internal_error(\"unexpected white space: \" + str);\n        break void;\n      };\n      this.!cols = margin.size;\n      this.!buffer = List.Cons(margin.str, this.buffer);\n    };\n    this.!cols = this.cols + str.length();\n    if (level != 0 && this.cols > static::MAX_COLS) {\n      throw MaxSizeReached()\n    };\n    this.!buffer = List.Cons(str, this.buffer);\n  }\n\n  mutable fun newLine(): void {\n    this.!cols = 0;\n    this.!buffer = List.Cons(\"\\n\", this.buffer);\n  }\n\n  mutable fun branch(\n    level: Int,\n    margin: Margin,\n    f1: (mutable this, Int, Margin) ~> void,\n    f2: (mutable this, Int, Margin, Margin) -> void,\n  ): void {\n    if (this.compact || level > 0) {\n      f1(this, level, margin);\n      return void\n    };\n    saved = this.chill();\n    try {\n      f1(this, level + 1, margin)\n    } catch {\n    | MaxSizeReached() ->\n      this.replace(saved);\n      prevMargin = margin;\n      !margin.size = margin.size + 2;\n      !margin.str = margin.str + \"  \";\n      f2(this, level, prevMargin, margin)\n    | exn -> throw (exn)\n    }\n  }\n\n  mutable fun stype(level: Int, margin: Margin, sty: SType): void {\n    sty match {\n    | TObject(fields, _) -> this.object(level, margin, fields)\n    | TPromise(ty, _) ->\n      this.branch(\n        level,\n        margin,\n        (pp, level, margin) ~> {\n          pp.out(level, margin, \"Promise<\");\n          pp.type(level, margin, ty);\n          pp.out(level, margin, \">\");\n        },\n        (pp, level, prevMargin, margin) -> {\n          pp.out(level, margin, \"Promise<\");\n          pp.newLine();\n          pp.type(level, margin, ty);\n          pp.newLine();\n          pp.out(level, prevMargin, \">\");\n          pp.newLine();\n        },\n      )\n    | TPrimUnit(k, _) -> this.out(level, margin, k.toString())\n    | TPrimValue(k, None(), _) -> this.out(level, margin, k.toString())\n    | TPrimValue(_, Some(arr), _) ->\n      this.out(level, margin, arr.values.map(x -> \"'\" + x.i1 + \"'\").join(\" | \"))\n\n    | TAlgebraic(branches, _) ->\n      this.branch(\n        level,\n        margin,\n        (pp, level, margin) ~> {\n          for (i => branch in branches) {\n            if (i != 0) pp.out(level, margin, \" | \");\n            pp.object(level, margin, branch.fields)\n          }\n        },\n        (pp, level, _prevMargin, margin) ~> {\n          pp.newLine();\n          for (branch in branches) {\n            pp.out(level, margin, \"| \");\n            pp.object(level, margin, branch.fields);\n            pp.newLine()\n          }\n        },\n      )\n    | TTuple(arr, _) -> this.tuple(level, margin, arr)\n    | TFuns(tfuns, tmethods, _) ->\n      this.tfuns(\n        level,\n        margin,\n        tfuns\n          .toArray()\n          .map(x -> (false, x))\n          .concat(tmethods.toArray().map(x -> (true, x))),\n      )\n    }\n  }\n\n  mutable fun tfuns(\n    level: Int,\n    margin: Margin,\n    tfuns: Array<(Bool, TFun)>,\n  ): void {\n    this.branch(\n      level,\n      margin,\n      (pp, level, margin) ~> {\n        for (i => tfun in tfuns) {\n          if (i != 0) pp.out(level, margin, \" | \");\n          pp.tfun(level, margin, tfun);\n        }\n      },\n      (pp, level, _, margin) ~> {\n        pp.newLine();\n        for (tfun in tfuns) {\n          pp.out(level, margin, \"| \");\n          pp.tfun(level, margin, tfun);\n          pp.newLine()\n        }\n      },\n    )\n  }\n\n  mutable fun tfun(level: Int, margin: Margin, arg: (Bool, TFun)): void {\n    (isMethod, tfun) = arg;\n    this.branch(\n      level,\n      margin,\n      (pp, level, margin) ~> {\n        if (tfun.tparams.size() != 0) {\n          pp.out(level, margin, \"<\");\n          for (i => tparam in tfun.tparams) {\n            if (i != 0) pp.out(level, margin, \", \");\n            pp.out(level, margin, tparam.name + \":\" + tparam.id);\n            tparam.cstr match {\n            | None() -> void\n            | Some(x) ->\n              pp.out(level, margin, \" extends1 \");\n              pp.type(level, margin, x)\n            }\n          };\n          pp.out(level, margin, \">\");\n        };\n        pp.out(level, margin, \"(\");\n        for (i => param in tfun.params) {\n          if (i != 0) pp.out(level, margin, \", \");\n          pp.type(level, margin, param)\n        };\n        for (i => param in tfun.optionalParams) {\n          if (tfun.params.size() != 0 || i != 0) pp.out(level, margin, \", \");\n          pp.out(level, margin, \"_?:\");\n          pp.type(level, margin, param)\n        };\n        if (isMethod) {\n          pp.out(level, margin, \"): \");\n        } else {\n          pp.out(level, margin, \") => \");\n        };\n        pp.type(level, margin, tfun.retType);\n      },\n      (pp, level, prevMargin, margin) ~> {\n        if (tfun.tparams.size() != 0) {\n          pp.out(level, margin, \"<\");\n          for (i => tparam in tfun.tparams) {\n            if (i != 0) pp.out(level, margin, \", \");\n            pp.out(level, margin, tparam.name + \":\" + tparam.id);\n            tparam.cstr match {\n            | None() -> void\n            | Some(x) ->\n              pp.out(level, margin, \" extends2 \");\n              pp.type(level, margin, x)\n            }\n          };\n          pp.out(level, margin, \">\");\n        };\n        pp.out(level, margin, \"(\");\n        pp.newLine();\n        for (param in tfun.params) {\n          pp.type(level, margin, param);\n          pp.out(level, margin, \",\");\n          pp.newLine();\n        };\n        for (param in tfun.optionalParams) {\n          pp.out(level, margin, \"_?:\");\n          pp.type(level, margin, param);\n          pp.out(level, margin, \",\");\n          pp.newLine();\n        };\n        if (isMethod) {\n          pp.out(level, prevMargin, \"): \");\n        } else {\n          pp.out(level, prevMargin, \") => \");\n        };\n        pp.type(level, margin, tfun.retType);\n      },\n    )\n  }\n\n  mutable fun tuple(level: Int, margin: Margin, values: Array<TType>): void {\n    this.out(level, margin, \"[\");\n    this.branch(\n      level,\n      margin,\n      (pp, level, margin) ~> {\n        for (i => ty in values) {\n          if (i != 0) {\n            pp.out(level, margin, \", \");\n          };\n          pp.type(level, margin, ty);\n        };\n        pp.out(level, margin, \"]\");\n      },\n      (pp, level, prevMargin, margin) -> {\n        pp.newLine();\n        for (ty in values) {\n          pp.type(level, margin, ty);\n          pp.out(level, margin, \",\");\n          pp.newLine();\n        };\n        pp.newLine();\n        pp.out(level, prevMargin, \"]\");\n        pp.newLine();\n      },\n    )\n  }\n\n  mutable fun object(level: Int, margin: Margin, fields: TFields): void {\n    this.out(level, margin, \"{\");\n    this.branch(\n      level,\n      margin,\n      (pp, level, margin) ~> {\n        pp.out(level, margin, \" \");\n        pp.fields(level, margin, fields, false);\n        pp.out(level, margin, \" }\");\n      },\n      (pp, level, prevMargin, margin) -> {\n        pp.newLine();\n        pp.fields(level, margin, fields, true);\n        pp.newLine();\n        pp.out(level, prevMargin, \"}\");\n        pp.newLine();\n      },\n    )\n  }\n\n  mutable fun fields(\n    level: Int,\n    margin: Margin,\n    fields: TFields,\n    multiLine: Bool,\n  ): void {\n    fieldArray = fields.fields;\n    indexes = fields.indexes;\n    for (i => field in fieldArray) {\n      fieldName = field.name;\n      fieldType = field.type;\n      this.out(level, margin, static::escapeName(fieldName));\n      if (field.isOptional) {\n        this.out(level, margin, \"?\")\n      };\n      this.out(level, margin, \": \");\n      this.type(level, margin, fieldType);\n      if (i != fieldArray.size() - 1 || !indexes.isEmpty()) {\n        this.out(level, margin, \",\");\n        if (multiLine) this.newLine() else {\n          this.out(level, margin, \" \")\n        };\n      }\n    };\n    for (i => index in indexes) {\n      this.out(level, margin, \"[ \");\n      this.out(level, margin, static::escapeName(index.keyName));\n      this.out(level, margin, \": \");\n      this.type(level, margin, index.keyType);\n      this.out(level, margin, \" ]: \");\n      this.type(level, margin, index.valueType);\n      if (i != indexes.size() - 1) {\n        this.out(level, margin, \",\");\n        if (multiLine) this.newLine() else {\n          this.out(level, margin, \" \")\n        }\n      }\n    }\n  }\n\n  static fun escapeName(name: String): String {\n    chars = mutable Vector[];\n    for (c in name) {\n      if (c == '\"') chars.push('\\\\');\n      chars.push(c)\n    };\n    String::fromChars(chars.toArray())\n  }\n\n  mutable fun clause(level: Int, margin: Margin, clause: Clause): void {\n    for (j => tparam in clause.vars) {\n      if (j != 0) {\n        this.out(level, margin, \" & \");\n      };\n      this.out(level, margin, tparam.name + \":\" + tparam.id);\n    };\n    clause.stypes match {\n    | None() ->\n      invariant(!clause.vars.isEmpty(), \"several clauses with a Top clause\");\n      void\n    | Some(c) ->\n      if (!clause.vars.isEmpty()) this.out(level, margin, \" extends \");\n      for (k => sty in c) {\n        if (k != 0) {\n          this.out(level, margin, \" | \");\n        };\n        this.stype(level, margin, sty);\n      }\n    }\n  }\n\n  mutable fun type(level: Int, margin: Margin, ty: TType): void {\n    !margin.depth = margin.depth + 1;\n    if (margin.depth >= 2) {\n      this.out(level, margin, \"...\");\n      return void;\n    };\n    if (ty.isTop()) {\n      this.out(level, margin, \"unknown\");\n      return void;\n    };\n    if (ty.isBottom()) {\n      this.out(level, margin, \"never\");\n      return void;\n    };\n    if (!ty.clauses.clauses.isEmpty()) {\n      for (i => clause in ty.clauses.clauses) {\n        if (i != 0) {\n          this.out(level, margin, \" | \");\n        };\n        this.clause(level, margin, clause);\n      };\n    };\n    this.branch(\n      level,\n      margin,\n      (pp, level, margin) ~> {\n        for (i => inst in ty.insts.insts) {\n          inst match {\n          | TSInst(x, targs) ->\n            if (i != 0) pp.out(level, margin, \" | \");\n            pp.out(level, margin, x.value);\n            if (targs.targs.size() != 0) {\n              pp.out(level, margin, \"<\");\n              for (j => targ in targs.targs) {\n                if (j != 0) pp.out(level, margin, \", \");\n                pp.type(level, margin, targ);\n              };\n              pp.out(level, margin, \">\");\n            }\n          | TInter(ty1, ty2) ->\n            pp.out(level, margin, \"(\");\n            pp.type(level, margin, ty1);\n            pp.out(level, margin, \")\");\n            pp.out(level, margin, \" & \");\n            pp.out(level, margin, \"(\");\n            pp.type(level, margin, ty2);\n            pp.out(level, margin, \")\")\n          | TUnion(ty1, ty2) ->\n            pp.out(level, margin, \"(\");\n            pp.type(level, margin, ty1);\n            pp.out(level, margin, \")\");\n            pp.out(level, margin, \" | \");\n            pp.out(level, margin, \"(\");\n            pp.type(level, margin, ty2);\n            pp.out(level, margin, \")\")\n          | TVar(_, id, _) -> pp.out(level, margin, \"'\" + id)\n          }\n        }\n      },\n      (pp, level, _prevMargin, margin) ~> {\n        for (inst in ty.insts.insts) {\n          pp.buffer match {\n          | List.Nil()\n          | List.Cons(\"\\n\", _) ->\n            void\n          | _ -> pp.newLine()\n          };\n          inst match {\n          | TSInst(x, targs) ->\n            pp.out(level, margin, x.value);\n            if (targs.targs.size() != 0) {\n              pp.out(level, margin, \"<\");\n              for (i => targ in targs.targs) {\n                if (i != 0) pp.out(level, margin, \", \");\n                pp.type(level, margin, targ);\n              };\n              pp.out(level, margin, \">\");\n            }\n          | TInter(ty1, ty2) ->\n            pp.type(level, margin, ty1);\n            pp.out(level, margin, \" & \");\n            pp.type(level, margin, ty2)\n          | TUnion(ty1, ty2) ->\n            pp.type(level, margin, ty1);\n            pp.out(level, margin, \" | \");\n            pp.type(level, margin, ty2)\n          | TVar(_, id, _) -> pp.out(level, margin, \"'\" + id)\n          }\n        }\n      },\n    );\n  }\n}\n\nfun prettyPrint(compact: Bool, f: mutable TypePp -> void): String {\n  pp = mutable TypePp{compact};\n  f(pp);\n  strings = pp.buffer.reversed();\n  if (compact) {\n    !strings = strings.map(str ~> {\n      String::fromChars(\n        str\n          .getIter()\n          .filter(c ~> c != '\\t' && c != '\\n' && c != ' ')\n          .collect(Array),\n      )\n    })\n  };\n  result = \"\".join(strings);\n  result\n}\n\nfun prettyPrintType(compact: Bool, ty: TType): String {\n  prettyPrint(compact, pp -> {\n    pp.type(0, Margin(), ty);\n  })\n}\n\nfun prettyPrintSType(stype: SType, compact: Bool = false): String {\n  prettyPrintType(compact, TType::single(stype))\n}\n\nfun prettyPrintClause(clause: Clause, compact: Bool = false): String {\n  if (clause.isTop()) {\n    prettyPrint(compact, pp -> pp.out(0, Margin(), \"unknown\"))\n  } else {\n    prettyPrint(compact, pp -> {\n      pp.clause(0, Margin(), clause);\n    })\n  }\n}\n\nmodule end;\n"}, {"path": "src/TTypeSubst.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Class that maintains the environment for type variables. */\n/***************************************************************************/\n\nmodule SKJS;\n\nbase class SubstValue {\n  children =\n  | SVOpen(TType)\n  | SVClosed(TType)\n}\n\nclass SavedSubst{version: Int, values: SortedMap<Int, SubstValue>}\n\nmutable class Subst private {\n  context: mutable SKStore.Context,\n  mutable seenSub: SortedSet<(TType, TType)> = SortedSet[],\n  mutable seenInter: SortedMap<(TType, TType), TType> = SortedMap[],\n  mutable seenUnion: SortedMap<(TType, TType), TType> = SortedMap[],\n  mutable version: Int = 0,\n  private mutable values: SortedMap<Int, SubstValue> = SortedMap[],\n} {\n  /* To ensure consistency in type variable identifiers, use mcreate only\n     in functions that take no argument containing type variables and whose\n     return value does not contain type variables. */\n  static fun mcreate{context: mutable SKStore.Context}: mutable this {\n    mutable static{context}\n  }\n\n  /* Use Subst#clone to create a temporary subst when there is already\n     one that shouldn't be polluted.\n     One would typically do this to check subtyping relations that are\n     non-mandatory. */\n  mutable fun clone(): mutable this {\n    mutable static{\n      context => this.context,\n      seenSub => this.seenSub,\n      seenInter => this.seenInter,\n      seenUnion => this.seenUnion,\n      version => this.version,\n      values => this.values,\n    }\n  }\n\n  readonly fun save(): SavedSubst {\n    SavedSubst{version => this.version, values => this.values}\n  }\n\n  mutable fun restore(saved: SavedSubst): void {\n    this.!version = saved.version;\n    this.!values = saved.values;\n  }\n\n  mutable fun grow(\n    tenv: TEnv,\n    tvar: TVar,\n    ty: TType,\n    variance: Variance,\n  ): void {\n    newTy = this.values.maybeGet(tvar.id) match {\n    | None() -> ty\n    | Some(SVClosed(_)) -> return void\n    | Some(SVOpen(ty2)) ->\n      newTy = TType::union(this, tenv, ty2, ty);\n      if (newTy == ty2) return void;\n      newTy\n    };\n    this.!version = this.version + 1;\n    this.!values[tvar.id] = variance match {\n    | Contravariant() -> SVOpen(newTy)\n    | Covariant() -> SVClosed(newTy)\n    }\n  }\n\n  mutable fun get(tenv: TEnv, tvar: TVar, variance: Variance): TType {\n    result = variance match {\n    | Covariant() ->\n      this.values.maybeGet(tvar.id) match {\n      | None() -> SVOpen(TType::bottom(tvar.pos))\n      | Some(sv) -> sv\n      } match {\n      | SVOpen(ty) ->\n        this.!version = this.version + 1;\n        this.!values[tvar.id] = SVClosed(ty);\n        ty\n      | SVClosed(ty) -> ty\n      }\n    | Contravariant() ->\n      this.values.maybeGet(tvar.id) match {\n      | None() -> TType::bottom(tvar.pos)\n      | Some(SVOpen(ty))\n      | Some(SVClosed(ty)) ->\n        ty\n      }\n    };\n    for (cstr in tvar.constraints) {\n      !result = TType::inter(this, tenv, result, cstr);\n    };\n    result\n  }\n\n  mutable fun gen(pos: PosRange): TVar {\n    id = this.version;\n    this.!version = this.version + 1;\n    TVar::create(pos, id)\n  }\n\n  readonly fun isOpen(tvar: TVar): Bool {\n    this.values.maybeGet(tvar.id) match {\n    | Some(SVOpen _) -> true\n    | _ -> false\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/TTypeSubtyping.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// Subtyping operations for types.\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class TAlgebraic {\n  static fun isSub(\n    subst: mutable Subst,\n    tenv: TEnv,\n    a1: TAlgebraic,\n    a2: TAlgebraic,\n  ): STResult {\n    a1.branches.leq(a2.branches, (b1, b2O) ->\n      b2O match {\n      | Some(b2) ->\n        TConstr::isSub(subst, tenv, b1, b2) match {\n        | STOk() -> Success(void)\n        | err @ STError _ -> Failure(err)\n        }\n      | None() -> Failure(STTooManyTConstr(b1))\n      }\n    ) match {\n    | Success(void) -> STOk()\n    | Failure(err) -> err\n    }\n  }\n}\n\nextension class TConstr {\n  static fun isSub(\n    subst: mutable Subst,\n    tenv: TEnv,\n    x: this,\n    y: this,\n  ): STResult {\n    TFields::isSub(subst, tenv, x.fields, y.fields)\n  }\n}\n\nextension class TFuns {\n  private static fun isSubTFun(\n    subst: mutable Subst,\n    tenv: TEnv,\n    f1: TFun,\n    f2O: ?TFun,\n  ): Result<void, STError> {\n    f2O match {\n    | Some(f2) ->\n      isSubTFun(subst, tenv, f1, f2) match {\n      | STOk() -> Success(void)\n      | err @ STError _ -> Failure(err)\n      }\n    | None() -> Failure(STTooManyTFun(f1))\n    }\n  }\n\n  static fun isSub(\n    subst: mutable Subst,\n    tenv: TEnv,\n    funs1: TFuns,\n    funs2: TFuns,\n  ): STResult {\n    funs1.funs.leq(funs2.funs, (x, y) ->\n      static::isSubTFun(subst, tenv, x, y)\n    ) match {\n    | Failure(err) -> err\n    | Success(void) ->\n      funs1.methods.leq(funs2.methods, (x, y) ->\n        static::isSubTFun(subst, tenv, x, y)\n      ) match {\n      | Failure(err) -> err\n      | Success(void) -> (STOk() : STResult)\n      }\n    }\n  }\n}\n\nextension class TFields {\n  static fun isSub(\n    subst: mutable Subst,\n    tenv: TEnv,\n    fields1: TFields,\n    fields2: TFields,\n  ): STResult {\n    index1o = fields1.maybeSingleIndex();\n    index2o = fields2.maybeSingleIndex();\n    (index1o, index2o) match {\n    | (_, None()) -> void\n    | (Some(index1), Some(index2)) ->\n      isSubTType(subst, tenv, index2.keyType, index1.keyType) match {\n      | err @ STError _ -> return err\n      | STOk() -> void\n      };\n      isSubTType(subst, tenv, index1.valueType, index2.valueType) match {\n      | err @ STError _ -> return err\n      | STOk() -> void\n      }\n    | (None(), Some(index2)) ->\n      for (f1 in fields1.fields) {\n        f1keyType = TType::single(\n          TPrimValue::single(TString(), f1.name, f1.pos),\n        );\n        isSubTType(subst.clone(), tenv, f1keyType, index2.keyType) match {\n        | STError _ -> void\n        | STOk() ->\n          isSubTType(subst, tenv, f1.type, index2.valueType) match {\n          | err @ STError _ -> return err\n          | STOk() -> void\n          }\n        }\n      }\n    };\n    for (f1of2o in fields1.fields.iterDiffInterDiff(fields2.fields)) {\n      f1of2o match {\n      | (_, None()) -> void\n      | (None(), Some(f2)) ->\n        if (!f2.isOptional) {\n          return STMissingField(f2.name)\n        };\n        index1o match {\n        | None() -> void\n        | Some(index1) ->\n          f2keyType = TType::single(\n            TPrimValue::single(TString(), f2.name, f2.pos),\n          );\n          isSubTType(subst.clone(), tenv, f2keyType, index1.keyType) match {\n          | STError _ -> void\n          | STOk() ->\n            isSubTType(subst, tenv, index1.valueType, f2.type) match {\n            | err @ STError _ -> return err\n            | STOk() -> void\n            }\n          }\n        }\n      | (Some(f1), Some(f2)) ->\n        if (f1.isOptional && !f2.isOptional) {\n          return STMissingField(f1.name)\n        } else {\n          f2type = if (f2.isOptional) {\n            f2.type.unionUndefined(subst, tenv, f2.pos)\n          } else {\n            f2.type\n          };\n          isSubTType(subst, tenv, f1.type, f2type) match {\n          | STOk() -> void\n          | err @ STError _ -> return err\n          }\n        }\n      }\n    };\n    STOk()\n  }\n}\n\nextension class STypes {\n  static fun isSub(\n    subst: mutable Subst,\n    tenv: TEnv,\n    stypes1: STypes,\n    stypes2: STypes,\n  ): STResult {\n    stypes1.stypes.leq(stypes2.stypes, (t1, t2O) ->\n      t2O match {\n      | Some(t2) ->\n        isSubSType(subst, tenv, t1, t2) match {\n        | STOk() -> Success(void)\n        | err @ STError _ -> Failure(err)\n        }\n      | None() -> Failure(STTooManySType(t1))\n      }\n    ) match {\n    | Success(void) -> STOk()\n    | Failure(err) -> err\n    }\n  }\n}\n\nextension class Clauses {\n  static fun isSub(\n    subst: mutable Subst,\n    tenv: TEnv,\n    clauses1: Clauses,\n    clauses2: Clauses,\n  ): STResult {\n    for (inter1 in clauses1.clauses) {\n      errors = List[];\n      for (inter2 in clauses2.clauses) {\n        if (!inter1.vars.contains(inter2.vars)) {\n          continue;\n        };\n        (inter1.stypes, inter2.stypes) match {\n        | (None(), None()) -> break void\n        | (Some _, None()) -> break void\n        | (None(), Some _) -> continue\n        | (Some(x1), Some(x2)) ->\n          STypes::isSub(subst, tenv, x1, x2) match {\n          | STOk() -> break void\n          | err @ STError _ ->\n            !errors = List.Cons(err, errors);\n            continue\n          }\n        }\n      } else {\n        return errors match {\n        | List.Cons(err, List.Nil()) -> err\n        | _ -> STInvalidClause(inter1)\n        }\n      }\n    };\n    STOk()\n  }\n}\n\nfun isSubTType(\n  subst: mutable Subst,\n  tenv: TEnv,\n  u1: TType,\n  u2: TType,\n): STResult {\n  if (u1 == u2) return STOk();\n  pair = (u1, u2);\n  if (subst.seenSub.contains(pair)) return STOk();\n  res = isSubTType_(subst, tenv, u1, u2);\n  if (res is STOk()) {\n    subst.!seenSub = subst.seenSub.set(pair)\n  };\n  res\n}\n\nfun isSubTType_(\n  subst: mutable Subst,\n  tenv: TEnv,\n  u1: TType,\n  u2: TType,\n): STResult {\n  if (u2.isTop()) return STOk();\n  if (tenv.seenSub.contains((subst.version, u1, u2))) return STOk();\n  !tenv.seenSub = tenv.seenSub.set((subst.version, u1, u2));\n  savedSubst = subst.save();\n  for (inst in u2.insts) {\n    inst match {\n    | tvar @ TVar(_, _, constraints) ->\n      for (_ => cstr in constraints) {\n        status = isSubTType(subst, tenv, u1, cstr);\n        if (status is STError _) return status;\n      };\n      subst.grow(tenv, tvar, u1.diff(u2), Contravariant())\n    | _ -> void\n    }\n  };\n  for (inst in u1.insts) {\n    inst match {\n    | tvar @ TVar(_, _, constraints) ->\n      if ({\n        substCopy = subst.save();\n        for (_ => cstr in constraints) {\n          status = isSubTType(subst, tenv, u2, cstr);\n          if (status is STError _) {\n            subst.restore(substCopy);\n            break false\n          }\n        } else {\n          true\n        }\n      }) subst.grow(tenv, tvar, u2.diff(u1), Covariant())\n    | _ -> void\n    }\n  };\n  clauses1 = u1.expand_(subst, tenv, Covariant());\n  clauses2 = u2.expand_(subst, tenv, Contravariant());\n  Clauses::isSub(subst, tenv, clauses1, clauses2) match {\n  | STOk() -> STOk()\n  | err @ STRec _ ->\n    subst.restore(savedSubst);\n    err\n  | other @ STTooManySType(stype) ->\n    subst.restore(savedSubst);\n    STRec(other, stype.pos, u2)\n  | other @ STError _ ->\n    subst.restore(savedSubst);\n    STRec(other, u1.pos, u2)\n  }\n}\n\nfun isSubSType(\n  subst: mutable Subst,\n  tenv: TEnv,\n  sty1: SType,\n  sty2: SType,\n): STResult {\n  (sty1, sty2) match {\n  | (TPrimUnit(_, _), TPrimUnit(_, _)) -> STOk()\n\n  | (TPrimValue(_, None(), _), TPrimValue(_, None(), _)) -> STOk()\n  | (TPrimValue(_, None(), _), TPrimValue(_, Some _, _)) -> STTooManySType(sty1)\n  | (TPrimValue(_, Some _, _), TPrimValue(_, None(), _)) -> STOk()\n\n  | (TPrimValue(k, Some(s1), _), TPrimValue(_, Some(s2), _)) ->\n    for (elt in s1.values) {\n      if (!s2.contains(elt.i1)) {\n        break STTooManySType(\n          TPrimValue(k, Some(ArrayValues::single(elt)), elt.i0),\n        )\n      }\n    } else {\n      STOk()\n    }\n\n  | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->\n    isSubTTuple(subst, tenv, tuple1, tuple2)\n\n  | (TPromise(ty1, _), TPromise(ty2, _)) -> isSubTType(subst, tenv, ty1, ty2)\n  | (funs1 @ TFuns _, funs2 @ TFuns _) ->\n    TFuns::isSub(subst, tenv, funs1, funs2)\n  | (obj1 @ TObject _, obj2 @ TObject _) ->\n    isSubTObject(subst, tenv, obj1, obj2)\n  | (TAlgebraic _, TObject _)\n  | (TObject _, TAlgebraic _) ->\n    STTooManySType(sty1)\n  | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->\n    TAlgebraic::isSub(subst, tenv, a1, a2)\n  | _ -> internal_error(\"Internal error\")\n  }\n}\n\nfun isSubTTuple(\n  subst: mutable Subst,\n  tenv: TEnv,\n  tuple1: TTuple,\n  tuple2: TTuple,\n): STResult {\n  if (tuple1.tuple.size() < tuple2.tuple.size()) {\n    return STTooManySType(tuple1)\n  };\n  for (i in Range(0, tuple2.tuple.size())) {\n    isSubTType(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]) match {\n    | STOk() -> void\n    | err @ STError _ -> return err\n    }\n  };\n  STOk()\n}\n\nfun isSubTFun(subst: mutable Subst, tenv: TEnv, f1: TFun, f2: TFun): STResult {\n  if (f1.tparams.size() != f2.tparams.size()) {\n    internal_error(\"function clause sizes must match\")\n  };\n  tsubst = SortedMap[];\n  for (i in Range(0, f1.tparams.size())) {\n    tparam1 = f1.tparams[i];\n    tparam2 = f2.tparams[i];\n    (tparam1.cstr, tparam2.cstr) match {\n    | (None(), None()) -> void\n    | (Some _, None()) -> void\n    | (None(), Some _) -> return STNoConstraint()\n    | (Some(ty1), Some(ty2)) ->\n      isSubTType(subst, tenv, ty2, ty1) match {\n      | STOk() -> void\n      | err @ STError _ -> return err\n      }\n    };\n    !tsubst[tparam2.id] = tparam1;\n  };\n  !f2 = (mutable RenameClauses()).fun_(tsubst, f2);\n  params1 = f1.params;\n  params2 = f2.params;\n  for (i in Range(0, params1.size())) {\n    isSubTType(subst, tenv, params2[i], params1[i]) match {\n    | STOk() -> void\n    | err @ STError _ -> return err\n    }\n  };\n  f2.spreadParam match {\n  | None() -> void\n  | Some(spread2) ->\n    f1.spreadParam match {\n    | None() -> return STMissingSpread()\n    | Some(spread1) ->\n      isSubTType(subst, tenv, spread1, spread2) match {\n      | STOk() -> void\n      | err @ STError _ -> return err\n      }\n    }\n  };\n  isSubTType(subst, tenv, f1.retType, f2.retType)\n}\n\nfun isSubTObject(\n  subst: mutable Subst,\n  tenv: TEnv,\n  obj1: TObject,\n  obj2: TObject,\n): STResult {\n  TFields::isSub(subst, tenv, obj1.fields, obj2.fields)\n}\n\nmodule end;\n"}, {"path": "src/TTypeTransformers.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Type transformation class. */\n/***************************************************************************/\n\nmodule SKJS;\n\nmutable base class ApplyType(\n  visiting: SortedSet<TType> = SortedSet[],\n  mutable seen: SortedMap<TType, TType> = SortedMap[],\n) {\n  type Env;\n\n  overridable deferred mutable fun type(env: this::Env, ty: TType): TType {\n    if (this.visiting.contains(ty)) {\n      internal_error(\"Found a Cyclic type in ApplyType\");\n    };\n    this.seen.maybeGet(ty) match {\n    | None() ->\n      !this.visiting = this.visiting.set(ty);\n      result = this.type_(env, ty);\n      this.!seen[ty] = result;\n      result\n    | Some(x) -> x\n    }\n  }\n\n  overridable deferred mutable fun type_(env: this::Env, ty: TType): TType {\n    ty.rawMap(\n      (insts) -> this.insts(env, insts),\n      (clauses) -> this.clauses(env, clauses),\n    )\n  }\n\n  overridable deferred mutable fun clauses(\n    env: this::Env,\n    clauses: Clauses,\n  ): Clauses {\n    clauses.map(c -> this.clause(env, c))\n  }\n\n  overridable deferred mutable fun clause(\n    env: this::Env,\n    clause: Clause,\n  ): ?Clause {\n    clause.map(x -> this.typeParam(env, x), x -> this.stypes(env, x))\n  }\n\n  overridable deferred mutable fun typeParamWithConstraint(\n    env: this::Env,\n    tparam: TParamWithConstraint,\n  ): TParamWithConstraint {\n    TParamWithConstraint(\n      tparam.name,\n      tparam.fileName,\n      tparam.id,\n      tparam.cstr.map(c -> this.type(env, c)),\n    )\n  }\n\n  overridable deferred mutable fun typeParam(\n    _env: this::Env,\n    tparam: TParam,\n  ): TParam {\n    TParam(tparam.name, tparam.fileName, tparam.id)\n  }\n\n  overridable deferred mutable fun stypes(\n    env: this::Env,\n    stypes: STypes,\n  ): STypes {\n    stypes.map(stype -> this.stype(env, stype))\n  }\n\n  overridable deferred mutable fun stype(env: this::Env, stype: SType): SType {\n    stype match {\n    | x @ TPrimUnit _\n    | x @ TPrimValue _ ->\n      x\n    | TPromise(ty, pos) -> TPromise(this.type(env, ty), pos)\n    | algs @ TAlgebraic _ -> this.algebraic(env, algs)\n    | funs @ TFuns _ -> this.funs(env, funs)\n    | obj @ TObject _ -> this.object(env, obj)\n    | tuples @ TTuple _ -> this.tuple(env, tuples)\n    }\n  }\n\n  overridable deferred mutable fun algebraic(\n    env: this::Env,\n    algebraic: TAlgebraic,\n  ): TAlgebraic {\n    TAlgebraic(algebraic.branches.map(x -> this.constr(env, x)), algebraic.pos)\n  }\n\n  overridable deferred mutable fun constr(\n    env: this::Env,\n    constr: TConstr,\n  ): TConstr {\n    constr.map(fields -> this.fields(env, fields))\n  }\n\n  overridable deferred mutable fun object(\n    env: this::Env,\n    object: TObject,\n  ): TObject {\n    TObject(this.fields(env, object.fields), object.pos)\n  }\n\n  overridable deferred mutable fun funs(env: this::Env, funs: TFuns): TFuns {\n    funs.mapFuns(x -> this.fun_(env, x))\n  }\n\n  overridable deferred mutable fun fun_(env: this::Env, f: TFun): TFun {\n    TFun(\n      f.tparams.map(x -> this.typeParamWithConstraint(env, x)),\n      f.params.map(x -> this.type(env, x)),\n      f.optionalParams.map(x -> this.type(env, x)),\n      f.spreadParam.map(x -> this.type(env, x)),\n      f.minSizeWitness,\n      this.type(env, f.retType),\n      f.cgNodes,\n    )\n  }\n\n  overridable deferred mutable fun fields(\n    env: this::Env,\n    fields: TFields,\n  ): TFields {\n    fields.map(x -> this.field(env, x), x -> this.indexField(env, x))\n  }\n\n  overridable deferred mutable fun field(\n    env: this::Env,\n    field: TField,\n  ): TField {\n    field.mapType(ty -> this.type(env, ty))\n  }\n\n  overridable deferred mutable fun indexField(\n    env: this::Env,\n    indexField: TIndexField,\n  ): TIndexField {\n    indexField.mapTypes(ty -> this.type(env, ty))\n  }\n\n  overridable deferred mutable fun tuple(\n    env: this::Env,\n    tuple: TTuple,\n  ): TTuple {\n    TTuple(tuple.tuple.map(x -> this.type(env, x)), tuple.pos)\n  }\n\n  overridable deferred mutable fun insts(\n    env: this::Env,\n    insts: TInsts,\n  ): TInsts {\n    insts.map(x -> this.inst(env, x))\n  }\n\n  overridable deferred mutable fun inst(env: this::Env, inst: TInst): TInst {\n    inst match {\n    | TSInst(name, targs) -> TSInst(name, this.targs(env, targs))\n    | TInter(ty1, ty2) ->\n      TInter::create(this.type(env, ty1), this.type(env, ty2))\n    | TUnion(ty1, ty2) ->\n      TUnion::create(this.type(env, ty1), this.type(env, ty2))\n    | tvar @ TVar _ -> tvar.mapConstraints(ty -> this.type(env, ty))\n    }\n  }\n\n  overridable deferred mutable fun targs(env: this::Env, targs: TArgs): TArgs {\n    TArgs(targs.targs.map(x -> this.type(env, x)))\n  }\n}\n\nmutable class RenameClauses() extends ApplyType {\n  type Env = SortedMap<Id, TParamWithConstraint>;\n  mutable fun typeParamWithConstraint(\n    subst: this::Env,\n    tparam: TParamWithConstraint,\n  ): TParamWithConstraint {\n    if (subst.containsKey(tparam.id)) {\n      subst[tparam.id]\n    } else {\n      tparam\n    }\n  }\n\n  mutable fun typeParam(subst: this::Env, tparam: TParam): TParam {\n    if (subst.containsKey(tparam.id)) {\n      newTParam = subst[tparam.id];\n      TParam(newTParam.name, newTParam.fileName, newTParam.id)\n    } else {\n      tparam\n    }\n  }\n}\n\nmutable class FilterType() extends ApplyType {\n  type Env = (SType ~> Bool, SType ~> SType);\n\n  mutable fun insts(_env: this::Env, insts: TInsts): TInsts {\n    insts\n  }\n\n  mutable fun stypes(env: this::Env, stypes: STypes): STypes {\n    stypes.filterMap(x -> if (env.i0(x)) Some(env.i1(x)) else None())\n  }\n}\n\nmutable class Instantiate() extends ApplyType {\n  type Env = (mutable Subst, TEnv, SortedMap<Id, TType>);\n\n  mutable fun type_(env: this::Env, ty: TType): TType {\n    !ty = ty.rawMap(\n      (insts) -> this.insts(env, insts),\n      (clauses) -> this.clauses(env, clauses),\n    );\n    (subst, tenv, map) = env;\n    ty.mapTParams(subst, tenv, (tparam) -> map.maybeGet(tparam.id))\n  }\n}\n\nmutable class ExpandTVars() extends ApplyType {\n  type Env = (mutable Subst, TEnv);\n\n  mutable fun type_(env: this::Env, ty: TType): TType {\n    !ty = ty.rawMap(\n      (insts) -> this.insts(env, insts),\n      (clauses) -> this.clauses(env, clauses),\n    );\n    (subst, tenv) = env;\n    ty.expand(subst, tenv, Covariant());\n  }\n}\n\nfun expandTVars(subst: mutable Subst, tenv: TEnv, ty: TType): TType {\n  (mutable ExpandTVars()).type((subst, tenv), ty)\n}\n\nmodule end;\n"}, {"path": "src/TTypeUnion.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n// Union operations for types.\n/***************************************************************************/\n\nmodule SKJS;\n\nextension class TType {\n  // Unexpanded union.\n  static private fun unexpandedUnion(t1: TType, t2: TType): this {\n    u = TUnion::create(t1, t2);\n    static::create(t1.pos, TInsts::single(u), Clauses::empty())\n  }\n\n  fun unionUndefined(subst: mutable Subst, tenv: TEnv, pos: PosRange): this {\n    undef = static::single(TPrimUnit(TUndefined(), pos));\n    static::union(subst, tenv, this, undef)\n  }\n\n  static fun union(\n    subst: mutable Subst,\n    tenv: TEnv,\n    ty1: this,\n    ty2: this,\n  ): this {\n    if (ty1 == ty2) return ty1;\n    subst.seenUnion.maybeGet((ty1, ty2)) match {\n    | None() ->\n      result = static::union_(subst, tenv, ty1, ty2);\n      subst.!seenUnion[(ty1, ty2)] = result;\n      result\n    | Some(ty) -> ty\n    }\n  }\n\n  private static fun union_(\n    subst: mutable Subst,\n    tenv: TEnv,\n    ty1: this,\n    ty2: this,\n  ): this {\n    if (ty1.isTop() || ty2.isBottom()) return ty1;\n    if (ty2.isTop() || ty1.isBottom()) return ty2;\n    if (tenv.seenUnion.contains((ty1, ty2))) {\n      return static::unexpandedUnion(ty1, ty2);\n    };\n    !tenv.seenUnion = tenv.seenUnion.set((ty1, ty2));\n\n    types = TInsts::union(ty1.insts, ty2.insts);\n    clauses = Clauses::union(subst, tenv, ty1.clauses, ty2.clauses);\n    static::create(ty1.pos, types, clauses)\n  }\n}\n\nextension class TAlgebraic {\n  static fun union(\n    subst: mutable Subst,\n    tenv: TEnv,\n    a1: TAlgebraic,\n    a2: TAlgebraic,\n  ): TAlgebraic {\n    static(\n      a1.branches.mapUnion(a2.branches, (x, y) ->\n        TConstr::union(subst, tenv, x, y)\n      ),\n      a1.pos,\n    )\n  }\n}\n\nextension class TConstr {\n  static fun union(subst: mutable Subst, tenv: TEnv, x: this, y: this): this {\n    invariant(x.tag == y.tag);\n    static(x.tag, x.tagPos, unionTFields(subst, tenv, x.fields, y.fields))\n  }\n}\n\nextension class TFuns {\n  static fun union(\n    subst: mutable Subst,\n    tenv: TEnv,\n    f1: TFuns,\n    f2: TFuns,\n  ): TFuns {\n    static(\n      f1.funs.mapUnion(f2.funs, (x, y) -> unionTFun(subst, tenv, x, y)),\n      f1.methods.mapUnion(f2.methods, (x, y) -> unionTFun(subst, tenv, x, y)),\n      f1.pos,\n    )\n  }\n}\n\nextension class TField {\n  static fun union(subst: mutable Subst, tenv: TEnv, x: this, y: this): this {\n    if (x.name != y.name) internal_error(\"field names must match\");\n    static(\n      x.pos,\n      x.name,\n      x.isOptional || y.isOptional,\n      TType::union(subst, tenv, x.type, y.type),\n    )\n  }\n}\n\nextension class TIndexField {\n  static fun union(subst: mutable Subst, tenv: TEnv, x: this, y: this): ?this {\n    /* Currently over-approximating by a union\n       for { [f: 0 | 1]: 4 | 5 } | { [g: 1 | 2]: 5 | 6 },\n       the result would be { [f: 0]: 4 | 5, [fg: 1]: 4 | 5 | 6, [g: 2]: 5 | 6}\n       but we return { [f: 0 | 1 | 2]: 4 | 5 | 6 } */\n    valueType = TType::union(subst, tenv, x.valueType, y.valueType);\n    keyType = TType::union(subst, tenv, x.keyType, y.keyType);\n    Some(static(x.pos, x.keyName, keyType, valueType))\n  }\n}\n\nextension class STypes {\n  static fun union(\n    subst: mutable Subst,\n    tenv: TEnv,\n    stypes1: STypes,\n    stypes2: STypes,\n  ): STypes {\n    static(\n      stypes1.stypes.mapUnion(stypes2.stypes, (x, y) ->\n        unionSType(subst, tenv, x, y)\n      ),\n    )\n  }\n}\n\n/* Unexpanded union */\n//\n// Interpretation:\n// \u301a union \u301b = \u301a union.ty1 \u301b \\/ \u301a union.ty2 \u301b\nclass TUnion private (ty1: TType, ty2: TType) extends TInst {\n  static fun create(ty1: TType, ty2: TType): this {\n    if (ty1.isBottom() || ty2.isBottom() || ty1.isTop() || ty2.isTop()) {\n      internal_error(`Unexpected Bottom or Top in TUnion: ${ty1} union ${ty2}`)\n    };\n    static(ty1, ty2)\n  }\n\n  fun hash(): Int {\n    (this.ty1.hash(), this.ty2.hash()).hash()\n  }\n}\n\nextension class TInsts {\n  static fun union(insts1: this, insts2: this): this {\n    static(\n      mapUnion(insts1.values(), insts2.values(), x ~> x, x ~> x, (x, _) ~> x),\n    )\n  }\n}\n\nextension class Clause {\n  fun union(subst: mutable Subst, tenv: TEnv, other: Clause): Clause {\n    if (this.vars != other.vars) {\n      internal_error(\"clause vars must be equal for union\")\n    };\n    stypesOpt = (this.stypes, other.stypes) match {\n    | (None(), _)\n    | (_, None()) ->\n      None()\n    | (Some(x), Some(y)) -> Some(STypes::union(subst, tenv, x, y))\n    };\n    Clause(this.vars, stypesOpt)\n  }\n}\n\nextension class Clauses {\n  static fun union(\n    subst: mutable Subst,\n    tenv: TEnv,\n    clauses1: Clauses,\n    clauses2: Clauses,\n  ): Clauses {\n    static::create(\n      clauses1.clauses.mapUnion(clauses2.clauses, (x, y) ->\n        x.union(subst, tenv, y)\n      ),\n    )\n  }\n}\n\nextension class TPrimValue {\n  static fun union(t1: this, t2: this): this {\n    if (t1.kind != t2.kind) {\n      invariant_violation(\n        \"Union must be called on primitive value types of same kind\",\n      )\n    };\n    (t1.values, t2.values) match {\n    | (None(), _) -> t1\n    | (Some _, None()) -> t2\n    | (Some(s1), Some(s2)) ->\n      u = s1.union(s2);\n      v = if (t1.kind == TBool() && u.size() >= 2) None() else Some(u);\n      static(t1.kind, v, t1.pos)\n    }\n  }\n}\n\n/***************************************************************************/\n/* Unions. */\n/***************************************************************************/\n\nfun unionTFields(\n  subst: mutable Subst,\n  tenv: TEnv,\n  fields1: TFields,\n  fields2: TFields,\n): TFields {\n  (noMatch1, noMatch2, fields) = mapInter(\n    fields1.values(),\n    fields2.values(),\n    x ~> x.name,\n    (x, y) -> TField::union(subst, tenv, x, y),\n  );\n  !fields = fields\n    .concat(noMatch1.map(x -> x.withOptional()))\n    .concat(noMatch2.map(x -> x.withOptional()))\n    .sortedBy(x ~> x.name);\n  // TODO: handle intersection between normal fields and index fields\n  indexes = {\n    index1o = fields1.maybeSingleIndex();\n    index2o = fields2.maybeSingleIndex();\n    (index1o, index2o) match {\n    | (None(), None()) -> None()\n    | (Some(index), None())\n    | (None(), Some(index)) ->\n      Some(index)\n    | (Some(index1), Some(index2)) ->\n      TIndexField::union(subst, tenv, index1, index2)\n    } match {\n    | None() -> Array[]\n    | Some(index) -> Array[index]\n    }\n  };\n  TFields::create(fields, indexes)\n}\n\nfun unionTObject(\n  subst: mutable Subst,\n  tenv: TEnv,\n  obj1: TObject,\n  obj2: TObject,\n): TObject {\n  TObject(unionTFields(subst, tenv, obj1.fields, obj2.fields), obj1.pos)\n}\n\nfun unionSType(\n  subst: mutable Subst,\n  tenv: TEnv,\n  sty1: SType,\n  sty2: SType,\n): SType {\n  (sty1, sty2) match {\n  | (TPrimUnit(_, _), TPrimUnit(_, _)) -> sty1\n\n  | (p1 @ TPrimValue _, p2 @ TPrimValue _) -> TPrimValue::union(p1, p2)\n\n  | (TPromise(ty1, pos), TPromise(ty2, _)) ->\n    TPromise(TType::union(subst, tenv, ty1, ty2), pos)\n  | (tuple1 @ TTuple _, tuple2 @ TTuple _) ->\n    unionTTuple(subst, tenv, tuple1, tuple2)\n  | (obj1 @ TObject _, obj2 @ TObject _) ->\n    unionTObject(subst, tenv, obj1, obj2)\n  | (a1 @ TAlgebraic _, a2 @ TAlgebraic _) ->\n    TAlgebraic::union(subst, tenv, a1, a2)\n  | (f1 @ TFuns _, f2 @ TFuns _) -> TFuns::union(subst, tenv, f1, f2)\n  | _ -> internal_error(\"Internal error\")\n  }\n}\n\nfun unionTFun(subst: mutable Subst, tenv: TEnv, f1: TFun, f2: TFun): TFun {\n  if (f1.tparams.size() != f2.tparams.size()) {\n    internal_error(\"function clause sizes must match\")\n  };\n  tsubst = SortedMap[];\n  clauses = mutable Vector[];\n  for (i in Range(0, f1.tparams.size())) {\n    tparam1 = f1.tparams[i];\n    tparam2 = f2.tparams[i];\n    !tsubst[tparam2.id] = tparam1;\n    cstr = (tparam1.cstr, tparam2.cstr) match {\n    | (None(), None()) -> None()\n    | (None(), Some(x)) -> Some(x)\n    | (Some(x), None()) -> Some(x)\n    | (Some(x), Some(y)) -> Some(TType::inter(subst, tenv, x, y))\n    };\n    clauses.push(tparam1 with {cstr});\n  };\n  !f2 = (mutable RenameClauses()).fun_(tsubst, f2);\n  params = mutable Vector[];\n  for (i in Range(0, f1.params.size())) {\n    params.push(TType::inter(subst, tenv, f1.params[i], f2.params[i]));\n  };\n  optionalParams = mutable Vector[];\n  for (i in Range(0, min(f1.optionalParams.size(), f2.optionalParams.size()))) {\n    optionalParams.push(\n      TType::inter(subst, tenv, f1.optionalParams[i], f2.optionalParams[i]),\n    );\n  };\n  spreadParam = (f1.spreadParam, f2.spreadParam) match {\n  | (Some(ty1), Some(ty2)) -> Some(TType::inter(subst, tenv, ty1, ty2))\n  | _ -> None()\n  };\n  retType = TType::union(subst, tenv, f1.retType, f2.retType);\n  totalSize1 = f1.params.size() + f1.optionalParams.size();\n  totalSize2 = f2.params.size() + f2.optionalParams.size();\n  sizeWitness = if (totalSize1 <= totalSize2) f1.minSizeWitness else {\n    f2.minSizeWitness\n  };\n  cgNodes = f1.cgNodes.union(f2.cgNodes);\n  TFun(\n    clauses.toArray(),\n    params.toArray(),\n    optionalParams.toArray(),\n    spreadParam,\n    sizeWitness,\n    retType,\n    cgNodes,\n  )\n}\n\nfun unionTTuple(\n  subst: mutable Subst,\n  tenv: TEnv,\n  tuple1: TTuple,\n  tuple2: TTuple,\n): TTuple {\n  result = mutable Vector[];\n  for (i in Range(0, min(tuple1.tuple.size(), tuple2.tuple.size()))) {\n    result.push(TType::union(subst, tenv, tuple1.tuple[i], tuple2.tuple[i]));\n  };\n  if (tuple1.tuple.size() < tuple2.tuple.size()) {\n    for (i in Range(tuple1.tuple.size(), tuple2.tuple.size())) {\n      posEnd = tuple1.pos.atEnd();\n      result.push(\n        TType::union(\n          subst,\n          tenv,\n          TType::single(TPrimUnit(TUndefined(), posEnd)),\n          tuple2.tuple[i],\n        ),\n      );\n    }\n  } else if (tuple2.tuple.size() < tuple1.tuple.size()) {\n    for (i in Range(tuple2.tuple.size(), tuple1.tuple.size())) {\n      posEnd = tuple2.pos.atEnd();\n      result.push(\n        TType::union(\n          subst,\n          tenv,\n          tuple1.tuple[i],\n          TType::single(TPrimUnit(TUndefined(), posEnd)),\n        ),\n      );\n    }\n  };\n  TTuple(result.toArray(), tuple1.pos)\n}\n\nmodule end;\n"}, {"path": "src/Termination.sk", "mtime": 1762775914, "contents": "module SKJS;\n\n/***************************************************************************/\n/* Statement termination classification */\n/* A statement may terminate in 5 different ways: */\n/* - it returns */\n/* - it breaks */\n/* - it throws */\n/* - it loops forever */\n/* - it goes through */\n/***************************************************************************/\n\n/*  A value of type StmtTermination must be interpreted as the union of the\n    representation of each field.\n    Field mayX means \"the statement may X\".\n    If only one field is set, then the statement will always X.\n    If no fields is set, then the statement is unreachable (should not happen).\n*/\nvalue class StmtTermination private {\n  mayReturn: Bool = false,\n  mayBreak: Bool = false,\n  mayContinue: Bool = false,\n  mayThrow: Bool = false,\n  mayLoop: Bool = false,\n  mayFallthrough: Bool = false,\n} {\n  const return_: this = StmtTermination{mayReturn => true};\n  const break_: this = StmtTermination{mayBreak => true};\n  const continue_: this = StmtTermination{mayContinue => true};\n  const throw_: this = StmtTermination{mayThrow => true};\n  const loop_: this = StmtTermination{mayLoop => true};\n  const skip: this = StmtTermination{mayFallthrough => true};\n  const throughOrThrow: this = StmtTermination{\n    mayFallthrough => true,\n    mayThrow => true,\n  };\n  const unknownCall: this = StmtTermination{\n    mayThrow => true,\n    mayLoop => true,\n    mayFallthrough => true,\n  };\n\n  fun merge(that: this, mergeThrough: (Bool, Bool) ~> Bool): this {\n    mayReturn = this.mayReturn || that.mayReturn;\n    mayBreak = this.mayBreak || that.mayBreak;\n    mayContinue = this.mayContinue || that.mayContinue;\n    mayThrow = this.mayThrow || that.mayThrow;\n    mayLoop = this.mayLoop || that.mayLoop;\n    mayFallthrough = mergeThrough(this.mayFallthrough, that.mayFallthrough);\n    static{mayReturn, mayBreak, mayContinue, mayThrow, mayLoop, mayFallthrough}\n  }\n  /* Or: taking either branch */\n  fun /(that: this): this {\n    this.merge(that, (t1, t2) ~> t1 || t2)\n  }\n  /* Maybe: taking either the branch or going through */\n  fun maybe(): this {\n    this / static::skip\n  }\n  /* Then: taking this followed by after */\n  fun then(after: this): this {\n    if (!this.mayFallthrough) this else this.merge(after, (_t1, t2) ~> t2)\n  }\n  /* Then: taking this followed by the continuation */\n  fun thenk(kafter: () -> this): this {\n    if (!this.mayFallthrough) this else this.merge(kafter(), (_t1, t2) ~> t2)\n  }\n  /* Finally: after supersedes any non-loop exit from this */\n  fun finally(after: this): this {\n    this.anyExitToFallthrough().thenk(() ~> after.then(this))\n  }\n  /* Converts breaks to fallThroughs. To be used on a block that may break */\n  fun breakToFallthrough(): this {\n    if (this.mayBreak) {\n      this with {mayBreak => false, mayFallthrough => true}\n    } else {\n      this\n    }\n  }\n  /* Converts continues to fallThroughs. To be used on a block that may continue */\n  fun continueToFallthrough(): this {\n    if (this.mayContinue) {\n      this with {mayContinue => false, mayFallthrough => true}\n    } else {\n      this\n    }\n  }\n  /* Converts any non-loop exit to fallthrough */\n  fun anyExitToFallthrough(): this {\n    mayFallthrough =\n      this.mayReturn ||\n      this.mayBreak ||\n      this.mayContinue ||\n      this.mayThrow ||\n      this.mayFallthrough;\n    static{mayLoop => this.mayLoop, mayFallthrough}\n  }\n  fun mayNonThrough(): ?String {\n    if (this.mayReturn) return Some(\"return\");\n    if (this.mayBreak) return Some(\"break\");\n    if (this.mayContinue) return Some(\"continue\");\n    if (this.mayThrow) return Some(\"throw\");\n    if (this.mayLoop) return Some(\"loop forever\");\n    None()\n  }\n\n  static fun it<T>(it: mutable Iterator<T>, f: T ~> this): this {\n    it.next() match {\n    | None() -> static::skip\n    | Some(x) -> f(x).thenk(() -> static::it(it, f))\n    }\n  }\n  static fun seq<T>(s: Sequence<T>, f: T ~> this): this {\n    static::it(s.iterator(), f)\n  }\n  static fun or<T>(s: Sequence<T>, f: T ~> this): this {\n    if (s.isEmpty()) internal_error(\"sequence should not be empty\");\n    s.reduce((acc, x) -> acc / f(x), static{})\n  }\n\n  static fun stmt(st: Stmt): this {\n    st.value match {\n    | StmtEmpty() -> static::skip\n    | StmtExpr(e) -> static::expr(e)\n    | Break() -> static::break_\n    | Continue() -> static::continue_\n    | Return(_pos, eo) -> static::exprOpt(eo).then(static::return_)\n    | Throw(e) -> static::expr(e).then(static::throw_)\n    | If(cond, bl1, bl2o) ->\n      static::cond(cond).if_(\n        () ~> static::block(bl1),\n        () ~> static::blockOpt(bl2o),\n      )\n    | ForInOf(_forInOfKind, var, e, body) ->\n      static::forVar(var);\n      static::expr(e).thenk(() ~>\n        CondTermination::any.loop_(() ~> static::block(body))\n      )\n    | For(init, cond, incr, body) ->\n      static::stmt(init).thenk(() ~>\n        static::cond(cond).loop_(() ~>\n          static::block(body).thenk(() ~> static::expr(incr))\n        )\n      )\n    | While(cond, body) -> static::cond(cond).loop_(() ~> static::block(body))\n    | Bind(_kind, bindings) -> static::seq(bindings, static::binding)\n    | Switch(e, branches) ->\n      static::expr(e).thenk(() ~> {\n        branchesTerm = static::or(branches, static::branch);\n        switchIsExhaustive = branches.any(branch ~> branch is Default _); // Unless exhaustiveness is proven differently?\n        if (switchIsExhaustive) branchesTerm else branchesTerm.maybe();\n      })\n    | Block(block) -> static::block(block)\n    | Try(tryBlock, catchClause, finallyBlock) ->\n      tryTerm = static::block(tryBlock);\n      afterCatchTerm = catchClause match {\n      | Some(CatchClause(_, _, catchBlock)) ->\n        // TODO: warning if tryTerm.mayThrow is false\n        // Remove mayThrow from try and combine with catch\n        tryNoThrow = tryTerm with {mayThrow => false};\n        catchTerm = static::block(catchBlock);\n        tryNoThrow / catchTerm\n      | None() -> tryTerm\n      };\n      finallyBlock match {\n      | Some(finallyStmts) ->\n        // TODO: warning if afterCatchTerm always loops or terminates normally\n        finallyTerm = static::block(finallyStmts);\n        afterCatchTerm.finally(finallyTerm)\n      | None() -> afterCatchTerm\n      }\n    }\n  }\n\n  static fun block(stmts: Sequence<Stmt>): this {\n    static::seq(stmts, static::stmt)\n  }\n\n  static fun blockOpt(so: ?Sequence<Stmt>): this {\n    static::block(so.default(Array[]))\n  }\n\n  static fun expr(expr: Expr): this {\n    /* Operands, array literals, object literals are always evaluated from left to right.\n       We assume that the existence of _name is checked in the typechecker.\n       We assume operators do not call custom functions. */\n    expr.value match {\n    | Number(_)\n    | BigInt(_)\n    | Var(_name)\n    | Spread(_name) /* We assume the typechecker checks it's an iterable */\n    | EString(_)\n    | Closure(_args, _retTy, _body)\n    | Regexp(_) ->\n      static::skip\n    | TemplateLiteral(_parts, expressions) ->\n      static::seq(expressions, static::expr)\n    | TypeOf(e)\n    | Await(e)\n    | As(e, _ty)\n    | AsConst(e) ->\n      static::expr(e)\n    | New(_name, _targs, args) ->\n      static::seq(args, static::expr).then(static::unknownCall)\n    | Unop(_unop, e)\n    | PostOp(_postop, e) ->\n      static::expr(e) /* do not throw */\n    | Binop(BOLogicalAnd(), e1, e2)\n    | Binop(BOLogicalOr(), e1, e2) ->\n      static::expr(e1).thenk(() ~> static::expr(e2).maybe())\n    | Get(e1, e2)\n    | InstanceOf(e1, e2)\n    | In(e1, e2)\n    | Binop(BODot(), e1, e2)\n    | Binop(BOExclamationMarkDot(), e1, e2) ->\n      static::expr(e1).thenk(() ~>\n        static::expr(e2).then(static::throughOrThrow)\n      )\n    | Binop(_op, e1, e2) ->\n      // We assume the typechecker checks we're not re-assigning a const\n      static::expr(e1).thenk(() ~> static::expr(e2)) /* do not throw */\n    | Call(e, _targs, args) ->\n      // We assume the typechecker checks it's a function so calling does not throw\n      static::expr(e).thenk(() ->\n        static::seq(args, static::expr).then(static::unknownCall)\n      )\n    | Params(_) -> paramsError(expr.pos)\n    | Object(fields) -> static::seq(fields, static::field)\n    | EArray(exprs) -> static::seq(exprs, static::expr)\n    | EIf(cond, e1, e2) ->\n      static::cond(cond).if_(() ~> static::expr(e1), () ~> static::expr(e2))\n    | Async(e) -> static::expr(e).maybe()\n    }\n  }\n\n  static fun exprOpt(eo: ?Expr): this {\n    eo.maybe(static::skip, static::expr)\n  }\n\n  static fun cond(cond: Expr): CondTermination {\n    CondTermination::expr(cond)\n  }\n\n  static fun field(field: Field): this {\n    field match {\n    | FDNormal(_name, e)\n    | FDSpread(e) ->\n      static::expr(e)\n    | FunDef _ -> static::skip\n    }\n  }\n\n  static fun branch(branch: SwitchBranch): this {\n    branch match {\n    | Case(e, block) ->\n      static::branchCase(e);\n      static::block(block).breakToFallthrough()\n    | Default(block) -> static::block(block).breakToFallthrough()\n    }\n  }\n\n  static fun branchCase(e: Expr): void {\n    static::expr(e).mayNonThrough().each(term ->\n      typingError(\n        Array[\n          (e.pos, `Invalid switch branch case expression, it may ${term}.`),\n        ],\n      )\n    )\n  }\n\n  static fun binding(binding: Binding): this {\n    static::exprOpt(binding.value)\n  }\n\n  static fun forVar(stmt: Stmt): void {\n    static::stmt(stmt).mayNonThrough().each(term ->\n      typingError(\n        Array[(stmt.pos, `Invalid for variable initializer, it may ${term}.`)],\n      )\n    )\n  }\n}\n\nvalue class CondTermination private (\n  exprTermination: StmtTermination,\n  tauto: TautologyCheck,\n) {\n  const any: CondTermination = CondTermination(StmtTermination::skip, TCTop());\n\n  static fun expr(expr: Expr): this {\n    static(StmtTermination::expr(expr), TautologyCheck::expr(expr))\n  }\n\n  fun if_(\n    ktrue: () ~> StmtTermination,\n    kfalse: () ~> StmtTermination,\n  ): StmtTermination {\n    this.exprTermination.thenk(() ~>\n      this.tauto match {\n      | TCAlwaysTrue() -> ktrue()\n      | TCAlwaysFalse() -> kfalse()\n      | TCTop() -> ktrue() / kfalse()\n      }\n    )\n  }\n\n  fun loop_(kbody: () ~> StmtTermination): StmtTermination {\n    this.if_(\n      () ~>\n        kbody()\n          .continueToFallthrough()\n          .then(StmtTermination::loop_)\n          .breakToFallthrough(),\n      () ~> StmtTermination::skip,\n    )\n  }\n}\n\nbase class TautologyCheck private () {\n  children =\n  | TCAlwaysTrue()\n  | TCAlwaysFalse()\n  | TCTop()\n\n  static fun expr(expr: Expr): TautologyCheck {\n    expr.value match {\n    | Var(Name(_pos, \"true\")) -> TCAlwaysTrue()\n    | Var(Name(_pos, \"false\")) -> TCAlwaysFalse()\n    | _ -> TCTop()\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/Tokens.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Tokens recognized by the Lexer. */\n/***************************************************************************/\n\nmodule SKJS;\n\nvalue class Token(kind: TokenKind, posStart: Pos, posEnd: Pos)\n\nbase class TokenKind uses Equality, XXHashable, Hashable {\n  children =\n  | TKAddQM()\n  | TKAddition()\n  | TKAdditionAssignment()\n  | TKAssignment()\n  | TKBackTick()\n  | TKBigInt()\n  | TKBitwiseAnd()\n  | TKBitwiseAndAssignment()\n  | TKBitwiseOr()\n  | TKBitwiseOrAssignment()\n  | TKBitwiseXor()\n  | TKBitwiseXorAssignment()\n  | TKCloseCurly()\n  | TKCloseParen()\n  | TKCloseSquare()\n  | TKClosure()\n  | TKColon()\n  | TKComma()\n  | TKDecr()\n  | TKDivision()\n  | TKDivisionAssignment()\n  | TKDot()\n  | TKDotDotDot()\n  | TKDoubleQuote()\n  | TKEquality()\n  | TKExclamationMark()\n  | TKExclamationMarkDot()\n  | TKGreaterThan()\n  | TKGreaterThanOrEqual()\n  | TKIncr()\n  | TKInequality()\n  | TKLeftShift()\n  | TKLeftShiftAssignment()\n  | TKLessThan()\n  | TKLessThanOrEqual()\n  | TKLogicalAnd()\n  | TKLogicalAndAssignment()\n  | TKLogicalOr()\n  | TKLogicalOrAssignment()\n  | TKMultiplication()\n  | TKMultiplicationAssignment()\n  | TKNullishCoalescing()\n  | TKNullishCoalescingAssignment()\n  | TKNumber()\n  | TKOpenCurly()\n  | TKOpenParen()\n  | TKOpenSquare()\n  | TKQuestionMark()\n  | TKQuestionMarkDot()\n  | TKQuote()\n  | TKRemainder()\n  | TKRemainderAssignment()\n  | TKRemoveQM()\n  | TKSemi()\n  | TKSignedRightShift()\n  | TKSignedRightShiftAssignment()\n  | TKStrictEquality()\n  | TKStrictInequality()\n  | TKSubtraction()\n  | TKSubtractionAssignment()\n  | TKTild()\n  | TKVar()\n  | TKZeroFilledRightShift()\n  | TKZeroFilledRightShiftAssignment()\n\n  fun toString(): String\n  | TKAddQM() -> \"+?\"\n  | TKAddition() -> \"+\"\n  | TKAdditionAssignment() -> \"+=\"\n  | TKAssignment() -> \"=\"\n  | TKBackTick() -> \"`\"\n  | TKBigInt() -> \"a bigint\"\n  | TKBitwiseAnd() -> \"&\"\n  | TKBitwiseAndAssignment() -> \"&=\"\n  | TKBitwiseOr() -> \"|\"\n  | TKBitwiseOrAssignment() -> \"|=\"\n  | TKBitwiseXor() -> \"^\"\n  | TKBitwiseXorAssignment() -> \"^=\"\n  | TKCloseCurly() -> \"}\"\n  | TKCloseParen() -> \")\"\n  | TKCloseSquare() -> \"]\"\n  | TKClosure() -> \"=>\"\n  | TKColon() -> \":\"\n  | TKComma() -> \",\"\n  | TKDecr() -> \"--\"\n  | TKDivision() -> \"/\"\n  | TKDivisionAssignment() -> \"/=\"\n  | TKDot() -> \".\"\n  | TKDotDotDot() -> \"...\"\n  | TKDoubleQuote() -> \"\\\"\"\n  | TKEquality() -> \"==\"\n  | TKExclamationMark() -> \"!\"\n  | TKExclamationMarkDot() -> \"!.\"\n  | TKGreaterThan() -> \">\"\n  | TKGreaterThanOrEqual() -> \">=\"\n  | TKIncr() -> \"++\"\n  | TKInequality() -> \"!=\"\n  | TKLeftShift() -> \"<<\"\n  | TKLeftShiftAssignment() -> \"<<=\"\n  | TKLessThan() -> \"<\"\n  | TKLessThanOrEqual() -> \"<=\"\n  | TKLogicalAnd() -> \"&&\"\n  | TKLogicalAndAssignment() -> \"&&=\"\n  | TKLogicalOr() -> \"||\"\n  | TKLogicalOrAssignment() -> \"||=\"\n  | TKMultiplication() -> \"*\"\n  | TKMultiplicationAssignment() -> \"*=\"\n  | TKNullishCoalescing() -> \"??\"\n  | TKNullishCoalescingAssignment() -> \"??=\"\n  | TKNumber() -> \"a number\"\n  | TKOpenCurly() -> \"{\"\n  | TKOpenParen() -> \"(\"\n  | TKOpenSquare() -> \"[\"\n  | TKQuestionMark() -> \"?\"\n  | TKQuestionMarkDot() -> \"?.\"\n  | TKQuote() -> \"'\"\n  | TKRemainder() -> \"%\"\n  | TKRemainderAssignment() -> \"%=\"\n  | TKRemoveQM() -> \"-?\"\n  | TKSemi() -> \";\"\n  | TKSignedRightShift() -> \">>\"\n  | TKSignedRightShiftAssignment() -> \">>=\"\n  | TKStrictEquality() -> \"===\"\n  | TKStrictInequality() -> \"!==\"\n  | TKSubtraction() -> \"-\"\n  | TKSubtractionAssignment() -> \"-=\"\n  | TKTild() -> \"~\"\n  | TKVar() -> \"a variable name\"\n  | TKZeroFilledRightShift() -> \">>>\"\n  | TKZeroFilledRightShiftAssignment() -> \">>>=\"\n\n  fun toBinop(): ?BinaryOperator {\n    this match {\n    | TKDot() -> Some(BODot())\n    | TKQuestionMarkDot() -> Some(BOOptionalDot())\n    | TKExclamationMarkDot() -> Some(BOExclamationMarkDot())\n    | TKMultiplication() -> Some(BOMultiplication())\n    | TKDivision() -> Some(BODivision())\n    | TKRemainder() -> Some(BORemainder())\n    | TKAddition() -> Some(BOAddition())\n    | TKSubtraction() -> Some(BOSubtraction())\n    | TKLeftShift() -> Some(BOLeftShift())\n    | TKSignedRightShift() -> Some(BOSignedRightShift())\n    | TKZeroFilledRightShift() -> Some(BOZeroFilledRightShift())\n    | TKLessThan() -> Some(BOLessThan())\n    | TKLessThanOrEqual() -> Some(BOLessThanOrEqual())\n    | TKGreaterThan() -> Some(BOGreaterThan())\n    | TKGreaterThanOrEqual() -> Some(BOGreaterThanOrEqual())\n    | TKStrictEquality() -> Some(BOStrictEquality())\n    | TKStrictInequality() -> Some(BOStrictInequality())\n    | TKBitwiseAnd() -> Some(BOBitwiseAnd())\n    | TKBitwiseXor() -> Some(BOBitwiseXor())\n    | TKBitwiseOr() -> Some(BOBitwiseOr())\n    | TKLogicalAnd() -> Some(BOLogicalAnd())\n    | TKLogicalOr() -> Some(BOLogicalOr())\n    | TKNullishCoalescing() -> Some(BONullishCoalescing())\n    | TKAssignment() -> Some(BOAssignment())\n    | TKMultiplicationAssignment() -> Some(BOOpAssignment(BOMultiplication()))\n    | TKDivisionAssignment() -> Some(BOOpAssignment(BODivision()))\n    | TKRemainderAssignment() -> Some(BOOpAssignment(BORemainder()))\n    | TKAdditionAssignment() -> Some(BOOpAssignment(BOAddition()))\n    | TKSubtractionAssignment() -> Some(BOOpAssignment(BOSubtraction()))\n    | TKLeftShiftAssignment() -> Some(BOOpAssignment(BOLeftShift()))\n    | TKSignedRightShiftAssignment() ->\n      Some(BOOpAssignment(BOSignedRightShift()))\n    | TKZeroFilledRightShiftAssignment() ->\n      Some(BOOpAssignment(BOZeroFilledRightShift()))\n    | TKBitwiseAndAssignment() -> Some(BOOpAssignment(BOBitwiseAnd()))\n    | TKBitwiseXorAssignment() -> Some(BOOpAssignment(BOBitwiseXor()))\n    | TKBitwiseOrAssignment() -> Some(BOOpAssignment(BOBitwiseOr()))\n    | TKLogicalAndAssignment() -> Some(BOOpAssignment(BOLogicalAnd()))\n    | TKLogicalOrAssignment() -> Some(BOOpAssignment(BOLogicalOr()))\n    | TKNullishCoalescingAssignment() ->\n      Some(BOOpAssignment(BONullishCoalescing()))\n\n    | _ -> None()\n    }\n  }\n}\n\n/***************************************************************************/\n// A special character is a character than can represent an operator\n// with multiple characters. So for example, '.' can be \"...\", + can\n// be \"+=\" etc ...\n/***************************************************************************/\n\nconst specialChars: Set<Char> = Set[\n  '.',\n  '*',\n  '/',\n  '%',\n  '+',\n  '-',\n  '<',\n  '>',\n  '=',\n  '!',\n  '&',\n  '^',\n  '|',\n  '?',\n];\n\n/***************************************************************************/\n// Table that associates an operator to a string.\n/***************************************************************************/\n\nconst operators: Map<String, TokenKind> = Map[\n  \"++\" => TKIncr(),\n  \"--\" => TKDecr(),\n  \"-?\" => TKRemoveQM(),\n  \"+?\" => TKAddQM(),\n  \"*\" => TKMultiplication(),\n  \"/\" => TKDivision(),\n  \"%\" => TKRemainder(),\n  \"+\" => TKAddition(),\n  \"-\" => TKSubtraction(),\n  \"<<\" => TKLeftShift(),\n  \">>\" => TKSignedRightShift(),\n  \">>>\" => TKZeroFilledRightShift(),\n  \"<\" => TKLessThan(),\n  \"<=\" => TKLessThanOrEqual(),\n  \">\" => TKGreaterThan(),\n  \">=\" => TKGreaterThanOrEqual(),\n  \"==\" => TKEquality(),\n  \"!=\" => TKInequality(),\n  \"===\" => TKStrictEquality(),\n  \"!==\" => TKStrictInequality(),\n  \"&\" => TKBitwiseAnd(),\n  \"^\" => TKBitwiseXor(),\n  \"|\" => TKBitwiseOr(),\n  \"&&\" => TKLogicalAnd(),\n  \"||\" => TKLogicalOr(),\n  \"??\" => TKNullishCoalescing(),\n  \"=\" => TKAssignment(),\n  \"*=\" => TKMultiplicationAssignment(),\n  \"/=\" => TKDivisionAssignment(),\n  \"%=\" => TKRemainderAssignment(),\n  \"+=\" => TKAdditionAssignment(),\n  \"-=\" => TKSubtractionAssignment(),\n  \"<<=\" => TKLeftShiftAssignment(),\n  \">>=\" => TKSignedRightShiftAssignment(),\n  \">>>=\" => TKZeroFilledRightShiftAssignment(),\n  \"&=\" => TKBitwiseAndAssignment(),\n  \"^=\" => TKBitwiseXorAssignment(),\n  \"|=\" => TKBitwiseOrAssignment(),\n  \"&&=\" => TKLogicalAndAssignment(),\n  \"||=\" => TKLogicalOrAssignment(),\n  \"??=\" => TKNullishCoalescingAssignment(),\n  \"=>\" => TKClosure(),\n  \"?.\" => TKQuestionMarkDot(),\n  \"!.\" => TKExclamationMarkDot(),\n];\n\n/***************************************************************************/\n// Type to represent operators associativity.\n/***************************************************************************/\n\nbase class Associativity {\n  children =\n  | ALeft()\n  | ARight()\n  | ANonAssoc()\n}\n\n/***************************************************************************/\n// Operators associativity and precedence.\n/***************************************************************************/\n\nconst in_and_instanceofPrec: (Associativity, Int) = (ANonAssoc(), 12);\nconst callPrec: Int = 18;\nconst typeOfPrec: Int = 13;\n\nconst precedence: Map<TokenKind, (Associativity, Int)> = Map[\n  TKDot() => (ALeft(), 20),\n  TKQuestionMarkDot() => (ALeft(), 20),\n  TKExclamationMarkDot() => (ALeft(), 20),\n  TKIncr() => (ANonAssoc(), 18),\n  TKDecr() => (ANonAssoc(), 18),\n  TKExclamationMark() => (ANonAssoc(), 17),\n  TKTild() => (ANonAssoc(), 17),\n  TKMultiplication() => (ALeft(), 15),\n  TKDivision() => (ALeft(), 15),\n  TKRemainder() => (ALeft(), 15),\n  TKAddition() => (ALeft(), 14),\n  TKSubtraction() => (ALeft(), 14),\n  TKLeftShift() => (ALeft(), 13),\n  TKSignedRightShift() => (ALeft(), 13),\n  TKZeroFilledRightShift() => (ALeft(), 13),\n  TKLessThan() => (ALeft(), 12),\n  TKLessThanOrEqual() => (ALeft(), 12),\n  TKGreaterThan() => (ALeft(), 12),\n  TKGreaterThanOrEqual() => (ALeft(), 12),\n  TKEquality() => (ALeft(), 11),\n  TKInequality() => (ALeft(), 11),\n  TKStrictEquality() => (ALeft(), 11),\n  TKStrictInequality() => (ALeft(), 11),\n  TKBitwiseAnd() => (ALeft(), 10),\n  TKBitwiseXor() => (ALeft(), 9),\n  TKBitwiseOr() => (ALeft(), 8),\n  TKLogicalAnd() => (ALeft(), 7),\n  TKLogicalOr() => (ALeft(), 6),\n  TKNullishCoalescing() => (ARight(), 5),\n  TKQuestionMark() => (ARight(), 4),\n  TKAssignment() => (ARight(), 3),\n  TKMultiplicationAssignment() => (ARight(), 3),\n  TKDivisionAssignment() => (ARight(), 3),\n  TKRemainderAssignment() => (ARight(), 3),\n  TKAdditionAssignment() => (ARight(), 3),\n  TKSubtractionAssignment() => (ARight(), 3),\n  TKLeftShiftAssignment() => (ARight(), 3),\n  TKSignedRightShiftAssignment() => (ARight(), 3),\n  TKZeroFilledRightShiftAssignment() => (ARight(), 3),\n  TKBitwiseAndAssignment() => (ARight(), 3),\n  TKBitwiseXorAssignment() => (ARight(), 3),\n  TKBitwiseOrAssignment() => (ARight(), 3),\n  TKLogicalAndAssignment() => (ARight(), 3),\n  TKLogicalOrAssignment() => (ARight(), 3),\n  TKNullishCoalescingAssignment() => (ARight(), 3),\n];\n\nmodule end;\n"}, {"path": "src/TypeCheck.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Type-checker for SKJS */\n/***************************************************************************/\n\nmodule SKJS;\n\n/***************************************************************************/\n/* Type-checker */\n/***************************************************************************/\n\nclass TypeChecker{\n  builtins: Set<String>,\n  builtinsFileName: FileName,\n  backtrace: Bool,\n  defMap: DefMap,\n  tenv: TEnv,\n  super: ?(CstrType, TType) = None(),\n  isAsync: Bool = false,\n  retType: ?TType = None(),\n} {}\n\n/***************************************************************************/\n/* Returns true if a statement always is \"terminal\", meaning if\n/* evaluating this statements terminates the function. */\n/***************************************************************************/\n\nfun isTerminalBlock(inTry: Bool, bl: Array<Stmt>): Bool {\n  term = StmtTermination::block(bl);\n  !term.mayFallthrough && (term.mayReturn || (!inTry && term.mayThrow))\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckClass.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun class_(context: mutable SKStore.Context, c: Class): void {\n    constructor: ?FunDef = None();\n    for (fieldType in c.fields) {\n      fieldType match {\n      | fd @ FunDef _ if (fd.name is Some(FNNormal(Name(_, \"constructor\")))) ->\n        constructor match {\n        | Some(existingConstructor) ->\n          typingError(\n            Array[\n              (fd.pos, \"Multiple constructor implementations are not allowed.\"),\n              (existingConstructor.pos, \"Previous implementation\"),\n            ],\n          )\n        | None() -> !constructor = Some(fd)\n        }\n      | _ -> void\n      }\n    };\n    static::checkTypeParams(c.tparams);\n    subst = Subst::mcreate{context};\n    targs = TArgs(\n      c.tparams.map(tparam -> {\n        if (tparam.default is Some _) {\n          typingError(\n            Array[\n              (\n                tparam.name.pos,\n                \"Optional type parameters are not supported for classes\",\n              ),\n            ],\n          )\n        };\n        ttypeParam = TParamWithConstraint(\n          tparam.name.value,\n          tparam.name.pos.fileName,\n          tparam.id,\n          tparam.constraint.map(c -> this.tenv.normalize(context, c)),\n        );\n        TType::fromTParamWithConstraint(\n          subst,\n          this.tenv,\n          tparam.name.pos,\n          ttypeParam,\n        )\n      }),\n    );\n    !this.tenv = this.tenv.addTParams(subst, c.tparams);\n    fileName = c.name.pos.fileName;\n    cstr = TType::inst(c.name, targs);\n    thisType = TType::fromTParamWithConstraint(\n      subst,\n      this.tenv,\n      c.name.pos,\n      TParamWithConstraint(\n        \"this\",\n        fileName,\n        Id::createThis(),\n        Some(cstr.expand(subst, this.tenv, Covariant())),\n      ),\n    );\n    if (c.extends_.size() != 0) {\n      isInterface = c.kind is CKInterface();\n      if (c.extends_.size() > 1 && !isInterface) {\n        typingError(Array[(c.name.pos, \"Cannot extend more than one class\")])\n      };\n      for (ext in c.extends_) {\n        ext.value match {\n        | TAInst(parentName, parentTArgs) ->\n          superCstr = this.tenv.newConstructor(\n            context,\n            parentName,\n            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),\n          );\n          super = this.tenv.new(\n            context,\n            parentName,\n            parentTArgs.map(ty -> this.tenv.normalize(context, ty)),\n          );\n          if (!isInterface) {\n            !this.super = Some((superCstr, super));\n          };\n          tcenv = TCEnv::mcreate(context, subst, CGNode::toplevel(fileName));\n          recordClassHierarchy(context, c, ctx ->\n            this.tenv.getClass(ctx, parentName)\n          );\n          this.checkSubType(\n            tcenv,\n            parentName.pos,\n            \"Invalid extends\",\n            thisType,\n            super,\n          )\n        | _ -> typingError(Array[(c.name.pos, \"Invalid extend\")])\n        }\n      }\n    };\n    for (interface in c.implements) {\n      interface.value match {\n      | TAInst(parentName, parentTArgs) ->\n        super = this.tenv.new(\n          context,\n          parentName,\n          parentTArgs.map(ty -> this.tenv.normalize(context, ty)),\n        );\n        tcenv = TCEnv::mcreate(context, subst, CGNode::toplevel(fileName));\n        recordClassHierarchy(context, c, ctx ->\n          this.tenv.getClass(ctx, parentName)\n        );\n        this.checkSubType(\n          tcenv,\n          parentName.pos,\n          \"Invalid implements\",\n          thisType,\n          super,\n        )\n      | _ -> typingError(Array[(c.name.pos, \"Invalid implements\")])\n      }\n    };\n    hasConstructor = false;\n    for (fieldType in c.fields) {\n      fieldType match {\n      | field @ FieldTypeValue _ ->\n        field.setGet match {\n        | None() -> void\n        | Some(FieldGetSet(_, pos)) -> notSupported(pos)\n        };\n        for (modifier in field.modifiers.modifiers) {\n          modifier match {\n          | ModStatic(pos) ->\n            typingError(Array[(pos, \"static fields are forbidden\")])\n          | ModPublic _ -> void /* public is the default */\n          | ModPrivate _\n          | ModProtected _\n          | ModReadonly _ ->\n            /* TODO: intentionally ignore accessibility modifiers since TypeScript do check them */ void\n          | mod ->\n            typingError(\n              Array[\n                (\n                  modifier.pos,\n                  `TODO: field modifier '${mod}' (TypeChecker#class_)`,\n                ),\n              ],\n            )\n          }\n        };\n        type = this.tenv.normalize(context, field.type);\n        field.value match {\n        | None() -> void\n        | Some(e) ->\n          tcenv = TCEnv::mcreate(context, subst, CGNode::toplevel(fileName));\n          this.checkSubType(\n            tcenv,\n            e.pos,\n            \"Invalid assignment\",\n            this.expr(tcenv, e, true),\n            type,\n          )\n        }\n      | fd @ FunDef _ ->\n        if (fd.name is Some(FNNormal(Name(_, \"constructor\")))) {\n          !hasConstructor = true;\n          partialThisType = this.tenv.new(\n            context,\n            c.name,\n            targs.targs,\n            fieldType ~> (fieldType is FieldTypeValue{value => Some _}),\n          );\n          _ = this.constructor(\n            subst,\n            thisType,\n            partialThisType,\n            fd,\n            Some(c.name),\n          )\n        } else {\n          cgNode = CGNode::create(\n            Method(fd.name, c.name, fd.pos.fileName, fd.isStatic()),\n          );\n          _ = this.funDef(subst, Some((c.kind, thisType)), fd, cgNode)\n        }\n      }\n    };\n    if (c.kind is CKInterface() || c.kind is CKAbstract()) return void;\n    if (!hasConstructor) {\n      for (fieldType in c.fields) {\n        fieldType match {\n        | field @ FieldTypeValue _ ->\n          field.value match {\n          | None() ->\n            if (field.optional is None()) {\n              typingError(Array[(field.pos, \"Uninitialized field\")])\n            }\n          | Some(_) -> void\n          }\n        | FunDef _ -> void\n        }\n      }\n    }\n  }\n\n  fun constructor(\n    subst: mutable Subst,\n    thisType: TType,\n    partialThisType: TType,\n    fd: FunDef,\n    className: ?Name,\n  ): void {\n    if (fd.retType.i1 is Some _) {\n      typingError(\n        Array[(fd.retType.i0, \"Constructors don't have return types\")],\n      );\n    };\n    for (modifier in fd.modifiers.modifiers) {\n      typingError(Array[(modifier.pos, \"Constructors cannot have modifiers\")]);\n    };\n    cgNode = CGNode::create(\n      className match {\n      | Some(cname) -> Constructor(cname, fd.pos.fileName)\n      | None() -> AnonymousFunDef(fd)\n      },\n    );\n    (!this, tcenv) = this.funDefSetup(subst, Some(partialThisType), fd, cgNode);\n    tcenv.localObjects![\"this\"] = LOCanGrow(Some(thisType));\n    fd.isAsync match {\n    | None() -> void\n    | Some(asyncPos) ->\n      typingError(Array[(asyncPos, \"Constructors cannot be async\")])\n    };\n    fd.body match {\n    | FDBNone(pos) -> typingError(Array[(pos, \"Missing definition\")])\n    | FDBSome(body) ->\n      blockScope = this.block(tcenv, body);\n      blockThisType = blockScope.get(Name(fd.pos, \"this\"));\n      objType = static::filterMethods(blockThisType, tcenv.subst, this.tenv);\n      fullType = static::filterMethods(thisType, tcenv.subst, this.tenv);\n      this.checkSubType(\n        tcenv,\n        fd.pos,\n        \"Invalid initialization\",\n        objType,\n        fullType,\n      )\n    };\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckDef.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun check(context: mutable SKStore.Context, defs: Array<Def>): Array<Error> {\n    errors = mutable Vector[];\n    for (def in defs) {\n      if (this.backtrace) this.checkDef(context, def) else {\n        try {\n          this.checkDef(context, def)\n        } catch {\n        | ErrorExn(err) -> errors.push(err)\n        | exn -> throw exn\n        }\n      }\n    };\n    errors.toArray()\n  }\n\n  fun checkDef(context: mutable SKStore.Context, def: Def): void {\n    def.value match {\n    | ExportImport _ -> notSupported(def.pos)\n    | ImportExpr _ -> void\n    | Global _ -> notSupported(def.pos)\n    | ExportAs _ -> notSupported(def.pos)\n    | ExportEq _ -> notSupported(def.pos)\n    | Module _ -> notSupported(def.pos)\n    | ToplevelExpr(e) ->\n      subst = Subst::mcreate{context};\n      tcenv = TCEnv::mcreate(\n        context,\n        subst,\n        CGNode::toplevel(def.pos.fileName),\n      );\n      ty = this.expr(tcenv, e);\n      this.checkIsVoid(tcenv, e.pos, ty)\n    | fd @ FunDef _ ->\n      cgNode = fd.name match {\n      | Some(name) -> CGNode::create(TopLevelFunDef(name, fd.pos.fileName))\n      | None() -> CGNode::create(AnonymousFunDef(fd))\n      };\n      subst = Subst::mcreate{context};\n      this.funDef(subst, None(), fd, cgNode)\n    | Declare _ -> void\n    | Namespace _ -> notSupported(def.pos)\n    | Export(_, _, d) -> this.checkDef(context, Def(def.pos, d))\n    | ExportDefault _ -> notSupported(def.pos)\n    | ExportNames _ -> void\n    | Import _ -> void\n    | c @ Class _ -> this.class_(context, c)\n    | Enum _ -> notSupported(def.pos)\n    | VarDefs(kind, varDefs) -> this.varDefs(context, kind, varDefs)\n    | td @ TypeDef _ -> this.typeDef(td)\n    }\n  }\n\n  fun varDefs(\n    context: mutable SKStore.Context,\n    kind: VarDefKind,\n    varDefs: Array<VarDef>,\n  ): void {\n    for (varDef in varDefs) {\n      kind match {\n      | VDKConst() -> void\n      | VDKLet() -> notSupported(varDef.pat.pos, \"toplevel let\")\n      | VDKVar() -> notSupported(varDef.pat.pos, \"toplevel var\")\n      };\n      literalType = varDef.value match {\n      | None() -> None()\n      | Some(x) -> this.asConstExpr(x)\n      };\n      type = varDef.type match {\n      | None() ->\n        literalType match {\n        | Some(ty) -> ty\n        | _ -> typingError(Array[(varDef.pat.pos, \"Missing type annotation\")])\n        }\n      | Some(x) -> this.tenv.normalize(context, x)\n      };\n      subst = Subst::mcreate{context};\n      if (!type.isPrimitiveType(subst, this.tenv)) {\n        typingError(\n          Array[\n            (\n              varDef.pat.pos,\n              \"Invalid type for constant, \" +\n                \"only primitive types (not objects) are allowed\",\n            ),\n          ],\n        );\n      };\n      varDef.pat.value match {\n      | PVar _ -> void\n      | PArray _ /* (Array<Pattern>) */\n      | PObject _ /* (Array<(Name, Pattern)>) */ ->\n        internal_error(\"TODO pattern varDef\")\n      };\n      e = varDef.value match {\n      | None() -> typingError(Array[(varDef.pat.pos, \"Missing definition\")])\n      | Some(x) -> x\n      };\n      tcenv = TCEnv::mcreate(\n        context,\n        subst,\n        CGNode::toplevel(varDef.pat.pos.fileName),\n      );\n      this.checkSubType(\n        tcenv,\n        varDef.pat.pos,\n        \"Invalid definition\",\n        literalType match {\n        | None() ->\n          ty = this.expr(tcenv, e);\n          ty\n        | Some(litType) -> litType\n        },\n        type,\n      )\n    }\n  }\n\n  fun typeDef(typeDef: TypeDef): void {\n    static::checkTypeParams(typeDef.tdefParams)\n  }\n\n  static fun checkTypeParams(tparams: Array<TypeParam>): void {\n    firstDefaultPosOpt: ?PosRange = None();\n    for (tparam in tparams) {\n      (tparam.default, firstDefaultPosOpt) match {\n      | (None(), Some(firstDefaultPos)) ->\n        typingError(\n          Array[\n            (\n              tparam.name.pos,\n              \"Required type parameters may not follow optional type parameters.\",\n            ),\n            (firstDefaultPos, \"First optional type parameter was here\"),\n          ],\n        )\n      | (Some _, None()) -> !firstDefaultPosOpt = Some(tparam.name.pos)\n      | (None(), None())\n      | (Some _, Some _) ->\n        void\n      }\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckEnv.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* The mutable environment used by the type-checker. */\n/***************************************************************************/\n\nmodule SKJS;\n\nbase class LocalObjectState {\n  children =\n  | LOCanGrow(bound: ?TType)\n  | LOUsed(PosRange)\n}\n\nmutable class TCEnv(\n  context: mutable SKStore.Context,\n  subst: mutable Subst,\n  mutable scope: mutable Scope,\n  mutable callingContext: CGNode,\n  localObjects: mutable Map<String, LocalObjectState> = mutable Map[]/*\n  Tracks local objects, i.e. object literals bounded to variables.\n  Those are allowed to grow if they haven't been used.\n  Growth is limited by the provided type, if any.\n  */ ,\n  private mutable counter: Int = 0,\n) {\n  static fun mcreate(\n    context: mutable SKStore.Context,\n    subst: mutable Subst,\n    callingContext: CGNode,\n  ): mutable this {\n    scope = Scope::mcreateToplevel();\n    mutable static(context, subst, scope, callingContext)\n  }\n\n  private mutable fun next(): Int {\n    this.!counter = this.counter + 1;\n    this.counter\n  }\n\n  mutable fun mergeScope(\n    tenv: TEnv,\n    scope1: readonly Scope,\n    scope2: readonly Scope,\n  ): void {\n    this.scope.merge(this.subst, tenv, scope1, scope2);\n  }\n\n  mutable fun popScope(\n    subst: mutable Subst,\n    tenv: TEnv,\n    scope: readonly Scope,\n  ): void {\n    this.scope.popMerge(subst, tenv, scope);\n  }\n\n  mutable fun popScopeReplace(scope: readonly Scope): void {\n    this.scope.popReplace(scope);\n  }\n\n  mutable fun mcreateSubScope{isLoop: Bool}: mutable Scope {\n    mutable Scope{id => this.next(), isLoop, up => Some(this.scope)}\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckExpr.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun block(\n    tcenv: mutable TCEnv,\n    stmts: Array<Stmt>,\n    cond: ?(Expr, Bool) = None(),\n  ): readonly Scope {\n    scopeCopy = tcenv.scope;\n    scope = tcenv.mcreateSubScope{isLoop => false};\n    tcenv.!scope = scope;\n    cond match {\n    | None() -> void\n    | Some((c, target)) -> this.evalCond(tcenv, c, target)\n    };\n    for (st in stmts) {\n      this.stmt(tcenv, st)\n    };\n    tcenv.!scope = scopeCopy;\n    scope\n  }\n\n  fun bind(\n    tcenv: mutable TCEnv,\n    kind: BindKind,\n    pat: Pattern,\n    type: TType,\n    isInitialized: Bool,\n    isLocalObject: Bool,\n  ): void {\n    pos = pat.pos;\n    pat.value match {\n    | PVar(local) ->\n      if (\n        isLocalObject &&\n        !tcenv.scope.isThroughLoop(local) &&\n        !tcenv.localObjects.containsKey(local.value)\n      ) {\n        tcenv.localObjects![local.value] = LOCanGrow(None())\n      };\n      tcenv.scope.bind(local, type, isInitialized)\n    | PArray(arrPat) ->\n      type.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n        stypes.singleElt()\n      ) match {\n      | Some(TTuple(tyl, _)) ->\n        if (arrPat.size() != tyl.size()) {\n          typingError(\n            Array[\n              (\n                pos,\n                `Invalid tuple pattern size, it is of size ${arrPat.size()}`,\n              ),\n              (\n                type.pos,\n                `It is incompatible with a tuple of size ${tyl.size()}`,\n              ),\n            ],\n          )\n        };\n        for (i in Range(0, arrPat.size())) {\n          this.bind(tcenv, kind, arrPat[i], tyl[i], isInitialized, false)\n        }\n      | _ ->\n        typingError(\n          Array[\n            (pos, \"Invalid tuple pattern\"),\n            (type.pos, `This is not a tuple, it is ${type}`),\n          ],\n        )\n      }\n\n    | PObject{fields => objectFields, rest} ->\n      fieldsToRemoveForRest = rest match {\n      | None() -> SortedSet[]\n      | Some(_name) ->\n        SortedSet::createFromItems(objectFields.map(f -> f.i0.value))\n      };\n      type.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n      | None() ->\n        typingError(\n          Array[(pos, \"Invalid object pattern\"), (type.pos, `This is ${type}`)],\n        )\n      | Some(stypes) ->\n        for (stype in stypes) {\n          (branches, typeForRest) = stype match {\n          | tobj @ TObject(fields, _) ->\n            (Array[fields], tobj.removeFields(fieldsToRemoveForRest))\n          | a @ TAlgebraic _ ->\n            (\n              a.branches.toArray().map(x -> x.fields),\n              a.removeFields(fieldsToRemoveForRest),\n            )\n          | _ ->\n            typingError(\n              Array[\n                (pos, \"Invalid object pattern\"),\n                (type.pos, `This is ${type}`),\n              ],\n            )\n          };\n          for (field in objectFields) {\n            (fieldName, fieldPat, fieldDefault) = field;\n            defaultOpt = fieldDefault.map(e ->\n              (e.pos, this.expr(tcenv, e, kind is BKConst()))\n            );\n            defaultIsUseless = fieldDefault.map(e -> e.pos);\n            typeForField = TType::bottom(fieldName.pos);\n            for (fields in branches) {\n              fields.maybeGet(fieldName.value) match {\n              | None() ->\n                typingError(\n                  Array[\n                    (fieldName.pos, `The field ${fieldName} is missing`),\n                    (type.pos, `Out of ${type}`),\n                  ],\n                )\n              | Some(tfield) ->\n                tfieldType = tfield.type;\n                if (tfield.isOptional) {\n                  !tfieldType = tfieldType.unionUndefined(\n                    tcenv.subst,\n                    this.tenv,\n                    tfield.pos,\n                  )\n                };\n                defaultOpt match {\n                | None() -> void\n                | Some((defaultPos, defaultType)) ->\n                  undefined = TType::single(\n                    TPrimUnit(TUndefined(), defaultPos),\n                  );\n                  if (\n                    tfield.isOptional ||\n                    isSubTType(\n                      tcenv.subst.clone(),\n                      this.tenv,\n                      undefined,\n                      tfieldType,\n                    ) is STOk()\n                  ) {\n                    !defaultIsUseless = None();\n                    !tfieldType = tfield.type.diff(undefined);\n                    !tfieldType = TType::union(\n                      tcenv.subst,\n                      this.tenv,\n                      tfieldType,\n                      defaultType,\n                    )\n                  }\n                };\n                !typeForField = TType::union(\n                  tcenv.subst,\n                  this.tenv,\n                  typeForField,\n                  tfieldType,\n                )\n              }\n            };\n            defaultIsUseless match {\n            | None() -> void\n            | Some(defaultPos) ->\n              typingError(\n                Array[\n                  (\n                    defaultPos,\n                    \"Default is useless because field cannot be undefined\",\n                  ),\n                ],\n              )\n            };\n            this.bind(tcenv, kind, fieldPat, typeForField, isInitialized, false)\n          };\n          rest.each(name ->\n            this.bind(\n              tcenv,\n              kind,\n              Pattern(name.pos, PVar(name)),\n              TType::single(typeForRest),\n              isInitialized,\n              false,\n            )\n          )\n        }\n      }\n    }\n  }\n\n  fun bindType(\n    pos: PosRange,\n    tcenv: mutable TCEnv,\n    kind: BindKind,\n    type: ?Type,\n    value: ?Expr,\n  ): (TType, Bool) {\n    value match {\n    | None() ->\n      if (kind is BKConst()) {\n        typingError(Array[(pos, \"Const must be bound to a value\")]);\n      };\n      type match {\n      | None() -> typingError(Array[(pos, \"Was expecting a type or a value\")])\n      | Some(annotAst) ->\n        ty = this.tenv.normalize(tcenv.context, annotAst);\n        (ty, false)\n      }\n    | Some(e) ->\n      ty = this.expr(tcenv, e, kind is BKConst());\n      type match {\n      | None() -> (ty, true)\n      | Some(annotAst) ->\n        annot = this.tenv.normalize(tcenv.context, annotAst);\n        this.checkSubType(tcenv, annotAst.pos, \"Invalid annotation\", ty, annot);\n        (annot, true)\n      }\n    }\n  }\n\n  /* Typechecks expression  obj.fieldName\n             or expression  obj?.fieldName  if optionalChaining is true\n       where obj has type objType */\n  fun dot(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    objType: TType,\n    fieldName: Name,\n    optionalChaining: Bool = false,\n  ): TType {\n    idx = Expr(fieldName.pos, EString(fieldName.value));\n    this.get(tcenv, pos, objType, idx, optionalChaining)\n  }\n\n  /* Typechecks expression  obj[idx]\n             or expression  obj.idx\n             or expression  obj?.idx  if optionalChaining is true\n     where obj has type objType\n\n     Try to keep in synch with TEnv#keyOfType\n  */\n  fun get(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    objType: TType,\n    idx: Expr,\n    optionalChaining: Bool = false,\n    allowConstructor: Bool = false,\n  ): TType {\n    stypes = objType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n    | Some(stypes) if (!stypes.isEmpty()) ->\n      Vector::mcreateFromIterator(stypes.values())\n    | _ ->\n      typingError(\n        Array[\n          (pos, `Invalid access for type ${prettyPrintType(false, objType)}`),\n        ],\n      )\n    };\n    idxType = this.expr(tcenv, idx, true);\n    idxSType = idxType\n      .getSTypes(tcenv.subst, this.tenv, Covariant())\n      .flatMap(stypes ~> stypes.singleElt()) match {\n    | Some(\n      TPrimValue(TString(), Some(values), _),\n    ) if (values.contains(\"constructor\") && !allowConstructor) ->\n      typingError(Array[(idx.pos, \"Cannot access field 'constructor'\")])\n    | Some(ty @ TPrimValue(TString(), _, _))\n    | Some(ty @ TPrimValue(TNum(), _, _)) ->\n      ty\n    | _ -> typingError(Array[(idx.pos, \"Invalid index type\")])\n    };\n    result = TType::bottom(pos);\n    optionalChainingIsUseless = optionalChaining;\n    optionalChainingIsAlwaysUndefined = optionalChaining;\n    while (!stypes.isEmpty()) {\n      stype = stypes.pop();\n\n      optionalChainingIsAlwaysUndefinedForThisSType = false;\n      stype match {\n      | TTuple(tyArr, tuplePos) ->\n        n = idxSType match {\n        | TPrimValue(TNum(), Some(numbers), _) ->\n          numbers.singleElt().flatMap(s -> s.i1.toIntOption())\n        | _ -> None()\n        } match {\n        | None() ->\n          typingError(\n            Array[\n              (idx.pos, \"Invalid index\"),\n              (tuplePos, \"A tuple expects a static index\"),\n            ],\n          )\n        | Some(x) -> x\n        };\n        !result = TType::union(tcenv.subst, this.tenv, result, tyArr[n])\n\n      | TObject(fields, objectPos) if (fields.isEmpty()) ->\n        !result = TType::top(objectPos)\n\n      | TObject(fields, objectPos) ->\n        idxSType.values match {\n        | None() -> Some(idxSType)\n        | Some(values) ->\n          values\n            .filter(posAndFieldName ->\n              fields.maybeGetType(\n                tcenv.subst,\n                this.tenv,\n                posAndFieldName.i1,\n                posAndFieldName.i0,\n              ) match {\n              | Some(ty) ->\n                !result = TType::union(tcenv.subst, this.tenv, result, ty);\n                false\n              | None() -> true\n              }\n            )\n            .map(remainingValues ->\n              idxSType with {values => Some(remainingValues)}\n            )\n        } match {\n        | None() -> void\n        | Some(remainingIdxSType) ->\n          fields.maybeSingleIndex() match {\n          | None() ->\n            remainingIdxSType.values match {\n            | None() ->\n              typingError(\n                Array[\n                  (pos, \"Invalid access\"),\n                  (\n                    idx.pos,\n                    `Index has non-literal type ${remainingIdxSType.kind}`,\n                  ),\n                  (objectPos, \"But object has no index field\"),\n                ],\n              )\n            | Some(values) ->\n              fields.getTypeTypingError(values.toStringList(), pos)\n            }\n          | Some(index) ->\n            this.checkSubType(\n              tcenv,\n              pos,\n              \"Invalid index key\",\n              TType::single(remainingIdxSType),\n              index.keyType,\n            );\n            ty = index.valueType.unionUndefined(tcenv.subst, this.tenv, pos);\n            !result = TType::union(tcenv.subst, this.tenv, result, ty)\n          }\n        }\n\n      | TAlgebraic(branches, _) ->\n        idxSType match {\n        | TPrimValue(TString(), Some(values), _) -> values.singleElt()\n        | _ -> None()\n        } match {\n        | None() ->\n          typingError(\n            Array[\n              (idx.pos, \"Invalid index\"),\n              (pos, \"An algebraic expects a static index\"),\n            ],\n          )\n        | Some((p, fieldName)) ->\n          for (branch in branches) {\n            !result = TType::union(\n              tcenv.subst,\n              this.tenv,\n              result,\n              branch.getType(tcenv.subst, this.tenv, fieldName, p),\n            )\n          }\n        }\n\n      | prim @ TPrimValue _ ->\n        obj = this.tenv.newObject(tcenv.context, prim.asClassName(), Array[]);\n        stypes.push(obj)\n\n      | TPrimUnit(TUndefined(), undefPos)\n      | TPrimUnit(\n        TNull(),\n        undefPos,\n      ) if (optionalChaining) ->\n        !optionalChainingIsUseless = false;\n        !optionalChainingIsAlwaysUndefinedForThisSType = true;\n        !result = result.unionUndefined(tcenv.subst, this.tenv, undefPos)\n\n      | _ ->\n        typingError(\n          Array[\n            (pos, \"Type cannot be accessed\"),\n            (\n              idxType.pos,\n              \"This is a \" + prettyPrintType(false, TType::single(stype)),\n            ),\n          ],\n        )\n      };\n      !optionalChainingIsAlwaysUndefined =\n        optionalChainingIsAlwaysUndefined &&\n        optionalChainingIsAlwaysUndefinedForThisSType;\n    };\n    if (optionalChainingIsUseless) {\n      typingError(\n        Array[\n          (pos, \"Useless '?.'. Use '.' instead\"),\n          (objType.pos, `${objType} is never null nor undefined`),\n        ],\n      )\n    };\n    if (optionalChainingIsAlwaysUndefined) {\n      typingError(\n        Array[\n          (pos, \"Result of optional chaining is always undefined\"),\n          (objType.pos, `${objType} is always null or undefined`),\n        ],\n      )\n    };\n    result\n  }\n\n  fun nonVoidExpr(pos: PosRange, tcenv: mutable TCEnv, e: Expr): TType {\n    ty = this.expr(tcenv, e);\n    if (this.nonTopContainsVoid(tcenv, ty)) {\n      typingError(\n        Array[\n          (pos, \"Invalid operation on type void\"),\n          (e.pos, `This expression has type ${ty}`),\n        ],\n      )\n    };\n    ty\n  }\n\n  /* Typechecks expression e\n     If mostPrecise, use the most precise type. */\n  fun expr(tcenv: mutable TCEnv, e: Expr, mostPrecise: Bool = false): TType {\n    if (mostPrecise) {\n      this.asConstExpr(e) match {\n      | Some(ty) -> return ty\n      | None() -> void\n      }\n    };\n\n    pos = e.pos;\n    e.value match {\n    | Number(_) -> TType::single(TPrimValue::number(pos))\n    | BigInt(_) -> TType::single(TPrimValue::bigint(pos))\n    | EString(_) -> TType::single(TPrimValue::string(pos))\n    | TemplateLiteral(_parts, exprs) ->\n      // Type check all embedded expressions - allow primitive types that can be converted to strings\n      strType = TType::single(TPrimValue::string(pos));\n      for (expr in exprs) {\n        ety = this.expr(tcenv, expr);\n        this.checkStringifiable(tcenv, expr.pos, ety);\n      };\n      strType\n\n    | Var(Name(_, \"true\"))\n    | Var(Name(_, \"false\")) ->\n      TType::single(TPrimValue::boolean(pos))\n    | Var(Name(_, \"null\")) ->\n      this.makeBoundTVar(tcenv, TType::single(TPrimUnit(TNull(), pos)))\n    | Var(Name(_, \"undefined\")) ->\n      this.makeBoundTVar(tcenv, TType::single(TPrimUnit(TUndefined(), pos)))\n    | Var(local) ->\n      if (tcenv.localObjects.containsKey(local.value)) {\n        tcenv.localObjects![local.value] = LOUsed(local.pos)\n      };\n      tcenv.scope.maybeGet(local) match {\n      | None() ->\n        defs = if (this.builtins.contains(local.value)) {\n          this.defMap.get(tcenv.context, this.builtinsFileName, local)\n        } else {\n          this.defMap.get(\n            tcenv.context,\n            FileName::create(local.pos.fileName),\n            local,\n          )\n        };\n        for (def in defs) {\n          def.value match {\n          | fd @ FunDef _ ->\n            break this.tenv.funDecl(\n              tcenv.context,\n              false,\n              fd,\n              fd.cgNode match {\n              | Some(n) -> n\n              | None() -> CGNode::create(AnonymousFunDef(fd))\n              },\n            ).i1\n          | c @ Class _ ->\n            staticClass = this.tenv.newStatic(tcenv.context, c.name);\n            break staticClass\n          | VarDefs(kind, varDefArr) ->\n            if (varDefArr.size() != 1) {\n              internal_error(\"varDefArr size should be 1\")\n            };\n            varDef = varDefArr[0];\n            if (!(kind is VDKConst _)) {\n              typingError(\n                Array[(varDef.pat.pos, \"Construction not supported\")],\n              );\n            };\n            if (!(varDef.pat is Pattern(_, PVar _))) {\n              typingError(\n                Array[(varDef.pat.pos, \"Construction not supported\")],\n              );\n            };\n            break varDef.type match {\n            | None() ->\n              varDef.value match {\n              | None() -> None()\n              | Some(x) -> this.asConstExpr(x)\n              } match {\n              | None() -> this.newTVar(tcenv, pos)\n              | Some(ty) -> ty\n              }\n            | Some(ty) -> this.tenv.normalize(tcenv.context, ty)\n            }\n          | _ -> void\n          }\n        } else {\n          typingError(Array[(pos, \"Unbound name\")])\n        }\n      | Some(localDef) -> localDef\n      }\n    | Object(efields) ->\n      algebraicBranchField: ?(PosRange, TType) = None();\n      fields = mutable Map[];\n      indexes = mutable Vector[];\n      for (efield in efields) {\n        (name, ty) = efield match {\n        | FDNormal(name, y) ->\n          if (name.value == \"constructor\") {\n            typingError(Array[(name.pos, `Forbidden field name: ${name}`)])\n          };\n          (name, this.expr(tcenv, y, name.value == kAlgebraicBranchFieldName))\n\n        | FDSpread(spreadExpr) ->\n          spreadTy = this.expr(tcenv, spreadExpr);\n          spreadTy.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n          | None() ->\n            typingError(\n              Array[\n                (spreadExpr.pos, \"Invalid spread\"),\n                (spreadTy.pos, \"This has type unknown\"),\n              ],\n            )\n          | Some(spreadSTypes) ->\n            for (spreadSType in spreadSTypes) {\n              spreadSType match {\n              | TObject(TFields(spreadFields, spreadIndexes), _pos) ->\n                for (spreadField in spreadFields) {\n                  fields![spreadField.name] = spreadField\n                };\n                for (spreadIndex in spreadIndexes) {\n                  indexes.push(spreadIndex)\n                }\n              | _ ->\n                typingError(\n                  Array[\n                    (spreadExpr.pos, \"Invalid spread\"),\n                    (spreadTy.pos, `This has type ${spreadTy}`),\n                  ],\n                )\n              }\n            }\n          };\n          continue\n        | fd @ FunDef _ ->\n          cgNode = CGNode::create(AnonymousFunDef(fd));\n          this.tenv.funDecl(tcenv.context, true, fd, cgNode)\n        };\n        TField::create(name.pos, name.value, false, ty) match {\n        | None() ->\n          algebraicBranchField match {\n          | Some((existingPos, _existingType)) ->\n            typingError(\n              Array[\n                (name.pos, `Duplicate field ${name}`),\n                (existingPos, \"Previously declared here\"),\n              ],\n            )\n          | None() -> void\n          };\n          !algebraicBranchField = Some((name.pos, ty))\n        | Some(field) -> fields![name.value] = field\n        }\n      };\n      obj = createObject(\n        pos,\n        algebraicBranchField,\n        TFields::create(fields.values().collect(Array), indexes.toArray()),\n      );\n      for (efield in efields) {\n        efield match {\n        | fd @ FunDef _ ->\n          cgNode = CGNode::create(AnonymousFunDef(fd));\n          this.funDef(tcenv.subst, Some((CKClass(), obj)), fd, cgNode)\n        | _ -> void\n        }\n      };\n      obj\n    | Call(Expr(_, Var(Name(superPos, \"super\"))), targs, args) ->\n      this.super match {\n      | None() -> typingError(Array[(superPos, \"'super' is not defined\")])\n      | Some((superCstr, super)) ->\n        if (targs.size() != 0) {\n          typingError(\n            Array[(pos, \"super cannot be called with type arguments\")],\n          );\n        };\n        this.callConstructor(\n          tcenv,\n          pos,\n          superCstr,\n          args.map(x -> this.expr(tcenv, x)),\n        );\n        thisName = Name(pos, \"this\");\n        thisType = TType::inter(\n          tcenv.subst,\n          this.tenv,\n          tcenv.scope.get(thisName),\n          super,\n        );\n        tcenv.scope.set(thisName, thisType, (x, y) -> {\n          this.checkSubType(tcenv, pos, \"Invalid super call\", x, y)\n        })\n      };\n      TType::single(TPrimUnit(TVoid(), pos))\n\n    | Call(Expr(_, Var(Name(_, \"__SKJS_show\"))), _, args) ->\n      exprTy = this.expr(tcenv, args[0]);\n      ty = exprTy.expand(tcenv.subst.clone(), this.tenv, Covariant());\n      print_error(prettyPrintType(false, ty));\n      TType::single(TPrimUnit(TVoid(), pos))\n    | Call(f, targs, args) ->\n      rty = this.call(\n        tcenv,\n        pos,\n        this.expr(tcenv, f),\n        targs.map(ty -> this.tenv.normalize(tcenv.context, ty)),\n        args.map(x -> this.expr(tcenv, x)),\n      );\n      f.value match {\n      | Binop(\n        BODot(),\n        Expr(_, Var(Name(_, \"console\"))),\n        Expr(_, Var(Name(_, \"assert\"))),\n      ) if (args.size() >= 1) ->\n        this.evalCond(tcenv, args[0], true)\n      | _ -> void\n      };\n      rty\n    | New(\n      className,\n      targsAst,\n      argsAst,\n    ) if (tcenv.scope.maybeGet(className) is Some _) ->\n      cstr = this.get(\n        tcenv,\n        pos,\n        this.expr(tcenv, Expr(pos, Var(className))),\n        Expr(pos, EString(\"constructor\")),\n        false,\n        true,\n      );\n      this.call(\n        tcenv,\n        pos,\n        cstr,\n        targsAst.map(x -> this.tenv.normalize(tcenv.context, x)),\n        argsAst.map(x -> this.expr(tcenv, x)),\n      )\n\n    | New(className, targsAst, argsAst) ->\n      targs = if (targsAst.size() == 0) {\n        this.tenv.makeTArgs(tcenv.context, tcenv.subst, className)\n      } else {\n        targsAst.map(targ -> this.tenv.normalize(tcenv.context, targ))\n      };\n      cstr = this.tenv.newConstructor(tcenv.context, className, targs);\n      this.callConstructor(\n        tcenv,\n        pos,\n        cstr,\n        argsAst.map(e -> this.expr(tcenv, e)),\n      );\n      this.tenv.new(tcenv.context, className, targs)\n\n    | Get(arr, idx) -> this.get(tcenv, pos, this.expr(tcenv, arr), idx)\n\n    | EArray(arr) ->\n      TType::single(TTuple(arr.map(x -> this.expr(tcenv, x)), pos))\n\n    | Unop(uop, subExpr) ->\n      uop match {\n      | UOExclamationMark() ->\n        bool = TType::single(TPrimValue::boolean(pos));\n        this.checkSubType(\n          tcenv,\n          pos,\n          \"Invalid !\",\n          this.expr(tcenv, subExpr),\n          bool,\n        );\n        bool\n      | _ -> typingError(Array[(pos, \"TODO: unary operator\")])\n      }\n\n    | Binop(op, e1, e2) ->\n      op match {\n      | BOAddition() ->\n        ty1 = this.expr(tcenv, e1);\n        ty1.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n          stypes.singleElt()\n        ) match {\n        | Some(TPrimValue(k @ TNum(), _, primPos))\n        | Some(TPrimValue(k @ TString(), _, primPos))\n        | Some(TPrimValue(k @ TBigInt(), _, primPos)) ->\n          ty2 = this.expr(tcenv, e2);\n          res = TType::single(TPrimValue::full(k, primPos));\n          this.checkSubType(tcenv, e2.pos, \"Invalid + operand\", ty2, res);\n          res\n        | _ ->\n          typingError(\n            Array[\n              (pos, \"Invalid + operation\"),\n              (e1.pos, `For an object of type: ${ty1}`),\n            ],\n          )\n        }\n      | BOAssignment() -> this.assign(tcenv, pos, e1, e2)\n      | op_ @ BOStrictComparison() ->\n        ty1 = this.nonVoidExpr(pos, tcenv, e1);\n        ty2 = this.nonVoidExpr(pos, tcenv, e2);\n        if (ty1.clauses.clauses.isEmpty() && ty2.clauses.clauses.isEmpty()) {\n          isSubTType(tcenv.subst, this.tenv, ty1, ty2) match {\n          | STOk() -> void\n          | STError _ ->\n            isSubTType(tcenv.subst, this.tenv, ty2, ty1) match {\n            | STOk() -> void\n            | STError _ ->\n              alwaysResult = op_ match {\n              | BOStrictEquality() -> \"false\"\n              | BOStrictInequality() -> \"true\"\n              };\n              typingError(\n                Array[(pos, \"This is equality is always \" + alwaysResult)],\n              )\n            }\n          }\n        };\n        TType::single(TPrimValue::boolean(pos))\n\n      | BOLogicalAnd() ->\n        ty1 = this.expr(tcenv, e1);\n        this.checkSubType(\n          tcenv,\n          pos,\n          \"Invalid &&\",\n          ty1,\n          TType::single(TPrimValue::boolean(e1.pos)),\n        );\n        this.evalCond(tcenv, e1, true);\n        ty2 = this.expr(tcenv, e2);\n        this.checkSubType(\n          tcenv,\n          pos,\n          \"Invalid &&\",\n          ty2,\n          TType::single(TPrimValue::boolean(e2.pos)),\n        );\n        TType::single(TPrimValue::boolean(pos))\n      | BOLogicalOr() ->\n        ty1 = this.expr(tcenv, e1);\n        this.checkSubType(\n          tcenv,\n          pos,\n          \"Invalid ||\",\n          ty1,\n          TType::single(TPrimValue::boolean(e1.pos)),\n        );\n        this.evalCond(tcenv, e1, false);\n        ty2 = this.expr(tcenv, e2);\n        this.checkSubType(\n          tcenv,\n          pos,\n          \"Invalid ||\",\n          ty2,\n          TType::single(TPrimValue::boolean(e2.pos)),\n        );\n        TType::single(TPrimValue::boolean(pos))\n\n      | BODot() ->\n        e2.value match {\n        | Var(fieldName) ->\n          this.dot(tcenv, e1.pos, this.expr(tcenv, e1), fieldName)\n        | _ -> typingError(Array[(e2.pos, \"Invalid '.'\")])\n        }\n\n      | BOOptionalDot() ->\n        e2.value match {\n        | Var(fieldName) ->\n          this.dot(\n            tcenv,\n            e1.pos,\n            this.expr(tcenv, e1),\n            fieldName,\n            true/* optionalChaining */ ,\n          )\n        | _ -> typingError(Array[(e2.pos, \"Invalid '?.'\")])\n        }\n\n      | BOExclamationMarkDot() -> notSupported(pos)\n\n      | BOLessThan()\n      | BOLessThanOrEqual()\n      | BOGreaterThan()\n      | BOGreaterThanOrEqual() ->\n        getExprPrimKind = (e) -> {\n          ty = this.expr(tcenv, e);\n          ty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n            stypes.singleElt()\n          ) match {\n          | Some(TPrimValue(k, _, _)) -> k\n          | _ ->\n            typingError(\n              Array[\n                (\n                  pos,\n                  \"Invalid comparison. You can only compare strings, numbers, bigints, and booleans.\",\n                ),\n                (e1.pos, `This is a ${ty}`),\n              ],\n            )\n          }\n        };\n        kind1 = getExprPrimKind(e1);\n        kind2 = getExprPrimKind(e2);\n        if (kind1 != kind2) {\n          typingError(\n            Array[\n              (\n                pos,\n                \"Invalid comparison. Both operands must have the same type.\",\n              ),\n              (e1.pos, `This is a ${kind1}`),\n              (e2.pos, `This is a ${kind2}`),\n            ],\n          )\n        };\n        TType::single(TPrimValue::boolean(pos))\n\n      | BOOpAssignment(assOp) ->\n        this.expr(\n          tcenv,\n          Expr(pos, Binop(BOAssignment(), e1, Expr(pos, Binop(assOp, e1, e2)))),\n        )\n\n      | BOMultiplication()\n      | BODivision()\n      | BORemainder()\n      | BOSubtraction()\n      | BOBitwiseAnd()\n      | BOBitwiseOr()\n      | BOBitwiseXor()\n      | BOLeftShift()\n      | BOSignedRightShift()\n      | BOZeroFilledRightShift() ->\n        ty1 = this.expr(tcenv, e1);\n        kind1 = this.checkIsNumeric(tcenv, e1.pos, \"Invalid operation\", ty1);\n        ty2 = this.expr(tcenv, e2);\n        kind2 = this.checkIsNumeric(tcenv, e2.pos, \"Invalid operation\", ty2);\n        if (kind1 != kind2) {\n          typingError(\n            Array[\n              (\n                pos,\n                \"Arithmetic operations require both operands to be the same numeric type\",\n              ),\n              (e1.pos, `Left operand is ${kind1}`),\n              (e2.pos, `Right operand is ${kind2}`),\n            ],\n          )\n        };\n        TType::single(TPrimValue::full(kind1, pos))\n\n      | BONullishCoalescing() ->\n        ty1 = this.nonVoidExpr(pos, tcenv, e1);\n        ty2 = this.expr(tcenv, e2);\n        ty1.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n        | None() -> void\n        | Some(stypes) ->\n          hasVoid = false;\n          hasNullOrUndefined = false;\n          hasOthers = false;\n          for (stype in stypes) {\n            stype match {\n            | TPrimUnit(TVoid(), _) -> !hasVoid = true\n            | TPrimUnit(TNull(), _)\n            | TPrimUnit(TUndefined(), _) ->\n              !hasNullOrUndefined = true\n            | _ -> !hasOthers = true\n            }\n          };\n          if (hasVoid) {\n            typingError(\n              Array[\n                (pos, \"Invalid operation on type void\"),\n                (e1.pos, `This expression has type ${ty1}`),\n              ],\n            )\n          };\n          if (!hasNullOrUndefined) {\n            typingError(\n              Array[\n                (pos, \"This operator is useless\"),\n                (e1.pos, \"This construction is never null or undefined\"),\n              ],\n            );\n          };\n          if (!hasOthers) {\n            typingError(\n              Array[\n                (pos, \"This operator is useless\"),\n                (e.pos, \"This constructor is always null or undefined\"),\n              ],\n            )\n          }\n        };\n        nullish = TType::union(\n          tcenv.subst,\n          this.tenv,\n          TType::single(TPrimUnit(TNull(), pos)),\n          TType::single(TPrimUnit(TUndefined(), pos)),\n        );\n        ty1WithoutNullish = ty1.diff(nullish);\n        TType::union(tcenv.subst, this.tenv, ty1WithoutNullish, ty2)\n      }\n\n    | InstanceOf(e1, Expr(_, Var(className))) ->\n      _ = this.expr(tcenv, e1);\n      _ = this.tenv.getClass(tcenv.context, className);\n      TType::single(TPrimValue::boolean(pos))\n    | InstanceOf(_, e2) -> typingError(Array[(e2.pos, \"Unexpected instanceof\")])\n    | In(e1, e2) ->\n      (t1, fieldsOpt) = this.getInLhsTypeAndFields(tcenv, pos, e1);\n      t2 = this.expr(tcenv, e2, true);\n      t2.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n      | None() ->\n        typingError(\n          Array[(pos, \"Invalid in\"), (e2.pos, \"This has type unknown\")],\n        )\n      | Some(stypes2) ->\n        canBeTrue = false;\n        canBeFalse = false;\n        for (stype2 in stypes2) {\n          stype2 match {\n          | TPrimUnit _\n          | TPrimValue _ ->\n            typingError(\n              Array[(pos, \"Invalid in\"), (e2.pos, `This has type ${t2}`)],\n            )\n          | TObject(TFields(fields, indexes), _pos) ->\n            !canBeTrue = true; // object types are open\n            !canBeFalse =\n              canBeFalse ||\n              !indexes.isEmpty() /* TODO: refine */ ||\n              fieldsOpt match {\n              | None() -> true\n              | Some(fieldsToCheck) ->\n                fieldsToCheck.values.any(fieldToCheck ->\n                  fields.maybeGet(fieldToCheck.i1) match {\n                  | Some(tField) -> tField.isOptional\n                  | None() -> true\n                  }\n                )\n              }\n          | TTuple _\n          | TPromise _\n          | TAlgebraic _\n          | TFuns _ ->\n            typingError(Array[(pos, \"TODO: in\"), (e2.pos, `For type ${t2}`)])\n          }\n        };\n        (canBeTrue, canBeFalse) match {\n        | (true, true) -> TType::single(TPrimValue::boolean(pos))\n        | (false, false) ->\n          typingError(\n            Array[\n              (pos, \"Unexpected in\"),\n              (e1.pos, `This has type ${t1}`),\n              (e2.pos, `This has type ${t2}`),\n            ],\n          )\n        | _ ->\n          typingError(Array[(pos, `This expression is always ${canBeTrue}`)])\n        }\n      }\n    | TypeOf(subExpr) ->\n      _ = this.nonVoidExpr(pos, tcenv, subExpr);\n      TType::single(TPrimValue::string(pos))\n\n    | PostOp(pop, subExpr) ->\n      pop match {\n      | PODecr()\n      | POIncr() ->\n        num = TType::single(TPrimValue::number(pos));\n        ty = this.expr(tcenv, subExpr);\n        this.checkSubType(tcenv, pos, \"Expected integer\", ty, num);\n        num\n      | POExcl() -> notSupported(pos)\n      }\n\n    | c @ Closure(params, retTypeAstOpt, body) ->\n      this.anonFunction(tcenv, None(), pos, c, params, retTypeAstOpt, body)\n    | Async(Expr(closurePos, c @ Closure(params, retTypeAstOpt, body))) ->\n      this.anonFunction(\n        tcenv,\n        Some(pos),\n        closurePos,\n        c,\n        params,\n        retTypeAstOpt,\n        body,\n      )\n    | As _ -> notSupported(pos)\n    | Async _ -> typingError(Array[(pos, \"Invalid async\")])\n    | Await(ae) ->\n      aeType = this.expr(tcenv, ae);\n      aeType.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n        stypes.singleElt()\n      ) match {\n      | Some(TPromise(ty, _)) -> ty\n      | _ ->\n        typingError(\n          Array[(pos, \"Invalid await\"), (aeType.pos, \"This is not a promise\")],\n        )\n      }\n    | EIf(e1, e2, e3) ->\n      cond = this.expr(tcenv, e1);\n      this.checkSubType(\n        tcenv,\n        e1.pos,\n        \"Invalid ? condition\",\n        cond,\n        TType::single(TPrimValue::boolean(e1.pos)),\n      );\n\n      // Create scopes for the true and false branches with type refinements\n      scopeCopy = tcenv.scope;\n\n      // True branch - evaluate e2 with refinements from e1 being true\n      trueScope = tcenv.mcreateSubScope{isLoop => false};\n      tcenv.!scope = trueScope;\n      this.evalCond(tcenv, e1, true);\n      left = this.expr(tcenv, e2);\n      tcenv.!scope = scopeCopy;\n\n      // False branch - evaluate e3 with refinements from e1 being false\n      falseScope = tcenv.mcreateSubScope{isLoop => false};\n      tcenv.!scope = falseScope;\n      this.evalCond(tcenv, e1, false);\n      right = this.expr(tcenv, e3);\n      tcenv.!scope = scopeCopy;\n\n      TType::union(tcenv.subst, this.tenv, left, right)\n    | AsConst(subExpr) ->\n      this.asConstExpr(subExpr) match {\n      | Some(ty) -> ty\n      | None() ->\n        typingError(\n          Array[(pos, \"'as const' can only be used with string literals\")],\n        )\n      }\n    | Params _ -> paramsError(pos)\n    | Regexp _ -> typingError(Array[(pos, \"TODO: regexp\")])\n    | Spread _ -> typingError(Array[(pos, \"TODO: ...\")])\n    }\n  }\n\n  fun anonFunction(\n    tcenv: mutable TCEnv,\n    isAsync: ?PosRange,\n    pos: PosRange,\n    c: Closure,\n    params: Array<(Name, ?Type)>,\n    retTypeAstOpt: ?Type,\n    body: ClosureBody,\n  ): TType {\n    paramTypes = mutable Vector[];\n    for (param in params) {\n      paramType = param.i1 match {\n      | None() ->\n        typingError(Array[(param.i0.pos, \"Please add a type annotation\")])\n      | Some(ty) -> this.tenv.normalize(tcenv.context, ty)\n      };\n      paramTypes.push((param.i0, paramType));\n    };\n    retType = retTypeAstOpt match {\n    | None() ->\n      tvar = this.newTVar(tcenv, pos);\n      isAsync match {\n      | None() -> tvar\n      | Some(asyncPos) -> TType::single(TPromise(tvar, asyncPos))\n      }\n    | Some(retTypeAst) -> this.tenv.normalize(tcenv.context, retTypeAst)\n    };\n    callingContext = CGNode::create(AnonymousLambda(pos, c));\n    // Register a dependency from parent context on this lambda\n    recordCalls(\n      tcenv.context,\n      tcenv.callingContext,\n      CGNodes::singleton(callingContext),\n    );\n    savedScope = tcenv.scope;\n    savedCallingContext = tcenv.callingContext;\n    tcenv.!scope = tcenv.mcreateSubScope{isLoop => false};\n    tcenv.!callingContext = callingContext;\n\n    this.closure(tcenv, isAsync, paramTypes.toArray(), retType, body);\n\n    tcenv.!scope = savedScope;\n    tcenv.!callingContext = savedCallingContext;\n\n    TType::single(\n      TFuns::singleFun(\n        TFun(\n          Array[],\n          paramTypes.map(x -> x.i1).toArray(),\n          Array[],\n          None(),\n          pos,\n          retType,\n          CGNodes::singleton(callingContext),\n        ),\n        pos,\n      ),\n    )\n  }\n\n  /* Typechecks expression e as const */\n  fun asConstExpr(e: Expr): ?TType {\n    pos = e.pos;\n    e.value match {\n    | AsConst(subExpr) ->\n      typingError(Array[(subExpr.pos, \"Unnecessary 'as const'\")])\n    | Var(Name(_, \"null\")) -> Some(TType::single(TPrimUnit(TNull(), pos)))\n    | Var(Name(_, \"undefined\")) ->\n      Some(TType::single(TPrimUnit(TUndefined(), pos)))\n    | Number(n) -> Some(TType::single(TPrimValue::single(TNum(), n, pos)))\n    | BigInt(n) -> Some(TType::single(TPrimValue::single(TBigInt(), n, pos)))\n    | Var(Name(_, \"true\")) ->\n      Some(TType::single(TPrimValue::single(TBool(), \"true\", pos)))\n    | Var(Name(_, \"false\")) ->\n      Some(TType::single(TPrimValue::single(TBool(), \"false\", pos)))\n    | EString(n) -> Some(TType::single(TPrimValue::single(TString(), n, pos)))\n    | _ -> None()\n    }\n  }\n\n  fun closure(\n    tcenv: mutable TCEnv,\n    isAsync: ?PosRange,\n    params: Array<(Name, TType)>,\n    retType: TType,\n    body: ClosureBody,\n  ): void {\n    for (param in params) {\n      tcenv.scope.bind(param.i0, param.i1, true)\n    };\n    body match {\n    | CBExpr(e) ->\n      this.checkSubType(\n        tcenv,\n        e.pos,\n        \"Invalid callback return\",\n        isAsync match {\n        | None() -> this.expr(tcenv, e)\n        | Some(asyncPos) ->\n          TType::single(TPromise(this.expr(tcenv, e), asyncPos))\n        },\n        retType,\n      )\n    | CBBlock(bl) ->\n      if (isAsync is Some _) !this.isAsync = true;\n      !this.retType = Some(retType);\n      _ = this.block(tcenv, bl)\n    }\n  }\n\n  fun callConstructor(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    cstrType: CstrType,\n    args: Array<TType>,\n  ): void {\n    cstrType.cstr match {\n    | None() ->\n      if (args.size() == 0) return void;\n      typingError(Array[(pos, \"Invalid new: constructor expects no arguments\")])\n    | Some(cstr) -> _ = this.call(tcenv, pos, cstr, Array[], args)\n    }\n  }\n\n  fun assign(tcenv: mutable TCEnv, pos: PosRange, e1: Expr, e2: Expr): TType {\n    this.checkLValue(e1);\n    e1.value match {\n    | Var(n) ->\n      ty2 = this.expr(tcenv, e2);\n      tcenv.scope.set(n, ty2, (x, y) ->\n        this.checkSubType(tcenv, pos, \"Invalid assignment\", x, y)\n      );\n      ty2\n    | Binop(\n      BODot(),\n      Expr(_, Var(local)),\n      Expr(_, Var(fieldName)),\n    ) if (tcenv.localObjects.containsKey(local.value)) ->\n      fieldType = this.expr(tcenv, e2);\n      used = tcenv.localObjects[local.value] match {\n      | LOCanGrow(bound) ->\n        bound match {\n        | None() -> void\n        | Some(objectType) ->\n          this.checkSubType(\n            tcenv,\n            e2.pos,\n            \"Invalid assignment\",\n            fieldType,\n            this.dot(tcenv, e1.pos, objectType, fieldName),\n          )\n        };\n        None()\n      | LOUsed(usedPos) -> Some(usedPos)\n      };\n      this.assignLocalObject(tcenv, pos, local, fieldName, fieldType, used)\n    | _ ->\n      ty1 = this.expr(tcenv, e1);\n      ty2 = this.expr(tcenv, e2);\n      this.checkSubType(tcenv, e2.pos, \"Invalid assignment\", ty2, ty1);\n      ty1\n    }\n  }\n\n  fun assignLocalObject(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    local: Name,\n    fieldName: Name,\n    fieldType: TType,\n    used: ?PosRange,\n  ): TType {\n    objField = tcenv.scope\n      .get(local)\n      .getSTypes(tcenv.subst, this.tenv, Covariant())\n      .flatMap(stypes ~> stypes.singleElt()) match {\n    | Some(TObject(fields, objPos)) ->\n      fields.maybeGet(fieldName.value) match {\n      | None() ->\n        used match {\n        | None() -> void\n        | Some(usedPos) ->\n          typingError(\n            Array[\n              (pos, \"You are trying to add a field to this object\"),\n              (\n                usedPos,\n                \"But this object has been already been used for something else\",\n              ),\n            ],\n          )\n        };\n        if (tcenv.scope.isThroughLoop(local)) {\n          typingError(\n            Array[(local.pos, \"You cannot add a field to an object in a loop\")],\n          )\n        };\n        field = TField::create(\n          fieldType.pos,\n          fieldName.value,\n          false,\n          fieldType,\n        ) match {\n        | None() -> internal_error(\"TODO: converting an object to an algebraic\")\n        | Some(f) -> f\n        };\n        tcenv.scope.set(\n          local,\n          TType::single(\n            TObject(\n              interTFields(\n                tcenv.subst,\n                this.tenv,\n                fields,\n                TFields::create(Array[field], Array[]),\n              ),\n              objPos,\n            ),\n          ),\n          (x, y) -> {\n            this.checkSubType(tcenv, fieldType.pos, \"Invalid assignment\", x, y)\n          },\n        );\n        fieldType\n      | Some(fd) -> fd.type\n      }\n    | _ -> internal_error(\"Internal error: local object is not an object\")\n    };\n    this.checkSubType(\n      tcenv,\n      fieldType.pos,\n      \"Invalid assignment\",\n      fieldType,\n      objField,\n    );\n    fieldType\n  }\n\n  fun getArrayEltType(tcenv: mutable TCEnv, object: TObject): TType {\n    object.fields.maybeGet(\"pop\") match {\n    | None() -> typingError(Array[(object.pos, \"Expected an Array type\")])\n    | Some(popMethod) ->\n      popF = popMethod.type\n        .getSTypes(tcenv.subst, this.tenv, Covariant())\n        .flatMap(stypes ~> stypes.singleElt())\n        .fromSome() match {\n      | TFuns(_, methods, _) ->\n        for (met in methods) {\n          break met\n        } else {\n          internal_error(\"Unexpected type for Array::pop\")\n        }\n      | _ -> internal_error(\"Unexpected pop method type for\")\n      };\n      popF.retType\n    };\n  }\n\n  fun getInLhsTypeAndFields(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    e1: Expr,\n  ): (TType, ?ArrayValues) {\n    t1 = this.expr(tcenv, e1, true);\n    t1.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n    | None() ->\n      typingError(Array[(pos, \"Invalid in\"), (e1.pos, \"This has type unknown\")])\n    | Some(stypes1) ->\n      fieldsOptOpt: ??ArrayValues = None();\n      for (stype1 in stypes1) {\n        stype1 match {\n        | TPrimValue(TNum(), values, _pos)\n        | TPrimValue(TString(), values, _pos) ->\n          (fieldsOptOpt, values) match {\n          | (Some(None()), _) -> void\n          | (None(), _)\n          | (Some(Some(_)), None()) ->\n            !fieldsOptOpt = Some(values)\n          | (Some(Some(existingFields)), Some(moreValues)) ->\n            !fieldsOptOpt = Some(Some(existingFields.union(moreValues)))\n          }\n        | _ ->\n          typingError(\n            Array[(pos, \"Invalid in\"), (e1.pos, `This has type ${t1}`)],\n          )\n        }\n      };\n      fieldsOptOpt\n    } match {\n    | None() ->\n      typingError(Array[(pos, \"Invalid in\"), (e1.pos, `This has type ${t1}`)])\n    | Some(fieldsOpt) -> (t1, fieldsOpt)\n    }\n  }\n\n  fun call(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    fty: TType,\n    targs: Array<TType>,\n    args: Array<TType>,\n  ): TType {\n    result: ?TType = None();\n    fty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n      stypes.singleElt()\n    ) match {\n    | Some(TFuns(funs, methods, _)) ->\n      for (tfun in funs.values().concat(methods.values())) {\n        recordCalls(tcenv.context, tcenv.callingContext, tfun.cgNodes);\n        if (targs.size() != 0 && targs.size() != tfun.tparams.size()) {\n          typingError(\n            Array[\n              (\n                pos,\n                \"Incompatible number of type arguments: \" +\n                  targs.size() +\n                  \" passed\",\n              ),\n              (fty.pos, \"Expected: \" + tfun.tparams.size()),\n            ],\n          )\n        };\n        map = SortedMap[];\n        for (i => tparamDecl in tfun.tparams) {\n          !map[tparamDecl.id] = if (targs.isEmpty()) {\n            this.newTVar(tcenv, pos)\n          } else {\n            targs[i]\n          };\n        };\n        !tfun = (mutable Instantiate()).fun_(\n          (tcenv.subst, this.tenv, map.chill()),\n          tfun with {tparams => Array[]},\n        );\n        version = tcenv.subst.version;\n        loop {\n          for (i in Range(0, tfun.params.size())) {\n            if (i >= args.size()) {\n              typingError(\n                Array[\n                  (pos, \"Invalid call\"),\n                  (\n                    fty.pos,\n                    \"This function has \" + tfun.params.size() + \" parameters\",\n                  ),\n                ],\n              )\n            };\n            this.checkSubType(\n              tcenv,\n              pos,\n              \"Invalid call\",\n              args[i],\n              tfun.params[i],\n            )\n          };\n          for (j in Range(0, tfun.optionalParams.size())) {\n            i = tfun.params.size() + j;\n            if (i >= args.size()) break void;\n            this.checkSubType(\n              tcenv,\n              pos,\n              \"Invalid call\",\n              args[i],\n              tfun.optionalParams[j],\n            )\n          };\n          if (tcenv.subst.version == version) break void;\n          !version = tcenv.subst.version;\n        };\n        totalSize = tfun.params.size() + tfun.optionalParams.size();\n        if (totalSize < args.size()) {\n          tfun.spreadParam match {\n          | None() ->\n            typingError(\n              Array[\n                (pos, \"Too many arguments\"),\n                (tfun.minSizeWitness, \"For this function\"),\n              ],\n            )\n          | Some(spreadType) ->\n            spreadType\n              .getSTypes(tcenv.subst, this.tenv, Contravariant())\n              .flatMap(stypes ~> stypes.singleElt()) match {\n            | Some(object @ TObject _) ->\n              eltType = this.getArrayEltType(tcenv, object);\n              for (i in Range(totalSize, args.size())) {\n                this.checkSubType(\n                  tcenv,\n                  pos,\n                  \"Invalid argument\",\n                  args[i],\n                  eltType,\n                );\n              }\n            | _ ->\n              typingError(\n                Array[\n                  (pos, \"Invalid call. Unexpected type for ...\"),\n                  (spreadType.pos, `${spreadType} is not an array`),\n                ],\n              )\n            }\n          }\n        };\n        !result = result match {\n        | None() -> Some(tfun.retType)\n        | Some(r) -> Some(TType::union(tcenv.subst, this.tenv, r, tfun.retType))\n        };\n      }\n    | _ -> void\n    };\n    result match {\n    | None() ->\n      typingError(\n        Array[\n          (pos, \"Invalid call\"),\n          (fty.pos, `Type ${fty} is not a function`),\n        ],\n      )\n    | Some(x) -> x\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckFun.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun funDefSetup(\n    subst: mutable Subst,\n    thisTypeOpt: ?TType,\n    fd: FunDef,\n    callingContext: CGNode,\n  ): (this, mutable TCEnv) {\n    static::checkTypeParams(fd.tparams);\n    tcenv = TCEnv::mcreate(subst.context, subst, callingContext);\n    thisTypeOpt match {\n    | None() -> void\n    | Some(thisType) ->\n      !this.tenv.subst[\"this\"] = (false, thisType);\n      tcenv.scope.bind(Name(fd.pos, \"this\"), thisType, true)\n    };\n    !this.tenv = this.tenv.addTParams(subst, fd.tparams);\n    for (i => param in fd.params) {\n      for (modifier in param.modifiers.modifiers) {\n        typingError(\n          Array[(modifier.pos, `Forbidden modifier for a function parameter`)],\n        )\n      };\n      paramType = param.type match {\n      | None() -> typingError(Array[(param.pos, \"Missing type annotation\")])\n      | Some(ty) -> this.tenv.normalize(subst.context, ty)\n      };\n      param.optional match {\n      | None() -> void\n      | Some(optionalPos) ->\n        !paramType = paramType.unionUndefined(subst, this.tenv, optionalPos)\n      };\n      param.default match {\n      | None() -> void\n      | Some(defaultExpr) ->\n        param.optional match {\n        | None() -> void\n        | Some(optionalPos) ->\n          typingError(\n            Array[\n              (\n                optionalPos,\n                \"A parameter cannot both be optional and have a default value\",\n              ),\n            ],\n          )\n        };\n        savedScope = tcenv.scope;\n        paramScope = tcenv.mcreateSubScope{isLoop => false};\n        tcenv.!scope = paramScope;\n        this.checkSubType(\n          tcenv,\n          defaultExpr.pos,\n          \"Default value doesn't have the expected type\",\n          this.expr(tcenv, defaultExpr),\n          paramType,\n        );\n        tcenv.!scope = savedScope\n      };\n      paramName = param.name match {\n      | PNName(n) -> n\n      | PNDDD(name) ->\n        param.optional match {\n        | None() -> void\n        | Some(optionalPos) ->\n          typingError(Array[(optionalPos, \"... cannot be optional\")])\n        };\n        param.default match {\n        | None() -> void\n        | Some(defaultExpr) ->\n          typingError(\n            Array[(defaultExpr.pos, \"... cannot have a default value\")],\n          )\n        };\n        if (i != fd.params.size() - 1) {\n          typingError(Array[(name.pos, \"... should be the last parameter\")])\n        };\n        name\n      | _ ->\n        typingError(\n          Array[\n            (param.pos, \"TODO: support for patterns in function parameters\"),\n          ],\n        )\n      };\n      tcenv.scope.bind(paramName, paramType, true)\n    };\n    !this.retType = fd.retType.i1.map(rty ->\n      this.tenv.normalize(subst.context, rty)\n    );\n    (this, tcenv)\n  }\n\n  fun funDef(\n    subst: mutable Subst,\n    thisTypeOpt: ?(ClassKind, TType),\n    fd: FunDef,\n    cgNode: CGNode,\n  ): void {\n    for (modifier in fd.modifiers.modifiers) {\n      modifier match {\n      | ModAsync(pos) -> !fd.isAsync = Some(pos)\n      | ModStatic(_) -> !thisTypeOpt = None()\n      | unsupported ->\n        // TODO: protected, private, public, abstract, readonly\n        typingError(\n          Array[\n            (\n              modifier.pos,\n              `TODO: support for method modifiers (encountered ${unsupported})`,\n            ),\n          ],\n        )\n      }\n    };\n    (!this, tcenv) = this.funDefSetup(\n      subst,\n      thisTypeOpt.map(x -> x.i1),\n      fd,\n      cgNode,\n    );\n    if (this.retType is None()) {\n      typingError(Array[(fd.retType.i0, \"Missing return type\")])\n    };\n    retType = this.retType.fromSome();\n    fd.isAsync match {\n    | None() -> !this.isAsync = false\n    | Some(asyncPos) ->\n      !this.isAsync = true;\n      tvar = tcenv.subst.gen(asyncPos);\n      type = TType::var(tvar);\n      this.checkSubType(\n        tcenv,\n        asyncPos,\n        \"Async functions must return an object of type Promise<_>\",\n        retType,\n        TType::single(TPromise(type, asyncPos)),\n      )\n    };\n    fd.body match {\n    | FDBNone(pos) ->\n      if (thisTypeOpt is Some((CKClass(), _))) {\n        typingError(Array[(pos, \"Missing definition\")])\n      }\n    | FDBSome(body) ->\n      if (thisTypeOpt is Some((CKInterface(), _))) {\n        typingError(Array[(fd.pos, \"An interface cannot implement a method\")])\n      };\n      _ = this.block(tcenv, body);\n      term = StmtTermination::block(body);\n      if (term.mayFallthrough && !this.isVoid(tcenv, this.isAsync, retType)) {\n        typingError(\n          Array[(fd.pos, \"This function may not always return a value\")],\n        )\n      }\n    };\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckRefine.sk", "mtime": 1762780371, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun evalEquality(\n    tcenv: mutable TCEnv,\n    e1: Expr,\n    e2: Expr,\n    target: Bool,\n  ): void {\n    (e1, e2) match {\n    | (\n      Expr(_, EString(tag)),\n      Expr(\n        _,\n        Binop(BODot(), Expr(_, Var(local)), Expr(_, Var(Name(_, fieldName)))),\n      ),\n    )\n    | (\n      Expr(\n        _,\n        Binop(BODot(), Expr(_, Var(local)), Expr(_, Var(Name(_, fieldName)))),\n      ),\n      Expr(_, EString(tag)),\n    ) if (fieldName == kAlgebraicBranchFieldName) ->\n      this.evalAlgebraicBranchEquality(tcenv, local, tag, target)\n\n    | (Expr(_, TypeOf(Expr(_, Var(local)))), Expr(typePos, EString(typeStr)))\n    | (Expr(typePos, EString(typeStr)), Expr(_, TypeOf(Expr(_, Var(local))))) ->\n      this.evalTypeofEquality(tcenv, local, typeStr, typePos, target)\n\n    | (Expr(_, Var(local)), Expr(_, Var(Name(_, \"null\"))))\n    | (Expr(_, Var(Name(_, \"null\"))), Expr(_, Var(local))) ->\n      this.evalNullEquality(tcenv, local, target)\n\n    | (Expr(_, Var(local)), Expr(_, Var(Name(_, \"undefined\"))))\n    | (Expr(_, Var(Name(_, \"undefined\"))), Expr(_, Var(local))) ->\n      this.evalUndefinedEquality(tcenv, local, target)\n\n    | (Expr(pos, _), Expr(_, Var(Name(_, \"null\"))))\n    | (Expr(_, Var(Name(_, \"null\"))), Expr(pos, _))\n    | (Expr(pos, _), Expr(_, Var(Name(_, \"undefined\"))))\n    | (Expr(_, Var(Name(_, \"undefined\"))), Expr(pos, _)) ->\n      typingError(\n        Array[(pos, \"Only locals can be compared to null/undefined.\")],\n      )\n\n    | _ -> void\n    }\n  }\n\n  fun evalAlgebraicBranchEquality(\n    tcenv: mutable TCEnv,\n    local: Name,\n    tag: String,\n    target: Bool,\n  ): void {\n    this.setLocal(\n      tcenv,\n      local,\n      None(),\n      _ ~> true,\n      stype ~>\n        stype match {\n        | TAlgebraic(branches, aPos) ->\n          TAlgebraic(\n            branches.filter(branch -> (branch.tag == tag) == target),\n            aPos,\n          )\n        | x -> x\n        }\n      ,\n    )\n  }\n\n  fun evalTypeofEquality(\n    tcenv: mutable TCEnv,\n    local: Name,\n    typeStr: String,\n    typePos: PosRange,\n    target: Bool,\n  ): void {\n    typeStr match {\n    | \"symbol\" -> void\n    | \"string\" ->\n      (filter, default) = (\n        x ~> (x is TPrimValue(TString(), _, _)),\n        Some(TType::single(TPrimValue::string(typePos))),\n      );\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) default else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | \"number\" ->\n      (filter, default) = (\n        x ~> x is TPrimValue(TNum(), _, _),\n        Some(TType::single(TPrimValue::number(typePos))),\n      );\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) default else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | \"bigint\" ->\n      (filter, default) = (\n        x ~> x is TPrimValue(TBigInt(), _, _),\n        Some(TType::single(TPrimValue::bigint(typePos))),\n      );\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) default else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | \"boolean\" ->\n      (filter, default) = (\n        x ~> x is TPrimValue(TBool(), _, _),\n        Some(TType::single(TPrimValue::boolean(typePos))),\n      );\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) default else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | \"undefined\" ->\n      filter = x ~>\n        x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _);\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) None() else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | \"object\" ->\n      filter = x ~>\n        x is TObject _ || x is TAlgebraic _ || x is TPrimUnit(TNull(), _);\n      objectTy = TType::single(TObject(TFields::empty(), typePos));\n      nullTy = TType::single(TPrimUnit(TNull(), typePos));\n      defaultType = TType::union(tcenv.subst, this.tenv, objectTy, nullTy);\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) Some(defaultType) else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | \"function\" ->\n      filter = x ~> x is TFuns _;\n      this.setLocal(\n        tcenv,\n        local,\n        if (target) None() else None(),\n        if (target) filter else x ~> !filter(x),\n      )\n    | _ ->\n      typingError(\n        Array[(typePos, `Unexpected typeof check against \"${typeStr}\"`)],\n      )\n    }\n  }\n\n  fun evalNullEquality(tcenv: mutable TCEnv, local: Name, target: Bool): void {\n    this.setLocal(tcenv, local, None(), x ~>\n      x is TPrimUnit(TNull(), _) == target\n    )\n  }\n\n  fun evalUndefinedEquality(\n    tcenv: mutable TCEnv,\n    local: Name,\n    target: Bool,\n  ): void {\n    this.setLocal(tcenv, local, None(), x ~>\n      (x is TPrimUnit(TUndefined(), _) || x is TPrimUnit(TVoid(), _)) == target\n    )\n  }\n\n  fun evalCond(tcenv: mutable TCEnv, e: Expr, target: Bool): void {\n    e.value match {\n    | Binop(BOStrictEquality(), e1, e2) ->\n      this.evalEquality(tcenv, e1, e2, target)\n\n    | Binop(BOStrictInequality(), e1, e2) ->\n      this.evalEquality(tcenv, e1, e2, !target)\n\n    | InstanceOf(\n      Expr(_, Var(local)),\n      Expr(_, Var(Name(posArray, \"Array\"))),\n    ) if (target) ->\n      tcenv.scope.set(\n        local,\n        TType::inst(\n          Name(posArray, \"Array\"),\n          TArgs(Array[TType::top(posArray)]),\n        ),\n        (_, _) -> void,\n      )\n\n    | InstanceOf(Expr(_, Var(local)), Expr(_, Var(className))) if (target) ->\n      tcenv.scope.set(\n        local,\n        this.tenv.new(\n          tcenv.context,\n          className,\n          this.tenv.makeTArgs(tcenv.context, tcenv.subst, className),\n        ),\n        (x, y) -> this.checkSubType(tcenv, e.pos, \"Invalid instanceof\", x, y),\n      )\n\n    | In(e1, Expr(_, Var(local))) ->\n      (_t1, fieldsOpt) = this.getInLhsTypeAndFields(tcenv, e.pos, e1);\n      default = if (target) {\n        fieldsOpt.flatMap(fieldsToCheck ->\n          fieldsToCheck.singleElt().flatMap(singleField ->\n            TField::create(\n              e1.pos,\n              singleField.i1,\n              false,\n              TType::top(e.pos),\n            ).map(field ->\n              TType::single(TObject(TFields::create(Array[field], Array[]), e1.pos))\n            )\n          )\n        )\n      } else {\n        None()\n      };\n      filterSType = stype ~>\n        stype match {\n        | TPrimUnit _\n        | TPrimValue _ ->\n          !target\n        | TTuple _\n        | TAlgebraic _\n        | TFuns _\n        | TPromise _ ->\n          true /* TODO */\n        | TObject _ -> true\n        };\n      mapSType = stype ~>\n        stype match {\n        | TPrimUnit _\n        | TPrimValue _ ->\n          if (target) internal_error(\"Filter should have got rid of it\") else {\n            stype\n          }\n        | TTuple _\n        | TAlgebraic _\n        | TFuns _\n        | TPromise _ ->\n          stype /* TODO */\n        | TObject(tFields @ TFields(_fields, indexes), tObjPos) ->\n          fieldsOpt\n            .flatMap(fieldsToCheck ->\n              fieldsToCheck\n                .singleElt()\n                .flatMap(singleField ->\n                  if (target) {\n                    if (!indexes.isEmpty()) None() else {\n                      TField::create(\n                        e1.pos,\n                        singleField.i1,\n                        false,\n                        TType::top(e.pos),\n                      ).flatMap(fieldToAdd -> tFields.addField(fieldToAdd))\n                    }\n                  } else {\n                    Some(\n                      tFields.filterMap(tField ->\n                        if (tField.name == singleField.i1) None() else {\n                          Some(tField)\n                        }\n                      ),\n                    )\n                  }\n                )\n                .map(newTFields -> TObject(newTFields, tObjPos))\n            )\n            .default(stype)\n        };\n      this.setLocal(tcenv, local, default, filterSType, mapSType)\n\n    | Binop(BOLogicalAnd(), e1, e2) if (target) ->\n      this.evalCond(tcenv, e1, true);\n      this.evalCond(tcenv, e2, true)\n\n    | Binop(BOLogicalOr(), e1, e2) if (!target) ->\n      this.evalCond(tcenv, e1, false);\n      this.evalCond(tcenv, e2, false)\n\n    | _ -> void\n    }\n  }\n\n  fun setLocal(\n    tcenv: mutable TCEnv,\n    local: Name,\n    default: ?TType,\n    filter: SType ~> Bool,\n    map: SType ~> SType = x ~> x,\n  ): void {\n    ty = tcenv.scope.get(local);\n    !ty = ty.expand(tcenv.subst, this.tenv, Covariant());\n    !ty = (mutable FilterType()).type((filter, map), ty);\n    localType = default match {\n    | Some(d) ->\n      isTopOrEmpty = ty.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n      | None() -> true\n      | Some(stypes) -> stypes.isEmpty()\n      };\n      if (isTopOrEmpty) d else ty\n    | _ -> ty\n    };\n    tcenv.scope.set(local, localType, (_, _) -> void)\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckScope.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* The local environment. */\n/***************************************************************************/\n\nmodule SKJS;\n\nvalue class LocalRef(type: TType, isInitialized: Bool)\n\nmutable class Scope{\n  id: Int,\n  private isLoop: Bool,\n  up: ?readonly Scope = None(),\n  private mutable locals: SortedMap<String, Name> = SortedMap[],\n  private mutable refs: SortedMap<String, LocalRef> = SortedMap[],\n} {\n  static fun mcreateToplevel(): mutable this {\n    mutable static{id => 0, isLoop => false}\n  }\n\n  readonly private fun maybeGetLocal(name: Name): ?Name {\n    this.locals.maybeGet(name.value) match {\n    | None() ->\n      this.up match {\n      | None() -> None()\n      | Some(up) -> up.maybeGetLocal(name)\n      }\n    | Some(x) -> Some(x)\n    }\n  }\n\n  readonly private fun maybeGetRefHelper(\n    throughLoop: Bool,\n    name: String,\n  ): ?(Bool, LocalRef) {\n    !throughLoop = this.isLoop || throughLoop;\n    this.refs.maybeGet(name) match {\n    | None() ->\n      this.up match {\n      | None() -> None()\n      | Some(up) -> up.maybeGetRefHelper(throughLoop, name)\n      }\n    | Some(x) -> Some((throughLoop, x))\n    }\n  }\n\n  readonly private fun maybeGetRef(name: String): ?(Bool, LocalRef) {\n    this.maybeGetRefHelper(false, name)\n  }\n\n  mutable fun bind(name: Name, ty: TType, isInitialized: Bool): void {\n    this.maybeGetLocal(name) match {\n    | None() ->\n      this.!locals[name.value] = name;\n      this.!refs[name.value] = LocalRef(ty, isInitialized)\n    | Some(otherDef) ->\n      typingError(\n        Array[\n          (name.pos, name.value + \" is already defined\"),\n          (otherDef.pos, \"Previous definition was here\"),\n        ],\n      )\n    }\n  }\n\n  readonly fun isThroughLoop(name: Name): Bool {\n    this.maybeGetRef(name.value) match {\n    | None() -> false\n    | Some((isThroughLoop, _)) -> isThroughLoop\n    }\n  }\n\n  readonly fun maybeGet(name: Name): ?TType {\n    this.maybeGetRef(name.value) match {\n    | None() -> None()\n    | Some((_, ref)) ->\n      if (!ref.isInitialized) {\n        typingError(Array[(name.pos, \"This local is not fully initialized\")])\n      } else {\n        Some(ref.type)\n      }\n    }\n  }\n\n  readonly fun get(name: Name): TType {\n    this.maybeGet(name) match {\n    | None() -> typingError(Array[(name.pos, \"Unbound name\")])\n    | Some(x) -> x\n    }\n  }\n\n  mutable fun set(\n    name: Name,\n    ty: TType,\n    isSubType: (TType, TType) -> void,\n  ): void {\n    (throughLoop, upRef) = this.maybeGetRef(name.value) match {\n    | None() -> typingError(Array[(name.pos, \"Unbound name: \" + name.value)])\n    | Some(x) -> x\n    };\n    if (throughLoop) {\n      isSubType(ty, upRef.type);\n    };\n    this.!refs[name.value] = LocalRef(ty, true);\n  }\n\n  readonly fun escapingRefs(): mutable Iterator<(String, LocalRef)> {\n    this.refs.items().filter(x -> !this.locals.containsKey(x.i0))\n  }\n\n  mutable fun merge(\n    subst: mutable Subst,\n    tenv: TEnv,\n    scope1: readonly Scope,\n    scope2: readonly Scope,\n  ): void {\n    if (scope1.up.fromSome().id != this.id) {\n      internal_error(\"scope1 up id mismatch\")\n    };\n    if (scope2.up.fromSome().id != this.id) {\n      internal_error(\"scope2 up id mismatch\")\n    };\n    _ = mapUnion(\n      scope1.escapingRefs(),\n      scope2.escapingRefs(),\n      x ~> x.i0,\n      (nameRef) -> {\n        (name, ref) = nameRef;\n        (_, upRef) = this.maybeGetRef(name).fromSome();\n        this.!refs[name] = LocalRef(\n          TType::union(subst, tenv, upRef.type, ref.type),\n          upRef.isInitialized,\n        );\n        nameRef\n      },\n      (nameRef1, nameRef2) -> {\n        (name1, ref1) = nameRef1;\n        (name2, ref2) = nameRef2;\n        if (name1 != name2) {\n          internal_error(\"name refs must have same name\")\n        };\n        this.!refs[name1] = LocalRef(\n          TType::union(subst, tenv, ref1.type, ref2.type),\n          ref1.isInitialized && ref2.isInitialized,\n        );\n        nameRef1\n      },\n    );\n  }\n\n  mutable fun popMerge(\n    subst: mutable Subst,\n    tenv: TEnv,\n    scope: readonly Scope,\n  ): void {\n    if (scope.up.fromSome().id != this.id) {\n      internal_error(\"scope up id mismatch\")\n    };\n    for (nameRef in scope.escapingRefs()) {\n      (name, ref) = nameRef;\n      (_, upRef) = this.maybeGetRef(name).fromSome();\n      this.!refs[name] = LocalRef(\n        TType::union(subst, tenv, upRef.type, ref.type),\n        upRef.isInitialized,\n      )\n    }\n  }\n\n  mutable fun popReplace(scope: readonly Scope): void {\n    if (scope.up.fromSome().id != this.id) {\n      internal_error(\"scope up id mismatch\")\n    };\n    for (nameRef in scope.escapingRefs()) {\n      (name, ref) = nameRef;\n      this.!refs[name] = ref;\n    }\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckStmt.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun stmt(tcenv: mutable TCEnv, st: Stmt): void {\n    st.value match {\n    | Break() -> void\n    | Continue() -> void\n    | StmtEmpty() -> void\n    | StmtExpr(e) ->\n      ty = this.expr(tcenv, e);\n      if (!static::isPossiblyNonVoidExpressionAllowedAsStatement(e)) {\n        this.checkIsVoid(tcenv, e.pos, ty)\n      }\n    | Return(pos, eOpt) ->\n      retType = this.retType match {\n      | None() ->\n        TType::single(TPrimUnit(TVoid(), st.pos)) // constructor\n      | Some(x) -> x\n      };\n      (epos, etype) = eOpt match {\n      | None() -> (pos, TType::single(TPrimUnit(TVoid(), pos)))\n      | Some(e) -> (e.pos, this.expr(tcenv, e, true))\n      };\n      rtype = if (this.isAsync) {\n        TType::single(TPromise(etype, epos))\n      } else {\n        etype\n      };\n      this.checkSubType(tcenv, epos, \"Invalid return type\", rtype, retType)\n\n    | Bind(BKVar(), vars) ->\n      if (vars.size() == 0) internal_error(\"vars size should not be 0\");\n      typingError(\n        Array[(vars[0].pat.pos, \"Don't use var, use let or const instead\")],\n      )\n\n    | Bind(bkind, bindings) ->\n      for (binding in bindings) {\n        (ty, isInitialized) = this.bindType(\n          binding.pat.pos,\n          tcenv,\n          bkind,\n          binding.type,\n          binding.value,\n        );\n        this.bind(\n          tcenv,\n          bkind,\n          binding.pat,\n          ty,\n          isInitialized,\n          binding.value is Some(Expr(_, Object _)),\n        )\n      }\n\n    | If(e, block1, block2opt) ->\n      block2 = block2opt.default(Array[]);\n      this.checkBool(tcenv, e);\n      scope1 = this.block(tcenv, block1, Some((e, true)));\n      scope2 = this.block(tcenv, block2, Some((e, false)));\n      (isTerminalBlock(false, block1), isTerminalBlock(false, block2)) match {\n      | (true, true) -> void /* TODO: everything that follows is unreachable */\n      | (true, false) -> tcenv.popScopeReplace(scope2)\n      | (false, true) -> tcenv.popScopeReplace(scope1)\n      | (false, false) -> tcenv.mergeScope(this.tenv, scope1, scope2)\n      }\n\n    | For(initStmt, cond, incr, block) ->\n      scopeCopy = tcenv.scope;\n      initScope = tcenv.mcreateSubScope{isLoop => false};\n      tcenv.!scope = initScope;\n      this.stmt(tcenv, initStmt);\n      loopScope = tcenv.mcreateSubScope{isLoop => true};\n      tcenv.!scope = loopScope;\n      this.checkBool(tcenv, cond);\n      loopBody = this.block(tcenv, block);\n      tcenv.popScopeReplace(loopBody);\n      _ = this.expr(tcenv, incr);\n      tcenv.!scope = initScope;\n      tcenv.popScope(tcenv.subst, this.tenv, loopScope);\n      tcenv.!scope = scopeCopy;\n      tcenv.popScopeReplace(initScope)\n    | Block(stmts) ->\n      for (stmt in stmts) {\n        this.stmt(tcenv, stmt)\n      }\n    | ForInOf(kind, initStmt, iterable, block) ->\n      scopeCopy = tcenv.scope;\n      initScope = tcenv.mcreateSubScope{isLoop => false};\n      tcenv.!scope = initScope;\n\n      iterableType = this.expr(tcenv, iterable, true);\n      ty = kind match {\n      | ForIn() -> this.tenv.forInKeys(tcenv.subst, iterableType, iterable.pos)\n      | ForOf() -> this.getValueType(tcenv, iterable.pos, iterableType)\n      };\n\n      this.bindLoopVar(tcenv, initStmt, ty);\n\n      loopScope = tcenv.mcreateSubScope{isLoop => true};\n      tcenv.!scope = loopScope;\n      loopBody = this.block(tcenv, block);\n      tcenv.popScopeReplace(loopBody);\n      tcenv.!scope = initScope;\n      tcenv.popScope(tcenv.subst, this.tenv, loopScope);\n      tcenv.!scope = scopeCopy;\n      tcenv.popScopeReplace(initScope)\n\n    | Throw(e) -> _ = this.expr(tcenv, e)\n    | While(cond, block) ->\n      scopeCopy = tcenv.scope;\n      loopScope = tcenv.mcreateSubScope{isLoop => true};\n      tcenv.!scope = loopScope;\n      this.checkBool(tcenv, cond);\n      loopBody = this.block(tcenv, block, Some((cond, true)));\n      tcenv.popScopeReplace(loopBody);\n      tcenv.!scope = scopeCopy;\n      tcenv.popScope(tcenv.subst, this.tenv, loopScope)\n    | Switch(e, branches) ->\n      this.switchCheckExhaustiveness(tcenv, e, branches);\n      this.switch(tcenv, e, branches)\n    | Try(tryBlock, catchClause, finallyBlock) ->\n      scopeCopy = tcenv.scope;\n      tryScope = tcenv.mcreateSubScope{isLoop => false};\n      tcenv.!scope = tryScope;\n      for (stmt in tryBlock) {\n        this.stmt(tcenv, stmt)\n      };\n      tcenv.!scope = scopeCopy;\n      tcenv.popScope(tcenv.subst, this.tenv, tryScope);\n\n      catchClause match {\n      | Some(CatchClause(param, type, catchBlock)) ->\n        catchScope = tcenv.mcreateSubScope{isLoop => false};\n        tcenv.!scope = catchScope;\n        param match {\n        | Some(pat) ->\n          errorType = type match {\n          | Some(t) -> // If we trusted user: this.tenv.normalize(tcenv.context, t)\n            typingError(\n              Array[\n                (\n                  t.pos,\n                  \"Do not specify a type annotation for caught exceptions as it cannot be trusted\",\n                ),\n              ],\n            )\n          | None() -> TType::top(pat.pos)\n          };\n          this.bind(tcenv, BKLet(), pat, errorType, true, false)\n        | None() -> void\n        };\n        for (stmt in catchBlock) {\n          this.stmt(tcenv, stmt)\n        };\n        tcenv.!scope = scopeCopy;\n        tcenv.popScope(tcenv.subst, this.tenv, catchScope)\n      | None() -> void\n      };\n\n      finallyBlock match {\n      | Some(finallyStmts) ->\n        finallyScope = tcenv.mcreateSubScope{isLoop => false};\n        tcenv.!scope = finallyScope;\n        for (stmt in finallyStmts) {\n          this.stmt(tcenv, stmt)\n        };\n        tcenv.!scope = scopeCopy;\n        tcenv.popScope(tcenv.subst, this.tenv, finallyScope)\n      | None() -> void\n      }\n    }\n  }\n\n  fun switch(\n    tcenv: mutable TCEnv,\n    e: Expr,\n    branches: Array<SwitchBranch>,\n  ): void {\n    if (branches.size() == 0) {\n      typingError(Array[(e.pos, \"Missing branch\")])\n    };\n    checkBreak = block -> {\n      term = StmtTermination::block(block);\n      if (term.mayFallthrough) {\n        if (block.size() == 0) {\n          internal_error(\"block size should not be 0\")\n        };\n        last = block[block.size() - 1];\n        typingError(Array[(last.pos, \"Missing break\")])\n      }\n    };\n    scope = branches[0] match {\n    | Case(v, block) ->\n      checkBreak(block);\n      cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));\n      this.block(tcenv, block, Some((cond, true)))\n    | Default(_) -> typingError(Array[(e.pos, \"Missing branch\")])\n    };\n    for (i in Range(1, branches.size())) {\n      tcenv.mergeScope(\n        this.tenv,\n        scope,\n        branches[i] match {\n        | Case(v, block) ->\n          checkBreak(block);\n          cond = Expr(e.pos, (Binop(BOStrictEquality(), e, v)));\n          this.block(tcenv, block, Some((cond, true)))\n        | Default(stmts) -> this.block(tcenv, stmts)\n        },\n      )\n    }\n  }\n\n  fun switchCheckExhaustiveness(\n    tcenv: mutable TCEnv,\n    e: Expr,\n    branches: Array<SwitchBranch>,\n  ): void {\n    condType = this.expr(tcenv, e, true);\n    cases = condType\n      .getSTypes(tcenv.subst, this.tenv, Covariant())\n      .flatMap(stypes ~> stypes.singleElt()) match {\n    | Some(TPrimValue(_, Some(values), _)) ->\n      Set::mcreateFromItems(values.values.map(x -> x.i1))\n    | _ -> return void\n    };\n    for (branch in branches) {\n      branch match {\n      | Case(v, _) ->\n        this.expr(tcenv, v, true)\n          .getSTypes(tcenv.subst, this.tenv, Covariant())\n          .flatMap(stypes ~> stypes.staticValue()) match {\n        | Some(staticValue) ->\n          if (!cases.contains(staticValue)) {\n            typingError(Array[(v.pos, \"Unused branch\")])\n          };\n          cases.remove(staticValue)\n        | None() -> void\n        }\n\n      | Default(stmts) ->\n        if (cases.isEmpty()) {\n          if (stmts.isEmpty()) {\n            internal_error(\"Internal error: empty default\");\n          };\n          typingError(Array[(stmts[0].pos, \"Unused branch\")])\n        };\n        cases.clear()\n      }\n    };\n    if (!cases.isEmpty()) {\n      typingError(Array[(e.pos, \"Missing branches:\\n\" + cases.join(\"\\n\"))]);\n    }\n  }\n\n  fun bindLoopVar(tcenv: mutable TCEnv, initStmt: Stmt, varType: TType): void {\n    initStmt.value match {\n    | Bind(kind, bindings) ->\n      if (bindings.size() != 1) {\n        typingError(\n          Array[\n            (\n              initStmt.pos,\n              \"Loop variable declaration must have exactly one binding\",\n            ),\n          ],\n        )\n      };\n      binding = bindings[0];\n      this.bind(tcenv, kind, binding.pat, varType, true, false)\n    | _ ->\n      typingError(Array[(initStmt.pos, \"Invalid loop variable declaration\")])\n    }\n  }\n\n  fun getValueType(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    iterableType: TType,\n  ): TType {\n    stypes = iterableType.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n    | Some(stypes) if (!stypes.isEmpty()) -> stypes\n    | _ -> typingError(Array[(pos, \"Invalid iterable type for for-of loop\")])\n    };\n\n    result = TType::bottom(pos);\n    for (stype in stypes) {\n      stype match {\n      | TObject(fields, _objectPos) ->\n        if (fields.indexes.isEmpty()) {\n          typingError(Array[(pos, \"Invalid iterable type for for-of loop\")])\n        };\n        for (index in fields.indexes) {\n          !result = TType::union(\n            tcenv.subst,\n            this.tenv,\n            result,\n            index.valueType,\n          )\n        }\n      | TTuple(tuple, _) ->\n        for (elementType in tuple) {\n          !result = TType::union(tcenv.subst, this.tenv, result, elementType)\n        }\n      | TPrimValue(TString(), _, _) ->\n        !result = TType::union(\n          tcenv.subst,\n          this.tenv,\n          result,\n          TType::single(TPrimValue::string(pos)),\n        )\n      | _ ->\n        typingError(\n          Array[\n            (pos, \"for-of loop requires an array, string, or iterable type\"),\n          ],\n        )\n      }\n    };\n    result\n  }\n}\n\nmodule end;\n"}, {"path": "src/TypeCheckUtils.sk", "mtime": 1762775914, "contents": "module SKJS;\n\nextension class TypeChecker {\n  fun isVoid(tcenv: mutable TCEnv, isAsync: Bool, ty: TType): Bool {\n    clauses = ty.expand(tcenv.subst, this.tenv, Covariant());\n    for (clause in clauses.clauses) {\n      clause.stypes match {\n      | None() -> return false\n      | Some(stypes) ->\n        stypes.singleElt() match {\n        | Some(TPrimUnit(TVoid(), _)) if (!isAsync) -> void\n        | Some(TPromise(realType, _)) if (isAsync) ->\n          if (!this.isVoid(tcenv, false, realType)) {\n            return false\n          }\n        | _ -> return false\n        }\n      }\n    };\n    true\n  }\n\n  // Returns true if the type is not Top but contains void\n  fun nonTopContainsVoid(tcenv: mutable TCEnv, ty: TType): Bool {\n    clauses = ty.expand(tcenv.subst, this.tenv, Covariant());\n    for (clause in clauses.clauses) {\n      clause.stypes match {\n      | Some(stypes) if (stypes.any(stype ~> stype is TPrimUnit(TVoid(), _))) ->\n        return true\n      | _ -> void\n      }\n    };\n    false\n  }\n\n  static private fun filterMethods(\n    ty: TType,\n    subst: mutable Subst,\n    tenv: TEnv,\n  ): TType {\n    ty.getSTypes(subst, tenv, Covariant()).flatMap(stypes ~> {\n      stypes.singleElt()\n    }) match {\n    | Some(TObject(fields, pos)) ->\n      TType::single(\n        TObject(\n          fields.filterMap(field -> {\n            fieldType = field.type;\n            fieldType\n              .mapSTypes(subst, tenv, Covariant(), fieldSTypes -> {\n                fieldSTypes.filter(fieldSType ~> {\n                  fieldSType match {\n                  | TFuns(funs, _methods, _pos) if (funs.isEmpty()) -> false\n                  | TFuns(_funs, methods, _pos) if (!methods.isEmpty()) ->\n                    internal_error(\n                      \"TODO: encountered both non-empty funs and methods in filterMethod\",\n                    )\n                  //Some(tfuns with {methods => Array[]})\n                  | _ -> true\n                  }\n                })\n              })\n              .flatMap((fieldType) ->\n                if (fieldType.isBottom()) None() else {\n                  Some(field.mapType(_existingType -> fieldType))\n                }\n              )\n          }),\n          pos,\n        ),\n      )\n    | _ -> internal_error(\"Internal error: new should produce an object\")\n    }\n  }\n\n  fun checkSubType(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    msg: String,\n    ty1: TType,\n    ty2: TType,\n  ): void {\n    isSubTType(tcenv.subst, this.tenv, ty1, ty2) match {\n    | STOk() -> void\n    | STRec(reason, pos1, subTy2) ->\n      typingError(\n        Array[\n          (pos, msg),\n          (\n            pos1,\n            reason.toString(\n              tcenv.subst,\n              this.tenv,\n              expandTVars(tcenv.subst, this.tenv, ty1),\n            ),\n          ),\n          (\n            subTy2.pos,\n            \"It is incompatible with: \" +\n              expandTVars(tcenv.subst, this.tenv, subTy2).toString(),\n          ),\n        ],\n      )\n    | err @ STError _ ->\n      typingError(Array[(pos, err.toString(tcenv.subst, this.tenv, ty1))])\n    }\n  }\n\n  fun checkIsVoid(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {\n    this.checkSubType(\n      tcenv,\n      pos,\n      \"This expression was expected to be of type void\",\n      ty,\n      TType::single(TPrimUnit(TVoid(), ty.pos)),\n    );\n  }\n\n  static fun isPossiblyNonVoidExpressionAllowedAsStatement(e: Expr): Bool {\n    e.value match {\n    | Binop(BOAssignment(), _, _)\n    | Binop(BOOpAssignment(_), _, _)\n    | PostOp(PODecr(), _)\n    | PostOp(POIncr(), _) ->\n      true\n    | _ -> false\n    }\n  }\n\n  fun checkBool(tcenv: mutable TCEnv, e: Expr): void {\n    this.checkSubType(\n      tcenv,\n      e.pos,\n      \"A condition is expected to be of type boolean, not: \",\n      this.expr(tcenv, e),\n      TType::single(TPrimValue::boolean(e.pos)),\n    );\n  }\n\n  fun checkStringifiable(tcenv: mutable TCEnv, pos: PosRange, ty: TType): void {\n    // Check if the type is a primitive type that can be converted to string\n    // Allowed types: string, number, bigint, boolean, null, undefined\n    isStringifiable = ty.getSTypes(tcenv.subst, this.tenv, Covariant()) match {\n    | None() -> false\n    | Some(stypes) ->\n      stypes.singleElt() match {\n      | Some(TPrimValue(TString(), _, _)) -> true\n      | Some(TPrimValue(TNum(), _, _)) -> true\n      | Some(TPrimValue(TBigInt(), _, _)) -> true\n      | Some(TPrimValue(TBool(), _, _)) -> true\n      | Some(TPrimUnit(TNull(), _)) -> true\n      | Some(TPrimUnit(TUndefined(), _)) -> true\n      | Some(TPrimUnit(TVoid(), _)) -> true\n      | _ -> false\n      }\n    };\n\n    if (!isStringifiable) {\n      typingError(\n        Array[\n          (\n            pos,\n            \"Template literal expressions must be string, number, bigint, boolean, null, or undefined\",\n          ),\n        ],\n      );\n    }\n  }\n\n  fun checkIsNumber(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    msg: String,\n    ty: TType,\n  ): void {\n    ty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n      stypes.singleElt()\n    ) match {\n    | Some(TPrimValue(TNum(), _, _)) -> void\n    | _ -> typingError(Array[(pos, msg), (ty.pos, \"This is not a number\")])\n    };\n  }\n\n  fun checkIsNumeric(\n    tcenv: mutable TCEnv,\n    pos: PosRange,\n    msg: String,\n    ty: TType,\n  ): TPrimValueKind {\n    ty.getSTypes(tcenv.subst, this.tenv, Covariant()).flatMap(stypes ~>\n      stypes.singleElt()\n    ) match {\n    | Some(TPrimValue(kind @ TNum(), _, _))\n    | Some(TPrimValue(kind @ TBigInt(), _, _)) ->\n      kind\n    | _ ->\n      typingError(\n        Array[\n          (pos, msg),\n          (ty.pos, \"This is not a numeric type (number or bigint)\"),\n        ],\n      )\n    };\n  }\n\n  fun makeBoundTVar(tcenv: mutable TCEnv, ty: TType): TType {\n    tvar = tcenv.subst.gen(ty.pos);\n    tcenv.subst.grow(this.tenv, tvar, ty, Contravariant());\n    TType::var(tvar)\n  }\n\n  fun newTVar(tcenv: mutable TCEnv, pos: PosRange): TType {\n    tvar = tcenv.subst.gen(pos);\n    TType::var(tvar)\n  }\n\n  fun checkLValue(e: Expr): void {\n    e.value match {\n    | Var(Name(_, \"super\")) -> typingError(Array[(e.pos, \"Invalid lvalue\")])\n    | Var _ -> void\n    | Get _ -> void\n    | EArray _ -> void\n    | Binop(BODot(), e1, Expr(_, Var(_))) -> this.checkLValue(e1)\n    | _ -> typingError(Array[(e.pos, \"Invalid lvalue\")])\n    }\n  }\n}\n\nfun paramsError<T>(pos: PosRange): T {\n  typingError(\n    Array[\n      (\n        pos,\n        \"Type annotations in parentheses are not valid in an expression.\" +\n          \"Use type assertions with 'as' keyword instead\",\n      ),\n    ],\n  )\n}\n\nmodule end;\n"}, {"path": "src/TypingError.sk", "mtime": 1762775914, "contents": "/***************************************************************************/\n/* Typing Errors */\n/***************************************************************************/\n\nmodule SKJS;\n\nclass TypingError(messages: Array<(PosRange, String)>) extends Error {\n  fun toString(\n    context: mutable SKStore.Context,\n    newLinesMap: NewLinesMap,\n    symbolsMap: SymbolsMap,\n  ): String {\n    result = mutable Vector[];\n    for (message in this.messages) {\n      pos = message.i0;\n      fileName = pos.fileName;\n      resolver = static::resolver(fileName, context, newLinesMap, symbolsMap);\n      result.push(resolver.relPosRange(message.i0).toString());\n      result.push(message.i1);\n    };\n    result.join(\"\\n\")\n  }\n}\n\nfun typingError<T>(messages: Array<(PosRange, String)>): T {\n  throw ErrorExn(TypingError(messages))\n}\n\nfun notSupported<T>(pos: PosRange, what: String = \"\"): T {\n  message = if (what == \"\") \"Construction not supported\" else {\n    `Construction not supported: ${what}`\n  };\n  typingError(Array[(pos, message)])\n}\n\nmodule end;\n"}], "env": [], "dependencies": [{"name": "std", "hash": "-7944181757509460678"}, {"name": "cli", "hash": "-7521088047300310590"}], "link": ["/Users/cristianocalcagno/GitHub/skjs/target/host/dev/build/skjs-39821826178da5dc/out/libskjs_runtime.a", "-lbacktrace", "-lpthread", "-L/Users/cristianocalcagno/.local/lib", "-lskip_runtime64"], "preambles": [], "has_object_code": false}