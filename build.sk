// Build script for skjs native runtime components

fun gitCommitHash(): String {
  System.subprocess(Array["git", "rev-parse", "--short", "HEAD"]) match {
  | Success(p) if (p.success()) ->
    hash = p.stdout.trim();
    if (!hash.isEmpty()) return hash
  | _ -> void
  };

  // Fall back to GITHUB_SHA in GitHub Actions runners where git refuses to
  // operate on the bind-mounted workspace ("dubious ownership").
  Environ.varOpt("GITHUB_SHA") match {
  | Some(sha) if (!sha.isEmpty()) -> sha.take(7)
  | _ ->
    print_string(
      "Error: could not determine git commit hash via `git rev-parse` or GITHUB_SHA",
    );
    skipExit(1)
  }
}

fun main(): void {
  print_string(`skargo:skc-env=GIT_COMMIT_HASH=${gitCommitHash()}`);

  pic = (Environ.var("RELOCATION_MODEL") == "pic");
  profile = Environ.var("PROFILE");

  // Native C++ source files
  native_cpp_srcs = Array["runtime.cpp"];

  // Mark files for dependency tracking
  native_cpp_srcs.each(f -> print_string(`skargo:rerun-if-changed=${f}`));
  print_string("skargo:rerun-if-changed=runtime.h");

  // Compile the C++ runtime
  builder = Cc.Build()
    .cpp(true) // Enable C++ compilation
    .pic(pic) // Position independent code based on environment
    .files(native_cpp_srcs)
    .define("SKIP64");

  // Add release flag for optimized builds
  if (profile == "release") {
    !builder = builder.define("RELEASE")
  };

  // Try to get libbacktrace configuration (for debug builds)
  if (profile != "release") {
    // Only try to use libbacktrace for non-release builds
    !builder = builder.include("../skip/skiplang/prelude/libbacktrace/")
  };

  // Compile the library
  builder.compile("skjs_runtime");

  // Link the compiled library (specify full path to the static library)
  out_dir = Environ.var("OUT_DIR");
  runtime_lib = `${out_dir}/libskjs_runtime.a`;
  print_string(`skargo:skc-link-lib=${runtime_lib}`);

  // Also record it as an explicit linker argument so downstream binaries link it.
  print_string(`skargo:skc-link-arg=${runtime_lib}`);

  // Link libbacktrace for non-release builds
  if (profile != "release") {
    print_string("skargo:skc-link-arg=-lbacktrace")
  };
}
